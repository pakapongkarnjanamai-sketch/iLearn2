<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- DevExpress NuGet feed — credentials injected via DEVEXPRESS_NUGET_KEY env var -->
    <add key="devexpress" value="https://nuget.devexpress.com/api" />
  </packageSources>
  <packageSourceCredentials>
    <devexpress>
      <add key="Username" value="License" />
      <add key="ClearTextPassword" value="%DEVEXPRESS_NUGET_KEY%" />
    </devexpress>
  </packageSourceCredentials>
</configuration>