<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- DevExpress NuGet feed (requires a license subscription).
         Developer machines: configure credentials via
           dotnet nuget add source "https://nuget.devexpress.com/{YOUR_KEY}/api" --name devexpress
         Copilot agent: DevExpress packages are pre-cached by the
           "Cache DevExpress NuGet Packages" Actions workflow (see .github/workflows/). -->
    <add key="devexpress" value="https://nuget.devexpress.com/api" />
  </packageSources>
</configuration>