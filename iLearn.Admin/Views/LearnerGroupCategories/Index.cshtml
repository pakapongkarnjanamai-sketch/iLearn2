@{
    ViewBag.Title = "Learner Group Categories";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title h3">@ViewBag.Title</div>
        <div class="page-subtitle">Organize Learner Groups into a hierarchical category structure.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Index", "LearnerGroups")" class="action-link">
            <i class="fas fa-users" aria-hidden="true"></i> Learner Groups
        </a>
        <a href="@Url.Action("Editor", "LearnerGroupCategories")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> New Category
        </a>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>
</div>

@section Scripts {
    <script>
        const CATEGORIES_API_URL = `${serviceUrl}/LearnerGroupCategories`;
        const detailUrl = '@Url.Action("Detail", "LearnerGroupCategories")';
        const editorUrl = '@Url.Action("Editor", "LearnerGroupCategories")';

        $(function () {
            const store = new DevExpress.data.CustomStore({
                key: "id",
                loadMode: "raw",
                load: async function () {
                    const res = await $.ajax({
                        url: CATEGORIES_API_URL,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });
                    return res?.data || [];
                }
            });

            const treeList = $("#grid").dxTreeList(buildAdminTreeListOptions("Search categories...", {
                preset: "defaultGrid",
                dataSource: store,
                keyExpr: "id",
                parentIdExpr: "parentId",
                dataStructure: "plain",
                rootValue: null,
                autoExpandAll: true,
                keyExpr: "id",
                height: "100%",
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                onRowDblClick: function (e) {
                    if (e.data?.id) window.location.href = `${detailUrl}?id=${e.data.id}`;
                },
                columns: [
                    { dataField: "name", caption: "Category", minWidth: 280 },
                    {
                        dataField: "description", caption: "Description", minWidth: 260,
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        dataField: "learnerGroupCount", caption: "Groups", width: 90,
                        alignment: "center", cssClass: "tabular-nums",
                        customizeText: function (e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "childCount", caption: "Sub-categories", width: 130,
                        alignment: "center", cssClass: "tabular-nums",
                        customizeText: function (e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "createdBy", caption: "Created By", width: 140,
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        type: "buttons", caption: "", width: 60,
                        alignment: "center", fixed: true, fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Details",
                                icon: "info",
                                onClick: function (e) {
                                    if (e.row.data.id) window.location.href = `${detailUrl}?id=${e.row.data.id}`;
                                }
                            }
                        ]
                    }
                ]
            })).dxTreeList("instance");

            window.enableAdminViewportLayout({
                refreshTargets: [{ instance: treeList }]
            });
        });
    </script>
}
