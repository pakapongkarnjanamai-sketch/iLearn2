@{
    ViewBag.Title = "Course Types";
}

<style>
    body {
        background-color: #f8f9fa;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                <i class="fas fa-layer-group fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted fw-medium">Manage course type definitions used to categorize courses.</small>
            </div>
        </div>
        <div>
            <button class="btn btn-primary rounded-3 shadow-sm px-4 py-2 d-flex align-items-center gap-2 fw-medium" onclick="addNewCourseType()">
                <i class="fas fa-plus"></i> New Course Type
            </button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/CourseTypesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search course types..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this course type? Courses using it may be affected."
                    },
                    popup: {
                        title: "Course Type Details",
                        showTitle: true,
                        width: 500,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        wrapperAttr: { class: "rounded-4 shadow-lg" }
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Course Type Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Name" },
                                        editorOptions: { placeholder: "e.g. Mandatory, Elective..." },
                                        validationRules: [{ type: "required", message: "Course Type name is required" }]
                                    },
                                    {
                                        dataField: "description",
                                        label: { text: "Description" },
                                        editorType: "dxTextArea",
                                        editorOptions: {
                                            height: 100,
                                            placeholder: "Optional description for this course type..."
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Course Type Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-tag text-primary opacity-75"))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted").text(options.value || "—").appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Actions",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        function addNewCourseType() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}
