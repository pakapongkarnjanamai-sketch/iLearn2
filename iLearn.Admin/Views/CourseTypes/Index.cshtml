@{
    ViewBag.Title = "Course Types";
}

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Course Types</div>
        <div class="page-subtitle">Manage course type definitions used to categorize courses.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewCourseType()">
        <i class="fas fa-plus"></i> New Course Type
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/CourseTypesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search course types..." },
                showBorders: false,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this course type? Courses using it may be affected."
                    },
                    popup: {
                        title: "Course Type Details",
                        showTitle: true,
                        width: 500,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        wrapperAttr: { class: "rounded-4 shadow-lg" }
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Course Type Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Name" },
                                        editorOptions: { placeholder: "e.g. Mandatory, Elective..." },
                                        validationRules: [{ type: "required", message: "Course Type name is required" }]
                                    },
                                    {
                                        dataField: "description",
                                        label: { text: "Description" },
                                        editorType: "dxTextArea",
                                        editorOptions: {
                                            height: 100,
                                            placeholder: "Optional description for this course type..."
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Course Type Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-tag text-primary opacity-75"))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted").text(options.value || "—").appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Actions",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        function addNewCourseType() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}
