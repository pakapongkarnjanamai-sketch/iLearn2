@{
    ViewBag.Title = "Course Types";
}

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Course Types</div>
        <div class="page-subtitle">Manage course type definitions used to categorize courses.</div>
    </div>
    <button type="button" class="action-link primary" onclick="addNewCourseType()">
        <i class="fas fa-plus"></i> New Course Type
    </button>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Types</div>
                <div class="kpi-number" id="kpi-total">�</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">Total Courses</div>
                <div class="kpi-number" id="kpi-courses">�</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Avg. Courses / Type</div>
                <div class="kpi-number" id="kpi-avg">�</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Unused Types</div>
                <div class="kpi-number" id="kpi-unused">�</div>
            </div>
        </div>
    </div>



</div>
    <!-- ── DataGrid ── -->
   <div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>
@section Scripts {
    <script>
        let gridInstance;
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD');

        function loadSummaryStats() {
            showStatSkeleton(['kpi-total', 'kpi-courses', 'kpi-avg', 'kpi-unused']);
            $.ajax({
                url: `${serviceUrl}/admin/CourseTypesCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                $("#kpi-total").text(d.totalTypes);
                $("#kpi-courses").text(d.totalCourses);
                $("#kpi-avg").text(d.avgCoursesPerType);
                $("#kpi-unused").text(d.unusedTypes);
            }).fail(function() {
                hideStatSkeleton(['kpi-total', 'kpi-courses', 'kpi-avg', 'kpi-unused']);
            });
        }

        $(() => {
            loadSummaryStats();

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search course types...", {
                dataSource: courseTypesStore,
                remoteOperations: true,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this course type? Courses using it may be affected."
                    },
                    popup: {
                        title: "Course Type Details",
                        showTitle: true,
                        width: 480,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Course Type Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Name" },
                                        editorOptions: { placeholder: "e.g. Mandatory, Elective..." },
                                        validationRules: [{ type: "required", message: "Course Type name is required" }]
                                    },
                                    {
                                        dataField: "description",
                                        label: { text: "Description" },
                                        editorType: "dxTextArea",
                                        editorOptions: {
                                            height: 100,
                                            placeholder: "Optional description for this course type..."
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 70,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Course Type Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-tag").css({ color: "var(--accent-color)", opacity: ".75" }))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<span>").css({ color: "var(--text-secondary)", fontSize: "12px" })
                                .text(options.value || "�").appendTo(container);
                        }
                    },
                    {
                        dataField: "courseCount",
                        caption: "Courses",
                        width: 110,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: undefined,
                        cellTemplate: function(container, options) {
                            const count = options.value || 0;
                            if (count === 0) {
                                $("<span>").addClass("tag-pill pill-default").text("None").appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-success")
                                    .text(window.formatAdminCountLabel(count, 'course')).appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) { return (e.row.data.courseCount || 0) === 0; }
                            }
                        ]
                    }
                ],
                onRowInserted: () => loadSummaryStats(),
                onRowUpdated: () => loadSummaryStats(),
                onRowRemoved: () => loadSummaryStats()
            }));
        });

        function addNewCourseType() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}
