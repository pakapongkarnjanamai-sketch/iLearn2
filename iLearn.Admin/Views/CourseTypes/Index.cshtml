@{
    ViewBag.Title = "Course Types";
}

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Course Types</h1>
        <div class="page-subtitle">Manage course type definitions used to categorize courses.</div>
    </div>
    <button type="button" class="action-link primary" onclick="addNewCourseType()">
        <i class="fas fa-plus" aria-hidden="true"></i> New Course Type
    </button>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Types</div>
                <div class="kpi-number" id="kpi-total">-</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">Total Courses</div>
                <div class="kpi-number" id="kpi-courses">-</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Avg. Courses / Type</div>
                <div class="kpi-number" id="kpi-avg">-</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Unused Types</div>
                <div class="kpi-number" id="kpi-unused">-</div>
            </div>
        </div>
    </div>

    <!-- ── DataGrid ── -->
    <div class="row g-3 flex-grow-1 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>


</div>

@section Scripts {
    <script>
        let gridInstance;
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD');
        const summaryKpiIds = ['kpi-total', 'kpi-courses', 'kpi-avg', 'kpi-unused'];
        const summaryStatsCacheTtlMs = 30000;
        let summaryStatsRequest = null;
        let summaryStatsCache = null;
        let summaryStatsCacheAt = 0;

        function applySummaryStats(d) {
            $("#kpi-total").text(d.totalTypes);
            $("#kpi-courses").text(d.totalCourses);
            $("#kpi-avg").text(d.avgCoursesPerType);
            $("#kpi-unused").text(d.unusedTypes);
        }

        function loadSummaryStats(options) {
            const settings = options || {};
            const force = settings.force === true;
            const now = Date.now();
            const canUseCache = !force && summaryStatsCache && (now - summaryStatsCacheAt) < summaryStatsCacheTtlMs;

            if (canUseCache) {
                applySummaryStats(summaryStatsCache);
                return $.Deferred().resolve(summaryStatsCache).promise();
            }

            if (summaryStatsRequest) {
                return summaryStatsRequest;
            }

            showStatSkeleton(summaryKpiIds);

            summaryStatsRequest = $.ajax({
                url: `${serviceUrl}/admin/CourseTypesCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                summaryStatsCache = d || {};
                summaryStatsCacheAt = Date.now();
                applySummaryStats(summaryStatsCache);
            }).fail(function() {
                hideStatSkeleton(summaryKpiIds);
            }).always(function() {
                summaryStatsRequest = null;
            });

            return summaryStatsRequest;
        }

        $(() => {
            loadSummaryStats();

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search course types...", {
                height: "100%",
                dataSource: courseTypesStore,
                remoteOperations: true,
                editing: window.buildAdminPopupEditing({
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this course type? Courses using it may be affected."
                    },
                    popup: {
                        title: "Course Type Details",
                        width: 520
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Course Type Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Name" },
                                        editorOptions: { placeholder: "e.g. Mandatory, Elective..." },
                                        validationRules: [{ type: "required", message: "Course Type name is required" }]
                                    },
                                    {
                                        dataField: "description",
                                        label: { text: "Description" },
                                        editorType: "dxTextArea",
                                        editorOptions: {
                                            height: 100,
                                            placeholder: "Optional description for this course type..."
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                }),
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 70,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Course Type Name",
                        minWidth: 200,
                        cellTemplate: (container, options) => {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-tag").css({ color: "var(--primary-color)", opacity: ".75" }))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 200,
                        cssClass: "cell-secondary",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        dataField: "courseCount",
                        caption: "Courses",
                        width: 110,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: undefined,
                        cellTemplate: (container, options) => {
                            const count = options.value || 0;
                            window.renderAdminGridTextCell(
                                container,
                                count === 0 ? "None" : window.formatAdminCountLabel(count, 'course'),
                                count === 0 ? "captionMuted" : "captionSuccess"
                            );
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) { return (e.row.data.courseCount || 0) === 0; }
                            }
                        ]
                    }
                ],
                onRowInserted: () => loadSummaryStats({ force: true }),
                onRowUpdated: () => loadSummaryStats({ force: true }),
                onRowRemoved: () => loadSummaryStats({ force: true })
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });
        });

        function addNewCourseType() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}
