@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<style>
    /* สไตล์สำหรับการ์ดปุ่มกด (Toolbar) */
    .action-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
    }

        .action-card:hover {
            background-color: #f8f9fa !important;
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
            border-color: #adb5bd !important;
        }

    .icon-box {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    /* Preview Button Style */
    .preview-btn {
        padding: 2px 8px;
        font-size: 0.75rem;
        border-radius: 4px;
        transition: all 0.2s;
    }

        .preview-btn:hover {
            transform: scale(1.05);
        }
</style>

<!-- Header - Minimal & Clean -->
<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <i class="fas fa-tachometer-alt text-primary fs-4"></i>
                <div>
                    <h1 class="h4 mb-0">Course Dashboard</h1>
                    <small class="text-muted">Manage course information and versions</small>
                </div>
            </div>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>
</div>

<div class="container px-4 pb-4">

    <!-- Course Information + Status Badge -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                <i class="fas fa-info-circle text-primary"></i> Course Information
            </h5>
            <span id="courseStatusBadge" class="badge bg-warning">Loading...</span>
        </div>
        <div class="card-body p-4">
            <div id="courseInfoForm"></div>

            <!-- Save button -->
            <div class="d-flex justify-content-end mt-3">
                <button id="btnSaveCourse" class="btn btn-primary btn-sm shadow-sm px-4">
                    <i class="fas fa-save me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Actions (styled like Create Course page) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                <i class="fas fa-bolt text-primary"></i> Quick Actions
            </h5>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="row g-3">
                <!-- New Version -->
                <div class="col-md-3 col-sm-6">
                    <a href="javascript:void(0);" id="btnNewVersion" class="action-card d-flex align-items-center p-3 border rounded shadow-sm bg-white h-100">
                        <div class="icon-box bg-primary bg-opacity-10 me-3">
                            <i class="fas fa-code-branch text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold text-dark">New Version</h6>
                            <small class="text-muted">Create new version</small>
                        </div>
                    </a>
                </div>

                <!-- Assignments -->
                <div class="col-md-3 col-sm-6">
                    <a href="javascript:void(0);" id="btnAssignment" class="action-card d-flex align-items-center p-3 border rounded shadow-sm bg-white h-100">
                        <div class="icon-box bg-info bg-opacity-10 me-3">
                            <i class="fas fa-user-plus text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold text-dark">Assignments</h6>
                            <small class="text-muted">Manage assignments</small>
                        </div>
                    </a>
                </div>

                <!-- Publish/Close -->
                <div class="col-md-3 col-sm-6">
                    <a href="javascript:void(0);" id="btnTogglePublish" class="action-card d-flex align-items-center p-3 border rounded shadow-sm bg-white h-100">
                        <div class="icon-box bg-success bg-opacity-10 me-3" id="publishIconBox">
                            <i id="publishIcon" class="fas fa-globe text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold text-dark" id="publishBtnText">Publish Course</h6>
                            <small class="text-muted" id="publishBtnDesc">Make course active</small>
                        </div>
                    </a>
                </div>

                <!-- Delete -->
                <div class="col-md-3 col-sm-6">
                    <a href="javascript:void(0);" id="btnDeleteCourse" class="action-card d-flex align-items-center p-3 border rounded shadow-sm bg-white h-100">
                        <div class="icon-box bg-danger bg-opacity-10 me-3">
                            <i class="fas fa-trash-alt text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-1 fw-bold text-dark">Delete Course</h6>
                            <small class="text-muted">Remove permanently</small>
                        </div>
                    </a>
                </div>
            </div>

            <div id="deleteWarningMsg" class="text-danger small mt-3 text-center d-none">
              
            </div>
        </div>
    </div>

    <!-- Versions (vertical cards) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                <i class="fas fa-layer-group text-primary"></i> Versions
            </h5>
          
        </div>
        <div class="card-body p-3 bg-light">
            <div id="versionsContainer" class="row g-3">
                <div class="col-12 text-center text-muted py-4" id="versionsLoading">
                    <i class="fas fa-spinner fa-spin me-2"></i> Loading...
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/Courses';
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];

        let isCourseActive = false;

        $(async () => {
            // 1) Course Form
            const courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                items: [
                    {
                        itemType: "group",
                        colCount: 3,
                        items: [
                            { dataField: "courseCode", label: { text: "Course Code" }, isRequired: true },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: function(item) {
                                        if(!item) return "";
                                        return item.division ? `${item.division.name} - ${item.name}` : item.name;
                                    },
                                    valueExpr: "id",
                                    searchEnabled: true
                                },
                                isRequired: true
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: courseTypes, displayExpr: "name", valueExpr: "id" }
                            }
                        ]
                    },
                    { dataField: "courseName", label: { text: "Course Name" }, isRequired: true },
                    { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 80 } }
                ]
            }).dxForm("instance");

            // Load course data
            $.ajax({
                url: `${courseApiUrl}/${courseId}`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done((data) => {
                data.courseType = data.courseType !== undefined ? data.courseType : data.CourseType;
                courseForm.option("formData", data);
                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);
            });

            // 2) Save Course
            $("#btnSaveCourse").click(() => {
                if(!courseForm.validate().isValid) return;
                const data = courseForm.option("formData");

                $.ajax({
                    url: `${courseApiUrl}/${courseId}/info`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode: data.courseCode,
                        courseName: data.courseName,
                        description: data.description,
                        categoryId: data.categoryId,
                        courseType: data.courseType
                    }),
                    success: () => DevExpress.ui.notify("Course updated successfully", "success", 2000),
                    error: () => DevExpress.ui.notify("Error updating course", "error", 2000)
                });
            });

            // 3) Status Management
            function updateStatusUI(isActive) {
                const publishIcon = $("#publishIcon");
                const publishIconBox = $("#publishIconBox");
                const publishBtnText = $("#publishBtnText");
                const publishBtnDesc = $("#publishBtnDesc");
                const btnDelete = $("#btnDeleteCourse");
                const btnAssignment = $("#btnAssignment");
                const statusBadge = $("#courseStatusBadge");
                const warnMsg = $("#deleteWarningMsg");

                if(isActive) {
                    // Active
                    publishIcon.removeClass("fa-globe text-success").addClass("fa-lock text-warning");
                    publishIconBox.removeClass("bg-success bg-opacity-10").addClass("bg-warning bg-opacity-10");
                    publishBtnText.text("Close Course");
                    publishBtnDesc.text("Deactivate course");
                    statusBadge.removeClass("bg-warning").addClass("bg-success text-white").html('<i class="fas fa-check-circle me-1"></i> Active');

                    btnDelete.addClass("disabled").css("opacity", "0.5").css("pointer-events", "none");
                    btnAssignment.removeClass("disabled").css("opacity", "1").css("pointer-events", "auto");
                    warnMsg.removeClass("d-none");
                } else {
                    // Inactive
                    publishIcon.removeClass("fa-lock text-warning").addClass("fa-globe text-success");
                    publishIconBox.removeClass("bg-warning bg-opacity-10").addClass("bg-success bg-opacity-10");
                    publishBtnText.text("Publish Course");
                    publishBtnDesc.text("Make course active");
                    statusBadge.removeClass("bg-success text-white").addClass("bg-warning").html('<i class="fas fa-lock me-1"></i> Closed');

                    btnDelete.removeClass("disabled").css("opacity", "1").css("pointer-events", "auto");
                    btnAssignment.addClass("disabled").css("opacity", "0.5").css("pointer-events", "none");
                    warnMsg.addClass("d-none");
                }
            }

            // Toggle Publish
            $("#btnTogglePublish").click(function(e) {
                e.preventDefault();
                const newState = !isCourseActive;
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/status`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({ isActive: newState }),
                    success: () => {
                        isCourseActive = newState;
                        updateStatusUI(newState);
                        loadVersions();
                        DevExpress.ui.notify(newState ? "Course published" : "Course closed", "success", 2000);
                    },
                    error: (xhr) => {
                        let errorMsg = xhr.responseJSON?.message || "Error updating status";
                        DevExpress.ui.notify(errorMsg, "error", 3000);
                    }
                });
            });

            // Delete Course
            $("#btnDeleteCourse").click(function(e) {
                e.preventDefault();
                if($(this).hasClass("disabled")) return;

                const result = DevExpress.ui.dialog.confirm("Delete this course permanently?", "Confirm Delete");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        $.ajax({
                            url: `${courseApiUrl}/${courseId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true },
                            success: () => {
                                DevExpress.ui.notify("Course deleted", "success", 2000);
                                setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);
                            },
                            error: () => DevExpress.ui.notify("Error deleting course", "error", 2000)
                        });
                    }
                });
            });

            // New Version
            $("#btnNewVersion").on("click", (e) => {
                e.preventDefault();
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            });

            // Assignment
            $("#btnAssignment").click(function(e) {
                e.preventDefault();
                if($(this).hasClass("disabled")) {
                    DevExpress.ui.notify("Please publish the course first", "warning", 2000);
                    return;
                }
                window.location.href = '/Assignments/Form?courseId=' + courseId;
            });

            // 4) Load Versions - แสดงทั้งหมด (ไม่กรอง)
            function loadVersions() {
                $.ajax({
                    url: serviceUrl + '/admin/CourseVersionsCRUD/Get',
                    data: { filter: JSON.stringify(["courseId", "=", courseId]) },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const versions = res.data || [];
                    versions.sort((a,b) => b.versionNumber - a.versionNumber);

                    const container = $("#versionsContainer");
                    container.empty();

                    if(versions.length === 0) {
                        container.html('<div class="col-12 text-center text-muted py-4">No versions found. Create one to get started.</div>');
                        return;
                    }

                    versions.forEach(v => {
                        const isActive = v.isActive;

                        // Badge สำหรับสถานะ
                        const badge = isActive
                            ? '<span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i> Active</span>'
                            : '<span class="badge bg-secondary px-2 py-1">Inactive</span>';

                        // ปุ่ม Set Active (แสดงเฉพาะ version ที่ไม่ active)
                        const activeBtn = isActive
                            ? ''
                            : `<button class="btn btn-sm btn-success text-white shadow-sm" onclick="setActiveVersion(${v.id})">
                                 <i class="fas fa-check-circle me-1"></i> Set Active
                               </button>`;

                        // ปุ่ม Edit (แสดงทุก version)
                        const editBtn = `<a href="/Courses/VersionForm/${v.id}?courseId=${courseId}"
                                           class="btn btn-sm btn-outline-primary" title="Edit Version">
                                           <i class="fas fa-edit"></i>
                                         </a>`;

                        // ปุ่ม Delete (แสดงเฉพาะ version ที่ไม่ active)
                        const deleteBtn = isActive
                            ? ''
                            : `<button class="btn btn-sm btn-outline-danger" onclick="deleteVersion(${v.id})" title="Delete Version">
                                 <i class="fas fa-trash"></i>
                               </button>`;

                        const formattedDate = new Date(v.createdAt).toLocaleDateString('en-GB');

                        // สไตล์ border ต่างกันระหว่าง Active และ Inactive
                        const borderClass = isActive ? 'border-success border-2' : 'border';

                        const cardHtml = `
                            <div class="col-12">
                                <div class="card h-100 ${borderClass}">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="mb-0">Version ${v.versionNumber}</h5>
                                            <div>${badge}</div>
                                        </div>
                                        <p class="text-muted small mb-2" style="min-height:40px;">${v.note || 'No description'}</p>
                                        <p class="text-muted small mb-3"><i class="fas fa-calendar-alt me-1"></i>${formattedDate}</p>

                                        <div class="bg-light rounded p-2 mb-2" style="min-height: 60px;">
                                            <div class="small fw-bold mb-1">Attached Content</div>
                                            <div id="res-container-${v.id}" class="small"></div>
                                        </div>

                                        <div class="d-flex gap-2 justify-content-end">
                                            ${activeBtn}
                                            ${editBtn}
                                            ${deleteBtn}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        container.append(cardHtml);
                        loadVersionResources(v.id);
                    });
                });
            }

            function loadVersionResources(versionId) {
                $.ajax({
                    url: serviceUrl + '/admin/CourseResourcesCRUD/Get',
                    data: { filter: JSON.stringify(["courseVersionId", "=", versionId]), expand: "resource" },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const resources = res.data || [];
                    const resContainer = $(`#res-container-${versionId}`);
                    resContainer.empty();

                    if(resources.length === 0) {
                        resContainer.html('<span class="text-muted fst-italic">No files</span>');
                        return;
                    }

                    resources.forEach(cr => {
                        const r = cr.resource;
                        if(!r) return;

                        const icon = r.typeId === 1 ? 'fa-book text-primary' : 'fa-pen text-danger';

                        // แสดงปุ่ม Preview เฉพาะ Resource ที่ isActive = true
                        const previewBtn = r.isActive
                            ? `<button class="btn btn-outline-info preview-btn ms-auto"
                                 onclick="window.viewContent(${r.id}, '${r.name.replace(/'/g, "\\'")}')"
                                 title="Preview Content">
                                 <i class="fas fa-play me-1"></i> Preview
                               </button>`
                            : '<span class="badge bg-secondary ms-auto">Not Published</span>';

                        resContainer.append(`
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fas ${icon}" style="width:16px;"></i>
                                <span class="text-truncate" style="flex:1;" title="${r.name}">${r.name}</span>
                                ${previewBtn}
                            </div>
                        `);
                    });
                });
            }

            // Preview Content (เหมือน Resource Library)
            window.viewContent = function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;

                if (resourceName.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading Content...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content URL...</div>";
                    }

                    $.ajax({
                        url: apiUrl,
                        method: "GET",
                        xhrFields: { withCredentials: true },
                        success: function(response) {
                            if (response && response.url) {
                                if (win) win.location.href = response.url;
                            } else {
                                if (win) win.close();
                                DevExpress.ui.notify("Content URL not found.", "error", 3000);
                            }
                        },
                        error: function() {
                            if (win) win.close();
                            DevExpress.ui.notify("Failed to get content link.", "error", 3000);
                        }
                    });
                } else {
                    window.open(apiUrl, '_blank');
                }
            };

            // Set Active Version
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true },
                    success: function() {
                        DevExpress.ui.notify("Active version updated!", "success", 2000);
                        loadVersions();
                    }
                });
            };

            // Delete Version
            window.deleteVersion = function(vId) {
                const result = DevExpress.ui.dialog.confirm("Delete this version? This action cannot be undone.", "Confirm Delete");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        $.ajax({
                            url: serviceUrl + '/admin/CourseVersionsCRUD/Delete',
                            type: 'DELETE',
                            data: { key: vId },
                            xhrFields: { withCredentials: true },
                            success: function() {
                                DevExpress.ui.notify("Version deleted.", "success", 2000);
                                loadVersions();
                            }
                        });
                    }
                });
            };

            // Initialize
            loadVersions();
        });
    </script>
}