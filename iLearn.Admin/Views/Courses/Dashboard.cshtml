@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;" id="pageTitle">Course Dashboard</div>
        <div class="text-secondary" style="font-size:12px;" id="pageSubtitle">Manage course information and versions</div>
    </div>
    <a href="@Url.Action("Index", "Courses")" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back to Courses
    </a>
</div>



<div class="container-fluid px-4 py-4" style="max-width:1400px;">

    <div class="row g-3 mb-4">

        <!-- Course Information Form -->
        <div class="col-lg-8">
            <div class="border rounded bg-white h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title mb-0" style="border:none; padding:0;">Course Information</div>
                    <span id="courseStatusBadge" style="font-size:11px; padding:2px 10px; border-radius:20px;
                          background:#fafafa; border:1px solid #f0f0f0; color:#595959; font-weight:600;">
                        <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                    </span>
                </div>
                <div id="courseInfoForm"></div>
                <div class="text-end mt-3 pt-3" style="border-top:1px solid var(--border-color);">
                    <a href="javascript:void(0);" id="btnSaveCourse" class="action-link primary">
                        <i class="fas fa-save"></i> Save Changes
                    </a>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Quick Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btnNewVersion" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);">
                            <i class="fas fa-code-branch"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">New Version</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Create a new content version</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnAssignment" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">Assignments</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Assign course to employees</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnTogglePublish" class="quick-action">
                        <div class="qa-icon" id="publishIconBox" style="background:#fafafa; color:var(--text-secondary);">
                            <i id="publishIcon" class="fas fa-globe"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);" id="publishBtnText">Publish Course</div>
                            <div style="font-size:11px; color:var(--text-secondary);" id="publishBtnDesc">Make course available</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnDeleteCourse" class="quick-action danger">
                        <div class="qa-icon" style="background:#fff2f0; color:var(--danger-color);">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">Delete Course</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Remove permanently</div>
                        </div>
                    </a>

                </div>

                <div id="warningMsg" class="mt-3 pt-3 d-none" style="border-top:1px solid var(--border-color); font-size:11px; color:var(--warning-color);">
                    <i class="fas fa-exclamation-triangle me-1"></i> Cannot delete an active course.
                </div>
            </div>
        </div>

    </div>

    <!-- Content Versions -->
    <div class="border rounded bg-white p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="section-title mb-0" style="border:none; padding:0;">Content Versions</div>
            <a href="javascript:void(0);" id="btnNewVersionHeader" class="action-link primary">
                <i class="fas fa-plus"></i> New Version
            </a>
        </div>
        <div id="versionsContainer" class="row g-3">
            <div class="col-12 text-center py-5" style="color:var(--text-secondary);">
                <i class="fas fa-circle-notch fa-spin fa-lg mb-3" style="color:var(--accent-color); display:block;"></i>
                Loading versions...
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/courses';

        const divisionsStore  = createDataStore(serviceUrl, 'admin/DivisionsCRUD',  { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        let isCourseActive = false;
        let courseForm;

        $(async () => {

            // ── 1. Build form ──────────────────────────────────────────
            courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 1,
                items: [
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: function(e) {
                                        const catEditor = courseForm.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();
                                        if (e.event) catEditor.option("value", null);
                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    disabled: true,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                }
                            }
                        ]
                    },
                    {
                        dataField: "courseName",
                        label: { text: "Course Name" },
                        validationRules: [{ type: "required", message: "Course Name is required" }],
                        editorOptions: { placeholder: "e.g. Introduction to Cybersecurity" }
                    },
                    {
                        dataField: "description",
                        label: { text: "Description" },
                        editorType: "dxTextArea",
                        editorOptions: { height: 90, placeholder: "Course summary and objectives..." }
                    }
                ]
            }).dxForm("instance");

            // ── 2. Load course data ────────────────────────────────────
            try {
                const response = await $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                const data = response.data || response;

                // Update page header with course title
                $("#pageTitle").text(data.courseName || "Course Dashboard");
                $("#pageSubtitle").text(data.courseCode ? `Code: ${data.courseCode}` : "Manage course information and versions");

                // Resolve divisionId from category if needed
                let divisionId = data.divisionId || null;
                if (!divisionId && data.categoryId) {
                    try {
                        const catData = await $.ajax({
                            url: `${serviceUrl}/admin/CategoriesCRUD/Get/${data.categoryId}`,
                            type: 'GET',
                            xhrFields: { withCredentials: true }
                        });
                        divisionId = catData.divisionId || null;
                    } catch(e) { /* ignore */ }
                }

                // Pre-enable category editor if we have a division
                if (divisionId) {
                    const catEditor = courseForm.getEditor("categoryId");
                    catEditor.option("disabled", false);
                    catEditor.getDataSource().filter(["divisionId", "=", divisionId]);
                    catEditor.getDataSource().load();
                }

                courseForm.option("formData", {
                    divisionId:   divisionId,
                    courseCode:   data.courseCode,
                    courseName:   data.courseName,
                    description:  data.description,
                    categoryId:   data.categoryId,
                    courseType:   data.courseType
                });

                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);

            } catch(xhr) {
                DevExpress.ui.notify("Error loading course: " + (xhr.responseJSON?.message || "Unknown error"), "error", 3000);
            }

            // ── 3. Save ────────────────────────────────────────────────
            $("#btnSaveCourse").on("click", function() {
                if (!courseForm.validate().isValid) {
                    DevExpress.ui.notify("Please fill in all required fields.", "warning", 2000);
                    return;
                }
                const fd = courseForm.option("formData");
                const $btn = $(this).css("opacity", 0.6).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode:  fd.courseCode,
                        courseName:  fd.courseName,
                        description: fd.description,
                        categoryId:  fd.categoryId,
                        courseType:  fd.courseType,
                        resourceIds: []
                    })
                }).done(() => {
                    DevExpress.ui.notify("Course updated successfully.", "success", 2000);
                    $("#pageTitle").text(fd.courseName || "Course Dashboard");
                    $("#pageSubtitle").text(fd.courseCode ? `Code: ${fd.courseCode}` : "Manage course information and versions");
                }).fail((xhr) => {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "Error updating course.", "error", 3000);
                }).always(() => {
                    $btn.css("opacity", 1).html('<i class="fas fa-save"></i> Save Changes');
                });
            });



            // ── 4. Status UI helpers ───────────────────────────────────
            function updateStatusUI(isActive) {
                const $publishIcon    = $("#publishIcon");
                const $publishIconBox = $("#publishIconBox");
                const $publishBtnText = $("#publishBtnText");
                const $publishBtnDesc = $("#publishBtnDesc");
                const $btnDelete      = $("#btnDeleteCourse");
                const $btnAssignment  = $("#btnAssignment");
                const $statusBadge    = $("#courseStatusBadge");
                const $warnMsg        = $("#warningMsg");

                if (isActive) {
                    $publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    $publishIconBox.css({ background: "#fffbe6", color: "var(--warning-color)" });
                    $publishBtnText.text("Close Course");
                    $publishBtnDesc.text("Deactivate — stop new learners");
                    $statusBadge.css({ background: "#f6ffed", color: "var(--success-color)",
                                       border: "1px solid #b7eb8f" })
                                .html('<i class="fas fa-check-circle me-1"></i> Active');

                    $btnDelete.addClass("disabled").css("opacity", 0.4).css("pointer-events", "none");
                    $btnAssignment.removeClass("disabled").css({ opacity: 1, pointerEvents: "" });
                    $warnMsg.removeClass("d-none");
                } else {
                    $publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    $publishIconBox.css({ background: "#fafafa", color: "var(--text-secondary)" });
                    $publishBtnText.text("Publish Course");
                    $publishBtnDesc.text("Make course available");
                    $statusBadge.css({ background: "#fafafa", color: "var(--text-secondary)",
                                       border: "1px solid var(--border-color)" })
                                .html('<i class="fas fa-lock me-1"></i> Closed');

                    $btnDelete.removeClass("disabled").css({ opacity: 1, pointerEvents: "" });
                    $btnAssignment.addClass("disabled").css("opacity", 0.4).css("pointer-events", "none");
                    $warnMsg.addClass("d-none");
                }
            }

           // ── 5. Toggle Publish ──────────────────────────────────────
            $("#btnTogglePublish").click(function(e) {
                e.preventDefault();
                const $btn = $(this);

                if ($btn.hasClass("disabled")) return;
                $btn.addClass("disabled opacity-50 pe-none");

                const newState  = !isCourseActive;
                const confirmMsg = newState
                    ? "Publish this course?"
                    : "Close this course?";

                DevExpress.ui.dialog.confirm(confirmMsg, "Confirm Status Change").done(function(ok) {
                    if (!ok) { $btn.removeClass("disabled opacity-50 pe-none"); return; }

                    $.ajax({
                        url: `${courseApiUrl}/${courseId}/status`,
                        type: 'PUT', // 🌟 [แก้ไขที่นี่ 1] เปลี่ยนจาก 'PATCH' เป็น 'PUT'
                        contentType: 'application/json',
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({ isActive: newState })
                    }).done((response) => { // 🌟 รับ response แบบ ApiResponse
                        isCourseActive = newState;
                        updateStatusUI(isCourseActive);

                        // 🌟 ดึง message จาก response.message ถ้ามี
                        const successMsg = response.message || (newState ? "Course published!" : "Course closed.");
                        DevExpress.ui.notify(successMsg, "success", 2000);

                        $btn.removeClass("disabled opacity-50 pe-none");
                    }).fail((xhr) => {
                        // 🌟 [แก้ไขที่นี่ 2] ปรับการดึงข้อความ Error จาก ApiResponse ให้ครอบคลุมมากขึ้น
                        let errorMsg = "Error updating status.";
                        if (xhr.responseJSON) {
                            // ถ้า API ส่ง ApiResponse กลับมาในรูปแบบ { success: false, message: "..." }
                            errorMsg = xhr.responseJSON.message || errorMsg;
                        } else if (xhr.responseText) {
                            // กรณีที่ error เป็น text ธรรมดา
                            errorMsg = xhr.responseText;
                        }

                        DevExpress.ui.notify(errorMsg, "error", 4000); // เพิ่มเวลาแสดงผลเป็น 4 วินาทีเพื่อให้อ่านทัน
                        $btn.removeClass("disabled opacity-50 pe-none");
                    });
                });
            });

            // ── 6. Delete Course ───────────────────────────────────────
            $("#btnDeleteCourse").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) return;

                DevExpress.ui.dialog.confirm("Delete this course permanently? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${courseApiUrl}/${courseId}`,
                        type: 'DELETE',
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        DevExpress.ui.notify("Course deleted.", "success", 2000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1500);
                    }).fail((xhr) => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Error deleting course.", "error", 3000);
                    });
                });
            });

            // ── 7. Navigation buttons ──────────────────────────────────
            const goNewVersion = () => {
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            };
            $("#btnNewVersion").on("click", (e) => { e.preventDefault(); goNewVersion(); });
            $("#btnNewVersionHeader").on("click", goNewVersion);

            $("#btnAssignment").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    DevExpress.ui.notify("Please publish the course before managing assignments.", "warning", 2500);
                    return;
                }
                window.location.href = '@Url.Action("Form", "Assignments")?courseId=' + courseId;
            });

            // ── 8. Load Versions ───────────────────────────────────────
            function loadVersions() {
                $.ajax({
                    url: `${serviceUrl}/admin/CourseVersionsCRUD/Get`,
                    data: { filter: JSON.stringify(["courseId", "=", courseId]) },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const rawData = res.data || res;
                    const versions = Array.isArray(rawData) ? rawData : (rawData.data || []);
                    versions.sort((a, b) => b.versionNumber - a.versionNumber);

                    const $container = $("#versionsContainer").empty();

                    if (versions.length === 0) {
                        $container.html(`
                            <div class="col-12 text-center py-5" style="color:var(--text-secondary);">
                                <i class="fas fa-layer-group fa-2x mb-3" style="opacity:0.2; display:block;"></i>
                                <div class="mb-3" style="font-size:13px;">No versions yet.</div>
                                <a href="javascript:void(0);" class="action-link primary" onclick="$('#btnNewVersion').trigger('click')">
                                    <i class="fas fa-plus"></i> Create First Version
                                </a>
                            </div>`);
                        return;
                    }

                    versions.forEach(v => {
                        const isActive = v.isActive;

                        const activeBadge = isActive
                            ? `<span style="font-size:11px; padding:2px 8px; border-radius:3px;
                                   background:#e6f4ff; color:var(--accent-color);
                                   border:1px solid #91d5ff; font-weight:600;">
                                   <i class="fas fa-check-circle me-1"></i>Active
                               </span>`
                            : `<span style="font-size:11px; padding:2px 8px; border-radius:3px;
                                   background:var(--bg-light); color:var(--text-secondary);
                                   border:1px solid var(--border-color); font-weight:500;">Draft</span>`;

                        const editItem = `
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="@Url.Action("VersionForm", "Courses")?id=${v.id}&courseId=${courseId}">
                                    <i class="fas fa-edit" style="width:16px; color:var(--warning-color);"></i>
                                    <span style="font-size:12px;">Edit</span>
                                </a>
                            </li>`;

                        const inactiveItems = !isActive ? `
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0);" onclick="setActiveVersion(${v.id})">
                                    <i class="fas fa-check-circle" style="width:16px; color:var(--accent-color);"></i>
                                    <span style="font-size:12px;">Set as Active</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="javascript:void(0);" onclick="deleteVersion(${v.id})">
                                    <i class="fas fa-trash-alt" style="width:16px;"></i>
                                    <span style="font-size:12px;">Delete</span>
                                </a>
                            </li>` : '';

                        const cardHtml = `
                            <div class="col-md-6 col-xl-4">
                                <div class="version-card ${isActive ? "active" : ""}">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <div style="font-size:14px; font-weight:700; color:var(--text-primary); margin-bottom:4px;">
                                                Version ${v.versionNumber}
                                            </div>
                                            ${activeBadge}
                                        </div>
                                        <div class="dropdown">
                                            <button class="btn btn-sm p-1 text-secondary" style="background:none; border:none;"
                                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-ellipsis-v" style="font-size:12px;"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-1 mt-1"
                                                style="border-color:var(--border-color) !important; border-radius:4px; min-width:160px;">
                                                ${editItem}${inactiveItems}
                                            </ul>
                                        </div>
                                    </div>

                                    <div style="font-size:11px; color:var(--text-secondary); min-height:32px;
                                                padding: 8px 0; border-bottom:1px solid var(--border-color); margin-bottom:10px;">
                                        ${v.note ? v.note : '<span style="opacity:0.5; font-style:italic;">No description</span>'}
                                    </div>

                                    <div id="res-container-${v.id}">
                                        <span style="font-size:11px; color:var(--text-secondary);">
                                            <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                                        </span>
                                    </div>
                                </div>
                            </div>`;

                        $container.append(cardHtml);
                        loadVersionResources(v.id);
                    });

                }).fail(function() {
                    $("#versionsContainer").html('<div class="col-12 text-center text-danger py-4">Error loading versions.</div>');
                });
            }

            function loadVersionResources(versionId) {
                $.ajax({
                    url: `${serviceUrl}/admin/CourseResourcesCRUD/Get`,
                    data: { filter: JSON.stringify(["courseVersionId", "=", versionId]), expand: "resource" },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const rawData  = res.data || res;
                    const resources = Array.isArray(rawData) ? rawData : (rawData.data || []);
                    const $cont    = $(`#res-container-${versionId}`).empty();

                    if (resources.length === 0) {
                        $cont.html('<span class="text-muted fst-italic opacity-75">No files attached</span>');
                        return;
                    }

                    resources.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

                    resources.forEach((cr, idx) => {
                        const r = cr.resource;
                        if (!r) return;

                        const order     = cr.order ?? (idx + 1);
                        const typeColor = r.typeId === 1 ? "#1890ff" : "#faad14";
                        const typeName  = r.typeId === 1 ? "Learn" : "Exam";
                        const previewBtn = r.isActive
                            ? `<a href="javascript:void(0);" onclick="window.viewContent(${r.id},'${r.name.replace(/'/g, "\\'")}')"
                                  style="font-size:11px; color:var(--accent-color); flex-shrink:0;" title="Preview">
                                   <i class="fas fa-external-link-alt"></i>
                               </a>`
                            : '';

                        $cont.append(`
                            <div class="d-flex align-items-center gap-2 mb-1"
                                 style="padding:5px 8px; border:1px solid var(--border-color);
                                        border-radius:3px; background:#fff; font-size:11px;">
                                <span style="min-width:18px; font-weight:600; color:var(--text-secondary);
                                             text-align:center;">${order}</span>
                                <span class="text-truncate flex-grow-1"
                                      style="color:var(--text-primary); font-weight:500;" title="${r.name}">${r.name}</span>
                                <span style="flex-shrink:0; font-size:10px; padding:1px 6px; border-radius:3px;
                                             background:${r.typeId === 1 ? "#e6f4ff" : "#fffbe6"};
                                             color:${typeColor}; font-weight:600;">${typeName}</span>
                                ${previewBtn}
                            </div>`);
                    });

                }).fail(function() {
                    $(`#res-container-${versionId}`).html('<span class="text-danger small">Error loading files</span>');
                });
            }

            // ── 9. Preview content ─────────────────────────────────────
            window.viewContent = function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;
                if (resourceName.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content...</div>";
                    }
                    $.ajax({ url: apiUrl, method: "GET", xhrFields: { withCredentials: true } })
                        .done(res => { if (res?.url && win) win.location.href = res.url; else { if (win) win.close(); DevExpress.ui.notify("Content URL not found.", "error", 3000); } })
                        .fail(() => { if (win) win.close(); DevExpress.ui.notify("Failed to get content link.", "error", 3000); });
                } else {
                    window.open(apiUrl, '_blank');
                }
            };

            // ── 10. Version actions ────────────────────────────────────
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true }
                }).done(() => {
                    DevExpress.ui.notify("Active version updated.", "success", 2000);
                    loadVersions();
                }).fail((xhr) => {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "Error updating active version.", "error", 3000);
                });
            };

            window.deleteVersion = function(vId) {
                DevExpress.ui.dialog.confirm("Delete this version? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${serviceUrl}/admin/CourseVersionsCRUD/Delete`,
                        type: 'DELETE',
                        data: { key: vId },
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        DevExpress.ui.notify("Version deleted.", "success", 2000);
                        loadVersions();
                    }).fail((xhr) => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Error deleting version.", "error", 3000);
                    });
                });
            };

            loadVersions();
        });
    </script>
}