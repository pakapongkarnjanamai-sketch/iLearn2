@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* สไตล์การ์ดปุ่มกด (Quick Actions) */
    .action-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent; /* เตรียมขอบไว้สำหรับ Hover */
    }

        .action-card:hover {
            transform: translateY(-4px);
            border-color: #0d6efd !important; /* เปลี่ยนสีกรอบเป็นสีน้ำเงินตอน Hover */
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }

 
</style>

<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-book-open fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold text-dark">Course Dashboard</h1>
                    <small class="text-muted">Manage course information and versions</small>
                </div>
            </div>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3">
                <i class="fas fa-arrow-left me-1"></i> Back to Courses
            </a>
        </div>
    </div>
</div>

<div class="container px-4 pb-4">

    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.15rem;">
                        Course Information
                    </h5>
                    <span id="courseStatusBadge" class="badge bg-secondary fw-normal px-3 py-2 rounded-pill">Loading...</span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div id="courseInfoForm"></div>

                    <div class="text-end mt-4 pt-3 border-top">
                        <button id="btnSaveCourse" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="bg-white p-4 rounded-4 shadow-sm h-100">
                <h5 class="fw-bold text-dark mb-4" style="font-size: 1.15rem;">
                    Quick Actions
                </h5>
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-12">
                        <a href="javascript:void(0);" id="btnNewVersion" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary me-3">
                                <i class="fas fa-code-branch fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold text-dark">New Version</h6>
                                <small class="text-muted" style="font-size: 0.8rem;">Create new version</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-12">
                        <a href="javascript:void(0);" id="btnAssignment" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary me-3">
                                <i class="fas fa-user-plus fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold text-dark">Assignments</h6>
                                <small class="text-muted" style="font-size: 0.8rem;">Manage assignments</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-12">
                        <a href="javascript:void(0);" id="btnTogglePublish" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-secondary bg-opacity-10 text-secondary me-3" id="publishIconBox">
                                <i id="publishIcon" class="fas fa-globe fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold text-dark" id="publishBtnText">Publish Course</h6>
                                <small class="text-muted" id="publishBtnDesc" style="font-size: 0.8rem;">Make course active</small>
                            </div>
                        </a>
                    </div>

                    <div class="col-12 col-sm-6 col-lg-12">
                        <a href="javascript:void(0);" id="btnDeleteCourse" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none border border-light">
                            <div class="icon-box bg-danger bg-opacity-10 text-danger me-3">
                                <i class="fas fa-trash-alt fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold text-dark">Delete Course</h6>
                                <small class="text-muted" style="font-size: 0.8rem;">Remove permanently</small>
                            </div>
                        </a>
                    </div>
                </div>

                <div id="warningMsg" class="text-muted small mt-3 px-1 d-none">
                    <i class="fas fa-info-circle text-primary me-1"></i> You cannot delete an active course.
                </div>
            </div>
        </div>

    </div>

  
        <div class="card-body pb-4">
            <div id="versionsContainer" class="row g-4">
                <div class="col-12 text-center text-muted py-5">
                    <i class="fas fa-circle-notch fa-spin fa-2x mb-2 text-primary"></i>
                    <p class="mb-0">Loading versions...</p>
                </div>
            </div>
        </div>


</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/courses';
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];

        let isCourseActive = false;

        $(async () => {
            // Course Form
            const courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                items: [
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                         
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: function(item) {
                                        if(!item) return "";
                                        return item.division ? `${item.division.name} - ${item.name}` : item.name;
                                    },
                                    valueExpr: "id",
                                    searchEnabled: true
                                },
                                isRequired: true
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: courseTypes, displayExpr: "name", valueExpr: "id" }
                            }
                        ]
                    },
                       { dataField: "courseCode", label: { text: "Course Code" }, isRequired: true },
                    { dataField: "courseName", label: { text: "Course Name" }, isRequired: true },
                    { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 80 } }
                ]
            }).dxForm("instance");

            // Load course - API สาย ICourseService ที่ส่งค่า courseDetailDto
            $.ajax({
                url: `${courseApiUrl}/${courseId}`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done((response) => {
                // Response format: { success: true, data: CourseDetailDto }
                const data = response.data || response;
                
                // Map API response ให้สอดคล้องกับ Form
                courseForm.option("formData", {
                    courseCode: data.courseCode,
                    courseName: data.courseName,
                    description: data.description,
                    categoryId: data.categoryId,
                    courseType: data.courseType
                });
                
                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);
            }).fail((xhr) => {
                DevExpress.ui.notify("Error loading course: " + (xhr.responseJSON?.message || "Unknown error"), "error", 3000);
            });

            // Save - ใช้ API ใหม่ (PUT /api/courses/{id})
            $("#btnSaveCourse").click(() => {
                if(!courseForm.validate().isValid) return;
                const data = courseForm.option("formData");

                $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode: data.courseCode,
                        courseName: data.courseName,
                        description: data.description,
                        categoryId: data.categoryId,
                        courseType: data.courseType,
                        resourceIds: [] // ถ้ามีการจัดการ Resource ให้ส่งไปด้วย
                    }),
                    success: (response) => {
                        DevExpress.ui.notify("Course updated successfully", "success", 2000);
                    },
                    error: (xhr) => {
                        const errorMsg = xhr.responseJSON?.message || "Error updating course";
                        DevExpress.ui.notify(errorMsg, "error", 3000);
                    }
                });
            });

            // Status UI (ปรับให้ใช้สี Primary/Secondary แทน เขียว/แดง/เหลือง)
            function updateStatusUI(isActive) {
                const publishIcon = $("#publishIcon");
                const publishIconBox = $("#publishIconBox");
                const publishBtnText = $("#publishBtnText");
                const publishBtnDesc = $("#publishBtnDesc");
                const btnDelete = $("#btnDeleteCourse");
                const btnAssignment = $("#btnAssignment");
                const statusBadge = $("#courseStatusBadge");
                const warnMsg = $("#warningMsg");

                if(isActive) {
                    publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    publishIconBox.removeClass("bg-primary text-primary").addClass("bg-secondary text-secondary");
                    publishBtnText.text("Close Course");
                    publishBtnDesc.text("Deactivate course");
                    statusBadge.removeClass("bg-secondary").addClass("bg-primary").html('<i class="fas fa-check-circle me-1"></i> Active');

                    btnDelete.addClass("disabled opacity-50 pe-none");
                    btnAssignment.removeClass("disabled opacity-50 pe-none");
                    warnMsg.removeClass("d-none");
                } else {
                    publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    publishIconBox.removeClass("bg-secondary text-secondary").addClass("bg-primary text-primary");
                    publishBtnText.text("Publish Course");
                    publishBtnDesc.text("Make course active");
                    statusBadge.removeClass("bg-primary").addClass("bg-secondary").html('<i class="fas fa-lock me-1"></i> Closed');

                    btnDelete.removeClass("disabled opacity-50 pe-none");
                    btnAssignment.addClass("disabled opacity-50 pe-none");
                    warnMsg.addClass("d-none");
                }
            }

          // Toggle Publish - ใช้ API ใหม่ (PATCH /api/courses/{id}/status)
            $("#btnTogglePublish").click(function(e) {
                e.preventDefault();

                // 1. ป้องกันการกดปุ่มซ้ำรัวๆ
                const $btn = $(this);
                if ($btn.hasClass("disabled")) return;
                $btn.addClass("disabled opacity-50 pe-none");

                // 2. กำหนดสถานะใหม่ที่กำลังจะเปลี่ยนไป
                const newState = !isCourseActive;

                // 3. ข้อความแจ้งเตือนให้ผู้ใช้ยืนยัน
                const confirmMsg = newState
                    ? "ต้องการเปิดใช้งาน (Publish) หลักสูตรนี้ใช่หรือไม่? พนักงานจะสามารถเข้าเรียนได้ทันที"
                    : "ต้องการปิด (Close) หลักสูตรนี้ใช่หรือไม่? พนักงานจะไม่สามารถเข้าเรียนได้ชั่วคราว";

                // 4. เรียกใช้ Dialog ของ DevExtreme เพื่อให้หน้าเว็บมีการตอบสนอง
                const result = DevExpress.ui.dialog.confirm(confirmMsg, "ยืนยันการเปลี่ยนสถานะ");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        // ดำเนินการเรียก API
                        $.ajax({
                            url: `${courseApiUrl}/${courseId}/status`,
                            type: 'PATCH',
                            contentType: 'application/json',
                            xhrFields: { withCredentials: true },
                            data: JSON.stringify({ isActive: newState }),
                            success: (response) => {
                                const message = newState ? "เปิดใช้งานหลักสูตรสำเร็จ!" : "ปิดหลักสูตรสำเร็จ!";
                                DevExpress.ui.notify(message, "success", 1500);

                                // 🌟 5. สั่งรีเฟรชหน้าจอ (Reload) เพื่อให้สถานะทุกส่วนอัปเดตใหม่ทั้งหมด
                                setTimeout(() => window.location.reload(), 1500);
                            },
                            error: (xhr) => {
                                const errorMsg = xhr.responseJSON?.message || "เกิดข้อผิดพลาดในการเปลี่ยนสถานะ";
                                DevExpress.ui.notify(errorMsg, "error", 3000);
                                // ปลดล็อคปุ่มกรณีเกิด Error
                                $btn.removeClass("disabled opacity-50 pe-none");
                            }
                        });
                    } else {
                        // ผู้ใช้กดยกเลิก ให้ปลดล็อคปุ่ม
                        $btn.removeClass("disabled opacity-50 pe-none");
                    }
                });
            });

            // Delete - ใช้ API ใหม่ (DELETE /api/courses/{id})
            $("#btnDeleteCourse").click(function(e) {
                e.preventDefault();
                if($(this).hasClass("disabled")) return;

                const result = DevExpress.ui.dialog.confirm("Delete this course permanently?", "Confirm Delete");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        $.ajax({
                            url: `${courseApiUrl}/${courseId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true },
                            success: (response) => {
                                DevExpress.ui.notify("Course deleted successfully", "success", 2000);
                                setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);
                            },
                            error: (xhr) => {
                                const errorMsg = xhr.responseJSON?.message || "Error deleting course";
                                DevExpress.ui.notify(errorMsg, "error", 3000);
                            }
                        });
                    }
                });
            });

            // New Version
            $("#btnNewVersion").on("click", (e) => {
                e.preventDefault();
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            });

            // Assignment - ใช้ API ใหม่ (POST /api/courses/{id}/assign-now)
         // Assignment - ลิงก์ไปยังหน้า Form ของ Assignments
            $("#btnAssignment").click(function(e) {
                e.preventDefault();

                // ตรวจสอบว่าคอร์สถูก Publish หรือยัง (บังคับให้ต้องเปิดคอร์สก่อนถึงจะมอบหมายได้)
                if($(this).hasClass("disabled")) {
                    DevExpress.ui.notify("Please publish the course first", "warning", 2000);
                    return;
                }

                // ส่ง courseId ไปที่หน้า Form เพื่อให้ระบบรู้ว่ากำลังจะมอบหมายงานของคอร์สไหน
                window.location.href = '@Url.Action("Form", "Assignments")?courseId=' + courseId;
            });

          // Load Versions - ยังใช้ endpoint เดิมของ admin/CourseVersionsCRUD
            function loadVersions() {
                $.ajax({
                    url: serviceUrl + '/admin/CourseVersionsCRUD/Get',
                    data: { filter: JSON.stringify(["courseId", "=", courseId]) },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const versions = (res.data || res) instanceof Array ? (res.data || res) : [];
                    versions.sort((a,b) => b.versionNumber - a.versionNumber);

                    const container = $("#versionsContainer");
                    container.empty();

                    if(versions.length === 0) {
                        container.html('<div class="col-12 text-center text-muted py-5"><i class="fas fa-inbox fa-2x mb-3 text-light"></i><br>No versions found. Create one to get started.</div>');
                        return;
                    }
                            versions.forEach(v => {
            const isActive = v.isActive;
            const activeBorderClass = isActive ? 'border-start border-primary border-4' : 'border border-light';

            // 1. จัดการ Dropdown Menu (ให้อยู่ใน Dropdown ทั้งหมด)
            // เมนู Edit (มีในทุกสถานะ)
            let dropdownItems = `
                <li>
                    <a class="dropdown-item py-2 fw-bold text-dark d-flex align-items-center" href="@Url.Action("VersionForm", "Courses")?id=${v.id}&courseId=${courseId}">
                        <div class="icon-box bg-warning bg-opacity-10 text-warning me-2" style="width: 26px; height: 26px; border-radius: 5px; font-size: 0.75rem;">
                            <i class="fas fa-edit"></i>
                        </div>
                        Edit
                    </a>
                </li>
            `;

            // ถ้ายังไม่ Active ให้เพิ่มปุ่ม Set Active และ Delete เข้าไปใน Dropdown
            if (!isActive) {
                dropdownItems = `
                    <li>
                        <a class="dropdown-item py-2 fw-bold text-dark d-flex align-items-center" href="javascript:void(0);" onclick="setActiveVersion(${v.id})">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary me-2" style="width: 26px; height: 26px; border-radius: 5px; font-size: 0.75rem;">
                                <i class="fas fa-check"></i>
                            </div>
                            Set Active
                        </a>
                    </li>
                    ${dropdownItems}
                    <li><hr class="dropdown-divider opacity-25 my-1"></li>
                    <li>
                        <a class="dropdown-item py-2 fw-bold text-danger d-flex align-items-center" href="javascript:void(0);" onclick="deleteVersion(${v.id})">
                            <div class="icon-box bg-danger bg-opacity-10 text-danger me-2" style="width: 30px; height: 30px; border-radius: 6px;">
                                <i class="fas fa-trash-alt"></i>
                            </div>
                            Delete
                        </a>
                    </li>
                `;
            }

            const rightContent = `
                <div class="dropdown">
                    <button class="btn btn-light btn-sm text-secondary border-0 px-2 py-1 rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Options">
                        <i class="fas fa-ellipsis-v fs-6"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 py-2 mt-1">
                        ${dropdownItems}
                    </ul>
                </div>
            `;

            // 2. ย้ายไอคอน Active มาไว้ข้างหน้าชื่อ Version
            const activeIcon = isActive
                ? `<i class="fas fa-check-circle text-primary me-2 fs-5" title="Active Version"></i>`
                : '';

            const cardHtml = `
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 ${activeBorderClass}" style="background-color: ${isActive ? '#fff' : '#fafafa'};">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="pe-2 d-flex align-items-center">
                                    ${activeIcon}
                                    <h6 class="mb-0 fw-bold text-dark fs-5">Version ${v.versionNumber}</h6>
                                </div>
                                <div class="text-end" style="min-width: 40px;">
                                    ${rightContent}
                                </div>
                            </div>

                            <p class="text-muted small mb-3 pb-3 border-bottom" style="min-height: 40px;">${v.note || '<span class="fst-italic">No description</span>'}</p>

                            <div>
                                <div id="res-container-${v.id}" class="small"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            container.append(cardHtml);
            loadVersionResources(v.id);
        });
                   
                }).fail(function(xhr) {
                    console.error("Error loading versions:", xhr);
                    const container = $("#versionsContainer");
                    container.html('<div class="col-12 text-center text-danger py-5">Error loading versions</div>');
                });
            }

                  function loadVersionResources(versionId) {
            $.ajax({
                url: serviceUrl + '/admin/CourseResourcesCRUD/Get',
                data: { filter: JSON.stringify(["courseVersionId", "=", versionId]), expand: "resource" },
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                let resources = (res.data || res) instanceof Array ? (res.data || res) : [];
                const resContainer = $(`#res-container-${versionId}`);
                resContainer.empty();

                if(resources.length === 0) {
                    resContainer.html('<span class="text-muted fst-italic">No files</span>');
                    return;
                }

                // [เพิ่มใหม่] เรียงลำดับตาม Property Order จากน้อยไปมาก
                // ถ้าข้อมูลเก่าไม่มี order ให้จัดการเผื่อไว้ (fallback เป็น 0)
                resources.sort((a, b) => (a.order || 0) - (b.order || 0));

                resources.forEach((cr, index) => {
                    const r = cr.resource;
                    if(!r) return;

                    // นำลำดับจาก Database มาโชว์ ถ้าไม่มีให้ใช้ index + 1
                    const orderNumber = cr.order !== undefined && cr.order !== null ? cr.order : (index + 1);

                    const icon = r.typeId === 1 ? 'fa-book text-secondary' : 'fa-file-alt text-secondary';
                    const previewBtn = r.isActive ? `<button class="btn btn-sm btn-link text-primary p-0 ms-2 text-decoration-none" onclick="window.viewContent(${r.id}, '${r.name.replace(/'/g, "\\'")}')" title="Preview">Preview</button>` : '';

                    // [เพิ่มส่วนแสดง Order Badge] <span class="badge bg-light text-dark border me-2">${orderNumber}</span>
                    resContainer.append(`
                        <div class="d-flex align-items-center gap-2 mb-2 p-2 bg-white border rounded-3 shadow-sm">
                            <span class="badge bg-light text-dark border me-1" style="min-width: 25px;">${orderNumber}</span>
                            <i class="fas ${icon} ms-1"></i>
                            <span class="text-truncate flex-grow-1 text-dark" title="${r.name}">${r.name}</span>
                            ${previewBtn}
                        </div>
                    `);
                });
            }).fail(function(xhr) {
                console.error("Error loading version resources:", xhr);
            });
        }
            // Preview Content
            window.viewContent = function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;

                if (resourceName.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content...</div>";
                    }

                    $.ajax({
                        url: apiUrl,
                        method: "GET",
                        xhrFields: { withCredentials: true },
                        success: function(response) {
                            if (response && response.url) {
                                if (win) win.location.href = response.url;
                            } else {
                                if (win) win.close();
                                DevExpress.ui.notify("Content URL not found.", "error", 3000);
                            }
                        },
                        error: function() {
                            if (win) win.close();
                            DevExpress.ui.notify("Failed to get content link.", "error", 3000);
                        }
                    });
                } else {
                    window.open(apiUrl, '_blank');
                }
            };

            // Set Active Version - ใช้ API ใหม่ (PATCH /api/courses/{courseId}/versions/{versionId}/set-active)
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true },
                    success: function(response) {
                        DevExpress.ui.notify("Active version updated successfully!", "success", 2000);
                        loadVersions();
                    },
                    error: function(xhr) {
                        const errorMsg = xhr.responseJSON?.message || "Error updating active version";
                        DevExpress.ui.notify(errorMsg, "error", 3000);
                    }
                });
            };

            // Delete Version - ยังใช้ endpoint เดิม
            window.deleteVersion = function(vId) {
                const result = DevExpress.ui.dialog.confirm("Delete this version?", "Confirm Delete");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        $.ajax({
                            url: serviceUrl + '/admin/CourseVersionsCRUD/Delete',
                            type: 'DELETE',
                            data: { key: vId },
                            xhrFields: { withCredentials: true },
                            success: function(response) {
                                DevExpress.ui.notify("Version deleted successfully.", "success", 2000);
                                loadVersions();
                            },
                            error: function(xhr) {
                                const errorMsg = xhr.responseJSON?.message || "Error deleting version";
                                DevExpress.ui.notify(errorMsg, "error", 3000);
                            }
                        });
                    }
                });
            };

            loadVersions();
        });
    </script>
}