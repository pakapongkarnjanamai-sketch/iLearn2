@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">Course Dashboard</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        <span>Managing Course ID: <span class="badge bg-secondary">@courseId</span></span>
                        <span id="courseStatusBadge" class="badge bg-warning text-dark ms-2">Loading...</span>
                    </div>
                </div>
            </h1>
            <div class="mt-3 mt-md-0">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary rounded shadow-sm px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">

    <div class="row mb-4">
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle text-info me-2"></i> Course Information</h5>
                </div>
                <div class="card-body">
                    <div id="courseInfoForm"></div>
                    <div class="text-end mt-4">
                        <button id="btnSaveCourse" class="btn btn-primary px-4 shadow-sm"><i class="fas fa-save me-1"></i> Save Changes</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-bold text-dark py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-bolt text-warning me-2"></i> Quick Management</h5>
                </div>
                <div class="card-body p-2" style="max-height: 400px; overflow-y: auto;">
                    <div class="list-group list-group-flush">

                        <a href="javascript:void(0);" id="btnTogglePublish" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light transition-all">
                            <i id="publishIcon" class="fas fa-globe text-success fs-4 me-3"></i>
                            <div>
                                <h6 id="publishBtnText" class="mb-0 fw-bold">Publish Course</h6>
                                <small id="publishSubText" class="text-muted">Make course visible to users.</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnNewVersion" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light transition-all">
                            <i class="fas fa-code-branch text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">New Version</h6>
                                <small class="text-muted">Create a new course version.</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnAssignment" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light transition-all">
                            <i id="assignmentIcon" class="fas fa-user-plus text-info fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Assignments</h6>
                                <small class="text-muted">Assign course to employees.</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnDeleteCourse" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded bg-light transition-all">
                            <i id="deleteIcon" class="fas fa-trash-alt text-danger fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Delete Course</h6>
                                <small class="text-muted">Remove this course permanently.</small>
                            </div>
                        </a>

                    </div>

                    <div id="deleteWarningMsg" class="text-danger small mt-3 text-center d-none">
                 
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-code-branch text-success me-2"></i> Versions & Content</h5>
                </div>
                <div class="card-body p-3">
                    <div id="versionsGrid"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-clipboard-list text-primary me-2"></i> Assignments Rules</h5>
                </div>
                <div class="card-body p-3">
                    <div id="assignmentsGrid"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-users text-warning me-2"></i> Enrollments & Progress</h5>
                </div>
                <div class="card-body p-3">
                    <div id="enrollmentsGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .transition-all:hover {
            transform: translateX(5px);
            background-color: #f8f9fa !important;
        }

        .transition-all.disabled:hover {
            transform: none;
            background-color: #f8f9fa !important;
        }
    </style>

    <script>
        const courseId = @courseId;

        const courseApiUrl = serviceUrl + '/Courses';
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const versionsStore = createDataStore(serviceUrl, 'admin/CourseVersionsCRUD', { key: 'id' });
        const assignmentsStore = createDataStore(serviceUrl, 'admin/AssignmentsCRUD', { key: 'id' });
        const enrollmentsStore = createDataStore(serviceUrl, 'admin/EnrollmentsCRUD', { key: 'id' });
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];

        let isCourseActive = false;

        // ==========================================
        // ฟังก์ชันเสริมสำหรับจัดการ Resource
        // ==========================================
        function viewContent(resourceId, resourceName) {
            const apiUrl = serviceUrl + `/Resources/${resourceId}/content`;

            if (resourceName && resourceName.toLowerCase().endsWith('.zip')) {
                const win = window.open('about:blank', '_blank');
                if (win) {
                    win.document.title = "Loading Course...";
                    win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content URL...</div>";
                }

                $.ajax({
                    url: apiUrl,
                    method: "GET",
                    xhrFields: { withCredentials: true },
                    success: function(response) {
                        if (response && response.url) {
                            if (win) win.location.href = response.url;
                        } else {
                            if (win) win.close();
                            DevExpress.ui.notify("Content URL not found.", "error", 3000);
                        }
                    },
                    error: function(err) {
                        if (win) win.close();
                        DevExpress.ui.notify("Failed to get content link.", "error", 3000);
                    }
                });
            } else {
                window.open(apiUrl, '_blank');
            }
        }

        function setResourcePublic(resourceId, gridInstance) {
            $.ajax({
                url: serviceUrl + `/Resources/SetPublic?key=${resourceId}`,
                type: "POST",
                xhrFields: { withCredentials: true },
                success: function() {
                    DevExpress.ui.notify("Resource visibility updated successfully.", "success", 2000);
                    if(gridInstance) gridInstance.refresh();
                },
                error: function() {
                    DevExpress.ui.notify("Failed to update resource visibility.", "error", 3000);
                }
            });
        }

        $(async () => {
            // ==========================================
            // 1. ฟอร์มข้อมูล Course
            // ==========================================
            const courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                items: [
                    {
                        itemType: "group",
                        colCount: 3,
                        items: [
                            { dataField: "courseCode", label: { text: "Course Code" }, isRequired: true },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: categoriesStore, displayExpr: "name", valueExpr: "id" },
                                isRequired: true
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: courseTypes, displayExpr: "name", valueExpr: "id" }
                            }
                        ]
                    },
                    { dataField: "courseName", label: { text: "Course Name" }, isRequired: true },
                    { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 90 } }
                ]
            }).dxForm("instance");

            // ดึงข้อมูลคอร์ส
            $.ajax({
                url: `${courseApiUrl}/${courseId}`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done((data) => {
                data.courseType = data.courseType !== undefined ? data.courseType : data.CourseType;
                courseForm.option("formData", data);
                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);
            }).fail((err) => {
                console.error("Failed to load course data", err);
            });

            // กดปุ่ม Save Changes
            $("#btnSaveCourse").click(() => {
                if(!courseForm.validate().isValid) return;
                const data = courseForm.option("formData");

                $.ajax({
                    url: `${courseApiUrl}/${courseId}/info`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode: data.courseCode,
                        courseName: data.courseName,
                        description: data.description,
                        categoryId: data.categoryId,
                        courseType: data.courseType
                    }),
                    success: () => DevExpress.ui.notify("Course info updated successfully!", "success", 2000),
                    error: () => DevExpress.ui.notify("Error updating course", "error", 2000)
                });
            });

            // ==========================================
            // 2. จัดการ Status (Publish/Closed)
            // ==========================================
            function updateStatusUI(isActive) {
                const publishIcon = $("#publishIcon");
                const btnDelete = $("#btnDeleteCourse");
                const deleteIcon = $("#deleteIcon");
                const warnMsg = $("#deleteWarningMsg");
                const btnAssignment = $("#btnAssignment");
                const assignmentIcon = $("#assignmentIcon");

                if(isActive) {
                    publishIcon.removeClass("fa-globe text-success").addClass("fa-lock text-warning");
                    $("#publishBtnText").text("Set to Closed");
                    $("#publishSubText").text("Hide course from users.");
                    $("#courseStatusBadge").removeClass("bg-warning text-dark").addClass("bg-success text-white").html('<i class="fas fa-check-circle me-1"></i> Public');

                    btnDelete.addClass("disabled text-muted").css({"cursor": "not-allowed", "opacity": "0.6"});
                    deleteIcon.removeClass("text-danger").addClass("text-muted");
                    warnMsg.removeClass("d-none");

                    btnAssignment.removeClass("disabled text-muted").css({"cursor": "pointer", "opacity": "1"});
                    assignmentIcon.removeClass("text-muted").addClass("text-info");
                } else {
                    publishIcon.removeClass("fa-lock text-warning").addClass("fa-globe text-success");
                    $("#publishBtnText").text("Publish Course");
                    $("#publishSubText").text("Make course visible to users.");
                    $("#courseStatusBadge").removeClass("bg-success text-white").addClass("bg-warning text-dark").html('<i class="fas fa-lock me-1"></i> Closed');

                    btnDelete.removeClass("disabled text-muted").css({"cursor": "pointer", "opacity": "1"});
                    deleteIcon.removeClass("text-muted").addClass("text-danger");
                    warnMsg.addClass("d-none");

                    btnAssignment.addClass("disabled text-muted").css({"cursor": "not-allowed", "opacity": "0.6"});
                    assignmentIcon.removeClass("text-info").addClass("text-muted");
                }
            }

            // ==========================================
            // 3. Event Buttons (Quick Management)
            // ==========================================
            $("#btnTogglePublish").click(() => {
                const newState = !isCourseActive;
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/status`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({ isActive: newState }),
                    success: () => {
                        isCourseActive = newState;
                        updateStatusUI(newState);
                        $("#versionsGrid").dxDataGrid("instance").refresh();
                        DevExpress.ui.notify(newState ? "Course published successfully!" : "Course set to closed.", "success", 2000);
                    },
                    error: (xhr) => {
                        let errorMsg = "Error updating status";
                        if(xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        DevExpress.ui.notify(errorMsg, "error", 4000);
                        updateStatusUI(!newState);
                    }
                });
            });

            $("#btnNewVersion").click(() => {
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            });

            $("#btnAssignment").click(function(e) {
                if ($(this).hasClass("disabled")) {
                    e.preventDefault();
                    DevExpress.ui.notify("Please 'Publish' the course before assigning to employees.", "warning", 3000);
                    return;
                }
                window.location.href = '/Assignments/Form?courseId=' + courseId;
            });

            $("#btnDeleteCourse").click(function(e) {
                if ($(this).hasClass("disabled")) {
                    e.preventDefault();
                    return;
                }
                const result = DevExpress.ui.dialog.confirm(
                    "<i>Are you sure you want to delete this course?</i><br/><br/>This will remove all versions, assignments, and cannot be undone.",
                    "Confirm Deletion"
                );
                result.done((dialogResult) => {
                    if(dialogResult) {
                        $.ajax({
                            url: `${courseApiUrl}/${courseId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true },
                            success: () => {
                                DevExpress.ui.notify("Course deleted successfully!", "success", 2000);
                                setTimeout(() => { window.location.href = '@Url.Action("Index", "Courses")'; }, 1500);
                            },
                            error: () => {
                                DevExpress.ui.notify("Error deleting course. It might be in use.", "error", 3000);
                            }
                        });
                    }
                });
            });

            // ==========================================
            // 4. DataGrids
            // ==========================================
            $("#versionsGrid").dxDataGrid({
                dataSource: { store: versionsStore, filter: ["courseId", "=", courseId] },
                showBorders: true,
                rowAlternationEnabled: true,
                editing: {
                    mode: "row",
                    allowUpdating: true,
                    allowDeleting: true,
                    useIcons: true
                },
         masterDetail: {
                    enabled: true,
                    template: function(container, options) {
                        const versionData = options.data;

                        const header = $("<div>")
                            .addClass("d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom")
                            .appendTo(container);

                        $("<div>")
                            .addClass("fw-bold text-secondary")
                            .html(`<i class="fas fa-folder-open me-2"></i>Content for Version ${versionData.versionNumber}`)
                            .appendTo(header);

                        $("<div>").dxDataGrid({
                            // กลับมาใช้ CourseResourcesCRUD เพื่อให้ Filter ทำงานได้ตามปกติ
                            dataSource: {
                                store: createDataStore(serviceUrl, 'admin/CourseResourcesCRUD', { key: 'id' }),
                                filter: ["courseVersionId", "=", versionData.id]
                            },
                            showBorders: true,
                            columnAutoWidth: true,
                            rowAlternationEnabled: true,
                            editing: {
                                mode: "row",
                                allowAdding: false, // ปิดการเพิ่มไฟล์ใหม่จากตรงนี้ (แนะนำให้ทำที่ Resource Library)
                                allowUpdating: true, // เปิดให้แก้ไข (แก้ชื่อ)
                                allowDeleting: true,
                                useIcons: true
                            },
                            // [ไฮไลท์สำคัญ] ดักจับการแก้ไขข้อมูล เพื่อให้ไปอัปเดตที่ตาราง Resources ตรงๆ
                            onRowUpdating: function(e) {
                                // เช็คว่ามีการพิมพ์แก้ไขในช่องชื่อไฟล์หรือไม่
                                if (e.newData.resource && e.newData.resource.name !== undefined) {
                                    // สั่งยกเลิกการเซฟลง CourseResourcesCRUD ปกติ แล้วใช้ $.ajax ยิงไป ResourcesCRUD แทน
                                    e.cancel = $.ajax({
                                        url: serviceUrl + '/admin/ResourcesCRUD/Put',
                                        type: 'PUT',
                                        data: {
                                            key: e.oldData.resourceId, // ส่ง ID ของ Resource ไปแก้
                                            values: JSON.stringify({ name: e.newData.resource.name }) // ส่งชื่อใหม่ไป
                                        }
                                    }).done(function() {
                                        DevExpress.ui.notify("Resource updated successfully.", "success", 2000);
                                    }).fail(function() {
                                        DevExpress.ui.notify("Failed to update Resource.", "error", 3000);
                                    });
                                }
                            },
                            columns: [
                                {
                                    // ดึงชื่อไฟล์มาแสดงผ่าน Include จาก Backend
                                    dataField: "resource.name",
                                    caption: "File / Content Name",
                                    validationRules: [{ type: "required", message: "Name cannot be empty" }]
                                },
                                {
                                    // ดึงสถานะ Active มาแสดง
                                    dataField: "resource.isActive",
                                    caption: "Resource Status",
                                    dataType: "boolean",
                                    width: 140,
                                    alignment: "center",
                                    allowEditing: false, // ปิดแก้ไขตรงนี้ ให้ไปใช้ปุ่ม Set Public แทนเพื่อความชัวร์
                                    cellTemplate: function(container, options) {
                                        // ป้องกัน Error กรณี resource เป็น null
                                        if (!options.data.resource) {
                                            $("<span>").text("-").appendTo(container);
                                            return;
                                        }

                                        if (options.data.resource.isActive) {
                                            $("<span>").addClass("badge bg-success").html('<i class="fas fa-globe me-1"></i>Public').appendTo(container);
                                        } else {
                                            $("<span>").addClass("badge bg-secondary").html('<i class="fas fa-lock me-1"></i>Private').appendTo(container);
                                        }
                                    }
                                },
                                {
                                    dataField: "createdAt",
                                    caption: "Added Date",
                                    dataType: "datetime",
                                    format: "dd/MM/yyyy HH:mm",
                                    width: 160,
                                    alignment: "center",
                                    allowEditing: false
                                },
                                {
                                    type: "buttons",
                                    width: 150,
                                    buttons: [
                                        "edit", // ปุ่มดินสอ จะเปิดช่องให้แก้ชื่อ resource.name ได้
                                        {
                                            hint: "Preview Content",
                                            icon: "video",
                                            visible: function(e) {
                                                return !e.row.isNewRow && e.row.data.resource?.isActive === true;
                                            },
                                            onClick: function(e) {
                                                const resourceName = e.row.data.resource.name;
                                                const resourceId = e.row.data.resourceId;
                                                viewContent(resourceId, resourceName);
                                            }
                                        },
                                        {
                                            hint: "Set Public (Extract SCORM)",
                                            icon: "upload",
                                            visible: function(e) {
                                                return !e.row.isNewRow && e.row.data.resource?.isActive === false;
                                            },
                                            onClick: function(e) {
                                                const resourceId = e.row.data.resourceId;
                                                setResourcePublic(resourceId, e.component);
                                            }
                                        },
                                        "delete"
                                    ]
                                }
                            ]
                        }).appendTo(container);
                    }
                },
                columns: [
                    { dataField: "versionNumber", caption: "Version No.", width: 100, alignment: "center", allowEditing: false },
                    { dataField: "note", caption: "Note" },
                    { dataField: "createdAt", caption: "Created Date", dataType: "datetime", format: "dd/MM/yyyy HH:mm", width: 160, allowEditing: false },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        dataType: "boolean",
                        width: 120,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $("<span>").addClass("badge bg-success").html('<i class="fas fa-check-circle me-1"></i>Active').appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-secondary").text("Inactive").appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons",
                        width: 140,
                        buttons: [
                            "edit",
                            {
                                hint: "Set as Active",
                                icon: "check",
                                visible: function(e) {
                                    return !e.row.data.isActive;
                                },
                                onClick: function(e) {
                                    const versionId = e.row.data.id;

                                    $.ajax({
                                        url: `${courseApiUrl}/${courseId}/versions/${versionId}/set-active`,
                                        type: 'PATCH',
                                        xhrFields: { withCredentials: true },
                                        success: function() {
                                            DevExpress.ui.notify("Active version updated!", "success", 2000);
                                            $("#versionsGrid").dxDataGrid("instance").refresh();
                                        },
                                        error: function() {
                                            DevExpress.ui.notify("Error updating active version.", "error", 2000);
                                        }
                                    });
                                }
                            },
                            "delete"
                        ]
                    }
                ]
            });

            $("#assignmentsGrid").dxDataGrid({
                dataSource: { store: assignmentsStore, filter: ["courseId", "=", courseId] },
                showBorders: true,
                rowAlternationEnabled: true,
                columns: [
                    { dataField: "assignmentNo", caption: "Assignment No" },
                    { dataField: "division", caption: "Division", width: 100, alignment: "center" },
                    { dataField: "dueDate", caption: "Due Date", dataType: "date", format: "dd/MM/yyyy", width: 100 },
                    { type: "buttons", buttons: ["edit", "delete"], width: 80 }
                ]
            });

            $("#enrollmentsGrid").dxDataGrid({
                dataSource: { store: enrollmentsStore, filter: ["courseId", "=", courseId] },
                showBorders: true,
                rowAlternationEnabled: true,
                searchPanel: { visible: true, placeholder: "Search Code..." },
                paging: { pageSize: 5 },
                columns: [
                    { dataField: "studentCode", caption: "Student", width: 100, alignment: "center" },
                    {
                        dataField: "isCompleted",
                        caption: "Status",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $("<span>").addClass("badge bg-success").text("Completed").appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-secondary").text("In Progress").appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "progress",
                        caption: "Progress",
                        cellTemplate: function(container, options) {
                            const percent = options.value || 0;
                            const color = percent === 100 ? "bg-success" : "bg-primary";
                            $(`
                                <div class="progress mt-1" style="height: 10px;">
                                    <div class="progress-bar ${color}" role="progressbar" style="width: ${percent}%;" aria-valuenow="${percent}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="text-center" style="font-size: 0.75rem; margin-top: 2px;">${percent}%</div>
                            `).appendTo(container);
                        }
                    }
                ]
            });
        });
    </script>
}