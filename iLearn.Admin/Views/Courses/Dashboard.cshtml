@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-tachometer-alt"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">Course Dashboard</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        <span>Managing Course ID: <span class="badge bg-secondary">@courseId</span></span>
                        <span id="courseStatusBadge" class="badge bg-warning text-dark ms-2">Loading...</span>
                    </div>
                </div>
            </h1>
            <div class="mt-3 mt-md-0">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary rounded shadow-sm px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">

    <div class="row mb-4">
        <div class="col-lg-8 mb-4 mb-lg-0">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle text-primary me-2"></i> Course Information</h5>
                </div>
                <div class="card-body">
                    <div id="courseInfoForm"></div>
                    <div class="text-end mt-4">
                        <button id="btnSaveCourse" class="btn btn-primary px-4 shadow-sm"><i class="fas fa-save me-1"></i> Save Changes</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-bold text-dark py-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-bolt text-primary me-2"></i> Quick Management</h5>
                </div>
                <div class="card-body p-2" style="max-height: 400px; overflow-y: auto;">
                    <div class="list-group list-group-flush">
                        <a href="javascript:void(0);" id="btnNewVersion" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-1 rounded mb-1 ">
                            <i class="fas fa-code-branch text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">New Version</h6>
                                <small class="text-muted">Create a new course version.</small>
                            </div>
                        </a>
                        <a href="javascript:void(0);" id="btnAssignment" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-1 rounded mb-1  ">
                            <i id="assignmentIcon" class="fas fa-user-plus text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Assignments</h6>
                                <small class="text-muted">Assign course to employees.</small>
                            </div>
                        </a>
                        <a href="javascript:void(0);" id="btnTogglePublish" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-1 rounded mb-1  ">
                            <i id="publishIcon" class="fas fa-globe text-primary fs-4 me-3"></i>
                            <div>
                                <h6 id="publishBtnText" class="mb-0 fw-bold">Publish Course</h6>
                                <small id="publishSubText" class="text-muted">Make course visible to users.</small>
                            </div>
                        </a>
                        <a href="javascript:void(0);" id="btnDeleteCourse" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-1 rounded  ">
                            <i id="deleteIcon" class="fas fa-trash-alt text-danger fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Delete Course</h6>
                                <small class="text-muted">Remove this course permanently.</small>
                            </div>
                        </a>
                    </div>
                    <div id="deleteWarningMsg" class="text-danger small mt-3 text-center d-none"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-layer-group text-primary me-2"></i> Versions & Content</h5>
                    <button class="btn btn-sm btn-outline-primary" id="btnAddNewVersionCard"><i class="fas fa-plus me-1"></i> Add Version</button>
                </div>
                <div class="card-body p-4 bg-light rounded-bottom">
                    <div class="row" id="versionsContainer">
                        <div class="col-12 text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i> Loading versions...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-bottom p-0">
                    <ul class="nav nav-tabs nav-justified" id="courseManagementTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold py-3 text-dark border-top-0 border-start-0 border-end-0" id="assignments-tab" data-bs-toggle="tab" data-bs-target="#assignments-pane" type="button" role="tab">
                                <i class="fas fa-clipboard-list text-primary me-2"></i> Assignments Rules
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold py-3 text-dark border-top-0 border-start-0 border-end-0" id="enrollments-tab" data-bs-toggle="tab" data-bs-target="#enrollments-pane" type="button" role="tab">
                                <i class="fas fa-users text-primary me-2"></i> Enrollments & Progress
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-3">
                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade show active" id="assignments-pane" role="tabpanel">
                            <div id="assignmentsGrid"></div>
                        </div>
                        <div class="tab-pane fade" id="enrollments-pane" role="tabpanel">
                            <div id="enrollmentsGrid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .transition-all:hover {
            transform: translateX(5px);
            background-color: #f8f9fa !important;
        }

        .transition-all.disabled:hover {
            transform: none;
            background-color: #f8f9fa !important;
        }

        .nav-tabs .nav-link.active {
            border-bottom: 3px solid #0d6efd !important;
            color: #0d6efd !important;
        }
    </style>

    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/Courses';
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const assignmentsStore = createDataStore(serviceUrl, 'admin/AssignmentsCRUD', { key: 'id' });
        const enrollmentsStore = createDataStore(serviceUrl, 'admin/EnrollmentsCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];
        let isCourseActive = false;

        $(async () => {
            // ==========================================
            // 1. ฟอร์มข้อมูล Course (เพิ่มโชว์ Division)
            // ==========================================
            const courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                items: [
                    {
                        itemType: "group",
                        colCount: 3,
                        items: [
                            { dataField: "courseCode", label: { text: "Course Code" }, isRequired: true },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    // ✨ แสดงชื่อ Division ก่อนหน้า Category Name
                                    displayExpr: function(item) {
                                        if(!item) return "";
                                        return item.division ? `${item.division.name} - ${item.name}` : item.name;
                                    },
                                    valueExpr: "id",
                                    searchEnabled: true
                                },
                                isRequired: true
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: courseTypes, displayExpr: "name", valueExpr: "id" }
                            }
                        ]
                    },
                    { dataField: "courseName", label: { text: "Course Name" }, isRequired: true },
                    { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 90 } }
                ]
            }).dxForm("instance");

            // ดึงข้อมูลคอร์สตั้งต้น
            $.ajax({
                url: `${courseApiUrl}/${courseId}`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done((data) => {
                data.courseType = data.courseType !== undefined ? data.courseType : data.CourseType;
                courseForm.option("formData", data);
                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);
            });

            $("#btnSaveCourse").click(() => {
                if(!courseForm.validate().isValid) return;
                const data = courseForm.option("formData");

                $.ajax({
                    url: `${courseApiUrl}/${courseId}/info`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode: data.courseCode,
                        courseName: data.courseName,
                        description: data.description,
                        categoryId: data.categoryId,
                        courseType: data.courseType
                    }),
                    success: () => DevExpress.ui.notify("Course info updated successfully!", "success", 2000),
                    error: () => DevExpress.ui.notify("Error updating course", "error", 2000)
                });
            });

            // ==========================================
            // 2. จัดการ Status (Publish/Closed)
            // ==========================================
            function updateStatusUI(isActive) {
                const publishIcon = $("#publishIcon");
                const btnDelete = $("#btnDeleteCourse");
                const deleteIcon = $("#deleteIcon");
                const warnMsg = $("#deleteWarningMsg");
                const btnAssignment = $("#btnAssignment");
                const assignmentIcon = $("#assignmentIcon");

                if(isActive) {
                    publishIcon.removeClass("fa-globe text-success").addClass("fa-lock text-warning");
                    $("#publishBtnText").text("Set to Closed");
                    $("#publishSubText").text("Hide course from users.");
                    $("#courseStatusBadge").removeClass("bg-warning text-dark").addClass("bg-success text-white").html('<i class="fas fa-check-circle me-1"></i> Public');
                    btnDelete.addClass("disabled text-muted").css({"cursor": "not-allowed", "opacity": "0.6"});
                    deleteIcon.removeClass("text-danger").addClass("text-muted");
                    warnMsg.removeClass("d-none");
                    btnAssignment.removeClass("disabled text-muted").css({"cursor": "pointer", "opacity": "1"});
                    assignmentIcon.removeClass("text-muted").addClass("text-primary");
                } else {
                    publishIcon.removeClass("fa-lock text-warning").addClass("fa-globe text-success");
                    $("#publishBtnText").text("Publish Course");
                    $("#publishSubText").text("Make course visible to users.");
                    $("#courseStatusBadge").removeClass("bg-success text-white").addClass("bg-warning text-dark").html('<i class="fas fa-lock me-1"></i> Closed');
                    btnDelete.removeClass("disabled text-muted").css({"cursor": "pointer", "opacity": "1"});
                    deleteIcon.removeClass("text-muted").addClass("text-danger");
                    warnMsg.addClass("d-none");
                    btnAssignment.addClass("disabled text-muted").css({"cursor": "not-allowed", "opacity": "0.6"});
                    assignmentIcon.removeClass("text-info").addClass("text-muted");
                }
            }

            $("#btnTogglePublish").click(() => {
                const newState = !isCourseActive;
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/status`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({ isActive: newState }),
                    success: () => {
                        isCourseActive = newState;
                        updateStatusUI(newState);
                        loadVersions(); // รีเฟรชการ์ดเวอร์ชัน
                        DevExpress.ui.notify(newState ? "Course published successfully!" : "Course set to closed.", "success", 2000);
                    },
                    error: (xhr) => {
                        let errorMsg = xhr.responseJSON?.message || "Error updating status";
                        DevExpress.ui.notify(errorMsg, "error", 4000);
                    }
                });
            });

            $("#btnNewVersion, #btnAddNewVersionCard").click(() => {
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            });

            $("#btnAssignment").click(function(e) {
                if ($(this).hasClass("disabled")) {
                    e.preventDefault();
                    DevExpress.ui.notify("Please 'Publish' the course before assigning.", "warning", 3000);
                    return;
                }
                window.location.href = '/Assignments/Form?courseId=' + courseId;
            });

            // ==========================================
            // 3. วาดการ์ด Versions & Content
            // ==========================================
            function loadVersions() {
                $.ajax({
                    url: serviceUrl + '/admin/CourseVersionsCRUD/Get',
                    data: { filter: JSON.stringify(["courseId", "=", courseId]) },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const versions = res.data || [];
                    versions.sort((a,b) => b.versionNumber - a.versionNumber); // เรียงล่าสุดขึ้นก่อน

                    const container = $("#versionsContainer");
                    container.empty();

                    if(versions.length === 0) {
                        container.html('<div class="col-12 text-center text-muted py-4">No versions found. Create one to get started.</div>');
                        return;
                    }

                    versions.forEach(v => {
                        const isActive = v.isActive;
                        const badge = isActive ? '<span class="badge bg-success px-2 py-1"><i class="fas fa-check-circle me-1"></i> Active</span>' : '<span class="badge bg-secondary px-2 py-1">Inactive</span>';
                        // ปุ่ม Set Active จะโผล่มาถ้ายังไม่ Active
                        const activeBtn = isActive ? '' : `<button class="btn btn-sm btn-success text-white shadow-sm" onclick="setActiveVersion(${v.id})"><i class="fas fa-check-circle me-1"></i> Set Active</button>`;
                        const formattedDate = new Date(v.createdAt).toLocaleDateString('en-GB'); // dd/mm/yyyy

                        const cardHtml = `
                            <div class="col-md-6 col-xl-4 mb-4">
                                <div class="card h-100 shadow-sm border-0 ${isActive ? 'border-top border-success border-4' : 'border-top border-secondary border-4'}">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title mb-0 fw-bold text-dark">
                                                Version ${v.versionNumber}
                                            </h5>
                                            <div>${badge}</div>
                                        </div>
                                        <p class="card-text text-muted small mb-2" style="min-height: 40px;">${v.note || 'No description provided.'}</p>
                                        <p class="card-text text-muted small mb-3"><i class="fas fa-calendar-alt me-1"></i>Created: ${formattedDate}</p>

                                        <h6 class="fw-bold small text-dark border-bottom pb-1 mb-2"><i class="fas fa-paperclip me-1"></i> Attached Content</h6>
                                        <div id="res-container-${v.id}" class="mb-2" style="min-height: 50px;">
                                            <div class="text-center small text-muted"><i class="fas fa-spinner fa-spin"></i></div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white border-0 pt-0 d-flex justify-content-between align-items-center">
                                        <div>${activeBtn}</div>
                                        <div>
                                            <a href="/Courses/VersionForm/${v.id}?courseId=${courseId}" class="btn btn-sm btn-light border text-primary" title="Edit Version"><i class="fas fa-edit"></i></a>
                                            <button class="btn btn-sm btn-light border text-danger" onclick="deleteVersion(${v.id})" title="Delete Version"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        container.append(cardHtml);
                        loadVersionResources(v.id);
                    });
                });
            }

            function loadVersionResources(versionId) {
                $.ajax({
                    url: serviceUrl + '/admin/CourseResourcesCRUD/Get',
                    data: { filter: JSON.stringify(["courseVersionId", "=", versionId]), expand: "resource" },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const resources = res.data || [];
                    const resContainer = $(`#res-container-${versionId}`);
                    resContainer.empty();

                    if(resources.length === 0) {
                        resContainer.html('<div class="small text-muted fst-italic py-1">- No files attached -</div>');
                        return;
                    }

                    const ul = $('<ul class="list-unstyled mb-0 small"></ul>');
                    resources.forEach(cr => {
                        const r = cr.resource;
                        if(!r) return;
                        const icon = r.typeId === 1 ? 'fa-book-reader text-primary' : 'fa-pen-alt text-danger';
                        ul.append(`<li class="mb-2 text-truncate d-flex align-items-center" title="${r.name}"><i class="fas ${icon} me-2" style="width: 15px;"></i><span>${r.name}</span></li>`);
                    });
                    resContainer.append(ul);
                });
            }

            // เรียกทำงานโหลดครั้งแรก
            loadVersions();

            // ฟังก์ชันผูกกับหน้าต่าง (Global scope)
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true },
                    success: function() {
                        DevExpress.ui.notify("Active version updated!", "success", 2000);
                        loadVersions();
                    }
                });
            }

            window.deleteVersion = function(vId) {
                const result = DevExpress.ui.dialog.confirm("Delete this version? This action cannot be undone.", "Confirm Delete");
                result.done(function(dialogResult) {
                    if(dialogResult) {
                        $.ajax({
                            url: serviceUrl + '/admin/CourseVersionsCRUD/Delete',
                            type: 'DELETE',
                            data: { key: vId },
                            xhrFields: { withCredentials: true },
                            success: function() {
                                DevExpress.ui.notify("Version deleted.", "success", 2000);
                                loadVersions();
                            }
                        });
                    }
                });
            }

            // ==========================================
            // 4. Assignments & Enrollments Grids (ใน Tabs)
            // ==========================================
            $("#assignmentsGrid").dxDataGrid({
                dataSource: { store: assignmentsStore, filter: ["courseId", "=", courseId] },
                showBorders: false,
                rowAlternationEnabled: true,
                columnAutoWidth: true,
                columns: [
                    { dataField: "assignmentNo", caption: "Assignment No", alignment: "center" },
                    { dataField: "division", caption: "Target Division", alignment: "center" },
                    { dataField: "dueDate", caption: "Due Date", dataType: "date", format: "dd/MM/yyyy", alignment: "center" },
                    { type: "buttons", buttons: ["edit", "delete"], width: 80 }
                ]
            });

            $("#enrollmentsGrid").dxDataGrid({
                dataSource: { store: enrollmentsStore, filter: ["courseId", "=", courseId] },
                showBorders: false,
                rowAlternationEnabled: true,
                searchPanel: { visible: true, placeholder: "Search Student Code..." },
                paging: { pageSize: 10 },
                columns: [
                    { dataField: "studentCode", caption: "Student", alignment: "center" },
                    {
                        dataField: "isCompleted",
                        caption: "Status",
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $("<span>").addClass("badge bg-success").text("Completed").appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-secondary").text("In Progress").appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "progress",
                        caption: "Progress",
                        cellTemplate: function(container, options) {
                            const percent = options.value || 0;
                            const color = percent === 100 ? "bg-success" : "bg-primary";
                            $(`
                                <div class="progress mt-1" style="height: 10px;">
                                    <div class="progress-bar ${color}" role="progressbar" style="width: ${percent}%;" aria-valuenow="${percent}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <div class="text-center text-muted" style="font-size: 0.75rem; margin-top: 2px;">${percent}%</div>
                            `).appendTo(container);
                        }
                    }
                ]
            });

            // ✨ แก้ปัญหา Grid เบี้ยวเวลาเปลี่ยน Tab (เพราะ Grid ถูกวาดตอนที่มันซ่อนอยู่)
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                const targetId = $(e.target).attr("data-bs-target");
                if (targetId === "#enrollments-pane") {
                    $("#enrollmentsGrid").dxDataGrid("instance").repaint();
                } else if (targetId === "#assignments-pane") {
                    $("#assignmentsGrid").dxDataGrid("instance").repaint();
                }
            });

        });
    </script>
}