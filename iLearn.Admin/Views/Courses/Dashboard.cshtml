@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;" id="pageTitle">Course Dashboard</div>
        <div class="text-secondary" style="font-size:12px;" id="pageSubtitle">Manage course information and versions</div>
    </div>
    <a href="@Url.Action("Index", "Courses")" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back to Courses
    </a>
</div>

<div class="container-fluid px-4 py-4" style="max-width:1400px;">

    <div class="row g-3 mb-4">

        <div class="col-lg-8">
            <div class="border rounded bg-white h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title mb-0" style="border:none; padding:0;">Course Information</div>
                    <span id="courseStatusBadge" class="status-pill pill-default">
                        <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                    </span>
                </div>
                <div id="courseInfoForm"></div>
                <div class="text-end mt-3 pt-3" style="border-top:1px solid var(--border-color);">
                    <a href="javascript:void(0);" id="btnSaveCourse" class="action-link primary">
                        <i class="fas fa-save"></i> Save Changes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Quick Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btnNewVersion" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);">
                            <i class="fas fa-code-branch"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">New Version</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Create a new content version</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnAssignment" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">Assignments</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Assign course to employees</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnTogglePublish" class="quick-action">
                        <div class="qa-icon" id="publishIconBox" style="background:#fafafa; color:var(--text-secondary);">
                            <i id="publishIcon" class="fas fa-globe"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);" id="publishBtnText">Publish Course</div>
                            <div style="font-size:11px; color:var(--text-secondary);" id="publishBtnDesc">Make course available</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnDeleteCourse" class="quick-action danger">
                        <div class="qa-icon" style="background:#fff2f0; color:var(--danger-color);">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600; color:var(--text-primary);">Delete Course</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Remove permanently</div>
                        </div>
                    </a>

                </div>

                <div id="warningMsg" class="mt-3 pt-3 d-none" style="border-top:1px solid var(--border-color); font-size:11px; color:var(--warning-color);">
                    <i class="fas fa-exclamation-triangle me-1"></i> Cannot delete an active course.
                </div>
            </div>
        </div>

    </div>

    <div class="border rounded bg-white">
        <div id="dashboardTabs"></div>

        <div id="panel-versions" class="p-3">
            <div id="versionsToolbar" class="mb-3"></div>
            <div id="versionsCardContainer" class="row g-3"></div>
        </div>

        <div id="panel-learners" class="p-3" style="display:none;">
            <div id="grid-learners"></div>
        </div>

        <div id="panel-assignments" class="p-3" style="display:none;">
            <div id="grid-assignments"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/courses';

        const divisionsStore  = createDataStore(serviceUrl, 'admin/DivisionsCRUD',  { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        let isCourseActive = false;
        let courseForm;
        let versionsData = [];
        $(async () => {

            // ── 1. Build form ──────────────────────────────────────────
            courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 1,
                items: [
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: function(e) {
                                        const catEditor = courseForm.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();
                                        if (e.event) catEditor.option("value", null);
                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    disabled: true,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                }
                            }
                        ]
                    },
                    {
                        dataField: "courseName",
                        label: { text: "Course Name" },
                        validationRules: [{ type: "required", message: "Course Name is required" }],
                        editorOptions: { placeholder: "e.g. Introduction to Cybersecurity" }
                    },
                    {
                        dataField: "description",
                        label: { text: "Description" },
                        editorType: "dxTextArea",
                        editorOptions: { height: 90, placeholder: "Course summary and objectives..." }
                    }
                ]
            }).dxForm("instance");

            // ── 2. Load dashboard data (single consolidated call) ──────
            try {
                const response = await $.ajax({
                    url: `${courseApiUrl}/${courseId}/dashboard`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                const { course: data, versions, kpi } = response.data;

                // Update page header
                $("#pageTitle").text(data.courseName || "Course Dashboard");
                $("#pageSubtitle").text(data.courseCode ? `Code: ${data.courseCode}` : "Manage course information and versions");

                // Resolve divisionId from category if needed
                let divisionId = data.divisionId || null;
                if (!divisionId && data.categoryId) {
                    try {
                        const catData = await $.ajax({
                            url: `${serviceUrl}/admin/CategoriesCRUD/Get/${data.categoryId}`,
                            type: 'GET',
                            xhrFields: { withCredentials: true }
                        });
                        divisionId = catData.divisionId || null;
                    } catch(e) { /* ignore */ }
                }

                // Pre-enable category editor if we have a division
                if (divisionId) {
                    const catEditor = courseForm.getEditor("categoryId");
                    catEditor.option("disabled", false);
                    catEditor.getDataSource().filter(["divisionId", "=", divisionId]);
                    catEditor.getDataSource().load();
                }

                courseForm.option("formData", {
                    divisionId:   divisionId,
                    courseCode:   data.courseCode,
                    courseName:   data.courseName,
                    description:  data.description,
                    categoryId:   data.categoryId,
                    courseType:   data.courseType
                });

                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);

                // Render versions from dashboard response
                renderVersionCards(versions);

            } catch(xhr) {
                showToast("Error loading course: " + (xhr.responseJSON?.message || "Unknown error"), "error");
                console.log(xhr);
            }

            // ── 3. Save ────────────────────────────────────────────────
            $("#btnSaveCourse").on("click", function() {
                if (!courseForm.validate().isValid) {
                    showToast("Please fill in all required fields.", "warning", 2000);
                    return;
                }
                const fd = courseForm.option("formData");
                const $btn = $(this).css("opacity", 0.6).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode:  fd.courseCode,
                        courseName:  fd.courseName,
                        description: fd.description,
                        categoryId:  fd.categoryId,
                        courseType:  fd.courseType,
                        resourceIds: []
                    })
                }).done(() => {
                    showToast("Course updated successfully.", "success", 2000);
                    $("#pageTitle").text(fd.courseName || "Course Dashboard");
                    $("#pageSubtitle").text(fd.courseCode ? `Code: ${fd.courseCode}` : "Manage course information and versions");
                }).fail((xhr) => {
                    showToast(xhr.responseJSON?.message || "Error updating course.", "error");
                }).always(() => {
                    $btn.css("opacity", 1).html('<i class="fas fa-save"></i> Save Changes');
                });
            });

            // ── 4. Status UI helpers ───────────────────────────────────
            function updateStatusUI(isActive) {
                const $publishIcon    = $("#publishIcon");
                const $publishIconBox = $("#publishIconBox");
                const $publishBtnText = $("#publishBtnText");
                const $publishBtnDesc = $("#publishBtnDesc");
                const $btnDelete      = $("#btnDeleteCourse");
                const $btnAssignment  = $("#btnAssignment");
                const $statusBadge    = $("#courseStatusBadge");
                const $warnMsg        = $("#warningMsg");

                if (isActive) {
                    $publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    $publishIconBox.css({ background: "#fffbe6", color: "var(--warning-color)" });
                    $publishBtnText.text("Close Course");
                    $publishBtnDesc.text("Deactivate — stop new learners");
                    $statusBadge.removeClass("pill-default pill-warning pill-danger pill-info")
                                .addClass("pill-success")
                                .html('<i class="fas fa-check-circle me-1"></i> Active');
                    $btnDelete.addClass("disabled").css("opacity", 0.4).css("pointer-events", "none");
                    $btnAssignment.removeClass("disabled").css({ opacity: 1, pointerEvents: "" });
                    $warnMsg.removeClass("d-none");
                } else {
                    $publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    $publishIconBox.css({ background: "#fafafa", color: "var(--text-secondary)" });
                    $publishBtnText.text("Publish Course");
                    $publishBtnDesc.text("Make course available");
                    $statusBadge.removeClass("pill-success pill-warning pill-danger pill-info")
                                .addClass("pill-default")
                                .html('<i class="fas fa-lock me-1"></i> Closed');
                    $btnDelete.removeClass("disabled").css({ opacity: 1, pointerEvents: "" });
                    $btnAssignment.addClass("disabled").css("opacity", 0.4).css("pointer-events", "none");
                    $warnMsg.addClass("d-none");
                }
            }

           // ── 5. Toggle Publish ──────────────────────────────────────
            $("#btnTogglePublish").click(function(e) {
                e.preventDefault();
                const $btn = $(this);

                if ($btn.hasClass("disabled")) return;
                $btn.addClass("disabled opacity-50 pe-none");

                const newState  = !isCourseActive;
                const confirmMsg = newState
                    ? "Publish this course?"
                    : "Close this course?";

                DevExpress.ui.dialog.confirm(confirmMsg, "Confirm Status Change").done(function(ok) {
                    if (!ok) { $btn.removeClass("disabled opacity-50 pe-none"); return; }

                    $.ajax({
                        url: `${courseApiUrl}/${courseId}/status`,
                        type: 'PUT',
                        contentType: 'application/json',
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({ isActive: newState })
                    }).done((response) => {
                        isCourseActive = newState;
                        updateStatusUI(isCourseActive);

                        const successMsg = response.message || (newState ? "Course published!" : "Course closed.");
                        showToast(successMsg, "success", 2000);

                        $btn.removeClass("disabled opacity-50 pe-none");
                    }).fail((xhr) => {
                        let errorMsg = "Error updating status.";
                        if (xhr.responseJSON) {
                            errorMsg = xhr.responseJSON.message || errorMsg;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }

                        showToast(errorMsg, "error", 4000);
                        $btn.removeClass("disabled opacity-50 pe-none");
                    });
                });
            });

            // ── 6. Delete Course ───────────────────────────────────────
            $("#btnDeleteCourse").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) return;

                DevExpress.ui.dialog.confirm("Delete this course permanently? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${courseApiUrl}/${courseId}`,
                        type: 'DELETE',
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        showToast("Course deleted.", "success", 2000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1500);
                    }).fail((xhr) => {
                        showToast(xhr.responseJSON?.message || "Error deleting course.", "error");
                    });
                });
            });

            // ── 7. Navigation buttons ──────────────────────────────────
                   function goNewVersion() {
            window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
        }
            $("#btnNewVersion").on("click", (e) => { e.preventDefault(); goNewVersion(); });

            $("#btnAssignment").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    showToast("Please publish the course before managing assignments.", "warning", 2500);
                    return;
                }
                window.location.href = '@Url.Action("Form", "Assignments")?courseId=' + courseId;
            });

            // ── 8. Versions CardView ──────────────────────────────────
        

            function renderVersionCards(versions) {
                versionsData = versions || [];

                // 1. สร้าง Toolbar สำหรับช่องค้นหา และปุ่มเพิ่มเวอร์ชัน (ทำแค่ครั้งแรก)
                if (!$("#versionsToolbar").hasClass("dx-toolbar")) {
                    $("#versionsToolbar").dxToolbar({
                        items: [
                            {
                                location: "before",
                                widget: "dxTextBox",
                                options: {
                                    placeholder: "Search versions...",
                                    width: 250,
                                    mode: "search",
                                    valueChangeEvent: "keyup",
                                    onValueChanged: function(e) {
                                        drawCards(e.value);
                                    }
                                }
                            },
                            {
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "plus",
                                    text: "New Version",
                                    type: "default",
                                    stylingMode: "text",
                                    onClick: goNewVersion
                                }
                            }
                        ]
                    });
                }

                // 2. สั่งวาด Cards
                drawCards("");
            }

            function drawCards(searchText) {
                const $container = $("#versionsCardContainer");
                $container.empty();

                // กรองข้อมูลตามคำค้นหา
                const filtered = versionsData.filter(v => {
                    if (!searchText) return true;
                    const term = searchText.toLowerCase();
                    return (v.note && v.note.toLowerCase().includes(term)) ||
                           (v.versionNumber && v.versionNumber.toString().includes(term));
                });

                if (filtered.length === 0) {
                    $container.html('<div class="col-12 text-center text-secondary py-4">No versions found.</div>');
                    return;
                }

                // วนลูปวาด Card ตามดีไซน์เดิม
                filtered.forEach(v => {
                    const ia = v.isActive;
                    const resources = v.resources || [];
                    const badge = ia
                        ? '<span class="tag-pill pill-info" style="font-size:10px;"><i class="fas fa-check-circle me-1"></i>Active</span>'
                        : '<span class="tag-pill pill-default" style="font-size:10px;">Draft</span>';

                    const editHref = `@Url.Action("VersionForm", "Courses")?id=${v.id}&courseId=${courseId}`;
                    let actions = `<a class="dropdown-item py-2 d-flex align-items-center gap-2" href="${editHref}"><i class="fas fa-edit" style="width:14px;color:var(--warning-color);"></i><span style="font-size:12px;">Edit</span></a>`;

                    if (!ia) {
                        actions += `<a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0);" onclick="setActiveVersion(${v.id})"><i class="fas fa-check-circle" style="width:14px;color:var(--accent-color);"></i><span style="font-size:12px;">Set Active</span></a>`;
                        actions += '<hr class="dropdown-divider my-1">';
                        actions += `<a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="javascript:void(0);" onclick="deleteVersion(${v.id})"><i class="fas fa-trash-alt" style="width:14px;"></i><span style="font-size:12px;">Delete</span></a>`;
                    }

                    // Build resource list HTML directly from embedded data
                    let resourcesHtml = '';
                    if (resources.length === 0) {
                        resourcesHtml = '<span style="font-size:11px;color:var(--text-secondary);opacity:.5;font-style:italic;">No files attached</span>';
                    } else {
                        resources.forEach((r, idx) => {
                            const typeCls  = r.typeId === 1 ? "pill-learn" : "pill-exam";
                            const typeName = r.typeName || (r.typeId === 1 ? "Learn" : "Exam");
                            const previewBtn = r.isActive
                                ? `<a href="javascript:void(0);" onclick="window.viewContent(${r.id},'${(r.name || '').replace(/'/g, "\\'")}')" style="font-size:11px;color:var(--accent-color);flex-shrink:0;" title="Preview"><i class="fas fa-external-link-alt"></i></a>`
                                : '';
                            resourcesHtml += `
                                <div class="d-flex align-items-center gap-2 mb-1" style="padding:4px 8px;border:1px solid var(--border-color);border-radius:3px;font-size:11px;">
                                    <span style="min-width:16px;font-weight:600;color:var(--text-secondary);text-align:center;">${idx + 1}</span>
                                    <span class="text-truncate flex-grow-1" style="color:var(--text-primary);font-weight:500;" title="${r.name}">${r.name}</span>
                                    <span class="tag-pill ${typeCls}" style="flex-shrink:0;font-size:10px;">${typeName}</span>
                                    ${previewBtn}
                                </div>`;
                        });
                    }

                    const cardHtml = `
                        <div class="col-md-4 mb-2">
                            <div style="padding:16px 18px;border:1px solid var(--border-color);border-radius:6px; height:100%;
                                        background:${ia ? '#fafeff' : '#fff'};${ia ? 'border-left:3px solid var(--accent-color);' : ''}">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div style="font-size:14px;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Version ${v.versionNumber}</div>
                                        ${badge}
                                    </div>
                                    <div class="dropdown">
                                        <button class="btn btn-sm p-1 text-secondary" style="background:none;border:none;" type="button" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v" style="font-size:11px;"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-1" style="border-radius:4px;min-width:150px;">${actions}</ul>
                                    </div>
                                </div>
                                <div style="font-size:11px;color:var(--text-secondary);min-height:28px;padding:6px 0; border-bottom:1px solid var(--border-color);margin-bottom:8px;">
                                    ${v.note || '<span style="opacity:.4;font-style:italic;">No description</span>'}
                                </div>
                                <div class="cv-res">${resourcesHtml}</div>
                            </div>
                        </div>
                    `;
                    $container.append(cardHtml);
                });

                // Init bootstrap dropdowns after DOM insertion
                setTimeout(() => {
                    $container.find('[data-bs-toggle="dropdown"]').each(function() {
                        new bootstrap.Dropdown(this);
                    });
                }, 0);
            }

            // Reload versions via dedicated endpoint (used after set-active / delete)
            function reloadVersions() {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const versions = res.data || [];
                    renderVersionCards(versions);
                }).fail(function() {
                    $("#versionsCardContainer").html('<div class="col-12 text-center text-danger py-4">Error loading versions.</div>');
                });
            }

            // ── 9. Preview content ─────────────────────────────────────
            window.viewContent = function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;
                if (resourceName.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content...</div>";
                    }
                    $.ajax({ url: apiUrl, method: "GET", xhrFields: { withCredentials: true } })
                        .done(res => { if (res?.url && win) win.location.href = res.url; else { if (win) win.close(); showToast("Content URL not found.", "error"); } })
                        .fail(() => { if (win) win.close(); showToast("Failed to get content link.", "error"); });
                } else {
                    window.open(apiUrl, '_blank');
                }
            };

            // ── 10. Version actions ────────────────────────────────────
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true }
                }).done(() => {
                    showToast("Active version updated.", "success", 2000);
                    reloadVersions();
                }).fail((xhr) => {
                    showToast(xhr.responseJSON?.message || "Error updating active version.", "error");
                });
            };

            window.deleteVersion = function(vId) {
                DevExpress.ui.dialog.confirm("Delete this version? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${courseApiUrl}/versions/${vId}`,
                        type: 'DELETE',
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        showToast("Version deleted.", "success", 2000);
                        reloadVersions();
                    }).fail((xhr) => {
                        showToast(xhr.responseJSON?.message || "Error deleting version.", "error");
                    });
                });
            };

            // ── 11. Dashboard Tabs ─────────────────────────────────────
            const tabItems = [
                { text: "Content Versions", icon: "fas fa-code-branch", panel: "panel-versions" },
                { text: "Learners",         icon: "fas fa-users",       panel: "panel-learners" },
                { text: "Assignments",      icon: "fas fa-clipboard-list", panel: "panel-assignments" }
            ];

            $("#dashboardTabs").dxTabs({
                dataSource: tabItems,
                selectedIndex: 0,
                itemTemplate: function(itemData) {
                    return $("<span>").append(
                        $("<i>").addClass(itemData.icon + " me-1"),
                        $("<span>").text(itemData.text)
                    );
                },
                onItemClick: function(e) {
                    tabItems.forEach(t => $("#" + t.panel).hide());
                    $("#" + e.itemData.panel).show();

                    if (e.itemData.panel === "panel-learners" && !learnersLoaded) {
                        loadLearners();
                    }
                    if (e.itemData.panel === "panel-assignments" && !assignmentsLoaded) {
                        loadAssignments();
                    }
                }
            });

            // ── 12. Learners Grid ──────────────────────────────────────
            let learnersLoaded = false;
            const learnersGrid = initDxGrid("#grid-learners", {
                dataSource: [],
                showBorders: false,
                showRowLines: true,
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                height: 520,
                scrolling: { mode: "standard" },
                paging:  { enabled: true, pageSize: 10 },
                pager:   { visible: true, showInfo: true, showNavigationButtons: true, showPageSizeSelector: true, allowedPageSizes: [10, 20, 50] },
                searchPanel: { visible: true, placeholder: "Search by ID or name..." },
                columns: [
                    {
                        dataField: "studentCode", caption: "Employee ID", width: 130,
                        cellTemplate: (c, o) =>
                            $("<a>").attr("href", `@Url.Action("Profile", "Students")?code=${o.value}`)
                                   .addClass("tag-pill pill-default fw-bold")
                                   .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "studentName", caption: "Full Name", minWidth: 180,
                        cellTemplate: (c, o) =>
                            $("<span>").addClass("fw-medium text-dark")
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "division", caption: "Division", width: 130,
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "department", caption: "Department", width: 130,
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "progress", caption: "Progress", width: 140, alignment: "center",
                        cellTemplate: (c, o) => {
                            const pct   = o.value || 0;
                            const color = pct === 100 ? "var(--success-color)"
                                        : pct >= 50  ? "var(--accent-color)"
                                        :               "var(--warning-color)";
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append(
                                    $("<div>").css({ flex: "1", height: "3px", background: "var(--border-color)",
                                                     borderRadius: "2px", overflow: "hidden" })
                                        .append($("<div>").css({ height: "100%", width: pct + "%", background: color }))
                                )
                                .append(
                                    $("<span>").css({ fontSize: "11px", fontWeight: "600",
                                                      minWidth: "32px", color: "var(--text-secondary)" })
                                               .text(pct + "%")
                                )
                                .appendTo(c);
                        }
                    },
                    {
                        dataField: "status", caption: "Status", width: 120, alignment: "center",
                        cellTemplate: (c, o) => {
                            const map = {
                                "Completed":  { cls: "pill-success", text: "Completed"   },
                                "Upcoming":   { cls: "pill-warning",  text: "Upcoming"    },
                                "Expired":    { cls: "pill-danger",   text: "Expired"     },
                                "InProgress": { cls: "pill-info",   text: "In Progress" },
                                "NotStarted": { cls: "pill-default",  text: "Not Started" }
                            };
                            const s = map[o.value] ?? { cls: "pill-default", text: o.value || "—" };
                            $(`<span class="status-pill ${s.cls}">${s.text}</span>`).appendTo(c);
                        }
                    },
                    {
                        dataField: "startDate", caption: "Start", width: 100, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    },
                    {
                        dataField: "dueDate", caption: "Due", width: 100, alignment: "center",
                        cellTemplate: (c, o) => {
                            if (!o.value) { $("<span>").css("color","var(--text-secondary)").text("—").appendTo(c); return; }
                            const isPast = new Date(o.value) < new Date();
                            $("<span>").css({ fontSize: "11px",
                                              color: isPast ? "var(--danger-color)" : "var(--text-secondary)",
                                              fontWeight: isPast ? "600" : "400" })
                                       .text(new Date(o.value).toLocaleDateString("en-GB")).appendTo(c);
                        }
                    },
                    {
                        dataField: "completedDate", caption: "Completed", width: 110, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: o.value ? "var(--success-color)" : "var(--text-secondary)", fontWeight: o.value ? "600" : "400" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    }
                ]
            });

            function loadLearners() {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/learners`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const data = res.data || [];
                    learnersLoaded = true;
                    learnersGrid.option("dataSource", data);
                }).fail(function() {
                    showToast("Error loading learners.", "error");
                });
            }

            // ── 13. Assignments Grid ───────────────────────────────────
            let assignmentsLoaded = false;
            const assignmentsGrid = initDxGrid("#grid-assignments", {
                dataSource: [],
                showBorders: false,
                showRowLines: true,
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                height: 520,
                scrolling: { mode: "standard" },
                paging:  { enabled: true, pageSize: 10 },
                pager:   { visible: true, showInfo: true, showNavigationButtons: true, showPageSizeSelector: true, allowedPageSizes: [10, 20, 50] },
                searchPanel: { visible: true, placeholder: "Search assignments..." },
                onRowPrepared: function(e) {
                    if (e.rowType !== "data") return;
                    if (e.data.status === "Expired")   $(e.rowElement).css("background-color", "#fff2f0");
                    if (e.data.status === "Completed") $(e.rowElement).css("background-color", "#f6ffed");
                },
                columns: [
                    {
                        dataField: "assignmentNo", caption: "Assignment No", width: 150,
                        sortOrder: "desc", alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "700", color: "var(--text-primary)" })
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "description", caption: "Description", minWidth: 200,
                        cellTemplate: (c, o) => {
                            const t = o.value || "—";
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(t.length > 60 ? t.slice(0, 60) + "…" : t)
                                       .attr("title", t).appendTo(c);
                        }
                    },
                    {
                        dataField: "completionPct", caption: "Progress", width: 140, alignment: "center",
                        cellTemplate: (c, o) => {
                            const pct   = o.value || 0;
                            const color = pct === 100 ? "var(--success-color)"
                                        : pct >= 50  ? "var(--accent-color)"
                                        :               "var(--warning-color)";
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append(
                                    $("<div>").css({ flex: "1", height: "3px", background: "var(--border-color)",
                                                     borderRadius: "2px", overflow: "hidden" })
                                        .append($("<div>").css({ height: "100%", width: pct + "%", background: color }))
                                )
                                .append(
                                    $("<span>").css({ fontSize: "11px", fontWeight: "600",
                                                      minWidth: "32px", color: "var(--text-secondary)" })
                                               .text(pct + "%")
                                )
                                .appendTo(c);
                        }
                    },
                    {
                        dataField: "status", caption: "Status", width: 120, alignment: "center",
                        cellTemplate: (c, o) => {
                            const map = {
                                "Completed":  { cls: "pill-success", text: "Completed"   },
                                "Upcoming":   { cls: "pill-warning",  text: "Upcoming"    },
                                "Expired":    { cls: "pill-danger",   text: "Expired"     },
                                "InProgress": { cls: "pill-info",   text: "In Progress" }
                            };
                            const s = map[o.value] ?? { cls: "pill-default", text: o.value || "—" };
                            $(`<span class="status-pill ${s.cls}">${s.text}</span>`).appendTo(c);
                        }
                    },
                    {
                        dataField: "totalEnrollmentCount", caption: "Enrolled", width: 90, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600" })
                                       .text(o.value ?? 0).appendTo(c)
                    },
                    {
                        dataField: "completedEnrollmentCount", caption: "Done", width: 80, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600", color: "var(--success-color)" })
                                       .text(o.value ?? 0).appendTo(c)
                    },
                    {
                        dataField: "startDate", caption: "Start", width: 100, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    },
                    {
                        dataField: "dueDate", caption: "Due", width: 100, alignment: "center",
                        cellTemplate: (c, o) => {
                            if (!o.value) { $("<span>").css("color","var(--text-secondary)").text("—").appendTo(c); return; }
                            const isPast = new Date(o.value) < new Date();
                            $("<span>").css({ fontSize: "11px",
                                              color: isPast ? "var(--danger-color)" : "var(--text-secondary)",
                                              fontWeight: isPast ? "600" : "400" })
                                       .text(new Date(o.value).toLocaleDateString("en-GB")).appendTo(c);
                        }
                    },
                    {
                        type: "buttons", caption: "", width: 70,
                        alignment: "center", fixed: true, fixedPosition: "right",
                        buttons: [{
                            hint: "View Dashboard", icon: "info",
                            onClick: e => window.location.href = `@Url.Action("Progress", "Assignments")/${e.row.data.id}`
                        }]
                    }
                ]
            });

            function loadAssignments() {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/assignments`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const data = res.data || [];
                    assignmentsLoaded = true;
                    assignmentsGrid.option("dataSource", data);
                }).fail(function() {
                    showToast("Error loading assignments.", "error");
                });
            }
        });
    </script>
}