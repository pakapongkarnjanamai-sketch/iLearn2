@{
    ViewBag.Title = "Course Dashboard";
    int courseId = ViewBag.CourseId;
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .action-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent;
    }

        .action-card:hover {
            transform: translateY(-3px);
            border-color: #0d6efd !important;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }

    .version-card-active {
        border-left: 4px solid #0d6efd !important;
    }
</style>

<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                    <i class="fas fa-book-open fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold text-dark" id="pageTitle">Course Dashboard</h1>
                    <small class="text-muted" id="pageSubtitle">Manage course information and versions</small>
                </div>
            </div>
            <a href="@Url.Action("Index", "Courses")" class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3 fw-medium">
                <i class="fas fa-arrow-left me-1"></i> Back to Courses
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5">

    <div class="row g-4 mb-4">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-info-circle text-primary me-2"></i> Course Information
                    </h6>
                    <span id="courseStatusBadge" class="badge bg-secondary fw-normal px-3 py-1 rounded-pill">
                        <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                    </span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div id="courseInfoForm"></div>
                    <div class="text-end mt-4 pt-3 border-top">
                        <button id="btnSaveCourse" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-medium">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-bolt text-primary me-2"></i> Quick Actions
                    </h6>
                </div>
                <div class="card-body px-4 pb-4">
                    <div class="d-flex flex-column gap-3">

                        <a href="javascript:void(0);" id="btnNewVersion" class="action-card d-flex align-items-center p-3 rounded-3 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3 me-3 flex-shrink-0">
                                <i class="fas fa-code-branch fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">New Version</h6>
                                <small class="text-muted">Create a new content version</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnAssignment" class="action-card d-flex align-items-center p-3 rounded-3 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3 me-3 flex-shrink-0">
                                <i class="fas fa-user-plus fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Assignments</h6>
                                <small class="text-muted">Assign course to employees</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnTogglePublish" class="action-card d-flex align-items-center p-3 rounded-3 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-3 me-3 flex-shrink-0" id="publishIconBox">
                                <i id="publishIcon" class="fas fa-globe fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark" id="publishBtnText">Publish Course</h6>
                                <small class="text-muted" id="publishBtnDesc">Make course available</small>
                            </div>
                        </a>

                        <a href="javascript:void(0);" id="btnDeleteCourse" class="action-card d-flex align-items-center p-3 rounded-3 bg-light shadow-sm text-decoration-none">
                            <div class="icon-box bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-3 me-3 flex-shrink-0">
                                <i class="fas fa-trash-alt fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark">Delete Course</h6>
                                <small class="text-muted">Remove permanently</small>
                            </div>
                        </a>

                    </div>

                    <div id="warningMsg" class="alert alert-warning border-0 rounded-3 small mt-3 mb-0 py-2 px-3 d-none">
                        <i class="fas fa-exclamation-triangle me-1"></i> Cannot delete an active course.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="fas fa-code-branch text-primary me-2"></i> Content Versions
            </h6>
            <button class="btn btn-primary btn-sm rounded-3 px-3 fw-medium shadow-sm" id="btnNewVersionHeader">
                <i class="fas fa-plus me-1"></i> New Version
            </button>
        </div>
        <div class="card-body p-4">
            <div id="versionsContainer" class="row g-4">
                <div class="col-12 text-center text-muted py-5">
                    <i class="fas fa-circle-notch fa-spin fa-2x mb-3 text-primary"></i>
                    <p class="mb-0 fw-medium">Loading versions...</p>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = serviceUrl + '/courses';

        const divisionsStore  = createDataStore(serviceUrl, 'admin/DivisionsCRUD',  { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        let isCourseActive = false;
        let courseForm;

        $(async () => {

            // ── 1. Build form ──────────────────────────────────────────
            courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 1,
                items: [
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: function(e) {
                                        const catEditor = courseForm.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();
                                        if (e.event) catEditor.option("value", null);
                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    disabled: true,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                }
                            }
                        ]
                    },
                    {
                        dataField: "courseName",
                        label: { text: "Course Name" },
                        validationRules: [{ type: "required", message: "Course Name is required" }],
                        editorOptions: { placeholder: "e.g. Introduction to Cybersecurity" }
                    },
                    {
                        dataField: "description",
                        label: { text: "Description" },
                        editorType: "dxTextArea",
                        editorOptions: { height: 90, placeholder: "Course summary and objectives..." }
                    }
                ]
            }).dxForm("instance");

            // ── 2. Load course data ────────────────────────────────────
            try {
                const response = await $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                const data = response.data || response;

                // Update page header with course title
                $("#pageTitle").text(data.courseName || "Course Dashboard");
                $("#pageSubtitle").text(data.courseCode ? `Code: ${data.courseCode}` : "Manage course information and versions");

                // Resolve divisionId from category if needed
                let divisionId = data.divisionId || null;
                if (!divisionId && data.categoryId) {
                    try {
                        const catData = await $.ajax({
                            url: `${serviceUrl}/admin/CategoriesCRUD/Get/${data.categoryId}`,
                            type: 'GET',
                            xhrFields: { withCredentials: true }
                        });
                        divisionId = catData.divisionId || null;
                    } catch(e) { /* ignore */ }
                }

                // Pre-enable category editor if we have a division
                if (divisionId) {
                    const catEditor = courseForm.getEditor("categoryId");
                    catEditor.option("disabled", false);
                    catEditor.getDataSource().filter(["divisionId", "=", divisionId]);
                    catEditor.getDataSource().load();
                }

                courseForm.option("formData", {
                    divisionId:   divisionId,
                    courseCode:   data.courseCode,
                    courseName:   data.courseName,
                    description:  data.description,
                    categoryId:   data.categoryId,
                    courseType:   data.courseType
                });

                isCourseActive = data.isActive;
                updateStatusUI(isCourseActive);

            } catch(xhr) {
                DevExpress.ui.notify("Error loading course: " + (xhr.responseJSON?.message || "Unknown error"), "error", 3000);
            }

            // ── 3. Save ────────────────────────────────────────────────
            $("#btnSaveCourse").click(function() {
                if (!courseForm.validate().isValid) {
                    DevExpress.ui.notify("Please fill in all required fields.", "warning", 2000);
                    return;
                }
                const fd = courseForm.option("formData");
                const $btn = $(this).prop("disabled", true).html('<i class="fas fa-spinner fa-spin me-1"></i> Saving...');

                $.ajax({
                    url: `${courseApiUrl}/${courseId}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify({
                        courseCode:  fd.courseCode,
                        courseName:  fd.courseName,
                        description: fd.description,
                        categoryId:  fd.categoryId,
                        courseType:  fd.courseType,
                        resourceIds: []
                    })
                }).done(() => {
                    DevExpress.ui.notify("Course updated successfully.", "success", 2000);
                    $("#pageTitle").text(fd.courseName || "Course Dashboard");
                    $("#pageSubtitle").text(fd.courseCode ? `Code: ${fd.courseCode}` : "Manage course information and versions");
                }).fail((xhr) => {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "Error updating course.", "error", 3000);
                }).always(() => {
                    $btn.prop("disabled", false).html('<i class="fas fa-save me-1"></i> Save Changes');
                });
            });

            // ── 4. Status UI helpers ───────────────────────────────────
            function updateStatusUI(isActive) {
                const $publishIcon    = $("#publishIcon");
                const $publishIconBox = $("#publishIconBox");
                const $publishBtnText = $("#publishBtnText");
                const $publishBtnDesc = $("#publishBtnDesc");
                const $btnDelete      = $("#btnDeleteCourse");
                const $btnAssignment  = $("#btnAssignment");
                const $statusBadge    = $("#courseStatusBadge");
                const $warnMsg        = $("#warningMsg");

                if (isActive) {
                    $publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    $publishIconBox.removeClass("bg-primary text-primary").addClass("bg-warning text-warning");
                    $publishBtnText.text("Close Course");
                    $publishBtnDesc.text("Deactivate — stop new learners");
                    $statusBadge.removeClass("bg-secondary").addClass("bg-success")
                        .html('<i class="fas fa-check-circle me-1"></i> Active');

                    $btnDelete.addClass("disabled opacity-50 pe-none");
                    $btnAssignment.removeClass("disabled opacity-50 pe-none");
                    $warnMsg.removeClass("d-none");
                } else {
                    $publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    $publishIconBox.removeClass("bg-warning text-warning").addClass("bg-primary text-primary");
                    $publishBtnText.text("Publish Course");
                    $publishBtnDesc.text("Make course available");
                    $statusBadge.removeClass("bg-success").addClass("bg-secondary")
                        .html('<i class="fas fa-lock me-1"></i> Closed');

                    $btnDelete.removeClass("disabled opacity-50 pe-none");
                    $btnAssignment.addClass("disabled opacity-50 pe-none");
                    $warnMsg.addClass("d-none");
                }
            }

            // ── 5. Toggle Publish ──────────────────────────────────────
            $("#btnTogglePublish").click(function(e) {
                e.preventDefault();
                const $btn = $(this);
                if ($btn.hasClass("disabled")) return;
                $btn.addClass("disabled opacity-50 pe-none");

                const newState  = !isCourseActive;
                const confirmMsg = newState
                    ? "Publish this course? Employees will be able to enroll immediately."
                    : "Close this course? Employees will no longer be able to enroll.";

                DevExpress.ui.dialog.confirm(confirmMsg, "Confirm Status Change").done(function(ok) {
                    if (!ok) { $btn.removeClass("disabled opacity-50 pe-none"); return; }

                    $.ajax({
                        url: `${courseApiUrl}/${courseId}/status`,
                        type: 'PATCH',
                        contentType: 'application/json',
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({ isActive: newState })
                    }).done(() => {
                        isCourseActive = newState;
                        updateStatusUI(isCourseActive);
                        DevExpress.ui.notify(newState ? "Course published!" : "Course closed.", "success", 2000);
                        $btn.removeClass("disabled opacity-50 pe-none");
                    }).fail((xhr) => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Error updating status.", "error", 3000);
                        $btn.removeClass("disabled opacity-50 pe-none");
                    });
                });
            });

            // ── 6. Delete Course ───────────────────────────────────────
            $("#btnDeleteCourse").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) return;

                DevExpress.ui.dialog.confirm("Delete this course permanently? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${courseApiUrl}/${courseId}`,
                        type: 'DELETE',
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        DevExpress.ui.notify("Course deleted.", "success", 2000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1500);
                    }).fail((xhr) => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Error deleting course.", "error", 3000);
                    });
                });
            });

            // ── 7. Navigation buttons ──────────────────────────────────
            const goNewVersion = () => {
                window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + courseId;
            };
            $("#btnNewVersion").on("click", (e) => { e.preventDefault(); goNewVersion(); });
            $("#btnNewVersionHeader").on("click", goNewVersion);

            $("#btnAssignment").click(function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    DevExpress.ui.notify("Please publish the course before managing assignments.", "warning", 2500);
                    return;
                }
                window.location.href = '@Url.Action("Form", "Assignments")?courseId=' + courseId;
            });

            // ── 8. Load Versions ───────────────────────────────────────
            function loadVersions() {
                $.ajax({
                    url: `${serviceUrl}/admin/CourseVersionsCRUD/Get`,
                    data: { filter: JSON.stringify(["courseId", "=", courseId]) },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const rawData = res.data || res;
                    const versions = Array.isArray(rawData) ? rawData : (rawData.data || []);
                    versions.sort((a, b) => b.versionNumber - a.versionNumber);

                    const $container = $("#versionsContainer").empty();

                    if (versions.length === 0) {
                        $container.html(`
                            <div class="col-12 text-center text-muted py-5">
                                <i class="fas fa-layer-group fa-3x mb-3 opacity-25"></i>
                                <p class="mb-3 fw-medium">No versions yet.</p>
                                <button class="btn btn-primary btn-sm rounded-3 px-4 fw-medium" onclick="$('#btnNewVersion').trigger('click')">
                                    <i class="fas fa-plus me-1"></i> Create First Version
                                </button>
                            </div>`);
                        return;
                    }

                    versions.forEach(v => {
                        const isActive = v.isActive;

                        const activeBadge = isActive
                            ? `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill fw-medium" style="font-size:0.7rem;">
                                   <i class="fas fa-check-circle me-1"></i>Active
                               </span>`
                            : `<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill fw-medium" style="font-size:0.7rem;">Draft</span>`;

                        const editItem = `
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="@Url.Action("VersionForm", "Courses")?id=${v.id}&courseId=${courseId}">
                                    <i class="fas fa-edit text-warning" style="width:16px;"></i> Edit
                                </a>
                            </li>`;

                        const inactiveItems = !isActive ? `
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0);" onclick="setActiveVersion(${v.id})">
                                    <i class="fas fa-check-circle text-primary" style="width:16px;"></i> Set as Active
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="javascript:void(0);" onclick="deleteVersion(${v.id})">
                                    <i class="fas fa-trash-alt" style="width:16px;"></i> Delete
                                </a>
                            </li>` : '';

                        const cardBorderClass = isActive ? 'version-card-active' : '';
                        const cardBg          = isActive ? '' : 'style="background-color:#fafafa;"';

                        const cardHtml = `
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm rounded-4 ${cardBorderClass}" ${cardBg}>
                                    <div class="card-body p-4">

                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark fs-5">Version ${v.versionNumber}</h6>
                                                ${activeBadge}
                                            </div>
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm border-0 px-2 py-1 rounded-3 text-secondary"
                                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 py-2 mt-1">
                                                    ${editItem}${inactiveItems}
                                                </ul>
                                            </div>
                                        </div>

                                        <p class="text-muted small mb-3 pb-3 border-bottom" style="min-height:36px;">
                                            ${v.note ? v.note : '<span class="fst-italic opacity-50">No description</span>'}
                                        </p>

                                        <div id="res-container-${v.id}" class="small">
                                            <span class="text-muted fst-italic">
                                                <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>`;

                        $container.append(cardHtml);
                        loadVersionResources(v.id);
                    });

                }).fail(function() {
                    $("#versionsContainer").html('<div class="col-12 text-center text-danger py-4">Error loading versions.</div>');
                });
            }

            function loadVersionResources(versionId) {
                $.ajax({
                    url: `${serviceUrl}/admin/CourseResourcesCRUD/Get`,
                    data: { filter: JSON.stringify(["courseVersionId", "=", versionId]), expand: "resource" },
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    const rawData  = res.data || res;
                    const resources = Array.isArray(rawData) ? rawData : (rawData.data || []);
                    const $cont    = $(`#res-container-${versionId}`).empty();

                    if (resources.length === 0) {
                        $cont.html('<span class="text-muted fst-italic opacity-75">No files attached</span>');
                        return;
                    }

                    resources.sort((a, b) => (a.order ?? 0) - (b.order ?? 0));

                    resources.forEach((cr, idx) => {
                        const r = cr.resource;
                        if (!r) return;

                        const order      = cr.order ?? (idx + 1);
                        const icon       = r.typeId === 1 ? 'fa-book text-info' : 'fa-file-alt text-warning';
                        const typeBadge  = r.typeId === 1
                            ? `<span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2" style="font-size:0.65rem;">Learn</span>`
                            : `<span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2" style="font-size:0.65rem;">Exam</span>`;
                        const previewBtn = r.isActive
                            ? `<button class="btn btn-sm btn-link text-primary p-0 ms-1 text-decoration-none fw-medium flex-shrink-0"
                                       onclick="window.viewContent(${r.id},'${r.name.replace(/'/g, "\\'")}')" title="Preview">
                                   <i class="fas fa-external-link-alt" style="font-size:0.75rem;"></i>
                               </button>`
                            : '';

                        $cont.append(`
                            <div class="d-flex align-items-center gap-2 mb-2 p-2 bg-white border border-light rounded-3 shadow-sm">
                                <span class="badge bg-light text-muted border fw-normal flex-shrink-0" style="min-width:24px;">${order}</span>
                                <i class="fas ${icon} flex-shrink-0"></i>
                                <span class="text-truncate flex-grow-1 text-dark fw-medium small" title="${r.name}">${r.name}</span>
                                ${typeBadge}
                                ${previewBtn}
                            </div>`);
                    });

                }).fail(function() {
                    $(`#res-container-${versionId}`).html('<span class="text-danger small">Error loading files</span>');
                });
            }

            // ── 9. Preview content ─────────────────────────────────────
            window.viewContent = function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;
                if (resourceName.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content...</div>";
                    }
                    $.ajax({ url: apiUrl, method: "GET", xhrFields: { withCredentials: true } })
                        .done(res => { if (res?.url && win) win.location.href = res.url; else { if (win) win.close(); DevExpress.ui.notify("Content URL not found.", "error", 3000); } })
                        .fail(() => { if (win) win.close(); DevExpress.ui.notify("Failed to get content link.", "error", 3000); });
                } else {
                    window.open(apiUrl, '_blank');
                }
            };

            // ── 10. Version actions ────────────────────────────────────
            window.setActiveVersion = function(vId) {
                $.ajax({
                    url: `${courseApiUrl}/${courseId}/versions/${vId}/set-active`,
                    type: 'PATCH',
                    xhrFields: { withCredentials: true }
                }).done(() => {
                    DevExpress.ui.notify("Active version updated.", "success", 2000);
                    loadVersions();
                }).fail((xhr) => {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "Error updating active version.", "error", 3000);
                });
            };

            window.deleteVersion = function(vId) {
                DevExpress.ui.dialog.confirm("Delete this version? This cannot be undone.", "Confirm Delete").done(function(ok) {
                    if (!ok) return;
                    $.ajax({
                        url: `${serviceUrl}/admin/CourseVersionsCRUD/Delete`,
                        type: 'DELETE',
                        data: { key: vId },
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        DevExpress.ui.notify("Version deleted.", "success", 2000);
                        loadVersions();
                    }).fail((xhr) => {
                        DevExpress.ui.notify(xhr.responseJSON?.message || "Error deleting version.", "error", 3000);
                    });
                });
            };

            loadVersions();
        });
    </script>
}