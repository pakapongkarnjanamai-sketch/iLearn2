@{
    ViewBag.Title = (ViewBag.Id == null ? "Create New Course" : "Edit Course");
    var isEdit = ViewBag.Id != null;
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* สไตล์การ์ดปุ่มกด */
    .action-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent; /* เตรียมขอบไว้สำหรับ Hover */
    }

        .action-card:hover {
            transform: translateY(-4px);
            border-color: #0d6efd !important; /* เปลี่ยนสีกรอบเป็นสีน้ำเงินตอน Hover */
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }

    /* กล่องสำหรับใส่ Icon */
    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        flex-shrink: 0;
    }
</style>

<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fas @(isEdit ? "fa-edit" : "fa-plus") fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                    <small class="text-muted">@(isEdit ? "Update course details and manage resources." : "Create a new training course for employees.")</small>
                </div>
            </div>
            <button id="btn-cancel-top" class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3" onclick="history.back()">
                <i class="fas fa-arrow-left me-1"></i> Back
            </button>
        </div>
    </div>
</div>

<div class="container px-4 pb-5 mb-5">
    <div id="load-panel"></div>

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.15rem;">
                        Course Information
                    </h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <div id="form-container"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1.15rem;">
                        Course Content List
                    </h5>
                    <span class="badge bg-primary px-3 py-2 rounded-pill fw-normal shadow-sm" id="total-count-badge">0 Items</span>
                </div>

                <div class="card-body px-4 pb-4">

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <a href="javascript:void(0);" id="btn-show-existing" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary me-3">
                                    <i class="fas fa-search fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold text-dark">1. Select Existing Resources</h6>
                                    <small class="text-muted">Choose files from the central library.</small>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-6">
                            <a href="javascript:void(0);" id="btn-trigger-upload" class="action-card d-flex align-items-center p-3 rounded-4 bg-light shadow-sm text-decoration-none">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary me-3">
                                    <i class="fas fa-cloud-upload-alt fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 fw-bold text-dark">2. Upload New SCORM</h6>
                                    <small class="text-muted">Drag & drop or click to browse .zip</small>
                                </div>
                            </a>
                            <div id="file-uploader-container"></div>
                        </div>
                    </div>

                    <div class="text-muted small mb-2 px-1">
                        <i class="fas fa-info-circle text-primary me-1"></i>
                        You can drag & drop rows to reorder the content.
                    </div>

                    <div class="bg-white border-light rounded-3 overflow-hidden shadow-sm">
                        <div id="master-resources-grid"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="fixed-bottom bg-white shadow-lg py-3 border-top" style="z-index: 100;">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                <i class="fas fa-check-circle me-1 text-primary"></i> Please verify all information and content order before saving.
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light border px-4 shadow-sm rounded-3" onclick="history.back()">Cancel</button>
                <div id="btn-save"></div>
            </div>
        </div>
    </div>
</div>

<div id="popup-existing"></div>

@section Scripts {
    <script>
        const COURSE_ID = @(ViewBag.Id ?? "null");
        const IS_EDIT = COURSE_ID != null;

        // Initialize DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];

        let formWidget;
        let masterGrid;
        let gridExisting;

        let unifiedResources = [];

        $(async () => {
            let formData = { courseType: 1, isActive: true };

            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            // --- Load Data (Edit Mode) ---
            if (IS_EDIT) {
                try {
                    loadPanel.show();
                    const courseData = await $.ajax({
                        url: `${serviceUrl}/courses/${COURSE_ID}`,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    formData = { ...courseData };

                    let existing = courseData.resources || [];
                    if (existing.length > 0) {
                        existing.forEach(r => {
                            unifiedResources.push({
                                uid: `EXISTING_${r.id}`,
                                realId: r.id,
                                name: r.name,
                                typeId: r.typeId,
                                isNew: false
                            });
                        });
                        refreshMasterGrid();
                    }

                    if (formData.categoryId && !formData.divisionId) {
                        try {
                            const catData = await $.ajax({
                                url: `${serviceUrl}/admin/CategoriesCRUD/Get/${formData.categoryId}`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            });
                            formData.divisionId = catData.divisionId;
                        } catch (e) { }
                    }
                } catch (err) {
                    console.error(err);
                    DevExpress.ui.notify("Error loading course data", "error", 3000);
                } finally {
                    loadPanel.hide();
                }
            }

            // --- 1. Form Widget Config ---
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        itemType: "group",

                        items: [ {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypes,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                },
                                validationRules: [{ type: "required", message: "Course Type is required" }]
                            },
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseName",
                                label: { text: "Course Title" },
                                validationRules: [{ type: "required", message: "Course Name is required" }],
                                editorOptions: { placeholder: "e.g. Intro to Cybersecurity" }
                            }
                        ]
                    },
                    {
                        itemType: "group",
                  
                        colCount: 2,
                        items: [
                                    {
            dataField: "divisionId",
            label: { text: "Division" },
            editorType: "dxSelectBox",
            editorOptions: {
                dataSource: divisionsStore,
                displayExpr: "name",
                valueExpr: "id",
                searchEnabled: true,
                showClearButton: true,
                placeholder: "Select Division",
                onValueChanged: function(e) {
                    const catEditor = formWidget.getEditor("categoryId");
                    const catDS = catEditor.getDataSource();

                    // เพิ่มส่วนนี้: ถ้าเกิดจากการเปลี่ยนค่าโดยผู้ใช้ (มี e.event) ให้เคลียร์ค่า Category เดิมทิ้ง
                    if (e.event) {
                        catEditor.option("value", null);
                    }

                    if (e.value) {
                        catEditor.option("disabled", false);
                        catDS.filter(["divisionId", "=", e.value]);
                        catDS.load();
                    } else {
                        catEditor.option("disabled", true);
                        catEditor.option("value", null);
                    }
                }
            }
        },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    disabled: !formData.divisionId,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                     
                        items: [
                           
                            {
                                dataField: "description",
                                label: { text: "Description" },
                                editorType: "dxTextArea",
                                editorOptions: {
                                    height: 120,
                                    placeholder: "Course summary and objectives..."
                                }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- 2. Master Grid ---
            masterGrid = $("#master-resources-grid").dxDataGrid({
                dataSource: unifiedResources,
                keyExpr: "uid",
                showBorders: false, // ปิด Border ขอบตารางให้ดูเนียนกับกล่อง
                columnAutoWidth: true,
                rowAlternationEnabled: true,
                showRowLines: true,
                noDataText: "No content added yet. Click buttons above to add.",
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = unifiedResources.findIndex(item => item.uid === visibleRows[e.toIndex].data.uid);
                        const fromIndex = unifiedResources.findIndex(item => item.uid === e.itemData.uid);

                        unifiedResources.splice(fromIndex, 1);
                        unifiedResources.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center",
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted fw-bold").text(options.rowIndex + 1).appendTo(container);
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const isNew = data.isNew;
                            // ใช้สี Secondary/Primary แทน Success แบบเก่าให้คลีนขึ้น
                            const iconClass = isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass}`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name))
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Type", width: 140, alignment: "center",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            if(data.isNew) {
                                $("<span>").addClass("badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1 fw-normal").html('<i class="fas fa-plus me-1"></i>New Upload').appendTo(container);
                            } else {
                                const tName = data.typeId === 1 ? "Learn" : "Exam";
                                $("<span>").addClass("badge bg-light text-dark border px-3 py-1 rounded-pill fw-normal").text(tName).appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center",
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                unifiedResources = unifiedResources.filter(r => r.uid !== e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            }).dxDataGrid("instance");

            function refreshMasterGrid() {
                masterGrid.option("dataSource", unifiedResources);
                $("#total-count-badge").text(`${unifiedResources.length} Items`);
            }

            // --- 3. Popup สำหรับเลือกไฟล์เก่า ---
            const popupExisting = $("#popup-existing").dxPopup({
                title: "Select Existing Resources",
                width: 800,
                height: 600,
                showCloseButton: true,
                dragEnabled: true,
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='grid-existing-pick'>").appendTo(contentElement);
                    gridExisting = gridContainer.dxDataGrid({
                        dataSource: resourcesStore,
                        showBorders: true,
                        height: 430,
                        scrolling: { mode: "virtual" },
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        searchPanel: { visible: true, placeholder: "Search for Learn or Exam..." },
                        columns: [
                            { dataField: "name", caption: "Resource Name" },
                            {
                                dataField: "typeId", caption: "Type", width: 120, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const text = options.value === 1 ? "Learn" : "Exam";
                                    $("<span>").addClass("badge bg-light text-dark border px-3 py-1 rounded-pill fw-normal").text(text).appendTo(container);
                                }
                            }
                        ]
                    }).dxDataGrid("instance");

                    const btnContainer = $("<div class='text-end mt-3'>").appendTo(contentElement);
                    $("<div id='btn-confirm-existing'>").appendTo(btnContainer).dxButton({
                        text: "Add Selected to List", type: "default", stylingMode: "contained", icon: "plus",
                        elementAttr: { class: "rounded-3" },
                        onClick: function() {
                            const selectedData = gridExisting.getSelectedRowsData();
                            selectedData.forEach(item => {
                                if(!unifiedResources.some(r => !r.isNew && r.realId === item.id)) {
                                    unifiedResources.push({
                                        uid: `EXISTING_${item.id}`,
                                        realId: item.id,
                                        name: item.name,
                                        typeId: item.typeId,
                                        isNew: false
                                    });
                                }
                            });
                            refreshMasterGrid();
                            gridExisting.clearSelection();
                            popupExisting.hide();
                        }
                    });
                }
            }).dxPopup("instance");

            $("#btn-show-existing").click(() => popupExisting.show());

            // --- 4. อัปโหลดไฟล์ใหม่ ---
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false,
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                onValueChanged: function(e) {
                    if(e.value && e.value.length > 0) {
                        e.value.forEach((file, index) => {
                            unifiedResources.push({
                                uid: `NEW_${Date.now()}_${index}`,
                                name: file.name,
                                isNew: true,
                                fileRef: file
                            });
                        });
                        e.component.reset();
                        refreshMasterGrid();
                        DevExpress.ui.notify("File added to queue", "success", 2000);
                    }
                }
            });

            // --- 5. Submit Data ---
            $("#btn-save").dxButton({
                text: IS_EDIT ? "Save Changes" : "Create Course",
                icon: "save",
                type: "default",
                stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 btn-primary rounded-3" }, // ใช้ rounded-3 คุมปุ่ม
                onClick: () => submitData()
            });

                   async function submitData() {
            // 1. ตรวจสอบความถูกต้องของ Form และ Resource
            if (!formWidget.validate().isValid) {
                DevExpress.ui.notify("Please fill in all required course details.", "warning", 2000);
                return;
            }

            if (unifiedResources.length === 0) {
                    DevExpress.ui.notify("Please add at least one resource.", "error", 4000);
                return;
            }

            loadPanel.option("message", "Saving course details...");
            loadPanel.show();

            try {
                const data = formWidget.option("formData");

                // กรองเอาเฉพาะ Resource เดิมที่มีอยู่แล้ว (ตัดไฟล์ใหม่ออกก่อนเพื่อกัน Error 500)
                const safeResourceIds = unifiedResources
                    .filter(r => !r.isNew)
                    .map(r => r.realId);

                // 2. เตรียมข้อมูล Course Payload (JSON)
                const coursePayload = {
                    courseCode: data.courseCode,
                    courseName: data.courseName,
                    description: data.description,
                    courseType: data.courseType,
                    categoryId: data.categoryId,
                    resourceIds: safeResourceIds
                };

                let courseId = COURSE_ID;

                // 3. บันทึกข้อมูลหลักสูตร (Create / Update)
                if (IS_EDIT) {
                    await $.ajax({
                        url: `${serviceUrl}/courses/${courseId}`,
                        method: "PUT",
                        contentType: "application/json",
                        data: JSON.stringify(coursePayload),
                        xhrFields: { withCredentials: true }
                    });
                } else {
                    const res = await $.ajax({
                        url: `${serviceUrl}/courses/Create`,
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(coursePayload),
                        xhrFields: { withCredentials: true }
                    });
                    courseId = res.data.id;
                }

                // 4. ค้นหา Version ปัจจุบันของ Course
                loadPanel.option("message", "Preparing resources...");
                const versionsRes = await $.ajax({
                    url: `${serviceUrl}/courses/${courseId}/versions`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });

                let activeVersionId = null;
                if (versionsRes.data && versionsRes.data.length > 0) {
                    // เลือก Version ที่เปิดใช้งานอยู่ (Active) หรือเอาอันแรกล่าสุด
                    const activeVersion = versionsRes.data.find(v => v.isActive) || versionsRes.data[0];
                    activeVersionId = activeVersion.id;
                }

                // 5. เตรียมข้อมูล Version และไฟล์แนบ (FormData) สำหรับอัปโหลด
                loadPanel.option("message", "Uploading files and processing SCORM...");
                let formDataObj = new FormData();
                formDataObj.append("Note", IS_EDIT ? "Updated resources via Form" : "Initial Content Upload");
                formDataObj.append("IsActive", true);

                // ใส่ข้อมูล Resources ทั้งหมด (ทั้งเก่าและใหม่)
                unifiedResources.forEach((item) => {
                    if (item.isNew) {
                        formDataObj.append("Files", item.fileRef);
                        formDataObj.append("ResourceIds", 0); // 0 คือสัญญาณบอก Backend ว่ามีไฟล์ใหม่
                    } else {
                        formDataObj.append("ResourceIds", item.realId);
                    }
                });

                // 6. อัปเดตข้อมูลไฟล์ไปยัง Version API
                if (activeVersionId) {
                    await $.ajax({
                        url: `${serviceUrl}/courses/versions/${activeVersionId}`,
                        method: "PUT",
                        data: formDataObj,
                        processData: false,
                        contentType: false,
                        xhrFields: { withCredentials: true }
                    });
                } else {
                    // สำรองเผื่อบั๊กไม่มี Version เลย ให้สร้าง Version ใหม่
                    await $.ajax({
                        url: `${serviceUrl}/courses/${courseId}/versions`,
                        method: "POST",
                        data: formDataObj,
                        processData: false,
                        contentType: false,
                        xhrFields: { withCredentials: true }
                    });
                }

                DevExpress.ui.notify("Course and content saved successfully!", "success", 2000);
                setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);

            } catch (err) {
                console.error(err);
                DevExpress.ui.notify("Error: " + (err.responseJSON?.message || err.statusText), "error", 4000);
            } finally {
                loadPanel.hide();
            }
        }
        });
    </script>
}