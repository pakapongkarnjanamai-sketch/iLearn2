@{
    ViewBag.Title = (ViewBag.Id == null ? "New Course" : "Edit Course");
    var isEdit = ViewBag.Id != null;
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">@ViewBag.Title</div>
        <div class="text-secondary" style="font-size:12px;">
            @(isEdit ? "Update course details and manage resources." : "Create a new training course for employees.")
        </div>
    </div>
    <a href="javascript:history.back();" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

<div class="container px-4 py-4" style="max-width:960px; margin-bottom:70px;">
    <div id="load-panel"></div>

    <!-- Course Information -->
    <div class="border rounded bg-white p-3 mb-3">
        <div class="section-title">Course Information</div>
        <div id="form-container"></div>
    </div>

    <!-- Course Content List -->
    <div class="border rounded bg-white p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="section-title mb-0" style="border:none; padding:0;">Course Content List</div>
            <span class="tag-pill pill-default" id="total-count-badge">0 Items</span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing">
                    <i class="fas fa-search fa-lg mb-3" style="color:var(--accent-color);"></i>
                    <div class="fw-bold text-dark mb-1" style="font-size:13px;">Select Existing Resources</div>
                    <div class="text-secondary" style="font-size:11px;">Choose files from the central library.</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload">
                    <i class="fas fa-cloud-upload-alt fa-lg mb-3" style="color:var(--accent-color);"></i>
                    <div class="fw-bold text-dark mb-1" style="font-size:13px;">Upload New SCORM</div>
                    <div class="text-secondary" style="font-size:11px;">Drag &amp; drop or click to browse .zip</div>
                </div>
                <div id="file-uploader-container"></div>
            </div>
        </div>

        <div style="font-size:11px; color:var(--text-secondary); margin-bottom:12px;">
            <i class="fas fa-info-circle" style="color:var(--accent-color);"></i>
            You can drag &amp; drop rows to reorder the content, and click on Type to change it for new files.
        </div>

        <div class="border rounded overflow-hidden">
            <div id="master-resources-grid"></div>
        </div>
    </div>
</div>

<!-- ── Fixed Bottom Toolbar ── -->
<div class="bottom-toolbar">
    <span class="me-auto text-secondary d-none d-md-inline" style="font-size:11px;">
        <i class="fas fa-check-circle" style="color:var(--success-color);"></i>
        Please verify all information and content order before saving.
    </span>
    <a href="javascript:history.back();" class="action-link">Cancel</a>
    <div id="btn-save"></div>
</div>

<div id="popup-existing"></div>

@section Scripts {
    <script>
        const COURSE_ID = @(ViewBag.Id ?? "null");
        const IS_EDIT = COURSE_ID != null;

        // Initialize DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        let formWidget;
        let masterGrid;
        let gridExisting;
        let unifiedResources = [];

        $(async () => {
            let formData = { courseType: 1, isActive: true };

            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            // --- Load Data (Edit Mode) ---
            if (IS_EDIT) {
                try {
                    loadPanel.show();
                    const courseData = await $.ajax({
                        url: `${serviceUrl}/courses/${COURSE_ID}`,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    formData = { ...courseData };

                    let existing = courseData.resources || [];
                    if (existing.length > 0) {
                        existing.forEach(r => {
                            unifiedResources.push({
                                uid: `EXISTING_${r.id}`,
                                realId: r.id,
                                name: r.name,
                                typeId: r.typeId,
                                isNew: false
                            });
                        });
                        refreshMasterGrid();
                    }

                    if (formData.categoryId && !formData.divisionId) {
                        try {
                            const catData = await $.ajax({
                                url: `${serviceUrl}/admin/CategoriesCRUD/Get/${formData.categoryId}`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            });
                            formData.divisionId = catData.divisionId;
                        } catch (e) { }
                    }
                } catch (err) {
                    console.error(err);
                    DevExpress.ui.notify("Error loading course data", "error", 3000);
                } finally {
                    loadPanel.hide();
                }
            }

            // --- 1. Form Widget Config ---
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        itemType: "group",
                        items: [
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                },
                                validationRules: [{ type: "required", message: "Course Type is required" }]
                            },
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseName",
                                label: { text: "Course Title" },
                                validationRules: [{ type: "required", message: "Course Name is required" }],
                                editorOptions: { placeholder: "e.g. Intro to Cybersecurity" }
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: function(e) {
                                        const catEditor = formWidget.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();

                                        if (e.event) {
                                            catEditor.option("value", null);
                                        }

                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    disabled: !formData.divisionId,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        items: [
                            {
                                dataField: "description",
                                label: { text: "Description" },
                                editorType: "dxTextArea",
                                editorOptions: {
                                    height: 120,
                                    placeholder: "Course summary and objectives..."
                                }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- 2. Master Grid (แก้ไขให้แก้ไข Type ได้สำหรับไฟล์ใหม่) ---
            masterGrid = $("#master-resources-grid").dxDataGrid({
                dataSource: unifiedResources,
                keyExpr: "uid",
                showBorders: false,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: "No content added yet. Click buttons above to add.",
                editing: {
                    mode: "cell", // เปิดโหมดแก้ไขแบบคลิกที่เซลล์
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    // อนุญาตให้แก้ได้เฉพาะคอลัมน์ Type และต้องเป็นไฟล์ใหม่ (isNew) เท่านั้น
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = unifiedResources.findIndex(item => item.uid === visibleRows[e.toIndex].data.uid);
                        const fromIndex = unifiedResources.findIndex(item => item.uid === e.itemData.uid);

                        unifiedResources.splice(fromIndex, 1);
                        unifiedResources.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted fw-bold").text(options.rowIndex + 1).appendTo(container);
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const isNew = data.isNew;
                            const iconClass = isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            // แสดงป้าย New สำหรับไฟล์ใหม่
                            if(isNew) {
                                wrapper.append($('<span>').addClass('tag-pill pill-info ms-2').css('font-size', '0.7rem').text('New'));
                            }
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Type (Click to edit)", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const tName = data.typeId === 1 ? "Learn" : (data.typeId === 2 ? "Exam" : "Unknown");
                            const typeCls = data.typeId === 1 ? "pill-learn" : "pill-exam";

                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const cursorStyle = data.isNew ? "cursor: pointer;" : "cursor: default;";
                            const tooltip = data.isNew ? "Click to change type" : "Existing resource type cannot be changed here";

                            $('<div>').addClass(`tag-pill ${typeCls}`)
                                .attr("style", cursorStyle)
                                .attr("title", tooltip)
                                .html(`${tName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                unifiedResources = unifiedResources.filter(r => r.uid !== e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            }).dxDataGrid("instance");

            function refreshMasterGrid() {
                masterGrid.option("dataSource", unifiedResources);
                $("#total-count-badge").text(`${unifiedResources.length} Items`);
            }

            // --- 3. Popup สำหรับเลือกไฟล์เก่า ---
            const popupExisting = $("#popup-existing").dxPopup({
                title: "Select Existing Resources",
                width: "90vw", maxWidth: 1100, height: "85vh",
                showCloseButton: true, dragEnabled: true,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='grid-existing-pick' style='height:100%;'>").appendTo(contentElement);
                    gridExisting = gridContainer.dxDataGrid({
                        dataSource: resourcesStore,
                        remoteOperations: true,
                        showBorders: false, showRowLines: true, rowAlternationEnabled: true,
                        hoverStateEnabled: true,
                        height: "100%",
                        scrolling: { mode: "virtual" },
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        searchPanel: { visible: true, placeholder: "Search by name or type...", width: 280 },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Resource Name", minWidth: 200,
                                cellTemplate: function(container, options) {
                                    $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                                }
                            },
                            {
                                dataField: "typeId", caption: "Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearn = options.value === 1;
                                    const text = isLearn ? "Learn" : "Exam";
                                    $('<span>').addClass(`tag-pill ${isLearn ? 'pill-learn' : 'pill-exam'}`).text(text).appendTo(container);
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(d) { return (d.courseResources || []).length; },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    $('<span>')
                                        .addClass(`tag-pill ${count > 0 ? 'pill-success' : 'pill-default'}`)
                                        .html(`<i class="fas fa-book me-1"></i>${count}`)
                                        .appendTo(container);
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                cellTemplate: function(container, options) {
                                    if (!options.value) return;
                                    const d = new Date(options.value);
                                    const formatted = d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" })
                                        + " " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
                                    $("<span>").addClass("text-muted small").text(formatted).appendTo(container);
                                }
                            }
                        ]
                    }).dxDataGrid("instance");
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                const selectedData = gridExisting.getSelectedRowsData();
                                selectedData.forEach(item => {
                                    if(!unifiedResources.some(r => !r.isNew && r.realId === item.id)) {
                                        unifiedResources.push({
                                            uid: `EXISTING_${item.id}`,
                                            realId: item.id,
                                            name: item.name,
                                            typeId: item.typeId,
                                            isNew: false
                                        });
                                    }
                                });
                                refreshMasterGrid();
                                gridExisting.clearSelection();
                                popupExisting.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").click(() => popupExisting.show());

            // --- 4. อัปโหลดไฟล์ใหม่ (กำหนด Type เริ่มต้นให้เป็น Learn) ---
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload", dropZone: "#btn-trigger-upload",
                visible: false, accept: ".zip", uploadMode: "useForm", multiple: true,
                onValueChanged: function(e) {
                    if(e.value && e.value.length > 0) {
                        e.value.forEach((file, index) => {
                            unifiedResources.push({
                                uid: `NEW_${Date.now()}_${index}`,
                                name: file.name,
                                isNew: true,
                                typeId: 1, // Default ให้เป็น Learn ก่อน (ผู้ใช้คลิกแก้ได้ในตาราง)
                                fileRef: file
                            });
                        });
                        e.component.reset();
                        refreshMasterGrid();
                        DevExpress.ui.notify("File added to queue", "success", 2000);
                    }
                }
            });

            // --- 5. Submit Data ---
            $("#btn-save").dxButton({
                text: IS_EDIT ? "Save Changes" : "Create Course",
                icon: "save", type: "default", stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 py-1 btn-primary rounded-3 fw-medium" },
                onClick: () => submitData()
            });

            async function submitData() {
                if (!formWidget.validate().isValid) { DevExpress.ui.notify("Please fill in all required course details.", "warning", 2000); return; }
                if (unifiedResources.length === 0) { DevExpress.ui.notify("Please add at least one resource.", "error", 4000); return; }

                loadPanel.option("message", "Saving course details...");
                loadPanel.show();

                try {
                    const data = formWidget.option("formData");
                    const safeResourceIds = unifiedResources.filter(r => !r.isNew).map(r => r.realId);

                    const coursePayload = {
                        courseCode: data.courseCode, courseName: data.courseName,
                        description: data.description, courseType: data.courseType,
                        categoryId: data.categoryId, resourceIds: safeResourceIds
                    };

                    let courseId = COURSE_ID;

                    if (IS_EDIT) {
                        await $.ajax({
                            url: `${serviceUrl}/courses/${courseId}`,
                            method: "PUT", contentType: "application/json",
                            data: JSON.stringify(coursePayload), xhrFields: { withCredentials: true }
                        });
                    } else {
                        const res = await $.ajax({
                            url: `${serviceUrl}/courses/Create`,
                            method: "POST", contentType: "application/json",
                            data: JSON.stringify(coursePayload), xhrFields: { withCredentials: true }
                        });
                        courseId = res.data.id;
                    }

                    loadPanel.option("message", "Preparing resources...");
                    const versionsRes = await $.ajax({
                        url: `${serviceUrl}/courses/${courseId}/versions`,
                        method: "GET", xhrFields: { withCredentials: true }
                    });

                    let activeVersionId = null;
                    if (versionsRes.data && versionsRes.data.length > 0) {
                        const activeVersion = versionsRes.data.find(v => v.isActive) || versionsRes.data[0];
                        activeVersionId = activeVersion.id;
                    }

                    loadPanel.option("message", "Uploading files and processing SCORM...");
                    let formDataObj = new FormData();
                    formDataObj.append("Note", IS_EDIT ? "Updated resources via Form" : "Initial Content Upload");
                    formDataObj.append("IsActive", true);

                    unifiedResources.forEach((item) => {
                        if (item.isNew) {
                            formDataObj.append("Files", item.fileRef);
                            formDataObj.append("ResourceIds", 0);
                        } else {
                            formDataObj.append("ResourceIds", item.realId);
                        }

                        // ส่ง ResourceTypes กลับไปให้ Backend
                        formDataObj.append("ResourceTypes", item.typeId);
                    });

                    if (activeVersionId) {
                        await $.ajax({
                            url: `${serviceUrl}/courses/versions/${activeVersionId}`,
                            method: "PUT", data: formDataObj,
                            processData: false, contentType: false, xhrFields: { withCredentials: true }
                        });
                    } else {
                        await $.ajax({
                            url: `${serviceUrl}/courses/${courseId}/versions`,
                            method: "POST", data: formDataObj,
                            processData: false, contentType: false, xhrFields: { withCredentials: true }
                        });
                    }

                    DevExpress.ui.notify("Course and content saved successfully!", "success", 2000);
                    setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);

                } catch (err) {
                    console.error(err);
                    DevExpress.ui.notify("Error: " + (err.responseJSON?.message || err.statusText), "error", 4000);
                } finally {
                    loadPanel.hide();
                }
            }
        });
    </script>
}