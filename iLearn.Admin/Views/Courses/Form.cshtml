@{
    ViewBag.Title = (ViewBag.Id == null ? "สร้างหลักสูตรใหม่ (New Course)" : "แก้ไขหลักสูตร (Edit Course)");
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
            <h5 class="mb-0">
                <i class="fas @(ViewBag.Id == null ? "fa-plus-circle" : "fa-edit") me-2"></i>@ViewBag.Title
            </h5>
            <button class="btn btn-sm btn-light text-primary" onclick="history.back()">
                <i class="fas fa-arrow-left me-1"></i> ย้อนกลับ
            </button>
        </div>

        <div class="card-body">
            <div id="load-panel"></div>

            <div id="form-container"></div>

            <div id="resources-section" class="mt-4">
                <div class="d-flex align-items-center border-bottom pb-2 mb-3 justify-content-between">
                    <h6 class="fw-bold text-secondary m-0">
                        <i class="fas fa-folder-open me-2"></i>ไฟล์ประกอบหลักสูตร (Resources)
                    </h6>
                    <span class="badge bg-primary rounded-pill" id="resource-count-badge">0 ไฟล์</span>
                </div>

                <div id="file-uploader-container" class="mb-3"></div>

                <div id="grid-resources"></div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <div id="btn-cancel"></div>
                @if (ViewBag.Id == null)
                {
                    <div id="btn-publish"></div>
                }
                <div id="btn-save"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const COURSE_ID = @(ViewBag.Id ?? "null");
        const IS_EDIT = COURSE_ID != null;

        // Data Stores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        let formWidget;

        // ตัวแปรจัดการไฟล์
        let newFiles = [];        // ไฟล์ใหม่ที่รออัปโหลด (File Object)
        let existingFiles = [];   // ไฟล์เดิมจาก DB (Data Object)
        let allResources = [];    // ข้อมูลรวมสำหรับแสดงใน Grid

        $(async () => {
            let formData = { courseType: 1, isActive: false };

            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(0,0,0,0.4)",
                position: { of: "#form-container" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true
            }).dxLoadPanel("instance");

            // --- 1. Load Data (Edit Mode) ---
            if (IS_EDIT) {
                try {
                    loadPanel.show();
                    const courseData = await $.ajax({
                        url: `${serviceUrl}/courses/${COURSE_ID}`,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    formData = { ...courseData };

                    // เก็บไฟล์เดิม
                    existingFiles = courseData.resources || [];

                    // โหลด Cascading Data
                    if (formData.categoryId) {
                        try {
                            const catData = await $.ajax({
                                url: `${serviceUrl}/admin/CategoriesCRUD/Get/${formData.categoryId}`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            });
                            formData.divisionId = catData.divisionId;
                        } catch (e) { }
                    }
                    loadPanel.hide();

                } catch (err) {
                    loadPanel.hide();
                    console.error(err);
                    DevExpress.ui.notify("ไม่พบข้อมูลหลักสูตร", "error", 3000);
                }
            }

            // อัปเดตข้อมูลตารางครั้งแรก
            updateResourceGrid();

            // --- 2. Form Widget ---
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 2,
                labelMode: "floating",
                items: [
                    {
                        itemType: "group",
                        caption: "ข้อมูลหลักสูตร",
                        items: [
                            { dataField: "courseCode", label: { text: "รหัสวิชา" }, validationRules: [{ type: "required" }] },
                            {
                                dataField: "courseType",
                                label: { text: "ประเภท" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: courseTypes, displayExpr: "name", valueExpr: "id" },
                                validationRules: [{ type: "required" }]
                            },
                            {
                                dataField: "courseName",
                                label: { text: "ชื่อหลักสูตร" },
                                colSpan: 2,
                                validationRules: [{ type: "required" }]
                            },
                            {
                                dataField: "divisionId",
                                label: { text: "ส่วนงาน" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    onValueChanged: function(e) {
                                        const catEditor = formWidget.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();
                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "หมวดหมู่" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    disabled: !formData.divisionId
                                },
                                validationRules: [{ type: "required" }]
                            },
                            {
                                dataField: "description",
                                label: { text: "คำอธิบาย" },
                                colSpan: 2,
                                editorType: "dxTextArea",
                                editorOptions: { height: 80 }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- 3. File Uploader (ออกแบบใหม่) ---
            $("#file-uploader-container").dxFileUploader({
                selectButtonText: "เลือกไฟล์ SCORM (.zip)",
                labelText: "หรือลากไฟล์มาวางที่นี่",
                accept: ".zip",
                uploadMode: "useForm", // ใช้ Form Submit ไม่ Upload ทันที
                multiple: true,
                showFileList: false, // [สำคัญ] ซ่อน List ของ Uploader เพราะเราจะโชว์ใน Grid แทน
                onValueChanged: function(e) {
                    // เมื่อมีการเลือกไฟล์ เพิ่มเข้าไปใน Array newFiles
                    if(e.value && e.value.length > 0) {
                        const files = e.value;
                        // เพิ่มไฟล์ใหม่ต่อท้าย (ป้องกันการทับ)
                        newFiles = [...newFiles, ...files];

                        // เคลียร์ค่าใน Uploader เพื่อให้เลือกไฟล์เดิมซ้ำได้ถ้าต้องการ (หรือเลือกเพิ่ม)
                        e.component.reset();

                        // รีเฟรชตาราง
                        updateResourceGrid();
                    }
                }
            });

            // --- 4. ฟังก์ชันรวมข้อมูลและแสดง Grid ---
            function updateResourceGrid() {
                // แปลง File Object เป็น Format เดียวกับ ExistingResource เพื่อแสดงผล
                const newFilesData = newFiles.map((file, index) => ({
                    id: `NEW_${index}`, // ID ชั่วคราว
                    name: file.name,
                    size: file.size,
                    typeName: "Learn",
                    isNew: true, // Flag บอกว่าเป็นไฟล์ใหม่
                    fileRef: file // เก็บ Reference ไฟล์จริงไว้สำหรับลบ
                }));

                // รวมข้อมูล (Existing + New)
                allResources = [...existingFiles, ...newFilesData];

                // อัปเดต Badge
                $("#resource-count-badge").text(`${allResources.length} ไฟล์`);

                // Render Grid
                renderGrid(allResources);
            }

            function renderGrid(dataSource) {
                $("#grid-resources").dxDataGrid({
                    dataSource: dataSource,
                    showBorders: true,
                    columnAutoWidth: true,
                    hoverStateEnabled: true,
                    rowAlternationEnabled: true,
                    noDataText: "ยังไม่มีไฟล์แนบ (เลือกไฟล์เพื่อเพิ่ม)",
                    columns: [
                        {
                            caption: "#",
                            width: 50,
                            alignment: "center",
                            cellTemplate: function(container, options) {
                                container.text(options.rowIndex + 1);
                            }
                        },
                        {
                            dataField: "name",
                            caption: "ชื่อไฟล์ (File Name)",
                            cellTemplate: function(container, options) {
                                const isNew = options.data.isNew;
                                const iconClass = isNew ? "fa-file-upload text-success" : "fa-file-archive text-warning";
                                const statusText = isNew ? " <span class='badge bg-success ms-1'>New</span>" : "";

                                $("<span>")
                                    .html(`<i class="fas ${iconClass} me-2"></i>${options.value}${statusText}`)
                                    .appendTo(container);
                            }
                        },
                        {
                            caption: "สถานะ",
                            width: 120,
                            alignment: "center",
                            cellTemplate: function(container, options) {
                                if (options.data.isNew) {
                                    $("<span>").addClass("text-success fw-bold").text("รอการบันทึก").appendTo(container);
                                } else {
                                    $("<span>").addClass("text-secondary").text("บันทึกแล้ว").appendTo(container);
                                }
                            }
                        },
                        {
                            caption: "จัดการ",
                            width: 100,
                            alignment: "center",
                            cellTemplate: function(container, options) {
                                const data = options.data;

                                // ปุ่มลบ
                                $("<button>")
                                    .addClass("btn btn-sm btn-outline-danger")
                                    .html('<i class="fas fa-trash-alt"></i>')
                                    .attr("title", "ลบไฟล์")
                                    .on("click", function() {
                                        if (data.isNew) {
                                            // กรณีไฟล์ใหม่: ลบออกจาก Array newFiles
                                            newFiles = newFiles.filter(f => f !== data.fileRef);
                                            updateResourceGrid(); // รีเฟรชตาราง
                                        } else {
                                            // กรณีไฟล์เก่า: เรียก API ลบ
                                            confirmDeleteResource(data.id, data.name);
                                        }
                                    })
                                    .appendTo(container);
                            }
                        }
                    ]
                });
            }

            // --- 5. Logic การลบ (Server Side) ---
            function confirmDeleteResource(id, name) {
                DevExpress.ui.dialog.confirm(`ต้องการลบไฟล์ <b>"${name}"</b> จากระบบใช่หรือไม่?`, "ยืนยันการลบ")
                    .done(function (dialogResult) {
                        if (dialogResult) {
                            deleteResource(id);
                        }
                    });
            }

            async function deleteResource(id) {
                try {
                    loadPanel.show();
                    await $.ajax({
                        url: `${serviceUrl}/courses/resource/${id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    DevExpress.ui.notify("ลบไฟล์สำเร็จ", "success", 2000);

                    // อัปเดต existingFiles
                    existingFiles = existingFiles.filter(f => f.id !== id);
                    updateResourceGrid();

                    loadPanel.hide();

                } catch (err) {
                    loadPanel.hide();
                    console.error(err);
                    DevExpress.ui.notify("เกิดข้อผิดพลาดในการลบไฟล์", "error", 3000);
                }
            }

            // --- 6. ปุ่มบันทึก (Save) ---
            $("#btn-cancel").dxButton({
                text: "ยกเลิก",
                icon: "close",
                onClick: () => window.location.href = '@Url.Action("Index", "Courses")'
            });

            $("#btn-save").dxButton({
                text: IS_EDIT ? "บันทึกการแก้ไข" : "บันทึก",
                icon: "save",
                type: "default",
                onClick: () => submitData()
            });

            function submitData() {
                if (!formWidget.validate().isValid) {
                    DevExpress.ui.notify("กรุณากรอกข้อมูลให้ครบถ้วน", "warning", 2000);
                    return;
                }

                // Check Validation: ถ้าสร้างใหม่ ต้องมีไฟล์ (รวมไฟล์เดิม + ไฟล์ใหม่)
                if (!IS_EDIT && newFiles.length === 0) {
                     DevExpress.ui.notify("กรุณาอัปโหลดไฟล์บทเรียนอย่างน้อย 1 ไฟล์", "error", 3000);
                     return;
                }

                loadPanel.show();

                const data = formWidget.option("formData");
                let formDataObj = new FormData();

                // Append Form Data
                for (let key in data) {
                    if (data[key] !== null && data[key] !== undefined && key !== 'resources') {
                        formDataObj.append(key, data[key]);
                    }
                }

                // Append Files (เฉพาะไฟล์ใหม่ที่อยู่ใน Array)
                if (newFiles.length > 0) {
                    newFiles.forEach(file => {
                        formDataObj.append("Files", file);
                    });
                }

                const url = IS_EDIT
                    ? `${serviceUrl}/courses/update-scorm/${COURSE_ID}`
                    : `${serviceUrl}/courses/create-scorm`;

                $.ajax({
                    url: url,
                    method: "POST",
                    data: formDataObj,
                    processData: false,
                    contentType: false,
                    xhrFields: { withCredentials: true },
                    success: function(res) {
                        loadPanel.hide();
                        DevExpress.ui.notify("บันทึกสำเร็จ", "success", 2000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);
                    },
                    error: function(err) {
                        loadPanel.hide();
                        DevExpress.ui.notify("เกิดข้อผิดพลาด: " + (err.responseJSON?.message || err.statusText), "error", 4000);
                    }
                });
            }
        });
    </script>
}