@{
    ViewBag.Title = (ViewBag.Id == null ? "New Course" : "Edit Course");
    var isEdit = ViewBag.Id != null;
}

<style>
    /* ── Height Settings ── */
    .course-page-shell {
        --course-page-min-height-offset: 120px;
        --course-page-bottom-padding: 64px;
        --course-page-bottom-padding-tablet: 128px;
        --course-page-bottom-padding-mobile: 156px;
        --course-review-table-min-height: 220px;
        --course-review-table-viewport-offset: 520px;
        --course-review-table-max-height: 360px;
        --admin-review-content-max-width: 1120px;

        min-height: calc(100vh - var(--course-page-min-height-offset));
        padding-top: 16px !important;
        padding-bottom: var(--course-page-bottom-padding) !important;
    }

    .course-wizard-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .course-step-card {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--surface-base);
        padding: var(--space-md) var(--space-lg);
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .course-step-card.active {
        border-color: var(--primary-color);
        background: var(--surface-info-subtle);
    }

    .course-step-card.complete {
        border-color: var(--border-success);
        background: var(--surface-success-subtle);
    }

    .course-step-index {
        width: var(--space-2xl);
        height: var(--space-2xl);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-pill);
        border: 1px solid currentColor;
        font-size: 11px;
        font-weight: 700;
        margin-right: var(--space-xs);
    }

    .course-step-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .course-step-text {
        font-size: 11px;
        color: var(--text-secondary);
        margin-top: 2px;
    }

    .course-panel {
        display: none;
    }

    .course-panel.active {
        display: block;
    }

    .course-sidebar-card,
    .course-section-card,
    .course-summary-card,
    .course-detail-card,
    .course-table-shell,
    .course-grid-shell {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--surface-base);
    }

    .course-sidebar-card,
    .course-section-card,
    .course-detail-card {
        padding: 12px;
    }

    .course-meta-item {
        padding: 8px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .course-meta-item:last-child {
        border-bottom: none;
    }

    .course-meta-label {
        font-size: 11px;
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 3px;
    }

    .course-meta-value {
        font-size: 13px;
        color: var(--text-primary);
        word-break: break-word;
    }

    .course-grid-head,
    .course-table-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: var(--space-sm) var(--space-md);
        border-bottom: 1px solid var(--border-color);
        background: var(--surface-subtle);
    }

    .course-grid-title,
    .course-table-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-primary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .course-grid-note,
    .course-inline-note,
    .course-content-preview {
        font-size: 12px;
        color: var(--text-secondary);
    }

    .course-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .course-summary-card {
        padding: var(--space-sm);
        background: var(--surface-subtle);
    }

    .course-summary-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.1;
    }

    .course-summary-label {
        font-size: 11px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 6px;
    }

    .course-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .course-detail-item {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--surface-subtle);
        padding: var(--space-sm);
    }

    .course-detail-label {
        font-size: 11px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .course-detail-value {
        font-size: 13px;
        color: var(--text-primary);
        white-space: pre-wrap;
        word-break: break-word;
    }

    .course-table-shell {
        overflow: hidden;
    }

    .course-table-wrap {
        overflow: auto;
        max-height: clamp(
            var(--course-review-table-min-height),
            calc(100vh - var(--course-review-table-viewport-offset)),
            var(--course-review-table-max-height)
        );
    }

    .course-table {
        width: 100%;
        border-collapse: collapse;
        min-width: min(760px, 100%);
    }

    .course-table th,
    .course-table td {
        padding: 8px 14px;
        border-bottom: 1px solid var(--border-color);
        font-size: 12px;
        vertical-align: top;
    }

    .course-table thead th {
        font-size: 11px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        background: var(--surface-subtle);
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .course-empty-state {
        padding: 32px 16px;
        text-align: center;
        color: var(--text-secondary);
    }

    .course-empty-state i {
        font-size: 28px;
        color: var(--state-empty-icon);
        margin-bottom: 10px;
        display: block;
    }

    .course-resource-name {
        font-weight: 600;
        color: var(--text-primary);
    }

    .course-resource-note {
        font-size: 11px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    @@media (max-width: 991.98px) {
        .course-page-shell {
            min-height: auto;
            padding-bottom: var(--course-page-bottom-padding-tablet) !important;
        }

        .course-wizard-steps,
        .course-summary-grid,
        .course-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .course-page-shell {
            padding-bottom: var(--course-page-bottom-padding-mobile) !important;
        }

        .course-table th,
        .course-table td {
            padding: 8px 10px;
        }
    }
</style>

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
    <div>
        <div class="page-title"><i class="fas fa-book text-primary me-2"></i>@ViewBag.Title</div>
        <div class="page-subtitle">@(isEdit ? "Update course information and content." : "Create a course, prepare learning content, and review everything before publishing.")</div>
    </div>
    <a href="@Url.Action("Index", "Courses")" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

