@{
    ViewBag.Title = (ViewBag.Id == null ? "Create New Course" : "Edit Course");
    var isEdit = ViewBag.Id != null;
}

<div class="page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="fas @(isEdit ? "fa-edit" : "fa-plus")"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        @(isEdit ? "Update course details and manage resources." : "Create a new training course for employees.")
                    </div>
                </div>
            </h1>
            <div>
                <button id="btn-cancel-top" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div id="load-panel"></div>

    <div class="row">
        <div class="col-lg-7">
            <div class="form-card">
                <div class="form-section-header">
                    <h5 class="section-title">
                        <div class="section-icon"><i class="fas fa-info"></i></div>
                        Course Information
                    </h5>
                </div>
                <div class="form-body">
                    <div id="form-container"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="form-card h-100">
                <div class="form-section-header">
                    <h5 class="section-title">
                        <div class="section-icon"><i class="fas fa-folder-open"></i></div>
                        Course Resources
                    </h5>
                    <span class="badge-count" id="resource-count-badge">0 Files</span>
                </div>

                <div class="form-body bg-light">
                    <div class="upload-zone mb-4">
                        <i class="fas fa-cloud-upload-alt upload-icon"></i>
                        <h6 class="fw-bold mb-2">Upload SCORM Package</h6>
                        <p class="text-muted small mb-3">Drag & drop .zip files here or click to browse</p>
                        <div id="file-uploader-container"></div>
                    </div>

                    <h6 class="fw-bold text-muted mb-3"><i class="fas fa-list me-2"></i>Attached Files</h6>
                    <div class="custom-grid-container bg-white shadow-sm">
                        <div id="grid-resources"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="fixed-bottom bg-white shadow-lg py-3 border-top" style="z-index: 100;">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                <i class="fas fa-info-circle me-1"></i> Please verify all information before saving.
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light btn-action text-muted border" onclick="history.back()">Cancel</button>
                <div id="btn-save"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const COURSE_ID = @(ViewBag.Id ?? "null");
        const IS_EDIT = COURSE_ID != null;
  

        // Initialize DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based Assignment)' },
            { id: 1, name: 'General (Auto-assign / Self-enroll)' }
        ];

        let formWidget;
        let newFiles = [];
        let existingFiles = [];
        let allResources = [];

        $(async () => {
            // Initial Form Data
            let formData = { courseType: 1, isActive: true };

            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            // --- Load Data (Edit Mode) ---
            if (IS_EDIT) {
                try {
                    loadPanel.show();
                    const courseData = await $.ajax({
                        url: `${serviceUrl}/courses/${COURSE_ID}`,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    formData = { ...courseData };
                    existingFiles = courseData.resources || [];

                    // Fetch Division if only Category is present
                    if (formData.categoryId && !formData.divisionId) {
                        try {
                            const catData = await $.ajax({
                                url: `${serviceUrl}/admin/CategoriesCRUD/Get/${formData.categoryId}`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            });
                            formData.divisionId = catData.divisionId;
                        } catch (e) { }
                    }
                } catch (err) {
                    console.error(err);
                    DevExpress.ui.notify("Error loading course data", "error", 3000);
                } finally {
                    loadPanel.hide();
                }
            }

            updateResourceGrid();

            // --- Form Widget Config ---
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1, // Single column for cleaner look in left panel
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        itemType: "group",
                        caption: "Basic Details",
                        items: [
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseName",
                                label: { text: "Course Title" },
                                validationRules: [{ type: "required", message: "Course Name is required" }],
                                editorOptions: { placeholder: "e.g. Intro to Cybersecurity" }
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "Categorization",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: function(e) {
                                        const catEditor = formWidget.getEditor("categoryId");
                                        const catDS = catEditor.getDataSource();
                                        if (e.value) {
                                            catEditor.option("disabled", false);
                                            catDS.filter(["divisionId", "=", e.value]);
                                            catDS.load();
                                        } else {
                                            catEditor.option("disabled", true);
                                            catEditor.option("value", null);
                                        }
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    disabled: !formData.divisionId,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "Settings",
                        items: [
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypes,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                },
                                validationRules: [{ type: "required", message: "Course Type is required" }]
                            },
                            {
                                dataField: "description",
                                label: { text: "Description" },
                                editorType: "dxTextArea",
                                editorOptions: {
                                    height: 120,
                                    placeholder: "Course summary and objectives..."
                                }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- File Uploader ---
            $("#file-uploader-container").dxFileUploader({
                selectButtonText: "Browse Files",
                labelText: "",
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                showFileList: false, // We use custom grid
                elementAttr: { class: "text-center" },
                onValueChanged: function(e) {
                    if(e.value && e.value.length > 0) {
                        const filesCount = e.value.length;
                        newFiles = [...newFiles, ...e.value];
                        e.component.reset();
                        updateResourceGrid();
                        DevExpress.ui.notify({
                            message: `Added ${filesCount} file(s)`,
                            type: "success",
                            position: { my: "bottom center", at: "bottom center", offset: "0 -80" }
                        });
                    }
                }
            });

            // --- Helpers: Grid & Logic ---
            function updateResourceGrid() {
                const newFilesData = newFiles.map((file, index) => ({
                    id: `NEW_${index}`,
                    name: file.name,
                    size: file.size,
                    typeName: "SCORM",
                    isNew: true,
                    fileRef: file
                }));
                allResources = [...existingFiles, ...newFilesData];
                $("#resource-count-badge").text(`${allResources.length} Files`);
                renderGrid(allResources);
            }

            function renderGrid(dataSource) {
                $("#grid-resources").dxDataGrid({
                    dataSource: dataSource,
                    showBorders: false,
                    columnAutoWidth: true,
                    hoverStateEnabled: true,
                    rowAlternationEnabled: false,
                    showRowLines: true,
                    noDataText: "",
                    columns: [
                        {
                            dataField: "name",
                            caption: "File Name",
                            cellTemplate: function(container, options) {
                                const isNew = options.data.isNew;
                                const iconClass = isNew ? "fa-file-upload text-success" : "fa-file-archive text-primary";
                                const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");
                                $("<i>").addClass(`fas ${iconClass}`).appendTo(wrapper);
                                $("<span>").addClass("fw-medium text-truncate").css("max-width", "180px").attr("title", options.value).text(options.value).appendTo(wrapper);
                                wrapper.appendTo(container);
                            }
                        },
                        {
                            caption: "Action",
                            width: 60,
                            alignment: "center",
                            cellTemplate: function(container, options) {
                                const data = options.data;
                                $("<button>")
                                    .addClass("btn btn-link text-danger p-0")
                                    .html('<i class="fas fa-times"></i>')
                                    .attr("title", "Remove")
                                    .on("click", function() {
                                        if (data.isNew) {
                                            newFiles = newFiles.filter(f => f !== data.fileRef);
                                            updateResourceGrid();
                                        } else {
                                            confirmDeleteResource(data.id, data.name);
                                        }
                                    })
                                    .appendTo(container);
                            }
                        }
                    ],
                    onContentReady: function(e) {
                        if (e.component.totalCount() === 0) {
                            e.element.find(".dx-datagrid-nodata").html(`
                                <div class="text-center py-4 text-muted">
                                    <small>No files attached yet.</small>
                                </div>
                            `);
                        }
                    }
                });
            }

            function confirmDeleteResource(id, name) {
                DevExpress.ui.dialog.confirm(
                    `Delete file "<strong>${name}</strong>"?`,
                    "Confirm Delete"
                ).done(function (dialogResult) {
                    if (dialogResult) deleteResource(id);
                });
            }

            async function deleteResource(id) {
                try {
                    loadPanel.show();
                    await $.ajax({
                        url: `${serviceUrl}/courses/resource/${id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });
                    DevExpress.ui.notify("File deleted", "success", 2000);
                    existingFiles = existingFiles.filter(f => f.id !== id);
                    updateResourceGrid();
                } catch (err) {
                    console.error(err);
                    DevExpress.ui.notify("Failed to delete file", "error", 3000);
                } finally {
                    loadPanel.hide();
                }
            }

            // --- Buttons ---
            $("#btn-cancel-top").click(() => window.history.back());

            $("#btn-save").dxButton({
                text: IS_EDIT ? "Save Changes" : "Create Course",
                icon: "save",
                type: "default",
                stylingMode: "contained",
                elementAttr: { class: "btn-action shadow-sm" },
                onClick: () => submitData()
            });

            function submitData() {
                if (!formWidget.validate().isValid) {
                    DevExpress.ui.notify("Please fill in all required fields.", "warning", 2000);
                    return;
                }

                if (!IS_EDIT && newFiles.length === 0) {
                     DevExpress.ui.notify("Please upload at least one SCORM package.", "error", 3000);
                     return;
                }

                loadPanel.option("message", "Saving course...");
                loadPanel.show();

                const data = formWidget.option("formData");
                let formDataObj = new FormData();

                for (let key in data) {
                    if (data[key] !== null && data[key] !== undefined && key !== 'resources') {
                        formDataObj.append(key, data[key]);
                    }
                }

                if (newFiles.length > 0) {
                    newFiles.forEach(file => formDataObj.append("Files", file));
                }

                const url = IS_EDIT
                    ? `${serviceUrl}/courses/update-scorm/${COURSE_ID}`
                    : `${serviceUrl}/courses/create-scorm`;

                $.ajax({
                    url: url,
                    method: "POST",
                    data: formDataObj,
                    processData: false,
                    contentType: false,
                    xhrFields: { withCredentials: true },
                    success: function(res) {
                        DevExpress.ui.notify("Course saved successfully!", "success", 2000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Courses")', 1000);
                    },
                    error: function(err) {
                        DevExpress.ui.notify("Error: " + (err.responseJSON?.message || err.statusText), "error", 4000);
                    },
                    complete: () => loadPanel.hide()
                });
            }
        });
    </script>
}