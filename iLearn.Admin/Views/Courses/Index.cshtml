@{
    ViewBag.Title = "Course Management";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-book"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        <span>Manage all training courses and versions.</span>
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded shadow-sm px-3">
                    <i class="fas fa-plus me-2"></i> Create New Course
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="row">
        <div class="col-md-4 col-lg-3 mb-4 mb-md-0">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-sitemap me-2 text-primary"></i>Divisions & Categories</h6>
                </div>
                <div class="card-body p-2">
                    <div id="categoryTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div id="grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // DataStores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special' },
            { id: 1, name: 'General' }
        ];

        $(async () => {
            // ==========================================
            // 1. สร้าง DataGrid หลักก่อน (เพื่อป้องกัน Error E0009)
            // ==========================================
            initDxGrid("#grid", {
                dataSource: coursesStore,
                height: "calc(100vh - 230px)",
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search courses..." },

                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this course and all its versions?" }
                },

                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
            
                         window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 150,
                        alignment: "center",
                    },
                   {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");

                            // เช็คเงื่อนไข: ถ้า isActive เป็น false ให้สร้างป้าย Draft
                            if (options.data.isActive === false) {
                                $("<span>")
                                    .addClass("badge bg-warning text-dark border")
                                    .html('Draft')
                                    .appendTo(wrapper);
                            }

                            // แสดงชื่อวิชาตามปกติ
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(wrapper);

                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 200,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "Type",
                        width: 160,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            const icon = options.value === 1 ? "fa-globe text-primary" : "fa-star text-danger";
                            $("<div>").html(`<i class="fas ${icon} me-1 opacity-75"></i> ${text}`).appendTo(container);
                        }
                    },
                   
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                           
                           
                            {
            hint: "View Course Dashboard",
            icon: "info", // ใช้ไอคอนกราฟหรือฟันเฟือง
            onClick: function(e) {
                // เปลี่ยนเส้นทางไปที่หน้า Dashboard
                window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.row.data.id;
            }
        }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. โหลดข้อมูลและสร้าง TreeView ด้านซ้ายจาก API
            // ==========================================
            try {
                const treeData = await $.ajax({
                    url: serviceUrl + '/Divisions/GetTree', // ลบ / ออกเพื่อไม่ให้ซ้ำซ้อนกับ serviceUrl ที่มี / ปิดท้ายอยู่แล้ว
                    type: 'GET',
                    xhrFields: {
                        withCredentials: true
                    }
                });

                $("#categoryTreeView").dxTreeView({
                    dataSource: treeData,
                    height: "calc(100vh - 267px)",
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;

                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรอง (Filter)
                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.categoryId) {
                            grid.filter(["categoryId", "=", node.categoryId]);
                        } else if (node.isDivision) {
                            grid.filter(["category.divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        // เลือก Root (All Courses) เป็นค่าเริ่มต้นเสมอ
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading treeview data", err);
            }
        });
    </script>
}