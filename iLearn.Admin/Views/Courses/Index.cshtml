@{
    ViewBag.Title = "Course Management";
}

<style>
    :root {
        --text-primary:   #262626;
        --text-secondary: #595959;
        --border-color:   #f0f0f0;
        --accent-color:   #1890ff;
        --success-color:  #52c41a;
        --warning-color:  #faad14;
        --bg-light:       #fafafa;
    }

    body { background: #fff; color: var(--text-primary); font-size: 13px; }

    .page-header {
        border-bottom: 1px solid var(--border-color);
        padding: 12px 24px;
        background: #fff;
    }

    .action-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: #fff;
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: 0.15s;
    }
    .action-link:hover { background: var(--bg-light); color: var(--text-primary); }
    .action-link.primary { background: var(--accent-color); border-color: var(--accent-color); color: #fff; }
    .action-link.primary:hover { background: #096dd9; border-color: #096dd9; color: #fff; }

    .section-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 10px 14px 8px;
        border-bottom: 1px solid var(--border-color);
    }

    .dx-treeview, .dx-datagrid { height: 100% !important; }
</style>

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Course Management</div>
        <div class="text-secondary" style="font-size:12px;">Manage all training courses and versions</div>
    </div>
    <a href="@Url.Action("Form", "Courses")" class="action-link primary">
        <i class="fas fa-plus"></i> New Course
    </a>
</div>

<div class="container-fluid px-4 py-3 pb-5" style="height: calc(100vh - 115px);">
    <div class="row g-3 h-100">

        <!-- Categories TreeView -->
        <div class="col-md-4 col-lg-3 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column">
                <div class="section-label">Categories</div>
                <div class="p-2 flex-grow-1 overflow-hidden">
                    <div id="categoryTreeView"></div>
                </div>
            </div>
        </div>

        <!-- Course DataGrid -->
        <div class="col-md-8 col-lg-9 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column overflow-hidden">
                <div id="grid" class="flex-grow-1"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // DataStores [cite: 50-51]
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        $(async () => {
            // ==========================================
            // 1. สร้าง DataGrid หลัก
            // ==========================================
            initDxGrid("#grid", {
                dataSource: coursesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search courses..." },

                // --- ปรับแต่ง UI ตารางให้คลีน ---
                showBorders: false, 
                rowAlternationEnabled: true, 
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this course and all its versions?" }
                },

                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 130,
                        alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600", color: "var(--text-primary)" })
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");

                            if (options.data.isActive === false) {
                                $("<span>").css({ fontSize: "11px", padding: "1px 7px",
                                                  borderRadius: "3px", background: "var(--bg-light)",
                                                  border: "1px solid var(--border-color)",
                                                  color: "var(--text-secondary)", fontWeight: "500" })
                                           .text("Draft").appendTo(wrapper);
                            }

                            $("<span>").css({ fontSize: "13px", fontWeight: "600",
                                              color: "var(--text-primary)" })
                                       .text(options.value).appendTo(wrapper);
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 200,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.displayValue || "—").appendTo(c)
                    },
                    {
                        dataField: "courseTypeId",
                        caption: "Type",
                        width: 140,
                        lookup: {
                            dataSource: courseTypesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue || "—";
                            const color = options.data.courseTypeId === 2 ? "var(--accent-color)" : "var(--text-secondary)";
                            $("<span>").css({ fontSize: "12px", color, fontWeight: "500" })
                                       .text(text).appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Course Dashboard",
                                icon: "info",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.row.data.id;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. โหลดข้อมูลและสร้าง TreeView ด้านซ้ายจาก API
            // ==========================================
            try {
                const treeData = await $.ajax({
                    url: serviceUrl + '/Divisions/GetTree', // อ้างอิงตามโค้ดเดิมของคุณ [cite: 76-77]
                    type: 'GET',
                    xhrFields: {
                        withCredentials: true
                    }
                });

                $("#categoryTreeView").dxTreeView({
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรองตารางตามโหนดที่คลิก [cite: 81-83]
                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.categoryId) {
                            grid.filter(["categoryId", "=", node.categoryId]);
                        } else if (node.isDivision) {
                            grid.filter(["category.divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading treeview data", err);
            }
        });
    </script>
}