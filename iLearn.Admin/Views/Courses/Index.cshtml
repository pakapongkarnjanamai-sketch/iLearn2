@{
    ViewBag.Title = "Course Management";
}

@section Styles {
    <style>
        .course-filter-group-label {
            font-size: var(--font-size-caption);
            line-height: var(--text-caption-line-height);
            font-weight: var(--font-weight-semibold);
            letter-spacing: var(--letter-spacing-normal);
            text-transform: uppercase;
            color: var(--text-secondary);
        }

        @@media (max-width: 991.98px) {
            .page-header {
                align-items: flex-start !important;
            }

            .page-header-actions {
                width: 100%;
            }
        }

    </style>
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="admin-monitor-bar">
      
        <div class="admin-monitor-filters admin-monitor-filters--spacious">
            <div class="admin-filter-group" role="group" aria-label="Course type filters">
                <div class="admin-filter-group" id="course-type-filter-chips"></div>
            </div>
        </div>
    </div>

    <div class="page-header-actions">
       <a href="@Url.Action("Index", "Categories")" class="action-link">
            <i class="fas fa-layer-group" aria-hidden="true"></i> Course Categories
        </a>
        <a href="@Url.Action("Editor", "Courses")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Course
        </a>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">

        <!-- Categories TreeView -->
        <div class="col-md-4 col-lg-3 h-100">
            <div class="panel h-100 d-flex flex-column">
                <div class="panel-header">
                    <i class="fas fa-filter me-1" aria-hidden="true"></i> Filters
                </div>

                <div class="panel-body p-2 flex-grow-1 overflow-hidden">
                    <div id="categoryTreeView" class="admin-viewport-fill"></div>
                </div>
            </div>
        </div>

        <!-- Course DataGrid -->
        <div class="col-md-8 col-lg-9 h-100">
       

        <div id="grid" class="h-100 admin-viewport-fill"></div>
   

        </div>

    </div>
</div>

@section Scripts {
    <script>
        const courseDetailUrl = '@Url.Action("Detail", "Courses")';
        const divisionsTreeUrl = `${serviceUrl}/Divisions/GetTree`;
        const courseQuickFilterState = {
            typeKey: "all"
        };
        let courseTypeFilters = [
            { key: "all", courseTypeId: null, label: "All Types" },
            { key: "type-1", courseTypeId: 1, label: "Special" },
            { key: "type-2", courseTypeId: 2, label: "General" }
        ];

        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        $(async () => {
            let categoryTreeView = null;
            let currentTreeFilter = null;
            const grid = initDxGrid("#grid", buildAdminGridOptions("Search by code, name, category, or type...", {
                height: "100%",
                dataSource: coursesStore,
                remoteOperations: true,

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Delete this course and all of its versions? This action cannot be undone." }
                },

                onRowDblClick: function(e) {
                    navigateToCourseDetail(e.data?.id);
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "title",
                        caption: "Course",
                        minWidth: 260,
                        calculateFilterExpression: function(value, selectedFilterOperation, target) {
                            if (target === "search" || !selectedFilterOperation || selectedFilterOperation === "contains") {
                                return [["code", "contains", value], "or", ["title", "contains", value]];
                            }
                            return this.defaultCalculateFilterExpression.apply(this, arguments);
                        },
                        cellTemplate: (container, options) => {
                            window.renderAdminCourseIdentityCell(container, {
                                code: options.data.code,
                                title: options.value,
                                isActive: options.data.isActive
                            });
                        }
                    },
                    {
                        dataField: "courseTypeName",
                        caption: "Course Type",
                        width: 140,
                        alignment: "center",
                        cellTemplate: (container, options) => {
                            const text = options.value || "—";
                            const tone = window.getAdminCourseTypeTone(options.data.courseTypeId, options.value);

                            window.renderAdminGridStatusCell(container, text, tone, { showDot: false });
                        }
                    },
                    {
                        dataField: "categoryName",
                        caption: "Category",
                        width: 200,
                        cssClass: "cell-secondary",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Course Details",
                                icon: "info",
                                onClick: function(e) {
                                    navigateToCourseDetail(e.row.data.id);
                                }
                            }
                        ]
                    }
                ]
            }));

            bindQuickFilters(grid);
            await loadCourseTypeFilters();
            const viewportLayoutController = window.enableAdminViewportLayout({
                refreshTargets: [grid]
            });

            try {
                const treeData = await $.ajax({
                    url: divisionsTreeUrl,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                categoryTreeView = $("#categoryTreeView").dxTreeView({
                    height: '100%',
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        applyTreeFilter(grid, e.itemData);
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                        viewportLayoutController?.refresh();
                    }
                }).dxTreeView("instance");
            } catch (err) {
                console.error("Error loading treeview data", err);
            }

            function navigateToCourseDetail(courseId) {
                if (!courseId) {
                    return;
                }

                window.location.href = `${courseDetailUrl}?id=${courseId}`;
            }

            function bindQuickFilters(gridInstance) {
                window.bindAdminFilterChips("#course-type-filter-chips", function(filterKey) {
                    if (getCourseTypeFilterByKey(filterKey)) {
                        courseQuickFilterState.typeKey = filterKey;
                    }

                    applyActiveFilters(gridInstance);
                }, { dataAttribute: "filterKey", defaultKey: "" });

                renderCourseTypeFilters();
                updateQuickFilterUi();
            }

            function applyActiveFilters(gridInstance) {
                window.applyAdminQuickFilter(gridInstance, courseQuickFilterState.typeKey, {
                    resolve: function (filterKey) {
                        const conditions = [];

                        if (currentTreeFilter) {
                            conditions.push(currentTreeFilter);
                        }

                        const selectedType = getCourseTypeFilterByKey(filterKey);
                        if (selectedType && selectedType.courseTypeId) {
                            conditions.push(["courseTypeId", "=", selectedType.courseTypeId]);
                        }

                        return {
                            conditions: conditions
                        };
                    },
                    onApplied: function () {
                        updateQuickFilterUi();
                    }
                });
            }

            function updateQuickFilterUi() {
                window.updateAdminFilterChipState("#course-type-filter-chips", courseQuickFilterState.typeKey, {
                    dataAttribute: "filterKey"
                });
            }

                function renderCourseTypeFilters() {
                window.renderAdminFilterChips("#course-type-filter-chips", courseTypeFilters, courseQuickFilterState.typeKey, {
                    dataAttribute: "filterKey"
                });
            }

            async function loadCourseTypeFilters() {
                try {
                    const response = await $.ajax({
                        url: `${serviceUrl}/admin/CourseTypesCRUD/Get`,
                        type: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    const loadedTypes = Array.isArray(response?.data) ? response.data : [];
                    const availableTypes = loadedTypes.filter(function(item) {
                        return item && item.id && item.name;
                    });

                    if (availableTypes.length > 0) {
                        courseTypeFilters = [{ key: "all", courseTypeId: null, label: "All Types" }].concat(
                            availableTypes.map(function(item) {
                                return {
                                    key: `type-${item.id}`,
                                    courseTypeId: item.id,
                                    label: item.name
                                };
                            })
                        );

                        if (!getCourseTypeFilterByKey(courseQuickFilterState.typeKey)) {
                            courseQuickFilterState.typeKey = "all";
                        }
                    }
                } catch (error) {
                    // Keep fallback labels when course type lookup is unavailable.
                }

                renderCourseTypeFilters();
                updateQuickFilterUi();
            }

            function getCourseTypeFilterByKey(filterKey) {
                return courseTypeFilters.find(function(item) {
                    return item.key === filterKey;
                }) || null;
            }

            function buildTreeFilter(node) {
                if (!node || node.isRoot) {
                    return null;
                }

                if (node.categoryId) {
                    return ["categoryId", "=", node.categoryId];
                }

                if (node.isDivision) {
                    return ["divisionId", "=", node.divisionId];
                }

                return null;
            }

            function applyTreeFilter(gridInstance, node) {
                currentTreeFilter = buildTreeFilter(node);
                applyActiveFilters(gridInstance);
            }
        });
    </script>
}