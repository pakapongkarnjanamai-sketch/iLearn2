@{
    ViewBag.Title = "Course Management";
    var categoryId = ViewBag.categoryId;
}

<!-- Styles moved to ~/wwwroot/css/admin-site.css -->

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="fas fa-book"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        @if (categoryId != null)
                        {
                            <span class="text-primary"><i class="fas fa-filter me-1"></i>Filtering by Category ID: @categoryId</span>
                        }
                        else
                        {
                            <span>Manage all training courses and versions.</span>
                        }
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-plus me-2"></i> Create New Course
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3" id="grid-courses"></div>
    </div>
</div>

@section Scripts {
    <script>

        const categoryFilterId = @(categoryId ?? "null");

        // DataStores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            let initialFilter = null;
            if (categoryFilterId) {
                initialFilter = ["categoryId", "=", parseInt(categoryFilterId)];
            }

            $("#grid-courses").dxDataGrid({
                dataSource: coursesStore,
                filterValue: initialFilter,
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: false, // Cleaner look
                height: "100%",
                scrolling: { mode: "virtual" },
                selection: { mode: 'single' },
                hoverStateEnabled: true,
                rowAlternationEnabled: false,
                showRowLines: true,
                searchPanel: {
                    visible: true,
                    width: 300,
                    placeholder: "Search courses..."
                },
                headerFilter: { visible: true },

                // Redirect on Double Click
                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Version", "Courses")?courseId=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 120,
                        alignment: "center",
                        cssClass: "fw-bold text-muted"
                    },
                    {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            const name = options.value;
                            $("<span>").addClass("fw-bold text-dark").text(name).appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 180,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "Type",
                        width: 160,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            const icon = options.value === 1 ? "fa-globe" : "fa-lock";
                            $("<div>").html(`<i class="fas ${icon} me-1 text-muted"></i> ${text}`).appendTo(container);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "badge-active" : "badge-inactive";
                            const icon = isActive ? "fa-check-circle" : "fa-clock";
                            const text = isActive ? "Active" : "Draft";

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${text}`)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Manage",
                        width: 160,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // Edit Button (Redirect to Form)
                            $("<button>")
                                .addClass("btn-icon")
                                .attr("title", "Edit Course")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Form", "Courses")?id=' + data.id)
                                .appendTo($group);

                            // Versions Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Manage Versions")
                                .html('<i class="fas fa-code-branch"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Version", "Courses")?courseId=' + data.id)
                                .appendTo($group);

                            // Delete Button
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Course")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", function() {
                                    confirmDelete(data.id, data.title);
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ],
                onToolbarPreparing: function(e) {
                    // Add Filter/Refresh buttons if needed
                }
            });
        });

        function confirmDelete(id, name) {
            DevExpress.ui.dialog.confirm(
                `Are you sure you want to delete course "<strong>${name}</strong>"?<br>This will delete all versions and history.`,
                "Confirm Delete"
            ).done(function (dialogResult) {
                if (dialogResult) {
                    deleteCourse(id);
                }
            });
        }

        function deleteCourse(id) {
            // Using standard CRUD store delete
            coursesStore.remove(id).done(() => {
                DevExpress.ui.notify("Course deleted successfully", "success", 2000);
                $("#grid-courses").dxDataGrid("instance").refresh();
            }).fail((err) => {
                console.error(err);
                DevExpress.ui.notify("Failed to delete course", "error", 2000);
            });
        }
    </script>
}