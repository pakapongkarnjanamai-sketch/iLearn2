@{
    ViewBag.Title = "Course Management";
    var categoryId = ViewBag.categoryId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-book"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        @if (categoryId != null)
                        {
                            <span class="text-primary"><i class="fas fa-filter me-1"></i>Filtering by Category ID: @categoryId</span>
                        }
                        else
                        {
                            <span>Manage all training courses and versions.</span>
                        }
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded shadow-sm px-3">
                    <i class="fas fa-plus me-2"></i> Create New Course
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const categoryFilterId = @(categoryId ?? "null");

        // DataStores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            let initialFilter = null;
            if (categoryFilterId) {
                initialFilter = ["categoryId", "=", parseInt(categoryFilterId)];
            }

            initDxGrid("#grid", {
                dataSource: coursesStore,
                filterValue: initialFilter,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search courses..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                // เปิดใช้งาน editing เพื่อให้รองรับการลบข้อมูลด้วย UI มาตรฐานของ DevExtreme
                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this course and all its versions?" }
                },

                // Redirect ไปหน้าจัดการเวอร์ชันเมื่อดับเบิลคลิกที่แถว
                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Version", "Courses")?courseId=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 120,
                        alignment: "center",
               
                    },
                    {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 250,
              
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 250,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "Type",
                        width: 160,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            // เพิ่มสีให้ไอคอนเพื่อให้แยกประเภทได้ง่ายขึ้น
                            const icon = options.value === 1 ? "fa-globe text-primary" : "fa-lock text-danger";
                            $("<div>").html(`<i class="fas ${icon} me-1 opacity-75"></i> ${text}`).appendTo(container);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: true, name: 'Active' },
                                { id: false, name: 'Draft' }
                            ],
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            // ใช้ Bootstrap Badge แบบมาตรฐาน แทน Custom CSS เดิม
                            const badgeClass = isActive ? "bg-success text-white" : "bg-warning text-dark";
                            const icon = isActive ? "fa-check-circle" : "fa-pen-nib";
                            const text = isActive ? "Active" : "Draft";

                            $("<span>")
                                .addClass(`badge border px-2 py-1 ${badgeClass}`)
                                .html(`<i class="fas ${icon} me-1"></i> ${text}`)
                                .appendTo(container);
                        }
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Edit Course",
                                icon: "edit",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Form", "Courses")?id=' + e.row.data.id;
                                }
                            },
                            {
                                hint: "Manage Versions",
                                icon: "preferences",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Version", "Courses")?courseId=' + e.row.data.id;
                                }
                            },
                            {
            hint: "Assign to Employees",
            icon: "group",
            onClick: function(e) {
                // ส่ง ID ของวิชานั้นแนบไปกับ URL
                window.location.href = `/Assignments/Form?courseId=${e.row.data.id}`;
            }
        },

                            "delete"
                        ]
                    }
                ]
            });
        });
    </script>
}