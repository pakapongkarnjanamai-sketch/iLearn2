@{
    ViewBag.Title = "Course Management";
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* บังคับให้ TreeView และ Grid สูงเต็มพื้นที่ของ Card Body */
    .dx-treeview, .dx-datagrid {
        height: 100% !important;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                <i class="fas fa-book fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted">Manage all training courses and versions.</small>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded-3 shadow-sm px-4 py-2 d-flex align-items-center gap-2 fw-medium">
                <i class="fas fa-plus"></i> New Course
            </a>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5" style="height: calc(100vh - 180px);">
    <div class="row g-4 h-100">
        
        <div class="col-md-4 col-lg-3 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-sitemap me-2 text-primary"></i> Categories
                    </h6>
                </div>
                <div class="card-body px-3 pb-4 flex-grow-1 overflow-hidden">
                    <div id="categoryTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-body p-0 flex-grow-1 overflow-hidden ">
                    <div id="grid"></div>
                </div>
            </div>
        </div>
        
    </div>
</div>

@section Scripts {
    <script>
        // DataStores [cite: 50-51]
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        $(async () => {
            // ==========================================
            // 1. สร้าง DataGrid หลัก
            // ==========================================
            initDxGrid("#grid", {
                dataSource: coursesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search courses..." },

                // --- ปรับแต่ง UI ตารางให้คลีน ---
                showBorders: false, 
                rowAlternationEnabled: true, 
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this course and all its versions?" }
                },

                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 150,
                        alignment: "center",
                    },
                    {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");
                            
                            // ปรับสไตล์ป้าย Draft ให้ดู Minimal ยิ่งขึ้น [cite: 59-62]
                            if (options.data.isActive === false) {
                                $("<span>")
                                    .addClass("badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill fw-medium")
                                    .html('<i class="fas fa-pen me-1" style="font-size: 0.7rem;"></i>Draft')
                                    .appendTo(wrapper);
                            }

                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(wrapper);
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 200,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "courseTypeId",
                        caption: "Type",
                        width: 160,
                        lookup: {
                            dataSource: courseTypesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            const icon = options.data.courseTypeId === 2 ? "fa-book text-primary" : "fa-star text-secondary";
                            $("<div>").html(`<i class="fas ${icon} me-1"></i> <span class="text-dark fw-medium">${text}</span>`).appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Course Dashboard",
                                icon: "info",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + e.row.data.id;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. โหลดข้อมูลและสร้าง TreeView ด้านซ้ายจาก API
            // ==========================================
            try {
                const treeData = await $.ajax({
                    url: serviceUrl + '/Divisions/GetTree', // อ้างอิงตามโค้ดเดิมของคุณ [cite: 76-77]
                    type: 'GET',
                    xhrFields: {
                        withCredentials: true
                    }
                });

                $("#categoryTreeView").dxTreeView({
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรองตารางตามโหนดที่คลิก [cite: 81-83]
                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.categoryId) {
                            grid.filter(["categoryId", "=", node.categoryId]);
                        } else if (node.isDivision) {
                            grid.filter(["category.divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading treeview data", err);
            }
        });
    </script>
}