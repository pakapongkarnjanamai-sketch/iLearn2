@{
    ViewBag.Title = "Course Dashboard";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Course Management</div>
        <div class="page-subtitle">Manage all training courses and versions</div>
    </div>
    <a href="@Url.Action("Form", "Courses")" class="action-link primary">
        <i class="fas fa-plus"></i> New Course
    </a>
</div>

<div class="container-fluid px-4 py-3 pb-5" style="height: calc(100vh - 115px);">
    <div class="row g-3 h-100">

        <!-- Categories TreeView -->
        <div class="col-md-4 col-lg-3 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column">
          
                <div class="panel-header">Categories</div>

                <div class="p-2 flex-grow-1 overflow-hidden">
                    <div id="categoryTreeView"></div>
                </div>
            </div>
        </div>

        <!-- Course DataGrid -->
        <div class="col-md-8 col-lg-9 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column overflow-hidden">
                <div id="grid" class="flex-grow-1"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // DataStores [cite: 50-51]
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' });

        // Lookup DataSources — raw+cached เพื่อดึงครั้งเดียว resolve label ในฝั่ง client
        const dsCategoriesLookup = { store: categoriesStore, loadMode: 'raw', cacheRawData: true };
        const dsCourseTypesLookup = { store: courseTypesStore, loadMode: 'raw', cacheRawData: true };

        $(async () => {
            // ==========================================
            // 1. สร้าง DataGrid หลัก
            // ==========================================
            initDxGrid("#grid", {
                dataSource: coursesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search courses..." },

                showBorders: false,
                scrolling: { mode: "virtual" },

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this course and all its versions?" }
                },

                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Detail", "Courses")?id=' + e.data.id;
                    }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 150,
                        alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600", color: "var(--text-primary)" })
                                       .text(o.value || "—").appendTo(c)
                    },
                    {
                        dataField: "title",
                        caption: "Course Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");

                            if (options.data.isActive === false) {
                                $("<span>").addClass("tag-pill pill-default")
                                           .text("Draft").appendTo(wrapper);
                            }

                            $("<span>").css({ fontSize: "13px", fontWeight: "600",
                                              color: "var(--text-primary)" })
                                       .text(options.value).appendTo(wrapper);
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 200,
                        lookup: {
                            dataSource: dsCategoriesLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.displayValue || "—").appendTo(c)
                    },
                    {
                        dataField: "courseTypeId",
                        caption: "Type",
                        width: 140,
                        lookup: {
                            dataSource: dsCourseTypesLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue || "—";
                            const color = options.data.courseTypeId === 2 ? "var(--accent-color)" : "var(--text-secondary)";
                            $("<span>").css({ fontSize: "12px", color, fontWeight: "500" })
                                       .text(text).appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Course Dashboard",
                                icon: "info",
                            onClick: function(e) {
                                    window.location.href = '@Url.Action("Detail", "Courses")?id=' + e.row.data.id;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. โหลดข้อมูลและสร้าง TreeView ด้านซ้ายจาก API
            // ==========================================
            try {
                const treeData = await $.ajax({
                    url: serviceUrl + '/Divisions/GetTree', // อ้างอิงตามโค้ดเดิมของคุณ [cite: 76-77]
                    type: 'GET',
                    xhrFields: {
                        withCredentials: true
                    }
                });

                $("#categoryTreeView").dxTreeView({
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรองตารางตามโหนดที่คลิก [cite: 81-83]
                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.categoryId) {
                            grid.filter(["categoryId", "=", node.categoryId]);
                        } else if (node.isDivision) {
                            grid.filter(["category.divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading treeview data", err);
            }
        });
    </script>
}