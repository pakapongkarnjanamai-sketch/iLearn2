@{
    ViewBag.Title = "Course Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">@ViewBag.Title</h1>
        <div class="page-subtitle">Manage courses and versions.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Editor", "Courses")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Course
        </a>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">

        <!-- Categories TreeView -->
        <div class="col-md-4 col-lg-3 h-100">
            <div class="panel h-100 d-flex flex-column">
                <div class="panel-header">
                    <i class="fas fa-filter me-1" aria-hidden="true"></i> Filters
                </div>

                <div class="panel-body p-2 flex-grow-1 overflow-hidden">
                    <div id="categoryTreeView" class="admin-viewport-fill"></div>
                </div>
            </div>
        </div>

        <!-- Course DataGrid -->
        <div class="col-md-8 col-lg-9 h-100">
       

        <div id="grid" class="h-100 admin-viewport-fill"></div>
   

        </div>

    </div>
</div>

@section Scripts {
    <script>
        const courseDetailUrl = '@Url.Action("Detail", "Courses")';
        const divisionsTreeUrl = `${serviceUrl}/Divisions/GetTree`;

        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        $(async () => {
            const grid = initDxGrid("#grid", buildAdminGridOptions("Search by code, name, category, or type...", {
                height: "100%",
                dataSource: coursesStore,
                remoteOperations: true,

                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Delete this course and all of its versions? This action cannot be undone." }
                },

                onRowDblClick: function(e) {
                    navigateToCourseDetail(e.data?.id);
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "title",
                        caption: "Course",
                        minWidth: 260,
                        calculateFilterExpression: function(value, selectedFilterOperation, target) {
                            if (target === "search" || !selectedFilterOperation || selectedFilterOperation === "contains") {
                                return [["code", "contains", value], "or", ["title", "contains", value]];
                            }
                            return this.defaultCalculateFilterExpression.apply(this, arguments);
                        },
                        cellTemplate: function(container, options) {
                            window.renderAdminCourseIdentityCell(container, {
                                code: options.data.code,
                                title: options.value,
                                isActive: options.data.isActive
                            });
                        }
                    },
                    {
                        dataField: "courseTypeName",
                        caption: "Type",
                        width: 140,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const text = options.value || "—";
                            const tone = window.getAdminCourseTypeTone(options.data.courseTypeId, options.value);

                            window.renderAdminGridStatusCell(container, text, tone, { showDot: false });
                        }
                    },
                    {
                        dataField: "categoryName",
                        caption: "Category",
                        width: 200,
                        cssClass: "cell-secondary",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        type: "buttons",
                        caption: "Quick Actions",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Course Details",
                                icon: "info",
                                onClick: function(e) {
                                    navigateToCourseDetail(e.row.data.id);
                                }
                            }
                        ]
                    }
                ]
            }));
            const viewportLayoutController = window.enableAdminViewportLayout({
                refreshTargets: [grid]
            });

            try {
                const treeData = await $.ajax({
                    url: divisionsTreeUrl,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                $("#categoryTreeView").dxTreeView({
                    height: '100%',
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    selectNodesRecursive: false,
                    onItemSelectionChanged: function(e) {
                        applyTreeFilter(grid, e.itemData);
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                        viewportLayoutController?.refresh();
                    }
                });
            } catch (err) {
                console.error("Error loading treeview data", err);
            }

            function navigateToCourseDetail(courseId) {
                if (!courseId) {
                    return;
                }

                window.location.href = `${courseDetailUrl}?id=${courseId}`;
            }

            function appendText(container, text, styles) {
                return appendAdminText(container, text, styles);
            }

            function applyTreeFilter(gridInstance, node) {
                if (node.isRoot) {
                    gridInstance.clearFilter();
                    return;
                }

                if (node.categoryId) {
                    gridInstance.filter(["categoryId", "=", node.categoryId]);
                    return;
                }

                if (node.isDivision) {
                    gridInstance.filter(["divisionId", "=", node.divisionId]);
                }
            }
        });
    </script>
}