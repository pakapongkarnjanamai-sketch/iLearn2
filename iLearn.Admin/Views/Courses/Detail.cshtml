@{
    ViewBag.Title = "Course Detail";
    int courseId = ViewBag.CourseId;
}

<style>
    .course-description {
        min-height: 96px;
        font-size: var(--font-size-sm);
        color: var(--text-primary);
        line-height: 1.6;
        white-space: pre-wrap;
    }
    .version-resource-stack { min-width: 0; }
    .version-resource-line { min-width: 0; }
    .version-resource-line .tag-pill { flex-shrink: 0; }
    .version-resource-preview-btn {
        border: 0;
        background: transparent;
        color: var(--primary-color);
        padding: 0;
        line-height: 1;
    }
    .version-resource-preview-btn:hover,
    .version-resource-preview-btn:focus-visible {
        color: var(--primary-hover);
        outline: none;
    }
    .version-resource-more {
        font-size: var(--font-size-xs);
        color: var(--text-secondary);
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title" id="pageTitle">Course Detail</h1>
        <div class="page-subtitle" id="pageSubtitle">Loading...</div>
    </div>
    <a href="@Url.Action("Index", "Courses")" class="action-link">
        <i class="fas fa-arrow-left text-secondary" aria-hidden="true"></i> Back
    </a>
</div>

<div class="container-fluid page-shell-lg px-4 py-4">

    <div class="row g-3 mb-4">

        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Info</div>
                        <span id="courseStatusBadge" class="tag-pill pill-default admin-section-status">
                            <i class="fas fa-circle-notch fa-spin me-1" aria-hidden="true"></i> Loading...
                        </span>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-meta-item">
                    <div class="admin-meta-label">Course Name</div>
                    <div class="admin-meta-value fw-bold" id="summary-course-name">—</div>
                </div>
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Course Code</div>
                    <div class="admin-meta-value" id="summary-course-code">—</div>
                </div>
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Division</div>
                    <div class="admin-meta-value" id="summary-division">—</div>
                </div>
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Category</div>
                    <div class="admin-meta-value" id="summary-category">—</div>
                </div>
                <div class="admin-meta-item">
                    <div class="admin-meta-label">Course Type</div>
                    <div class="admin-meta-value" id="summary-course-type">—</div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="section-title">Summary</div>
                <div class="detail-stat-strip mb-3">
                    <div class="detail-stat detail-stat--primary">
                        <div class="detail-stat__num" id="stat-version-count">—</div>
                        <div class="detail-stat__lbl">Versions</div>
                    </div>
                    <div class="detail-stat">
                        <div class="detail-stat__num" id="stat-assignment-count">—</div>
                        <div class="detail-stat__lbl">Assignments</div>
                    </div>
                    <div class="detail-stat">
                        <div class="detail-stat__num" id="stat-learner-count">—</div>
                        <div class="detail-stat__lbl">Learners</div>
                    </div>
                    <div class="detail-stat detail-stat--success">
                        <div class="detail-stat__num" id="stat-completed-count">—</div>
                        <div class="detail-stat__lbl">Completed</div>
                    </div>
                </div>
                <div class="border rounded bg-white p-3 flex-grow-1 d-flex flex-column gap-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="admin-meta-label">Current Version</div>
                            <div class="admin-meta-value" id="summary-active-version">—</div>
                        </div>
                        <div class="col-md-6">
                            <div class="admin-meta-label">Availability</div>
                            <div class="admin-meta-value" id="summary-availability">—</div>
                        </div>
                    </div>
                    <div>
                        <div class="admin-meta-label">Description</div>
                        <div class="course-description" id="summary-description">—</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <button type="button" id="btnEditCourse" class="quick-action">
                        <div class="qa-icon qa-icon-muted">
                            <i class="fas fa-edit" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Edit Course</div>
                            <div class="u-fs-11 text-secondary">Change course information</div>
                        </div>
                    </button>

                    <button type="button" id="btnNewVersion" class="quick-action">
                        <div class="qa-icon qa-icon-accent">
                            <i class="fas fa-code-branch" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">New Version</div>
                            <div class="u-fs-11 text-secondary">Create a new content version</div>
                        </div>
                    </button>

                    <button type="button" id="btnAssignment" class="quick-action">
                        <div class="qa-icon qa-icon-accent">
                            <i class="fas fa-user-plus" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Assignments</div>
                            <div class="u-fs-11 text-secondary">Assign course to employees</div>
                        </div>
                    </button>

                    <button type="button" id="btnTogglePublish" class="quick-action">
                        <div class="qa-icon qa-icon-muted" id="publishIconBox">
                            <i id="publishIcon" class="fas fa-globe" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark" id="publishBtnText">Publish Course</div>
                            <div class="u-fs-11 text-secondary" id="publishBtnDesc">Make course available</div>
                        </div>
                    </button>

                    <button type="button" id="btnDeleteCourse" class="quick-action danger">
                        <div class="qa-icon qa-icon-danger">
                            <i class="fas fa-trash-alt" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Delete Course</div>
                            <div class="u-fs-11 text-secondary">Remove permanently</div>
                        </div>
                    </button>

                </div>

                <div id="warningMsg" class="mt-3 pt-3 d-none u-border-top u-fs-11 u-text-warning">
                    <i class="fas fa-exclamation-triangle me-1" aria-hidden="true"></i> Cannot delete an active course.
                </div>
            </div>
        </div>

    </div>

    <div class="border rounded bg-white p-3">
        <div class="admin-section-header mb-3">
            <div class="admin-section-header-main">
                <div class="section-title mb-0 admin-section-title-fill">Course Versions</div>
                <span class="tag-pill pill-default admin-section-meta" id="versionsCountBadge">0 Versions</span>
            </div>
            <div class="admin-section-divider"></div>
        </div>
        <div id="versionsGrid"></div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = `${serviceUrl}/courses`;
        const courseIndexUrl = '@Url.Action("Index", "Courses")';
        const newVersionUrl = '@Url.Action("VersionForm", "Courses")';
        const assignmentFormUrl = '@Url.Action("BulkAssign", "Assignments")';
        const VERSION_LEARNER_POLICY = {
            NewLearnersOnly: "NewLearnersOnly",
            MoveNotStarted: "MoveNotStarted",
            ResetInProgress: "ResetInProgress"
        };

        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'Courses', {
            key: 'id',
            loadUrl: `${serviceUrl}/Courses/course-types-lookup`
        });

        let isCourseActive = false;
        let currentCourseData = null;
        let versionsData = [];
        let versionsGrid;
        let divisionOptions = [];
        let categoryOptions = [];
        let courseTypeOptions = [];
        let activeVersionRequestId = null;
        const versionReadinessCache = new Map();
        let dashboardKpi = {
            versionCount: 0,
            assignmentCount: 0,
            learnerCount: 0,
            completedCount: 0
        };
        const EMPTY_TEXT = '—';

        $(async () => {
            const lookupResults = await Promise.all([
                loadLookupOptions(divisionsStore),
                loadLookupOptions(categoriesStore),
                loadLookupOptions(courseTypesStore)
            ]);

            divisionOptions = lookupResults[0];
            categoryOptions = lookupResults[1];
            courseTypeOptions = lookupResults[2];

            initializeVersionsGrid();

            $("#btnEditCourse").on("click", function(e) {
                e.preventDefault();
                openEditCourseDialog();
            });

            await loadDashboardData();

            function updateStatusUI(isActive) {
                const $publishIcon = $("#publishIcon");
                const $publishIconBox = $("#publishIconBox");
                const $publishBtnText = $("#publishBtnText");
                const $publishBtnDesc = $("#publishBtnDesc");
                const $btnDelete = $("#btnDeleteCourse");
                const $btnAssignment = $("#btnAssignment");
                const $statusBadge = $("#courseStatusBadge");
                const $warnMsg = $("#warningMsg");
                const $availability = $("#summary-availability");

                if (isActive) {
                    $publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    $publishIconBox.removeClass("qa-icon-muted").addClass("qa-icon-warning");
                    $publishBtnText.text("Close Course");
                    $publishBtnDesc.text("Deactivate — stop new learners");
                    $statusBadge.removeClass("pill-default pill-warning pill-danger pill-primary")
                                .addClass("pill-success")
                                .html('<i class="fas fa-check-circle me-1"></i> Active');
                    setActionLinkState($btnDelete, true);
                    setActionLinkState($btnAssignment, false);
                    $availability.html('<span class="tag-pill pill-success"><i class="fas fa-check-circle me-1"></i> Available for assignment</span>');
                    $warnMsg.removeClass("d-none");
                } else {
                    $publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    $publishIconBox.removeClass("qa-icon-warning").addClass("qa-icon-muted");
                    $publishBtnText.text("Publish Course");
                    $publishBtnDesc.text("Make course available");
                    $statusBadge.removeClass("pill-success pill-warning pill-danger pill-primary")
                                .addClass("pill-default")
                                .html('<i class="fas fa-lock me-1"></i> Closed');
                    setActionLinkState($btnDelete, false);
                    setActionLinkState($btnAssignment, true);
                    $availability.html('<span class="tag-pill pill-default"><i class="fas fa-lock me-1"></i> Closed to new learners</span>');
                    $warnMsg.addClass("d-none");
                }

                if (currentCourseData) {
                    currentCourseData.isActive = isActive;
                }
            }

            $("#btnTogglePublish").on("click", function(e) {
                e.preventDefault();
                const $btn = $(this);

                if ($btn.hasClass("disabled")) {
                    return;
                }

                setActionLinkState($btn, true, "opacity-50 pe-none");

                const newState = !isCourseActive;
                const confirmMsg = newState ? "Publish this course?" : "Close this course?";

                DevExpress.ui.dialog.confirm(confirmMsg, "Confirm Status Change").done(async function(ok) {
                    if (!ok) {
                        setActionLinkState($btn, false, "opacity-50 pe-none");
                        return;
                    }

                    try {
                        const response = await $.ajax({
                            url: `${courseApiUrl}/${courseId}/status`,
                            type: 'PUT',
                            contentType: 'application/json',
                            xhrFields: { withCredentials: true },
                            data: JSON.stringify({ isActive: newState })
                        });

                        isCourseActive = newState;
                        updateStatusUI(isCourseActive);

                        const successMessage = response.message || (newState ? "Course published!" : "Course closed.");
                        showToast(successMessage, "success", 2000);
                    } catch (xhr) {
                        showToast(window.getApiErrorMessage(xhr, "Error updating status."), "error", 4000);
                    } finally {
                        setActionLinkState($btn, false, "opacity-50 pe-none");
                    }
                });
            });

            $("#btnDeleteCourse").on("click", function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    return;
                }

                DevExpress.ui.dialog.confirm("Delete this course permanently? This cannot be undone.", "Confirm Delete").done(async function(ok) {
                    if (!ok) {
                        return;
                    }

                    try {
                        await $.ajax({
                            url: `${courseApiUrl}/${courseId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true }
                        });

                        showToast("Course deleted.", "success", 2000);
                        setTimeout(() => {
                            window.location.href = courseIndexUrl;
                        }, 1500);
                    } catch (xhr) {
                        showToast(window.getApiErrorMessage(xhr, "Error deleting course."), "error");
                    }
                });
            });

            function goNewVersion() {
                window.location.href = `${newVersionUrl}?courseId=${courseId}`;
            }

            $("#btnNewVersion").on("click", function(e) {
                e.preventDefault();
                goNewVersion();
            });

            $("#btnAssignment").on("click", function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    showToast("Please publish the course before managing assignments.", "warning", 2500);
                    return;
                }
                window.location.href = `${assignmentFormUrl}?courseId=${courseId}`;
            });

            function initializeVersionsGrid() {
                versionsGrid = initDxGrid("#versionsGrid", {
                    preset: "compactGrid",
                    dataSource: [],
                    rowAlternationEnabled: true,
                    searchPanel: { placeholder: "Search versions..." },
                    columns: [
                        {
                            dataField: "versionNumber",
                            caption: "Version",
                            width: 110,
                            alignment: "center",
                            cssClass: "cell-bold",
                            customizeText: function(e) {
                                return e.value ? `v${e.value}` : EMPTY_TEXT;
                            }
                        },
                        {
                            dataField: "isActive",
                            caption: "Status",
                            width: 120,
                            alignment: "center",
                            cellTemplate: function(container, options) {
                                window.renderAdminGridStatusCell(
                                    container,
                                    options.value ? "Active" : "Closed",
                                    options.value ? "success" : "default"
                                );
                            }
                        },
                        {
                            dataField: "note",
                            caption: "Description",
                            minWidth: 240,
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    window.renderAdminGridTruncatedTextCell(container, options.value, 80, "captionMuted");
                                    return;
                                }

                                $("<span>")
                                    .addClass("text-muted u-fs-11")
                                    .text("No description")
                                    .appendTo(container);
                            }
                        },
                        {
                            dataField: "createdAt",
                            caption: "Created",
                            width: 120,
                            alignment: "center",
                            dataType: "date",
                            format: ADMIN_DATE_DISPLAY_FORMAT,
                            cssClass: "cell-caption"
                        },
                        {
                            dataField: "resources",
                            caption: "Resources",
                            minWidth: 300,
                            allowSorting: false,
                            allowFiltering: false,
                            cellTemplate: function(container, options) {
                                renderVersionResourcesCell(container, options.value || []);
                            }
                        },
                        {
                            type: "buttons",
                            caption: "Actions",
                            width: 130,
                            alignment: "center",
                            fixed: true,
                            fixedPosition: "right",
                            buttons: [
                                {
                                    hint: "Edit Version",
                                    icon: "edit",
                                    onClick: function(e) {
                                        window.location.href = `${newVersionUrl}?id=${e.row.data.id}&courseId=${courseId}`;
                                    }
                                },
                                {
                                    hint: "Set Active",
                                    icon: "check",
                                    visible: function(e) {
                                        return !e.row.data.isActive;
                                    },
                                    disabled: function() {
                                        return activeVersionRequestId !== null;
                                    },
                                    onClick: function(e) {
                                        window.setActiveVersion(e.row.data.id);
                                    }
                                },
                                {
                                    hint: "Delete Version",
                                    icon: "trash",
                                    visible: function(e) {
                                        return !e.row.data.isActive;
                                    },
                                    onClick: function(e) {
                                        window.deleteVersion(e.row.data.id);
                                    }
                                }
                            ]
                        }
                    ]
                });
            }

            function renderVersionsGrid(versions) {
                versionsData = versions || [];
                versionReadinessCache.clear();
                updateVersionsCountBadge(versionsData.length);

                if (versionsGrid) {
                    versionsGrid.option("dataSource", versionsData);
                }
            }

            window.viewContent = async function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;
                if (!resourceName.toLowerCase().endsWith('.zip')) {
                    window.open(apiUrl, '_blank');
                    return;
                }

                const previewWindow = window.open('about:blank', '_blank');
                if (previewWindow) {
                    previewWindow.document.write(`<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Loading...</title>
    <style>
        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            color: #595959;
            background: #ffffff;
        }

        .resource-preview-loading {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="resource-preview-loading">Processing content...</div>
</body>
</html>`);
                    previewWindow.document.close();
                }

                try {
                    const response = await $.ajax({
                        url: apiUrl,
                        method: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    if (response?.url && previewWindow) {
                        previewWindow.location.href = response.url;
                        return;
                    }

                    if (previewWindow) {
                        previewWindow.close();
                    }

                    showToast('Content URL not found.', 'error');
                } catch {
                    if (previewWindow) {
                        previewWindow.close();
                    }

                    showToast('Failed to get content link.', 'error');
                }
            };

            window.setActiveVersion = async function(versionId) {
                if (activeVersionRequestId !== null) {
                    return;
                }

                activeVersionRequestId = versionId;
                if (versionsGrid) {
                    versionsGrid.repaint();
                }

                try {
                    const learnerPolicy = await resolveLearnerPolicyForActiveVersion();
                    if (!learnerPolicy) {
                        return;
                    }

                    await $.ajax({
                        url: `${courseApiUrl}/${courseId}/versions/${versionId}/set-active`,
                        type: 'PATCH',
                        contentType: 'application/json',
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({ policy: learnerPolicy })
                    });

                    showToast('Active version updated.', 'success', 2000);
                    await reloadVersions();
                } catch (xhr) {
                    if (xhr?.status === 409) {
                        const readiness = await tryGetVersionReadiness(versionId, true);
                        if (readiness && !readiness.isReady) {
                            await showVersionReadinessDialog(versionId, readiness);
                            return;
                        }
                    }

                    showToast(window.getApiErrorMessage(xhr, 'Error updating active version.'), 'error');
                } finally {
                    activeVersionRequestId = null;
                    if (versionsGrid) {
                        versionsGrid.repaint();
                    }
                }
            };

            async function resolveLearnerPolicyForActiveVersion() {
                const response = await $.ajax({
                    url: `${courseApiUrl}/${courseId}/version-impact`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                const impact = response.data || response;
                if (!impact || !impact.hasEligibleOpenLearners) {
                    return VERSION_LEARNER_POLICY.NewLearnersOnly;
                }

                return showVersionLearnerPolicyDialog(impact);
            }

            function showVersionLearnerPolicyDialog(impact) {
                const notStartedCount = Number(impact.notStartedCount || 0);
                const inProgressCount = Number(impact.inProgressCount || 0);
                const completedCount = Number(impact.completedCount || 0);
                const otherOpenCount = Number(impact.otherOpenCount || 0);
                const messageHtml = `
                    <div class="text-start">
                        <div class="u-fs-12 text-secondary mb-3">This course has assigned learners. Choose how the active version should apply.</div>
                        <div class="admin-summary-grid admin-summary-grid--cols-4 mb-3">
                            <div class="admin-summary-item">
                                <div class="admin-summary-value">${notStartedCount}</div>
                                <div class="admin-summary-label">Not Started</div>
                            </div>
                            <div class="admin-summary-item">
                                <div class="admin-summary-value">${inProgressCount}</div>
                                <div class="admin-summary-label">In Progress</div>
                            </div>
                            <div class="admin-summary-item">
                                <div class="admin-summary-value">${completedCount}</div>
                                <div class="admin-summary-label">Completed</div>
                            </div>
                            <div class="admin-summary-item">
                                <div class="admin-summary-value">${otherOpenCount}</div>
                                <div class="admin-summary-label">Not Affected</div>
                            </div>
                        </div>
                        <div class="u-fs-11 text-secondary">Completed learners are kept as-is. In-progress learners are reset only if you choose reset.</div>
                    </div>`;

                const dialog = DevExpress.ui.dialog.custom({
                    title: 'Apply Active Version',
                    messageHtml,
                    buttons: [
                        {
                            text: 'New Learners Only',
                            onClick: function() {
                                return VERSION_LEARNER_POLICY.NewLearnersOnly;
                            }
                        },
                        {
                            text: 'Move Not Started',
                            type: 'default',
                            onClick: function() {
                                return VERSION_LEARNER_POLICY.MoveNotStarted;
                            }
                        },
                        {
                            text: 'Reset In Progress',
                            type: 'danger',
                            onClick: function() {
                                return VERSION_LEARNER_POLICY.ResetInProgress;
                            }
                        },
                        {
                            text: 'Cancel',
                            onClick: function() {
                                return null;
                            }
                        }
                    ]
                });

                return dialog.show();
            }

            async function ensureVersionReadyForActivation(versionId) {
                const readiness = await tryGetVersionReadiness(versionId);
                if (!readiness) {
                    return true;
                }

                if (readiness.isReady) {
                    return true;
                }

                await showVersionReadinessDialog(versionId, readiness);
                return false;
            }

            async function tryGetVersionReadiness(versionId, forceRefresh) {
                try {
                    return await getVersionReadiness(versionId, forceRefresh);
                } catch (xhr) {
                    if (xhr?.status === 404) {
                        return null;
                    }

                    throw xhr;
                }
            }

            async function getVersionReadiness(versionId, forceRefresh) {
                const cacheKey = String(versionId);
                if (!forceRefresh && versionReadinessCache.has(cacheKey)) {
                    return versionReadinessCache.get(cacheKey);
                }

                const response = await $.ajax({
                    url: `${courseApiUrl}/versions/${versionId}/readiness`,
                    type: 'GET',
                    xhrFields: { withCredentials: true }
                });

                const readiness = response.data || response || {
                    versionId: versionId,
                    isReady: true,
                    resourceCount: 0,
                    issues: []
                };

                versionReadinessCache.set(cacheKey, readiness);
                return readiness;
            }

            function showVersionReadinessDialog(versionId, readiness) {
                const issues = Array.isArray(readiness?.issues) ? readiness.issues : [];
                const issueItems = issues.length
                    ? issues.map(function(issue) {
                        const resourceName = window.escapeHtml(issue.resourceName || 'Unnamed resource');
                        const reason = window.escapeHtml(issue.reason || 'Not ready');
                        return `<li><strong>${resourceName}</strong> <span class="text-secondary">${reason}</span></li>`;
                    }).join('')
                    : '<li><span class="text-secondary">This version has no published learning resources yet.</span></li>';

                const messageHtml = `
                    <div class="text-start">
                        <div class="u-fs-12 text-secondary mb-2">This version still could not be activated after automatic preparation. Fix the listed resource issues first.</div>
                        <div class="tag-pill pill-warning mb-3">${window.escapeHtml(window.formatAdminCountLabel(issues.length || readiness.resourceCount || 0, 'issue'))}</div>
                        <ul class="ps-3 mb-3 u-fs-11">${issueItems}</ul>
                        <div class="u-fs-11 text-secondary">Open the version editor to replace the affected resources, or repair the stored SCORM package and try again.</div>
                    </div>`;

                const dialog = DevExpress.ui.dialog.custom({
                    title: 'Version Not Ready',
                    messageHtml,
                    buttons: [
                        {
                            text: 'Open Version',
                            type: 'default',
                            onClick: function() {
                                window.location.href = `${newVersionUrl}?id=${versionId}&courseId=${courseId}`;
                                return true;
                            }
                        },
                        {
                            text: 'Close',
                            onClick: function() {
                                return false;
                            }
                        }
                    ]
                });

                return dialog.show();
            }

            window.deleteVersion = function(versionId) {
                DevExpress.ui.dialog.confirm('Delete this version? This cannot be undone.', 'Confirm Delete').done(async function(ok) {
                    if (!ok) {
                        return;
                    }

                    try {
                        await $.ajax({
                            url: `${courseApiUrl}/versions/${versionId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true }
                        });

                        showToast('Version deleted.', 'success', 2000);
                        await reloadVersions();
                    } catch (xhr) {
                        showToast(window.getApiErrorMessage(xhr, 'Error deleting version.'), 'error');
                    }
                });
            };

            async function loadLookupOptions(store) {
                try {
                    const result = await store.load();
                    return Array.isArray(result) ? result : [];
                } catch {
                    return [];
                }
            }

            async function syncCategoryEditor(formInstance, divisionId) {
                const categoryEditor = formInstance.getEditor('categoryId');
                if (!categoryEditor) {
                    return;
                }

                if (!divisionId) {
                    categoryEditor.option('disabled', true);
                    categoryEditor.option('value', null);
                    return;
                }

                categoryEditor.option('disabled', false);

                const categoryDataSource = categoryEditor.getDataSource();
                categoryDataSource.filter(['divisionId', '=', divisionId]);
                await categoryDataSource.load();

                const currentValue = categoryEditor.option('value');
                if (!currentValue) {
                    return;
                }

                const exists = categoryDataSource.items().some(function(item) {
                    return item.id === currentValue;
                });

                if (!exists) {
                    categoryEditor.option('value', null);
                }
            }

            async function resolveDivisionId(courseData) {
                if (courseData.divisionId || !courseData.categoryId) {
                    return courseData.divisionId || null;
                }

                try {
                    const categoryData = await $.ajax({
                        url: `${serviceUrl}/admin/CategoriesCRUD/Get/${courseData.categoryId}`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    return categoryData.divisionId || null;
                } catch {
                    return null;
                }
            }

            async function loadDashboardData() {
                try {
                    const response = await $.ajax({
                        url: `${courseApiUrl}/${courseId}/dashboard`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    const dashboardData = response.data || {};
                    const courseData = dashboardData.course || {};
                    const versions = dashboardData.versions || [];
                    dashboardKpi = {
                        versionCount: dashboardData.kpi?.versionCount ?? versions.length,
                        assignmentCount: dashboardData.kpi?.assignmentCount ?? 0,
                        learnerCount: dashboardData.kpi?.learnerCount ?? 0,
                        completedCount: dashboardData.kpi?.completedCount ?? 0
                    };
                    const divisionId = await resolveDivisionId(courseData);

                    currentCourseData = {
                        divisionId: divisionId,
                        courseCode: courseData.courseCode,
                        courseName: courseData.courseName,
                        description: courseData.description,
                        categoryId: courseData.categoryId,
                        courseType: courseData.courseType,
                        isActive: courseData.isActive
                    };

                    isCourseActive = courseData.isActive;
                    updateCourseHeader(courseData.courseName, courseData.courseCode);
                    updateStatusUI(isCourseActive);
                    renderCourseSummary(currentCourseData, dashboardKpi, versions);
                    renderVersionsGrid(versions);
                } catch (xhr) {
                    showToast(`Error loading course: ${window.getApiErrorMessage(xhr, 'Unknown error')}`, 'error');
                    console.log(xhr);
                }
            }

            function renderCourseSummary(courseData, kpi, versions) {
                const activeVersion = (versions || []).find(function(version) {
                    return version.isActive;
                }) || null;

                $("#summary-course-name").text(courseData.courseName || EMPTY_TEXT);
                $("#summary-course-code").text(courseData.courseCode || EMPTY_TEXT);
                $("#summary-division").text(getLookupText(divisionOptions, courseData.divisionId) || EMPTY_TEXT);
                $("#summary-category").text(getLookupText(categoryOptions, courseData.categoryId) || EMPTY_TEXT);
                $("#summary-course-type").text(getLookupText(courseTypeOptions, courseData.courseType) || EMPTY_TEXT);
                $("#summary-description").text(courseData.description || 'No description');
                $("#summary-active-version").html(
                    activeVersion
                        ? `<span class="tag-pill pill-success">Version ${activeVersion.versionNumber}</span>`
                        : '<span class="tag-pill pill-default">No active version</span>'
                );
                $("#summary-resource-count").text(window.formatAdminCountLabel((activeVersion?.resources || []).length, 'resource'));

                $("#stat-version-count").text(kpi.versionCount ?? (versions || []).length);
                $("#stat-assignment-count").text(kpi.assignmentCount ?? 0);
                $("#stat-learner-count").text(kpi.learnerCount ?? 0);
                $("#stat-completed-count").text(kpi.completedCount ?? 0);
            }

            function getLookupText(options, value) {
                if (!value) {
                    return '';
                }

                const match = (options || []).find(function(item) {
                    return item.id === value;
                });

                return match ? match.name : '';
            }

            function getCourseEditFormData() {
                return {
                    divisionId: currentCourseData?.divisionId || null,
                    categoryId: currentCourseData?.categoryId || null,
                    courseCode: currentCourseData?.courseCode || '',
                    courseName: currentCourseData?.courseName || '',
                    description: currentCourseData?.description || '',
                    courseType: currentCourseData?.courseType || null
                };
            }

            function openEditCourseDialog() {
                if (!currentCourseData) {
                    showToast('Course details are still loading.', 'warning', 2500);
                    return;
                }

                const dialogId = `edit-course-dialog-${Date.now()}`;
                const formId = `${dialogId}-form`;
                const cancelId = `${dialogId}-cancel`;
                const saveId = `${dialogId}-save`;

                const dialog = DevExpress.ui.dialog.custom({
                    title: 'Edit Course',
                    messageHtml: `
                        <div id="${dialogId}" class="pt-2 text-start">
                            <div id="${formId}"></div>
                            <div class="d-flex gap-2 justify-content-end mt-3">
                                <div id="${cancelId}"></div>
                                <div id="${saveId}"></div>
                            </div>
                        </div>`,
                    buttons: [],
                    dragEnabled: false,
                    closeOnOutsideClick: false,
                    showCloseButton: true,
                    width: 640
                });

                dialog.show();

                window.setTimeout(async function() {
                    const $formHost = $("#" + formId);
                    if (!$formHost.length) {
                        return;
                    }

                    let editForm;
                    editForm = $formHost.dxForm({
                        formData: getCourseEditFormData(),
                        labelLocation: 'top',
                        colCount: 1,
                        items: [
                            {
                                itemType: 'group',
                                colCount: 2,
                                items: [
                                    {
                                        dataField: 'divisionId',
                                        label: { text: 'Division' },
                                        editorType: 'dxSelectBox',
                                        editorOptions: {
                                            dataSource: divisionOptions,
                                            displayExpr: 'name',
                                            valueExpr: 'id',
                                            searchEnabled: true,
                                            showClearButton: true,
                                            placeholder: 'Select Division',
                                            onValueChanged: async function(e) {
                                                if (e.event) {
                                                    editForm.getEditor('categoryId').option('value', null);
                                                }

                                                await syncCategoryEditor(editForm, e.value);
                                            }
                                        }
                                    },
                                    {
                                        dataField: 'categoryId',
                                        label: { text: 'Category' },
                                        editorType: 'dxSelectBox',
                                        editorOptions: {
                                            dataSource: categoriesStore,
                                            displayExpr: 'name',
                                            valueExpr: 'id',
                                            searchEnabled: true,
                                            disabled: true,
                                            placeholder: 'Select Category'
                                        },
                                        validationRules: [{ type: 'required', message: 'Category is required' }]
                                    }
                                ]
                            },
                            {
                                itemType: 'group',
                                colCount: 2,
                                items: [
                                    {
                                        dataField: 'courseCode',
                                        label: { text: 'Course Code' },
                                        validationRules: [{ type: 'required', message: 'Course Code is required' }],
                                        editorOptions: { placeholder: 'e.g. CS-101' }
                                    },
                                    {
                                        dataField: 'courseType',
                                        label: { text: 'Course Type' },
                                        editorType: 'dxSelectBox',
                                        editorOptions: {
                                            dataSource: courseTypeOptions,
                                            displayExpr: 'name',
                                            valueExpr: 'id',
                                            placeholder: 'Select Type'
                                        }
                                    }
                                ]
                            },
                            {
                                dataField: 'courseName',
                                label: { text: 'Course Name' },
                                validationRules: [{ type: 'required', message: 'Course Name is required' }],
                                editorOptions: { placeholder: 'e.g. Introduction to Cybersecurity' }
                            },
                            {
                                dataField: 'description',
                                label: { text: 'Description' },
                                editorType: 'dxTextArea',
                                editorOptions: { height: 110, placeholder: 'Course summary and objectives...' }
                            }
                        ]
                    }).dxForm('instance');

                    await syncCategoryEditor(editForm, currentCourseData.divisionId);

                    const cancelButton = $("#" + cancelId).dxButton({
                        text: 'Cancel',
                        stylingMode: 'outlined',
                        onClick: function() {
                            dialog.hide();
                        }
                    }).dxButton('instance');

                    const saveButton = $("#" + saveId).dxButton({
                        text: 'Save Changes',
                        type: 'default',
                        stylingMode: 'contained',
                        onClick: async function() {
                            if (!editForm.validate().isValid) {
                                showToast('Please fill in all required fields.', 'warning', 2000);
                                return;
                            }

                            const formData = editForm.option('formData');
                            setDialogSaveButtonState(saveButton, true);
                            cancelButton.option('disabled', true);

                            try {
                                await $.ajax({
                                    url: `${courseApiUrl}/${courseId}`,
                                    type: 'PUT',
                                    contentType: 'application/json',
                                    xhrFields: { withCredentials: true },
                                    data: JSON.stringify({
                                        courseCode: formData.courseCode,
                                        courseName: formData.courseName,
                                        description: formData.description,
                                        categoryId: formData.categoryId,
                                        courseType: formData.courseType
                                    })
                                });

                                currentCourseData = {
                                    ...currentCourseData,
                                    ...formData
                                };
                                updateCourseHeader(formData.courseName, formData.courseCode);
                                renderCourseSummary(currentCourseData, dashboardKpi, versionsData);
                                dialog.hide();
                                showToast('Course updated successfully.', 'success', 2000);
                            } catch (xhr) {
                                setDialogSaveButtonState(saveButton, false);
                                cancelButton.option('disabled', false);
                                showToast(window.getApiErrorMessage(xhr, 'Error updating course.'), 'error');
                            }
                        }
                    }).dxButton('instance');
                }, 0);
            }

            function updateCourseHeader(courseName, courseCode) {
                $("#pageTitle").text(courseName || 'Course Detail');
                $("#pageSubtitle").text(courseCode ? `Code: ${courseCode}` : 'Course information and versions');
            }

            function updateVersionsCountBadge(count) {
                $("#versionsCountBadge").text(window.formatAdminCountLabel(count, 'version'));
            }

            function setActionLinkState($element, disabled, extraClasses) {
                $element.toggleClass('disabled', disabled)
                    .css({ opacity: disabled ? 0.4 : 1, pointerEvents: disabled ? 'none' : '' });

                if (extraClasses) {
                    $element.toggleClass(extraClasses, disabled);
                }
            }

            function setDialogSaveButtonState(button, isLoading) {
                if (!button) {
                    return;
                }

                button.option({
                    disabled: isLoading,
                    text: isLoading ? 'Saving...' : 'Save Changes',
                    icon: isLoading ? 'refresh' : undefined
                });
            }

            function formatDate(value) {
                return window.formatAdminDate(value, EMPTY_TEXT);
            }

            function renderVersionResourcesCell(container, resources) {
                const items = Array.isArray(resources) ? resources : [];

                if (!items.length) {
                    $("<span>")
                        .addClass('text-muted u-fs-11')
                        .text('No files attached')
                        .appendTo(container);
                    return;
                }

                const $stack = $("<div>").addClass('d-flex flex-column gap-1 version-resource-stack');

                items.slice(0, 2).forEach(function(resource, index) {
                    const $row = $("<div>").addClass('d-flex align-items-center gap-2 version-resource-line');
                    const typeTone = resource.typeId === 1 ? 'pill-primary' : 'pill-warning';
                    const typeName = resource.typeName || (resource.typeId === 1 ? 'Learn' : 'Exam');
                    const readinessTone = resource.isActive ? 'pill-success' : 'pill-danger';
                    const readinessLabel = resource.isActive ? 'Published' : 'Not Ready';

                    $("<span>")
                        .addClass('u-fs-11 text-secondary')
                        .text(`${index + 1}.`)
                        .appendTo($row);

                    $("<span>")
                        .addClass('text-truncate flex-grow-1 u-fs-11')
                        .attr('title', resource.name || 'Unnamed resource')
                        .text(resource.name || 'Unnamed resource')
                        .appendTo($row);

                    $("<span>")
                        .addClass(`tag-pill tag-pill-xs ${typeTone}`)
                        .text(typeName)
                        .appendTo($row);

                    $("<span>")
                        .addClass(`tag-pill tag-pill-xs ${readinessTone}`)
                        .text(readinessLabel)
                        .appendTo($row);

                    if (resource.isActive) {
                        $("<button>")
                            .attr({ type: 'button', title: 'Preview' })
                            .addClass('version-resource-preview-btn')
                            .append($('<i>').addClass('fas fa-external-link-alt'))
                            .on('click', function() {
                                window.viewContent(resource.id, resource.name || '');
                            })
                            .appendTo($row);
                    }

                    $row.appendTo($stack);
                });

                if (items.length > 2) {
                    $("<div>")
                        .addClass('version-resource-more')
                        .text(`+${items.length - 2} more`)
                        .appendTo($stack);
                }

                $stack.appendTo(container);
            }

            async function reloadVersions() {
                try {
                    const response = await $.ajax({
                        url: `${courseApiUrl}/${courseId}/versions`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    renderVersionsGrid(response.data || []);
                    dashboardKpi.versionCount = (response.data || []).length;
                    renderCourseSummary(currentCourseData || {}, dashboardKpi, response.data || []);
                } catch {
                    showToast('Error loading versions.', 'error');
                }
            }

        });
    </script>
}