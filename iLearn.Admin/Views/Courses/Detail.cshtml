@{
    ViewBag.Title = "Course Detail";
    int courseId = ViewBag.CourseId;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title" id="pageTitle">Course Detail</div>
        <div class="page-subtitle" id="pageSubtitle">Loading...</div>
    </div>
    <a href="@Url.Action("Index", "Courses")" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

<div class="container-fluid page-shell-lg px-4 py-4">

    <div class="row g-3 mb-4">

        <div class="col-lg-8">
            <div class="border rounded bg-white h-100 d-flex flex-column">
                <div class="p-3">
                    <div class="admin-section-header">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Course Information</div>
                            <span id="courseStatusBadge" class="tag-pill pill-default admin-section-status">
                                <i class="fas fa-circle-notch fa-spin me-1"></i> Loading...
                            </span>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>
                </div>
                <div class="px-3 pb-3 d-flex flex-column flex-grow-1">
                    <div id="courseInfoForm"></div>
                    <div class="text-end mt-3 pt-3 u-border-top">
                        <a href="javascript:void(0);" id="btnSaveCourse" class="action-link primary">
                            <i class="fas fa-save"></i> Save Changes
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btnNewVersion" class="quick-action">
                        <div class="qa-icon qa-icon-accent">
                            <i class="fas fa-code-branch"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">New Version</div>
                            <div class="u-fs-11 text-secondary">Create a new content version</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnAssignment" class="quick-action">
                        <div class="qa-icon qa-icon-accent">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Assignments</div>
                            <div class="u-fs-11 text-secondary">Assign course to employees</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnTogglePublish" class="quick-action">
                        <div class="qa-icon qa-icon-muted" id="publishIconBox">
                            <i id="publishIcon" class="fas fa-globe"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark" id="publishBtnText">Publish Course</div>
                            <div class="u-fs-11 text-secondary" id="publishBtnDesc">Make course available</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btnDeleteCourse" class="quick-action danger">
                        <div class="qa-icon qa-icon-danger">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Delete Course</div>
                            <div class="u-fs-11 text-secondary">Remove permanently</div>
                        </div>
                    </a>

                </div>

                <div id="warningMsg" class="mt-3 pt-3 d-none u-border-top u-fs-11 u-text-warning">
                    <i class="fas fa-exclamation-triangle me-1"></i> Cannot delete an active course.
                </div>
            </div>
        </div>

    </div>

    <div class="border rounded bg-white p-3">
        <div class="admin-section-header mb-3">
            <div class="admin-section-header-main">
                <div class="section-title mb-0 admin-section-title-fill">Course Versions</div>
                <span class="tag-pill pill-default admin-section-meta" id="versionsCountBadge">0 Versions</span>
            </div>
            <div class="admin-section-divider"></div>
        </div>
        <div id="versionsToolbar" class="mb-3"></div>
        <div id="versionsCardContainer" class="row g-3"></div>
    </div>

</div>

@section Scripts {
    <script>
        const courseId = @courseId;
        const courseApiUrl = `${serviceUrl}/courses`;
        const courseIndexUrl = '@Url.Action("Index", "Courses")';
        const newVersionUrl = '@Url.Action("VersionForm", "Courses")';
        const assignmentFormUrl = '@Url.Action("Form", "Assignments")';

        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'Courses', {
            key: 'id',
            loadUrl: `${serviceUrl}/Courses/course-types-lookup`
        });

        let isCourseActive = false;
        let courseForm;
        let versionsData = [];

        $(async () => {
            const [divisionOptions, courseTypeOptions] = await Promise.all([
                loadLookupOptions(divisionsStore),
                loadLookupOptions(courseTypesStore)
            ]);

            showCardsSkeleton('#versionsCardContainer', 3);

            courseForm = $("#courseInfoForm").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 1,
                items: [
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionOptions,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: async function(e) {
                                        if (e.event) {
                                            getCategoryEditor().option("value", null);
                                        }

                                        await syncCategoryEditor(e.value);
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    disabled: true,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypeOptions,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                }
                            }
                        ]
                    },
                    {
                        dataField: "courseName",
                        label: { text: "Course Name" },
                        validationRules: [{ type: "required", message: "Course Name is required" }],
                        editorOptions: { placeholder: "e.g. Introduction to Cybersecurity" }
                    },
                    {
                        dataField: "description",
                        label: { text: "Description" },
                        editorType: "dxTextArea",
                        editorOptions: { height: 90, placeholder: "Course summary and objectives..." }
                    }
                ]
            }).dxForm("instance");

            await loadDashboardData();

            $("#btnSaveCourse").on("click", async function() {
                if (!courseForm.validate().isValid) {
                    showToast("Please fill in all required fields.", "warning", 2000);
                    return;
                }

                const formData = courseForm.option("formData");
                const $button = $(this);

                setSaveButtonLoading($button, true);

                try {
                    await $.ajax({
                        url: `${courseApiUrl}/${courseId}`,
                        type: 'PUT',
                        contentType: 'application/json',
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({
                            courseCode: formData.courseCode,
                            courseName: formData.courseName,
                            description: formData.description,
                            categoryId: formData.categoryId,
                            courseType: formData.courseType
                        })
                    });

                    updateCourseHeader(formData.courseName, formData.courseCode);
                    showToast("Course updated successfully.", "success", 2000);
                } catch (xhr) {
                    showToast(getApiErrorMessage(xhr, "Error updating course."), "error");
                } finally {
                    setSaveButtonLoading($button, false);
                }
            });

            function updateStatusUI(isActive) {
                const $publishIcon = $("#publishIcon");
                const $publishIconBox = $("#publishIconBox");
                const $publishBtnText = $("#publishBtnText");
                const $publishBtnDesc = $("#publishBtnDesc");
                const $btnDelete = $("#btnDeleteCourse");
                const $btnAssignment = $("#btnAssignment");
                const $statusBadge = $("#courseStatusBadge");
                const $warnMsg = $("#warningMsg");

                if (isActive) {
                    $publishIcon.removeClass("fa-globe").addClass("fa-lock");
                    $publishIconBox.removeClass("qa-icon-muted").addClass("qa-icon-warning");
                    $publishBtnText.text("Close Course");
                    $publishBtnDesc.text("Deactivate — stop new learners");
                    $statusBadge.removeClass("pill-default pill-warning pill-danger pill-info")
                                .addClass("pill-success")
                                .html('<i class="fas fa-check-circle me-1"></i> Active');
                    setActionLinkState($btnDelete, true);
                    setActionLinkState($btnAssignment, false);
                    $warnMsg.removeClass("d-none");
                } else {
                    $publishIcon.removeClass("fa-lock").addClass("fa-globe");
                    $publishIconBox.removeClass("qa-icon-warning").addClass("qa-icon-muted");
                    $publishBtnText.text("Publish Course");
                    $publishBtnDesc.text("Make course available");
                    $statusBadge.removeClass("pill-success pill-warning pill-danger pill-info")
                                .addClass("pill-default")
                                .html('<i class="fas fa-lock me-1"></i> Closed');
                    setActionLinkState($btnDelete, false);
                    setActionLinkState($btnAssignment, true);
                    $warnMsg.addClass("d-none");
                }
            }

            $("#btnTogglePublish").on("click", function(e) {
                e.preventDefault();
                const $btn = $(this);

                if ($btn.hasClass("disabled")) {
                    return;
                }

                setActionLinkState($btn, true, "opacity-50 pe-none");

                const newState = !isCourseActive;
                const confirmMsg = newState ? "Publish this course?" : "Close this course?";

                DevExpress.ui.dialog.confirm(confirmMsg, "Confirm Status Change").done(async function(ok) {
                    if (!ok) {
                        setActionLinkState($btn, false, "opacity-50 pe-none");
                        return;
                    }

                    try {
                        const response = await $.ajax({
                            url: `${courseApiUrl}/${courseId}/status`,
                            type: 'PUT',
                            contentType: 'application/json',
                            xhrFields: { withCredentials: true },
                            data: JSON.stringify({ isActive: newState })
                        });

                        isCourseActive = newState;
                        updateStatusUI(isCourseActive);

                        const successMessage = response.message || (newState ? "Course published!" : "Course closed.");
                        showToast(successMessage, "success", 2000);
                    } catch (xhr) {
                        showToast(getApiErrorMessage(xhr, "Error updating status."), "error", 4000);
                    } finally {
                        setActionLinkState($btn, false, "opacity-50 pe-none");
                    }
                });
            });

            $("#btnDeleteCourse").on("click", function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    return;
                }

                DevExpress.ui.dialog.confirm("Delete this course permanently? This cannot be undone.", "Confirm Delete").done(async function(ok) {
                    if (!ok) {
                        return;
                    }

                    try {
                        await $.ajax({
                            url: `${courseApiUrl}/${courseId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true }
                        });

                        showToast("Course deleted.", "success", 2000);
                        setTimeout(() => {
                            window.location.href = courseIndexUrl;
                        }, 1500);
                    } catch (xhr) {
                        showToast(getApiErrorMessage(xhr, "Error deleting course."), "error");
                    }
                });
            });

            function goNewVersion() {
                window.location.href = `${newVersionUrl}?courseId=${courseId}`;
            }

            $("#btnNewVersion").on("click", function(e) {
                e.preventDefault();
                goNewVersion();
            });

            $("#btnAssignment").on("click", function(e) {
                e.preventDefault();
                if ($(this).hasClass("disabled")) {
                    showToast("Please publish the course before managing assignments.", "warning", 2500);
                    return;
                }
                window.location.href = `${assignmentFormUrl}?courseId=${courseId}`;
            });

            function renderVersionCards(versions) {
                versionsData = versions || [];
                updateVersionsCountBadge(versionsData.length);

                if (!$("#versionsToolbar").hasClass("dx-toolbar")) {
                    $("#versionsToolbar").dxToolbar({
                        items: [
                            {
                                location: "before",
                                widget: "dxTextBox",
                                options: {
                                    placeholder: "Search versions...",
                                    width: 250,
                                    mode: "search",
                                    valueChangeEvent: "keyup",
                                    onValueChanged: function(e) {
                                        drawCards(e.value);
                                    }
                                }
                            },
                            {
                                location: "after",
                                widget: "dxButton",
                                options: {
                                    icon: "plus",
                                    text: "New Version",
                                    type: "default",
                                    stylingMode: "text",
                                    onClick: goNewVersion
                                }
                            }
                        ]
                    });
                }

                drawCards("");
            }

            function drawCards(searchText) {
                const $container = $("#versionsCardContainer");
                $container.empty();

                const filteredVersions = versionsData.filter(version => matchesVersionSearch(version, searchText));
                updateVersionsCountBadge(filteredVersions.length);

                if (filteredVersions.length === 0) {
                    $container.html('<div class="col-12 text-center text-secondary py-4">No versions found.</div>');
                    return;
                }

                filteredVersions.forEach(version => {
                    $container.append(buildVersionCardHtml(version));
                });

                setTimeout(() => {
                    $container.find('[data-bs-toggle="dropdown"]').each(function() {
                        new bootstrap.Dropdown(this);
                    });
                }, 0);
            }

            window.viewContent = async function(resourceId, resourceName) {
                const apiUrl = `${serviceUrl}/Resources/${resourceId}/content`;
                if (!resourceName.toLowerCase().endsWith('.zip')) {
                    window.open(apiUrl, '_blank');
                    return;
                }

                const previewWindow = window.open('about:blank', '_blank');
                if (previewWindow) {
                    previewWindow.document.title = 'Loading...';
                    previewWindow.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content...</div>";
                }

                try {
                    const response = await $.ajax({
                        url: apiUrl,
                        method: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    if (response?.url && previewWindow) {
                        previewWindow.location.href = response.url;
                        return;
                    }

                    if (previewWindow) {
                        previewWindow.close();
                    }

                    showToast('Content URL not found.', 'error');
                } catch {
                    if (previewWindow) {
                        previewWindow.close();
                    }

                    showToast('Failed to get content link.', 'error');
                }
            };

            window.setActiveVersion = async function(versionId) {
                try {
                    await $.ajax({
                        url: `${courseApiUrl}/${courseId}/versions/${versionId}/set-active`,
                        type: 'PATCH',
                        xhrFields: { withCredentials: true }
                    });

                    showToast('Active version updated.', 'success', 2000);
                    await reloadVersions();
                } catch (xhr) {
                    showToast(getApiErrorMessage(xhr, 'Error updating active version.'), 'error');
                }
            };

            window.deleteVersion = function(versionId) {
                DevExpress.ui.dialog.confirm('Delete this version? This cannot be undone.', 'Confirm Delete').done(async function(ok) {
                    if (!ok) {
                        return;
                    }

                    try {
                        await $.ajax({
                            url: `${courseApiUrl}/versions/${versionId}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true }
                        });

                        showToast('Version deleted.', 'success', 2000);
                        await reloadVersions();
                    } catch (xhr) {
                        showToast(getApiErrorMessage(xhr, 'Error deleting version.'), 'error');
                    }
                });
            };

            async function loadLookupOptions(store) {
                try {
                    const result = await store.load();
                    return Array.isArray(result) ? result : [];
                } catch {
                    return [];
                }
            }

            function getCategoryEditor() {
                return courseForm.getEditor('categoryId');
            }

            async function syncCategoryEditor(divisionId) {
                const categoryEditor = getCategoryEditor();
                if (!divisionId) {
                    categoryEditor.option('disabled', true);
                    categoryEditor.option('value', null);
                    return;
                }

                categoryEditor.option('disabled', false);

                const categoryDataSource = categoryEditor.getDataSource();
                categoryDataSource.filter(['divisionId', '=', divisionId]);
                await categoryDataSource.load();

                const currentValue = categoryEditor.option('value');
                if (!currentValue) {
                    return;
                }

                const exists = categoryDataSource.items().some(function(item) {
                    return item.id === currentValue;
                });

                if (!exists) {
                    categoryEditor.option('value', null);
                }
            }

            async function resolveDivisionId(courseData) {
                if (courseData.divisionId || !courseData.categoryId) {
                    return courseData.divisionId || null;
                }

                try {
                    const categoryData = await $.ajax({
                        url: `${serviceUrl}/admin/CategoriesCRUD/Get/${courseData.categoryId}`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    return categoryData.divisionId || null;
                } catch {
                    return null;
                }
            }

            async function loadDashboardData() {
                try {
                    const response = await $.ajax({
                        url: `${courseApiUrl}/${courseId}/dashboard`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    const dashboardData = response.data || {};
                    const courseData = dashboardData.course || {};
                    const versions = dashboardData.versions || [];
                    const divisionId = await resolveDivisionId(courseData);

                    await syncCategoryEditor(divisionId);

                    courseForm.option('formData', {
                        divisionId: divisionId,
                        courseCode: courseData.courseCode,
                        courseName: courseData.courseName,
                        description: courseData.description,
                        categoryId: courseData.categoryId,
                        courseType: courseData.courseType
                    });

                    isCourseActive = courseData.isActive;
                    updateCourseHeader(courseData.courseName, courseData.courseCode);
                    updateStatusUI(isCourseActive);
                    renderVersionCards(versions);
                } catch (xhr) {
                    $("#versionsCardContainer").html('<div class="col-12 text-center text-danger py-4">Error loading versions.</div>');
                    showToast(`Error loading course: ${getApiErrorMessage(xhr, 'Unknown error')}`, 'error');
                    console.log(xhr);
                }
            }

            function updateCourseHeader(courseName, courseCode) {
                $("#pageTitle").text(courseName || 'Course Detail');
                $("#pageSubtitle").text(courseCode ? `Code: ${courseCode}` : 'Course information and versions');
            }

            function updateVersionsCountBadge(count) {
                $("#versionsCountBadge").text(window.formatAdminCountLabel(count, 'version'));
            }

            function getApiErrorMessage(xhr, fallbackMessage) {
                return xhr?.responseJSON?.message || xhr?.responseText || fallbackMessage;
            }

            function setActionLinkState($element, disabled, extraClasses) {
                $element.toggleClass('disabled', disabled)
                    .css({ opacity: disabled ? 0.4 : 1, pointerEvents: disabled ? 'none' : '' });

                if (extraClasses) {
                    $element.toggleClass(extraClasses, disabled);
                }
            }

            function setSaveButtonLoading($button, isLoading) {
                $button.css('opacity', isLoading ? 0.6 : 1)
                    .html(isLoading
                        ? '<i class="fas fa-spinner fa-spin"></i> Saving...'
                        : '<i class="fas fa-save"></i> Save Changes');
            }

            function appendText(container, text, styles) {
                return $("<span>").css(styles || {}).text(text).appendTo(container);
            }

            function formatDate(value) {
                return window.formatAdminDate(value, '—');
            }

            function truncateText(value, maxLength) {
                if (!value || value.length <= maxLength) {
                    return value || '—';
                }

                return `${value.slice(0, maxLength)}…`;
            }

            function renderProgressCell(container, value) {
                const progress = value || 0;
                const color = progress === 100
                    ? 'var(--success-color)'
                    : progress >= 50
                        ? 'var(--accent-color)'
                        : 'var(--warning-color)';

                $("<div>").addClass('d-flex align-items-center gap-2')
                    .append(
                        $("<div>").css({
                            flex: '1',
                            height: '3px',
                            background: 'var(--border-color)',
                            borderRadius: '2px',
                            overflow: 'hidden'
                        }).append(
                            $("<div>").css({
                                height: '100%',
                                width: `${progress}%`,
                                background: color
                            })
                        )
                    )
                    .append(
                        $("<span>").css({
                            fontSize: '11px',
                            fontWeight: '600',
                            minWidth: '32px',
                            color: 'var(--text-secondary)'
                        }).text(window.formatAdminPercentage(progress, '0%'))
                    )
                    .appendTo(container);
            }

            function renderStatusCell(container, value, map) {
                const status = map[value] || { cls: 'pill-default', text: value || '—' };
                $(`<span class="tag-pill ${status.cls}">${status.text}</span>`).appendTo(container);
            }

            function renderDueDateCell(container, value) {
                if (!value) {
                    appendText(container, '—', { fontSize: '11px', color: 'var(--text-secondary)' });
                    return;
                }

                const isPast = new Date(value) < new Date();
                appendText(container, formatDate(value), {
                    fontSize: '11px',
                    color: isPast ? 'var(--danger-color)' : 'var(--text-secondary)',
                    fontWeight: isPast ? '600' : '400'
                });
            }

            function escapeHtml(value) {
                return String(value || '').replace(/[&<>"']/g, function(char) {
                    return {
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#39;'
                    }[char];
                });
            }

            function escapeJsString(value) {
                return String(value || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
            }

            function matchesVersionSearch(version, searchText) {
                if (!searchText) {
                    return true;
                }

                const term = searchText.toLowerCase();
                return (version.note && version.note.toLowerCase().includes(term))
                    || (version.versionNumber && version.versionNumber.toString().includes(term));
            }

            function buildVersionActions(version) {
                const editHref = `${newVersionUrl}?id=${version.id}&courseId=${courseId}`;
                let actions = `<a class="dropdown-item py-2 d-flex align-items-center gap-2" href="${editHref}"><i class="fas fa-edit version-action-icon warning"></i><span class="u-fs-12">Edit</span></a>`;

                if (!version.isActive) {
                    actions += `<a class="dropdown-item py-2 d-flex align-items-center gap-2" href="javascript:void(0);" onclick="setActiveVersion(${version.id})"><i class="fas fa-check-circle version-action-icon accent"></i><span class="u-fs-12">Set Active</span></a>`;
                    actions += '<hr class="dropdown-divider my-1">';
                    actions += `<a class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger" href="javascript:void(0);" onclick="deleteVersion(${version.id})"><i class="fas fa-trash-alt version-action-icon"></i><span class="u-fs-12">Delete</span></a>`;
                }

                return actions;
            }

            function buildVersionResourcesHtml(resources) {
                if (!resources.length) {
                    return '<span class="version-resource-empty">No files attached</span>';
                }

                return resources.map(function(resource, index) {
                    const typeClass = resource.typeId === 1 ? 'pill-learn' : 'pill-exam';
                    const typeName = escapeHtml(resource.typeName || (resource.typeId === 1 ? 'Learn' : 'Exam'));
                    const resourceName = escapeHtml(resource.name || 'Unnamed resource');
                    const previewButton = resource.isActive
                        ? `<a href="javascript:void(0);" onclick="window.viewContent(${resource.id},'${escapeJsString(resource.name)}')" class="version-resource-preview" title="Preview"><i class="fas fa-external-link-alt"></i></a>`
                        : '';

                    return `
                        <div class="version-resource-item d-flex align-items-center gap-2 mb-1">
                            <span class="version-resource-index">${index + 1}</span>
                            <span class="version-resource-name text-truncate flex-grow-1" title="${resourceName}">${resourceName}</span>
                            <span class="tag-pill tag-pill-xs tag-pill-static ${typeClass}">${typeName}</span>
                            ${previewButton}
                        </div>`;
                }).join('');
            }

            function buildVersionCardHtml(version) {
                const isActive = version.isActive;
                const badge = isActive
                    ? '<span class="tag-pill tag-pill-xs pill-info"><i class="fas fa-check-circle me-1"></i>Active</span>'
                    : '<span class="tag-pill tag-pill-xs pill-default">Draft</span>';
                const noteHtml = version.note
                    ? escapeHtml(version.note)
                    : '<span class="version-card-empty-note">No description</span>';

                return `
                    <div class="col-md-4 mb-2">
                        <div class="version-card ${isActive ? 'active' : ''}">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="version-card-title"> ${badge} Version ${version.versionNumber}</div>
                                   
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm p-1 text-secondary version-card-menu" type="button" data-bs-toggle="dropdown"><i class="fas fa-ellipsis-v u-fs-11"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border py-1 version-card-dropdown">${buildVersionActions(version)}</ul>
                                </div>
                            </div>
                            <div class="version-card-note u-fs-11 text-secondary u-border-bottom">${noteHtml}</div>
                            <div class="cv-res">${buildVersionResourcesHtml(version.resources || [])}</div>
                        </div>
                    </div>`;
            }

            async function reloadVersions() {
                try {
                    const response = await $.ajax({
                        url: `${courseApiUrl}/${courseId}/versions`,
                        type: 'GET',
                        xhrFields: { withCredentials: true }
                    });

                    renderVersionCards(response.data || []);
                } catch {
                    $("#versionsCardContainer").html('<div class="col-12 text-center text-danger py-4">Error loading versions.</div>');
                }
            }

        });
    </script>
}