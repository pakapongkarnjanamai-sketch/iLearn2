@{
    ViewBag.Title = ViewBag.Id == null ? "Create New Version" : "Edit Version";
    var isEdit = ViewBag.Id != null;
    var courseId = ViewBag.CourseId;
    var detailUrl = Url.Action("Detail", "Courses", new { id = courseId });
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    .version-content-note {
        font-size: var(--font-size-caption);
        color: var(--text-secondary);
    }

    .version-review-table-wrap {
        --admin-table-wrap-max-height: clamp(220px, calc(100vh - 540px), 320px);
    }
</style>

<!-- ── Page Header ── -->
<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-code-branch text-primary me-2" aria-hidden="true"></i>@ViewBag.Title</h1>
    <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
        <div class="admin-step-card active" data-step-card="1" aria-current="step">
            <div class="admin-step-title"><span class="admin-step-index">1</span>Details</div>
        </div>
        <div class="admin-step-card" data-step-card="2">
            <div class="admin-step-title"><span class="admin-step-index">2</span>Content</div>
        </div>
        <div class="admin-step-card" data-step-card="3">
            <div class="admin-step-title"><span class="admin-step-index">3</span>Review</div>
        </div>
    </div>
    <div class="admin-page-header-actions">
        <a href="@detailUrl" class="action-link">
            <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
        </a>
        <button type="button" id="btn-previous-step" class="action-link d-none">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
        </button>
        <button type="button" id="btn-next-step" class="action-link primary">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
        </button>
        <button type="button" id="btn-submit-version" class="action-link primary d-none">
            <i class="fas fa-save" aria-hidden="true"></i> @(isEdit ? "Save Changes" : "Create Version")
        </button>
    </div>
</div>

<div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow">
    <div id="load-panel"></div>

    <div class="admin-review-main-col">
        <div class="border rounded bg-white p-3">
            <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="form">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Version Details</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>
                <div class="admin-detail-card">
                    <div id="form-container"></div>
                </div>
            </div>

            <div id="step-panel-2" class="admin-wizard-panel" data-step-layout="wide">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Version Content</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-detail-card">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing" role="button" tabindex="0">
                                <i class="fas fa-search fa-lg target-card-icon"></i>
                                <div class="fw-bold text-dark target-card-title">Select Existing Resources</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload" role="button" tabindex="0">
                                <i class="fas fa-cloud-upload-alt fa-lg target-card-icon"></i>
                                <div class="fw-bold text-dark target-card-title">Upload New SCORM</div>
                            </div>
                            <div id="file-uploader-container"></div>
                        </div>
                    </div>

                    <div class="version-content-note mb-3">You can drag and drop rows to reorder the content, and click on Type to change it for new files.</div>

                    <div class="admin-grid-shell overflow-hidden">
                        <div class="admin-grid-head">
                            <div class="admin-grid-title">Selected Content</div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="tag-pill pill-default" id="total-count-badge">0 items</span>
                            </div>
                        </div>
                        <div id="master-resources-grid"></div>
                    </div>
                </div>
            </div>

            <div id="step-panel-3" class="admin-wizard-panel" data-step-layout="review">
                <div class="admin-section-header admin-review-header">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Review And Confirm</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-review-stack">
                    <div class="admin-summary-grid">
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-total-resources">0</div>
                            <div class="admin-summary-label">Total Content Items</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-existing-resources">0</div>
                            <div class="admin-summary-label">Existing Resources</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-new-resources">0</div>
                            <div class="admin-summary-label">New Uploads</div>
                        </div>
                    </div>

                    <div class="admin-detail-card">
                        <div class="section-title mb-2">Version Details</div>
                        <div id="form-review-details"></div>
                    </div>

                    <div class="admin-table-shell">
                        <div class="admin-table-head">
                            <div class="admin-table-title">Content Review</div>
                        </div>
                        <div class="admin-table-wrap version-review-table-wrap" id="review-content-table"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="popup-existing"></div>

@section Scripts {
    <script>
        const COURSE_ID = Number('@courseId');
        const VERSION_ID = @(ViewBag.Id != null ? ViewBag.Id : "null");
        const IS_EDIT = VERSION_ID !== null;
        const COURSE_DETAIL_URL = '@Url.Action("Detail", "Courses")';
        const VERSION_CANCEL_URL = '@detailUrl';

        const VERSION_NOTE_HEIGHT = 90;
        const MASTER_RESOURCE_GRID_HEIGHT = 520;
        const EXISTING_RESOURCE_GRID_HEIGHT = 520;
        const TOTAL_WIZARD_STEPS = 3;

        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        let formWidget;
        let masterGrid;
        let gridExisting;
        let unifiedResources = [];
        let popupExisting;
        let loadPanel;
        let reviewForm;
        const createState = {
            currentStep: 1
        };

        $(async () => {
            loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            initializeVersionForm({ courseId: COURSE_ID, isActive: true });
            initializeMasterGrid();
            initializeExistingResourcesPopup();
            initializeFileUploader();
            initializeReviewForm();

            if (IS_EDIT) {
                await loadVersionData();
            }

            initializeCreateWizard();
            updateCreateWizardUi();

            refreshMasterGrid();
            updateVersionReview();
            renderVersionReview();
        });

        function initializeVersionForm(formData) {
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                onFieldDataChanged: function() {
                    updateVersionReview();
                    renderVersionReview();
                },
                items: [
                    {
                        dataField: "note",
                        editorType: "dxTextArea",
                        label: { text: "Version Name / Note" },
                        editorOptions: {
                            height: VERSION_NOTE_HEIGHT,
                            placeholder: "e.g. Added new V2 materials"
                        },
                        validationRules: [{ type: "required", message: "Version note is required" }]
                    },
                    {
                        dataField: "isActive",
                        editorType: "dxCheckBox",
                        label: { text: "Status", visible: false },
                        editorOptions: { text: "Set as Active Version" }
                    }
                ]
            }).dxForm("instance");
        }

        function initializeReviewForm() {
            reviewForm = $("#form-review-details").dxForm({
                readOnly: true,
                labelMode: "floating",
                stylingMode: "outlined",
                colCount: 2,
                formData: { note: "", status: "" },
                items: [
                    {
                        dataField: "note",
                        label: { text: "Version Note" },
                        colSpan: 2,
                        editorType: "dxTextArea",
                        editorOptions: { height: VERSION_NOTE_HEIGHT }
                    },
                    {
                        dataField: "status",
                        label: { text: "Status On Save" },
                        colSpan: 2
                    }
                ]
            }).dxForm("instance");
        }

        function initializeMasterGrid() {
            masterGrid = initDxGrid("#master-resources-grid", {
                dataSource: unifiedResources,
                keyExpr: "uid",
                height: MASTER_RESOURCE_GRID_HEIGHT,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: getNoDataText("content"),
                editing: {
                    mode: "cell",
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = unifiedResources.findIndex(function(item) {
                            return item.uid === visibleRows[e.toIndex].data.uid;
                        });
                        const fromIndex = unifiedResources.findIndex(function(item) {
                            return item.uid === e.itemData.uid;
                        });

                        unifiedResources.splice(fromIndex, 1);
                        unifiedResources.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                        refreshMasterGrid();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            window.renderAdminGridTextCell(container, options.rowIndex + 1, "captionMuted", { fontWeight: "700" });
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const iconClass = data.isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            if (data.isNew) {
                                window.renderAdminGridTextCell(wrapper, "New", "xsAccent", { marginLeft: "8px" });
                            }

                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Type (Click to edit)", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const typeName = getResourceTypeLabel(data.typeId);
                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const tooltip = data.isNew ? "Click to change type" : "Existing resource type cannot be changed here";

                            $('<div>').css(window.getAdminGridTextStyle(data.typeId === 1 ? 'captionAccent' : 'captionWarning', {
                                cursor: data.isNew ? 'pointer' : 'default'
                            }))
                                .attr("title", tooltip)
                                .html(`${typeName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                removeResource(e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            });
        }

        function initializeExistingResourcesPopup() {
            popupExisting = $("#popup-existing").dxPopup({
                title: "Select Existing Resources",
                width: "90vw",
                maxWidth: 1080,
                height: "auto",
                maxHeight: "90vh",
                disableGlobalHeightSizing: true,
                showCloseButton: true,
                dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    if (gridExisting) {
                        gridExisting.updateDimensions();
                    }
                },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='grid-existing-pick'>").appendTo(contentElement);
                    gridExisting = initDxGrid(gridContainer, {
                        preset: "selectionGrid",
                        dataSource: resourcesStore,
                        remoteOperations: true,
                        height: EXISTING_RESOURCE_GRID_HEIGHT,
                        searchPanel: { placeholder: "Search by name or type..." },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Resource Name", minWidth: 200,
                                cssClass: "fw-medium text-dark"
                            },
                            {
                                dataField: "typeId", caption: "Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearn = options.value === 1;
                                    const text = isLearn ? "Learn" : "Exam";
                                    window.renderAdminGridStatusCell(container, text, isLearn ? 'primary' : 'warning', { showDot: false });
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(data) {
                                    return (data.courseResources || []).length;
                                },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    window.renderAdminGridTextCell(container, count, count > 0 ? 'captionSuccess' : 'captionMuted');
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                format: ADMIN_DATETIME_DISPLAY_FORMAT,
                                cssClass: "cell-muted"
                            }
                        ]
                    });
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                addExistingResources(gridExisting.getSelectedRowsData());
                                refreshMasterGrid();
                                gridExisting.clearSelection();
                                popupExisting.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").on("click", function() {
                popupExisting.show();
            }).on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).click();
                }
            });
        }

        function initializeFileUploader() {
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false,
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                onValueChanged: function(e) {
                    if (!e.value || e.value.length === 0) {
                        return;
                    }

                    addNewFiles(e.value);
                    e.component.reset();
                    refreshMasterGrid();
                    showToast("File added to queue", "success", 2000);
                }
            });

            $("#btn-trigger-upload").on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).click();
                }
            });
        }

        function initializeCreateWizard() {
            $("#btn-previous-step").on("click", function() {
                if (createState.currentStep <= 1) {
                    return;
                }

                createState.currentStep -= 1;
                updateCreateWizardUi();
            });

            $("#btn-next-step").on("click", function() {
                handleNextStep();
            });

            $("#btn-submit-version").on("click", function() {
                submitData();
            });
        }

        function refreshMasterGrid() {
            masterGrid.option("dataSource", unifiedResources);
            $("#total-count-badge").text(window.formatAdminCountLabel(unifiedResources.length, 'item'));
            updateVersionReview();
            renderVersionReview();
        }

        function handleNextStep() {
            if (createState.currentStep === 1 && !validateVersionDetailsStep()) {
                return;
            }

            if (createState.currentStep === 2 && !validateVersionContentStep()) {
                return;
            }

            if (createState.currentStep < TOTAL_WIZARD_STEPS) {
                createState.currentStep += 1;
                updateCreateWizardUi();
            }
        }

        function updateCreateWizardUi() {
            $("[data-step-card]").each(function() {
                const step = Number($(this).data("stepCard"));
                $(this).toggleClass("active", step === createState.currentStep);
                $(this).toggleClass("complete", step < createState.currentStep);

                if (step === createState.currentStep) {
                    $(this).attr("aria-current", "step");
                } else {
                    $(this).removeAttr("aria-current");
                }
            });

            $(".admin-wizard-panel").removeClass("active");
            $(`#step-panel-${createState.currentStep}`).addClass("active");
            const layout = $(`#step-panel-${createState.currentStep}`).attr("data-step-layout") || "wide";
            $(".admin-wizard-shell")
                .toggleClass("is-form-step", layout === "form")
                .toggleClass("is-review-step", layout === "review");

            $("#btn-previous-step").toggleClass("d-none", createState.currentStep <= 1);
            $("#btn-next-step").toggleClass("d-none", createState.currentStep >= TOTAL_WIZARD_STEPS);
            $("#btn-submit-version").toggleClass("d-none", createState.currentStep !== TOTAL_WIZARD_STEPS);

            if (createState.currentStep === 2 && masterGrid) {
                masterGrid.updateDimensions();
            }

            if (createState.currentStep === 3) {
                updateVersionReview();
                renderVersionReview();
            }
        }

        function validateVersionDetailsStep() {
            const validation = formWidget.validate();
            if (!validation.isValid) {
                showToast("Please complete the required version details before continuing.", "warning", 2500);
                return false;
            }

            return true;
        }

        function validateVersionContentStep() {
            if (unifiedResources.length === 0) {
                showToast("Please add at least one resource before reviewing the version.", "warning", 3000);
                return false;
            }

            return true;
        }

        async function submitData() {
            if (!formWidget.validate().isValid) {
                showToast("Please fill in the required version details.", "warning", 2000);
                return;
            }

            if (unifiedResources.length === 0) {
                showToast("Please add at least one resource.", "error", 4000);
                return;
            }

            const submitButtonSelector = "#btn-submit-version";
            setButtonLoading(submitButtonSelector, true, IS_EDIT ? "Saving..." : "Creating...");
            loadPanel.option("message", "Saving version and processing files...");
            loadPanel.show();

            try {
                await $.ajax({
                    url: getSubmitUrl(),
                    method: getSubmitMethod(),
                    data: buildVersionFormData(),
                    processData: false,
                    contentType: false,
                    xhrFields: { withCredentials: true }
                });

                showToast("Version saved successfully!", "success", 2000);
                setTimeout(function() {
                    window.location.href = VERSION_CANCEL_URL;
                }, 1200);
            } catch (xhr) {
                showToast(`Error: ${window.getApiErrorMessage(xhr, "Failed to save")}`, "error", 4000);
            } finally {
                loadPanel.hide();
                setButtonLoading(submitButtonSelector, false);
            }
        }

        async function loadVersionData() {
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${serviceUrl}/courses/versions/${VERSION_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });

                const detailData = response.data || response;
                formWidget.option("formData", {
                    courseId: COURSE_ID,
                    note: detailData.note,
                    isActive: detailData.isActive
                });

                await loadExistingResources(detailData.resourceIds || []);
            } catch (xhr) {
                showToast(window.getApiErrorMessage(xhr, "Error loading version"), "error");
            } finally {
                loadPanel.hide();
            }
        }

        async function loadExistingResources(resourceIds) {
            if (!resourceIds.length) {
                return;
            }

            try {
                const response = await resourcesStore.load();
                const allResources = response.data || response || [];

                resourceIds.forEach(function(resourceId) {
                    const resource = allResources.find(function(item) {
                        return item.id === resourceId;
                    });

                    if (resource) {
                        addExistingResources([resource]);
                    }
                });

                refreshMasterGrid();
            } catch {
                showToast("Error loading resource details", "error");
            }
        }

        function createExistingResource(resource) {
            return {
                uid: `EXISTING_${resource.id}`,
                realId: resource.id,
                name: resource.name,
                typeId: resource.typeId,
                isNew: false
            };
        }

        function createNewResource(file, suffix) {
            return {
                uid: `NEW_${Date.now()}_${suffix}`,
                name: file.name,
                isNew: true,
                typeId: 1,
                fileRef: file
            };
        }

        function addExistingResources(resources) {
            resources.forEach(function(resource) {
                const resourceId = resource.realId ?? resource.id;
                const exists = unifiedResources.some(function(item) {
                    return !item.isNew && item.realId === resourceId;
                });

                if (!exists) {
                    unifiedResources.push(createExistingResource({
                        id: resourceId,
                        name: resource.name,
                        typeId: resource.typeId
                    }));
                }
            });
        }

        function addNewFiles(files) {
            Array.from(files).forEach(function(file, index) {
                unifiedResources.push(createNewResource(file, index));
            });
        }

        function removeResource(uid) {
            unifiedResources = unifiedResources.filter(function(resource) {
                return resource.uid !== uid;
            });
        }

        function buildVersionFormData() {
            const formData = formWidget.option("formData");
            const versionFormData = new FormData();
            versionFormData.append("courseId", COURSE_ID);
            versionFormData.append("note", formData.note);
            versionFormData.append("isActive", formData.isActive || false);

            unifiedResources.forEach(function(resource) {
                if (resource.isNew) {
                    versionFormData.append("Files", resource.fileRef);
                    versionFormData.append("ResourceIds", 0);
                } else {
                    versionFormData.append("ResourceIds", resource.realId);
                }

                versionFormData.append("ResourceTypes", resource.typeId);
            });

            return versionFormData;
        }

        function updateVersionReview() {
            if (!formWidget || !reviewForm) {
                return;
            }

            const formData = formWidget.option("formData") || {};
            reviewForm.option("formData", {
                note: formData.note || "Not set",
                status: formData.isActive ? "Set as active version" : "Saved as inactive version"
            });
        }

        function renderVersionReview() {
            const existingCount = unifiedResources.filter(function(resource) {
                return !resource.isNew;
            }).length;
            const newCount = unifiedResources.filter(function(resource) {
                return resource.isNew;
            }).length;

            $("#review-total-resources").text(unifiedResources.length);
            $("#review-existing-resources").text(existingCount);
            $("#review-new-resources").text(newCount);
            $("#review-content-table").html(buildReviewContentTable());
        }

        function buildReviewContentTable() {
            if (unifiedResources.length === 0) {
                return `
                    <div class="admin-wizard-empty-state">
                        <i class="fas fa-folder-open"></i>
                        <div>No content has been added yet.</div>
                    </div>`;
            }

            const rows = unifiedResources.map(function(resource, index) {
                const sourceText = resource.isNew ? "New upload" : "Resource library";
                const sourceBadge = resource.isNew ? "pill-primary" : "pill-default";

                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td>
                            <div class="admin-student-name">${window.escapeHtml(resource.name)}</div>
                        </td>
                        <td><span class="tag-pill ${sourceBadge}">${window.escapeHtml(sourceText)}</span></td>
                        <td><span class="tag-pill ${resource.typeId === 1 ? 'pill-learn' : 'pill-exam'}">${window.escapeHtml(getResourceTypeLabel(resource.typeId))}</span></td>
                        <td>${resource.isNew ? "Queued for upload" : "Linked from library"}</td>
                    </tr>`;
            }).join('');

            return `
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Content Name</th>
                            <th>Source</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>`;
        }

        function getResourceTypeLabel(typeId) {
            return typeId === 2 ? "Exam" : "Learn";
        }

        function getSubmitUrl() {
            return IS_EDIT
                ? `${serviceUrl}/courses/versions/${VERSION_ID}`
                : `${serviceUrl}/courses/${COURSE_ID}/versions`;
        }

        function getSubmitMethod() {
            return IS_EDIT ? "PUT" : "POST";
        }
    </script>
}