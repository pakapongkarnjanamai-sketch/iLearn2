@{
    ViewBag.Title = ViewBag.Id == null ? "Create New Version" : "Edit Version";
    var isEdit = ViewBag.Id != null;
    var courseId = ViewBag.CourseId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas @(isEdit ? "fa-edit" : "fa-plus")"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        @(isEdit ? "Update version details and resources." : "Create a new version and upload new SCORM files.")
                    </div>
                </div>
            </h1>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Version", "Courses", new { courseId = courseId })" class="btn btn-light border shadow-sm rounded px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </a>
                <button id="btnSave" class="btn btn-primary rounded shadow-sm px-4">
                    <i class="fas fa-save me-2"></i> Save Version
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div id="load-panel"></div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                        <i class="fas fa-info-circle text-primary me-2"></i> Version Details
                    </h5>
                    <div id="form"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                        <i class="fas fa-cloud-upload-alt text-success"></i> Upload New SCORM
                    </h5>
                    <span class="badge bg-light text-success border px-2 py-1" id="new-resource-count">0 Files</span>
                </div>
                <div class="card-body bg-light p-4">
                    <div class="upload-zone mb-3 bg-white border rounded p-3 text-center shadow-sm" style="border-style: dashed !important; border-width: 2px !important; border-color: #dee2e6 !important;">
                        <i class="fas fa-file-archive text-secondary mb-2" style="font-size: 2rem;"></i>
                        <p class="text-muted small mb-2">Drag & drop .zip files here or browse</p>
                        <div id="file-uploader-container"></div>
                    </div>
                    <div class="bg-white border rounded overflow-hidden shadow-sm">
                        <div id="new-files-grid"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="fas fa-book-reader me-2"></i> Select Existing Material (Learn)
                    </h5>
                    <div id="gridLearn"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-danger border-bottom pb-2 mb-3">
                        <i class="fas fa-pen-alt me-2"></i> Select Existing Examination (Exam)
                    </h5>
                    <div id="gridExam"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const COURSE_ID = parseInt('@courseId');
        const VERSION_ID = @(ViewBag.Id != null ? ViewBag.Id : "null");
        const IS_EDIT = VERSION_ID !== null;

        let selectedLearnIds = [];
        let selectedExamIds = [];
        let newFiles = []; // อาร์เรย์เก็บไฟล์อัปโหลดใหม่

        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        // Helper สร้าง Grid เลือกไฟล์เดิม
        function createGridConfig(typeId, onSelectionChangeCallback) {
            return {
                dataSource: { store: resourcesStore, filter: ["typeId", "=", typeId] },
                showBorders: true,
                height: 350,
                selection: { mode: "multiple", showCheckBoxesMode: "always" },
                searchPanel: { visible: true, width: 250, placeholder: "Search existing resources..." },
                scrolling: { mode: "virtual" },
                columns: [
                    { dataField: "name", caption: "Resource Name" },
                    { dataField: "isActive", caption: "Active", dataType: "boolean", width: 80, alignment: "center" }
                ],
                onSelectionChanged: onSelectionChangeCallback
            };
        }

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Saving version..."
            }).dxLoadPanel("instance");

            // 1. สร้าง Form
            const formWidget = $("#form").dxForm({
                formData: { courseId: COURSE_ID, isActive: true },
                colCount: 2,
                labelLocation: "top",
                items: [
                    {
                        dataField: "versionNumber",
                        editorType: "dxNumberBox",
                        label: { text: "Version No." },
                        editorOptions: {
                            disabled: !IS_EDIT,
                            placeholder: !IS_EDIT ? "Auto-generated" : ""
                        },
                        validationRules: IS_EDIT ? [{ type: "required", message: "Version number is required" }] : []
                    },
                    {
                        dataField: "note",
                        editorType: "dxTextBox",
                        label: { text: "Version Name / Note" },
                        validationRules: [{ type: "required", message: "Note is required" }]
                    },
                    {
                        dataField: "isActive",
                        editorType: "dxCheckBox",
                        label: { text: "Status", visible: false },
                        editorOptions: { text: "Active" },
                        colSpan: 2
                    }
                ]
            }).dxForm("instance");

            // 2. สร้าง Grids เลือกไฟล์เดิม (Learn & Exam)
            const gridLearn = $("#gridLearn").dxDataGrid(createGridConfig(1, (e) => {
                selectedLearnIds = e.selectedRowsData.map(r => r.id);
            })).dxDataGrid("instance");

            const gridExam = $("#gridExam").dxDataGrid(createGridConfig(2, (e) => {
                selectedExamIds = e.selectedRowsData.map(r => r.id);
            })).dxDataGrid("instance");

            // 3. ระบบ Upload ไฟล์ใหม่
            $("#file-uploader-container").dxFileUploader({
                selectButtonText: "Browse Files",
                labelText: "",
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                showFileList: false, // ใช้ Grid คัสตอมแทน
                onValueChanged: function(e) {
                    if(e.value && e.value.length > 0) {
                        newFiles = [...newFiles, ...e.value];
                        e.component.reset();
                        updateNewFilesGrid();
                    }
                }
            });

            function updateNewFilesGrid() {
                const dataSource = newFiles.map((file, index) => ({
                    id: index,
                    name: file.name,
                    fileRef: file
                }));

                $("#new-resource-count").text(`${newFiles.length} Files`);

                $("#new-files-grid").dxDataGrid({
                    dataSource: dataSource,
                    showBorders: false,
                    columnAutoWidth: true,
                    showRowLines: true,
                    noDataText: "No new files uploaded.",
                    columns: [
                        {
                            dataField: "name",
                            caption: "File Name",
                            cellTemplate: function(container, options) {
                                $("<div>").addClass("d-flex align-items-center gap-2")
                                    .append($("<i>").addClass("fas fa-file-upload text-success"))
                                    .append($("<span>").addClass("fw-medium text-truncate").css("max-width", "250px").text(options.value))
                                    .appendTo(container);
                            }
                        },
                        {
                            type: "buttons",
                            width: 60,
                            alignment: "center",
                            buttons: [
                                {
                                    icon: "trash",
                                    hint: "Remove",
                                    onClick: function(e) {
                                        newFiles = newFiles.filter(f => f !== e.row.data.fileRef);
                                        updateNewFilesGrid();
                                    }
                                }
                            ]
                        }
                    ]
                });
            }
            updateNewFilesGrid(); // วาด Grid ว่างเปล่าไว้ก่อน

            // 4. โหลดข้อมูล (เฉพาะตอน Edit)
            if (IS_EDIT) {
                $.ajax({
                    url: `${serviceUrl}/admin/CourseVersionsCRUD/Get/${VERSION_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    let detailData = res.data ? res.data : res;
                    formWidget.option("formData", detailData);

                    let rIds = detailData.resourceIds || (detailData.courseResources ? detailData.courseResources.map(cr => cr.resourceId) : []);
                    if (rIds.length > 0) {
                        const resourcePromises = rIds.map(id => resourcesStore.byKey(id));
                        Promise.all(resourcePromises).then(resources => {
                            gridLearn.option("selectedRowKeys", resources.filter(r => r && r.typeId === 1).map(r => r.id));
                            gridExam.option("selectedRowKeys", resources.filter(r => r && r.typeId === 2).map(r => r.id));
                        });
                    }
                });
            }

            // 5. บันทึกข้อมูล
            $("#btnSave").click(function() {
                const result = formWidget.validate();
                if (!result.isValid) {
                    DevExpress.ui.notify("Please fill in all required fields.", "warning", 2000);
                    return;
                }

                const hasExistingResources = selectedLearnIds.length > 0 || selectedExamIds.length > 0;

                // Validation: ต้องมีไฟล์ใหม่ หรือ เลือกไฟล์เดิมอย่างน้อย 1 รายการ
                if (!IS_EDIT && newFiles.length === 0 && !hasExistingResources) {
                     DevExpress.ui.notify("Please upload a new SCORM package OR select existing resources.", "error", 4000);
                     return;
                }

                loadPanel.show(); // แสดงหน้าโหลด

                const data = formWidget.option("formData");
                let formDataObj = new FormData();

                // 5.1 ยัดข้อมูล Form
                for (let key in data) {
                    if (data[key] !== null && data[key] !== undefined) {
                        formDataObj.append(key, data[key]);
                    }
                }

                // 5.2 ยัดข้อมูล Resource เก่าที่เลือกไว้ (ส่งเป็น Array)
                const allSelectedIds = [...selectedLearnIds, ...selectedExamIds];
                allSelectedIds.forEach(id => formDataObj.append("ResourceIds", id));

                // 5.3 ยัดไฟล์อัปโหลดใหม่
                if (newFiles.length > 0) {
                    newFiles.forEach(file => formDataObj.append("Files", file));
                }

                // ปรับ URL API ใหม่ให้ตรงกับ Backend
                const url = IS_EDIT
                    ? `${serviceUrl}/courses/UpdateVersion/${VERSION_ID}` // หากคุณตั้งชื่อ API อัปเดตไว้แบบนี้
                    : `${serviceUrl}/courses/CreateVersion`;

                // การส่งไฟล์จำเป็นต้องใช้ POST/PUT ร่วมกับ FormData
                const method = IS_EDIT ? "PUT" : "POST";

                $.ajax({
                    url: url,
                    method: method,
                    data: formDataObj,
                    processData: false, // ห้ามลบ! จำเป็นสำหรับ FormData
                    contentType: false, // ห้ามลบ! จำเป็นสำหรับ FormData
                    xhrFields: { withCredentials: true }
                }).done(function() {
                    DevExpress.ui.notify("Version saved successfully!", "success", 2000);
                    setTimeout(() => window.location.href = '@Url.Action("Version", "Courses")?courseId=' + COURSE_ID, 1000);
                }).fail(function(err) {
                    DevExpress.ui.notify("Error: " + (err.responseJSON?.message || "Failed to save version."), "error", 4000);
                }).always(function() {
                    loadPanel.hide();
                });
            });
        });
    </script>
}