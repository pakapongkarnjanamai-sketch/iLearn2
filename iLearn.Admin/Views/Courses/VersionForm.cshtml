@{
    ViewBag.Title = ViewBag.Id == null ? "Create New Version" : "Edit Version";
    var isEdit = ViewBag.Id != null;
    var courseId = ViewBag.CourseId;
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
    <div>
        <div class="page-title">@ViewBag.Title</div>
        <div class="page-subtitle">@(isEdit ? "Update version details and content order." : "Create a version and add learning content.")</div>
    </div>
    <a href="javascript:history.back();" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

<div class="container page-shell-md px-4 py-4">
    <div id="load-panel"></div>

    <!-- Version Details -->
    <div class="border rounded bg-white d-flex flex-column mb-3">
        <div class="p-3">
            <div class="admin-section-header">
                <div class="admin-section-header-main">
                    <div class="section-title mb-0 admin-section-title-fill">Version Details</div>
                </div>
                <div class="admin-section-divider"></div>
            </div>
        </div>
        <div class="px-3 pb-3">
            <div id="form-container"></div>
        </div>
    </div>

    <!-- Version Content -->
    <div class="border rounded bg-white d-flex flex-column">
        <div class="p-3">
            <div class="admin-section-header">
                <div class="admin-section-header-main">
                    <div class="section-title mb-0 admin-section-title-fill">Version Content</div>
                    <span class="tag-pill pill-default admin-section-meta" id="total-count-badge">0 Items</span>
                </div>
                <div class="admin-section-divider"></div>
            </div>
        </div>

        <div class="px-3 pb-3">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing">
                        <i class="fas fa-search fa-lg mb-3 target-card-icon"></i>
                        <div class="fw-bold text-dark mb-1 target-card-title">Select Existing Resources</div>
                        <div class="text-secondary target-card-subtitle">Choose files from the central library.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload">
                        <i class="fas fa-cloud-upload-alt fa-lg mb-3 target-card-icon"></i>
                        <div class="fw-bold text-dark mb-1 target-card-title">Upload New SCORM</div>
                        <div class="text-secondary target-card-subtitle">Drag &amp; drop or click to browse .zip</div>
                    </div>
                    <div id="file-uploader-container"></div>
                </div>
            </div>

            <div class="inline-note mb-3">
                <i class="fas fa-info-circle u-text-accent"></i>
                You can drag &amp; drop rows to reorder the content, and click on Type to change it for new files.
            </div>

            <div class="border rounded overflow-hidden">
                <div id="master-resources-grid"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Fixed Bottom Toolbar ── -->
<div class="bottom-toolbar">
    <span class="me-auto text-secondary d-none d-md-inline bottom-toolbar-note">
        <i class="fas fa-check-circle u-text-success"></i>
        Verify content order before saving.
    </span>
    <a href="javascript:history.back();" class="action-link">Cancel</a>
    <div id="btn-save"></div>
</div>

<div id="popup-existing"></div>

@section Scripts {
    <script>
        const COURSE_ID = parseInt('@courseId');
        const VERSION_ID = @(ViewBag.Id != null ? ViewBag.Id : "null");
        const IS_EDIT = VERSION_ID !== null;
        const COURSE_DETAIL_URL = '@Url.Action("Detail", "Courses")';
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        let formWidget;
        let masterGrid;
        let gridExisting;
        let unifiedResources = [];
        let popupExisting;
        let loadPanel;

        $(async () => {
            loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true
            }).dxLoadPanel("instance");

            formWidget = $("#form-container").dxForm({
                formData: { courseId: COURSE_ID, isActive: true },
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        dataField: "note",
                        editorType: "dxTextArea",
                        label: { text: "Version Name / Note" },
                        editorOptions: { height: 90, placeholder: "e.g. Added new V2 materials" },
                        validationRules: [{ type: "required", message: "Required" }]
                    },
                    {
                        dataField: "isActive",
                        editorType: "dxCheckBox",
                        label: { text: "Status", visible: false },
                        editorOptions: { text: "Set as Active Version" }
                    }
                ]
            }).dxForm("instance");

            masterGrid = initDxGrid("#master-resources-grid", {
                dataSource: unifiedResources,
                keyExpr: "uid",
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: getNoDataText("content"),
                editing: {
                    mode: "cell",
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = unifiedResources.findIndex(item => item.uid === visibleRows[e.toIndex].data.uid);
                        const fromIndex = unifiedResources.findIndex(item => item.uid === e.itemData.uid);
                        unifiedResources.splice(fromIndex, 1);
                        unifiedResources.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted fw-bold").text(options.rowIndex + 1).appendTo(container);
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const isNew = data.isNew;
                            const iconClass = isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            if (isNew) {
                                wrapper.append($("<span>").addClass("tag-pill tag-pill-xs pill-info ms-2").text("New"));
                            }
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Type (Click to edit)", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const tName = data.typeId === 1 ? "Learn" : (data.typeId === 2 ? "Exam" : "Unknown");
                            const typeCls = data.typeId === 1 ? "pill-learn" : "pill-exam";

                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const cursorStyle = data.isNew ? "cursor: pointer;" : "cursor: default;";
                            const tooltip = data.isNew ? "Click to change type" : "Existing resource type cannot be changed here";

                            $('<div>').addClass(`tag-pill ${typeCls}`)
                                .attr("style", cursorStyle)
                                .attr("title", tooltip)
                                .html(`${tName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                removeResource(e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            });

            function refreshMasterGrid() {
                masterGrid.option("dataSource", unifiedResources);
                $("#total-count-badge").text(window.formatAdminCountLabel(unifiedResources.length, 'item'));
            }

            popupExisting = $("#popup-existing").dxPopup({
                title: "Select Existing Resources",
                width: "90vw", maxWidth: 1100,
                disableGlobalHeightSizing: true,
                showCloseButton: true, dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    if (gridExisting) gridExisting.updateDimensions();
                },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='grid-existing-pick' style='height:100%;'>").appendTo(contentElement);
                    gridExisting = initDxGrid(gridContainer, {
                        preset: "selectionGrid",
                        dataSource: resourcesStore,
                        remoteOperations: true,
                        searchPanel: { placeholder: "Search by name or type..." },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Resource Name", minWidth: 200,
                                cellTemplate: function(container, options) {
                                    $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                                }
                            },
                            {
                                dataField: "typeId", caption: "Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearn = options.value === 1;
                                    const text = isLearn ? "Learn" : "Exam";
                                    $('<span>').addClass(`tag-pill ${isLearn ? 'pill-learn' : 'pill-exam'}`).text(text).appendTo(container);
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(d) { return (d.courseResources || []).length; },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    $('<span>')
                                        .addClass(`tag-pill ${count > 0 ? 'pill-success' : 'pill-default'}`)
                                        .html(`<i class="fas fa-book me-1"></i>${count}`)
                                        .appendTo(container);
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                cellTemplate: function(container, options) {
                                    if (!options.value) {
                                        return;
                                    }

                                    const formatted = formatDateTime(options.value);
                                    $("<span>").addClass("text-muted small").text(formatted).appendTo(container);
                                }
                            }
                        ]
                    });
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                addExistingResources(gridExisting.getSelectedRowsData());
                                refreshMasterGrid();
                                gridExisting.clearSelection();
                                popupExisting.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").on("click", function() {
                popupExisting.show();
            });

            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false, accept: ".zip", uploadMode: "useForm", multiple: true,
                onValueChanged: function(e) {
                    if (!e.value || e.value.length === 0) {
                        return;
                    }

                    addNewFiles(e.value);
                    e.component.reset();
                    refreshMasterGrid();
                    showToast("File added to queue", "success", 2000);
                }
            });

            if (IS_EDIT) {
                await loadVersionData();
            }

            refreshMasterGrid();

            $("#btn-save").dxButton({
                text: IS_EDIT ? "Save Changes" : "Create Version",
                icon: "save", type: "default", stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 py-1 btn-primary rounded-3 fw-medium" },
                onClick: () => submitData()
            });

            async function submitData() {
                if (!formWidget.validate().isValid) {
                    showToast("Please fill in required fields.", "warning");
                    return;
                }

                if (unifiedResources.length === 0) {
                    showToast("Please add at least one resource.", "error");
                    return;
                }

                loadPanel.option("message", "Saving version & processing files...");
                loadPanel.show();

                try {
                    await $.ajax({
                        url: getSubmitUrl(),
                        method: getSubmitMethod(),
                        data: buildVersionFormData(),
                        processData: false,
                        contentType: false,
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Saved successfully!", "success", 2000);
                    setTimeout(() => window.location.href = `${COURSE_DETAIL_URL}?id=${COURSE_ID}`, 1200);
                } catch (xhr) {
                    showToast(`Error: ${window.getApiErrorMessage(xhr, "Failed to save")}`, "error", 4000);
                } finally {
                    loadPanel.hide();
                }
            }

            async function loadVersionData() {
                loadPanel.show();

                try {
                    const response = await $.ajax({
                        url: `${serviceUrl}/courses/versions/${VERSION_ID}`,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    const detailData = response.data || response;
                    formWidget.option("formData", {
                        note: detailData.note,
                        isActive: detailData.isActive
                    });

                    await loadExistingResources(detailData.resourceIds || []);
                } catch (xhr) {
                    showToast(window.getApiErrorMessage(xhr, "Error loading version"), "error");
                } finally {
                    loadPanel.hide();
                }
            }

            async function loadExistingResources(resourceIds) {
                if (!resourceIds.length) {
                    return;
                }

                try {
                    const response = await resourcesStore.load();
                    const allResources = response.data || response || [];

                    resourceIds.forEach(function(resourceId) {
                        const resource = allResources.find(function(item) {
                            return item.id === resourceId;
                        });

                        if (resource) {
                            addExistingResources([resource]);
                        }
                    });

                    refreshMasterGrid();
                } catch {
                    showToast("Error loading resource details", "error");
                }
            }

            function createExistingResource(resource) {
                return {
                    uid: `EXISTING_${resource.id}`,
                    realId: resource.id,
                    name: resource.name,
                    typeId: resource.typeId,
                    isNew: false
                };
            }

            function createNewResource(file, suffix) {
                return {
                    uid: `NEW_${Date.now()}_${suffix}`,
                    name: file.name,
                    isNew: true,
                    typeId: 1,
                    fileRef: file
                };
            }

            function addExistingResources(resources) {
                resources.forEach(function(resource) {
                    const resourceId = resource.realId ?? resource.id;
                    const exists = unifiedResources.some(function(item) {
                        return !item.isNew && item.realId === resourceId;
                    });

                    if (!exists) {
                        unifiedResources.push(createExistingResource({
                            id: resourceId,
                            name: resource.name,
                            typeId: resource.typeId
                        }));
                    }
                });
            }

            function addNewFiles(files) {
                files.forEach(function(file, index) {
                    unifiedResources.push(createNewResource(file, index));
                });
            }

            function removeResource(uid) {
                unifiedResources = unifiedResources.filter(function(resource) {
                    return resource.uid !== uid;
                });
            }

            function buildVersionFormData() {
                const formData = formWidget.option("formData");
                const versionFormData = new FormData();
                versionFormData.append("courseId", COURSE_ID);
                versionFormData.append("note", formData.note);
                versionFormData.append("isActive", formData.isActive || false);

                unifiedResources.forEach(function(resource) {
                    if (resource.isNew) {
                        versionFormData.append("Files", resource.fileRef);
                        versionFormData.append("ResourceIds", 0);
                    } else {
                        versionFormData.append("ResourceIds", resource.realId);
                    }

                    versionFormData.append("ResourceTypes", resource.typeId);
                });

                return versionFormData;
            }

            function getSubmitUrl() {
                return IS_EDIT
                    ? `${serviceUrl}/courses/versions/${VERSION_ID}`
                    : `${serviceUrl}/courses/${COURSE_ID}/versions`;
            }

            function getSubmitMethod() {
                return IS_EDIT ? "PUT" : "POST";
            }

            function formatDateTime(value) {
                return window.formatAdminDateTime(value, '—');
            }
        });
    </script>
}