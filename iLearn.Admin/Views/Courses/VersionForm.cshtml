@{
    ViewBag.Title = ViewBag.Id == null ? "Create New Version" : "Edit Version";
    var isEdit = ViewBag.Id != null;
    var courseId = ViewBag.CourseId;
    var detailUrl = Url.Action("Detail", "Courses", new { id = courseId });
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    .version-content-note {
        font-size: var(--font-size-caption);
        color: var(--text-secondary);
    }

    .version-review-table-wrap {
        --admin-table-wrap-max-height: clamp(220px, calc(100vh - 540px), 320px);
    }
</style>

<!-- ── Page Header ── -->
<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-code-branch text-primary me-2" aria-hidden="true"></i>@ViewBag.Title</h1>
    <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
        <div class="admin-step-card active" data-step-card="1" aria-current="step">
            <div class="admin-step-title"><span class="admin-step-index">1</span>Details</div>
        </div>
        <div class="admin-step-card" data-step-card="2">
            <div class="admin-step-title"><span class="admin-step-index">2</span>Content</div>
        </div>
        <div class="admin-step-card" data-step-card="3">
            <div class="admin-step-title"><span class="admin-step-index">3</span>Options</div>
        </div>
        <div class="admin-step-card" data-step-card="4">
            <div class="admin-step-title"><span class="admin-step-index">4</span>Review</div>
        </div>
    </div>
    <div class="admin-page-header-actions">
        <a href="@detailUrl" class="action-link">
            <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
        </a>
        <button type="button" id="btn-previous-step" class="action-link d-none">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
        </button>
        <button type="button" id="btn-next-step" class="action-link primary">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
        </button>
        <button type="button" id="btn-submit-version" class="action-link primary d-none">
            <i class="fas fa-save" aria-hidden="true"></i> @(isEdit ? "Save Changes" : "Create Version")
        </button>
    </div>
</div>

<div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow admin-viewport-layout">
    <div id="load-panel"></div>

    <div class="admin-review-main-col admin-responsive-content">
        <div class="border rounded bg-white p-3 admin-viewport-fill">
            <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="form">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Version Details</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>
                <div class="admin-detail-card">
                    <div id="form-container"></div>
                </div>
            </div>

            <div id="step-panel-2" class="admin-wizard-panel admin-wizard-panel--grid-fill" data-step-layout="wide">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Version Content</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-detail-card">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing" role="button" tabindex="0">
                                <i class="fas fa-search fa-lg target-card-icon"></i>
                                <div class="fw-bold text-dark target-card-title">Select Existing Content</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload" role="button" tabindex="0">
                                <i class="fas fa-cloud-upload-alt fa-lg target-card-icon"></i>
                                <div class="fw-bold text-dark target-card-title">Upload New SCORM</div>
                            </div>
                            <div id="file-uploader-container"></div>
                        </div>
                    </div>

                    <div class="version-content-note mb-3">You can drag and drop rows to reorder the content, and click on Type to change it for new files.</div>

                    <div class="admin-compat-note mb-3">
                        <div class="admin-compat-note-title">SCORM Compatibility</div>
                        <ul class="admin-compat-note-list">
                            <li>Accepts SCORM 1.2 and SCORM 2004 ZIP packages only.</li>
                            <li>Supports import, launch, runtime commit, and resume for SCORM 1.2 and SCORM 2004 content.</li>
                            <li><code>imsmanifest.xml</code> may be at the ZIP root or inside a package folder.</li>
                            <li>Resume depends on the package writing bookmark or suspend data and calling Commit or Terminate.</li>
                            <li>Uses one launch SCO per content item; full SCORM 2004 sequencing and multi-SCO navigation are not orchestrated.</li>
                            <li>Limits: 100 MB ZIP, 1,000 archive entries, 100 MB per file, 250 MB expanded.</li>
                        </ul>
                    </div>

                    <div class="admin-grid-shell overflow-hidden">
                        <div class="admin-grid-head">
                            <div class="admin-grid-title">Selected Content</div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="tag-pill pill-default" id="total-count-badge">0 items</span>
                            </div>
                        </div>
                        <div id="content-items-grid" class="admin-grid-fill"></div>
                    </div>
                </div>
            </div>

            <div id="step-panel-3" class="admin-wizard-panel" data-step-layout="form">
                <div class="admin-section-header mb-2">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Version Options</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-option-card mb-2">
                    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
                        <div>
                            <div class="u-fs-12 u-fw-semibold text-dark">Learner Version Policy</div>
                            <div class="admin-status-option-note" id="version-policy-note">Checking learner impact when this step opens.</div>
                        </div>
                        <span class="tag-pill pill-default" id="version-policy-state">Pending</span>
                    </div>

                    <div class="admin-summary-grid admin-summary-grid--cols-4 mb-3">
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="policy-not-started-count">0</div>
                            <div class="admin-summary-label">Not Started</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="policy-in-progress-count">0</div>
                            <div class="admin-summary-label">In Progress</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="policy-completed-count">0</div>
                            <div class="admin-summary-label">Completed</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="policy-other-open-count">0</div>
                            <div class="admin-summary-label">Not Affected</div>
                        </div>
                    </div>

                    <div class="admin-status-options" id="version-policy-options">
                        <div class="admin-status-option version-policy-option" data-version-policy="NewLearnersOnly">
                            <label for="version-policy-new">
                                <div>
                                    <div class="admin-status-option-title">New Learners Only</div>
                                    <div class="admin-status-option-note">Keep current assigned learners on their current version.</div>
                                </div>
                                <input class="form-check-input version-policy-radio" type="radio" name="version-policy" id="version-policy-new" value="NewLearnersOnly" checked>
                            </label>
                        </div>
                        <div class="admin-status-option version-policy-option" data-version-policy="MoveNotStarted">
                            <label for="version-policy-not-started">
                                <div>
                                    <div class="admin-status-option-title">Move Not Started</div>
                                    <div class="admin-status-option-note">Move only not-started learners in currently in-progress assignments.</div>
                                </div>
                                <input class="form-check-input version-policy-radio" type="radio" name="version-policy" id="version-policy-not-started" value="MoveNotStarted">
                            </label>
                        </div>
                        <div class="admin-status-option version-policy-option" data-version-policy="ResetInProgress">
                            <label for="version-policy-reset">
                                <div>
                                    <div class="admin-status-option-title">Reset In Progress</div>
                                    <div class="admin-status-option-note">Move and reset open learners in currently in-progress assignments.</div>
                                </div>
                                <input class="form-check-input version-policy-radio" type="radio" name="version-policy" id="version-policy-reset" value="ResetInProgress">
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div id="step-panel-4" class="admin-wizard-panel" data-step-layout="review">
                <div class="admin-section-header admin-review-header">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Review And Confirm</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="admin-review-stack">
                    <div class="admin-summary-grid">
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-total-content">0</div>
                            <div class="admin-summary-label">Total Content Items</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-existing-content">0</div>
                            <div class="admin-summary-label">Existing Content</div>
                        </div>
                        <div class="admin-summary-item">
                            <div class="admin-summary-value" id="review-new-content">0</div>
                            <div class="admin-summary-label">New Uploads</div>
                        </div>
                    </div>

                    <div class="admin-detail-card">
                        <div class="section-title mb-2">Version Details</div>
                        <div id="form-review-details"></div>
                    </div>

                    <div class="admin-table-shell">
                        <div class="admin-table-head">
                            <div class="admin-table-title">Content Review</div>
                        </div>
                        <div class="admin-table-wrap version-review-table-wrap" id="review-content-table"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="content-picker-popup"></div>

@section Scripts {
    <script>
        const COURSE_ID = Number('@courseId');
        const VERSION_ID = @(ViewBag.Id != null ? ViewBag.Id : "null");
        const IS_EDIT = VERSION_ID !== null;
        const COURSE_DETAIL_URL = '@Url.Action("Detail", "Courses")';
        const VERSION_CANCEL_URL = '@detailUrl';

        const VERSION_NOTE_HEIGHT = 90;
        const CONTENT_GRID_HEIGHT = "100%";
        const CONTENT_LIBRARY_GRID_HEIGHT = 520;
        const TOTAL_WIZARD_STEPS = 4;
        const VERSION_LEARNER_POLICY = {
            NewLearnersOnly: "NewLearnersOnly",
            MoveNotStarted: "MoveNotStarted",
            ResetInProgress: "ResetInProgress"
        };
        const VERSION_LEARNER_POLICY_LABELS = {
            NewLearnersOnly: "New Learners Only",
            MoveNotStarted: "Move Not Started",
            ResetInProgress: "Reset In Progress"
        };

        const contentLibraryStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        let formWidget;
        let masterGrid;
        let contentPickerGrid;
        let contentItems = [];
        let contentPickerPopup;
        let loadPanel;
        let reviewForm;
        let gridViewportController = null;
        let isSubmittingVersion = false;
        let initialVersionIsActive = false;
        let versionLearnerImpact = null;
        let versionLearnerImpactLoaded = false;
        let isLoadingVersionImpact = false;
        let learnerPolicySelection = VERSION_LEARNER_POLICY.NewLearnersOnly;
        const createState = {
            currentStep: 1
        };

        $(async () => {
            loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            initializeVersionForm({ courseId: COURSE_ID, isActive: true });
            initializeMasterGrid();
            initializeExistingContentPopup();
            initializeFileUploader();
            initializeReviewForm();

            if (IS_EDIT) {
                await loadVersionData();
            }

            initializeCreateWizard();
            updateCreateWizardUi();

            refreshMasterGrid();
            renderVersionPolicyStep();
            updateVersionReview();
            renderVersionReview();
        });

        function initializeVersionForm(formData) {
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                onFieldDataChanged: function(e) {
                    if (e.dataField === "isActive") {
                        invalidateVersionPolicyImpact();
                        renderVersionPolicyStep();
                    }

                    updateVersionReview();
                    renderVersionReview();
                },
                items: [
                    {
                        dataField: "note",
                        editorType: "dxTextArea",
                        label: { text: "Version Name / Note" },
                        editorOptions: {
                            height: VERSION_NOTE_HEIGHT,
                            placeholder: "e.g. Added new V2 materials"
                        },
                        validationRules: [{ type: "required", message: "Version note is required" }]
                    },
                    {
                        dataField: "isActive",
                        editorType: "dxCheckBox",
                        label: { text: "Status", visible: false },
                        editorOptions: { text: "Set as Active Version" }
                    }
                ]
            }).dxForm("instance");
        }

        function initializeReviewForm() {
            reviewForm = $("#form-review-details").dxForm({
                readOnly: true,
                labelMode: "floating",
                stylingMode: "outlined",
                colCount: 2,
                formData: { note: "", status: "" },
                items: [
                    {
                        dataField: "note",
                        label: { text: "Version Note" },
                        colSpan: 2,
                        editorType: "dxTextArea",
                        editorOptions: { height: VERSION_NOTE_HEIGHT }
                    },
                    {
                        dataField: "status",
                        label: { text: "Status On Save" },
                        colSpan: 2
                    },
                    {
                        dataField: "learnerPolicy",
                        label: { text: "Learner Policy" },
                        colSpan: 2
                    }
                ]
            }).dxForm("instance");
        }

        function initializeMasterGrid() {
            masterGrid = initDxGrid("#content-items-grid", {
                dataSource: contentItems,
                keyExpr: "uid",
                height: CONTENT_GRID_HEIGHT,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: getNoDataText("content"),
                editing: {
                    mode: "cell",
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = contentItems.findIndex(function(item) {
                            return item.uid === visibleRows[e.toIndex].data.uid;
                        });
                        const fromIndex = contentItems.findIndex(function(item) {
                            return item.uid === e.itemData.uid;
                        });

                        contentItems.splice(fromIndex, 1);
                        contentItems.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                        refreshMasterGrid();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            window.renderAdminGridTextCell(container, options.rowIndex + 1, "captionMuted", { fontWeight: "700" });
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const iconClass = data.isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            if (data.isNew) {
                                window.renderAdminGridTextCell(wrapper, "New", "xsAccent", { marginLeft: "8px" });
                            }

                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Content Type", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const typeName = getContentTypeLabel(data.typeId);
                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const tooltip = data.isNew ? "Click to change content type" : "Existing content type cannot be changed here";

                            $('<div>').css(window.getAdminGridTextStyle(data.typeId === 1 ? 'captionAccent' : 'captionWarning', {
                                cursor: data.isNew ? 'pointer' : 'default'
                            }))
                                .attr("title", tooltip)
                                .html(`${typeName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Status", width: 150, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            renderContentReadinessCell(container, options.data);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                removeContentItem(e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            });
        }

        function initializeExistingContentPopup() {
            contentPickerPopup = $("#content-picker-popup").dxPopup({
                title: "Select Existing Content",
                width: "90vw",
                maxWidth: 1080,
                height: "auto",
                maxHeight: "90vh",
                disableGlobalHeightSizing: true,
                showCloseButton: true,
                dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    if (contentPickerGrid) {
                        contentPickerGrid.updateDimensions();
                    }
                },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='content-library-grid'>").appendTo(contentElement);
                    contentPickerGrid = initDxGrid(gridContainer, {
                        preset: "selectionGrid",
                        dataSource: contentLibraryStore,
                        remoteOperations: true,
                        height: CONTENT_LIBRARY_GRID_HEIGHT,
                        searchPanel: { placeholder: "Search by name or content type..." },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Content Name", minWidth: 200,
                                cssClass: "fw-medium text-dark"
                            },
                            {
                                dataField: "typeId", caption: "Content Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearningType = options.value === 1;
                                    const text = isLearningType ? "Learn" : "Exam";
                                    window.renderAdminGridStatusCell(container, text, isLearningType ? 'primary' : 'warning', { showDot: false });
                                }
                            },
                            {
                                caption: "Status", width: 130, alignment: "center",
                                cellTemplate: function(container, options) {
                                    renderContentReadinessCell(container, options.data);
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(data) {
                                    return (data.courseResources || []).length;
                                },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    window.renderAdminGridTextCell(container, count, count > 0 ? 'captionSuccess' : 'captionMuted');
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                format: ADMIN_DATETIME_DISPLAY_FORMAT,
                                cssClass: "cell-muted"
                            }
                        ]
                    });
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                addExistingContentItems(contentPickerGrid.getSelectedRowsData());
                                refreshMasterGrid();
                                contentPickerGrid.clearSelection();
                                contentPickerPopup.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").on("click", function() {
                contentPickerPopup.show();
            }).on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).click();
                }
            });
        }

        function initializeFileUploader() {
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false,
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                onValueChanged: function(e) {
                    if (!e.value || e.value.length === 0) {
                        return;
                    }

                    addNewFiles(e.value);
                    e.component.reset();
                    refreshMasterGrid();
                    showToast("File added to queue", "success", 2000);
                }
            });

            $("#btn-trigger-upload").on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    $(this).click();
                }
            });
        }

        function initializeCreateWizard() {
            $("#btn-previous-step").on("click", function() {
                if (createState.currentStep <= 1) {
                    return;
                }

                createState.currentStep -= 1;
                updateCreateWizardUi();
            });

            $("#btn-next-step").on("click", function() {
                handleNextStep();
            });

            $("#btn-submit-version").on("click", function() {
                if (isSubmittingVersion) {
                    return;
                }

                submitData();
            });

            $(".version-policy-radio").on("change", function() {
                learnerPolicySelection = $(this).val() || VERSION_LEARNER_POLICY.NewLearnersOnly;
                renderVersionPolicyStep();
            });
        }

        function refreshMasterGrid() {
            masterGrid.option("dataSource", contentItems);
            $("#total-count-badge").text(window.formatAdminCountLabel(contentItems.length, 'item'));
            updateVersionReview();
            renderVersionReview();
        }

        async function handleNextStep() {
            if (createState.currentStep === 1 && !validateVersionDetailsStep()) {
                return;
            }

            if (createState.currentStep === 2 && !validateVersionContentStep()) {
                return;
            }

            if (createState.currentStep === 2 && !(await prepareVersionPolicyStep())) {
                return;
            }

            if (createState.currentStep === 3 && !validateVersionPolicyStep()) {
                return;
            }

            if (createState.currentStep < TOTAL_WIZARD_STEPS) {
                createState.currentStep += 1;
                updateCreateWizardUi();
            }
        }

        function updateCreateWizardUi() {
            $("[data-step-card]").each(function() {
                const step = Number($(this).data("stepCard"));
                $(this).toggleClass("active", step === createState.currentStep);
                $(this).toggleClass("complete", step < createState.currentStep);

                if (step === createState.currentStep) {
                    $(this).attr("aria-current", "step");
                } else {
                    $(this).removeAttr("aria-current");
                }
            });

            $(".admin-wizard-panel").removeClass("active");
            $(`#step-panel-${createState.currentStep}`).addClass("active");
            const layout = $(`#step-panel-${createState.currentStep}`).attr("data-step-layout") || "wide";
            $(".admin-wizard-shell")
                .toggleClass("is-grid-step", createState.currentStep === 2)
                .toggleClass("is-form-step", layout === "form")
                .toggleClass("is-review-step", layout === "review");

            gridViewportController = window.toggleAdminViewportLayout(gridViewportController, createState.currentStep === 2, {
                layoutSelector: ".admin-wizard-shell.admin-viewport-layout",
                contentSelector: ".admin-review-main-col.admin-responsive-content",
                refreshTargets: [masterGrid]
            });

            $("#btn-previous-step").toggleClass("d-none", createState.currentStep <= 1);
            $("#btn-next-step").toggleClass("d-none", createState.currentStep >= TOTAL_WIZARD_STEPS);
            $("#btn-submit-version").toggleClass("d-none", createState.currentStep !== TOTAL_WIZARD_STEPS);

            if (createState.currentStep === 2 && masterGrid) {
                masterGrid.updateDimensions();
            }

            if (createState.currentStep === 3) {
                renderVersionPolicyStep();
            }

            if (createState.currentStep === 4) {
                updateVersionReview();
                renderVersionReview();
            }
        }

        function validateVersionDetailsStep() {
            const validation = formWidget.validate();
            if (!validation.isValid) {
                showToast("Please complete the required version details before continuing.", "warning", 2500);
                return false;
            }

            return true;
        }

        function validateVersionContentStep() {
            if (contentItems.length === 0) {
                showToast("Please add at least one content item before reviewing the version.", "warning", 3000);
                return false;
            }

            return true;
        }

        function validateVersionPolicyStep() {
            if (isVersionPolicyChoiceEnabled() && !learnerPolicySelection) {
                showToast("Please select a learner version policy.", "warning", 2500);
                return false;
            }

            return true;
        }

        async function submitData() {
            if (isSubmittingVersion) {
                return;
            }

            if (!formWidget.validate().isValid) {
                showToast("Please fill in the required version details.", "warning", 2000);
                return;
            }

            if (contentItems.length === 0) {
                showToast("Please add at least one content item.", "error", 4000);
                return;
            }

            isSubmittingVersion = true;
            const submitButtonSelector = "#btn-submit-version";
            let shouldResetSubmitting = true;

            try {
                const learnerPolicy = getLearnerPolicyForSave();

                setButtonLoading(submitButtonSelector, true, IS_EDIT ? "Saving..." : "Creating...");
                loadPanel.option("message", "Saving version and processing files...");
                loadPanel.show();

                await $.ajax({
                    url: getSubmitUrl(),
                    method: getSubmitMethod(),
                    data: buildVersionFormData(learnerPolicy),
                    processData: false,
                    contentType: false,
                    xhrFields: { withCredentials: true }
                });

                showToast("Version saved successfully!", "success", 2000);
                shouldResetSubmitting = false;
                setTimeout(function() {
                    window.location.href = VERSION_CANCEL_URL;
                }, 1200);
            } catch (xhr) {
                const readinessMessage = getVersionReadinessErrorMessage(xhr);
                if (readinessMessage) {
                    showVersionReadinessServerDialog(readinessMessage);
                    return;
                }

                showToast(`Error: ${window.getApiErrorMessage(xhr, "Failed to save")}`, "error", 4000);
            } finally {
                if (shouldResetSubmitting) {
                    isSubmittingVersion = false;
                    loadPanel.hide();
                    setButtonLoading(submitButtonSelector, false);
                }
            }
        }

        async function loadVersionData() {
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${serviceUrl}/courses/versions/${VERSION_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });

                const detailData = response.data || response;
                initialVersionIsActive = !!detailData.isActive;
                formWidget.option("formData", {
                    courseId: COURSE_ID,
                    note: detailData.note,
                    isActive: detailData.isActive
                });
                invalidateVersionPolicyImpact();
                renderVersionPolicyStep();

                await loadLinkedContentItems(detailData.resourceIds || []);
            } catch (xhr) {
                showToast(window.getApiErrorMessage(xhr, "Error loading version"), "error");
            } finally {
                loadPanel.hide();
            }
        }

        async function loadLinkedContentItems(resourceIds) {
            if (!resourceIds.length) {
                return;
            }

            try {
                const response = await contentLibraryStore.load();
                const allResources = response.data || response || [];

                resourceIds.forEach(function(resourceId) {
                    const resource = allResources.find(function(item) {
                        return item.id === resourceId;
                    });

                    if (resource) {
                        addExistingContentItems([resource]);
                    }
                });

                refreshMasterGrid();
            } catch {
                showToast("Error loading content details", "error");
            }
        }

        function createExistingContentItem(resource) {
            return {
                uid: `EXISTING_${resource.id}`,
                realId: resource.id,
                name: resource.name,
                typeId: resource.typeId,
                isNew: false,
                isActive: !!resource.isActive,
                url: resource.url || null
            };
        }

        function createUploadedContentItem(file, suffix) {
            return {
                uid: `NEW_${Date.now()}_${suffix}`,
                name: file.name,
                isNew: true,
                typeId: 1,
                fileRef: file
            };
        }

        function addExistingContentItems(resources) {
            resources.forEach(function(resource) {
                const resourceId = resource.realId ?? resource.id;
                const exists = contentItems.some(function(item) {
                    return !item.isNew && item.realId === resourceId;
                });

                if (!exists) {
                    contentItems.push(createExistingContentItem({
                        id: resourceId,
                        name: resource.name,
                        typeId: resource.typeId,
                        isActive: resource.isActive,
                        url: resource.url
                    }));
                }
            });
        }

        function addNewFiles(files) {
            Array.from(files).forEach(function(file, index) {
                contentItems.push(createUploadedContentItem(file, index));
            });
        }

        function removeContentItem(uid) {
            contentItems = contentItems.filter(function(resource) {
                return resource.uid !== uid;
            });
        }

        function buildVersionFormData(learnerPolicy) {
            const formData = formWidget.option("formData");
            const versionFormData = new FormData();
            versionFormData.append("courseId", COURSE_ID);
            versionFormData.append("note", formData.note);
            versionFormData.append("isActive", formData.isActive || false);
            versionFormData.append("learnerPolicy", learnerPolicy || VERSION_LEARNER_POLICY.NewLearnersOnly);

            contentItems.forEach(function(resource) {
                if (resource.isNew) {
                    versionFormData.append("Files", resource.fileRef);
                    versionFormData.append("ResourceIds", 0);
                } else {
                    versionFormData.append("ResourceIds", resource.realId);
                }

                versionFormData.append("ResourceTypes", resource.typeId);
            });

            return versionFormData;
        }

        async function loadVersionLearnerImpact() {
            const response = await $.ajax({
                url: `${serviceUrl}/courses/${COURSE_ID}/version-impact`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            return response.data || response;
        }

        async function prepareVersionPolicyStep() {
            if (!willActivateVersionOnSave()) {
                invalidateVersionPolicyImpact();
                renderVersionPolicyStep();
                return true;
            }

            if (isLoadingVersionImpact) {
                return false;
            }

            if (versionLearnerImpactLoaded) {
                renderVersionPolicyStep();
                return true;
            }

            isLoadingVersionImpact = true;
            setButtonLoading("#btn-next-step", true, "Checking...");
            loadPanel.option("message", "Checking learner impact...");
            loadPanel.show();

            try {
                versionLearnerImpact = await loadVersionLearnerImpact();
                versionLearnerImpactLoaded = true;
                renderVersionPolicyStep();
                return true;
            } catch (xhr) {
                showToast(window.getApiErrorMessage(xhr, "Failed to check learner impact."), "error", 4000);
                return false;
            } finally {
                isLoadingVersionImpact = false;
                loadPanel.hide();
                setButtonLoading("#btn-next-step", false);
            }
        }

        function invalidateVersionPolicyImpact() {
            versionLearnerImpact = null;
            versionLearnerImpactLoaded = false;
            learnerPolicySelection = VERSION_LEARNER_POLICY.NewLearnersOnly;
        }

        function willSaveVersionAsActive() {
            const formData = formWidget ? (formWidget.option("formData") || {}) : {};
            return !!formData.isActive;
        }

        function willActivateVersionOnSave() {
            const formData = formWidget ? (formWidget.option("formData") || {}) : {};
            return !!formData.isActive && (!IS_EDIT || !initialVersionIsActive);
        }

        function isVersionPolicyChoiceEnabled() {
            return willActivateVersionOnSave()
                && !!versionLearnerImpact
                && !!versionLearnerImpact.hasEligibleOpenLearners;
        }

        function getLearnerPolicyForSave() {
            return isVersionPolicyChoiceEnabled()
                ? learnerPolicySelection
                : VERSION_LEARNER_POLICY.NewLearnersOnly;
        }

        function getLearnerPolicyLabel(policy) {
            return VERSION_LEARNER_POLICY_LABELS[policy] || VERSION_LEARNER_POLICY_LABELS.NewLearnersOnly;
        }

        function renderVersionPolicyStep() {
            const impact = versionLearnerImpact || {};
            const choiceEnabled = isVersionPolicyChoiceEnabled();
            const policyForSave = getLearnerPolicyForSave();

            $("#policy-not-started-count").text(formatPolicyCount(impact.notStartedCount));
            $("#policy-in-progress-count").text(formatPolicyCount(impact.inProgressCount));
            $("#policy-completed-count").text(formatPolicyCount(impact.completedCount));
            $("#policy-other-open-count").text(formatPolicyCount(impact.otherOpenCount));

            setVersionPolicyStatePill(getVersionPolicyState());
            $("#version-policy-note").text(getVersionPolicyNote());

            $(".version-policy-radio")
                .prop("disabled", !choiceEnabled)
                .prop("checked", false);
            $(`.version-policy-radio[value="${policyForSave}"]`).prop("checked", true);

            $(".version-policy-option").each(function() {
                const policy = String($(this).data("versionPolicy") || "");
                $(this)
                    .toggleClass("disabled", !choiceEnabled)
                    .toggleClass("active", choiceEnabled && policy === policyForSave);
            });

            updateVersionReview();
        }

        function setVersionPolicyStatePill(state) {
            $("#version-policy-state")
                .removeClass("pill-default pill-primary pill-warning pill-danger pill-success")
                .addClass(state.className)
                .text(state.text);
        }

        function getVersionPolicyState() {
            if (!willActivateVersionOnSave()) {
                return { text: "Not Required", className: "pill-default" };
            }

            if (!versionLearnerImpactLoaded) {
                return { text: "Pending", className: "pill-default" };
            }

            if (!versionLearnerImpact || !versionLearnerImpact.hasEligibleOpenLearners) {
                return { text: "No Impact", className: "pill-success" };
            }

            return { text: "Action Required", className: "pill-warning" };
        }

        function getVersionPolicyNote() {
            if (!willActivateVersionOnSave()) {
                return "This save will not activate a new version, so learner migration is not required.";
            }

            if (!versionLearnerImpactLoaded) {
                return "Learner impact will be checked before continuing.";
            }

            if (!versionLearnerImpact || !versionLearnerImpact.hasEligibleOpenLearners) {
                return "No open learners in current active assignments will be moved.";
            }

            return "Choose how assigned learners should be handled when this version becomes active.";
        }

        function formatPolicyCount(value) {
            return Number(value || 0).toLocaleString();
        }

        function updateVersionReview() {
            if (!formWidget || !reviewForm) {
                return;
            }

            const formData = formWidget.option("formData") || {};
            reviewForm.option("formData", {
                note: formData.note || "Not set",
                status: formData.isActive ? "Set as active version" : "Saved as inactive version",
                learnerPolicy: getLearnerPolicyLabel(getLearnerPolicyForSave())
            });
        }

        function getContentReadinessState(resource) {
            if (resource.isNew) {
                return {
                    tone: "primary",
                    text: "Queued Upload",
                    detail: "Will be processed when you save this version."
                };
            }

            if (!resource.isActive) {
                return {
                    tone: "danger",
                    text: "Not Ready",
                    detail: "content item is not published"
                };
            }

            if (!resource.url) {
                return {
                    tone: "warning",
                    text: "Not Ready",
                    detail: "launch URL is missing"
                };
            }

            return {
                tone: "success",
                text: "Published",
                detail: "Ready to use in an active version."
            };
        }

        function renderContentReadinessCell(container, resource) {
            const state = getContentReadinessState(resource || {});
            window.renderAdminGridStatusCell(container, state.text, state.tone, { showDot: false });
        }

        function getExistingContentReadinessIssues() {
            return contentItems
                .filter(function(resource) {
                    return !resource.isNew;
                })
                .map(function(resource) {
                    const state = getContentReadinessState(resource);
                    if (state.text === "Published") {
                        return null;
                    }

                    return {
                        name: resource.name || "Unnamed content item",
                        reason: state.detail
                    };
                })
                .filter(function(issue) {
                    return issue !== null;
                });
        }

        function validateActiveVersionContentReadiness() {
            if (!willSaveVersionAsActive()) {
                return true;
            }

            const issues = getExistingContentReadinessIssues();
            if (!issues.length) {
                return true;
            }

            showVersionReadinessDialog(issues);
            return false;
        }

        function getVersionReadinessErrorMessage(xhr) {
            const message = window.getApiErrorMessage(xhr, "") || "";
            return /cannot activate this course version|learning (resources|content) are not ready|content items? are not ready|resource is not published|content item is not published|launch url is missing/i.test(message)
                ? message
                : "";
        }

        function showVersionReadinessDialog(issues) {
            const issueItems = issues.map(function(issue) {
                return `<li><strong>${window.escapeHtml(issue.name)}</strong> <span class="text-secondary">${window.escapeHtml(issue.reason)}</span></li>`;
            }).join('');

            const dialog = DevExpress.ui.dialog.custom({
                title: "Version Not Ready",
                messageHtml: `
                    <div class="text-start">
                        <div class="u-fs-12 text-secondary mb-2">This version cannot be saved as active until these linked content items are ready.</div>
                        <ul class="ps-3 mb-3 u-fs-11">${issueItems}</ul>
                        <div class="u-fs-11 text-secondary">Replace or remove the affected content items, or keep this version inactive until the content is published.</div>
                    </div>`,
                buttons: [
                    {
                        text: "Keep Version Inactive",
                        type: "default",
                        onClick: function() {
                            if (formWidget) {
                                formWidget.updateData("isActive", false);
                            }
                            return true;
                        }
                    },
                    {
                        text: "Keep Editing",
                        onClick: function() {
                            return false;
                        }
                    }
                ]
            });

            return dialog.show();
        }

        function showVersionReadinessServerDialog(message) {
            const dialog = DevExpress.ui.dialog.custom({
                title: "Version Not Ready",
                messageHtml: `
                    <div class="text-start">
                        <div class="u-fs-12 text-secondary mb-2">The server could not make all linked content items ready for this active save.</div>
                        <div class="u-fs-11 mb-3">${window.escapeHtml(message)}</div>
                        <div class="u-fs-11 text-secondary">Publish or replace the affected content, or keep this version inactive until the content is ready.</div>
                    </div>`,
                buttons: [
                    {
                        text: "Keep Version Inactive",
                        type: "default",
                        onClick: function() {
                            if (formWidget) {
                                formWidget.updateData("isActive", false);
                            }
                            return true;
                        }
                    },
                    {
                        text: "Keep Editing",
                        onClick: function() {
                            return false;
                        }
                    }
                ]
            });

            return dialog.show();
        }

        function renderVersionReview() {
            const existingCount = contentItems.filter(function(resource) {
                return !resource.isNew;
            }).length;
            const newCount = contentItems.filter(function(resource) {
                return resource.isNew;
            }).length;

            $("#review-total-content").text(contentItems.length);
            $("#review-existing-content").text(existingCount);
            $("#review-new-content").text(newCount);
            $("#review-content-table").html(buildReviewContentTable());
        }

        function buildReviewContentTable() {
            if (contentItems.length === 0) {
                return `
                    <div class="admin-wizard-empty-state">
                        <i class="fas fa-folder-open"></i>
                        <div>No content has been added yet.</div>
                    </div>`;
            }

            const rows = contentItems.map(function(resource, index) {
                const sourceText = resource.isNew ? "New upload" : "Content library";
                const sourceBadge = resource.isNew ? "pill-primary" : "pill-default";
                const readinessState = getContentReadinessState(resource);

                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td>
                            <div class="admin-review-item-name">${window.escapeHtml(resource.name)}</div>
                        </td>
                        <td><span class="tag-pill ${sourceBadge}">${window.escapeHtml(sourceText)}</span></td>
                        <td><span class="tag-pill ${resource.typeId === 1 ? 'pill-learn' : 'pill-exam'}">${window.escapeHtml(getContentTypeLabel(resource.typeId))}</span></td>
                        <td><span class="tag-pill pill-${window.escapeHtml(readinessState.tone)}">${window.escapeHtml(readinessState.text)}</span></td>
                    </tr>`;
            }).join('');

            return `
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Content Name</th>
                            <th>Source</th>
                            <th>Content Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>`;
        }

        function getContentTypeLabel(typeId) {
            return typeId === 2 ? "Exam" : "Learn";
        }

        function getSubmitUrl() {
            return IS_EDIT
                ? `${serviceUrl}/courses/versions/${VERSION_ID}`
                : `${serviceUrl}/courses/${COURSE_ID}/versions`;
        }

        function getSubmitMethod() {
            return IS_EDIT ? "PUT" : "POST";
        }
    </script>
}