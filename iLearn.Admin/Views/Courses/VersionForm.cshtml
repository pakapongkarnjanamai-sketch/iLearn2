@{
    ViewBag.Title = ViewBag.Id == null ? "Create New Version" : "Edit Version";
    var isEdit = ViewBag.Id != null;
    var courseId = ViewBag.CourseId;
}

<style>
    body {
        background-color: #f8f9fa;
    }

    /* Action Card Styles */
    .action-card {
        border: 2px dashed #e8ecf1;
        border-radius: 12px;
        background-color: #ffffff;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-align: center;
        padding: 2rem 1.5rem;
    }

        .action-card:hover {
            border-color: #0d6efd;
            background-color: #f8fbff;
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
        }

    /* Fixed Bottom Toolbar */
    .fixed-bottom-toolbar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #ffffff;
        padding: 1rem 2rem;
        box-shadow: 0 -4px 15px rgba(0,0,0,0.05);
        z-index: 1000;
        border-top: 1px solid #e8ecf1;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1rem;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                <i class="fas @(isEdit ? "fa-edit" : "fa-plus") fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted fw-medium">@(isEdit ? "Update version details and rearrange resources." : "Create a new version and manage learning materials.")</small>
            </div>
        </div>
        <button class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3 fw-medium" onclick="history.back()">
            <i class="fas fa-arrow-left me-1"></i> Back
        </button>
    </div>
</div>

<div class="container px-4 pb-5" style="margin-bottom: 80px;">
    <div id="load-panel"></div>

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-info-circle text-primary me-2"></i> Version Details
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div id="form-container"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-list text-primary me-2"></i> Course Content List
                    </h6>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-medium" id="total-count-badge">0 Items</span>
                </div>

                <div class="card-body p-4 pt-2">

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <a href="javascript:void(0);" id="btn-show-existing" class="action-card d-flex flex-column align-items-center justify-content-center text-decoration-none h-100">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 px-3 py-2 mb-3">
                                    <i class="fas fa-search fs-4"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Select Existing Resources</h6>
                                <p class="text-muted small mb-0">Choose files from the central library.</p>
                            </a>
                        </div>

                        <div class="col-md-6">
                            <a href="javascript:void(0);" id="btn-trigger-upload" class="action-card d-flex flex-column align-items-center justify-content-center text-decoration-none h-100">
                                <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 px-3 py-2 mb-3">
                                    <i class="fas fa-cloud-upload-alt fs-4"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">Upload New SCORM</h6>
                                <p class="text-muted small mb-0">Drag & drop or click to browse .zip</p>
                            </a>
                            <div id="file-uploader-container"></div>
                        </div>
                    </div>

                    <div class="text-muted small fw-medium mb-3">
                        <i class="fas fa-info-circle text-primary me-1"></i> You can drag & drop rows to reorder the content, and click on Type to change it for new files.
                    </div>

                    <div class="border border-light rounded-3 overflow-hidden">
                        <div id="master-resources-grid"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="fixed-bottom-toolbar">
    <div class="d-flex align-items-center text-muted small fw-medium me-auto d-none d-md-flex">
        <i class="fas fa-check-circle text-success me-2"></i> Verify content order before saving.
    </div>
    <button type="button" class="btn btn-light border px-4 py-2 shadow-sm rounded-3 fw-medium" onclick="history.back()">Cancel</button>
    <div id="btn-save"></div>
</div>

<div id="popup-existing"></div>

@section Scripts {
    <script>
        const COURSE_ID = parseInt('@courseId');
        const VERSION_ID = @(ViewBag.Id != null ? ViewBag.Id : "null");
        const IS_EDIT = VERSION_ID !== null;
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        let formWidget;
        let masterGrid;
        let gridExisting;
        let unifiedResources = [];

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)", position: { of: "body" }, visible: false, showIndicator: true, showPane: true, shading: true
            }).dxLoadPanel("instance");

            // --- 1. Form ด้านบน ---
            formWidget = $("#form-container").dxForm({
                formData: { courseId: COURSE_ID, isActive: true },
                colCount: 1, labelMode: "floating", stylingMode: "outlined",
                items: [
                    { dataField: "note", editorType: "dxTextArea", label: { text: "Version Name / Note" }, editorOptions: { height: 90, placeholder: "e.g. Added new V2 materials" }, validationRules: [{ type: "required", message: "Required" }] },
                    { dataField: "isActive", editorType: "dxCheckBox", label: { text: "Status", visible: false }, editorOptions: { text: "Set as Active Version" } }
                ]
            }).dxForm("instance");

            // --- 2. Master Grid (ตารางหลัก รองรับการคลิกแก้ Type ได้สำหรับไฟล์ใหม่) ---
            masterGrid = $("#master-resources-grid").dxDataGrid({
                dataSource: unifiedResources,
                keyExpr: "uid",
                showBorders: false,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: "No content added yet. Click buttons above to add.",
                editing: {
                    mode: "cell", // เปิดโหมดแก้ไขแบบคลิกที่เซลล์
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    // อนุญาตให้แก้ได้เฉพาะคอลัมน์ Type และต้องเป็นไฟล์ใหม่ (isNew) เท่านั้น
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = unifiedResources.findIndex(item => item.uid === visibleRows[e.toIndex].data.uid);
                        const fromIndex = unifiedResources.findIndex(item => item.uid === e.itemData.uid);
                        unifiedResources.splice(fromIndex, 1);
                        unifiedResources.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("text-muted fw-bold").text(options.rowIndex + 1).appendTo(container);
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const isNew = data.isNew;
                            const iconClass = isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            if(isNew) {
                                wrapper.append($("<span>").addClass("badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2 py-0 ms-2").css("font-size", "0.7rem").text("New"));
                            }
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Type (Click to edit)", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const tName = data.typeId === 1 ? "Learn" : (data.typeId === 2 ? "Exam" : "Unknown");
                            const badgeClass = data.typeId === 1 ? "bg-info text-info border-info" : "bg-warning text-warning border-warning";

                            // ถ้าเป็นไฟล์ใหม่ ให้เพิ่มไอคอนลูกศรชี้ลง และเปลี่ยนเคอร์เซอร์เพื่อให้รู้ว่ากดแก้ได้
                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const cursorStyle = data.isNew ? "cursor: pointer;" : "cursor: default;";
                            const tooltip = data.isNew ? "Click to change type" : "Existing resource type cannot be changed here";

                            $("<div>")
                                .addClass(`badge ${badgeClass} bg-opacity-10 border border-opacity-25 px-3 py-1 rounded-pill fw-medium`)
                                .attr("style", cursorStyle)
                                .attr("title", tooltip)
                                .html(`${tName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                unifiedResources = unifiedResources.filter(r => r.uid !== e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            }).dxDataGrid("instance");

            function refreshMasterGrid() {
                masterGrid.option("dataSource", unifiedResources);
                $("#total-count-badge").text(`${unifiedResources.length} Items`);
            }

            // --- 3. Popup สำหรับเลือกไฟล์เก่า ---
            const popupExisting = $("#popup-existing").dxPopup({
                title: "Select Existing Resources",
                width: "90vw", maxWidth: 1100, height: "85vh",
                showCloseButton: true, dragEnabled: true,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='grid-existing-pick' style='height:100%;'>").appendTo(contentElement);
                    gridExisting = gridContainer.dxDataGrid({
                        dataSource: resourcesStore,
                        remoteOperations: true,
                        showBorders: false, showRowLines: true, rowAlternationEnabled: true,
                        hoverStateEnabled: true,
                        height: "100%",
                        scrolling: { mode: "virtual" },
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        searchPanel: { visible: true, placeholder: "Search by name or type...", width: 280 },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Resource Name", minWidth: 200,
                                cellTemplate: function(container, options) {
                                    $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                                }
                            },
                            {
                                dataField: "typeId", caption: "Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearn = options.value === 1;
                                    const text = isLearn ? "Learn" : "Exam";
                                    const badgeClass = isLearn ? "bg-info text-info border-info" : "bg-warning text-warning border-warning";
                                    $("<span>").addClass(`badge ${badgeClass} bg-opacity-10 border border-opacity-25 px-3 py-1 rounded-pill fw-medium`).text(text).appendTo(container);
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(d) { return (d.courseResources || []).length; },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    const cls = count > 0
                                        ? "bg-success bg-opacity-10 text-success border-success"
                                        : "bg-secondary bg-opacity-10 text-secondary border-secondary";
                                    $("<span>")
                                        .addClass(`badge ${cls} border border-opacity-25 rounded-pill px-2 fw-medium`)
                                        .html(`<i class="fas fa-book me-1"></i>${count}`)
                                        .appendTo(container);
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                cellTemplate: function(container, options) {
                                    if (!options.value) return;
                                    const d = new Date(options.value);
                                    const formatted = d.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" })
                                        + " " + d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
                                    $("<span>").addClass("text-muted small").text(formatted).appendTo(container);
                                }
                            }
                        ]
                    }).dxDataGrid("instance");
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                const selectedData = gridExisting.getSelectedRowsData();
                                selectedData.forEach(item => {
                                    if (!unifiedResources.some(r => !r.isNew && r.realId === item.id)) {
                                        unifiedResources.push({
                                            uid: `EXISTING_${item.id}`,
                                            realId: item.id,
                                            name: item.name,
                                            typeId: item.typeId,
                                            isNew: false
                                        });
                                    }
                                });
                                refreshMasterGrid();
                                gridExisting.clearSelection();
                                popupExisting.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").click(() => popupExisting.show());

            // --- 4. อัปโหลดไฟล์ใหม่ ---
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false, accept: ".zip", uploadMode: "useForm", multiple: true,
                onValueChanged: function(e) {
                    if(e.value && e.value.length > 0) {
                        e.value.forEach((file, index) => {
                            unifiedResources.push({
                                uid: `NEW_${Date.now()}_${index}`,
                                name: file.name,
                                isNew: true,
                                typeId: 1, // 🌟 Default เป็น 1 (Learn) ให้คลิกแก้ใน Grid ทีหลัง
                                fileRef: file
                            });
                        });
                        e.component.reset();
                        refreshMasterGrid();
                        DevExpress.ui.notify("File added to queue", "success", 2000);
                    }
                }
            });

            // --- 5. โหลดข้อมูล (เฉพาะโหมดแก้ไข) ---
            if (IS_EDIT) {
                loadPanel.show();
                $.ajax({
                    url: `${serviceUrl}/courses/versions/${VERSION_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(response) {
                    let detailData = response.data || response;
                    formWidget.option("formData", { note: detailData.note, isActive: detailData.isActive });
                    let resourceIds = detailData.resourceIds || [];

                    if (resourceIds.length > 0) {
                        resourcesStore.load().done(function(res) {
                            const allResources = res.data || res || [];
                            resourceIds.forEach(rId => {
                                const resource = allResources.find(r => r.id === rId);
                                if(resource) {
                                    unifiedResources.push({
                                        uid: `EXISTING_${rId}`, realId: rId,
                                        name: resource.name, typeId: resource.typeId, isNew: false
                                    });
                                }
                            });
                            refreshMasterGrid();
                        }).fail(() => DevExpress.ui.notify("Error loading resource details", "error", 3000));
                    }
                }).fail(function(xhr) {
                    DevExpress.ui.notify(xhr.responseJSON?.message || "Error loading version", "error", 3000);
                }).always(() => loadPanel.hide());
            }

            // --- 6. บันทึกข้อมูล ---
            $("#btn-save").dxButton({
                text: IS_EDIT ? "Save Changes" : "Create Version",
                icon: "save", type: "default", stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 py-1 btn-primary rounded-3 fw-medium" },
                onClick: () => submitData()
            });

            function submitData() {
                if (!formWidget.validate().isValid) { DevExpress.ui.notify("Please fill in required fields.", "warning", 3000); return; }
                if (unifiedResources.length === 0) { DevExpress.ui.notify("Please add at least one resource.", "error", 3000); return; }

                loadPanel.option("message", "Saving version & processing files...");
                loadPanel.show();

                const data = formWidget.option("formData");
                let formDataObj = new FormData();
                formDataObj.append("courseId", COURSE_ID);
                formDataObj.append("note", data.note);
                formDataObj.append("isActive", data.isActive || false);

                unifiedResources.forEach((item) => {
                    if (item.isNew) {
                        formDataObj.append("Files", item.fileRef);
                        formDataObj.append("ResourceIds", 0);
                    } else {
                        formDataObj.append("ResourceIds", item.realId);
                    }

                    // 🌟 ส่งค่า Type ของแต่ละไฟล์ไปด้วย
                    formDataObj.append("ResourceTypes", item.typeId);
                });

                const url = IS_EDIT ? `${serviceUrl}/courses/versions/${VERSION_ID}` : `${serviceUrl}/courses/${COURSE_ID}/versions`;
                const method = IS_EDIT ? "PUT" : "POST";

                $.ajax({
                    url: url, method: method, data: formDataObj,
                    processData: false, contentType: false, xhrFields: { withCredentials: true }
                }).done(function(response) {
                    DevExpress.ui.notify("Saved successfully!", "success", 2000);
                    setTimeout(() => window.location.href = '@Url.Action("Dashboard", "Courses")?id=' + COURSE_ID, 1200);
                }).fail(function(xhr) {
                    DevExpress.ui.notify("Error: " + (xhr.responseJSON?.message || "Failed to save"), "error", 4000);
                }).always(() => loadPanel.hide());
            }
        });
    </script>
}