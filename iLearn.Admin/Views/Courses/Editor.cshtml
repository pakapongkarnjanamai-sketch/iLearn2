@{
    ViewBag.Title = (ViewBag.Id == null ? "New Course" : "Edit Course");
    var isEdit = ViewBag.Id != null;
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    /* ── Unique: Content preview note ── */
    .course-content-preview {
        font-size: var(--font-size-caption);
        color: var(--text-secondary);
    }

    /* ── Unique: Review table scroll height ── */
    .course-review-table-wrap {
        --admin-table-wrap-max-height: clamp(220px, calc(100vh - 520px), 360px);
    }
</style>

<!-- ── Page Header ── -->
<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-book text-primary me-2" aria-hidden="true"></i>@ViewBag.Title</h1>
    @if (!isEdit)
    {
        <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
            <div class="admin-step-card active" data-step-card="1" aria-current="step">
                <div class="admin-step-title"><span class="admin-step-index">1</span>Information</div>
            </div>
            <div class="admin-step-card" data-step-card="2">
                <div class="admin-step-title"><span class="admin-step-index">2</span>Content</div>
            </div>
            <div class="admin-step-card" data-step-card="3">
                <div class="admin-step-title"><span class="admin-step-index">3</span>Review</div>
            </div>
        </div>
    }
    @if (isEdit)
    {
        <div class="admin-page-header-actions">
            <a href="@Url.Action("Index", "Courses")" class="action-link">
                <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
            </a>
            <button type="button" id="btn-save" class="action-link primary">
                <i class="fas fa-save" aria-hidden="true"></i> Save Changes
            </button>
        </div>
    }
    else
    {
        <div class="admin-page-header-actions">
            <a href="@Url.Action("Index", "Courses")" class="action-link">
                <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
            </a>
            <button type="button" id="btn-previous-step" class="action-link d-none">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
            </button>
            <button type="button" id="btn-next-step" class="action-link primary">
                <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
            </button>
            <button type="button" id="btn-create-course" class="action-link primary d-none">
                <i class="fas fa-save" aria-hidden="true"></i> Create Course
            </button>
        </div>
    }
</div>

@if (isEdit)
{
    <div class="container page-shell-md px-4 py-4">
        <div id="load-panel"></div>

        <div class="border rounded bg-white d-flex flex-column mb-3">
            <div class="p-3">
                <div class="admin-section-header">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Course Information</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>
            </div>
            <div class="px-3 pb-3">
                <div id="form-container"></div>
            </div>
        </div>

        <div class="border rounded bg-white d-flex flex-column">
            <div class="p-3">
                <div class="admin-section-header">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Course Content</div>
                        <span class="tag-pill pill-default admin-section-meta" id="total-count-badge">0 item</span>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>
            </div>

            <div class="px-3 pb-3">
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing" role="button" tabindex="0">
                            <i class="fas fa-search fa-lg target-card-icon"></i>
                            <div class="fw-bold text-dark target-card-title">Select Existing Content</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload" role="button" tabindex="0">
                            <i class="fas fa-cloud-upload-alt fa-lg target-card-icon"></i>
                            <div class="fw-bold text-dark target-card-title">Upload New SCORM</div>
                        </div>
                        <div id="file-uploader-container"></div>
                    </div>
                </div>

                <div class="admin-compat-note mb-3">
                    <div class="admin-compat-note-title">SCORM Compatibility</div>
                    <ul class="admin-compat-note-list">
                        <li>Accepts SCORM 1.2 and SCORM 2004 ZIP packages only.</li>
                        <li>Supports import, launch, runtime commit, and resume for SCORM 1.2 and SCORM 2004 content.</li>
                        <li><code>imsmanifest.xml</code> may be at the ZIP root or inside a package folder.</li>
                        <li>Resume depends on the package writing bookmark or suspend data and calling Commit or Terminate.</li>
                        <li>Uses one launch SCO per content item; full SCORM 2004 sequencing and multi-SCO navigation are not orchestrated.</li>
                        <li>Limits: 100 MB ZIP, 1,000 archive entries, 100 MB per file, 250 MB expanded.</li>
                    </ul>
                </div>

                <div class="border rounded overflow-hidden">
                    <div id="content-items-grid"></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow admin-viewport-layout">
        <div id="load-panel"></div>

        <div class="admin-review-main-col admin-responsive-content">
            <div class="border rounded bg-white p-3 admin-viewport-fill">
                    <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="form">
                        <div class="admin-section-header mb-2">
                            <div class="admin-section-header-main">
                                <div class="section-title mb-0 admin-section-title-fill">Course Information</div>
                            </div>
                            <div class="admin-section-divider"></div>
                        </div>
                        <div class="admin-detail-card">
                            <div id="form-container"></div>
                        </div>
                    </div>

                    <div id="step-panel-2" class="admin-wizard-panel admin-wizard-panel--grid-fill" data-step-layout="wide">
                        <div class="admin-section-header mb-2">
                            <div class="admin-section-header-main">
                                <div class="section-title mb-0 admin-section-title-fill">Course Content</div>
                            </div>
                            <div class="admin-section-divider"></div>
                        </div>

                        <div class="admin-detail-card">
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-show-existing" role="button" tabindex="0">
                                        <i class="fas fa-search fa-lg target-card-icon"></i>
                                        <div class="fw-bold text-dark target-card-title">Select Existing Content</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="target-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-trigger-upload" role="button" tabindex="0">
                                        <i class="fas fa-cloud-upload-alt fa-lg target-card-icon"></i>
                                        <div class="fw-bold text-dark target-card-title">Upload New SCORM</div>
                                    </div>
                                    <div id="file-uploader-container"></div>
                                </div>
                            </div>

                            <div class="admin-compat-note mb-3">
                                <div class="admin-compat-note-title">SCORM Compatibility</div>
                                <ul class="admin-compat-note-list">
                                    <li>Accepts SCORM 1.2 and SCORM 2004 ZIP packages only.</li>
                                    <li>Supports import, launch, runtime commit, and resume for SCORM 1.2 and SCORM 2004 content.</li>
                                    <li><code>imsmanifest.xml</code> may be at the ZIP root or inside a package folder.</li>
                                    <li>Resume depends on the package writing bookmark or suspend data and calling Commit or Terminate.</li>
                                    <li>Uses one launch SCO per content item; full SCORM 2004 sequencing and multi-SCO navigation are not orchestrated.</li>
                                    <li>Limits: 100 MB ZIP, 1,000 archive entries, 100 MB per file, 250 MB expanded.</li>
                                </ul>
                            </div>

                            <div class="admin-grid-shell overflow-hidden">
                                <div class="admin-grid-head">
                                    <div class="admin-grid-title">Selected Content</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="tag-pill pill-default" id="total-count-badge">0 item</span>
                                    </div>
                                </div>
                                <div id="content-items-grid" class="admin-grid-fill"></div>
                            </div>
                        </div>
                    </div>

                    <div id="step-panel-3" class="admin-wizard-panel" data-step-layout="review">
                        <div class="admin-section-header admin-review-header">
                            <div class="admin-section-header-main">
                                <div class="section-title mb-0 admin-section-title-fill">Review And Confirm</div>
                            </div>
                            <div class="admin-section-divider"></div>
                        </div>

                        <div class="admin-review-stack">
                            <div class="admin-summary-grid">
                                <div class="admin-summary-item">
                                    <div class="admin-summary-value" id="review-total-content">0</div>
                                    <div class="admin-summary-label">Total Content Items</div>
                                </div>
                                <div class="admin-summary-item">
                                    <div class="admin-summary-value" id="review-existing-content">0</div>
                                    <div class="admin-summary-label">Existing Content</div>
                                </div>
                                <div class="admin-summary-item">
                                    <div class="admin-summary-value" id="review-new-content">0</div>
                                    <div class="admin-summary-label">New Uploads</div>
                                </div>
                            </div>

                            <div class="admin-detail-card">
                                <div class="section-title mb-2">Course Details</div>
                                <div id="form-review-details"></div>
                            </div>

                            <div class="admin-table-shell">
                                <div class="admin-table-head">
                                    <div class="admin-table-title">Content Review</div>
                                </div>
                                <div class="admin-table-wrap course-review-table-wrap" id="review-content-table"></div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
}

<div id="content-picker-popup"></div>

@section Scripts {
    <script>
        const COURSE_ID = @(ViewBag.Id ?? "null");
        const IS_EDIT = COURSE_ID != null;
        const COURSE_INDEX_URL = '@Url.Action("Index", "Courses")';
        const COURSE_CREATE_API_URL = `${serviceUrl}/courses/Create`;

        /* Height Settings */
        const DESCRIPTION_FIELD_HEIGHT = 120;
        const CONTENT_GRID_HEIGHT = "100%";
        const CONTENT_LIBRARY_GRID_HEIGHT = 520;
        const TOTAL_WIZARD_STEPS = 3;

        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const contentLibraryStore = createDataStore(serviceUrl, 'admin/ContentItemsCRUD', { key: 'id' });
        const courseTypesStore = createDataStore(serviceUrl, 'Courses', {
            key: 'id',
            loadUrl: `${serviceUrl}/Courses/course-types-lookup`
        });

        let formWidget;
        let masterGrid;
        let contentPickerGrid;
        let contentItems = [];
        let contentPickerPopup;
        let loadPanel;
        let reviewForm;
        let gridViewportController = null;
        const createState = {
            currentStep: 1
        };

        $(async () => {
            let formData = { courseType: 1, isActive: true };

            loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading data..."
            }).dxLoadPanel("instance");

            if (IS_EDIT) {
                formData = await loadCourseFormData(formData);
            }

            initializeCourseForm(formData);
            await syncCategoryEditor(formData.divisionId);
            initializeMasterGrid();
            initializeExistingContentPopup();
            initializeFileUploader();
            initializeReviewForm();

            if (IS_EDIT) {
                initializeSaveButton();
            } else {
                initializeCreateWizard();
                updateCreateWizardUi();
            }

            refreshMasterGrid();
            updateCourseSnapshot();
            renderCourseReview();
        });

        function initializeReviewForm() {
            if (IS_EDIT) {
                return;
            }

            reviewForm = $("#form-review-details").dxForm({
                readOnly: true,
                labelMode: "floating",
                stylingMode: "outlined",
                colCount: 2,
                formData: { courseType: "", courseCode: "", courseName: "", division: "", category: "", description: "" },
                items: [
                    { dataField: "courseType", label: { text: "Course Type" } },
                    { dataField: "courseCode", label: { text: "Course Code" } },
                    { dataField: "courseName", label: { text: "Course Title" }, colSpan: 2 },
                    { dataField: "division", label: { text: "Division" } },
                    { dataField: "category", label: { text: "Category" } },
                    {
                        dataField: "description",
                        label: { text: "Description" },
                        colSpan: 2,
                        editorType: "dxTextArea",
                        editorOptions: { height: DESCRIPTION_FIELD_HEIGHT }
                    }
                ]
            }).dxForm("instance");
        }

        function initializeCourseForm(formData) {
            formWidget = $("#form-container").dxForm({
                formData: formData,
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                onFieldDataChanged: function() {
                    updateCourseSnapshot();
                    renderCourseReview();
                },
                items: [
                    {
                        itemType: "group",
                        items: [
                            {
                                dataField: "courseType",
                                label: { text: "Course Type" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: courseTypesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    placeholder: "Select Type"
                                },
                                validationRules: [{ type: "required", message: "Course Type is required" }]
                            },
                            {
                                dataField: "courseCode",
                                label: { text: "Course Code" },
                                validationRules: [{ type: "required", message: "Course Code is required" }],
                                editorOptions: { placeholder: "e.g. CS-101" }
                            },
                            {
                                dataField: "courseName",
                                label: { text: "Course Title" },
                                validationRules: [{ type: "required", message: "Course Name is required" }],
                                editorOptions: { placeholder: "e.g. Intro to Cybersecurity" }
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "divisionId",
                                label: { text: "Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionsStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    placeholder: "Select Division",
                                    onValueChanged: async function(e) {
                                        if (e.event) {
                                            getCategoryEditor().option("value", null);
                                        }

                                        await syncCategoryEditor(e.value);
                                        updateCourseSnapshot();
                                        renderCourseReview();
                                    }
                                }
                            },
                            {
                                dataField: "categoryId",
                                label: { text: "Category" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: categoriesStore,
                                    displayExpr: "name",
                                    valueExpr: "id",
                                    disabled: !formData.divisionId,
                                    placeholder: "Select Category"
                                },
                                validationRules: [{ type: "required", message: "Category is required" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        items: [
                            {
                                dataField: "description",
                                label: { text: "Description" },
                                editorType: "dxTextArea",
                                editorOptions: {
                                    height: DESCRIPTION_FIELD_HEIGHT,
                                    placeholder: "Course summary and objectives..."
                                }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");
        }

        function initializeMasterGrid() {
            masterGrid = initDxGrid("#content-items-grid", {
                dataSource: contentItems,
                keyExpr: "uid",
                height: CONTENT_GRID_HEIGHT,
                showBorders: true,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                showRowLines: true,
                columnAutoWidth: true,
                noDataText: getNoDataText("content"),
                editing: {
                    mode: "cell",
                    allowUpdating: true
                },
                onEditorPreparing: function(e) {
                    if (e.parentType === "dataRow") {
                        if (e.dataField !== "typeId" || !e.row.data.isNew) {
                            e.editorOptions.disabled = true;
                        }
                    }
                },
                rowDragging: {
                    allowReordering: true,
                    showDragIcons: true,
                    onReorder: function(e) {
                        const visibleRows = e.component.getVisibleRows();
                        const toIndex = contentItems.findIndex(function(item) {
                            return item.uid === visibleRows[e.toIndex].data.uid;
                        });
                        const fromIndex = contentItems.findIndex(function(item) {
                            return item.uid === e.itemData.uid;
                        });

                        contentItems.splice(fromIndex, 1);
                        contentItems.splice(toIndex, 0, e.itemData);
                        e.component.refresh();
                        refreshMasterGrid();
                    }
                },
                columns: [
                    {
                        caption: "Order", width: 80, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            window.renderAdminGridTextCell(container, options.rowIndex + 1, "captionMuted", { fontWeight: "700" });
                        }
                    },
                    {
                        dataField: "name", caption: "Content Name", allowEditing: false,
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const isNew = data.isNew;
                            const iconClass = isNew ? "fa-file-upload text-primary" : "fa-file-archive text-secondary";

                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass(`fas ${iconClass} opacity-75`))
                                .append($("<span>").addClass("fw-medium text-dark text-truncate").text(data.name));

                            if (isNew) {
                                window.renderAdminGridTextCell(wrapper, 'New', 'xsAccent', { marginLeft: '8px' });
                            }

                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "typeId", caption: "Content Type", width: 180, alignment: "center",
                        lookup: {
                            dataSource: [
                                { id: 1, name: "Learn" },
                                { id: 2, name: "Exam" }
                            ],
                            displayExpr: "name",
                            valueExpr: "id"
                        },
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const typeName = getContentTypeLabel(data.typeId);
                            const editHint = data.isNew ? '<i class="fas fa-caret-down ms-2 opacity-50"></i>' : '';
                            const tooltip = data.isNew ? "Click to change content type" : "Existing content type cannot be changed here";

                            $('<div>').css(window.getAdminGridTextStyle(data.typeId === 1 ? 'captionAccent' : 'captionWarning', {
                                cursor: data.isNew ? 'pointer' : 'default'
                            }))
                                .attr("title", tooltip)
                                .html(`${typeName} ${editHint}`)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Status", width: 150, alignment: "center", allowEditing: false,
                        cellTemplate: function(container, options) {
                            renderContentReadinessCell(container, options.data);
                        }
                    },
                    {
                        type: "buttons", width: 80, alignment: "center", allowEditing: false,
                        buttons: [{
                            icon: "trash", hint: "Remove from list",
                            onClick: function(e) {
                                removeContentItem(e.row.data.uid);
                                refreshMasterGrid();
                            }
                        }]
                    }
                ]
            });
        }

        function initializeExistingContentPopup() {
            contentPickerPopup = $("#content-picker-popup").dxPopup({
                title: "Select Existing Content",
                width: "90vw",
                maxWidth: 1080,
                height: "auto",
                maxHeight: "90vh",
                disableGlobalHeightSizing: true,
                showCloseButton: true,
                dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    if (contentPickerGrid) {
                        contentPickerGrid.updateDimensions();
                    }
                },
                contentTemplate: function(contentElement) {
                    const gridContainer = $("<div id='content-library-grid'>").appendTo(contentElement);
                    contentPickerGrid = initDxGrid(gridContainer, {
                        preset: "selectionGrid",
                        dataSource: contentLibraryStore,
                        remoteOperations: true,
                        height: CONTENT_LIBRARY_GRID_HEIGHT,
                        searchPanel: { placeholder: "Search by name or content type..." },
                        sorting: { mode: "multiple" },
                        columns: [
                            {
                                dataField: "name", caption: "Content Name", minWidth: 200,
                                cssClass: "fw-medium text-dark"
                            },
                            {
                                dataField: "typeId", caption: "Content Type", width: 110, alignment: "center",
                                cellTemplate: function(container, options) {
                                    const isLearningType = options.value === 1;
                                    const text = isLearningType ? "Learn" : "Exam";
                                    window.renderAdminGridStatusCell(container, text, isLearningType ? 'primary' : 'warning', { showDot: false });
                                }
                            },
                            {
                                caption: "Status", width: 130, alignment: "center",
                                cellTemplate: function(container, options) {
                                    renderContentReadinessCell(container, options.data);
                                }
                            },
                            {
                                caption: "Used In", width: 100, alignment: "center", allowSorting: true,
                                calculateCellValue: function(d) { return (d.courseContentItems || []).length; },
                                cellTemplate: function(container, options) {
                                    const count = options.value;
                                    window.renderAdminGridTextCell(container, count, count > 0 ? 'captionSuccess' : 'captionMuted');
                                }
                            },
                            {
                                dataField: "createdAt", caption: "Created", width: 155, alignment: "center",
                                dataType: "datetime",
                                sortOrder: "desc", sortIndex: 0,
                                format: ADMIN_DATETIME_DISPLAY_FORMAT,
                                cssClass: "cell-muted"
                            }
                        ]
                    });
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Add Selected", type: "default", stylingMode: "contained", icon: "check",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                addExistingContentItems(contentPickerGrid.getSelectedRowsData());
                                refreshMasterGrid();
                                contentPickerGrid.clearSelection();
                                contentPickerPopup.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-show-existing").on("click", function() {
                contentPickerPopup.show();
            }).on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); $(this).click(); }
            });
        }

        function initializeFileUploader() {
            $("#file-uploader-container").dxFileUploader({
                dialogTrigger: "#btn-trigger-upload",
                dropZone: "#btn-trigger-upload",
                visible: false,
                accept: ".zip",
                uploadMode: "useForm",
                multiple: true,
                onValueChanged: function(e) {
                    if (!e.value || e.value.length === 0) {
                        return;
                    }

                    addNewFiles(e.value);
                    e.component.reset();
                    refreshMasterGrid();
                    showToast("File added to queue", "success", 2000);
                }
            });

            $("#btn-trigger-upload").on("keydown", function(e) {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); $(this).click(); }
            });
        }

        function initializeSaveButton() {
            $("#btn-save").on("click", function() {
                submitData();
            });
        }

        function initializeCreateWizard() {
            $("#btn-previous-step").on("click", function() {
                if (createState.currentStep <= 1) {
                    return;
                }

                createState.currentStep -= 1;
                updateCreateWizardUi();
            });

            $("#btn-next-step").on("click", function() {
                handleNextStep();
            });

            $("#btn-create-course").on("click", function() {
                submitData();
            });
        }

        function refreshMasterGrid() {
            masterGrid.option("dataSource", contentItems);
            const count = contentItems.length;
            const countLabel = `${count} ${count === 1 ? "item" : "items"}`;
            $("#total-count-badge").text(countLabel);
            $("#snapshot-content-count").text(`${countLabel} selected`);
            updateCourseSnapshot();
            renderCourseReview();
        }

        function handleNextStep() {
            if (createState.currentStep === 1 && !validateCourseDetailsStep()) {
                return;
            }

            if (createState.currentStep === 2 && !validateCourseContentStep()) {
                return;
            }

            if (createState.currentStep < TOTAL_WIZARD_STEPS) {
                createState.currentStep += 1;
                updateCreateWizardUi();
            }
        }

        function getCourseStepNote(step) {
            switch (step) {
                case 1:
                    return 'Enter course details before continuing.';
                case 2:
                    return 'Add content items to the course list.';
                case 3:
                    return 'Review course details and content before creating.';
                default:
                    return '';
            }
        }

        function updateCreateWizardUi() {
            $("[data-step-card]").each(function() {
                const step = Number($(this).data("stepCard"));
                $(this).toggleClass("active", step === createState.currentStep);
                $(this).toggleClass("complete", step < createState.currentStep);
                if (step === createState.currentStep) {
                    $(this).attr("aria-current", "step");
                } else {
                    $(this).removeAttr("aria-current");
                }
            });

            $(".admin-wizard-panel").removeClass("active");
            $(`#step-panel-${createState.currentStep}`).addClass("active");
            const layout = $(`#step-panel-${createState.currentStep}`).attr("data-step-layout") || "wide";
            $(".admin-wizard-shell")
                .toggleClass("is-grid-step", createState.currentStep === 2)
                .toggleClass("is-form-step", layout === "form")
                .toggleClass("is-review-step", layout === "review");

            gridViewportController = window.toggleAdminViewportLayout(gridViewportController, createState.currentStep === 2, {
                layoutSelector: ".admin-wizard-shell.admin-viewport-layout",
                contentSelector: ".admin-review-main-col.admin-responsive-content",
                refreshTargets: [masterGrid]
            });

            $("#btn-previous-step").toggleClass("d-none", createState.currentStep <= 1);
            $("#btn-next-step").toggleClass("d-none", createState.currentStep >= TOTAL_WIZARD_STEPS);
            $("#btn-create-course").toggleClass("d-none", createState.currentStep !== TOTAL_WIZARD_STEPS);

            $(".bottom-toolbar-note").html(`<i class="fas fa-info-circle text-muted me-1" aria-hidden="true"></i> ${getCourseStepNote(createState.currentStep)}`);

            if (createState.currentStep === 2 && masterGrid) {
                masterGrid.updateDimensions();
            }

            if (createState.currentStep === 3) {
                renderCourseReview();
            }
        }

        function validateCourseDetailsStep() {
            const validation = formWidget.validate();
            if (!validation.isValid) {
                showToast("Please complete the required course information before continuing.", "warning", 2500);
                return false;
            }

            return true;
        }

        function validateCourseContentStep() {
            if (contentItems.length === 0) {
                showToast("Please add at least one content item before reviewing the course.", "warning", 3000);
                return false;
            }

            return true;
        }

        async function submitData() {
            if (!formWidget.validate().isValid) {
                showToast("Please fill in all required course details.", "warning", 2000);
                return;
            }

            if (contentItems.length === 0) {
                showToast("Please add at least one content item.", "error", 4000);
                return;
            }

            const submitButtonSelector = IS_EDIT ? "#btn-save" : "#btn-create-course";
            setButtonLoading(submitButtonSelector, true, IS_EDIT ? "Saving..." : "Creating...");
            loadPanel.option("message", "Saving course details...");
            loadPanel.show();
            let savedCourseId = null;

            try {
                const persistedCourseId = await saveCourse();
                savedCourseId = persistedCourseId;

                loadPanel.option("message", "Preparing content...");
                const activeVersionId = await getActiveVersionId(persistedCourseId);

                loadPanel.option("message", "Uploading files and processing SCORM...");
                await saveContentItemsToVersion(persistedCourseId, activeVersionId);

                showToast("Course and content saved successfully!", "success", 2000);
                setTimeout(function() {
                    window.location.href = COURSE_INDEX_URL;
                }, 1000);
            } catch (err) {
                console.error(err);
                const fallbackMessage = !IS_EDIT && savedCourseId
                    ? "Course was saved as a draft, but some content is not ready yet. Review the upload error and try again."
                    : "Request failed";
                showToast(`Error: ${window.getApiErrorMessage(err, fallbackMessage)}`, "error", 5000);
            } finally {
                loadPanel.hide();
                setButtonLoading(submitButtonSelector, false);
            }
        }

        async function loadCourseFormData(defaultFormData) {
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${serviceUrl}/courses/${COURSE_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });
                const courseData = response.data || response;

                addExistingContentItems(courseData.contentItems || []);

                const resolvedDivisionId = await resolveDivisionId(courseData);

                return {
                    ...defaultFormData,
                    ...courseData,
                    divisionId: resolvedDivisionId
                };
            } catch (err) {
                console.error(err);
                showToast("Error loading course data", "error");
                return defaultFormData;
            } finally {
                loadPanel.hide();
            }
        }

        function getCategoryEditor() {
            return formWidget.getEditor("categoryId");
        }

        async function syncCategoryEditor(divisionId) {
            const categoryEditor = getCategoryEditor();
            if (!divisionId) {
                categoryEditor.option("disabled", true);
                categoryEditor.option("value", null);
                return;
            }

            categoryEditor.option("disabled", false);

            const categoryDataSource = categoryEditor.getDataSource();
            categoryDataSource.filter(["divisionId", "=", divisionId]);
            await categoryDataSource.load();

            const currentValue = categoryEditor.option("value");
            if (!currentValue) {
                return;
            }

            const exists = categoryDataSource.items().some(function(item) {
                return item.id === currentValue;
            });

            if (!exists) {
                categoryEditor.option("value", null);
            }
        }

        async function resolveDivisionId(courseData) {
            if (courseData.divisionId || !courseData.categoryId) {
                return courseData.divisionId || null;
            }

            try {
                const response = await $.ajax({
                    url: `${serviceUrl}/admin/CategoriesCRUD/Get/${courseData.categoryId}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });
                const categoryData = response.data || response;

                return categoryData.divisionId || null;
            } catch {
                return null;
            }
        }

        function createExistingContentItem(contentItem) {
            return {
                uid: `EXISTING_${contentItem.id}`,
                realId: contentItem.id,
                name: contentItem.name,
                typeId: contentItem.typeId,
                isNew: false,
                isActive: !!contentItem.isActive,
                url: contentItem.url || null
            };
        }

        function createUploadedContentItem(file, suffix) {
            return {
                uid: `NEW_${Date.now()}_${suffix}`,
                name: file.name,
                isNew: true,
                typeId: 1,
                fileRef: file
            };
        }

        function addExistingContentItems(contentItems) {
            contentItems.forEach(function(contentItem) {
                const contentItemId = contentItem.realId ?? contentItem.id;
                const exists = contentItems.some(function(item) {
                    return !item.isNew && item.realId === contentItemId;
                });

                if (!exists) {
                    contentItems.push(createExistingContentItem({
                        id: contentItemId,
                        name: contentItem.name,
                        typeId: contentItem.typeId,
                        isActive: contentItem.isActive,
                        url: contentItem.url
                    }));
                }
            });
        }

        function addNewFiles(files) {
            Array.from(files).forEach(function(file, index) {
                contentItems.push(createUploadedContentItem(file, index));
            });
        }

        function removeContentItem(uid) {
            contentItems = contentItems.filter(function(contentItem) {
                return contentItem.uid !== uid;
            });
        }

        function getCoursePayload() {
            const formData = formWidget.option("formData");
            const linkedContentItemIds = contentItems
                .filter(function(contentItem) { return !contentItem.isNew; })
                .map(function(contentItem) { return contentItem.realId; });

            return {
                courseCode: formData.courseCode,
                courseName: formData.courseName,
                description: formData.description,
                courseType: formData.courseType,
                categoryId: formData.categoryId,
                contentItemIds: linkedContentItemIds
            };
        }

        async function saveCourse() {
            const payload = getCoursePayload();

            if (IS_EDIT) {
                await $.ajax({
                    url: `${serviceUrl}/courses/${COURSE_ID}`,
                    method: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    xhrFields: { withCredentials: true }
                });

                return COURSE_ID;
            }

            const response = await $.ajax({
                url: COURSE_CREATE_API_URL,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            });

            return response.data.id;
        }

        async function getActiveVersionId(courseId) {
            const response = await $.ajax({
                url: `${serviceUrl}/courses/${courseId}/versions`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });
            const versions = response.data || response || [];

            if (versions.length === 0) {
                return null;
            }

            const activeVersion = versions.find(function(version) { return version.isActive; }) || versions[0];
            return activeVersion.id;
        }

        function buildVersionFormData() {
            const versionFormData = new FormData();
            versionFormData.append("Note", IS_EDIT ? "Updated content via form" : "Initial content upload");
            versionFormData.append("IsActive", true);

            contentItems.forEach(function(contentItem) {
                if (contentItem.isNew) {
                    versionFormData.append("Files", contentItem.fileRef);
                    versionFormData.append("ContentItemIds", 0);
                } else {
                    versionFormData.append("ContentItemIds", contentItem.realId);
                }

                versionFormData.append("ContentTypeIds", contentItem.typeId);
            });

            return versionFormData;
        }

        async function saveContentItemsToVersion(courseId, activeVersionId) {
            const versionFormData = buildVersionFormData();
            const requestUrl = activeVersionId
                ? `${serviceUrl}/courses/versions/${activeVersionId}`
                : `${serviceUrl}/courses/${courseId}/versions`;
            const requestMethod = activeVersionId ? "PUT" : "POST";

            await $.ajax({
                url: requestUrl,
                method: requestMethod,
                data: versionFormData,
                processData: false,
                contentType: false,
                xhrFields: { withCredentials: true }
            });
        }

        function updateCourseSnapshot() {
            if (IS_EDIT || !formWidget) {
                return;
            }

            const formData = formWidget.option("formData") || {};
            const courseCode = formData.courseCode || "Not set";
            const courseName = formData.courseName || "Not set";
            const description = formData.description || "No description";
            const courseType = getEditorText("courseType", "Not selected");
            const division = getEditorText("divisionId", "No division");
            const category = getEditorText("categoryId", "No category");
            const previewContentNames = contentItems.slice(0, 3).map(function(contentItem) {
                return contentItem.name;
            });

            $("#snapshot-course-type").text(courseType);
            $("#snapshot-course-code").text(courseCode);
            $("#snapshot-course-name").text(courseName);
            $("#snapshot-course-scope").text(`${division} / ${category}`);
            $("#snapshot-content-preview").text(previewContentNames.length > 0
                ? `${previewContentNames.join(', ')}${contentItems.length > 3 ? ' ...' : ''}`
                : "No content added yet");

            if (reviewForm) {
                reviewForm.option("formData", {
                    courseType: courseType,
                    courseCode: courseCode,
                    courseName: courseName,
                    division: division,
                    category: category,
                    description: description
                });
            }
        }

        function renderCourseReview() {
            if (IS_EDIT) {
                return;
            }

            const existingCount = contentItems.filter(function(contentItem) {
                return !contentItem.isNew;
            }).length;
            const newCount = contentItems.filter(function(contentItem) {
                return contentItem.isNew;
            }).length;

            $("#review-total-content").text(contentItems.length);
            $("#review-existing-content").text(existingCount);
            $("#review-new-content").text(newCount);
            $("#review-content-table").html(buildReviewContentTable());
        }

        function buildReviewContentTable() {
            if (contentItems.length === 0) {
                return `
                    <div class="admin-wizard-empty-state">
                        <i class="fas fa-folder-open"></i>
                        <div>No content has been added yet.</div>
                    </div>`;
            }

            const rows = contentItems.map(function(contentItem, index) {
                const sourceText = contentItem.isNew ? "New upload" : "Content library";
                const sourceBadge = contentItem.isNew ? "pill-primary" : "pill-default";
                const readinessState = getContentReadinessState(contentItem);

                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td>
                            <div class="admin-review-item-name">${window.escapeHtml(contentItem.name)}</div>
                        </td>
                        <td><span class="tag-pill ${sourceBadge}">${window.escapeHtml(sourceText)}</span></td>
                        <td><span class="tag-pill ${contentItem.typeId === 1 ? 'pill-learn' : 'pill-exam'}">${window.escapeHtml(getContentTypeLabel(contentItem.typeId))}</span></td>
                        <td><span class="tag-pill pill-${window.escapeHtml(readinessState.tone)}">${window.escapeHtml(readinessState.text)}</span></td>
                    </tr>`;
            }).join('');

            return `
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Content Name</th>
                            <th>Source</th>
                            <th>Content Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>`;
        }

        function getEditorText(dataField, fallbackText) {
            const editor = formWidget?.getEditor(dataField);
            if (!editor) {
                return fallbackText;
            }

            const selectedItem = editor.option("selectedItem");
            if (selectedItem?.name) {
                return selectedItem.name;
            }

            const textValue = editor.option("text");
            return textValue || fallbackText;
        }

        function getContentTypeLabel(typeId) {
            return typeId === 2 ? "Exam" : "Learn";
        }

        function getContentReadinessState(contentItem) {
            if (contentItem.isNew) {
                return {
                    tone: "primary",
                    text: "Queued Upload",
                    detail: "Will be processed when you save this course."
                };
            }

            if (!contentItem.isActive) {
                return {
                    tone: "danger",
                    text: "Not Ready",
                    detail: "content item is not published"
                };
            }

            if (!contentItem.url) {
                return {
                    tone: "warning",
                    text: "Not Ready",
                    detail: "launch URL is missing"
                };
            }

            return {
                tone: "success",
                text: "Published",
                detail: "Ready to use in the initial version."
            };
        }

        function renderContentReadinessCell(container, contentItem) {
            const state = getContentReadinessState(contentItem || {});
            window.renderAdminGridStatusCell(container, state.text, state.tone, { showDot: false });
        }

        function formatDateTime(value) {
            return window.formatAdminDateTime(value, '—');
        }
    </script>
}