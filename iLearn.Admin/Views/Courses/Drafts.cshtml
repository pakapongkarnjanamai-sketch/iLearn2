@{
    ViewBag.Title = "Draft Courses";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-warning text-dark rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-file-pen"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Review and publish courses that are currently in draft mode.
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Index", "Courses")" class="btn btn-light border shadow-sm rounded px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back to All Courses
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Stores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });
        const draftCoursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            initDxGrid("#grid", {
                dataSource: new DevExpress.data.DataSource({
                    store: draftCoursesStore,
                    filter: ["isActive", "=", false] // บังคับกรองเฉพาะ Draft
                }),
                remoteOperations: true,
                selection: { mode: "single" },
                searchPanel: { placeholder: "Search drafts..." },

                // --- ปรับแต่ง UI ตารางหลักให้เข้ากับหน้าอื่นๆ ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                // เปิดการลบเพื่อใช้ปุ่มและ Dialog มาตรฐานของระบบ
                editing: {
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this draft course?" }
                },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 120,
                        alignment: "center",
               
                    },
                    {
                        dataField: "title",
                        caption: "Course Title",
                        minWidth: 300,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");
                            // ใช้ Bootstrap Badge แบบมาตรฐาน
                            $("<span>").addClass("badge bg-warning text-dark border").html('<i class="fas fa-pen-nib me-1"></i>Draft').appendTo(wrapper);
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(wrapper);
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        minWidth: 200,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "Type",
                        minWidth: 100,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            const icon = options.value === 1 ? "fa-globe text-primary" : "fa-lock text-danger";
                            $("<div>").html(`<i class="fas ${icon} me-1 opacity-75"></i> ${text}`).appendTo(container);
                        }
                    },
                    {
                        dataField: "updatedAt",
                        caption: "Last Modified",
                        dataType: "datetime",
                        format: "dd MMM yyyy HH:mm",
                        minWidth: 120,
                        alignment: "right",
                        allowHeaderFiltering: false
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 140,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Edit Course",
                                icon: "edit",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Form", "Courses")?id=' + e.row.data.id;
                                }
                            },
                            {
                                hint: "Publish Course",
                                icon: "upload", // ใช้ไอคอนอัปโหลดของระบบสื่อถึงการนำขึ้นระบบ (Publish)
                                onClick: function(e) {
                                    publishCourse(e.row.data);
                                }
                            },
                            "delete" // คำสั่ง String "delete" จะจัดการลบผ่าน draftCoursesStore ให้ทันที
                        ]
                    }
                ],
                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        template: function() {
                            return $("<div class='d-flex align-items-center gap-2 text-muted fw-medium'><i class='fas fa-info-circle text-warning'></i> Pending for publication</div>");
                        }
                    });
                }
            });
        });

        // ฟังก์ชัน Publish เปลี่ยนมาใช้ DataStore.update แทนการเขียน Ajax แบบยาว
        function publishCourse(data) {
            DevExpress.ui.dialog.confirm(
                `Are you sure you want to publish <strong>"${data.title}"</strong>?<br><small class='text-muted'>Once published, it will be visible to all eligible employees.</small>`,
                "Confirm Publication"
            ).done((dialogResult) => {
                if (dialogResult) {
                    // ใช้ draftCoursesStore เพื่ออัปเดตสถานะ isActive
                    draftCoursesStore.update(data.id, { isActive: true })
                        .done(function() {
                            DevExpress.ui.notify("Course published successfully!", "success", 2000);
                            $("#grid").dxDataGrid("instance").refresh();
                        })
                        .fail(function(err) {
                            console.error(err);
                            DevExpress.ui.notify("Failed to publish course.", "error", 3000);
                        });
                }
            });
        }
    </script>
}