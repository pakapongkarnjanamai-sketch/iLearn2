@{
    ViewBag.Title = "จัดการแบบร่าง (Draft Courses)";
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>@ViewBag.Title</h5>
            <button class="btn btn-sm btn-light" onclick="window.location.href='@Url.Action("Index", "Courses")'">
                <i class="fas fa-list me-1"></i> ดูหลักสูตรทั้งหมด
            </button>
        </div>
        <div class="card-body">
            <div id="grid-drafts"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
      

        // Data Store (ดึงข้อมูลทั้งหมด แล้วเดี๋ยวเรา Filter ใน Grid เอา)
        // หรือถ้า API รองรับ parameter isActive ก็สามารถใส่ loadParams ได้
        const coursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            $("#grid-drafts").dxDataGrid({
                dataSource: coursesStore,
                // ★ กรองเฉพาะ Draft (IsActive = false) ★
                filterValue: ["isActive", "=", false],
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: true,
                height: "100%",
                scrolling: { mode: "virtual" },
                searchPanel: { visible: true, width: 300, placeholder: "ค้นหาแบบร่าง..." },
                headerFilter: { visible: true },

                columns: [
                    {
                        dataField: "code",
                        caption: "Code",
                        width: 100,
                        sortOrder: 'asc'
                    },
                    {
                        dataField: "title",
                        caption: "Title",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            // แสดงป้าย Draft ชัดๆ
                            $("<div>").append(
                                $("<span>").addClass("badge bg-secondary me-2").text("Draft"),
                                $("<span>").text(options.value)
                            ).appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        width: 180,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "Type",
                        width: 150,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "updatedAt",
                        caption: "Last Updated",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        width: 150
                    },
                    {
                        type: "buttons",
                        width: 160,
                        buttons: [
                            // 1. ปุ่มแก้ไข (Edit) -> ไปหน้า Form
                            {
                                hint: "แก้ไข (Edit)",
                                icon: "edit",
                                type: "default",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Form", "Courses")?id=' + e.row.data.id;
                                }
                            },
                            // 2. ปุ่ม Publish (Public) -> เรียก API Update IsActive = true
                            {
                                hint: "เผยแพร่ (Publish)",
                                icon: "check", // รูปเครื่องหมายถูก
                                type: "success",
                                onClick: function(e) {
                                    publishCourse(e.row.data);
                                }
                            },
                            // 3. ปุ่มลบ (Delete)
                            "delete"
                        ]
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับ Publish Course
        function publishCourse(data) {
            DevExpress.ui.dialog.confirm(
                `ยืนยันการเผยแพร่หลักสูตร <b>"${data.title}"</b> หรือไม่?<br/>ระบบจะทำการเตรียมไฟล์ SCORM และเปิดให้พนักงานเข้าถึงได้`,
                "Publish Confirmation"
            ).done(function(dialogResult) {
                if (dialogResult) {
                    const loadPanel = showLoading("กำลังเผยแพร่และเตรียมไฟล์...");

                    // เรียก API Create/Publish (ใช้ Endpoint เดียวกับตอนกด Publish ในหน้า Form)
                    // แต่รอบนี้เรามี ID แล้ว และไม่ได้ส่งไฟล์ใหม่
                    // เราจะใช้ API Update (Put) หรือ API เฉพาะก็ได้

                    // วิธีที่ง่ายที่สุด: เรียก PUT Update IsActive = true
                    // แต่ถ้าต้องการ Trigger SCORM Extract ด้วย ต้องเรียก API พิเศษ
                    // สมมติว่าใช้ Endpoint create-scorm เดิม แต่ส่ง flag isPublish=true และ courseId ไป
                    // หรือเรียก Update ปกติแล้ว Backend มี Logic ตรวจจับการเปลี่ยน Status

                    // ในที่นี้ขอใช้แบบ Update IsActive (Generic Put)
                    // *หมายเหตุ: หากระบบต้อง Extract SCORM ตอน Publish เท่านั้น คุณอาจต้องสร้าง API เฉพาะชื่อ /api/courses/{id}/publish*

                    $.ajax({
                        url: `${serviceUrl}/admin/CoursesCRUD/Put`,
                        method: "PUT",
                        data: {
                            key: data.id,
                            values: JSON.stringify({ isActive: true }) // เปลี่ยนสถานะเป็น Active
                        },
                        xhrFields: { withCredentials: true },
                        success: function() {
                            loadPanel.hide();
                            DevExpress.ui.notify("เผยแพร่สำเร็จ", "success", 2000);
                            $("#grid-drafts").dxDataGrid("instance").refresh(); // Refresh Grid
                        },
                        error: function(err) {
                            loadPanel.hide();
                            DevExpress.ui.notify("เกิดข้อผิดพลาดในการเผยแพร่", "error", 3000);
                        }
                    });
                }
            });
        }

        function showLoading(msg) {
            const panel = $("<div>").dxLoadPanel({
                shadingColor: "rgba(0,0,0,0.4)",
                visible: true,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: msg
            }).dxLoadPanel("instance");
            return panel;
        }
    </script>
}