@{
    ViewBag.Title = "จัดการแบบร่าง (Draft Courses)";
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm h-100">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>@ViewBag.Title</h5>
            <button class="btn btn-sm btn-light text-secondary" onclick="window.location.href='@Url.Action("Index", "Courses")'">
                <i class="fas fa-list me-1"></i> กลับไปดูหลักสูตรทั้งหมด
            </button>
        </div>
        <div class="card-body p-0">
            <div id="grid-drafts"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    

        // Lookup DataStores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        // ★ จุดสำคัญ: สร้าง Store สำหรับ Draft โดยเฉพาะ ★
        // เราส่ง loadParams: { isActive: false } เพื่อบังคับให้ API ส่งเฉพาะ Draft กลับมา
        const draftCoursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', {
            key: 'id',
            loadParams: { isActive: false }
        });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            $("#grid-drafts").dxDataGrid({
                dataSource: draftCoursesStore,
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: false,
                height: "100%",
                scrolling: { mode: "virtual" },
                searchPanel: { visible: true, width: 300, placeholder: "ค้นหาแบบร่าง..." },
                headerFilter: { visible: true },
                rowAlternationEnabled: true,
                hoverStateEnabled: true,

                // ไม่ต้องใส่ filterValue: ["isActive", "=", false] ที่นี่
                // เพราะเรากรองตั้งแต่ตอนขอข้อมูลด้วย loadParams แล้ว

                columns: [
                    {
                        dataField: "code",
                        caption: "รหัสวิชา (Code)",
                        width: 120,
                        sortOrder: 'asc'
                    },
                    {
                        dataField: "title",
                        caption: "ชื่อหลักสูตร (Title)",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<div>")
                                .append($("<span>").addClass("badge bg-warning text-dark me-2").text("Draft"))
                                .append($("<span>").addClass("fw-bold").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "หมวดหมู่ (Category)",
                        width: 180,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type",
                        caption: "ประเภท (Type)",
                        width: 150,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "updatedAt", // หรือ createdDate ตาม Model ของคุณ
                        caption: "แก้ไขล่าสุด",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm",
                        width: 150
                    },
                    {
                        type: "buttons",
                        width: 140,
                        caption: "จัดการ",
                        buttons: [
                            {
                                hint: "แก้ไขข้อมูล",
                                icon: "edit",
                                type: "default",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Form", "Courses")?id=' + e.row.data.id;
                                }
                            },
                            {
                                hint: "เผยแพร่ (Publish)",
                                icon: "upload",
                                cssClass: "text-success",
                                onClick: function(e) {
                                    publishCourse(e.row.data);
                                }
                            },
                            "delete"
                        ]
                    }
                ],
                // เพิ่ม Toolbar เพื่อความสวยงาม
                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        template: function() {
                            return $("<div class='fw-bold text-secondary ms-2'>รายการที่รอการเผยแพร่</div>");
                        }
                    });
                }
            });
        });

        function publishCourse(data) {
            DevExpress.ui.dialog.confirm(
                `ยืนยันการเผยแพร่หลักสูตร <b>"${data.title}"</b> หรือไม่?<br/>เมื่อเผยแพร่แล้ว พนักงานจะสามารถมองเห็นหลักสูตรนี้ได้ทันที`,
                "ยืนยันการเผยแพร่ (Confirm Publish)"
            ).done(function(dialogResult) {
                if (dialogResult) {
                    const loadPanel = showLoading("กำลังเผยแพร่...");

                    // เรียก API เพื่อเปลี่ยนสถานะ isActive = true
                    $.ajax({
                        url: `${serviceUrl}/admin/CoursesCRUD/Put`,
                        method: "PUT",
                        data: {
                            key: data.id,
                            values: JSON.stringify({ isActive: true }) // ส่งเฉพาะค่าที่ต้องการเปลี่ยน
                        },
                        xhrFields: { withCredentials: true },
                        success: function() {
                            loadPanel.hide();
                            DevExpress.ui.notify("เผยแพร่หลักสูตรสำเร็จ", "success", 2000);
                            $("#grid-drafts").dxDataGrid("instance").refresh();
                        },
                        error: function(err) {
                            loadPanel.hide();
                            console.error(err);
                            DevExpress.ui.notify("เกิดข้อผิดพลาดในการเผยแพร่", "error", 3000);
                        }
                    });
                }
            });
        }

        function showLoading(msg) {
            return $("<div>").dxLoadPanel({
                shadingColor: "rgba(0,0,0,0.4)",
                visible: true,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: msg,
                position: { of: "#grid-drafts" }
            }).dxLoadPanel("instance");
        }
    </script>
}