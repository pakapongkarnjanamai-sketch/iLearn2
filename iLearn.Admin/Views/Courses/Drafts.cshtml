@{
    ViewBag.Title = "Draft Courses";
}

@section Styles {
    <style>
        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 700;
            color: var(--brand-dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* --- Card & Grid Styling --- */
        .content-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            border: none;
            overflow: hidden;
            height: calc(100vh - 240px);
            display: flex;
            flex-direction: column;
        }

        .dx-datagrid-headers {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

        .badge-draft {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.2s;
            border: none;
            background: transparent;
        }

            .btn-icon:hover {
                background-color: #f1f3f5;
                transform: translateY(-2px);
            }

        .action-btn-group {
            display: flex;
            gap: 8px;
            justify-content: center;
        }
    </style>
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-warning text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 48px; height: 48px; font-size: 1.4rem;">
                    <i class="fas fa-file-pen"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Review and publish courses that are currently in draft mode.
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-2"></i> Back to All Courses
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-4" id="grid-drafts"></div>
    </div>
</div>

@section Scripts {
    <script>

        // Stores
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        // 1. สร้าง Store ปกติ (ไม่ต้องใส่ loadParams ที่นี่)
        const draftCoursesStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', {
            key: 'id'
        });

        const courseTypes = [
            { id: 0, name: 'Special (Rule-based)' },
            { id: 1, name: 'General (Auto-assign)' }
        ];

        $(() => {
            $("#grid-drafts").dxDataGrid({
                // 2. ใช้ DataSource และกำหนด filter ที่นี่แทน
                dataSource: new DevExpress.data.DataSource({
                    store: draftCoursesStore,
                    filter: ["isActive", "=", false] // ★ สำคัญ: บังคับกรองเฉพาะ Draft ★
                }),
                remoteOperations: true,
                showBorders: false,
                height: "100%",
                columnAutoWidth: true,
                scrolling: { mode: "virtual" },
                hoverStateEnabled: true,
                rowAlternationEnabled: false,
                showRowLines: true,
                searchPanel: {
                    visible: true,
                    width: 300,
                    placeholder: "Search drafts..."
                },
                headerFilter: { visible: true },
                selection: { mode: "single" },

                columns: [
                    {
                        dataField: "code", // ตรงกับ JSON API (code)
                        caption: "Code",
                        width: 120,
                        alignment: "center",
                        cssClass: "fw-bold text-muted"
                    },
                    {
                        dataField: "title", // ตรงกับ JSON API (title)
                        caption: "Course Title",
                        minWidth: 300,
                        cellTemplate: function(container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");

                            // Badge
                            $("<span>").addClass("badge-draft").html('<i class="fas fa-pen-nib me-1"></i>Draft').appendTo(wrapper);

                            // Name
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(wrapper);

                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "categoryId",
                        caption: "Category",
                        minWidth: 200,
                        lookup: {
                            dataSource: categoriesStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "type", // ตรงกับ JSON API (type)
                        caption: "Type",
                        minWidth: 100,
                        lookup: {
                            dataSource: courseTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            const icon = options.value === 1 ? "fa-globe" : "fa-lock";
                            $("<div>").html(`<i class="fas ${icon} me-1 text-muted"></i> ${text}`).appendTo(container);
                        }
                    },
                    {
                        dataField: "updatedAt", // ตรงกับ JSON API (updatedAt)
                        caption: "Last Modified",
                        dataType: "datetime",
                        format: "dd MMM yyyy HH:mm",
                        minWidth: 80,
                        alignment: "right",
                        allowHeaderFiltering: false
                    },
                    {
                        caption: "Actions",
                        width: 160,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-btn-group");

                            // Edit Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Course")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Form", "Courses")?id=' + data.id)
                                .appendTo($group);

                            // Publish Button
                            $("<button>")
                                .addClass("btn-icon text-success")
                                .attr("title", "Publish Course")
                                .html('<i class="fas fa-rocket"></i>')
                                .on("click", () => publishCourse(data))
                                .appendTo($group);

                            // Delete Button
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Draft")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    confirmDelete(data.id, data.title);
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ],
                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        template: function() {
                            return $("<div class='d-flex align-items-center gap-2 text-muted fw-medium'><i class='fas fa-info-circle'></i> Pending for publication</div>");
                        }
                    });
                }
            });
        });

        // ฟังก์ชัน Publish
        function publishCourse(data) {
            const confirmDialog = DevExpress.ui.dialog.custom({
                title: "Confirm Publication",
                messageHtml: `
                    <div class="text-center my-3">
                        <div class="mb-3 text-success" style="font-size: 3rem;"><i class="fas fa-check-circle"></i></div>
                        <p>Are you sure you want to publish <strong>"${data.title}"</strong>?</p>
                        <small class="text-muted">Once published, it will be visible to all eligible employees.</small>
                    </div>
                `,
                buttons: [
                    { text: "Cancel", onClick: () => false },
                    { text: "Publish Now", type: "success", onClick: () => true }
                ]
            });

            confirmDialog.show().done((dialogResult) => {
                if (dialogResult) {
                    const loadPanel = showLoading("Publishing...");

                    $.ajax({
                        url: `${serviceUrl}/admin/CoursesCRUD/Put`,
                        method: "PUT",
                        data: {
                            key: data.id,
                            values: JSON.stringify({ isActive: true })
                        },
                        xhrFields: { withCredentials: true },
                        success: function() {
                            DevExpress.ui.notify({
                                message: "Course published successfully!",
                                type: "success",
                                displayTime: 3000,
                                position: { my: "top center", at: "top center" }
                            });
                            $("#grid-drafts").dxDataGrid("instance").refresh();
                        },
                        error: function(err) {
                            console.error(err);
                            DevExpress.ui.notify("Failed to publish course.", "error", 3000);
                        },
                        complete: () => loadPanel.hide()
                    });
                }
            });
        }

        // ฟังก์ชัน Delete
        function confirmDelete(id, title) {
             const confirmDialog = DevExpress.ui.dialog.custom({
                title: "Confirm Delete",
                messageHtml: `
                    <div class="text-center my-3">
                        <div class="mb-3 text-danger" style="font-size: 3rem;"><i class="fas fa-trash-alt"></i></div>
                        <p>Are you sure you want to delete draft <strong>"${title}"</strong>?</p>
                        <small class="text-muted">This action cannot be undone.</small>
                    </div>
                `,
                buttons: [
                    { text: "Cancel", onClick: () => false },
                    { text: "Delete", type: "danger", onClick: () => true }
                ]
            });

            confirmDialog.show().done((dialogResult) => {
                if(dialogResult) {
                    const loadPanel = showLoading("Deleting...");
                     $.ajax({
                        url: `${serviceUrl}/admin/CoursesCRUD/Delete`,
                        method: "DELETE",
                        data: { key: id },
                        xhrFields: { withCredentials: true },
                        success: function() {
                            DevExpress.ui.notify("Draft deleted.", "success", 2000);
                            $("#grid-drafts").dxDataGrid("instance").refresh();
                        },
                        error: function(err) {
                            DevExpress.ui.notify("Failed to delete.", "error", 3000);
                        },
                        complete: () => loadPanel.hide()
                    });
                }
            });
        }

        function showLoading(msg) {
            return $("<div>").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.7)",
                visible: true,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: msg,
                position: { of: "#grid-drafts" }
            }).dxLoadPanel("instance");
        }
    </script>
}