@{
    ViewBag.Title = "Course Versions";
    var courseId = ViewBag.CourseId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-code-branch"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        <span id="courseDisplayCode" class="badge bg-light text-secondary border me-1">-</span>
                        <strong id="courseDisplayName" class="text-dark">Loading...</strong>
                        <span class="mx-1">|</span>
                        Manage versions and resources for Course ID: <strong class="text-primary">@courseId</strong>
                    </div>
                </div>
            </h1>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-light border shadow-sm rounded px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </a>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewVersion()">
                    <i class="fas fa-plus me-2"></i> New Version
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedLearnIds = [];
        let selectedExamIds = [];
        let currentCourseId = parseInt('@courseId');
        let nextVersionNumber = 1;

        // 1. Load Course Header Information
        function loadCourseHeader() {
            $.ajax({
                url: serviceUrl + "/admin/CoursesCRUD/Get/" + currentCourseId,
                method: "GET",
                xhrFields: { withCredentials: true }
            }).done(function(data) {
                $('#courseDisplayName').text(data.title || 'Unknown Course');
                $('#courseDisplayCode').text(data.code || '-');
            }).fail(function() {
                $('#courseDisplayName').text('Unable to load course details');
            });
        }

        // 2. Data Store for Resources
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        function createGridConfig(typeId, onSelectionChangeCallback) {
            return {
                dataSource: {
                    store: resourcesStore,
                    filter: ["typeId", "=", typeId]
                },
                showBorders: true,
                height: 300,
                selection: { mode: "multiple", showCheckBoxesMode: "always" },
                searchPanel: { visible: true, width: 200, placeholder: "Search..." },
                scrolling: { mode: "virtual" },
                columns: [
                    { dataField: "name", caption: "Resource Name" },
                    { dataField: "isActive", caption: "Active", dataType: "boolean", width: 80, alignment: "center" }
                ],
                onSelectionChanged: onSelectionChangeCallback
            };
        }

        $(() => {
            loadCourseHeader();

            const versionsDataSource = new DevExpress.data.CustomStore({
                key: "id",
                load: function(loadOptions) {
                    const params = {
                        filter: JSON.stringify(["courseId", "=", currentCourseId]),
                        sort: JSON.stringify([{ selector: "versionNumber", desc: true }]),
                        skip: loadOptions.skip,
                        take: loadOptions.take,
                        requireTotalCount: loadOptions.requireTotalCount
                    };

                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get",
                        method: "GET",
                        data: params,
                        xhrFields: { withCredentials: true }
                    }).done(function(res) {
                        if(res.data && res.data.length > 0) {
                            nextVersionNumber = Math.max(...res.data.map(v => v.versionNumber)) + 1;
                        }
                    });
                },
                byKey: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get/" + key,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });
                },
                insert: function(values) {
                    const payload = {
                        ...values,
                        courseId: currentCourseId,
                        resourceIds: [...selectedLearnIds, ...selectedExamIds]
                    };
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Post",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                update: function(key, values) {
                    const payload = {
                        ...values,
                        resourceIds: [...selectedLearnIds, ...selectedExamIds]
                    };
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Put/" + key,
                        method: "PUT",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Delete/" + key,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });
                }
            });

            // 3. Setup Main Grid
            $("#grid").dxDataGrid({
                dataSource: versionsDataSource,
                remoteOperations: true,
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                columnAutoWidth: true,
                searchPanel: { visible: true, width: 250, placeholder: "Search versions..." },
                height: "calc(100vh - 250px)",
                paging: { pageSize: 15 },
                pager: { showPageSizeSelector: true, allowedPageSizes: [15, 30, 50], showInfo: true },

                onInitNewRow: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];
                    e.data.courseId = currentCourseId;
                    e.data.versionNumber = nextVersionNumber;
                    e.data.isActive = true;
                },

                onEditingStart: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];
                    if (e.data && e.data.id) {
                        versionsDataSource.byKey(e.data.id).done(function(response) {
                            let detailData = response.data ? response.data : response;
                            let rIds = detailData.resourceIds || (detailData.courseResources ? detailData.courseResources.map(cr => cr.resourceId) : []);

                            if (rIds.length > 0) {
                                const resourcePromises = rIds.map(id => resourcesStore.byKey(id));
                                Promise.all(resourcePromises).then(resources => {
                                    selectedLearnIds = resources.filter(r => r && r.typeId === 1).map(r => r.id);
                                    selectedExamIds = resources.filter(r => r && r.typeId === 2).map(r => r.id);

                                    setTimeout(() => {
                                        const gridLearn = $("#gridLearn").dxDataGrid("instance");
                                        if (gridLearn) gridLearn.option("selectedRowKeys", selectedLearnIds);
                                        const gridExam = $("#gridExam").dxDataGrid("instance");
                                        if (gridExam) gridExam.option("selectedRowKeys", selectedExamIds);
                                    }, 500);
                                });
                            }
                        });
                    }
                },
        editing: {
            allowDeleting: true, // อนุญาตให้ลบได้จากตาราง
            useIcons: true,
            texts: { confirmDeleteMessage: "Are you sure you want to delete this version?" }
        },

                columns: [
                    { dataField: "id", caption: "ID", width: 60, alignment: "center", sortOrder: 'desc', allowEditing: false },
                    {
                        dataField: "versionNumber",
                        caption: "Version No.",
                        width: 100,
                        alignment: "center",
                        cellTemplate: (c, o) => $("<span>").addClass("badge bg-info text-dark").text("v." + o.value).appendTo(c)
                    },
                    { dataField: "note", caption: "Version Name / Note" },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $("<span>").addClass("badge bg-success text-white px-2 py-1").html('<i class="fas fa-check-circle"></i> Active').appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-light text-muted border px-2 py-1").html('<i class="fas fa-times-circle"></i> Inactive').appendTo(container);
                            }
                        }
                    },
                    { dataField: "createdAt", caption: "Created Date", dataType: "date", format: "dd MMM yyyy HH:mm", width: 160, allowEditing: false },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                               buttons: [
            {
                hint: "Preview Version",
                icon: "runner",
                onClick: function(e) { window.location.href = '@Url.Action("Player", "Courses")?versionId=' + e.row.data.id; }
            },
            // ปุ่มแก้ไขใหม่ ชี้ไปหน้า Form
            {
                hint: "Edit Version",
                icon: "edit",
                onClick: function(e) {
                    window.location.href = '@Url.Action("VersionForm", "Courses")?id=' + e.row.data.id + '&courseId=' + currentCourseId;
                }
            },
            "delete"
        ]
                    }
                ]
            });
        });

        // Add new row logic
              function addNewVersion() {
            window.location.href = '@Url.Action("VersionForm", "Courses")?courseId=' + currentCourseId;
        }
    </script>
}