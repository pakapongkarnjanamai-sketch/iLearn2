@{
    ViewBag.Title = "Course Versions";
    var courseId = ViewBag.CourseId;
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-code-branch"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage versions and resources for Course ID: <strong class="text-primary">@courseId</strong>
                    </div>
                </div>
            </h1>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </a>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewVersion()">
                    <i class="fas fa-plus me-2"></i> New Version
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. ประกาศตัวแปรเก็บ ID ที่เลือก
        let selectedLearnIds = [];
        let selectedExamIds = [];
        let currentCourseId = 0;

        // 2. Stores สำหรับ Dropdown และ Grid ย่อย
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        // ฟังก์ชันสร้าง Config สำหรับ Grid ย่อย (เหมือนหน้า Courses เดิม)
        function createGridConfig(typeId, onSelectionChangeCallback) {
            return {
                dataSource: {
                    store: resourcesStore,
                    filter: ["typeId", "=", typeId] // 1=Learn, 2=Exam
                },
                showBorders: true, // Grid ย่อยยังคงขอบไว้เพื่อให้ดูแบ่งสัดส่วนใน Popup
                height: 250,
                selection: { mode: "multiple", showCheckBoxesMode: "always" },
                searchPanel: { visible: true, width: 150 },
                scrolling: { mode: "virtual" },
                columns: [
                    { dataField: "name", caption: "Resource Name" },
                    { dataField: "isActive", dataType: "boolean", width: 60 }
                ],
                onSelectionChanged: onSelectionChangeCallback
            };
        }

        $(() => {
            let initialFilter = null;

            if (@courseId) {
                initialFilter = ["courseId", "=", parseInt(@courseId)];
                // ตั้งค่า currentCourseId ให้ตรงกับค่าที่ส่งมาจากเซิร์ฟเวอร์
                currentCourseId = parseInt(@courseId);
            }

            const versionsDataSource = new DevExpress.data.CustomStore({
                key: "id",
                load: function(loadOptions) {
                    const filter = initialFilter;
                    const params = {
                        filter: JSON.stringify(filter),
                        sort: JSON.stringify(loadOptions.sort),
                        skip: loadOptions.skip,
                        take: loadOptions.take,
                        requireTotalCount: loadOptions.requireTotalCount
                    };

                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get",
                        method: "GET",
                        data: params,
                        xhrFields: { withCredentials: true }
                    });
                },
                byKey: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get/" + key,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });
                },
                insert: function(values) {
                    const allResourceIds = [...selectedLearnIds, ...selectedExamIds];
                    const payload = {
                        ...values,
                        courseId: currentCourseId,
                        resourceIds: allResourceIds
                    };

                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Post",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                update: function(key, values) {
                    const allResourceIds = [...selectedLearnIds, ...selectedExamIds];
                    const payload = {
                        ...values,
                        resourceIds: allResourceIds
                    };

                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Put/" + key,
                        method: "PUT",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Delete/" + key,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });
                }
            });

            // 4. ตั้งค่า Main Grid
            $("#grid").dxDataGrid({
                dataSource: versionsDataSource,
                remoteOperations: true,
                columnAutoWidth: true,

                // --- ปรับแต่ง UI ตารางหลักให้เป็นมาตรฐานใหม่ ---
                showBorders: false,
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                height: "calc(100vh - 250px)",
                selection: { mode: 'single' },

                // Reset ค่าตัวแปรเมื่อเริ่มเพิ่มแถวใหม่
                onInitNewRow: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];
                    e.data.courseId = currentCourseId;
                    e.data.IsActive = true;
                },

                // Double Click เข้า Player
                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Player", "Courses")?versionId=' + e.data.id;
                    }
                },

                // โหลดข้อมูล Resources เมื่อเริ่มแก้ไข
                onEditingStart: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];

                    if (e.data && e.data.id) {
                        versionsDataSource.byKey(e.data.id).done(function(detailData) {
                            if (detailData.resourceIds && detailData.resourceIds.length > 0) {
                                const resourcePromises = detailData.resourceIds.map(id => resourcesStore.byKey(id));

                                Promise.all(resourcePromises).then(resources => {
                                    selectedLearnIds = resources.filter(r => r && r.typeId === 1).map(r => r.id);
                                    selectedExamIds = resources.filter(r => r && r.typeId === 2).map(r => r.id);

                                    setTimeout(() => {
                                        const gridLearn = $("#gridLearn").dxDataGrid("instance");
                                        if (gridLearn) gridLearn.option("selectedRowKeys", selectedLearnIds);

                                        const gridExam = $("#gridExam").dxDataGrid("instance");
                                        if (gridExam) gridExam.option("selectedRowKeys", selectedExamIds);
                                    }, 500);
                                });
                            }
                        });
                    }
                },

                editing: {
                    mode: "popup",
                    allowAdding: true,
                    allowUpdating: true,
                    allowDeleting: true,
                    useIcons: true,
                    popup: {
                        title: "Version Info & Resources",
                        showTitle: true,
                        width: 900,
                        height: 750
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Version Info",
                                colCount: 2,
                                items: [
                                    {
                                        dataField: "VersionNumber",
                                        caption: "Version No.",
                                        dataType: "number",
                                        validationRules: [{ type: "required" }]
                                    },
                                    {
                                        dataField: "Name",
                                        caption: "Version Name",
                                        validationRules: [{ type: "required" }]
                                    },
                                    {
                                        dataField: "IsActive",
                                        editorType: "dxCheckBox",
                                        colSpan: 2
                                    }
                                ]
                            },
                            {
                                itemType: "group",
                                caption: "Resources Assignment",
                                colCount: 2,
                                items: [
                                    {
                                        colSpan: 1,
                                        template: function (data, itemElement) {
                                            itemElement.append(
                                                $("<div class='p-2 border rounded bg-light'>").append(
                                                    $("<h6 class='fw-bold text-primary mb-2'>").html('<i class="fas fa-book-reader me-1"></i> สื่อการเรียนรู้ (Learn)'),
                                                    $("<div>").attr("id", "gridLearn")
                                                )
                                            );
                                            setTimeout(() => {
                                                const grid = $("#gridLearn").dxDataGrid(createGridConfig(1, (e) => {
                                                    selectedLearnIds = e.selectedRowsData.map(r => r.id);
                                                })).dxDataGrid("instance");

                                                if (selectedLearnIds.length > 0) grid.option("selectedRowKeys", selectedLearnIds);
                                            }, 100);
                                        }
                                    },
                                    {
                                        colSpan: 1,
                                        template: function (data, itemElement) {
                                            itemElement.append(
                                                $("<div class='p-2 border rounded bg-light'>").append(
                                                    $("<h6 class='fw-bold text-danger mb-2'>").html('<i class="fas fa-pen-alt me-1"></i> แบบทดสอบ (Exam)'),
                                                    $("<div>").attr("id", "gridExam")
                                                )
                                            );
                                            setTimeout(() => {
                                                const grid = $("#gridExam").dxDataGrid(createGridConfig(2, (e) => {
                                                    selectedExamIds = e.selectedRowsData.map(r => r.id);
                                                })).dxDataGrid("instance");

                                                if (selectedExamIds.length > 0) grid.option("selectedRowKeys", selectedExamIds);
                                            }, 100);
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 60,
                        sortOrder: 'desc',
                        allowEditing: false,
                        alignment: "center",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "versionNumber",
                        caption: "Version No.",
                        width: 100,
                        alignment: "center",
                        cellTemplate: (c, o) => $("<span>").addClass("badge bg-info text-dark").text("v." + o.value).appendTo(c)
                    },
                    {
                        dataField: "name",
                        caption: "Version Name",
                        cssClass: "fw-bold text-dark",
                        validationRules: [{ type: "required" }]
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        dataType: "boolean",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "badge-active" : "badge-inactive";
                            const icon = isActive ? "fa-check-circle" : "fa-times-circle";
                            const text = isActive ? "Active" : "Inactive";

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${text}`)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "createdAt",
                        caption: "Created Date",
                        dataType: "date",
                        format: "dd MMM yyyy HH:mm",
                        allowEditing: false,
                        width: 180
                    },

                    // --- คอลัมน์ Action แบบใหม่ ---
                    {
                        caption: "Manage",
                        width: 140,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const grid = $("#grid").dxDataGrid("instance");
                            const $group = $("<div>").addClass("action-group");

                            // ปุ่ม Preview (ไปหน้า Player)
                            $("<button>")
                                .addClass("btn-icon text-success")
                                .attr("title", "Preview Version")
                                .html('<i class="fas fa-play-circle"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Player", "Courses")?versionId=' + data.id)
                                .appendTo($group);

                            // ปุ่ม Edit
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Version")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => grid.editRow(options.rowIndex))
                                .appendTo($group);

                            // ปุ่ม Delete
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Version")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(`Are you sure you want to delete <b>Version ${data.versionNumber}</b>?`, "Confirm Delete").done((res) => {
                                        if (res) grid.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม New Version ด้านบน
        function addNewVersion() {
            $("#grid").dxDataGrid("instance").addRow();
        }
    </script>
}