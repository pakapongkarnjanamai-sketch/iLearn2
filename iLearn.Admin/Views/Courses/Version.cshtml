@{
    ViewBag.Title = "Course Versions";
    var courseId = ViewBag.CourseId;
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-code-branch"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage versions and resources for Course ID: <strong class="text-primary">@courseId</strong>
                    </div>
                </div>
            </h1>
            <div class="d-flex gap-2">
                <a href="@Url.Action("Index", "Courses")" class="btn btn-light border shadow-sm rounded px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back to Courses
                </a>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewVersion()">
                    <i class="fas fa-plus me-2"></i> New Version
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. ประกาศตัวแปรเก็บ ID ที่เลือก
        let selectedLearnIds = [];
        let selectedExamIds = [];
        let currentCourseId = 0;

        // 2. Stores สำหรับ Dropdown และ Grid ย่อย
        const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

        // ฟังก์ชันสร้าง Config สำหรับ Grid ย่อย (ใน Popup)
        function createGridConfig(typeId, onSelectionChangeCallback) {
            return {
                dataSource: {
                    store: resourcesStore,
                    filter: ["typeId", "=", typeId] // 1=Learn, 2=Exam
                },
                showBorders: true,
                height: 250,
                selection: { mode: "multiple", showCheckBoxesMode: "always" },
                searchPanel: { visible: true, width: 150, placeholder: "Search..." },
                scrolling: { mode: "virtual" },
                columns: [
                    { dataField: "name", caption: "Resource Name" },
                    { dataField: "isActive", caption: "Active", dataType: "boolean", width: 80, alignment: "center" }
                ],
                onSelectionChanged: onSelectionChangeCallback
            };
        }

        $(() => {
            let initialFilter = null;

            if (@courseId) {
                initialFilter = ["courseId", "=", parseInt(@courseId)];
                currentCourseId = parseInt(@courseId);
            }

            const versionsDataSource = new DevExpress.data.CustomStore({
                key: "id",
                load: function(loadOptions) {
                    const params = {
                        filter: JSON.stringify(initialFilter),
                        sort: JSON.stringify(loadOptions.sort),
                        skip: loadOptions.skip,
                        take: loadOptions.take,
                        requireTotalCount: loadOptions.requireTotalCount
                    };

                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get",
                        method: "GET",
                        data: params,
                        xhrFields: { withCredentials: true }
                    });
                },
                byKey: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Get/" + key,
                        method: "GET",
                        xhrFields: { withCredentials: true }
                    });
                },
                insert: function(values) {
                    const allResourceIds = [...selectedLearnIds, ...selectedExamIds];
                    const payload = {
                        ...values,
                        courseId: currentCourseId,
                        resourceIds: allResourceIds // ส่งไปเป็น Array ของ ID
                    };
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Post",
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                update: function(key, values) {
                    const allResourceIds = [...selectedLearnIds, ...selectedExamIds];
                    const payload = {
                        ...values,
                        resourceIds: allResourceIds
                    };
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Put/" + key,
                        method: "PUT",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });
                },
                remove: function(key) {
                    return $.ajax({
                        url: serviceUrl + "/admin/CourseVersionsCRUD/Delete/" + key,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });
                }
            });

            // 4. ตั้งค่า Main Grid
            $("#grid").dxDataGrid({
                dataSource: versionsDataSource,
                remoteOperations: true,
                columnAutoWidth: true,

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                height: "calc(100vh - 250px)",
                selection: { mode: 'single' },

                // Reset ค่าตัวแปรเมื่อเริ่มเพิ่มแถวใหม่
                onInitNewRow: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];
                    e.data.courseId = currentCourseId;
                    e.data.isActive = true;
                },

                // Double Click เข้า Player
                onRowDblClick: function(e) {
                    if (e.data && e.data.id) {
                        window.location.href = '@Url.Action("Player", "Courses")?versionId=' + e.data.id;
                    }
                },

                // โหลดข้อมูล Resources เมื่อเริ่มแก้ไข
                onEditingStart: function(e) {
                    selectedLearnIds = [];
                    selectedExamIds = [];

                    if (e.data && e.data.id) {
                        versionsDataSource.byKey(e.data.id).done(function(response) {
                            // ป้องกันกรณีที่ Response ถูกครอบด้วย { data: {...} }
                            let detailData = response.data ? response.data : response;

                            // ดึง Resource Ids ออกมาจาก courseResources หรือ resourceIds
                            let rIds = [];
                            if (detailData.resourceIds && detailData.resourceIds.length > 0) {
                                rIds = detailData.resourceIds;
                            } else if (detailData.courseResources && detailData.courseResources.length > 0) {
                                rIds = detailData.courseResources.map(cr => cr.resourceId);
                            }

                            if (rIds.length > 0) {
                                const resourcePromises = rIds.map(id => resourcesStore.byKey(id));

                                Promise.all(resourcePromises).then(resources => {
                                    // แยกประเภทไฟล์ 1=Learn, 2=Exam
                                    selectedLearnIds = resources.filter(r => r && r.typeId === 1).map(r => r.id);
                                    selectedExamIds = resources.filter(r => r && r.typeId === 2).map(r => r.id);

                                    // อัปเดตตารางย่อยใน Popup หลังจากเรนเดอร์เสร็จ (หน่วงเวลา 500ms)
                                    setTimeout(() => {
                                        const gridLearn = $("#gridLearn").dxDataGrid("instance");
                                        if (gridLearn && selectedLearnIds.length > 0) gridLearn.option("selectedRowKeys", selectedLearnIds);

                                        const gridExam = $("#gridExam").dxDataGrid("instance");
                                        if (gridExam && selectedExamIds.length > 0) gridExam.option("selectedRowKeys", selectedExamIds);
                                    }, 500);
                                });
                            }
                        });
                    }
                },

                editing: {
                    mode: "popup",
                    allowAdding: true,
                    allowUpdating: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this version?" },
                    popup: {
                        title: "Version Info & Resources",
                        showTitle: true,
                        width: 900,
                        height: 750
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Version Info",
                                colCount: 2,
                                items: [
                                    {
                                        dataField: "versionNumber",
                                        caption: "Version No.",
                                        dataType: "number",
                                        validationRules: [{ type: "required" }]
                                    },
                                    {
                                        dataField: "note", // <--- เปลี่ยนจาก Name เป็น Note ตาม Backend API
                                        caption: "Version Name / Note",
                                        validationRules: [{ type: "required" }]
                                    },
                                    {
                                        dataField: "isActive",
                                        caption: "Active Status",
                                        editorType: "dxCheckBox",
                                        colSpan: 2
                                    }
                                ]
                            },
                            {
                                itemType: "group",
                                caption: "Resources Assignment",
                                colCount: 2,
                                items: [
                                    {
                                        colSpan: 1,
                                        template: function (data, itemElement) {
                                            itemElement.append(
                                                $("<div class='p-2 border rounded bg-light'>").append(
                                                    $("<h6 class='fw-bold text-primary mb-2'>").html('<i class="fas fa-book-reader me-1"></i> สื่อการเรียนรู้ (Learn)'),
                                                    $("<div>").attr("id", "gridLearn")
                                                )
                                            );

                                            setTimeout(() => {
                                                const grid = $("#gridLearn").dxDataGrid(createGridConfig(1, (e) => {
                                                    selectedLearnIds = e.selectedRowsData.map(r => r.id);
                                                })).dxDataGrid("instance");
                                            }, 100);
                                        }
                                    },
                                    {
                                        colSpan: 1,
                                        template: function (data, itemElement) {
                                            itemElement.append(
                                                $("<div class='p-2 border rounded bg-light'>").append(
                                                    $("<h6 class='fw-bold text-danger mb-2'>").html('<i class="fas fa-pen-alt me-1"></i> แบบทดสอบ (Exam)'),
                                                    $("<div>").attr("id", "gridExam")
                                                )
                                            );

                                            setTimeout(() => {
                                                const grid = $("#gridExam").dxDataGrid(createGridConfig(2, (e) => {
                                                    selectedExamIds = e.selectedRowsData.map(r => r.id);
                                                })).dxDataGrid("instance");
                                            }, 100);
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 60,
                        sortOrder: 'desc',
                        allowEditing: false,
                        alignment: "center",
            
                    },
                    {
                        dataField: "versionNumber",
                        caption: "Version No.",
                        width: 100,
                        alignment: "center",
                        cellTemplate: (c, o) => $("<span>").addClass("badge bg-info text-dark").text("v." + o.value).appendTo(c)
                    },
                    {
                        dataField: "note", // <--- แมปคอลัมน์จาก API
                        caption: "Version Name / Note",
             
                        validationRules: [{ type: "required" }]
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        dataType: "boolean",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>").addClass("badge bg-success text-white px-2 py-1").html('<i class="fas fa-check-circle"></i> Active').appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-light text-muted border px-2 py-1").html('<i class="fas fa-times-circle"></i> Inactive').appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "createdAt",
                        caption: "Created Date",
                        dataType: "date",
                        format: "dd MMM yyyy HH:mm",
                        allowEditing: false,
                        width: 180
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Preview Version",
                                icon: "runner", // ไอคอนคนวิ่ง (Native)
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Player", "Courses")?versionId=' + e.row.data.id;
                                }
                            },
                            "edit",
                            "delete"
                        ]
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม New Version ด้านบน
        function addNewVersion() {
            $("#grid").dxDataGrid("instance").addRow();
        }
    </script>
}