@{
    ViewData["Title"] = "Learning Player Preview";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
    var versionId = ViewBag.VersionId;
}

<div class="container-fluid px-4 pb-4">


    <div class="row g-3" style="height: calc(100vh - 160px);">
        <div class="col-lg-8 h-100">
            <div class="card border-0 shadow-sm h-100 overflow-hidden" id="fullscreenArea">
                <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
                    <div class="text-dark fw-bold text-truncate" id="lessonTitle">
                        <i class="fas fa-book-open text-primary me-2"></i> โหลดข้อมูล...
                    </div>
                    <button class="btn btn-sm btn-light border rounded" onclick="toggleFullscreen()" title="Full Screen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>

                <div class="card-body p-0 position-relative bg-light">
                    <div id="startOverlay" class="position-absolute w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-white" style="z-index: 10;">
                        <button class="btn btn-primary rounded-circle shadow d-flex align-items-center justify-content-center"
                                style="width: 80px; height: 80px; font-size: 2rem; transition: transform 0.2s;"
                                onclick="startCourse()"
                                onmouseover="this.style.transform='scale(1.1)'"
                                onmouseout="this.style.transform='scale(1)'">
                            <i class="fas fa-play ps-1"></i>
                        </button>
                        <h5 class="mt-4 fw-bold text-dark">เริ่มบทเรียน</h5>
                        <p id="overlayMessage" class="text-muted">เลือกหัวข้อทางขวาเพื่อเริ่ม</p>
                    </div>

                    <iframe id="scormFrame"
                            class="w-100 h-100 border-0"
                            style="display: none;"
                            sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
                    </iframe>
                </div>
            </div>
        </div>

        <div class="col-lg-4 h-100">
            <div class="card border-0 shadow-sm h-100 d-flex flex-column">

                <div class="p-4 border-bottom bg-white">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-primary me-2" id="courseCodeDisplay">CODE</span>
                        <span class="badge bg-secondary" id="courseVersionDisplay">v.1</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-2" id="courseTitleDisplay">กำลังโหลดข้อมูล...</h5>
                    <div class="d-flex align-items-center text-muted small mb-2">
                        <i class="far fa-folder me-2"></i>
                        <span id="courseCategoryDisplay">-</span>
                    </div>
                    <p class="text-muted small mb-0" id="courseDescDisplay" style="line-height: 1.4;">
                        -
                    </p>
                </div>

                <div class="bg-light border-bottom p-3">
                    <div class="row g-0">
                        <div class="col-6 border-end text-center px-2">
                            <div class="text-muted small mb-1">Preview Status</div>
                            <div id="statusDisplay" class="fw-bold text-muted">-</div>
                        </div>
                        <div class="col-6 text-center px-2">
                            <div class="text-muted small mb-1">Preview Score</div>
                            <div id="scoreDisplay" class="fw-bold text-dark">-</div>
                        </div>
                    </div>
                </div>

                <div class="bg-white border-bottom py-2 px-3 fw-bold text-dark" style="font-size: 0.9rem;">
                    <i class="fas fa-list-ul text-secondary me-2"></i> เนื้อหาบทเรียน (Resources)
                </div>

                <div class="flex-grow-1 overflow-auto p-3 bg-white" id="courseTocList">
                    <div class="text-center text-muted mt-4">
                        <div class="spinner-border text-primary spinner-border-sm mb-2" role="status"></div>
                        <div>กำลังโหลดโครงสร้าง...</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const VERSION_ID = "@ViewBag.VersionId";
        let scormLaunchUrl = "";
        let currentResources = [];
        let apiBaseUrl = "https://localhost:7128/api";

        $(function() {
            initScormAdapter();
            prepareContent();
        });

        async function prepareContent() {
            try {
                const apiUrl = `${apiBaseUrl}/admin/CourseVersionsCRUD/Get/${VERSION_ID}`;

                const response = await $.ajax({
                    url: apiUrl,
                    method: 'GET',
                    dataType: 'json',
                    xhrFields: { withCredentials: true }
                });

                let data = null;
                if (Array.isArray(response) && response.length > 0) {
                    data = response[0];
                } else if (response && !Array.isArray(response)) {
                    data = response;
                }

                if (data) {
                    const course = data.course || data.Course || {};
                    const versionNumber = data.versionNumber ?? data.VersionNumber ?? "1";
                    const resources = data.courseResources || data.CourseResources || [];

                    $("#courseTitleDisplay").text(course.title || course.Title || "ไม่มีชื่อหลักสูตร");
                    $("#courseCodeDisplay").text(course.code || course.Code || "N/A");
                    $("#courseCategoryDisplay").text((course.category && (course.category.name || course.category.Name)) ? (course.category.name || course.category.Name) : "General");
                    $("#courseDescDisplay").text(course.description || course.Description || "ไม่มีคำอธิบาย");
                    $("#courseVersionDisplay").text("v." + (versionNumber));

                    if (resources && resources.length > 0) {
                        currentResources = resources;
                        renderCourseContent(currentResources);
                    } else {
                        $("#courseTocList").html('<div class="alert alert-warning m-2 small"><i class="fas fa-exclamation-triangle me-2"></i>ไม่พบไฟล์เนื้อหาในเวอร์ชันนี้</div>');
                        $("#lessonTitle").html('<i class="fas fa-book-open text-primary me-2"></i> ไม่พบข้อมูล');
                    }
                } else {
                    DevExpress.ui.notify("ไม่พบข้อมูลหลักสูตร", "error", 3000);
                }

            } catch (err) {
                console.error(err);
                DevExpress.ui.notify("Error: " + err.message, "error", 3000);
                $("#courseTocList").html('<div class="text-danger text-center p-3"><i class="fas fa-times-circle fs-3 mb-2"></i><br>เกิดข้อผิดพลาดในการโหลดข้อมูล</div>');
            }
        }

        function renderCourseContent(resources) {
            const container = $("#courseTocList");
            container.empty();

            resources.forEach((item, index) => {
                const wrapper = item || {};
                const res = wrapper.resource || wrapper.Resource || null;
                if (!res) return;

                const typeId = res.typeId ?? res.TypeId;
                const name = res.name || res.Name || "-";

                let iconClass = "far fa-file-alt";
                if (typeId === 1) iconClass = "fas fa-laptop-code text-primary";
                else if (typeId === 2) iconClass = "fas fa-clipboard-check text-danger";

                // ใส่ ID ให้คลิกได้ และใช้คลาส bg-light ตอน Hover
                const html = `
                    <div class="card border mb-2 resource-item" style="cursor: pointer; transition: background-color 0.2s;"
                         id="res-item-${index}"
                         onclick="loadResource(${index})"
                         onmouseover="if(!this.classList.contains('border-primary')) this.classList.add('bg-light')"
                         onmouseout="this.classList.remove('bg-light')">
                        <div class="card-body p-3 d-flex align-items-center text-dark">
                            <div class="me-3" style="font-size: 1.5rem; width: 30px; text-align: center;">
                                <i class="${iconClass}"></i>
                            </div>
                            <div style="overflow: hidden;">
                                <div class="fw-bold text-truncate" title="${name}">${name}</div>
                                <div class="small text-muted mt-1">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">${typeId == 1 ? 'Learn' : 'Exam'}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.append(html);
            });

            if (resources.length > 0) {
                loadResource(0);
            }
        }

        function loadResource(index) {
            const wrapper = currentResources[index];
            if (!wrapper) return;

            const res = wrapper.resource || wrapper.Resource || null;
            if (!res) return;

            const name = res.name || res.Name || "-";
            const url = res.url || res.URL || "";

            // รีเซ็ตสไตล์ของการ์ดทั้งหมด
            $(".resource-item").removeClass("border-primary bg-primary bg-opacity-10 shadow-sm").addClass("border");

            // ไฮไลต์การ์ดที่ถูกเลือก
            $(`#res-item-${index}`).removeClass("border").addClass("border-primary bg-primary bg-opacity-10 shadow-sm");

            $("#lessonTitle").html(`<i class="fas fa-book-open text-primary me-2"></i> ${name}`);
            scormLaunchUrl = url;

            $("#startOverlay").fadeIn(200);
            $("#scormFrame").attr("src", "");
            $("#scormFrame").hide();

            $("#scoreDisplay").text("-").removeClass("text-success").addClass("text-dark");
            $("#statusDisplay").text("Not Attempted").removeClass("text-success text-danger text-warning").addClass("text-muted");
        }

        function startCourse() {
            if (!scormLaunchUrl) {
                DevExpress.ui.notify("URL ของไฟล์ไม่ถูกต้อง", "warning", 2000);
                return;
            }

            $("#startOverlay").fadeOut(200);
            const iframe = document.getElementById("scormFrame");
            iframe.style.display = "block";
            iframe.src = scormLaunchUrl;

            log("Course Launched: " + scormLaunchUrl);
        }

        // ==========================================
        // SCORM API ADAPTER (จำลองการรับค่าจากไฟล์ SCORM)
        // ==========================================
        function initScormAdapter() {
            const Adapter = {
                LMSInitialize: function(p) { log("LMSInitialize"); return "true"; },
                LMSGetValue: function(e) { log("LMSGetValue: " + e); return ""; },

                LMSSetValue: function(e, v) {
                    log("LMSSetValue: " + e + " = " + v);

                    if (e === "cmi.core.score.raw" || e === "cmi.score.raw") {
                        $("#scoreDisplay").text(v + " %");
                    }

                    if (e === "cmi.core.lesson_status" || e === "cmi.completion_status") {
                        const statusDisplay = $("#statusDisplay");
                        let statusText = v;

                        statusDisplay.removeClass("text-primary text-success text-danger text-warning text-muted");

                        if (v === 'completed' || v === 'passed') {
                            statusDisplay.addClass("text-success");
                            statusText = "Completed";
                        } else if (v === 'failed') {
                            statusDisplay.addClass("text-danger");
                            statusText = "Failed";
                        } else if (v === 'incomplete') {
                            statusDisplay.addClass("text-warning");
                            statusText = "Incomplete";
                        } else {
                            statusDisplay.addClass("text-primary");
                        }

                        statusDisplay.text(statusText);
                    }

                    return "true";
                },

                LMSCommit: function(p) { log("LMSCommit"); return "true"; },
                LMSFinish: function(p) { log("LMSFinish"); return "true"; },
                LMSGetLastError: function() { return "0"; },
                LMSGetErrorString: function(e) { return "No error"; },
                LMSGetDiagnostic: function(e) { return "No error"; },

                Initialize: function(p) { return this.LMSInitialize(p); },
                Terminate: function(p) { return this.LMSFinish(p); },
                GetValue: function(e) { return this.LMSGetValue(e); },
                SetValue: function(e, v) { return this.LMSSetValue(e, v); },
                Commit: function(p) { return this.LMSCommit(p); }
            };
            window.API = Adapter;
            window.API_1484_11 = Adapter;
        }

        function log(msg) {
            console.log(`%c[LMS] ${msg}`, "color: #28a745; font-weight: bold;");
        }

        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) {
                if(elem.requestFullscreen) elem.requestFullscreen();
                else if (elem.webkitRequestFullscreen) elem.webkitRequestFullscreen();
                else if (elem.msRequestFullscreen) elem.msRequestFullscreen();
            } else {
                if(document.exitFullscreen) document.exitFullscreen();
                else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                else if (document.msExitFullscreen) document.msExitFullscreen();
            }
        }
    </script>
}