@{
    ViewBag.Title = "Course Enrollments";
}

@section Styles {
    <style>
        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 700;
            color: var(--brand-dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* --- Content Layout --- */
        .content-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            border: none;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 240px);
        }

        /* --- Grid Customization --- */
        .dx-datagrid-headers {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

            .dx-datagrid-headers .dx-header-row > td {
                font-weight: 700 !important;
                color: #495057 !important;
                padding-top: 15px;
                padding-bottom: 15px;
            }

        /* --- Badges & Icons --- */
        .badge-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* สีตามสถานะการเรียน */
        .badge-completed {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .badge-inprogress {
            background-color: #cff4fc;
            color: #055160;
        }

        .badge-enrolled {
            background-color: #e2e3e5;
            color: #41464c;
        }

        .btn-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
            border: none;
            background: #f8f9fa;
            color: #6c757d;
        }

            .btn-icon:hover {
                transform: translateY(-2px);
                background-color: var(--brand-light);
                color: var(--brand-color);
            }

        .action-group {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
    </style>
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Track employee enrollments, learning progress, and completion status.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-outline-secondary rounded-pill px-4 shadow-sm" onclick="exportGrid()">
                    <i class="fas fa-file-excel me-2 text-success"></i> Export Report
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div id="grid-enrollments"></div>
    </div>
</div>

@section Scripts {
    <script>

        let gridInstance;

        // Data Stores (ปรับให้เรียกแบบ Pagination เพื่อไม่ให้โหลดข้อมูลรวดเดียว)
        const enrollmentsStore = createDataStore(serviceUrl, 'admin/EnrollmentsCRUD', { key: 'id' });

        // Lookup DataSources (ทยอยโหลดทีละ 20 ป้องกันหน้าเว็บค้าง)
        const dsCourses = {
            store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
            paginate: true,
            pageSize: 20
        };

        $(() => {
            gridInstance = $("#grid-enrollments").dxDataGrid({
                dataSource: enrollmentsStore,
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: false,
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                height: "100%",
                headerFilter: { visible: true },
                searchPanel: { visible: true, width: 300, placeholder: "Search student code..." },
                export: { enabled: false }, // ซ่อนปุ่มเดิม ใช้ปุ่ม Custom ด้านบน
                onExporting: (e) => handleExporting(e, 'Enrollment_Report'),

                // การตั้งค่า Popup สำหรับ Edit
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true, // อนุญาตให้ลงทะเบียน Manual
                    useIcons: true,
                    popup: {
                        title: "Enrollment Details",
                        showTitle: true,
                        width: 500,
                        height: 'auto'
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Assignment Info",
                                colCount: 1,
                                items: [
                                    {
                                        dataField: "studentCode", // แก้ให้ตรงกับ Backend
                                        label: { text: "Student Code" },
                                        validationRules: [{ type: "required" }]
                                    },
                                    {
                                        dataField: "courseId",
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: dsCourses,
                                            displayExpr: "code", // หรือ "title" ตามที่แอดมินถนัด
                                            valueExpr: "id",
                                            searchEnabled: true,
                                            searchExpr: ["code", "title"] // ค้นหาได้ทั้ง Code และชื่อ
                                        },
                                        validationRules: [{ type: "required" }]
                                    }
                                ]
                            },
                            {
                                itemType: "group",
                                caption: "Progress Status",
                                colCount: 2,
                                items: [
                                    {
                                        dataField: "isCompleted",
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Course Completed" }
                                    },
                                    {
                                        dataField: "progress",
                                        editorType: "dxNumberBox",
                                        editorOptions: { min: 0, max: 100 }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    { dataField: "id", caption: "ID", width: 80, visible: false },
                    {
                        dataField: "studentCode",
                        caption: "Student Code",
                        width: 150,
                        cellTemplate: function(container, options) {
                            // โชว์รหัสพนักงานให้เป็นตัวหนาสีน้ำเงิน
                            $("<span>").addClass("fw-bold text-primary").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "courseId",
                        caption: "Course Code / Title",
                        minWidth: 200,
                        lookup: {
                            dataSource: dsCourses,
                            displayExpr: "title", // ให้ DataGrid แปลง ID กลับเป็นชื่อคอร์ส
                            valueExpr: "id"
                        }
                    },
                    {
                        // คำนวณสถานะจำลองขึ้นมาเพื่อให้โชว์ Badge สวยๆ ได้
                        caption: "Status",
                        width: 140,
                        alignment: "center",
                        calculateCellValue: function(rowData) {
                            if (rowData.isCompleted) return "Completed";
                            if (rowData.progress > 0) return "In Progress";
                            return "Enrolled";
                        },
                        cellTemplate: function(container, options) {
                            const status = options.value;
                            let badgeClass = "badge-enrolled";
                            let icon = "fa-clipboard-list";

                            if (status === "Completed") {
                                badgeClass = "badge-completed";
                                icon = "fa-check-circle";
                            } else if (status === "In Progress") {
                                badgeClass = "badge-inprogress";
                                icon = "fa-spinner fa-spin";
                            }

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${status}`)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "progress",
                        caption: "Progress",
                        width: 180,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const val = options.value || 0;
                            const colorClass = val === 100 ? 'bg-success' : 'bg-primary';

                            // วาด Progress Bar เล็กๆ ในเซลล์ตาราง
                            container.html(`
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 shadow-sm" style="height: 8px; border-radius: 4px; background-color: #e9ecef;">
                                        <div class="progress-bar ${colorClass}" role="progressbar" style="width: ${val}%;" aria-valuenow="${val}" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="ms-2 small text-muted fw-bold" style="width: 35px; text-align: right;">${val}%</span>
                                </div>
                            `);
                        }
                    },
                    {
                        dataField: "createdAt",
                        caption: "Assigned On",
                        dataType: "datetime",
                        format: "dd MMM yyyy HH:mm",
                        width: 160
                    },
                    {
                        caption: "Manage",
                        width: 120,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // Edit Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Enrollment")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // Delete Button
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Enrollment")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(`Are you sure you want to delete enrollment for student: <b>${data.studentCode}</b>?`, "Confirm Delete").done((r) => {
                                        if(r) gridInstance.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ]
            }).dxDataGrid('instance');
        });

        // ฟังก์ชัน Export (เรียกใช้จากปุ่มด้านบน)
        function exportGrid() {
            gridInstance.exportToExcel(false);
        }
    </script>
}