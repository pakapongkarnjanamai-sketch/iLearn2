@{
    ViewBag.Title = "Enrollments";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Enrollments</h1>
        <div class="page-subtitle">Track employee enrollments, learning progress, and completion status.</div>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Enrollments</div>
                <div class="kpi-number" id="kpi-total">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-success h-100">
                <div class="kpi-label">Completed</div>
                <div class="kpi-number" id="kpi-completed">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">In Progress</div>
                <div class="kpi-number" id="kpi-inprogress">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Enrolled</div>
                <div class="kpi-number" id="kpi-enrolled">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Avg. Progress</div>
                <div class="kpi-number" id="kpi-avgprogress">—</div>
            </div>
        </div>
    </div>

    <!-- ── Filter Bar ── -->
    <div class="panel">
        <div class="panel-header">
            <i class="fas fa-filter me-1"></i> Filters
        </div>
        <div class="panel-body p-2">
            <div class="row g-3 align-items-end">
                <div class="col-auto u-minw-260">
                    <label class="filter-label">Course</label>
                    <div id="filterCourse"></div>
                </div>
                <div class="col-auto">
                    <label class="filter-label">Status</label>
                    <div id="filterStatus"></div>
                </div>
                <div class="col-auto ms-auto">
                    <button type="button" class="action-link action-link-sm" id="btnClearFilters">
                        <i class="fas fa-times"></i> Clear Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ── DataGrid ── -->
    <div class="row g-3 flex-grow-1 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>

</div>

@section Scripts {
    <script>
        let gridInstance;
        const statusOptions = [
            { id: 'all', name: 'All' },
            { id: 'completed', name: 'Completed' },
            { id: 'inprogress', name: 'In Progress' },
            { id: 'enrolled', name: 'Enrolled' }
        ];
        const summaryKpiIds = ['kpi-total', 'kpi-completed', 'kpi-inprogress', 'kpi-enrolled', 'kpi-avgprogress'];
        const summaryStatsCacheTtlMs = 30000;
        let summaryStatsRequest = null;
        let summaryStatsCache = null;
        let summaryStatsCacheAt = 0;
        const enrollmentStatusToneMap = {
            Completed: "success",
            "In Progress": "primary",
            Enrolled: "default"
        };

        let filterCourseId = null;
        let filterStatus = 'all';

        const enrollmentsStore = createDataStore(serviceUrl, 'admin/EnrollmentsCRUD');

        const coursesLookupStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetForLookup` });
        const dsCoursesLookup = {
            store: coursesLookupStore,
            loadMode: 'raw',
            cacheRawData: true
        };

        const dsCoursesSelect = {
            store: createDataStore(serviceUrl, 'admin/CoursesCRUD'),
            paginate: true,
            pageSize: 20
        };

        function formatTimeSpent(seconds) {
            if (!seconds || seconds === 0) return '—';
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            if (h > 0) return h + 'h ' + m + 'm';
            return m + 'm';
        }

        function applySummaryStats(d) {
            $("#kpi-total").text(d.totalCount);
            $("#kpi-completed").text(d.completedCount);
            $("#kpi-inprogress").text(d.inProgressCount);
            $("#kpi-enrolled").text(d.enrolledCount);
            $("#kpi-avgprogress").text(d.avgProgress + '%');
        }

        function loadSummaryStats(options) {
            const settings = options || {};
            const force = settings.force === true;
            const now = Date.now();
            const canUseCache = !force && summaryStatsCache && (now - summaryStatsCacheAt) < summaryStatsCacheTtlMs;

            if (canUseCache) {
                applySummaryStats(summaryStatsCache);
                return $.Deferred().resolve(summaryStatsCache).promise();
            }

            if (summaryStatsRequest) {
                return summaryStatsRequest;
            }

            showStatSkeleton(summaryKpiIds);

            summaryStatsRequest = $.ajax({
                url: `${serviceUrl}/admin/EnrollmentsCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                summaryStatsCache = d || {};
                summaryStatsCacheAt = Date.now();
                applySummaryStats(summaryStatsCache);
            }).fail(function() {
                hideStatSkeleton(summaryKpiIds);
            }).always(function() {
                summaryStatsRequest = null;
            });

            return summaryStatsRequest;
        }

        function applyFilters() {
            const filters = [];
            if (filterCourseId) filters.push(["courseId", "=", filterCourseId]);
            if (filterStatus === 'completed') filters.push(["isCompleted", "=", true]);
            if (filterStatus === 'inprogress') { filters.push(["isCompleted", "=", false]); filters.push("and"); filters.push(["progress", ">", 0]); }
            if (filterStatus === 'enrolled') { filters.push(["isCompleted", "=", false]); filters.push("and"); filters.push(["progress", "=", 0]); }

            if (filters.length > 1 && filterCourseId && filterStatus !== 'all') {
                gridInstance.filter([["courseId", "=", filterCourseId], "and", ...filters.slice(1)]);
            } else if (filters.length > 0) {
                gridInstance.filter(filters.length === 1 ? filters[0] : filters);
            } else {
                gridInstance.clearFilter();
            }
            gridInstance.refresh();
        }

        function resetEnrollment(id, studentCode) {
            showAdminConfirmDialog({
                title: 'Reset Progress?',
                messageHtml: `<div class="u-text-secondary-60">Reset all progress for <strong>${escapeAdminHtml(studentCode)}</strong>.<br>Learning logs will be preserved for history.</div>`,
                icon: 'warning',
                confirmButtonText: 'Reset',
                cancelButtonText: 'Cancel',
                confirmType: 'danger'
            }).done((confirmed) => {
                if (confirmed) {
                    $.ajax({
                        url: `${serviceUrl}/Enrollments/ResetStatus?key=${id}`,
                        type: 'POST',
                        xhrFields: { withCredentials: true }
                    }).done(() => {
                        showToast("Progress reset successfully.", "success", 2000);
                        loadSummaryStats({ force: true });
                        gridInstance.refresh();
                    }).fail((xhr) => {
                        showToast(xhr.responseJSON?.message || "Failed to reset.", "error", 3000);
                    });
                }
            });
        }

        $(() => {
            loadSummaryStats();

            // ── Filter Bar Controls ──
            $("#filterCourse").dxSelectBox({
                dataSource: { store: coursesLookupStore, paginate: true, pageSize: 20 },
                valueExpr: 'id',
                displayExpr: 'code',
                value: null,
                placeholder: 'All Courses',
                showClearButton: true,
                searchEnabled: true,
                searchExpr: 'code',
                searchMode: 'contains',
                width: '100%',
                onValueChanged: (e) => { filterCourseId = e.value; applyFilters(); }
            });

            $("#filterStatus").dxSelectBox({
                dataSource: statusOptions,
                valueExpr: 'id',
                displayExpr: 'name',
                value: 'all',
                width: 160,
                onValueChanged: (e) => { filterStatus = e.value; applyFilters(); }
            });

            $("#btnClearFilters").on('click', function() {
                filterCourseId = null;
                filterStatus = 'all';
                $("#filterCourse").dxSelectBox("instance").option('value', null);
                $("#filterStatus").dxSelectBox("instance").option('value', 'all');
                applyFilters();
            });

            // ── DataGrid ──
            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search learner ID...", {
                height: "100%",
                dataSource: enrollmentsStore,
                remoteOperations: true,

                export: { enabled: true, allowExportSelectedData: true },
                onExporting: (e) => handleExporting(e, 'Enrollment_Report'),

                editing: {
                    mode: "popup", allowUpdating: true, allowDeleting: true, allowAdding: false, useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this enrollment?" },
                    popup: {
                        title: "Edit Enrollment",
                        showTitle: true,
                        width: 500,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Enrollment Info",
                                colCount: 1,
                                items: [
                               
                                    {
                                        dataField: "studentCode",
                                        label: { text: "Learner ID" },
                                        editorOptions: { readOnly: true }
                                    },
                                    {
                                        dataField: "courseId",
                                        label: { text: "Course" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: dsCoursesSelect,
                                            displayExpr: "code",
                                            valueExpr: "id",
                                            searchEnabled: true,
                                            searchExpr: ["code", "title"],
                                            readOnly: true
                                        }
                                    }
                                ]
                            },
                            {
                                itemType: "group",
                                caption: "Progress",
                                colCount: 2,
                                items: [
                                    {
                                        dataField: "progress",
                                        label: { text: "Progress (%)" },
                                        editorType: "dxNumberBox",
                                        editorOptions: { min: 0, max: 100 }
                                    },
                                    {
                                        dataField: "totalScore",
                                        label: { text: "Score" },
                                        editorType: "dxNumberBox",
                                        editorOptions: { min: 0 }
                                    },
                                    {
                                        dataField: "isCompleted",
                                        label: { text: "Completed" },
                                        editorType: "dxSwitch",
                                        editorOptions: { switchedOnText: "Yes", switchedOffText: "No" }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                 { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "studentCode", caption: "Learner ID", width: 130 },
                    {
                        dataField: "courseId", caption: "Course", minWidth: 180,
                        lookup: { dataSource: dsCoursesLookup, displayExpr: "code", valueExpr: "id" }
                    },
                    {
                        caption: "Status", width: 120, alignment: "center",
                        allowEditing: false,
                        calculateCellValue: function(r) {
                            if (r.isCompleted) return "Completed";
                            if (r.progress > 0) return "In Progress";
                            return "Enrolled";
                        },
                        cellTemplate: (container, options) => window.renderAdminGridStatusCell(
                            container,
                            options.value,
                            enrollmentStatusToneMap[options.value] || "default"
                        )
                    },
                    {
                        dataField: "progress", caption: "Progress", width: 100, alignment: "center",
                        allowEditing: false,
                        cssClass: "cell-accent",
                        customizeText: function(e) { return Math.round(e.value || 0) + "%"; }
                    },
                    {
                        dataField: "totalScore", caption: "Score", width: 80, alignment: "center",
                        allowEditing: false,
                        cellTemplate: (container, options) => {
                            const value = options.value || 0;
                            window.renderAdminGridTextCell(container, value > 0 ? value : "—", value > 0 ? "captionStrong" : "captionMuted");
                        }
                    },
                    {
                        dataField: "totalTimeSpent", caption: "Time Spent", width: 100, alignment: "center",
                        allowEditing: false,
                        cssClass: "cell-caption",
                        customizeText: function(e) { return formatTimeSpent(e.value); }
                    },
                    {
                        dataField: "completedDate", caption: "Completed On", dataType: "datetime",
                        format: ADMIN_DATETIME_DISPLAY_FORMAT, width: 160, alignment: "center",
                        allowEditing: false,
                        cssClass: "cell-caption",
                        customizeText: function(e) {
                            return e.value ? window.formatAdminDateTime(e.value, "—") : "—";
                        }
                    },
                    { dataField: "createdAt", caption: "Enrolled On", dataType: "datetime", format: ADMIN_DATETIME_DISPLAY_FORMAT, width: 160, allowEditing: false },
                    {
                        type: "buttons", caption: "Manage", width: 130, alignment: "center",
                        buttons: [
                            "edit",
                            {
                                hint: "Reset Progress", icon: "refresh",
                                visible: e => e.row.data.progress > 0 || e.row.data.isCompleted,
                                onClick: e => resetEnrollment(e.row.data.id, e.row.data.studentCode)
                            },
                            "delete"
                        ]
                    }
                ],
                onRowUpdated: () => loadSummaryStats({ force: true }),
                onRowRemoved: () => loadSummaryStats({ force: true })
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });
        });
    </script>
}