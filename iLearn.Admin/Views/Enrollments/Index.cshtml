@{
    ViewBag.Title = "Enrollments";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Enrollments</div>
        <div class="text-secondary" style="font-size:12px;">Track employee enrollments, learning progress, and completion status.</div>
    </div>
    <a href="javascript:void(0);" class="action-link" onclick="exportGrid()">
        <i class="fas fa-file-excel" style="color:var(--success-color);"></i> Export Report
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        const enrollmentsStore = createDataStore(serviceUrl, 'admin/EnrollmentsCRUD');
        const dsCourses = {
            store: createDataStore(serviceUrl, 'admin/CoursesCRUD'),
            paginate: true,
            pageSize: 20
        };

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: enrollmentsStore,
                remoteOperations: true,
                searchPanel: { visible: true, placeholder: "Search student code..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                export: { enabled: false }, // ซ่อนปุ่มเดิมเพราะเราใช้ปุ่มด้านบน
                onExporting: (e) => handleExporting(e, 'Enrollment_Report'),

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this enrollment?" },
                    popup: { title: "Enrollment Details", showTitle: true, width: 500, height: 'auto' },
                    form: {
                        items: [
                            {
                                itemType: "group", caption: "Assignment Info", colCount: 1,
                                items: [
                                    { dataField: "studentCode", label: { text: "Student Code" }, validationRules: [{ type: "required" }] },
                                    {
                                        dataField: "courseId", editorType: "dxSelectBox",
                                        editorOptions: { dataSource: dsCourses, displayExpr: "code", valueExpr: "id", searchEnabled: true, searchExpr: ["code", "title"] },
                                        validationRules: [{ type: "required" }]
                                    }
                                ]
                            },
                            {
                                itemType: "group", caption: "Progress Status", colCount: 2,
                                items: [
                                    { dataField: "isCompleted", editorType: "dxCheckBox", editorOptions: { text: "Course Completed" } },
                                    { dataField: "progress", editorType: "dxNumberBox", editorOptions: { min: 0, max: 100 } }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, visible: false },
                    { dataField: "studentCode", caption: "Student Code", width: 150 },
                    {
                        dataField: "courseId", caption: "Course Code / Title", minWidth: 200,
                        lookup: { dataSource: dsCourses, displayExpr: "title", valueExpr: "id" }
                    },
                    {
                        caption: "Status", width: 140, alignment: "center",
                        calculateCellValue: function(rowData) {
                            if (rowData.isCompleted) return "Completed";
                            if (rowData.progress > 0) return "In Progress";
                            return "Enrolled";
                        }
                    },
                    {
                        dataField: "progress", caption: "Progress", width: 180, alignment: "center",
                        // ใช้ dxProgressBar ของ DevExtreme แทนการเขียน HTML String เอง
                        cellTemplate: function(container, options) {
                            $("<div/>").dxProgressBar({
                                min: 0, max: 100, value: options.value || 0,
                                statusFormat: function(ratio, value) { return value + "%"; }
                            }).appendTo(container);
                        }
                    },
                    { dataField: "createdAt", caption: "Assigned On", dataType: "datetime", format: "dd MMM yyyy HH:mm", width: 160 },
                    {
                        type: "buttons", caption: "Manage", width: 100, alignment: "center", fixed: true, fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        function exportGrid() {
            if (gridInstance) {
                gridInstance.exportToExcel(false);
            }
        }
    </script>
}