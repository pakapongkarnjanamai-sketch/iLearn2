@{
    ViewBag.Title = "Enrollments";
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@ViewBag.Title</h5>
        </div>
        <div class="card-body">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(() => {
            const grid = $("#grid").dxDataGrid({
                dataSource: createDataStore(serviceUrl, 'admin/EnrollmentsCRUD', {
                    key: 'id',
                }),
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: true,
                scrolling: { mode: "virtual" },
                height: "100%",
                headerFilter: { visible: true, search: { enabled: true } },
                searchPanel: { visible: true, width: 300 },
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    form: {
                        items: [
                            { dataField: 'Id', editorOptions: { disabled: true } },
                            { dataField: 'StudentCode' },
                            { dataField: 'CourseId' },
                            { dataField: 'isCompleted', editorType: 'dxCheckBox', caption: 'Completed' },
                            { dataField: 'DueDate', editorType: 'dxDateBox' },
                            { dataField: 'CompletedDate', editorType: 'dxDateBox' }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 50, allowUpdating: false },
                    { dataField: "studentCode", caption: "Student Code" },
                    {
                        dataField: "courseId",
                        caption: "Course",
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
                            displayExpr: 'title', // หรือ Name ตาม Model Course ของคุณ
                            valueExpr: 'id'
                        }
                    },
                    { dataField: "isCompleted", caption: "Completed", dataType: "boolean", width: 100 },
                    { dataField: "dueDate", caption: "Due Date", dataType: "date", format: "yyyy-MM-dd" },
                    { dataField: "completedDate", caption: "Completed", dataType: "date", format: "yyyy-MM-dd HH:mm" },
                            {
            type: "buttons",
            width: 110,
            buttons: [
                "edit",
                "delete",
                {
                    hint: "Reset for Retake",
                    icon: "refresh",
                    onClick: function(e) {
                        const data = e.row.data;
                        DevExpress.ui.dialog.confirm(`ต้องการ Reset การเรียนของ ${data.studentCode} ในวิชานี้เพื่อให้เรียนใหม่ใช่หรือไม่?`, "ยืนยันการ Reset")
                            .done(function(result) {
                                if (result) {
                                    // เรียก API สำหรับ Reset (คุณอาจต้องสร้าง Endpoint นี้เพิ่มใน API)
                                    $.ajax({
                                        url: `${serviceUrl}/Enrollments/ResetStatus?key=${data.id}`,
                                        method: 'POST',
                                        xhrFields: { withCredentials: true },
                                        success: function() {
                                            DevExpress.ui.notify("Reset สถานะเรียบร้อยแล้ว", "success", 2000);
                                            e.component.refresh();
                                        }
                                    });
                                }
                            });
                    }
                }
            ]
        }
                ],
            }).dxDataGrid('instance');
        })
    </script>
}