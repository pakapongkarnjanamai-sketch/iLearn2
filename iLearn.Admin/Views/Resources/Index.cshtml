@{
    ViewBag.Title = "Resource Library";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Resource Library</div>
        <div class="text-secondary" style="font-size:12px;">Manage learning materials, SCORM packages, and assign them to courses.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="openUploadPopup()">
        <i class="fas fa-cloud-upload-alt"></i> Upload Resource
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

<div id="uploadPopup"></div>
<div id="popupContent" style="display:none;">
    <div class="p-3">
        <div class="mb-3">
            <label class="filter-label">1. Select Content Type</label>
            <div id="uploadTypeSelect"></div>
        </div>
        <div>
            <label class="filter-label">2. Choose File (.zip)</label>
            <div id="fileUploader"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const resourceTypes = [{ id: 1, name: 'Learn' }, { id: 2, name: 'Exam' }];
        let selectedUploadTypeId = 1;
        let uploadPopupInstance;
        let gridInstance;

        // lookup column — raw+cached ดึงครั้งเดียว resolve courseId → code
        const dsCoursesLookup = {
            store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetForLookup` }),
            loadMode: 'raw',
            cacheRawData: true
        };

        $(() => {
            // 1. Popup Upload
            uploadPopupInstance = $("#uploadPopup").dxPopup({
                title: "Upload New Resource",
                width: 500, height: 'auto',
                contentTemplate: function(contentElement) {
                    contentElement.append($("#popupContent").show());
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Upload", type: "success", onClick: () => { $("#fileUploader").dxFileUploader("instance").upload(); } }
                    },
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Cancel", onClick: () => uploadPopupInstance.hide() }
                    }
                ]
            }).dxPopup("instance");

            // 2. SelectBox
            $("#uploadTypeSelect").dxSelectBox({
                dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name', value: selectedUploadTypeId,
                onValueChanged: (e) => { selectedUploadTypeId = e.value; $("#fileUploader").dxFileUploader("instance").option("uploadUrl", getUploadUrl()); }
            });
            function getUploadUrl() { return `${serviceUrl}/Resources/upload?typeId=${selectedUploadTypeId}`; }

            // 3. File Uploader
            $("#fileUploader").dxFileUploader({
                name: 'file', accept: '.zip', uploadMode: 'useButtons',
                uploadUrl: getUploadUrl(),
                onUploaded: () => {
                    DevExpress.ui.notify("File uploaded successfully", "success", 2000);
                    if(gridInstance) gridInstance.refresh();
                    uploadPopupInstance.hide();
                }
            });

            // 4. DataGrid
            let isShowingUnassigned = true;
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' }),
                remoteOperations: true,
                filterValue: ["courseIdsCount", "=", 0],
                searchPanel: { visible: true, placeholder: "Search resources..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                editing: {
                    mode: "popup", allowUpdating: true, allowDeleting: true, allowAdding: false, useIcons: true
                },
                onToolbarPreparing: function(e) {
                    // ปล่อยปุ่ม Show All/Show Unassigned ไว้ใน Toolbar เหมือนเดิม เพราะเป็นการ Filter
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        widget: "dxButton",
                        options: {
                            text: "Show All Resources",
                            onClick: function(args) {
                                if (isShowingUnassigned) {
                                    gridInstance.clearFilter();
                                    args.component.option("text", "Show Unassigned Only");
                                    isShowingUnassigned = false;
                                } else {
                                    gridInstance.filter(["courseIdsCount", "=", 0]);
                                    args.component.option("text", "Show All Resources");
                                    isShowingUnassigned = true;
                                }
                            }
                        }
                    });
                },
                columns: [
                    { dataField: "name", caption: "Resource File Name", dataType: "string", minWidth: 250 },
                    { dataField: "typeId", caption: "Resource Type", dataType: "number",
                        lookup: { dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name' },
                        alignment: "center", width: 140,
                        cellTemplate: function(container, options) {
                            const cls = options.value === 1 ? "tag-pill pill-learn" : "tag-pill pill-exam";
                            $("<span>").addClass(cls).text(options.displayValue || "—").appendTo(container);
                        }
                    },
                    {
                        dataField: "courseIdsCount", dataType: "number", visible: false,
                        calculateCellValue: rowData => rowData.courseResources ? rowData.courseResources.length : 0
                    },
                    {
                        dataField: "courseIds", caption: "Assigned Courses", dataType: "object", allowSorting: false,
                        calculateCellValue: rowData => rowData.courseResources ? rowData.courseResources.map(cr => cr.courseId) : [],
                        lookup: {
                            dataSource: dsCoursesLookup,
                            displayExpr: 'code',
                            valueExpr: 'id'
                        }
                    },
                    { dataField: "isActive", caption: "Status", dataType: "boolean", alignment: "center",
                        cellTemplate: function(container, options) {
                            const cls = options.value ? "status-pill pill-success" : "status-pill pill-default";
                            const label = options.value ? "Active" : "Draft";
                            $("<span>").addClass(cls).text(label).appendTo(container);
                        }
                    },
                    {
                        type: "buttons", caption: "Manage", width: 140, alignment: "center",
                        buttons: [
                            { hint: "Publish", icon: "upload", visible: e => !e.row.data.isActive, onClick: e => setResourcePublic(e.row.data.id) },
                            { hint: "Preview", icon: "video", visible: e => e.row.data.isActive, onClick: e => window.open(`${serviceUrl}/Resources/${e.row.data.id}/content`, '_blank') },
                            "edit",
                            { name: "delete", visible: e => !e.row.data.isActive }
                        ]
                    }
                ]
            });

            function setResourcePublic(id) {
                if(confirm("Extract and publish this SCORM package?")) {
                    $.post(`${serviceUrl}/Resources/SetPublic?key=${id}`, () => {
                        DevExpress.ui.notify("Published successfully!", "success", 2000);
                        if(gridInstance) gridInstance.refresh();
                    });
                }
            }
        });

        // เรียกจากปุ่มบน Page Header
        window.openUploadPopup = function() {
            uploadPopupInstance.show();
        };
    </script>
}