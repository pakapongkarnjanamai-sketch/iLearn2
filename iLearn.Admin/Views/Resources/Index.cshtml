@{
    ViewBag.Title = "Resource Library";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-folder-open"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage learning materials, SCORM packages, and assign them to courses.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="openUploadPopup()">
                    <i class="fas fa-cloud-upload-alt me-2"></i> Upload Resource
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

<div id="uploadPopup"></div>
<div id="popupContent" style="display: none;">
    <div class="p-3">
        <div class="mb-4">
            <label class="form-label text-dark fw-bold mb-2">
                <i class="fas fa-tag text-primary me-2"></i> 1. Select Content Type
            </label>
            <div id="uploadTypeSelect"></div>
        </div>
        <div>
            <label class="form-label text-dark fw-bold mb-2">
                <i class="fas fa-file-archive text-primary me-2"></i> 2. Choose File (.zip)
            </label>
            <div class="border rounded bg-light p-3 text-center mb-2" style="border-style: dashed !important; border-width: 2px !important;">
                <div id="fileUploader"></div>
            </div>
            <div class="text-muted small text-center">
                <i class="fas fa-info-circle text-primary me-1"></i>
                Supported format: <b>.zip (SCORM)</b> | Max file size: <b>100MB</b>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const resourceTypes = [
            { id: 1, name: 'Learn' },
            { id: 2, name: 'Exam' }
        ];

        let selectedUploadTypeId = 1;
        let gridInstance;
        let uploadPopupInstance;

        $(() => {
            // --- 1. Init Upload Popup ---
            uploadPopupInstance = $("#uploadPopup").dxPopup({
                title: "Upload New Resource",
                width: 500,
                height: 'auto',
                showCloseButton: true,
                dragEnabled: false,
                hideOnOutsideClick: true,
                contentTemplate: function(contentElement) {
                    contentElement.append($("#popupContent"));
                    $("#popupContent").show();
                },
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Confirm & Upload",
                            icon: "upload",
                            type: "success",
                            stylingMode: "contained",
                            onClick: function() {
                                const uploader = $("#fileUploader").dxFileUploader("instance");
                                const files = uploader.option("value");
                                if (files && files.length > 0) {
                                    uploader.upload();
                                } else {
                                    DevExpress.ui.notify("Please select at least one file to upload.", "warning", 2000);
                                }
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancel",
                            stylingMode: "outlined",
                            type: "normal",
                            onClick: function() {
                                uploadPopupInstance.hide();
                            }
                        }
                    }
                ],
                onHidden: function() {
                    const uploader = $("#fileUploader").dxFileUploader("instance");
                    if(uploader) uploader.reset();
                }
            }).dxPopup("instance");

            window.openUploadPopup = function() {
                uploadPopupInstance.show();
            };

            // --- 2. Upload Type SelectBox ---
            $("#uploadTypeSelect").dxSelectBox({
                dataSource: resourceTypes,
                valueExpr: 'id',
                displayExpr: 'name',
                value: selectedUploadTypeId,
                onValueChanged: function(e) {
                    selectedUploadTypeId = e.value;
                    const uploader = $("#fileUploader").dxFileUploader("instance");
                    uploader.option("uploadUrl", getUploadUrl());
                }
            });

            function getUploadUrl() {
                return `${serviceUrl}/Resources/upload?typeId=${selectedUploadTypeId}`;
            }

            // --- 3. File Uploader Configuration ---
            $("#fileUploader").dxFileUploader({
                name: 'file',
                multiple: true,
                accept: '.zip',
                uploadMode: 'useButtons',
                maxFileSize: 100 * 1024 * 1024, // 100MB
                selectButtonText: "Browse Files",
                labelText: "or drag and drop here",
                uploadFile: function(file, progressCallback) {
                    var deferred = $.Deferred();
                    var formData = new FormData();
                    formData.append("file", file);

                    var xhr = new XMLHttpRequest();
                    var url = getUploadUrl();
                    xhr.open("POST", url, true);
                    xhr.withCredentials = true;

                    xhr.upload.onprogress = function(e) {
                        if (e.lengthComputable) {
                            progressCallback(e.loaded, e.total);
                        }
                    };
                    xhr.onload = function() {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            deferred.resolve();
                        } else {
                            deferred.reject(xhr.responseText || xhr.statusText);
                        }
                    };
                    xhr.onerror = function() {
                        deferred.reject("Network Error");
                    };

                    xhr.send(formData);
                    return deferred.promise();
                },
               onUploaded: function (e) {
                    DevExpress.ui.notify({ message: "File uploaded successfully", type: "success", displayTime: 2000 });
                    if(gridInstance) gridInstance.refresh();
                    if(uploadPopupInstance) uploadPopupInstance.hide();
                },
                onUploadError: function (e) {
                    let msg = e.error || "Upload failed";
                    DevExpress.ui.notify({ message: msg, type: "error", displayTime: 4000 });
                }
            });

            // --- 4. DataGrid Configuration ---
            const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });
            let isShowingUnassigned = true;
            gridInstance = initDxGrid("#grid", {
                dataSource: resourcesStore,
                filterValue: ["courseIdsCount", "=", 0],
                remoteOperations: { paging: true, sorting: true, filtering: false },
                searchPanel: { placeholder: "Search resources..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        widget: "dxButton",
                        options: {
                            text: "Show All Resources",
                            icon: "group",
                            stylingMode: "outlined",
                            type: "normal",
                           onClick: function(args) {
                                // เช็คจากตัวแปรสถานะของเราเอง
                                if (isShowingUnassigned) {
                                    // 1. ถ้ากำลังโชว์ Unassigned -> ให้เคลียร์ฟิลเตอร์เพื่อโชว์ทั้งหมด
                                    gridInstance.clearFilter();
                                    args.component.option({
                                        text: "Show Unassigned Only",
                                        icon: "filter",
                                        stylingMode: "contained",
                                        type: "primary"
                                    });
                                    isShowingUnassigned = false; // อัปเดตสถานะ
                                } else {
                                    // 2. ถ้ากำลังโชว์ทั้งหมด -> ให้ใส่ฟิลเตอร์กลับไป
                                    gridInstance.filter(["courseIdsCount", "=", 0]);
                                    args.component.option({
                                        text: "Show All Resources",
                                        icon: "group",
                                        stylingMode: "outlined",
                                        type: "normal"
                                    });
                                    isShowingUnassigned = true; // อัปเดตสถานะ
                                }
                            }
                        }
                    });
                },

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: false,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this resource?" },
                    popup: { title: "Edit Resource Information", showTitle: true, width: 600, height: 400 },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                caption: "Details",
                                colCount: 1,
                                items: [
                                    { dataField: 'name', validationRules: [{ type: "required" }] },
                                    {
                                        dataField: 'typeId',
                                        editorType: "dxSelectBox",
                                        editorOptions: { dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name' },
                                        validationRules: [{ type: "required" }]
                                    },
                                    { dataField: 'isActive', editorType: "dxCheckBox", editorOptions: { text: "Set as Active" }, label: { visible: false } }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "name",
                        caption: "Resource File Name",
                        dataType: "string", // <-- ระบุ Type ป้องกัน W1005
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            const name = options.value || "";
                            let iconClass = 'far fa-file text-secondary';

                            if(name.toLowerCase().endsWith('.zip')) iconClass = 'fas fa-file-archive text-warning';
                            else if(name.toLowerCase().endsWith('.pdf')) iconClass = 'fas fa-file-pdf text-danger';
                            else if(name.toLowerCase().endsWith('.mp4')) iconClass = 'fas fa-file-video text-info';

                            const wrapper = $("<div>").addClass("fw-medium text-dark d-flex align-items-center gap-2");
                            $("<i>").addClass(iconClass).appendTo(wrapper);
                            $("<span>").text(name).appendTo(wrapper);

                            container.append(wrapper);
                        }
                    },
                    {
                        dataField: "typeId",
                        caption: "Resource Type",
                        dataType: "number", // <-- ระบุ Type
                        width: 150,
                        lookup: { dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name' }
                    },
                    {
                        dataField: "courseIdsCount",
                        dataType: "number", // <-- ต้นเหตุที่ทำให้เกิด W1005 (เพราะมีการ Filter ตอนเริ่มต้น)
                        visible: false,
                        calculateCellValue: function(rowData) {
                            return rowData.courseResources ? rowData.courseResources.length : 0;
                        }
                    },
                    {
                        dataField: "courseIds",
                        caption: "Assigned Courses",
                        dataType: "object", // <-- ระบุ Type เนื่องจากข้อมูลเป็น Array
                        width: 280,
                        allowSorting: false,
                        calculateCellValue: function(rowData) {
                            return rowData.courseResources ? rowData.courseResources.map(cr => cr.courseId) : [];
                        },
                        editCellTemplate: tagBoxCourseTemplate,
                        lookup: {
                            dataSource: {
                                store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
                                paginate: true,
                                pageSize: 20
                            },
                            displayExpr: 'code',
                            valueExpr: 'id',
                        },
                        cellTemplate: function(container, options) {
                            const items = options.value || [];
                            if(items.length === 0) {
                                container.html('<span class="text-muted small">- Not assigned -</span>');
                                return;
                            }

                            const wrapper = $("<div>").addClass("d-flex flex-wrap gap-1");
                            items.forEach(id => {
                                const code = options.column.lookup.calculateCellValue(id) || id;
                                $("<span>")
                                    .addClass("badge bg-light text-primary border px-2 py-1")
                                    .text(code)
                                    .appendTo(wrapper);
                            });
                            container.append(wrapper);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        dataType: "boolean", // <-- ระบุ Type
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>").addClass("badge bg-success text-white px-2 py-1").html('<i class="fas fa-check-circle"></i> Active').appendTo(container);
                            } else {
                                $("<span>").addClass("badge bg-warning text-dark px-2 py-1").html('<i class="fas fa-hourglass-half"></i> Pending').appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 140,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Extract & Publish SCORM",
                                icon: "upload",
                                visible: function(e) { return !e.row.data.isActive; },
                                onClick: function(e) { setResourcePublic(e.row.data.id); }
                            },
                            {
                                hint: "Preview Content",
                                icon: "video",
                                visible: function(e) { return e.row.data.isActive; },
                                onClick: function(e) { viewContent(e.row.data); }
                            },
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) { return !e.row.data.isActive; }
                            }
                        ]
                    }
                ]
            });

            // --- Helpers ---
            function tagBoxCourseTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: {
                        store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
                        paginate: true,
                        pageSize: 20
                    },
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'code',
                    searchExpr: ['code', 'title'],
                    itemTemplate: function(data) {
                        return `<div><strong class="text-primary">${data.code}</strong> <small class="text-muted">- ${data.title}</small></div>`;
                    },
                    showSelectionControls: true,
                    maxDisplayedTags: 3,
                    showMultiTagOnly: false,
                    applyValueMode: 'useButtons',
                    searchEnabled: true,
                    placeholder: "Search course by code or title...",
                    onValueChanged(e) { cellInfo.setValue(e.value); },
                    onSelectionChanged(e) { cellInfo.component.updateDimensions(); }
                });
            }

            function setResourcePublic(id) {
                DevExpress.ui.dialog.confirm(
                    "<div class='text-center'><i class='fas fa-box-open text-primary mb-2' style='font-size: 2rem;'></i><br>Extract and publish this SCORM package?</div>",
                    "Publish Resource"
                ).done(function(dialogResult) {
                    if (dialogResult) {
                        DevExpress.ui.notify("Extracting files... Please wait.", "info", 3000);

                        $.ajax({
                            url: `${serviceUrl}/Resources/SetPublic?key=${id}`,
                            type: "POST",
                            xhrFields: { withCredentials: true },
                            success: function(res) {
                                DevExpress.ui.notify("Published successfully!", "success", 2000);
                                gridInstance.refresh();
                            },
                            error: function(xhr) {
                                let msg = xhr.responseText || "Activation failed";
                                DevExpress.ui.notify(msg, "error", 4000);
                            }
                        });
                    }
                });
            }

            function viewContent(resource) {
                const apiUrl = `${serviceUrl}/Resources/${resource.id}/content`;
                if (resource.name.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading Course...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content URL...</div>";
                    }

                    $.ajax({
                        url: apiUrl,
                        method: "GET",
                        xhrFields: { withCredentials: true },
                        success: function(response) {
                            if (response && response.url) {
                                if (win) win.location.href = response.url;
                            } else {
                                if (win) win.close();
                                DevExpress.ui.notify("Content URL not found.", "error", 3000);
                            }
                        },
                        error: function(err) {
                            if (win) win.close();
                            DevExpress.ui.notify("Failed to get content link.", "error", 3000);
                        }
                    });
                } else {
                    window.open(apiUrl, '_blank');
                }
            }
        });
    </script>
}