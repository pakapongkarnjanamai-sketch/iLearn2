@{
    ViewBag.Title = "Resource Library";
}

<!-- Styles moved to ~/wwwroot/css/admin-site.css -->

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage learning materials, SCORM packages, and assign them to courses.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openUploadPopup()">
                    <i class="fas fa-cloud-upload-alt me-2"></i> Upload Resource
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid-resources"></div>
        </div>
    </div>
</div>

<div id="uploadPopup"></div>

<div id="popupContent" style="display: none;">
    <div class="p-2">
        <div class="form-group mb-4">
            <label class="form-label text-dark fw-bold">
                <i class="fas fa-tag text-primary me-1"></i> 1. Select Content Type
            </label>
            <div id="uploadTypeSelect"></div>
        </div>
        <div class="form-group">
            <label class="form-label text-dark fw-bold">
                <i class="fas fa-file-archive text-primary me-1"></i> 2. Choose File (.zip)
            </label>
            <div class="upload-dropzone mt-1">
                <div id="fileUploader"></div>
            </div>
            <div class="mt-3 text-muted small text-center">
                <i class="fas fa-info-circle text-primary"></i>
                Supported format: <b>.zip (SCORM)</b> | Max file size: <b>100MB</b>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    

        const resourceTypes = [
            { id: 1, name: 'Learning Material (Learn)' },
            { id: 2, name: 'Examination (Exam)' }
        ];

        let selectedUploadTypeId = 1;
        let gridInstance;
        let uploadPopupInstance;

        $(() => {

            // --- 1. Init Upload Popup ---
            uploadPopupInstance = $("#uploadPopup").dxPopup({
                title: "Upload New Resource",
                width: 500,
                height: 'auto',
                showCloseButton: true,
                dragEnabled: false,
                hideOnOutsideClick: true,
                contentTemplate: function(contentElement) {
                    contentElement.append($("#popupContent"));
                    $("#popupContent").show();
                },
                // [ใหม่] เพิ่มแถบปุ่มกดด้านล่างของ Popup
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Confirm & Upload",
                            icon: "upload",
                            type: "success",
                            stylingMode: "contained",
                            onClick: function() {
                                const uploader = $("#fileUploader").dxFileUploader("instance");
                                const files = uploader.option("value");
                                // เช็คว่ามีการเลือกไฟล์แล้วหรือยัง
                                if (files && files.length > 0) {
                                    uploader.upload(); // สั่งให้อัปโหลดเมื่อกดปุ่มนี้
                                } else {
                                    DevExpress.ui.notify("Please select at least one file to upload.", "warning", 2000);
                                }
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancel",
                            stylingMode: "outlined",
                            type: "normal",
                            onClick: function() {
                                uploadPopupInstance.hide();
                            }
                        }
                    }
                ],
                onHidden: function() {
                    const uploader = $("#fileUploader").dxFileUploader("instance");
                    if(uploader) uploader.reset();
                }
            }).dxPopup("instance");

            window.openUploadPopup = function() {
                uploadPopupInstance.show();
            };

            // --- 2. Upload Type SelectBox ---
            $("#uploadTypeSelect").dxSelectBox({
                dataSource: resourceTypes,
                valueExpr: 'id',
                displayExpr: 'name',
                value: selectedUploadTypeId,
                onValueChanged: function(e) {
                    selectedUploadTypeId = e.value;
                    const uploader = $("#fileUploader").dxFileUploader("instance");
                    uploader.option("uploadUrl", getUploadUrl());
                }
            });

            function getUploadUrl() {
                return `${serviceUrl}/Resources/upload?typeId=${selectedUploadTypeId}`;
            }

            // --- 3. File Uploader Configuration ---
            $("#fileUploader").dxFileUploader({
                name: 'file',
                multiple: true,
                accept: '.zip',
                // [ใหม่] เปลี่ยนจาก 'instantly' เป็น 'useButtons' เพื่อให้รอกดปุ่ม Confirm ก่อน
                uploadMode: 'useButtons',
                maxFileSize: 100 * 1024 * 1024, // 100MB
                selectButtonText: "Browse Files",
                labelText: "or drag and drop here",

                // Custom Upload Logic (รองรับไฟล์ใหญ่)
                uploadFile: function(file, progressCallback) {
                    var deferred = $.Deferred();
                    var formData = new FormData();
                    formData.append("file", file);

                    var xhr = new XMLHttpRequest();
                    var url = getUploadUrl();
                    xhr.open("POST", url, true);
                    xhr.withCredentials = true;

                    xhr.upload.onprogress = function(e) {
                        if (e.lengthComputable) {
                            progressCallback(e.loaded, e.total);
                        }
                    };

                    xhr.onload = function() {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            deferred.resolve();
                        } else {
                            deferred.reject(xhr.responseText || xhr.statusText);
                        }
                    };

                    xhr.onerror = function() {
                        deferred.reject("Network Error");
                    };

                    xhr.send(formData);
                    return deferred.promise();
                },

               onUploaded: function (e) {
                    DevExpress.ui.notify({ message: "File uploaded successfully", type: "success", displayTime: 2000 });
                    if(gridInstance) gridInstance.refresh();

                    // ปิด Popup หลังจากอัปโหลดเสร็จและรีเฟรชตารางแล้ว
                    if(uploadPopupInstance) uploadPopupInstance.hide();
                },
                onUploadError: function (e) {
                    let msg = e.error || "Upload failed";
                    DevExpress.ui.notify({ message: msg, type: "error", displayTime: 4000 });
                }
            });

          // --- 4. DataGrid Configuration ---
            const resourcesStore = createDataStore(serviceUrl, 'admin/ResourcesCRUD', { key: 'id' });

            gridInstance = $("#grid-resources").dxDataGrid({
                dataSource: resourcesStore,
                // ★ 1. ตั้งค่าเริ่มต้นให้กรองเฉพาะไฟล์ที่ยังไม่ได้ผูกกับ Course (Unassigned)
                filterValue: ["courseIdsCount", "=", 0],
                remoteOperations: {
                    paging: true,
                    sorting: true,
                    filtering: false
                },
                columnAutoWidth: true,
                showBorders: false,
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                height: "calc(100vh - 280px)",
                headerFilter: { visible: true },
                searchPanel: { visible: true, width: 300, placeholder: "Search resources..." },

                // ★ 2. แถบเครื่องมือ (Toolbar) ปรับปุ่ม Toggle ให้สัมพันธ์กับค่าเริ่มต้น
                onToolbarPreparing: function(e) {
                    e.toolbarOptions.items.unshift({
                        location: "before",
                        widget: "dxButton",
                        options: {
                            // สถานะเริ่มต้น (เนื่องจาก Grid โดน Filter ไว้แล้วตั้งแต่โหลดหน้า)
                            text: "Show All Resources",
                            icon: "group", // เปลี่ยนไอคอนให้สื่อถึงการดูทั้งหมด
                            stylingMode: "outlined",
                            type: "normal",
                            onClick: function(args) {
                                const currentFilter = gridInstance.option("filterValue");
                                const isUnassignedFiltered = currentFilter && JSON.stringify(currentFilter).includes("courseIdsCount");

                                if (isUnassignedFiltered) {
                                    // กรณีที่กำลังดู Unassigned อยู่ -> ให้ล้าง Filter เพื่อดูทั้งหมด
                                    gridInstance.clearFilter();
                                    args.component.option({
                                        text: "Show Unassigned Only",
                                        icon: "filter",
                                        stylingMode: "contained",
                                        type: "primary"
                                    });
                                } else {
                                    // กรณีที่กำลังดูทั้งหมดอยู่ -> ให้กลับมากรองเฉพาะ Unassigned
                                    gridInstance.filter(["courseIdsCount", "=", 0]);
                                    args.component.option({
                                        text: "Show All Resources",
                                        icon: "group",
                                        stylingMode: "outlined",
                                        type: "normal"
                                    });
                                }
                            }
                        }
                    });
                },

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: false,
                    useIcons: true,
                    popup: { title: "Edit Resource Information", showTitle: true, width: 600, height: 400 },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                caption: "Details",
                                colCount: 1,
                                items: [
                                    { dataField: 'name', validationRules: [{ type: "required" }] },
                                    {
                                        dataField: 'typeId',
                                        editorType: "dxSelectBox",
                                        editorOptions: { dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name' },
                                        validationRules: [{ type: "required" }]
                                    },
                                    { dataField: 'isActive', editorType: "dxCheckBox", editorOptions: { text: "Set as Active" }, label: { visible: false } }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "name",
                        caption: "Resource File Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            const name = options.value || "";
                            let iconClass = 'far fa-file text-secondary';

                            if(name.toLowerCase().endsWith('.zip')) iconClass = 'fas fa-file-archive text-warning';
                            else if(name.toLowerCase().endsWith('.pdf')) iconClass = 'fas fa-file-pdf text-danger';
                            else if(name.toLowerCase().endsWith('.mp4')) iconClass = 'fas fa-file-video text-info';

                            const wrapper = $("<div>").addClass("file-icon-wrapper fw-medium text-dark");
                            $("<i>").addClass(iconClass).appendTo(wrapper);
                            $("<span>").text(name).appendTo(wrapper);

                            container.append(wrapper);
                        }
                    },
                    {
                        dataField: "typeId",
                        caption: "Resource Type",
                        width: 150,
                        lookup: { dataSource: resourceTypes, valueExpr: 'id', displayExpr: 'name' }
                    },

                    // Hidden Column สำหรับใช้ กรอง Unassigned
                    {
                        dataField: "courseIdsCount",
                        dataType: "number",
                        visible: false,
                        calculateCellValue: function(rowData) {
                            return rowData.courseResources ? rowData.courseResources.length : 0;
                        }
                    },

                    {
                        dataField: "courseIds",
                        caption: "Assigned Courses",
                        width: 280,
                        allowSorting: false,
                        calculateCellValue: function(rowData) {
                            return rowData.courseResources ? rowData.courseResources.map(cr => cr.courseId) : [];
                        },
                        editCellTemplate: tagBoxCourseTemplate,
                        lookup: {
                            dataSource: {
                                store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
                                paginate: true,
                                pageSize: 20
                            },
                            displayExpr: 'code',
                            valueExpr: 'id',
                        },
                        cellTemplate: function(container, options) {
                            const items = options.value || [];
                            if(items.length === 0) {
                                container.html('<span class="text-muted small">- Not assigned -</span>');
                                return;
                            }

                            const wrapper = $("<div>").addClass("d-flex flex-wrap gap-1");
                            items.forEach(id => {
                                const code = options.column.lookup.calculateCellValue(id) || id;
                                $("<span>")
                                    .addClass("badge")
                                    .css({
                                        "background-color": "var(--brand-light)",
                                        "color": "var(--brand-color)",
                                        "border": "1px solid rgba(0, 98, 204, 0.2)",
                                        "font-size": "0.8rem",
                                        "font-weight": "600",
                                        "padding": "4px 8px"
                                    })
                                    .text(code)
                                    .appendTo(wrapper);
                            });
                            container.append(wrapper);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>").addClass("badge-status badge-active").html('<i class="fas fa-check-circle"></i> Active').appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status badge-pending").html('<i class="fas fa-hourglass-half"></i> Pending').appendTo(container);
                            }
                        }
                    },
                    {
                        caption: "Actions",
                        width: 180,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // 1. Publish Button (if inactive)
                            if (!data.isActive) {
                                $("<button>")
                                    .addClass("btn-icon text-success")
                                    .attr("title", "Extract & Publish SCORM")
                                    .html('<i class="fas fa-globe"></i>')
                                    .on("click", () => setResourcePublic(data.id))
                                    .appendTo($group);
                            }

                            // 2. View Button (if active)
                            if (data.isActive) {
                                $("<button>")
                                    .addClass("btn-icon text-info")
                                    .attr("title", "Preview Content")
                                    .html('<i class="fas fa-play-circle"></i>')
                                    .on("click", () => viewContent(data))
                                    .appendTo($group);
                            }

                            // 3. Edit Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Properties")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // 4. Delete Button (เงื่อนไข: ให้ลบได้เฉพาะ isActive = false)
                            if (!data.isActive) {
                                $("<button>")
                                    .addClass("btn-icon text-danger")
                                    .attr("title", "Delete Resource")
                                    .html('<i class="fas fa-trash-alt"></i>')
                                    .on("click", () => {
                                        DevExpress.ui.dialog.confirm(`Delete resource "<b>${data.name}</b>"?`, "Confirm Delete").done((res) => {
                                            if(res) gridInstance.deleteRow(options.rowIndex);
                                        });
                                    })
                                    .appendTo($group);
                            }

                            $group.appendTo(container);
                        }
                    }
                ]
            }).dxDataGrid('instance');

            // --- Helpers ---

            // TagBox สำหรับตอนแก้ไข
            function tagBoxCourseTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: {
                        store: createDataStore(serviceUrl, 'admin/CoursesCRUD', { key: 'id' }),
                        paginate: true,
                        pageSize: 20
                    },
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'code',
                    searchExpr: ['code', 'title'],
                    itemTemplate: function(data) {
                        return `<div><strong class="text-primary">${data.code}</strong> <small class="text-muted">- ${data.title}</small></div>`;
                    },
                    showSelectionControls: true,
                    maxDisplayedTags: 3,
                    showMultiTagOnly: false,
                    applyValueMode: 'useButtons',
                    searchEnabled: true,
                    placeholder: "Search course by code or title...",
                    onValueChanged(e) { cellInfo.setValue(e.value); },
                    onSelectionChanged(e) { cellInfo.component.updateDimensions(); }
                });
            }

            function setResourcePublic(id) {
                DevExpress.ui.dialog.confirm(
                    "<div class='text-center'><i class='fas fa-box-open text-primary mb-2' style='font-size: 2rem;'></i><br>Extract and publish this SCORM package?</div>",
                    "Publish Resource"
                ).done(function(dialogResult) {
                    if (dialogResult) {
                        DevExpress.ui.notify("Extracting files... Please wait.", "info", 3000);

                        $.ajax({
                            url: `${serviceUrl}/Resources/SetPublic?key=${id}`,
                            type: "POST",
                            xhrFields: { withCredentials: true },
                            success: function(res) {
                                DevExpress.ui.notify("Published successfully!", "success", 2000);
                                gridInstance.refresh();
                            },
                            error: function(xhr) {
                                let msg = xhr.responseText || "Activation failed";
                                DevExpress.ui.notify(msg, "error", 4000);
                            }
                        });
                    }
                });
            }

            function viewContent(resource) {
                const apiUrl = `${serviceUrl}/Resources/${resource.id}/content`;

                if (resource.name.toLowerCase().endsWith('.zip')) {
                    const win = window.open('about:blank', '_blank');
                    if (win) {
                        win.document.title = "Loading Course...";
                        win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;color:#666;'>Processing content URL...</div>";
                    }

                    $.ajax({
                        url: apiUrl,
                        method: "GET",
                        xhrFields: { withCredentials: true },
                        success: function(response) {
                            if (response && response.url) {
                                if (win) win.location.href = response.url;
                            } else {
                                if (win) win.close();
                                DevExpress.ui.notify("Content URL not found.", "error", 3000);
                            }
                        },
                        error: function(err) {
                            if (win) win.close();
                            DevExpress.ui.notify("Failed to get content link.", "error", 3000);
                        }
                    });
                } else {
                    window.open(apiUrl, '_blank');
                }
            }

        }); // End Document Ready
    </script>
}