@using Microsoft.Extensions.Configuration
@using System.Security.Claims

@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

    var courseMenuItems = new (string Controller, string Text, string IconClass)[]
    {
        ("Courses", "Courses", "fas fa-book"),
        ("Assignments", "Assignments", "fas fa-tasks"),
        ("LearnerGroups", "Learner Groups", "fas fa-users-rectangle")
    };

    var adminMenuItems = new (string? Controller, string Text, string IconClass, bool Divider)[]
    {
        ("Users", "Users", "fas fa-user", false),
        ("Roles", "Roles", "fas fa-user-shield", false),
        ("Divisions", "Divisions", "fas fa-building", false),
        ("Learners", "Learners (Employees)", "fas fa-user-graduate", false),
        ("CourseTypes", "Course Types", "fas fa-tags", false),
        (null, string.Empty, string.Empty, true),
        ("ContentItems", "Content Library", "fas fa-folder-open", false),
        (null, string.Empty, string.Empty, true),
        ("Enrollments", "Enrollments", "fas fa-clipboard-check", false),
        ("LearningLogs", "Learning Logs", "fas fa-clock-rotate-left", false)
    };

    var fullWindowsName = User.Identity?.Name ?? string.Empty;
    var nameParts = fullWindowsName.Split('\\', StringSplitOptions.RemoveEmptyEntries);
    var displayName = nameParts.Length > 0 ? nameParts[^1] : fullWindowsName;
    var roles = User.FindAll(ClaimTypes.Role)
        .Select(claim => claim.Value)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var hasSuperAdminRole = roles.Contains("SuperAdmin", StringComparer.OrdinalIgnoreCase);
    var showSuperAdminMenu = hasSuperAdminRole;
    var divisionId = User.FindFirst("DivisionId")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iLearn Admin - @ViewData["Title"]</title>

    <link href="~/favicon.svg" rel="icon" type="image/svg+xml" asp-append-version="true" />

    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <link href="~/css/admin-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-minimal.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("WizardStyles", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-user-shield" aria-hidden="true"></i> iLearn Admin
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index"
                           aria-current="@(currentController == "Home" ? "page" : null)">
                            <i class="fas fa-chart-pie me-1" aria-hidden="true"></i> Dashboard
                        </a>
                    </li>
                    @foreach (var item in courseMenuItems)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == item.Controller ? "active" : "")"
                               asp-controller="@item.Controller" asp-action="Index"
                               aria-current="@(currentController == item.Controller ? "page" : null)">
                                <i class="@item.IconClass me-1" aria-hidden="true"></i>
                                @item.Text
                            </a>
                        </li>
                    }
                    @if (showSuperAdminMenu)
                    {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-users me-1" aria-hidden="true"></i> Admin
                        </a>
                        <ul class="dropdown-menu" aria-label="Admin">
                            @foreach (var item in adminMenuItems)
                            {
                                if (item.Divider)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    continue;
                                }

                                <li>
                                    <a class="dropdown-item" asp-controller="@item.Controller" asp-action="Index">
                                        <i class="@item.IconClass me-2" aria-hidden="true"></i>@item.Text
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "SystemConfig" ? "active" : "")"
                           asp-controller="SystemConfig" asp-action="Index"
                           aria-current="@(currentController == "SystemConfig" ? "page" : null)">
                            <i class="fas fa-cog me-1" aria-hidden="true"></i> System Config
                        </a>
                    </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item me-2 d-flex align-items-center">
                        <a href="@($"{Context.Request.PathBase}-react/")"
                           class="btn btn-sm btn-outline-light d-flex align-items-center gap-1"
                           style="font-size: 12px; padding: 4px 10px; opacity: 0.85;">
                            <i class="fas fa-arrows-rotate" aria-hidden="true"></i>
                            New Admin
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link d-flex align-items-center gap-2 py-1 px-2 admin-profile-trigger"
                           href="#" id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false"
                           aria-label="User menu for @displayName">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 admin-profile-avatar">
                                <i class="fas fa-user admin-profile-avatar-icon" aria-hidden="true"></i>
                            </div>
                            <div class="d-none d-md-flex flex-column lh-1 admin-profile-meta">
                                <span class="fw-semibold admin-profile-name">
                                    @displayName
                                </span>
                             
                            </div>
                            <i class="fas fa-chevron-down ms-1 admin-profile-chevron" aria-hidden="true"></i>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end admin-profile-menu"
                            aria-label="User account">

                            <li class="px-3 py-2 admin-profile-menu-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 admin-profile-avatar admin-profile-avatar-lg">
                                        <i class="fas fa-user-circle admin-profile-menu-avatar-icon" aria-hidden="true"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-truncate admin-profile-menu-name">
                                            @displayName
                                        </div>
                                        <div class="text-muted text-truncate admin-profile-menu-identity">
                                            @fullWindowsName
                                        </div>
                                    </div>
                                </div>
                            </li>

                            <li class="px-3 pt-2 pb-1">
                                <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                    <i class="fas fa-shield-halved me-1" aria-hidden="true"></i>Roles
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in roles)
                                    {
                                        if (role == "SuperAdmin")
                                        {
                                            <span class="badge rounded-pill admin-role-pill admin-role-pill-highlight">
                                                <i class="fas fa-star me-1" aria-hidden="true"></i>@role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill admin-role-pill">
                                                @role
                                            </span>
                                        }
                                    }
                                    @if (!roles.Any())
                                    {
                                        <span class="text-muted admin-profile-empty-text">No roles assigned</span>
                                    }
                                </div>
                            </li>

                            @if (!string.IsNullOrEmpty(divisionId))
                            {
                                <li class="px-3 pb-2">
                                    <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                    <i class="fas fa-building me-1" aria-hidden="true"></i>Division
                                </div>
                                    <span class="badge rounded-pill admin-division-pill">
                                        <i class="fas fa-layer-group me-1" aria-hidden="true"></i>ID: @divisionId
                                    </span>
                                </li>
                            }
                            else if (hasSuperAdminRole)
                            {
                                <li class="px-3 pb-2">
                                    <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                    <i class="fas fa-building me-1" aria-hidden="true"></i>Division
                                </div>
                                    <span class="badge rounded-pill admin-division-pill admin-division-pill-global">
                                        <i class="fas fa-globe me-1" aria-hidden="true"></i>All divisions
                                    </span>
                                </li>
                            }

                            <li><hr class="dropdown-divider my-1"></li>

                            <li>
                                <button type="button"
                                        class="dropdown-item d-flex align-items-center gap-2 py-2 admin-refresh-link"
                                        data-admin-clear-cache="true">
                                    <i class="fas fa-broom text-muted admin-refresh-link-icon" aria-hidden="true"></i>
                                    Clear all cached data
                                </button>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main id="main-content" class="w-100" aria-label="Page content" tabindex="-1">
        @RenderBody()
    </main>



    <script>
        window.iLearnAdminConfig = {
            apiBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["ApiSettings:BaseUrl"] ?? string.Empty)),
            clearAllCacheUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("ClearAll", "Cache") ?? string.Empty)),
            appBasePath: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Content("~/")))
        };
    </script>
    <script src="~/js/devextreme/jquery.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("PreDxScripts", required: false)
    <script src="~/js/devextreme/dx.all.js" asp-append-version="true"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js" asp-append-version="true"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js" asp-append-version="true"></script>
    <script src="~/src/devextreme-license.js" asp-append-version="true"></script>
    @await RenderSectionAsync("ExternalDependencies", required: false)
    <script src="~/js/admin-layout.js" asp-append-version="true"></script>
    <script src="~/js/admin-view-utils.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>