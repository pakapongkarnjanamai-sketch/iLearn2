@using Microsoft.Extensions.Configuration
@using System.Security.Claims

@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

    var courseMenuItems = new (string? Controller, string Text, bool Divider)[]
    {
        ("Courses", "Courses", false),
        ("Assignments", "Assignment", false),
        ("StudentGroups", "Student Groups", false),
        (null, string.Empty, true),
        ("Categories", "Categories", false)
    };

    var adminMenuItems = new (string? Controller, string Text, bool Divider)[]
    {
        ("Users", "Users", false),
        ("Roles", "Roles", false),
        ("Divisions", "Divisions", false),
        ("Students", "Students (Employees)", false),
        ("CourseTypes", "Course Types", false),
        (null, string.Empty, true),
        ("Resources", "Resources Library", false),
        (null, string.Empty, true),
        ("Enrollments", "Enrollments", false),
        ("LearningLogs", "Learning Logs", false)
    };

    var fullWindowsName = User.Identity?.Name ?? string.Empty;
    var nameParts = fullWindowsName.Split('\\', StringSplitOptions.RemoveEmptyEntries);
    var displayName = nameParts.Length > 0 ? nameParts[^1] : fullWindowsName;
    var roles = User.FindAll(ClaimTypes.Role)
        .Select(claim => claim.Value)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();
    var hasSuperAdminRole = roles.Contains("SuperAdmin", StringComparer.OrdinalIgnoreCase);
    var showSuperAdminMenu = hasSuperAdminRole;
    var divisionId = User.FindFirst("DivisionId")?.Value;
    var primaryRole = hasSuperAdminRole ? "SuperAdmin" : roles.FirstOrDefault() ?? "—";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iLearn Admin - @ViewData["Title"]</title>

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    @* <link href="~/css/admin-site.css" rel="stylesheet" /> *@
    <link href="~/css/admin-minimal.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/devextreme/filesaver.min.js" defer></script>
    <script src="~/js/devextreme/dx-exceljs-fork.min.js" defer></script>
    @await RenderSectionAsync("PreDxScripts", required: false)
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/src/devextreme-license.js"></script>
    <script src="~/js/site.js"></script>

    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" defer></script>
    @await RenderSectionAsync("ExternalDependencies", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-user-shield"></i> iLearn Admin
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="fas fa-chart-pie me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="courseDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-book me-1"></i> Course Management
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="courseDropdown">
                            @foreach (var item in courseMenuItems)
                            {
                                if (item.Divider)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    continue;
                                }

                                <li><a class="dropdown-item" asp-controller="@item.Controller" asp-action="Index">@item.Text</a></li>
                            }
                        </ul>
                    </li>
                    @if (showSuperAdminMenu)
                    {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-users me-1"></i> Admin
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                            @foreach (var item in adminMenuItems)
                            {
                                if (item.Divider)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    continue;
                                }

                                <li><a class="dropdown-item" asp-controller="@item.Controller" asp-action="Index">@item.Text</a></li>
                            }
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(currentController == "SystemConfig" ? "active" : "")"
                           asp-controller="SystemConfig" asp-action="Index">
                            <i class="fas fa-cog me-1"></i> System Config
                        </a>
                    </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link d-flex align-items-center gap-2 py-1 px-2 admin-profile-trigger"
                           href="#" id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 admin-profile-avatar">
                                <i class="fas fa-user admin-profile-avatar-icon"></i>
                            </div>
                            <div class="d-none d-md-flex flex-column lh-1 admin-profile-meta">
                                <span class="fw-semibold admin-profile-name">
                                    @displayName
                                </span>
                             
                            </div>
                            <i class="fas fa-chevron-down ms-1 admin-profile-chevron"></i>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end admin-profile-menu"
                            aria-labelledby="profileDropdown">

                            <li class="px-3 py-2 admin-profile-menu-header">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 admin-profile-avatar admin-profile-avatar-lg">
                                        <i class="fas fa-user-circle admin-profile-menu-avatar-icon"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-truncate admin-profile-menu-name">
                                            @displayName
                                        </div>
                                        <div class="text-muted text-truncate admin-profile-menu-identity">
                                            @fullWindowsName
                                        </div>
                                    </div>
                                </div>
                            </li>

                            <li class="px-3 pt-2 pb-1">
                                <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                    <i class="fas fa-shield-halved me-1"></i>Roles
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var role in roles)
                                    {
                                        if (role == "SuperAdmin")
                                        {
                                            <span class="badge rounded-pill admin-role-pill admin-role-pill-highlight">
                                                <i class="fas fa-star me-1"></i>@role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill admin-role-pill">
                                                @role
                                            </span>
                                        }
                                    }
                                    @if (!roles.Any())
                                    {
                                        <span class="text-muted admin-profile-empty-text">ไม่มี Role</span>
                                    }
                                </div>
                            </li>

                            @if (!string.IsNullOrEmpty(divisionId))
                            {
                                <li class="px-3 pb-2">
                                    <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                        <i class="fas fa-building me-1"></i>Division
                                    </div>
                                    <span class="badge rounded-pill admin-division-pill">
                                        <i class="fas fa-layer-group me-1"></i>ID: @divisionId
                                    </span>
                                </li>
                            }
                            else if (hasSuperAdminRole)
                            {
                                <li class="px-3 pb-2">
                                    <div class="text-uppercase text-muted mb-1 admin-profile-section-title">
                                        <i class="fas fa-building me-1"></i>Division
                                    </div>
                                    <span class="badge rounded-pill admin-division-pill admin-division-pill-global">
                                        <i class="fas fa-globe me-1"></i>ทุก Division
                                    </span>
                                </li>
                            }

                            <li><hr class="dropdown-divider my-1"></li>

                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2 py-2 admin-refresh-link"
                                   href="#" data-admin-refresh-user="true">
                                    <i class="fas fa-rotate-right text-muted admin-refresh-link-icon"></i>
                                    รีเฟรชข้อมูลผู้ใช้
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="w-100 pb-4">
        @RenderBody()
    </main>

    <footer class="footer text-center mt-auto py-3 bg-white border-top">
        <div class="container-fluid">
            <span class="text-muted small">&copy; @DateTime.Now.Year - iLearn Management System (Admin Console)</span>
        </div>
    </footer>

    <script>
        window.iLearnAdminConfig = {
            apiBaseUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Configuration["ApiSettings:BaseUrl"] ?? string.Empty))
        };
    </script>
    <script src="~/js/admin-layout.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>