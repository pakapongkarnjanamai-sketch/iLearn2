@{
    var pageTitle = ViewData["Title"] as string ?? "Report";
    var reportTitle = ViewData["ReportTitle"] as string ?? pageTitle;
    var reportIcon = ViewData["ReportIcon"] as string ?? "fa-file-alt";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle</title>
    <link rel="preload" href="~/lib/font-awesome/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin asp-append-version="true" />
    <link rel="preload" href="~/js/devextreme/dx.all.js" as="script" asp-append-version="true" />
    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />
    <style>
        @@font-face { font-family: "Font Awesome 7 Free"; font-display: swap; }
        @@font-face { font-family: "Font Awesome 7 Brands"; font-display: swap; }
        @@font-face { font-family: "Font Awesome 5 Free"; font-display: swap; }
        @@font-face { font-family: "Font Awesome 5 Brands"; font-display: swap; }
        @@font-face { font-family: "FontAwesome"; font-display: swap; }
    </style>
    <link href="~/css/admin-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/admin-minimal.css" rel="stylesheet" asp-append-version="true" />
    <style>
        body {
            font-family: var(--font-stack);
            background: var(--surface-base);
            color: var(--text-primary);
            font-size: var(--font-size-md);
            line-height: var(--text-body-line-height);
            font-kerning: normal;
            padding-top: 50px;
            height: auto;
            overflow: auto;
        }

        .toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 999;
            background: var(--surface-base);
            border-bottom: 1px solid var(--border-color);
            padding: var(--space-sm) var(--space-2xl);
        }

        .toolbar-btn {
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: var(--space-2xs) var(--space-lg);
            min-height: 2.5rem;
            font-size: var(--font-size-sm);
            font-weight: 500;
            line-height: 1.2;
            cursor: pointer;
            background: var(--surface-base);
            color: var(--text-secondary);
            transition: background-color 220ms cubic-bezier(0.22, 1, 0.36, 1),
                        color 220ms cubic-bezier(0.22, 1, 0.36, 1),
                        border-color 220ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .toolbar-btn:hover {
            background: var(--bg-light);
            color: var(--text-primary);
        }

        .toolbar-btn:focus-visible {
            outline: 2px solid color-mix(in srgb, var(--primary-color) 70%, var(--surface-base));
            outline-offset: 1px;
            border-color: color-mix(in srgb, var(--primary-color) 40%, var(--border-color));
            color: var(--primary-dark);
        }

        .toolbar-btn:active {
            background: color-mix(in srgb, var(--surface-brand-subtle) 52%, var(--surface-base));
            border-color: color-mix(in srgb, var(--primary-color) 36%, var(--border-color));
        }

        .toolbar-btn:disabled,
        .toolbar-btn[aria-disabled="true"] {
            opacity: 0.55;
            cursor: not-allowed;
            color: var(--text-muted);
            background: var(--surface-subtle);
        }

        .toolbar .fw-bold {
            font-size: var(--font-size-lg) !important;
            line-height: var(--text-subheading-line-height);
        }

        .table {
            font-size: var(--font-size-grid-cell);
            border-color: var(--border-color) !important;
            margin-bottom: 0;
            font-variant-numeric: tabular-nums;
            font-feature-settings: var(--font-feature-data);
        }

        .table th {
            background: var(--bg-light);
            font-weight: 600;
            color: var(--text-secondary);
            font-size: var(--font-size-grid-header);
            line-height: 1.45;
        }

        .table-hover tbody tr:hover {
            background-color: var(--bg-light);
        }

        .progress-slim {
            height: 4px;
            background: var(--border-color);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 4px;
        }

        .status-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .status-done {
            color: var(--success-color);
        }

        .status-done .status-dot {
            background: var(--success-color);
        }

        .status-active {
            color: var(--warning-color);
        }

        .status-active .status-dot {
            background: var(--warning-color);
        }

        .status-pending {
            color: var(--text-secondary);
        }

        .status-pending .status-dot {
            background: var(--border-strong);
        }

        @@media (max-width: 767.98px) {
            .toolbar-btn {
                min-height: 2.75rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .toolbar-btn {
                transition: none;
            }
        }

        @@media print {
            .toolbar {
                display: none !important;
            }

            body {
                padding-top: 0;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="toolbar d-flex align-items-center gap-2">
        <span class="fw-bold fs-6 flex-grow-1">
            <i class="fas @reportIcon me-2 text-muted"></i>@reportTitle
        </span>
        @RenderSection("ToolbarActions", required: false)
    </div>

    @RenderBody()

    <script src="~/js/devextreme/jquery.js" defer asp-append-version="true"></script>
    <script src="~/js/devextreme/dx.all.js" defer asp-append-version="true"></script>
    <script src="~/src/devextreme-license.js" defer asp-append-version="true"></script>
    <script src="~/js/admin-layout.js" defer asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>