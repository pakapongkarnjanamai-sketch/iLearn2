@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.Title = "Content Library";
    var isSuperAdmin = (await AuthorizationService.AuthorizeAsync(User, "SuperAdminOnly")).Succeeded;
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Content Library</h1>
        <div class="page-subtitle">Manage content items, SCORM packages, and course usage.</div>
    </div>
    <div class="d-flex gap-2">
   
            <button type="button" class="action-link" onclick="openOptimizePopup()">
                <i class="fas fa-magic text-secondary" aria-hidden="true"></i> Optimize
            </button>
    
        <button type="button" class="action-link primary" onclick="openUploadPopup()">
            <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i> Upload Content
        </button>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Content Items</div>
                <div class="kpi-number" id="kpi-total">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-success h-100">
                <div class="kpi-label">Published</div>
                <div class="kpi-number" id="kpi-published">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Draft</div>
                <div class="kpi-number" id="kpi-draft">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">DB Storage</div>
                <div class="kpi-number" id="kpi-dbsize">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Server Files</div>
                <div class="kpi-number" id="kpi-serverfiles">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-danger h-100">
                <div class="kpi-label">Server Storage</div>
                <div class="kpi-number" id="kpi-serversize">—</div>
            </div>
        </div>
    </div>

    <!-- ── Filter Bar ── -->
    <div class="panel">
        <div class="panel-header">
            <i class="fas fa-filter me-1"></i> Filters
        </div>
        <div class="panel-body p-2">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="filter-label">Content Type</label>
                    <div id="filterType"></div>
                </div>
                <div class="col-auto u-minw-280">
                    <label class="filter-label">Assigned Course</label>
                    <div id="filterCourse"></div>
                </div>
                <div class="col-auto">
                    <label class="filter-label">Assignment</label>
                    <div id="filterAssignment"></div>
                </div>
                <div class="col-auto ms-auto">
                    <button type="button" class="action-link action-link-sm" id="btnClearFilters">
                        <i class="fas fa-times"></i> Clear Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 flex-grow-1 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>

</div>


<div id="uploadPopup"></div>
<div id="optimizePopup"></div>
<div id="popupContent" style="display:none;">
    <div class="p-3">
        <div class="mb-3">
            <label class="filter-label">1. Select Content Type</label>
            <div id="uploadTypeSelect"></div>
        </div>
        <div>
            <label class="filter-label">2. Choose File (.zip)</label>
            <div id="fileUploader"></div>
        </div>
        <div class="admin-compat-note mt-3">
            <div class="admin-compat-note-title">SCORM Compatibility</div>
            <ul class="admin-compat-note-list">
                <li>Accepts SCORM 1.2 and SCORM 2004 ZIP packages only.</li>
                <li>Supports import, launch, runtime commit, and resume for SCORM 1.2 and SCORM 2004 content.</li>
                <li><code>imsmanifest.xml</code> may be at the ZIP root or inside a package folder.</li>
                <li>Resume depends on the package writing bookmark or suspend data and calling Commit or Terminate.</li>
                <li>Uses one launch SCO per content item; full SCORM 2004 sequencing and multi-SCO navigation are not orchestrated.</li>
                <li>Limits: 100 MB ZIP, 1,000 archive entries, 100 MB per file, 250 MB expanded.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const contentTypeIds = [{ id: 1, name: 'Learn' }, { id: 2, name: 'Exam' }];
        const assignmentOptions = [{ id: 'all', name: 'All' }, { id: 'unassigned', name: 'Unassigned' }, { id: 'assigned', name: 'Assigned' }];
        let selectedUploadTypeId = 1;
        let uploadPopupInstance;
        let gridInstance;
        let serverStatsMap = {};
        const summaryKpiIds = ['kpi-total', 'kpi-published', 'kpi-draft', 'kpi-dbsize', 'kpi-serverfiles', 'kpi-serversize'];
        const dashboardStatsCacheTtlMs = 30000;
        let dashboardStatsRequest = null;
        let dashboardStatsCache = null;
        let dashboardStatsCacheAt = 0;

        function renderServerStatCell(container, options, valueSelector, styleKey, formatter) {
            const stats = serverStatsMap[options.data.id];
            if (!options.data.isActive || !stats) {
                $("<span>").css(window.getAdminGridTextStyle("xsMutedFaint")).text("—").appendTo(container);
                return;
            }

            $("<span>")
                .css(window.getAdminGridTextStyle(styleKey))
                .text(formatter(valueSelector(stats)))
                .appendTo(container);
        }

        // Current filter state
        let filterCourseId = null;
        let filterTypeId = null;
        let filterAssignment = 'all';

        // lookup column — raw+cached
        const coursesLookupStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetForLookup` });
        const dsCoursesLookup = {
            store: coursesLookupStore,
            loadMode: 'raw',
            cacheRawData: true
        };

        function createContentItemsDataSource() {
            return createDataStore(serviceUrl, 'admin/ContentItemsCRUD', {
                key: 'id',
                loadUrl: buildLoadUrl()
            });
        }

        let processingDialogController = null;
        let batchPublishProgressDialogController = null;

        function showProcessingDialog(title, text) {
            closeProcessingDialog();

            processingDialogController = createAdminDialogController({
                title: title,
                width: 420,
                messageHtml: `
                    <div class="text-start dialog-body-sm">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas fa-spinner fa-spin" style="color:var(--primary-color);"></i>
                            <span class="u-fw-semibold">Processing</span>
                        </div>
                        <div class="u-text-secondary-60">${escapeAdminHtml(text)}</div>
                    </div>`
            });
        }

        function closeProcessingDialog() {
            if (processingDialogController) {
                processingDialogController.hide();
                processingDialogController = null;
            }

            if (batchPublishProgressDialogController) {
                batchPublishProgressDialogController.hide();
                batchPublishProgressDialogController = null;
            }
        }

        function formatElapsedTime(elapsed) {
            if (!elapsed) return '00:00';

            if (typeof elapsed === 'string') {
                const parts = elapsed.split(':');
                if (parts.length >= 3) {
                    return `${parts[1].padStart(2, '0')}:${parts[2].split('.')[0].padStart(2, '0')}`;
                }
                return elapsed;
            }

            return '00:00';
        }

        function showBatchPublishProgressDialog() {
            closeProcessingDialog();

            batchPublishProgressDialogController = createAdminDialogController({
                title: 'Publishing Content',
                width: 560,
                messageHtml: `
                    <div class="text-start dialog-body-sm">
                        <div class="mb-2 text-muted" id="batchPublishStatusText">Preparing batch...</div>
                        <div class="progress mb-2 u-progress-xs progress-track-neutral">
                            <div id="batchPublishProgressBar" class="progress-fill-brand" style="width:0%;"></div>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span id="batchPublishCounter">0 / 0</span>
                            <span id="batchPublishElapsed">00:00</span>
                        </div>
                        <div class="small text-muted mb-2">Latest activity</div>
                        <div id="batchPublishLatestLog" class="log-panel-soft">
                            <div class="text-muted">Waiting for progress...</div>
                        </div>
                    </div>`
            });
        }

        function normalizeBatchPublishProgress(progress) {
            if (!progress) return null;

            const latestResult = progress.latestResult || progress.LatestResult || null;

            return {
                currentItem: progress.currentItem ?? progress.CurrentItem ?? 0,
                totalItems: progress.totalItems ?? progress.TotalItems ?? 0,
                successCount: progress.successCount ?? progress.SuccessCount ?? 0,
                failureCount: progress.failureCount ?? progress.FailureCount ?? 0,
                currentContentItemName: progress.currentContentItemName ?? progress.CurrentContentItemName ?? null,
                currentStep: progress.currentStep ?? progress.CurrentStep ?? null,
                isComplete: progress.isComplete ?? progress.IsComplete ?? false,
                elapsedTime: progress.elapsedTime ?? progress.ElapsedTime ?? null,
                latestResult: latestResult ? {
                    success: latestResult.success ?? latestResult.Success ?? false,
                    contentItemName: latestResult.contentItemName ?? latestResult.ContentItemName ?? '',
                    errorMessage: latestResult.errorMessage ?? latestResult.ErrorMessage ?? '',
                    details: latestResult.details ?? latestResult.Details ?? ''
                } : null
            };
        }

        function updateBatchPublishProgress(progress) {
            progress = normalizeBatchPublishProgress(progress);
            if (!progress) return;

            const total = progress.totalItems || 0;
            const current = progress.currentItem || 0;
            const percent = total > 0 ? Math.min(100, Math.round((current / total) * 100)) : 0;
            const statusText = progress.currentContentItemName
                ? `${progress.currentStep || 'Processing'}: ${progress.currentContentItemName}`
                : (progress.currentStep || 'Processing...');

            $('#batchPublishStatusText').text(statusText);
            $('#batchPublishProgressBar').css('width', `${percent}%`);
            $('#batchPublishCounter').text(`${current} / ${total}`);
            $('#batchPublishElapsed').text(formatElapsedTime(progress.elapsedTime));

            if (progress.latestResult) {
                const latest = progress.latestResult;
                const icon = latest.success ? 'fa-circle-check' : 'fa-circle-xmark';
                const color = latest.success ? 'var(--color-success-600)' : 'var(--danger-color)';
                const detail = latest.errorMessage || latest.details || progress.currentStep || '';
                $('#batchPublishLatestLog').prepend(
                    `<div style="margin-bottom:6px; color:${color};">
                        <i class="fas ${icon} me-1"></i>
                        <strong>${latest.contentItemName || progress.currentContentItemName || 'Content item'}</strong>
                        <div class="log-item-detail">${detail}</div>
                    </div>`
                );
            }
        }

        async function runBatchPublishWithProgress(keys) {
            showBatchPublishProgressDialog();

            try {
                const response = await fetch(`${serviceUrl}/ContentItems/Admin/BatchPublishStream`, {
                    method: 'POST',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(keys)
                });

                if (!response.ok || !response.body) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let lastProgress = null;

                while (true) {
                    const result = await reader.read();
                    if (result.done) break;

                    buffer += decoder.decode(result.value, { stream: true });
                    const messages = buffer.split('\n\n');
                    buffer = messages.pop() || '';

                    messages.forEach(function(message) {
                        const line = message.split('\n').find(x => x.startsWith('data: '));
                        if (!line) return;

                        const payload = JSON.parse(line.substring(6));
                        const normalized = normalizeBatchPublishProgress(payload);
                        lastProgress = normalized;
                        updateBatchPublishProgress(normalized);
                    });
                }

                closeProcessingDialog();

                if (lastProgress) {
                    const type = lastProgress.failureCount > 0 ? 'warning' : 'success';
                    const message = `Published ${window.formatAdminCountLabel(lastProgress.successCount || 0, 'content item', 'content items')}. ${window.formatAdminCountLabel(lastProgress.failureCount || 0, 'failed item', 'failed items')}.`;
                    showToast(message, type, 3500);
                } else {
                    showToast('Batch publish completed.', 'success', 3000);
                }

                loadOptimizeData();
                refreshAll();
            } catch (error) {
                closeProcessingDialog();
                showToast(error.message || 'Batch publish failed.', 'error', 4000);
            }
        }

        function applySummaryStats(d) {
            $("#kpi-total").text(window.formatAdminInteger(d.totalCount, '0'));
            $("#kpi-published").text(window.formatAdminInteger(d.publishedCount, '0'));
            $("#kpi-draft").text(window.formatAdminInteger(d.draftCount, '0'));
            $("#kpi-dbsize").text(window.formatAdminFileSize(d.totalDbSize, '—'));
            $("#kpi-serverfiles").text(window.formatAdminInteger(d.totalServerFiles, '0'));
            $("#kpi-serversize").text(window.formatAdminFileSize(d.totalServerSize, '—'));
        }

        function applyDashboardStats(payload) {
            if (!payload) return;

            serverStatsMap = payload.serverStats || {};
            if (gridInstance) gridInstance.repaint();

            if (payload.summary) {
                applySummaryStats(payload.summary);
            }
        }

        function loadDashboardStats(options) {
            const settings = options || {};
            const force = settings.force === true;
            const now = Date.now();
            const canUseCache = !force && dashboardStatsCache && (now - dashboardStatsCacheAt) < dashboardStatsCacheTtlMs;

            if (canUseCache) {
                applyDashboardStats(dashboardStatsCache);
                return $.Deferred().resolve(dashboardStatsCache).promise();
            }

            if (dashboardStatsRequest) {
                return dashboardStatsRequest;
            }

            showStatSkeleton(summaryKpiIds);

            dashboardStatsRequest = $.ajax({
                url: `${serviceUrl}/admin/ContentItemsCRUD/GetDashboardStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(dashboard) {
                dashboardStatsCache = dashboard || {};
                dashboardStatsCacheAt = Date.now();
                applyDashboardStats(dashboardStatsCache);
            }).fail(function() {
                hideStatSkeleton(summaryKpiIds);
            }).always(function() {
                dashboardStatsRequest = null;
            });

            return dashboardStatsRequest;
        }

        function loadSummaryStats(options) {
            return loadDashboardStats(options);
        }

        function loadServerStats(options) {
            return loadDashboardStats(options);
        }

        function refreshAll() {
            loadDashboardStats({ force: true });
            if (gridInstance) gridInstance.refresh();
        }

        function viewContent(contentItemId, contentItemName) {
            const apiUrl = `${serviceUrl}/ContentItems/${contentItemId}/content`;
            if (contentItemName.toLowerCase().endsWith('.zip')) {
                const win = window.open('about:blank', '_blank');
                if (win) {
                    win.document.title = "Loading...";
                    win.document.body.innerHTML = "<div style='display:flex;justify-content:center;align-items:center;height:100vh;font-family:sans-serif;'>Processing content...</div>";
                }
                $.ajax({ url: apiUrl, method: "GET", xhrFields: { withCredentials: true } })
                    .done(res => { if (res?.url && win) win.location.href = res.url; else { if (win) win.close(); showToast("Content URL not found.", "error"); } })
                    .fail(() => { if (win) win.close(); showToast("Failed to get content link.", "error"); });
            } else {
                window.open(apiUrl, '_blank');
            }
        }

        function buildLoadUrl() {
            if (filterCourseId) {
                return `${serviceUrl}/admin/ContentItemsCRUD/GetByCourse?courseId=${filterCourseId}`;
            }
            return `${serviceUrl}/admin/ContentItemsCRUD/Get`;
        }

        function applyFilters() {
            // Build combined filter for type + assignment
            const filters = [];
            if (filterTypeId) filters.push(["typeId", "=", filterTypeId]);
            if (filterAssignment === 'unassigned') filters.push(["courseIdsCount", "=", 0]);
            if (filterAssignment === 'assigned') filters.push(["courseIdsCount", ">", 0]);

            gridInstance.option('dataSource', createContentItemsDataSource());

            if (filters.length > 1) {
                const combined = [filters[0]];
                for (let i = 1; i < filters.length; i++) {
                    combined.push("and", filters[i]);
                }
                gridInstance.filter(combined);
            } else if (filters.length === 1) {
                gridInstance.filter(filters[0]);
            } else {
                gridInstance.clearFilter();
            }
        }

        $(() => {
            // Load stats on page init
            loadDashboardStats();

            // ── Filter Bar Controls ──
            $("#filterType").dxSelectBox({
                dataSource: contentTypeIds,
                valueExpr: 'id',
                displayExpr: 'name',
                value: null,
                placeholder: 'All Types',
                showClearButton: true,
                width: 150,
                onValueChanged: (e) => { filterTypeId = e.value; applyFilters(); }
            });

            $("#filterCourse").dxSelectBox({
                dataSource: {
                    store: coursesLookupStore,
                    paginate: true,
                    pageSize: 20
                },
                valueExpr: 'id',
                displayExpr: 'code',
                value: null,
                placeholder: 'All Courses',
                showClearButton: true,
                searchEnabled: true,
                searchExpr: 'code',
                searchMode: 'contains',
                width: '100%',
                onValueChanged: (e) => { filterCourseId = e.value; applyFilters(); }
            });

            $("#filterAssignment").dxSelectBox({
                dataSource: assignmentOptions,
                valueExpr: 'id',
                displayExpr: 'name',
                value: 'all',
                width: 160,
                onValueChanged: (e) => { filterAssignment = e.value; applyFilters(); }
            });

            $("#btnClearFilters").on('click', function() {
                filterTypeId = null;
                filterCourseId = null;
                filterAssignment = 'all';
                $("#filterType").dxSelectBox("instance").option('value', null);
                $("#filterCourse").dxSelectBox("instance").option('value', null);
                $("#filterAssignment").dxSelectBox("instance").option('value', 'all');
                applyFilters();
            });

            // ── Popup Upload ──
            uploadPopupInstance = $("#uploadPopup").dxPopup({
                title: "Upload New Content",
                width: 500, height: 'auto',
                contentTemplate: function(contentElement) {
                    contentElement.append($("#popupContent").show());
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Upload", type: "success", onClick: () => { $("#fileUploader").dxFileUploader("instance").upload(); } }
                    },
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Cancel", onClick: () => uploadPopupInstance.hide() }
                    }
                ]
            }).dxPopup("instance");

            $("#uploadTypeSelect").dxSelectBox({
                dataSource: contentTypeIds, valueExpr: 'id', displayExpr: 'name', value: selectedUploadTypeId,
                onValueChanged: (e) => { selectedUploadTypeId = e.value; $("#fileUploader").dxFileUploader("instance").option("uploadUrl", getUploadUrl()); }
            });
            function getUploadUrl() { return `${serviceUrl}/ContentItems/upload?typeId=${selectedUploadTypeId}`; }

            $("#fileUploader").dxFileUploader({
                name: 'file', accept: '.zip', uploadMode: 'useButtons',
                uploadUrl: getUploadUrl(),
                onUploaded: () => {
                    showToast("File uploaded successfully", "success", 2000);
                    refreshAll();
                    uploadPopupInstance.hide();
                }
            });

            // ── DataGrid ──
            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search content...", {
                height: "100%",
                dataSource: createContentItemsDataSource(),
                remoteOperations: true,
                editing: {
                    mode: "popup", allowUpdating: true, allowDeleting: true, allowAdding: false, useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this content item?" },
                    popup: {
                        title: "Edit Content",
                        showTitle: true,
                        width: 480,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Content Details",
                                colCount: 1,
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Content File Name" },
                                        editorOptions: { placeholder: "Enter content name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "typeId",
                                        label: { text: "Content Type" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: contentTypeIds,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            placeholder: "Select type..."
                                        },
                                        validationRules: [{ type: "required", message: "Type is required" }]
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Content File Name", dataType: "string", minWidth: 200 },
                    { dataField: "typeId", caption: "Content Type", dataType: "number",
                        lookup: { dataSource: contentTypeIds, valueExpr: 'id', displayExpr: 'name' },
                        alignment: "center", width: 120,
                        cellTemplate: (container, options) => window.renderAdminGridStatusCell(
                            container,
                            options.displayValue || "—",
                            options.value === 1 ? "primary" : "warning",
                            { showDot: false }
                        )
                    },
                    { dataField: "fileLength", caption: "DB Size", dataType: "number", alignment: "center", width: 100,
                        allowEditing: false,
                        cssClass: "cell-caption",
                        customizeText: function(e) { return window.formatAdminFileSize(e.value, '—'); }
                    },
                    { caption: "Server Files", dataType: "number", alignment: "center", width: 100,
                        allowEditing: false, allowSorting: false, allowFiltering: false,
                        cellTemplate: (container, options) => renderServerStatCell(
                            container,
                            options,
                            stats => stats.fileCount,
                            "xsStrong",
                            value => window.formatAdminInteger(value, '0')
                        )
                    },
                    { caption: "Server Size", dataType: "number", alignment: "center", width: 110,
                        allowEditing: false, allowSorting: false, allowFiltering: false,
                        cellTemplate: (container, options) => renderServerStatCell(
                            container,
                            options,
                            stats => stats.totalSize,
                            "xsAccent",
                            value => window.formatAdminFileSize(value, '—')
                        )
                    },
                    { dataField: "courseIdsCount", caption: "Courses", dataType: "number", alignment: "center", width: 90,
                        allowEditing: false,
                        cellTemplate: (container, options) => {
                            const count = options.value || 0;
                            window.renderAdminGridTextCell(
                                container,
                                count === 0 ? "None" : window.formatAdminCountLabel(count, 'course'),
                                count === 0 ? "captionMuted" : "captionSuccess"
                            );
                        }
                    },
                    {
                        dataField: "courseIds", caption: "Assigned Courses", dataType: "object", allowSorting: false,
                        allowFiltering: false, allowEditing: false, minWidth: 200,
                        calculateCellValue: rowData => rowData.courseContentItems ? rowData.courseContentItems.map(cr => cr.courseId) : [],
                        lookup: {
                            dataSource: dsCoursesLookup,
                            displayExpr: 'code',
                            valueExpr: 'id'
                        }
                    },
                    { dataField: "isActive", caption: "Status", dataType: "boolean", alignment: "center", width: 100,
                        allowEditing: false,
                        cellTemplate: (container, options) => window.renderAdminGridStatusCell(
                            container,
                            options.value ? "Active" : "Draft",
                            options.value ? "success" : "default"
                        )
                    },
                    {
                        type: "buttons", caption: "Manage", width: 160, alignment: "center",
                        buttons: [
                            { hint: "Publish", icon: "upload", visible: e => !e.row.data.isActive, onClick: e => setContentItemPublic(e.row.data.id) },
                            { hint: "Preview", icon: "video", visible: e => e.row.data.isActive, onClick: e => viewContent(e.row.data.id, e.row.data.name) },
                            { hint: "Unpublish", icon: "download", cssClass: "dx-btn-unpublish",
                              visible: e => e.row.data.isActive && (e.row.data.courseIdsCount || 0) === 0,
                              onClick: e => unpublishContentItem(e.row.data.id, e.row.data.name) },
                            "edit",
                            { name: "delete", visible: e => !e.row.data.isActive }
                        ]
                    }
                ]
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });

            function setContentItemPublic(id) {
                showAdminConfirmDialog({
                    title: 'Publish Content?',
                    text: 'Extract and publish this SCORM package?',
                    icon: 'question',
                    confirmButtonText: 'Publish',
                    cancelButtonText: 'Cancel',
                    confirmType: 'default'
                }).done((confirmed) => {
                    if (confirmed) {
                        runBatchPublishWithProgress([id]);
                    }
                });
            }

            function unpublishContentItem(id, name) {
                const stats = serverStatsMap[id];
                const sizeText = stats ? window.formatAdminFileSize(stats.totalSize, '—') : '';
                const filesText = stats ? window.formatAdminCountLabel(stats.fileCount, 'file') : '';
                const detail = sizeText ? `This will delete ${filesText} (${sizeText}) from the server.` : 'This will delete extracted files from the server.';

                showAdminConfirmDialog({
                    title: 'Unpublish Content?',
                    messageHtml: `<div class="u-text-secondary-60 text-start">
                               <p><strong>${escapeAdminHtml(name)}</strong></p>
                               <p>${detail}</p>
                               <p class="dialog-body-sm u-text-secondary-60">The original .zip file in the database will be kept so you can re-publish later.</p>
                           </div>`,
                    icon: 'warning',
                    confirmButtonText: 'Unpublish',
                    cancelButtonText: 'Cancel',
                    confirmType: 'danger'
                }).done((confirmed) => {
                    if (confirmed) {
                        $.ajax({
                            url: `${serviceUrl}/ContentItems/Unpublish?key=${id}`,
                            type: 'POST',
                            xhrFields: { withCredentials: true }
                        }).done((res) => {
                                showToast(res.message || "Content unpublished.", "success", 2000);
                                refreshAll();
                            })
                            .fail((xhr) => {
                                showToast(xhr.responseJSON?.message || "Failed to unpublish content.", "error", 3000);
                            });
                    }
                });
            }
        });

        window.openUploadPopup = function() {
            uploadPopupInstance.show();
        };

        // ── Optimize Popup (SuperAdmin) ──
        let optimizePopupInstance;
        let unusedGridInstance;
        let shouldPublishGridInstance;

        window.openOptimizePopup = function() {
            if (!optimizePopupInstance) {
                optimizePopupInstance = $("#optimizePopup").dxPopup({
                    title: "Content Optimization",
                    showTitle: true,
                    width: "90%",
                    maxWidth: 1100,
                    height: "85vh",
                    position: { my: "center", at: "center", of: window },
                    dragEnabled: true,
                    hideOnOutsideClick: true,
                    showCloseButton: true,
                    onShown: loadOptimizeData,
                    contentTemplate: function(contentElement) {
                        contentElement.append($(`
                            <div class="p-3">
                                <div class="d-flex align-items-center gap-2 mb-3 p-3 border rounded optimize-banner">
                                    <i class="fas fa-magic optimize-banner-icon"></i>
                                    <div class="u-fs-12 u-text-secondary-60">
                                        Analyze content usage and optimize server storage. Unpublish unused content to free disk space, or publish draft content that is needed by active courses.
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mb-3">
                                    <button type="button" class="action-link" id="btnUnpublishAllPublished">
                                        <i class="fas fa-box-archive text-secondary"></i> Unpublish All Published
                                    </button>
                                </div>

                                <div class="d-flex gap-2 mb-3" id="opt-summary">
                                    <div class="border rounded p-2 px-3 flex-fill text-center optimize-summary-card-danger">
                                        <div class="optimize-summary-label u-text-danger">Unused Published</div>
                                        <div class="optimize-summary-value u-text-danger" id="opt-unused-count">—</div>
                                    </div>
                                    <div class="border rounded p-2 px-3 flex-fill text-center optimize-summary-card-success">
                                        <div class="optimize-summary-label u-text-success">Should Publish</div>
                                        <div class="optimize-summary-value u-text-success" id="opt-publish-count">—</div>
                                    </div>
                                    <div class="border rounded p-2 px-3 flex-fill text-center optimize-summary-card-accent">
                                        <div class="optimize-summary-label u-text-accent">Reclaimable Space</div>
                                        <div class="optimize-summary-value u-text-accent" id="opt-reclaim-size">—</div>
                                    </div>
                                </div>

                                <div class="mb-2 d-flex justify-content-between align-items-center">
                                    <div class="optimize-section-title u-text-danger">
                                        <i class="fas fa-box-archive me-1"></i> Unused Published Content
                                    </div>
                                    <button type="button" class="action-link action-link-sm" id="btnBulkUnpublish">
                                        <i class="fas fa-box-archive"></i> Unpublish Selected
                                    </button>
                                </div>
                                <div id="unusedGrid" class="mb-4"></div>

                                <div class="mb-2 d-flex justify-content-between align-items-center">
                                    <div class="optimize-section-title u-text-success">
                                        <i class="fas fa-upload me-1"></i> Draft Content Needed by Active Courses
                                    </div>
                                    <button type="button" class="action-link primary action-link-sm" id="btnBulkPublish">
                                        <i class="fas fa-upload"></i> Publish Selected
                                    </button>
                                </div>
                                <div id="shouldPublishGrid"></div>
                            </div>
                        `));
                    }
                }).dxPopup("instance");
            }
            optimizePopupInstance.show();
        };

        function loadOptimizeData() {
            $("#opt-unused-count, #opt-publish-count, #opt-reclaim-size").html('<span class="skeleton skeleton-line" style="width:30px;height:20px;display:inline-block;"></span>');

            $.ajax({
                url: `${serviceUrl}/ContentItems/Admin/OptimizeAnalysis`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                $("#opt-unused-count").text(d.summary.unusedCount);
                $("#opt-publish-count").text(d.summary.shouldPublishCount);
                $("#opt-reclaim-size").text(window.formatAdminFileSize(d.summary.totalReclaimableSize, '—'));

                // Unused Published Grid
                if (unusedGridInstance) {
                    unusedGridInstance.option("dataSource", d.unusedPublished);
                } else {
                    unusedGridInstance = initDxGrid("#unusedGrid", {
                        preset: "selectionGrid",
                        height: 350,
                        dataSource: d.unusedPublished,
                        keyExpr: "id",
                        columns: [
                            { dataField: "name", caption: "Content Name", minWidth: 180 },
                            { dataField: "typeId", caption: "Type", width: 80, alignment: "center",
                                calculateCellValue: r => r.typeId === 1 ? "Learn" : "Exam" },
                            { dataField: "fileLength", caption: "DB Size", width: 90, alignment: "center",
                                calculateCellValue: r => window.formatAdminFileSize(r.fileLength, '—') },
                            { dataField: "serverFileCount", caption: "Files", width: 70, alignment: "center" },
                            { dataField: "serverSize", caption: "Server Size", width: 100, alignment: "center",
                                cellTemplate: (container, options) => {
                                    $("<span>").css({ fontWeight: "600", color: "var(--danger-color)" })
                                        .text(window.formatAdminFileSize(options.value, '—')).appendTo(container);
                                }
                            },
                            { dataField: "totalCourseCount", caption: "Courses", width: 80, alignment: "center",
                                cellTemplate: (container, options) => {
                                    const count = options.value || 0;
                                    window.renderAdminGridTextCell(
                                        container,
                                        count === 0 ? "None" : window.formatAdminCountLabel(count, 'inactive course'),
                                        count === 0 ? "captionMuted" : "captionStrong"
                                    );
                                }
                            }
                        ],
                        noDataText: getNoDataText("unusedPublishedContentItems"),
                        summary: {
                            totalItems: [
                                { column: "serverSize", summaryType: "sum", customizeText: e => window.formatAdminFileSize(e.value, '—') }
                            ]
                        }
                    });
                }

                // Should Publish Grid
                if (shouldPublishGridInstance) {
                    shouldPublishGridInstance.option("dataSource", d.shouldPublish);
                } else {
                    shouldPublishGridInstance = initDxGrid("#shouldPublishGrid", {
                        preset: "selectionGrid",
                        height: 350,
                        dataSource: d.shouldPublish,
                        keyExpr: "id",
                        columns: [
                            { dataField: "name", caption: "Content Name", minWidth: 180 },
                            { dataField: "typeId", caption: "Type", width: 80, alignment: "center",
                                calculateCellValue: r => r.typeId === 1 ? "Learn" : "Exam" },
                            { dataField: "fileLength", caption: "DB Size", width: 90, alignment: "center",
                                calculateCellValue: r => window.formatAdminFileSize(r.fileLength, '—') },
                            { caption: "Active Courses", minWidth: 200,
                                cellTemplate: (container, options) => {
                                    const courses = options.data.activeCourseVersions || [];
                                    courses.forEach(courseVersion => {
                                        window.renderAdminGridTextCell(container, `${courseVersion.courseCode} v${courseVersion.versionNumber}`, "xsStrong", {
                                            color: "var(--success-color)",
                                            marginRight: "8px"
                                        });
                                    });
                                }
                            }
                        ],
                        noDataText: getNoDataText("draftContentItemsNeeded")
                    });
                }

                // Wire bulk actions
                $("#btnBulkUnpublish").off("click").on("click", function() {
                    const keys = unusedGridInstance.getSelectedRowKeys();
                    if (keys.length === 0) { showToast("Select content items to unpublish.", "warning"); return; }
                    showAdminConfirmDialog({
                        title: `Unpublish ${window.formatAdminCountLabel(keys.length, 'content item', 'content items')}?`,
                        messageHtml: `<div class="u-text-secondary-60">This will delete extracted files from the server for <strong>${window.formatAdminCountLabel(keys.length, 'content item', 'content items')}</strong>.<br>Original .zip files in the database will be kept.</div>`,
                        icon: 'warning',
                        confirmButtonText: `Unpublish ${window.formatAdminInteger(keys.length, '0')}`,
                        cancelButtonText: 'Cancel',
                        confirmType: 'danger'
                    }).done(confirmed => {
                        if (confirmed) {
                            setButtonLoading("#btnBulkUnpublish", true, "Processing...");
                            showProcessingDialog('Unpublishing Content', 'Removing published files from the server. Please wait.');
                            $.ajax({
                                url: `${serviceUrl}/ContentItems/Admin/BatchUnpublish`,
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify(keys),
                                xhrFields: { withCredentials: true }
                            }).done(res => {
                                showToast(res.message, "success");
                                loadOptimizeData();
                                refreshAll();
                            }).fail(xhr => {
                                showToast(xhr.responseJSON?.message || "Batch unpublish failed.", "error");
                            }).always(() => {
                                closeProcessingDialog();
                                setButtonLoading("#btnBulkUnpublish", false);
                            });
                        }
                    });
                });

                $("#btnBulkPublish").off("click").on("click", function() {
                    const keys = shouldPublishGridInstance.getSelectedRowKeys();
                    if (keys.length === 0) { showToast("Select content items to publish.", "warning"); return; }
                    showAdminConfirmDialog({
                        title: `Publish ${window.formatAdminCountLabel(keys.length, 'content item', 'content items')}?`,
                        messageHtml: `<div class="u-text-secondary-60">This will extract and publish <strong>${window.formatAdminCountLabel(keys.length, 'SCORM package')}</strong> to the server.</div>`,
                        icon: 'question',
                        confirmButtonText: `Publish ${window.formatAdminInteger(keys.length, '0')}`,
                        cancelButtonText: 'Cancel',
                        confirmType: 'default'
                    }).done(confirmed => {
                        if (confirmed) {
                            setButtonLoading("#btnBulkPublish", true, "Processing...");
                            runBatchPublishWithProgress(keys)
                                .finally(() => setButtonLoading("#btnBulkPublish", false));
                        }
                    });
                });

                $("#btnUnpublishAllPublished").off("click").on("click", function() {
                    showAdminConfirmDialog({
                        title: 'Unpublish all published content?',
                        messageHtml: `<div class="u-text-secondary-60 text-start">
                                   <p>This will remove all published SCORM folders/files from the server.</p>
                                   <p>All affected content records will be reverted to draft status.</p>
                                   <p class="u-text-danger dialog-body-sm">This action impacts every published content item.</p>
                               </div>`,
                        icon: 'warning',
                        confirmButtonText: 'Unpublish All',
                        cancelButtonText: 'Cancel',
                        confirmType: 'danger'
                    }).done(function(confirmed) {
                        if (!confirmed) return;

                        setButtonLoading("#btnUnpublishAllPublished", true, "Processing...");
                        showProcessingDialog('Unpublishing All Content', 'Removing all published files and reverting content to draft.');

                        $.ajax({
                            url: `${serviceUrl}/ContentItems/Admin/BulkDeletePublished?confirmDelete=true`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true }
                        }).done(function(res) {
                            showToast(res.summary || 'All published content was unpublished.', 'success', 3500);
                            loadOptimizeData();
                            refreshAll();
                        }).fail(function(xhr) {
                            showToast(xhr.responseJSON?.message || 'Failed to unpublish all published content.', 'error', 4000);
                        }).always(function() {
                            closeProcessingDialog();
                            setButtonLoading("#btnUnpublishAllPublished", false);
                        });
                    });
                });

            }).fail(function() {
                showToast("Failed to load optimization data.", "error");
            });
        }
    </script>
}