@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_ReportLayout";
    ViewData["Title"] = "Student Report";
    ViewData["ReportTitle"] = "Student Report";
    ViewData["ReportIcon"] = "fa-file-alt";
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "";
    var studentCode = ViewBag.StudentCode as string ?? "";
}

@section Styles {
    <style>
        #report-content {
            max-width: 1440px;
            margin: 0 auto;
            padding-left: clamp(12px, 2vw, 24px);
            padding-right: clamp(12px, 2vw, 24px);
        }

        .report-top-grid {
            display: grid;
            grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
            gap: clamp(16px, 2.2vw, 28px);
            margin-bottom: clamp(28px, 4vw, 44px);
        }

        .report-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .section-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            border-bottom: 1px solid color-mix(in srgb, var(--brand-color) 18%, var(--border-color));
            padding-bottom: 8px;
        }

        .section-title {
            font-size: var(--text-subheading-size);
            font-weight: 700;
            color: var(--brand-dark);
            line-height: var(--text-subheading-line-height);
            letter-spacing: 0.01em;
            margin: 0;
        }

        .profile-card,
        .summary-card,
        .history-card {
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            background: var(--surface-base);
        }

        .profile-card {
            background: color-mix(in srgb, var(--surface-brand-subtle) 36%, var(--surface-base));
            border-color: color-mix(in srgb, var(--brand-color) 20%, var(--border-color));
        }

        .summary-card {
            background: linear-gradient(
                180deg,
                color-mix(in srgb, var(--surface-info-subtle) 72%, var(--surface-base)) 0%,
                var(--surface-base) 100%
            );
            border-color: color-mix(in srgb, var(--brand-color) 14%, var(--border-color));
        }

        .history-card {
            background: color-mix(in srgb, var(--surface-subtle) 70%, var(--surface-base));
        }

        .profile-card,
        .summary-card {
            padding: clamp(14px, 1.8vw, 22px);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 12px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 16px;
            margin-bottom: 16px;
        }

        .stat-block {
            background: var(--surface-base);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 10px 8px;
        }

        .stat-block--total {
            border-color: color-mix(in srgb, var(--brand-color) 22%, var(--border-color));
            background: color-mix(in srgb, var(--surface-brand-subtle) 40%, var(--surface-base));
        }

        .stat-block--completed {
            border-color: var(--border-success);
            background: var(--surface-success-subtle);
        }

        .stat-block--inprogress {
            border-color: var(--border-warning);
            background: var(--surface-warning-subtle);
        }

        .stat-block--overdue {
            border-color: var(--border-danger);
            background: var(--surface-danger-subtle);
        }

        .stat-block--cancelled {
            border-color: var(--border-strong);
            background: var(--surface-subtle);
        }

        .stat-block--total .stat-num { color: var(--brand-dark); }
        .stat-block--completed .stat-num { color: var(--success-color); }
        .stat-block--inprogress .stat-num { color: var(--warning-color); }
        .stat-block--overdue .stat-num { color: var(--danger-color); }
        .stat-block--cancelled .stat-num { color: var(--text-secondary); }

        .history-card {
            overflow: auto;
        }

        .history-table {
            min-width: 930px;
        }

        .profile-name {
            font-size: var(--text-heading-size);
            font-weight: 700;
            line-height: var(--text-heading-line-height);
            color: var(--text-primary);
            max-width: 26ch;
        }

        .profile-avatar {
            width: 64px;
            height: 64px;
            background: var(--surface-brand-subtle);
            color: var(--accent-color);
            border-radius: 50%;
            font-size: 24px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 2px solid var(--surface-base);
            outline: 1px solid var(--border-color);
        }

        .info-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 0;
            font-size: var(--text-secondary-size);
            line-height: var(--text-secondary-line-height);
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .info-row:last-child { border-bottom: none; }
        .info-row i { width: 16px; text-align: center; color: var(--brand-mid); opacity: 0.9; }
        .info-row .info-label { min-width: 70px; font-weight: 500; }
        .info-row .info-value { font-weight: 600; color: var(--text-primary); }
        .status-overdue { color: var(--danger-color); }
        .status-overdue .status-dot { background: var(--danger-color); }
        .status-cancelled { color: var(--text-secondary); opacity: 0.6; }
        .status-cancelled .status-dot { background: var(--border-strong); }
        .stat-block { text-align: center; }
        .stat-block .stat-num { font-size: 1.5rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; font-feature-settings: var(--font-feature-data); }
        .stat-block .stat-label { font-size: var(--text-caption-size); line-height: var(--text-caption-line-height); color: var(--text-secondary); margin-top: 2px; letter-spacing: 0.02em; text-transform: uppercase; }

        @@media (max-width: 991.98px) {
            .report-top-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .section-head {
                flex-wrap: wrap;
            }

            .history-table {
                min-width: 860px;
            }
        }
    </style>
}

@section ToolbarActions {
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.print()">
            <i class="fas fa-print"></i> Print
        </button>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="exportToExcel()">
            <i class="fas fa-file-excel"></i> Export
        </button>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.close()">
            <i class="fas fa-times"></i> Close
        </button>
}

    <!-- ── Content ── -->
    <div id="report-content" class="container-fluid py-4">
        <div class="d-flex flex-column justify-content-center align-items-center text-muted u-minh-70vh">
            <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
            <span class="fs-6">Loading profile...</span>
        </div>
    </div>

@section Scripts {
    <script>
        const STUDENT_CODE = '@studentCode';
        const serviceUrl = "@apiBaseUrl";
        let _profileData = null;

        // ─── Helpers ───
        function fmtDate(v)     { return window.formatAdminDate ? window.formatAdminDate(v, "—") : (v || "—"); }
        function fmtDuration(s) { return window.formatAdminDuration ? window.formatAdminDuration(s, "—") : (s || "—"); }
        function fmtPct(v)      { return window.formatAdminPercentage ? window.formatAdminPercentage(v, "0%") : (v + "%"); }
        function esc(s)         { return window.escapeAdminHtml ? window.escapeAdminHtml(s) : $("<span>").text(s).html(); }

        function getStatus(e) {
            const now = new Date();
            if (e.isAssignmentCancelled) return { cls: "status-cancelled", label: "Cancelled", icon: "fa-ban" };
            if (e.isCompleted)           return { cls: "status-done",      label: "Completed", icon: "fa-check-circle" };
            if (!e.isCompleted && e.dueDate && new Date(e.dueDate) < now)
                                         return { cls: "status-overdue",   label: "Overdue",   icon: "fa-exclamation-circle" };
            if (e.progress > 0)          return { cls: "status-active",    label: "In Progress", icon: "fa-spinner" };
            return                                { cls: "status-pending",   label: "Not Started", icon: "fa-circle" };
        }

        // ─── Load Profile ───
        async function loadProfile() {
            try {
                const res = await fetch(
                    `${serviceUrl}/Students/profile/${encodeURIComponent(STUDENT_CODE)}`,
                    { credentials: "include" }
                );
                const json = await res.json();
                if (!json.success || !json.data) {
                    document.getElementById("report-content").innerHTML =
                        '<div class="text-danger text-center py-5">Failed to load profile data.</div>';
                    return;
                }
                _profileData = json.data;
                renderProfile(json.data);
            } catch {
                document.getElementById("report-content").innerHTML =
                    '<div class="text-danger text-center py-5">Network error.</div>';
            }
        }

        loadProfile();

        // ─── Render ───
        function renderProfile(d) {
            const k = d.kpi;
            const enrollments = d.enrollments || [];
            const now = new Date();

            // Compute audit stats
            const overdue    = enrollments.filter(e => !e.isCompleted && !e.isAssignmentCancelled && e.dueDate && new Date(e.dueDate) < now).length;
            const notStarted = enrollments.filter(e => !e.isCompleted && !e.isAssignmentCancelled && e.progress === 0).length;
            const cancelled  = enrollments.filter(e => e.isAssignmentCancelled).length;
            const completionPct = k.totalCourses > 0 ? Math.round((k.completedCourses / k.totalCourses) * 100) : 0;

            // Build initial
            const initial = (d.name || d.code || "?").charAt(0).toUpperCase();

            // Info rows
            const infoItems = [
                { icon: "fa-id-badge",    label: "Code",       value: d.code },
                { icon: "fa-building",    label: "Division",   value: d.division },
                { icon: "fa-layer-group", label: "Dept.",      value: d.department },
                { icon: "fa-sitemap",     label: "Section",    value: d.section },
                { icon: "fa-user-tag",    label: "Position",   value: d.position },
                { icon: "fa-clock",       label: "Total Time", value: fmtDuration(k.totalTimeSpentSeconds) }
            ].filter(r => r.value).map(r =>
                `<div class="info-row">
                    <i class="fas ${r.icon}"></i>
                    <span class="info-label">${r.label}</span>
                    <span class="info-value">${esc(String(r.value))}</span>
                </div>`
            ).join("");

            // Enrollment rows
            const historyRows = enrollments.map(e => {
                const st = getStatus(e);
                const pct = e.progress || 0;
                const barColor = pct === 100 ? "var(--success-color)" : pct > 0 ? "var(--accent-color)" : "var(--border-color)";
                const titleStyle = e.isCourseDeleted ? "color:var(--text-secondary); text-decoration:line-through;" : "";
                const deletedIcon = e.isCourseDeleted ? ' <i class="fas fa-archive u-fs-10 text-secondary" title="Course deleted"></i>' : "";
                const dueDateStyle = (!e.isCompleted && e.dueDate && new Date(e.dueDate) < now)
                    ? "color:var(--danger-color); font-weight:600;" : "";

                return `<tr>
                    <td class="fw-bold align-middle">${esc(e.courseCode || "—")}</td>
                    <td class="align-middle" style="${titleStyle}">${esc(e.courseTitle || "—")}${deletedIcon}</td>
                    <td class="align-middle text-center">
                        <span class="${st.cls}"><span class="status-dot"></span>${st.label}</span>
                    </td>
                    <td class="align-middle u-minw-120">
                        <div class="d-flex justify-content-between u-fs-11">
                            <span class="text-muted">Progress</span>
                            <span class="fw-bold">${fmtPct(pct)}</span>
                        </div>
                        <div class="progress-slim">
                            <div style="height:100%; width:${pct}%; background:${barColor};"></div>
                        </div>
                    </td>
                    <td class="align-middle text-center">${e.totalScore > 0 ? '<span class="fw-bold" style="color:var(--accent-color)">' + e.totalScore + '</span>' : '<span class="text-muted">—</span>'}</td>
                    <td class="align-middle text-center u-fs-11 text-secondary">${fmtDuration(e.totalTimeSpent)}</td>
                    <td class="align-middle text-center u-fs-11 text-secondary">${fmtDate(e.startDate)}</td>
                    <td class="align-middle text-center u-fs-11" style="${dueDateStyle}">${fmtDate(e.dueDate)}</td>
                    <td class="align-middle text-center u-fs-11" style="color:var(--success-color);">${fmtDate(e.completedDate)}</td>
                </tr>`;
            }).join("");

            // Inject layout
            document.getElementById("report-content").innerHTML = `
                <div class="report-top-grid">

                    <section class="report-section">
                        <div class="section-head">
                            <h2 class="section-title">Student Information</h2>
                            <button class="btn btn-outline-primary btn-sm py-1 px-2 u-fs-11" onclick="exportProfileImage()">
                                <i class="fas fa-download"></i> Save Image
                            </button>
                        </div>

                        <div id="export-target" class="profile-card">
                            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                <div class="profile-avatar">${initial}</div>
                                <div>
                                    <div class="profile-name">${esc(d.name || d.code)}</div>
                                    <div class="text-muted u-fs-12">
                                        ${[d.division, d.department, d.section].filter(Boolean).map(v => esc(v)).join(" · ") || "—"}
                                    </div>
                                </div>
                            </div>
                            ${infoItems}
                        </div>
                    </section>

                    <section class="report-section">
                        <div class="section-head">
                            <h2 class="section-title">Completion Summary</h2>
                        </div>

                        <div class="summary-card">
                            <div class="stats-grid text-center">
                                <div class="stat-block stat-block--total">
                                    <div class="stat-num">${k.totalCourses}</div>
                                    <div class="stat-label">Total</div>
                                </div>
                                <div class="stat-block stat-block--completed">
                                    <div class="stat-num">${k.completedCourses}</div>
                                    <div class="stat-label">Completed</div>
                                </div>
                                <div class="stat-block stat-block--inprogress">
                                    <div class="stat-num">${k.inProgressCourses}</div>
                                    <div class="stat-label">In Progress</div>
                                </div>
                                <div class="stat-block">
                                    <div class="stat-num">${notStarted}</div>
                                    <div class="stat-label">Not Started</div>
                                </div>
                                <div class="stat-block stat-block--overdue">
                                    <div class="stat-num">${overdue}</div>
                                    <div class="stat-label">Overdue</div>
                                </div>
                                ${cancelled > 0 ? `<div class="stat-block stat-block--cancelled">
                                    <div class="stat-num">${cancelled}</div>
                                    <div class="stat-label">Cancelled</div>
                                </div>` : ""}
                            </div>

                            <div id="profile-pie-chart" style="height:220px;"></div>
                        </div>
                    </section>
                </div>

                <section class="report-section mb-5">
                    <div class="section-head">
                        <h2 class="section-title">Learning History</h2>
                        <button class="btn btn-outline-primary btn-sm py-1 px-2 u-fs-11" onclick="exportToExcel()">
                            <i class="fas fa-file-excel"></i> Export
                        </button>
                    </div>

                    <div class="history-card">
                        <table class="table table-hover m-0 history-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Course</th>
                                    <th class="text-center">Status</th>
                                    <th>Progress</th>
                                    <th class="text-center">Score</th>
                                    <th class="text-center">Time</th>
                                    <th class="text-center">Start</th>
                                    <th class="text-center">Due</th>
                                    <th class="text-center">Completed</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${historyRows || '<tr><td colspan="9" class="text-center text-muted py-4">No enrollment data.</td></tr>'}
                            </tbody>
                        </table>
                    </div>
                </section>
            `;

            // Render Pie Chart
            $("#profile-pie-chart").dxPieChart(
                window.createAdminPieChartConfig({
                    palettePreset: "status4",
                    centerLabel: 'Completion',
                    centerValue: completionPct + '%',
                    baseConfig: {
                        type: "doughnut",
                        innerRadius: 0.65,
                        dataSource: [
                            { status: "Completed",   count: k.completedCourses },
                            { status: "In Progress", count: k.inProgressCourses },
                            { status: "Not Started", count: notStarted - overdue },
                            { status: "Overdue",     count: overdue }
                        ].filter(i => i.count > 0),
                        series: [{
                            argumentField: "status", valueField: "count",
                            label: {
                                visible: true,
                                position: "outside",
                                customizeText: p => `${p.valueText} (${p.percentText})`,
                                font: { size: 11, color: "var(--text-secondary)" },
                                connector: { visible: true, width: 1 }
                            }
                        }],
                        legend: {
                            horizontalAlignment: "right", verticalAlignment: "center",
                            margin: 0, font: { size: 12, color: "var(--text-secondary)" }
                        },
                        tooltip: { enabled: true }
                    }
                })
            );
        }

        // ─── Excel Export ───
        function getExportFileName(prefix) {
            const code = (_profileData?.code || 'Unknown').replace(/[\\/:*?"<>|]/g, '_');
            const now = new Date();
            const ts = [
                now.getFullYear(),
                String(now.getMonth() + 1).padStart(2, '0'),
                String(now.getDate()).padStart(2, '0'),
                String(now.getHours()).padStart(2, '0'),
                String(now.getMinutes()).padStart(2, '0')
            ].join('');
            return `${prefix}_${code}_${ts}.xlsx`;
        }

        function saveWorkbook(workbook, fileName) {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
            });
        }

        function styleHeaderRow(ws) {
            const row = ws.getRow(1);
            row.font = { bold: true, size: 11 };
            row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF5F5F5' } };
            row.alignment = { vertical: 'middle' };
            row.eachCell(cell => cell.border = { bottom: { style: 'thin', color: { argb: 'FFD9D9D9' } } });
        }

        async function exportToExcel() {
            if (!_profileData) return;
            await window.ensureExportDependencies();
            const d = _profileData;
            const wb = new ExcelJS.Workbook();
            const now = new Date();

            // Sheet 1: Summary
            const ws1 = wb.addWorksheet('Summary');
            ws1.columns = [
                { header: 'Field', key: 'field', width: 18 },
                { header: 'Value', key: 'value', width: 40 }
            ];
            ws1.addRow({ field: 'Employee Code', value: d.code });
            ws1.addRow({ field: 'Name', value: d.name });
            ws1.addRow({ field: 'Division', value: d.division || '' });
            ws1.addRow({ field: 'Department', value: d.department || '' });
            ws1.addRow({ field: 'Section', value: d.section || '' });
            ws1.addRow({ field: 'Position', value: d.position || '' });
            ws1.addRow({ field: 'Total Courses', value: d.kpi.totalCourses });
            ws1.addRow({ field: 'Completed', value: d.kpi.completedCourses });
            ws1.addRow({ field: 'In Progress', value: d.kpi.inProgressCourses });
            const overdueCount = (d.enrollments || []).filter(e => !e.isCompleted && !e.isAssignmentCancelled && e.dueDate && new Date(e.dueDate) < now).length;
            ws1.addRow({ field: 'Overdue', value: overdueCount });
            ws1.addRow({ field: 'Completion %', value: d.kpi.totalCourses > 0 ? Math.round((d.kpi.completedCourses / d.kpi.totalCourses) * 100) : 0 });
            styleHeaderRow(ws1);

            // Sheet 2: Learning History
            const ws2 = wb.addWorksheet('Learning History');
            ws2.columns = [
                { header: 'Course Code',  key: 'code',      width: 20 },
                { header: 'Course Title', key: 'title',     width: 45 },
                { header: 'Status',       key: 'status',    width: 14 },
                { header: 'Progress %',   key: 'progress',  width: 12 },
                { header: 'Score',        key: 'score',     width: 10 },
                { header: 'Time (sec)',   key: 'time',      width: 12 },
                { header: 'Start Date',   key: 'start',     width: 14 },
                { header: 'Due Date',     key: 'due',       width: 14 },
                { header: 'Completed On', key: 'completed', width: 14 }
            ];
            (d.enrollments || []).forEach(function (e) {
                const st = getStatus(e);
                ws2.addRow({
                    code: e.courseCode,
                    title: e.courseTitle,
                    status: st.label,
                    progress: e.progress || 0,
                    score: e.totalScore || 0,
                    time: e.totalTimeSpent || 0,
                    start: e.startDate ? fmtDate(e.startDate) : '',
                    due: e.dueDate ? fmtDate(e.dueDate) : '',
                    completed: e.completedDate ? fmtDate(e.completedDate) : ''
                });
            });
            styleHeaderRow(ws2);

            saveWorkbook(wb, getExportFileName('Student_Profile'));
        }

        // ─── Export Summary Image ───
        async function exportProfileImage() {
            const target = document.getElementById("export-target");
            try {
                const html2canvasLib = await window.ensureHtml2Canvas();
                const canvas = await html2canvasLib(target, { scale: 2, backgroundColor: window.getAdminExportBackgroundColor(), logging: false });
                const link = document.createElement("a");
                link.download = `Student_Profile_${STUDENT_CODE}.png`;
                link.href = canvas.toDataURL("image/png");
                link.click();
            } catch {
                alert("Could not save the image.");
            }
        }
    </script>
}
