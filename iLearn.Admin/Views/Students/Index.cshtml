@{
    ViewBag.Title = "Learners (Employees)";
    var studentReportUrlTemplate = Url.Content("~/Students/Report/__STUDENT_CODE__");
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Learners (Employees)</h1>
        <div class="page-subtitle">View and manage learner/employee information.</div>
    </div>
    <button type="button" class="action-link" onclick="refreshGrid()">
        <i class="fas fa-sync-alt" aria-hidden="true"></i> Refresh
    </button>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>


@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search learners by name, ID, or division...", {
                dataSource: createDataStore(serviceUrl, 'Students', { key: 'EId' }),
                remoteOperations: true,
                export: { enabled: true, allowExportSelectedData: true },
                onExporting: (e) => handleExporting(e, 'Learners_Employees'),
                editing: { allowUpdating: false, allowDeleting: false, allowAdding: false },
                columns: [
                    { dataField: "EId", caption: "Employee ID", width: 160, alignment: "center", fixed: true,
                        cellTemplate: (c, o) => {
                            $("<a>").attr("href", `@studentReportUrlTemplate`.replace("__STUDENT_CODE__", encodeURIComponent(o.value || "")))
                                   .attr("target", "_blank")
                                   .css(window.getAdminGridTextStyle("captionStrong"))
                                   .text(o.value || "—").appendTo(c);
                        }
                    },
                    { dataField: "EnglishFirstName", caption: "First Name", width: 250 },
                    { dataField: "EnglishLastName", caption: "Last Name", width: 250 },
                    { dataField: "Position", caption: "Position", width: 150 },
                    { dataField: "Division", caption: "Division", width: 120, alignment: "center" },
                    { dataField: "Department", caption: "Department", width: 120, alignment: "center" },
                    { dataField: "Section", caption: "Section" }
                ]
            }));
        });

        function refreshGrid() {
            if(gridInstance) gridInstance.refresh();
        }
    </script>
}