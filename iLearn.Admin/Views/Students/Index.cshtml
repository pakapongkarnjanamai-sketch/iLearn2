@{
    ViewBag.Title = "Students (Employees)";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Students (Employees)</div>
        <div class="text-secondary" style="font-size:12px;">View and manage student/employee information.</div>
    </div>
    <a href="javascript:void(0);" class="action-link" onclick="refreshGrid()">
        <i class="fas fa-sync-alt"></i> Refresh
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'Students', { key: 'EId' }),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search students by Name, ID, or Division..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                editing: { allowUpdating: false, allowDeleting: false, allowAdding: false },
                columns: [
                    { dataField: "EId", caption: "Employee ID", width: 160, alignment: "center", fixed: true },
                    { dataField: "EnglishFirstName", caption: "First Name", width: 250 },
                    { dataField: "EnglishLastName", caption: "Last Name", width: 250 },
                    { dataField: "Position", caption: "Position", width: 150 },
                    { dataField: "Division", caption: "Division", width: 120, alignment: "center" },
                    { dataField: "Department", caption: "Department", width: 120, alignment: "center" },
                    { dataField: "Section", caption: "Section" }
                ]
            });
        });

        function refreshGrid() {
            if(gridInstance) gridInstance.refresh();
        }
    </script>
}