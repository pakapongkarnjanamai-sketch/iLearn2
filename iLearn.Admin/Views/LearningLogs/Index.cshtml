@{
    ViewBag.Title = "Learning Logs";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Learning Logs</h1>
        <div class="page-subtitle">Monitor detailed SCORM learning history, progress, and scores.</div>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Logs</div>
                <div class="kpi-number" id="kpi-total">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-success h-100">
                <div class="kpi-label">Completed / Passed</div>
                <div class="kpi-number" id="kpi-completed">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">In Progress</div>
                <div class="kpi-number" id="kpi-inprogress">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-danger h-100">
                <div class="kpi-label">Failed</div>
                <div class="kpi-number" id="kpi-failed">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Avg. Score</div>
                <div class="kpi-number" id="kpi-avgscore">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">Total Time</div>
                <div class="kpi-number" id="kpi-totaltime">—</div>
            </div>
        </div>
    </div>

    <!-- ── Filter Bar ── -->
    <div class="panel">
        <div class="panel-header">
            <i class="fas fa-filter me-1"></i> Filters
        </div>
        <div class="panel-body p-2">
            <div class="row g-3 align-items-end">
                <div class="col-auto u-minw-200">
                    <label class="filter-label">Learner ID</label>
                    <div id="filterStudent"></div>
                </div>
                <div class="col-auto u-minw-240">
                    <label class="filter-label">Course</label>
                    <div id="filterCourse"></div>
                </div>
                <div class="col-auto">
                    <label class="filter-label">Status</label>
                    <div id="filterStatus"></div>
                </div>
                <div class="col-auto ms-auto">
                    <button type="button" class="action-link action-link-sm" id="btnClearFilters">
                        <i class="fas fa-times"></i> Clear Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

  
    <div class="row g-3 flex-grow-1 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>

</div>

@section Scripts {
    <script>
        let gridInstance;
        const statusOptions = [
            { id: 'all', name: 'All' },
            { id: 'completed', name: 'Completed / Passed' },
            { id: 'failed', name: 'Failed' },
            { id: 'inprogress', name: 'In Progress / Incomplete' }
        ];
        const summaryKpiIds = ['kpi-total', 'kpi-completed', 'kpi-inprogress', 'kpi-failed', 'kpi-avgscore', 'kpi-totaltime'];
        const summaryStatsCacheTtlMs = 30000;
        let summaryStatsRequest = null;
        let summaryStatsCache = null;
        let summaryStatsCacheAt = 0;
        const statusToneMap = {
            completed: "success",
            passed: "success",
            failed: "danger",
            incomplete: "warning",
            in_progress: "primary"
        };

        let filterStudentCode = null;
        let filterCourseCode = null;
        let filterStatus = 'all';

        const logsStore = createDataStore(serviceUrl, 'admin/LearningLogsCRUD');
        const coursesLookupStore = createDataStore(serviceUrl, 'admin/CoursesCRUD', { loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetForLookup` });

        function formatTimeSpent(seconds) {
            return window.formatAdminDuration(seconds, '—', { includeSeconds: true });
        }

        function formatTimeFull(seconds) {
            return window.formatAdminDuration(seconds, '—');
        }

        function applySummaryStats(d) {
            $("#kpi-total").text(window.formatAdminInteger(d.totalLogs, '0'));
            $("#kpi-completed").text(window.formatAdminInteger(d.completedCount, '0'));
            $("#kpi-inprogress").text(window.formatAdminInteger(d.inProgressCount, '0'));
            $("#kpi-failed").text(window.formatAdminInteger(d.failedCount, '0'));
            $("#kpi-avgscore").text(d.avgScore > 0 ? window.formatAdminPercentage(d.avgScore, '—') : '—');
            $("#kpi-totaltime").text(formatTimeFull(d.totalTimeSpent));
        }

        function loadSummaryStats(options) {
            const settings = options || {};
            const force = settings.force === true;
            const now = Date.now();
            const canUseCache = !force && summaryStatsCache && (now - summaryStatsCacheAt) < summaryStatsCacheTtlMs;

            if (canUseCache) {
                applySummaryStats(summaryStatsCache);
                return $.Deferred().resolve(summaryStatsCache).promise();
            }

            if (summaryStatsRequest) {
                return summaryStatsRequest;
            }

            showStatSkeleton(summaryKpiIds);

            summaryStatsRequest = $.ajax({
                url: `${serviceUrl}/admin/LearningLogsCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                summaryStatsCache = d || {};
                summaryStatsCacheAt = Date.now();
                applySummaryStats(summaryStatsCache);
            }).fail(function() {
                hideStatSkeleton(summaryKpiIds);
            }).always(function() {
                summaryStatsRequest = null;
            });

            return summaryStatsRequest;
        }

        function applyFilters() {
            const filters = [];
            if (filterStudentCode) filters.push(["studentCode", "contains", filterStudentCode]);
            if (filterCourseCode) filters.push(["courseCode", "contains", filterCourseCode]);

            if (filterStatus === 'completed') {
                filters.push([["status", "=", "completed"], "or", ["status", "=", "passed"]]);
            } else if (filterStatus === 'failed') {
                filters.push(["status", "=", "failed"]);
            } else if (filterStatus === 'inprogress') {
                filters.push([["status", "=", "incomplete"], "or", ["status", "=", "in_progress"]]);
            }

            if (filters.length > 1) {
                const combined = [filters[0]];
                for (let i = 1; i < filters.length; i++) {
                    combined.push("and", filters[i]);
                }
                gridInstance.filter(combined);
            } else if (filters.length === 1) {
                gridInstance.filter(filters[0]);
            } else {
                gridInstance.clearFilter();
            }
            gridInstance.refresh();
        }

        $(() => {
            loadSummaryStats();

            // ── Filter Bar Controls ──
            $("#filterStudent").dxTextBox({
                placeholder: 'Search...',
                showClearButton: true,
                width: '100%',
                valueChangeEvent: 'keyup',
                onValueChanged: (e) => { filterStudentCode = e.value || null; applyFilters(); }
            });

            $("#filterCourse").dxSelectBox({
                dataSource: { store: coursesLookupStore, paginate: true, pageSize: 20 },
                valueExpr: 'code',
                displayExpr: 'code',
                value: null,
                placeholder: 'All Courses',
                showClearButton: true,
                searchEnabled: true,
                searchExpr: 'code',
                searchMode: 'contains',
                width: '100%',
                onValueChanged: (e) => { filterCourseCode = e.value || null; applyFilters(); }
            });

            $("#filterStatus").dxSelectBox({
                dataSource: statusOptions,
                valueExpr: 'id',
                displayExpr: 'name',
                value: 'all',
                width: 200,
                onValueChanged: (e) => { filterStatus = e.value; applyFilters(); }
            });

            $("#btnClearFilters").on('click', function() {
                filterStudentCode = null;
                filterCourseCode = null;
                filterStatus = 'all';
                $("#filterStudent").dxTextBox("instance").option('value', null);
                $("#filterCourse").dxSelectBox("instance").option('value', null);
                $("#filterStatus").dxSelectBox("instance").option('value', 'all');
                applyFilters();
            });

            // ── DataGrid ──
            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search logs...", {
                height: "100%",
                dataSource: logsStore,
                remoteOperations: true,

                export: { enabled: true, allowExportSelectedData: true },
                onExporting: (e) => handleExporting(e, 'LearningLogs_Report'),

                columns: [
                    { dataField: "studentCode", caption: "Learner ID", width: 130 },
                    { dataField: "courseCode", caption: "Course", minWidth: 120 },
                    { dataField: "courseTitle", caption: "Course Title", minWidth: 180, visible: false },
                    { dataField: "enrollmentId", caption: "Enroll ID", width: 100, alignment: "center" },
                    {
                        dataField: "status", caption: "Status", width: 120, alignment: "center",
                        cellTemplate: (container, options) => {
                            const value = (options.value || "").toLowerCase();
                            window.renderAdminGridStatusCell(container, options.value || "—", statusToneMap[value] || "default");
                        }
                    },
                    {
                        dataField: "progress", caption: "Progress", width: 100, alignment: "center",
                        cssClass: "cell-accent",
                        customizeText: function(e) { return Math.round(e.value || 0) + "%"; }
                    },
                    {
                        dataField: "score", caption: "Score", width: 80, alignment: "center",
                        cellTemplate: (container, options) => {
                            const value = options.value;
                            if (value === null || value === undefined) {
                                window.renderAdminGridTextCell(container, "—", "captionMuted", { opacity: ".4" });
                                return;
                            }

                            window.renderAdminGridTextCell(container, value, value >= 50 ? "captionSuccess" : "captionDanger");
                        }
                    },
                    {
                        dataField: "totalSecondsPlayed", caption: "Time Spent", width: 100, alignment: "center",
                        cssClass: "cell-caption",
                        customizeText: function(e) { return formatTimeSpent(e.value); }
                    },
                    { dataField: "attemptCount", caption: "Attempts", width: 80, alignment: "center" },
                    { dataField: "updatedAt", caption: "Last Activity", dataType: "datetime", format: ADMIN_DATETIME_DISPLAY_FORMAT, width: 155 },
                    { dataField: "createdAt", caption: "First Access", dataType: "datetime", format: ADMIN_DATETIME_DISPLAY_FORMAT, width: 155, visible: false }
                ]
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });
        });
    </script>
}