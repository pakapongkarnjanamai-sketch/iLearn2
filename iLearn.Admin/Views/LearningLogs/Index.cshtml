@{
    ViewBag.Title = "Learning Logs (SCORM)";
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@ViewBag.Title</h5>
        </div>
        <div class="card-body">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(() => {
            const grid = $("#grid").dxDataGrid({
                dataSource: createDataStore(serviceUrl, 'admin/LearningLogsCRUD', {
                    key: 'Id',
                }),
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: true,
                scrolling: { mode: "virtual" },
                height: "100%",
                headerFilter: { visible: true, search: { enabled: true } },
                searchPanel: { visible: true, width: 300 },
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, '@ViewBag.Title'),

                // ปรับปรุง Form สำหรับการแก้ไข (ถ้าอนุญาตให้แก้)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: false, // Log มักจะเกิดจากระบบ ไม่ควร Add เอง
                    useIcons: true,
                    form: {
                        colCount: 2,
                        items: [
                            { dataField: 'Id', editorOptions: { disabled: true }, colSpan: 2 },
                            { dataField: 'StudentCode', editorOptions: { disabled: true } },
                            { dataField: 'CourseId', editorOptions: { disabled: true } },
                            { dataField: 'CourseVersionId', editorOptions: { disabled: true } },
                            { dataField: 'ResourceId', editorOptions: { disabled: true } },

                            // SCORM Data (อนุญาตให้แก้ Status/Score ได้กรณีมีปัญหา)
                            { dataField: 'LessonStatus' },
                            { dataField: 'ScoreRaw' },
                            { dataField: 'TotalTime' },
                            { dataField: 'AttemptCount' },
                            { dataField: 'CompletedDate', editorType: "dxDateBox" }
                        ]
                    }
                },

                // ปรับปรุง Columns ให้ตรงกับ DTO ใหม่
                columns: [
                    { dataField: "Id", caption: "ID", width: 60, allowUpdating: false },
                    { dataField: "StudentCode", caption: "Student Code" },

                    // Course Info
                    { dataField: "CourseId", caption: "Course ID", width: 80 },
                    { dataField: "CourseVersionId", caption: "Ver.", width: 60 },
                    { dataField: "ResourceId", caption: "Resource ID", width: 100 },

                    // SCORM Status
                    {
                        dataField: "LessonStatus",
                        caption: "Status",
                        cellTemplate: function(container, options) {
                            let color = 'secondary';
                            const status = (options.value || '').toLowerCase();
                            if (status === 'passed' || status === 'completed') color = 'success';
                            else if (status === 'failed') color = 'danger';
                            else if (status === 'incomplete') color = 'warning';

                            $("<span class='badge bg-" + color + "'>")
                                .text(options.value)
                                .appendTo(container);
                        }
                    },
                    { dataField: "ScoreRaw", caption: "Score", dataType: "number" },
                    { dataField: "TotalTime", caption: "Total Time" },
                    { dataField: "AttemptCount", caption: "Attempts", dataType: "number" },

                    // Dates
                    {
                        dataField: "LastAccessDate",
                        caption: "Last Access",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm"
                    },
                    {
                        dataField: "CompletedDate",
                        caption: "Completed",
                        dataType: "datetime",
                        format: "dd/MM/yyyy HH:mm"
                    }
                ],
            }).dxDataGrid('instance');
        })
    </script>
}