@{
    ViewBag.Title = "Learning Logs";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Monitor detailed SCORM learning history, progress, and scores.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-light border shadow-sm rounded px-3" onclick="exportGrid()">
                    <i class="fas fa-file-excel me-2 text-success"></i> Export to Excel
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/LearningLogsCRUD'),
                remoteOperations: true,
                searchPanel: { placeholder: "Search logs..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                export: { enabled: false }, // ซ่อนปุ่มเดิมและใช้ปุ่ม Custom ด้านบนแทน
                onExporting: (e) => handleExporting(e, 'LearningLogs_Data'),

                columns: [
                    { dataField: "id", caption: "ID", dataType: "number", width: 80, visible: false },
                    { dataField: "studentCode", caption: "Employee ID", dataType: "string", minWidth: 120 },
                    { dataField: "enrollmentId", caption: "Enrollment ID", dataType: "number", minWidth: 120, alignment: "center" },
                    {
                        dataField: "status", // อัปเดตให้ตรงกับ API ใหม่
                        caption: "Status",
                        dataType: "string",
                        minWidth: 150,
                        alignment: "center",
                       
                    },
                    {
                        dataField: "progress", // เพิ่มคอลัมน์ progress เข้ามาใหม่
                        caption: "Progress",
                        dataType: "number",
                        minWidth: 100,
                        alignment: "center",
                     
                    },
                    {
                        dataField: "score", // เปลี่ยนจาก scoreRaw เป็น score
                        caption: "Score",
                        dataType: "number",
                        minWidth: 80,
                        alignment: "center",
                       
                    },
                    {
                        dataField: "totalSecondsPlayed",
                        caption: "Time Spent",
                        dataType: "number",
                        minWidth: 120,
                        alignment: "center",
                        calculateCellValue: function(data) {
                            // แปลงวินาทีเป็น HH:mm:ss แบบรองรับเวลาเกิน 24 ชม. ได้
                            const sec = parseInt(data.totalSecondsPlayed) || 0;
                            const h = Math.floor(sec / 3600).toString().padStart(2, '0');
                            const m = Math.floor((sec % 3600) / 60).toString().padStart(2, '0');
                            const s = Math.floor(sec % 60).toString().padStart(2, '0');
                            return `${h}:${m}:${s}`;
                        }
                    },
                    { dataField: "attemptCount", caption: "Attempts", dataType: "number", minWidth: 90, alignment: "center" },
                    {
                        dataField: "updatedAt", // เปลี่ยนจาก lastAccessDate เป็น updatedAt
                        caption: "Last Access",
                        dataType: "datetime",
                        format: "dd MMM yyyy HH:mm",
                        minWidth: 160
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม Export ด้านบน
        function exportGrid() {
            if (gridInstance) {
                gridInstance.exportToExcel(false);
            }
        }
    </script>
}