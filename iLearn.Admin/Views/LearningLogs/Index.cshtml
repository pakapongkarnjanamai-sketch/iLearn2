@{
    ViewBag.Title = "Learning Logs (SCORM)";
}

<div class="container-fluid page-full-height">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@ViewBag.Title</h5>
        </div>
        <div class="card-body">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(() => {
            const grid = $("#grid").dxDataGrid({
                dataSource: createDataStore(serviceUrl, 'admin/LearningLogsCRUD', {
                    key: 'id',
                }),
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: true,
                scrolling: { mode: "virtual" },
                height: "100%",
                headerFilter: { visible: true, search: { enabled: true } },
                searchPanel: { visible: true, width: 300 },
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, '@ViewBag.Title'),

                // ปรับปรุง Form สำหรับการแก้ไข (ถ้าอนุญาตให้แก้)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: false, // Log มักจะเกิดจากระบบ ไม่ควร Add เอง
                    useIcons: true,
                    form: {
                        colCount: 2,
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true }, colSpan: 2 },
                            { dataField: 'studentCode', editorOptions: { disabled: true } },
                            { dataField: 'courseId', editorOptions: { disabled: true } },
                            { dataField: 'courseVersionId', editorOptions: { disabled: true } },
                            { dataField: 'resourceId', editorOptions: { disabled: true } },

                            // SCORM Data (อนุญาตให้แก้ Status/Score ได้กรณีมีปัญหา)
                            { dataField: 'LessonStatus' },
                            { dataField: 'ScoreRaw' },
                            { dataField: 'TotalTime' },
                            { dataField: 'AttemptCount' },
                            { dataField: 'CompletedDate', editorType: "dxDateBox" }
                        ]
                    }
                },

                       // ปรับปรุง columns
        columns: [
            { dataField: "id", caption: "ID", width: 60, visible: false },
            { dataField: "enrollmentId", caption: "Enrollment ID", width: 100 }, // ✅ แสดง ID รอบการลงทะเบียน
            { dataField: "studentCode", caption: "พนักงาน" },
            { dataField: "lessonStatus", caption: "สถานะล่าสุด" }, //
            {
                dataField: "totalSecondsPlayed",
                caption: "เวลาเรียนรวม",
                calculateCellValue: function(data) {
                    // แปลงวินาทีเป็น HH:mm:ss เพื่อให้ Admin อ่านง่าย
                    const sec = data.totalSecondsPlayed || 0;
                    return new Date(sec * 1000).toISOString().substr(11, 8);
                }
            },
            { dataField: "attemptCount", caption: "จำนวนครั้งที่เข้าเรียน", width: 150 }, // ✅ แสดงความถี่ในการเข้า
            { dataField: "lastAccessDate", caption: "ใช้งานล่าสุด", dataType: "datetime", format: "dd/MM/yyyy HH:mm" }
        ],
            }).dxDataGrid('instance');
        })
    </script>
}