@{
    ViewBag.Title = "Learning Logs (SCORM)";
}

@section Styles {
    <style>
        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 700;
            color: var(--brand-dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* --- Content Layout --- */
        .content-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            border: none;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 240px);
        }

        /* --- Grid Customization --- */
        .dx-datagrid-headers {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

            .dx-datagrid-headers .dx-header-row > td {
                font-weight: 700 !important;
                color: #495057 !important;
                padding-top: 15px;
                padding-bottom: 15px;
            }

        /* --- Badges & Icons --- */
        .btn-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
            border: none;
            background: #f8f9fa;
            color: #6c757d;
        }

            .btn-icon:hover {
                transform: translateY(-2px);
                background-color: var(--brand-light);
                color: var(--brand-color);
            }

        .action-group {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
    </style>
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Monitor detailed SCORM learning history, progress, and scores.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-outline-secondary rounded-pill px-4 shadow-sm" onclick="exportGrid()">
                    <i class="fas fa-file-excel me-2 text-success"></i> Export to Excel
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3" id="grid-logs"></div>
    </div>
</div>

@section Scripts {
    <script>
    
        let gridInstance;

        $(() => {
            gridInstance = $("#grid-logs").dxDataGrid({
                dataSource: createDataStore(serviceUrl, 'admin/LearningLogsCRUD', {
                    key: 'id',
                }),
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: false,
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                height: "100%",
                width: "100%",
                headerFilter: { visible: true, search: { enabled: true } },
                searchPanel: { visible: true, width: 300, placeholder: "Search logs..." },
                export: { enabled: false }, // เราซ่อนปุ่มเดิมและใช้ปุ่ม Custom ด้านบนแทน
                onExporting: (e) => handleExporting(e, 'LearningLogs_Data'),

               

                columns: [
                    { dataField: "id", caption: "ID", width: 80, visible: false },
                    { dataField: "studentCode", caption: "Employee ID", width: 150, cssClass: "fw-bold text-primary" },
                    { dataField: "enrollmentId", caption: "Enrollment ID", width: 120, alignment: "center" },
                    {
                        dataField: "lessonStatus",
                        caption: "Status",
                        width: 150,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const status = (options.value || "unknown").toLowerCase();
                            let badgeClass = "bg-secondary";
                            let icon = "fa-question-circle";

                            if (status === 'passed' || status === 'completed') {
                                badgeClass = "bg-success";
                                icon = "fa-check-circle";
                            } else if (status === 'failed') {
                                badgeClass = "bg-danger";
                                icon = "fa-times-circle";
                            } else if (status === 'incomplete' || status === 'browsed') {
                                badgeClass = "bg-warning text-dark";
                                icon = "fa-hourglass-half";
                            } else if (status === 'not attempted') {
                                badgeClass = "bg-light border text-muted";
                                icon = "fa-minus-circle";
                            }

                            $("<span>").addClass(`badge ${badgeClass} px-2 py-1`)
                                       .html(`<i class="fas ${icon} me-1"></i> ${options.value || 'N/A'}`)
                                       .appendTo(container);
                        }
                    },
                    {
                        dataField: "scoreRaw",
                        caption: "Score",
                        width: 100,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const score = options.value;
                            if (score !== null && score !== undefined) {
                                $("<span>").addClass("fw-bold").text(score).appendTo(container);
                            } else {
                                $("<span>").addClass("text-muted small").text("-").appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "totalSecondsPlayed",
                        caption: "Time Spent",
                        width: 150,
                        alignment: "center",
                        calculateCellValue: function(data) {
                            // แปลงวินาทีเป็น HH:mm:ss แบบรองรับเวลาเกิน 24 ชม. ได้
                            const sec = parseInt(data.totalSecondsPlayed) || 0;
                            const h = Math.floor(sec / 3600).toString().padStart(2, '0');
                            const m = Math.floor((sec % 3600) / 60).toString().padStart(2, '0');
                            const s = Math.floor(sec % 60).toString().padStart(2, '0');
                            return `${h}:${m}:${s}`;
                        }
                    },
                    { dataField: "attemptCount", caption: "Attempts", width: 100, alignment: "center" },
                    { dataField: "lastAccessDate", caption: "Last Access", dataType: "datetime", format: "dd MMM yyyy HH:mm", width: 180 },
                    
                ],
            }).dxDataGrid('instance');
        });

        // ฟังก์ชันสำหรับปุ่ม Export ด้านบน
        function exportGrid() {
            gridInstance.exportToExcel(false);
        }
    </script>
}