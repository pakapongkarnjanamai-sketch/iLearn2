@{
    var isEdit = ViewBag.Id != null;
    ViewBag.Title = isEdit ? "Edit Category" : "New Category";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1 class="page-title">
        <i class="fas fa-folder text-primary me-2" aria-hidden="true"></i>@ViewBag.Title
    </h1>
    <div class="page-header-actions">
        <a href="@Url.Action("Index", "StudentGroupCategories")" class="action-link">
            <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
        </a>
        <button type="button" id="btn-save" class="action-link primary">
            <i class="fas fa-save" aria-hidden="true"></i> @(isEdit ? "Save Changes" : "Create Category")
        </button>
    </div>
</div>

<div class="container page-shell-sm px-4 py-4">
    <div id="load-panel"></div>

    <div class="border rounded bg-white d-flex flex-column">
        <div class="p-3">
            <div class="admin-section-header">
                <div class="admin-section-header-main">
                    <div class="section-title mb-0 admin-section-title-fill">Category Information</div>
                </div>
                <div class="admin-section-divider"></div>
            </div>
        </div>
        <div class="px-3 pb-3 admin-form-card">
            <div id="form-container"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const CATEGORIES_API_URL = `${serviceUrl}/StudentGroupCategories`;
    const CATEGORY_ID = @(ViewBag.Id ?? "null");
    const INITIAL_PARENT_ID = @(ViewBag.ParentId ?? "null");
    const IS_EDIT = @(isEdit ? "true" : "false");
    const INDEX_URL = '@Url.Action("Index", "StudentGroupCategories")';
    const DESCRIPTION_FIELD_HEIGHT = 120;

    let formInstance;
    let loadPanel;

    $(() => {
        loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: false,
            showIndicator: true,
            showPane: true,
            shading: true
        }).dxLoadPanel("instance");

        formInstance = $("#form-container").dxForm({
            labelMode: "floating",
            colCount: 1,
            formData: { name: "", description: "", parentId: INITIAL_PARENT_ID },
            items: [
                {
                    dataField: "name",
                    label: { text: "Category Name" },
                    editorOptions: { placeholder: "e.g. Operations / Field Services" },
                    validationRules: [
                        { type: "required", message: "Name is required" },
                        { type: "stringLength", max: 200, message: "Max 200 characters" }
                    ]
                },
                buildParentSelectorItem(),
                {
                    dataField: "description",
                    label: { text: "Description" },
                    editorType: "dxTextArea",
                    editorOptions: {
                        height: DESCRIPTION_FIELD_HEIGHT,
                        placeholder: "Short description of what this category contains"
                    }
                }
            ]
        }).dxForm("instance");

        if (IS_EDIT) {
            loadCategory();
        }

        $("#btn-save").on("click", save);
    });

    function buildParentSelectorItem() {
        return {
            dataField: "parentId",
            label: { text: "Parent Category (optional)" },
            editorType: "dxSelectBox",
            editorOptions: {
                dataSource: new DevExpress.data.CustomStore({
                    key: "id",
                    loadMode: "raw",
                    load: async function () {
                        const res = await $.ajax({
                            url: CATEGORIES_API_URL,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        });
                        const items = (res?.data || []).filter(c => !IS_EDIT || c.id !== CATEGORY_ID);
                        return items.map(c => ({
                            id: c.id,
                            name: c.name,
                            depth: c.depth || 0,
                            label: `${"— ".repeat(c.depth || 0)}${c.name}`
                        }));
                    }
                }),
                displayExpr: "label",
                valueExpr: "id",
                searchEnabled: true,
                showClearButton: !INITIAL_PARENT_ID,
                readOnly: !!INITIAL_PARENT_ID,
                placeholder: "No parent (root category)"
            }
        };
    }

    async function loadCategory() {
        loadPanel.show();
        try {
            const res = await $.ajax({
                url: `${CATEGORIES_API_URL}/${CATEGORY_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });
            const c = res.data;
            if (!c) {
                showToast("Category not found.", "error");
                window.location.href = INDEX_URL;
                return;
            }
            formInstance.option("formData", {
                name: c.name || "",
                description: c.description || "",
                parentId: c.parentId ?? null
            });
        } catch {
            showToast("Error loading category.", "error");
            window.location.href = INDEX_URL;
        } finally {
            loadPanel.hide();
        }
    }

    async function save() {
        if (!formInstance.validate().isValid) return;
        const data = formInstance.option("formData");
        const payload = {
            name: data.name,
            description: data.description,
            parentId: data.parentId ?? null
        };

        setButtonLoading("#btn-save", true, IS_EDIT ? "Saving..." : "Creating...");
        try {
            if (IS_EDIT) {
                await $.ajax({
                    url: `${CATEGORIES_API_URL}/${CATEGORY_ID}`,
                    method: "PUT",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    xhrFields: { withCredentials: true }
                });
                showToast("Category updated.", "success");
            } else {
                await $.ajax({
                    url: CATEGORIES_API_URL,
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    xhrFields: { withCredentials: true }
                });
                showToast("Category created.", "success");
            }
            window.location.href = INDEX_URL;
        } catch (err) {
            showToast(getApiErrorMessage(err, "Failed to save category."), "error", 4000);
        } finally {
            setButtonLoading("#btn-save", false);
        }
    }
</script>
}
