@{
    ViewBag.Title = "Divisions";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Divisions</div>
        <div class="page-subtitle">Manage company structure and division information.</div>
    </div>
    <button type="button" class="action-link primary" onclick="addNewDivision()">
        <i class="fas fa-plus"></i> New Division
    </button>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Divisions</div>
                <div class="kpi-number" id="kpi-total">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">Total Categories</div>
                <div class="kpi-number" id="kpi-categories">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Total Roles</div>
                <div class="kpi-number" id="kpi-roles">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Unused Divisions</div>
                <div class="kpi-number" id="kpi-unused">—</div>
            </div>
        </div>
    </div>

    <!-- ── DataGrid ── -->
<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>


</div>
 
@section Scripts {
    <script>
        let gridInstance;
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');

        function loadSummaryStats() {
            showStatSkeleton(['kpi-total', 'kpi-categories', 'kpi-roles', 'kpi-unused']);
            $.ajax({
                url: `${serviceUrl}/admin/DivisionsCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                $("#kpi-total").text(d.totalDivisions);
                $("#kpi-categories").text(d.totalCategories);
                $("#kpi-roles").text(d.totalRoles);
                $("#kpi-unused").text(d.unusedDivisions);
            }).fail(function() {
                hideStatSkeleton(['kpi-total', 'kpi-categories', 'kpi-roles', 'kpi-unused']);
            });
        }

        $(() => {
            loadSummaryStats();

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search divisions...", {
                dataSource: divisionsStore,
                remoteOperations: true,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this division? Categories and roles linked to it may be affected."
                    },
                    popup: {
                        title: "Division Details",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Division Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Division Name" },
                                        editorOptions: { placeholder: "Enter division name..." },
                                        validationRules: [{ type: "required", message: "Division name is required" }]
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 70,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Division Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-building").css({ color: "var(--accent-color)", opacity: ".75" }))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        allowEditing: true,
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>").addClass("tag-pill pill-success")
                                    .html('<i class="fas fa-check me-1"></i> Active')
                                    .appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-default")
                                    .html('<i class="fas fa-times me-1"></i> Inactive')
                                    .appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "categoryCount",
                        caption: "Categories",
                        width: 120,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: function(container, options) {
                            const count = options.value || 0;
                            if (count === 0) {
                                $("<span>").addClass("tag-pill pill-default").text("None").appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-success")
                                    .text(count + " categor" + (count > 1 ? "ies" : "y")).appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "roleCount",
                        caption: "Roles",
                        width: 110,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: function(container, options) {
                            const count = options.value || 0;
                            if (count === 0) {
                                $("<span>").addClass("tag-pill pill-default").text("None").appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-info")
                                    .text(count + " role" + (count > 1 ? "s" : "")).appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) {
                                    return (e.row.data.categoryCount || 0) === 0 && (e.row.data.roleCount || 0) === 0;
                                }
                            }
                        ]
                    }
                ],
                onRowInserted: () => loadSummaryStats(),
                onRowUpdated: () => loadSummaryStats(),
                onRowRemoved: () => loadSummaryStats()
            }));
        });

        function addNewDivision() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}