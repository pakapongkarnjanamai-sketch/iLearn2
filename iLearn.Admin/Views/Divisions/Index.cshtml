@{
    ViewBag.Title = "Divisions";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Divisions</h1>
        <div class="page-subtitle">Manage company structure and division information.</div>
    </div>
    <button type="button" class="action-link primary" onclick="addNewDivision()">
        <i class="fas fa-plus" aria-hidden="true"></i> New Division
    </button>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── Summary KPI Bar ── -->
    <div class="row g-2" id="summary-bar">
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-all h-100">
                <div class="kpi-label">Total Divisions</div>
                <div class="kpi-number" id="kpi-total">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-accent h-100">
                <div class="kpi-label">Total Categories</div>
                <div class="kpi-number" id="kpi-categories">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-purple h-100">
                <div class="kpi-label">Total Roles</div>
                <div class="kpi-number" id="kpi-roles">—</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card kpi-warning h-100">
                <div class="kpi-label">Unused Divisions</div>
                <div class="kpi-number" id="kpi-unused">—</div>
            </div>
        </div>
    </div>

    <!-- ── DataGrid ── -->
    <div class="row g-3 flex-grow-1 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>


</div>
 
@section Scripts {
    <script>
        let gridInstance;
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const summaryKpiIds = ['kpi-total', 'kpi-categories', 'kpi-roles', 'kpi-unused'];
        const summaryStatsCacheTtlMs = 30000;
        let summaryStatsRequest = null;
        let summaryStatsCache = null;
        let summaryStatsCacheAt = 0;

        function applySummaryStats(d) {
            $("#kpi-total").text(d.totalDivisions);
            $("#kpi-categories").text(d.totalCategories);
            $("#kpi-roles").text(d.totalRoles);
            $("#kpi-unused").text(d.unusedDivisions);
        }

        function loadSummaryStats(options) {
            const settings = options || {};
            const force = settings.force === true;
            const now = Date.now();
            const canUseCache = !force && summaryStatsCache && (now - summaryStatsCacheAt) < summaryStatsCacheTtlMs;

            if (canUseCache) {
                applySummaryStats(summaryStatsCache);
                return $.Deferred().resolve(summaryStatsCache).promise();
            }

            if (summaryStatsRequest) {
                return summaryStatsRequest;
            }

            showStatSkeleton(summaryKpiIds);

            summaryStatsRequest = $.ajax({
                url: `${serviceUrl}/admin/DivisionsCRUD/GetSummaryStats`,
                type: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(d) {
                summaryStatsCache = d || {};
                summaryStatsCacheAt = Date.now();
                applySummaryStats(summaryStatsCache);
            }).fail(function() {
                hideStatSkeleton(summaryKpiIds);
            }).always(function() {
                summaryStatsRequest = null;
            });

            return summaryStatsRequest;
        }

        $(() => {
            loadSummaryStats();

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search divisions...", {
                height: "100%",
                dataSource: divisionsStore,
                remoteOperations: true,
                editing: window.buildAdminPopupEditing({
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this division? Categories and roles linked to it may be affected."
                    },
                    popup: {
                        title: "Division Details",
                        width: 520
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Division Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Division Name" },
                                        editorOptions: { placeholder: "Enter division name..." },
                                        validationRules: [{ type: "required", message: "Division name is required" }]
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                }),
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowEditing: false,
                        alignment: "center",
                        sortOrder: "asc",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Division Name",
                        minWidth: 200,
                        cellTemplate: (container, options) => {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-building").css({ color: "var(--primary-color)", opacity: ".75" }))
                                .append($("<span>").addClass("fw-bold text-dark").text(options.value))
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        allowEditing: true,
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: (container, options) => window.renderAdminGridStatusCell(
                            container,
                            options.value ? "Active" : "Inactive",
                            options.value ? "success" : "default"
                        )
                    },
                    {
                        dataField: "categoryCount",
                        caption: "Categories",
                        width: 120,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: (container, options) => {
                            const count = options.value || 0;
                            window.renderAdminGridTextCell(
                                container,
                                count === 0 ? "None" : count + " categor" + (count > 1 ? "ies" : "y"),
                                count === 0 ? "captionMuted" : "captionSuccess"
                            );
                        }
                    },
                    {
                        dataField: "roleCount",
                        caption: "Roles",
                        width: 110,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: (container, options) => {
                            const count = options.value || 0;
                            window.renderAdminGridTextCell(
                                container,
                                count === 0 ? "None" : count + " role" + (count > 1 ? "s" : ""),
                                count === 0 ? "captionMuted" : "captionAccent"
                            );
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) {
                                    return (e.row.data.categoryCount || 0) === 0 && (e.row.data.roleCount || 0) === 0;
                                }
                            }
                        ]
                    }
                ],
                onRowInserted: () => loadSummaryStats({ force: true }),
                onRowUpdated: () => loadSummaryStats({ force: true }),
                onRowRemoved: () => loadSummaryStats({ force: true })
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });
        });

        function addNewDivision() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}