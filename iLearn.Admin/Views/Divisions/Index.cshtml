@{
    ViewBag.Title = "Divisions";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-sitemap"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage company structure and division information.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewDivision()">
                    <i class="fas fa-plus me-2"></i> New Division
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search divisions..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    form: {
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true } },
                            { dataField: 'name', validationRules: [{ type: "required", message: "Division name is required" }] }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Division Name" }
                ]
            });
        });

        function addNewDivision() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}