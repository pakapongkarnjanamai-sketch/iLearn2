@{
    ViewBag.Title = "Divisions";
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-sitemap"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage company structure and division information.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewDivision()">
                    <i class="fas fa-plus me-2"></i> New Division
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            // เรียกใช้ initDxGrid เพื่อนำการตั้งค่าจาก Layout มาใช้ร่วมกัน
            gridInstance = initDxGrid("#grid", {
                // key: 'id' ไม่ต้องใส่แล้ว เพราะมีใน Default ของ createDataStore แล้ว
                dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },

                // เขียนทับแค่ Placeholder ของช่องค้นหา นอกนั้นดึงจาก Default
                searchPanel: { placeholder: "Search divisions..." },

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    form: {
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true } },
                            { dataField: 'name', validationRules: [{ type: "required", message: "Division name is required" }] }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Division Name",
                        cssClass: "fw-bold text-dark"
                    },

                    // --- คอลัมน์ Action แบบมาตรฐาน ---
                    {
                        caption: "Manage",
                        width: 120,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // ปุ่ม Edit
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Division")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // ปุ่ม Delete
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Division")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(
                                        `Are you sure you want to delete division <b>${data.name}</b>?`,
                                        "Confirm Delete"
                                    ).done((res) => {
                                        if (res) gridInstance.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม New Division ด้านบน
        function addNewDivision() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}