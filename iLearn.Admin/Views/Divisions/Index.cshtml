@{
    ViewBag.Title = "Divisions";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Divisions</div>
        <div class="page-subtitle">Manage company structure and division information.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewDivision()">
        <i class="fas fa-plus"></i> New Division
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search divisions..." },
                showBorders: false,
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    form: {
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true } },
                            { dataField: 'name', validationRules: [{ type: "required", message: "Division name is required" }] }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Division Name" }
                ]
            });
        });

        function addNewDivision() {
            if (gridInstance) gridInstance.addRow();
        }
    </script>
}