@{
    ViewBag.Title = "Learner Groups";
}

@section Styles {
    <style>
        @@media (max-width: 991.98px) {
            .page-header {
                align-items: flex-start !important;
            }

            .page-header-actions {
                width: 100%;
            }
        }

    </style>
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="admin-monitor-bar">
        <div class="admin-monitor-filters admin-monitor-filters--spacious">
            <div class="admin-filter-group" role="group" aria-label="Category filters">
                <div class="admin-filter-group" id="type-filter-chips"></div>
            </div>
        </div>
    </div>
    
    <div class="page-header-actions">
        <a href="@Url.Action("Index", "LearnerGroupCategories")" class="action-link">
            <i class="fas fa-folder-tree" aria-hidden="true"></i> Manage Categories
        </a>
        <a href="@Url.Action("Editor", "LearnerGroups")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Group
        </a>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>
</div>

@section Scripts {
    <script>
        const CATEGORIES_API_URL = `${serviceUrl}/LearnerGroupCategories`;
        const groupDetailUrl = '@Url.Action("Detail", "LearnerGroups")';
        const groupsStore = createDataStore(serviceUrl, 'admin/LearnerGroupsCRUD', { key: 'id' });
        const EMPTY_CATEGORY_FILTER_KEY = "uncategorized";
        let learnerGroupCategoryFilters = [{ key: "all", categoryId: null, label: "All Categories" }];
        let learnerGroupQuickFilterState = { categoryKey: "all" };

        $(function () {
            const grid = initDxGrid("#grid", buildAdminGridOptions("Search by group name...", {
                dataSource: groupsStore,
                keyExpr: "id",
                height: "100%",
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                onRowDblClick: function (e) {
                    if (e.data?.id) window.location.href = `${groupDetailUrl}?id=${e.data.id}`;
                },
                columns: [
                    {
                        dataField: "name",
                        caption: "Group Name",
                        minWidth: 240
                    },
                    {
                        dataField: "categoryName",
                        caption: "Category",
                        width: 220,
                        cssClass: "cell-secondary",
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 220
                    },
                    {
                        dataField: "memberCount",
                        caption: "Members",
                        width: 100,
                        alignment: "center",
                        cssClass: "tabular-nums",
                        customizeText: function (e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "createdBy",
                        caption: "Created By",
                        width: 140,
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Group Details",
                                icon: "info",
                                onClick: function (e) {
                                    if (e.row.data.id) window.location.href = `${groupDetailUrl}?id=${e.row.data.id}`;
                                }
                            }
                        ]
                    }
                ]
            }));

            bindCategoryFilters(grid);
            void loadCategoryFilters(grid);

            window.enableAdminViewportLayout({
                refreshTargets: [{ instance: grid }]
            });

            function bindCategoryFilters(gridInstance) {
                window.bindAdminFilterChips("#type-filter-chips", function (filterKey) {
                    if (getCategoryFilterByKey(filterKey)) {
                        learnerGroupQuickFilterState.categoryKey = filterKey;
                    }

                    applyCategoryFilter(gridInstance);
                }, { dataAttribute: "filterKey" });

                renderCategoryFilters();
                updateCategoryFilterUi();
            }

            function getCategoryFilterByKey(filterKey) {
                return learnerGroupCategoryFilters.find(function (item) {
                    return item.key === filterKey;
                }) || null;
            }

            function applyCategoryFilter(gridInstance) {
                window.applyAdminQuickFilter(gridInstance, learnerGroupQuickFilterState.categoryKey, {
                    getConditions: function (filterKey) {
                        const selectedFilter = getCategoryFilterByKey(filterKey);
                        const conditions = [];

                        if (selectedFilter) {
                            if (selectedFilter.key === EMPTY_CATEGORY_FILTER_KEY) {
                                conditions.push(["categoryId", "=", null]);
                            } else if (selectedFilter.categoryId) {
                                conditions.push(["categoryId", "=", selectedFilter.categoryId]);
                            }
                        }

                        return conditions;
                    },
                    onApplied: function () {
                        updateCategoryFilterUi();
                    }
                });
            }

            function updateCategoryFilterUi() {
                window.updateAdminFilterChipState("#type-filter-chips", learnerGroupQuickFilterState.categoryKey, {
                    dataAttribute: "filterKey"
                });
            }

            function renderCategoryFilters() {
                window.renderAdminFilterChips("#type-filter-chips", learnerGroupCategoryFilters, learnerGroupQuickFilterState.categoryKey, {
                    dataAttribute: "filterKey"
                });
            }

            async function loadCategoryFilters(gridInstance) {
                try {
                    const response = await $.ajax({
                        url: CATEGORIES_API_URL,
                        type: "GET",
                        xhrFields: { withCredentials: true }
                    });

                    const loadedCategories = Array.isArray(response?.data) ? response.data : [];
                    const availableCategories = loadedCategories.filter(function (item) {
                        return item && item.id && item.name;
                    });

                    learnerGroupCategoryFilters = [{ key: "all", categoryId: null, label: "All Categories" }]
                        .concat(availableCategories.map(function (item) {
                            return {
                                key: `category-${item.id}`,
                                categoryId: item.id,
                                label: item.name
                            };
                        }))
                        .concat([{ key: EMPTY_CATEGORY_FILTER_KEY, categoryId: null, label: "No Category" }]);

                    if (!getCategoryFilterByKey(learnerGroupQuickFilterState.categoryKey)) {
                        learnerGroupQuickFilterState.categoryKey = "all";
                    }
                } catch (error) {
                    console.error("Unable to load learner group categories", error);
                    learnerGroupCategoryFilters = [
                        { key: "all", categoryId: null, label: "All Categories" },
                        { key: EMPTY_CATEGORY_FILTER_KEY, categoryId: null, label: "No Category" }
                    ];
                    learnerGroupQuickFilterState.categoryKey = "all";
                }

                renderCategoryFilters();
                applyCategoryFilter(gridInstance);
            }
        });
    </script>
}
