@{
    ViewBag.Title = "Student Groups";
}

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Student Groups</div>
        <div class="page-subtitle">Manage reusable groups of learners for course assignments</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" id="btn-create-group">
        <i class="fas fa-plus"></i> New Group
    </a>
</div>

<div class="container-fluid px-4 py-4">

    <!-- ?? KPI Bar ?? -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-label">Total Groups</div>
                <div class="kpi-number" id="kpi-total">�</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="kpi-card">
                <div class="kpi-label" style="color:var(--accent-color);">Total Members</div>
                <div class="kpi-number" style="color:var(--accent-color);" id="kpi-members">�</div>
            </div>
        </div>
    </div>

    <!-- ?? DataGrid ?? -->
    <div class="border rounded bg-white">
        <div class="panel-header">Group List</div>
        <div id="grid-groups"></div>
    </div>

</div>

<!-- ?? Create / Edit Popup ?? -->
<div id="popup-form"></div>

@section Scripts {
<script>
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const GROUP_DETAIL_URL = '@Url.Action("Detail", "StudentGroups")';
    const EMPTY_TEXT = "—";

    let gridInstance;
    let allGroups = [];
    let editingGroupId = null;
    let formPopup;

    $(() => {
        gridInstance = initDxGrid("#grid-groups", {
            dataSource: [],
            selection: { mode: "single" },
            showBorders: false,
            searchPanel: { visible: true, placeholder: "Search groups..." },
            columns: [
                {
                    dataField: "name", caption: "Group Name", minWidth: 200,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, {
                            fontSize: "13px",
                            fontWeight: "600",
                            color: "var(--text-primary)"
                        });
                    }
                },
                {
                    dataField: "description", caption: "Description", minWidth: 240,
                    cellTemplate: function(container, options) {
                        const description = options.value || EMPTY_TEXT;
                        appendText(container, truncateText(description, 70), {
                            fontSize: "12px",
                            color: "var(--text-secondary)"
                        }).attr("title", description);
                    }
                },
                {
                    dataField: "memberCount", caption: "Members", width: 120, alignment: "center",
                    cellTemplate: function(container, options) {
                        $("<span>")
                            .addClass("tag-pill pill-info")
                            .text(`${options.value ?? 0} members`)
                            .appendTo(container);
                    }
                },
                {
                    dataField: "createdBy", caption: "Created By", width: 140,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, {
                            fontSize: "12px",
                            color: "var(--text-secondary)"
                        });
                    }
                },
                {
                    dataField: "createdAt", caption: "Created", width: 110, alignment: "center",
                    cellTemplate: function(container, options) {
                        appendText(container, formatDate(options.value), {
                            fontSize: "11px",
                            color: "var(--text-secondary)"
                        });
                    }
                },
                {
                    type: "buttons", caption: "Actions", width: 130,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [
                        {
                            hint: "Manage Members", icon: "group",
                            onClick: function(e) {
                                navigateToGroupDetail(e.row.data.id);
                            }
                        },
                        {
                            hint: "Edit", icon: "edit",
                            onClick: function(e) {
                                openEditPopup(e.row.data);
                            }
                        },
                        {
                            hint: "Delete", icon: "trash",
                            onClick: function(e) {
                                confirmDelete(e.row.data);
                            }
                        }
                    ]
                }
            ]
        });

        loadGroups();

        formPopup = $("#popup-form").dxPopup({
            title: "New Student Group",
            width: 500,
            height: "auto",
            showCloseButton: true,
            dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            contentTemplate: function (contentElement) {
                $(`<div id="form-group" class="px-1 pt-2"></div>`).appendTo(contentElement);

                $("#form-group").dxForm({
                    labelMode: "floating",
                    formData: { name: "", description: "" },
                    items: [
                        {
                            dataField: "name",
                            label: { text: "Group Name" },
                            validationRules: [{ type: "required", message: "Group name is required" }]
                        },
                        {
                            dataField: "description",
                            label: { text: "Description (optional)" },
                            editorType: "dxTextArea",
                            editorOptions: { height: 100 }
                        }
                    ]
                });
            },
            toolbarItems: [
                {
                    widget: "dxButton", toolbar: "bottom", location: "before",
                    options: {
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => formPopup.hide()
                    }
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Save", type: "default", stylingMode: "contained",
                        elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                        onClick: () => saveGroup()
                    }
                }
            ]
        }).dxPopup("instance");

        $("#btn-create-group").click(function () {
            openCreatePopup();
        });

        function openCreatePopup() {
            editingGroupId = null;
            formPopup.option("title", "New Student Group");
            getFormInstance().option("formData", createEmptyGroup());
            formPopup.show();
        }

        function openEditPopup(data) {
            editingGroupId = data.id;
            formPopup.option("title", "Edit Student Group");
            getFormInstance().option("formData", { name: data.name, description: data.description || "" });
            formPopup.show();
        }

        async function saveGroup() {
            const form = getFormInstance();
            if (!form.validate().isValid) {
                return;
            }

            const data = form.option("formData");
            const url = editingGroupId ? `${GROUPS_API_URL}/${editingGroupId}` : GROUPS_API_URL;
            const method = editingGroupId ? "PUT" : "POST";

            try {
                await $.ajax({
                    url: url,
                    method: method,
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    xhrFields: { withCredentials: true }
                });

                showToast(editingGroupId ? "Group updated successfully." : "Group created successfully.", "success");
                formPopup.hide();
                loadGroups();
            } catch (err) {
                showToast(`Error: ${getApiErrorMessage(err, "Failed to save")}`, "error", 4000);
            }
        }

        function confirmDelete(data) {
            DevExpress.ui.dialog.confirm(
                `<b>Delete group "${data.name}"?</b><br>
                 <small class="text-muted">All members in this group will also be removed.</small>`,
                "Confirm Delete"
            ).then(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${data.id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Group deleted.", "success");
                    loadGroups();
                } catch {
                    showToast("Failed to delete group.", "error");
                }
            });
        }

        async function loadGroups() {
            try {
                const res = await $.ajax({
                    url: GROUPS_API_URL,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });

                allGroups = res.data || [];
                const totalMembers = allGroups.reduce((sum, g) => sum + (g.memberCount || 0), 0);
                $("#kpi-total").text(allGroups.length);
                $("#kpi-members").text(totalMembers);
                gridInstance.option("dataSource", allGroups);
            } catch {
                showToast("Error loading student groups.", "error");
            }
        }

        function getFormInstance() {
            return $("#form-group").dxForm("instance");
        }

        function createEmptyGroup() {
            return { name: "", description: "" };
        }

        function navigateToGroupDetail(groupId) {
            window.location.href = `${GROUP_DETAIL_URL}?id=${groupId}`;
        }

        function appendText(container, text, styles) {
            return $("<span>").css(styles || {}).text(text).appendTo(container);
        }

        function truncateText(text, maxLength) {
            if (!text || text.length <= maxLength) {
                return text || EMPTY_TEXT;
            }

            return `${text.slice(0, maxLength)}…`;
        }

        function formatDate(value) {
            return value ? new Date(value).toLocaleDateString("en-GB") : EMPTY_TEXT;
        }

        function getApiErrorMessage(error, fallbackMessage) {
            return error?.responseJSON?.message || error?.statusText || fallbackMessage;
        }
    });
</script>
}
