@{
    ViewBag.Title = "Student Groups";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Student Groups</div>
        <div class="page-subtitle">Manage reusable learner groups.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Form", "StudentGroups")" class="action-link primary">
            <i class="fas fa-plus"></i> Create Group
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>

@section Scripts {
    <script>
        const groupDetailUrl = '@Url.Action("Detail", "StudentGroups")';
        const groupsStore = createDataStore(serviceUrl, 'admin/StudentGroupsCRUD', { key: 'id' });

        $(function () {
            initDxGrid("#grid", buildAdminGridOptions("Search by group name, description, or owner...", {
                dataSource: groupsStore,
                remoteOperations: true,

                onRowDblClick: function (e) {
                    if (e.data?.id) window.location.href = `${groupDetailUrl}?id=${e.data.id}`;
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "name",
                        caption: "Group Name",
                        minWidth: 200,
                        cellTemplate: function (container, options) {
                            appendAdminText(container, options.value || "—", { fontSize: "13px", fontWeight: "600", color: "var(--text-primary)" });
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 240,
                        cellTemplate: function (container, options) {
                            const text = options.value || "—";
                            const display = text.length > 70 ? text.slice(0, 70) + "\u2026" : text;
                            const el = $("<span>").text(display).css({ fontSize: "12px", color: "var(--text-secondary)" });
                            if (text.length > 70) el.attr("title", text);
                            $(container).append(el);
                        }
                    },
                    {
                        dataField: "memberCount",
                        caption: "Members",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            const count = options.value || 0;
                            const label = count + " member" + (count !== 1 ? "s" : "");
                            $("<span>").addClass("tag-pill pill-info").text(label).appendTo(container);
                        }
                    },
                    {
                        dataField: "createdBy",
                        caption: "Created By",
                        width: 140,
                        cellTemplate: function (container, options) {
                            appendAdminText(container, options.value || "—", { fontSize: "12px", color: "var(--text-secondary)" });
                        }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Group Details",
                                icon: "info",
                                onClick: function (e) {
                                    if (e.row.data.id) window.location.href = `${groupDetailUrl}?id=${e.row.data.id}`;
                                }
                            }
                        ]
                    }
                ]
            }));
        });
    </script>
}
