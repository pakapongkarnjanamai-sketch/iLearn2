@{
    ViewBag.Title = "Student Groups";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Student Groups</div>
        <div class="page-subtitle">Manage reusable learner groups.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Form", "StudentGroups")" class="action-link primary">
            <i class="fas fa-plus"></i> Create Group
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">


    <!-- ── DataGrid ── -->
    <div class="panel flex-grow-1 d-flex flex-column">
        <div class="panel-header">Groups</div>
        <div class="panel-body p-0 flex-grow-1 overflow-hidden">
            <div id="grid-groups" class="h-100"></div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const GROUP_DETAIL_URL = '@Url.Action("Detail", "StudentGroups")';
    const GROUP_FORM_URL = '@Url.Action("Form", "StudentGroups")';
    const EMPTY_TEXT = "—";

    let gridInstance;
    let allGroups = [];

    $(() => {
        gridInstance = initDxGrid("#grid-groups", buildAdminGridOptions("Search by group name, description, or owner...", {
            dataSource: [],

            onRowDblClick: function(e) {
                navigateToGroupDetail(e.data?.id);
            },

            columns: [
                {
                    dataField: "name", caption: "Group Name", minWidth: 200,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, {
                            fontSize: "13px",
                            fontWeight: "600",
                            color: "var(--text-primary)"
                        });
                    }
                },
                {
                    dataField: "description", caption: "Description", minWidth: 240,
                    cellTemplate: function(container, options) {
                        const description = options.value || EMPTY_TEXT;
                        appendText(container, truncateText(description, 70), {
                            fontSize: "12px",
                            color: "var(--text-secondary)"
                        }).attr("title", description);
                    }
                },
                {
                    dataField: "memberCount", caption: "Members", width: 120, alignment: "center",
                    cellTemplate: function(container, options) {
                        $("<span>")
                            .addClass("tag-pill pill-info")
                            .text(window.formatAdminCountLabel(options.value ?? 0, "member"))
                            .appendTo(container);
                    }
                },
                {
                    dataField: "createdBy", caption: "Created By", width: 140,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, {
                            fontSize: "12px",
                            color: "var(--text-secondary)"
                        });
                    }
                },
              
                {
                    type: "buttons", caption: "Quick Actions", width: 130,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [
                        {
                            hint: "Open Group Details", icon: "info",
                            onClick: function(e) {
                                navigateToGroupDetail(e.row.data.id);
                            }
                        },
                      
                    ]
                }
            ]
        }));

        loadGroups();

        function confirmDelete(data) {
            DevExpress.ui.dialog.confirm(
                `<b>Delete group "${data.name}"?</b><br>
                 <small class="text-muted">This will remove all members from this group.</small>`,
                "Delete Group"
            ).then(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${data.id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Group deleted.", "success");
                    loadGroups();
                } catch {
                    showToast("Couldn't delete the group. Please try again.", "error");
                }
            });
        }

        async function loadGroups() {
            try {
                const res = await $.ajax({
                    url: GROUPS_API_URL,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                });

                allGroups = res.data || [];
                gridInstance.option("dataSource", allGroups);
            } catch {
                showToast("Couldn't load student groups. Please refresh and try again.", "error");
            }
        }

        function navigateToGroupDetail(groupId) {
            if (!groupId) {
                return;
            }

            window.location.href = `${GROUP_DETAIL_URL}?id=${groupId}`;
        }

        function appendText(container, text, styles) {
            return appendAdminText(container, text, styles);
        }

        function truncateText(text, maxLength) {
            return truncateAdminText(text, maxLength);
        }

        function formatDate(value) {
            return window.formatAdminDate(value, EMPTY_TEXT);
        }
    });
</script>
}
