@{
    ViewBag.Title = "Student Groups";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Student Groups</h1>
        <div class="page-subtitle">Manage reusable learner groups.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Editor", "StudentGroups")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Group
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>

@section Scripts {
    <script>
        const groupDetailUrl = '@Url.Action("Detail", "StudentGroups")';
        const groupsStore = createDataStore(serviceUrl, 'admin/StudentGroupsCRUD', { key: 'id' });

        $(function () {
            initDxGrid("#grid", buildAdminGridOptions("Search by group name, description, or owner...", {
                dataSource: groupsStore,
                remoteOperations: true,

                onRowDblClick: function (e) {
                    if (e.data?.id) window.location.href = `${groupDetailUrl}?id=${e.data.id}`;
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "name",
                        caption: "Group Name",
                        minWidth: 200,
                        cssClass: "cell-label",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 240,
                        cellTemplate: function (container, options) {
                            window.renderAdminGridTruncatedTextCell(container, options.value, 70, "captionMuted");
                        }
                    },
                    {
                        dataField: "memberCount",
                        caption: "Members",
                        width: 120,
                        alignment: "center",
                        cssClass: "cell-accent",
                        customizeText: function(e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "createdBy",
                        caption: "Created By",
                        width: 140,
                        cssClass: "cell-secondary",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Group Details",
                                icon: "info",
                                onClick: function (e) {
                                    if (e.row.data.id) window.location.href = `${groupDetailUrl}?id=${e.row.data.id}`;
                                }
                            }
                        ]
                    }
                ]
            }));
        });
    </script>
}
