@{
    ViewBag.Title = "Student Group";
    var groupId = ViewBag.GroupId is int gid ? gid : 0;
}

<style>
    .meta-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .meta-item:last-child { border-bottom: none; }
    .meta-label { font-size: 11px; color: var(--text-secondary); font-weight: 600;
                  text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .meta-value { font-size: 13px; color: var(--text-primary); }
</style>

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title" id="page-title">Student Group</div>
        <div class="page-subtitle" id="page-subtitle">Loading...</div>
    </div>
    <a href="@Url.Action("Index", "StudentGroups")" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

<div class="container-fluid px-4 py-4 d-flex flex-column">

    <div class="row g-3 mb-4 flex-shrink-0">

        <!-- Group Info -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Info</div>

                <div class="meta-item">
                    <div class="meta-label">Group Name</div>
                    <div class="meta-value fw-bold" id="summary-name">—</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Description</div>
                    <div class="meta-value" id="summary-description">—</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Members</div>
                    <div class="meta-value">
                        <span class="tag-pill pill-info" id="summary-member-count">0 members</span>
                    </div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Created By</div>
                    <div class="meta-value" id="summary-created-by">—</div>
                </div>
            </div>
        </div>

        <!-- Summary -->
        <div class="col-lg-6">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="section-title">Summary</div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-members">0</div>
                            <div class="stat-label">Members</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-assignments">0</div>
                            <div class="stat-label">Assignments</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-success" id="stat-completed">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-warning" id="stat-inprogress">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-stretch justify-content-center flex-grow-1 px-3 pt-3 pb-3" style="min-height:240px;">
                    <div id="status-pie-chart" style="width:100%;height:100%;min-height:240px;"></div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btn-add-members" class="quick-action">
                        <div class="qa-icon qa-icon-success"><i class="fas fa-user-plus"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Add Members</div>
                            <div class="u-fs-11 text-secondary">Add students to this group</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Form", "Assignments")?groupId=@groupId" class="quick-action">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-book-open"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Assign Course</div>
                            <div class="u-fs-11 text-secondary">Assign courses to this group</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Form", "StudentGroups")?id=@groupId" class="quick-action">
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-edit"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Edit Student Group</div>
                            <div class="u-fs-11 text-secondary">Change name or description</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-delete-group" class="quick-action danger">
                        <div class="qa-icon qa-icon-danger"><i class="fas fa-trash-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Delete Student Group</div>
                            <div class="u-fs-11 text-secondary">Delete this group and its members</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>

    </div>

    <!-- ── Tabs ── -->
    <div class="border rounded bg-white flex-grow-1 d-flex flex-column" style="min-height:0">
        <div class="d-flex border-bottom px-1 flex-shrink-0">
            <button id="tab-btn-members" onclick="switchTab('members', this)" class="tab-btn active">
                <i class="fas fa-users me-1"></i> Members
                <span class="tag-pill tag-pill-xs pill-default ms-1" id="tab-badge-members">0</span>
            </button>
            <button id="tab-btn-assignments" onclick="switchTab('assignments', this)" class="tab-btn">
                <i class="fas fa-clipboard-list me-1"></i> Assignment History
                <span class="tag-pill tag-pill-xs pill-default ms-1" id="tab-badge-assignments">0</span>
            </button>
        </div>
        <div id="panel-members" class="flex-grow-1" style="min-height:0">
            <div id="grid-members" class="h-100"></div>
        </div>
        <div id="panel-assignments" class="d-none flex-grow-1" style="min-height:0">
            <div id="grid-assignments" class="h-100"></div>
        </div>
    </div>

</div>

<!-- ?? Add Members Popup ?? -->
<div id="popup-add-members"></div>

@section Scripts {
<script>
    const GROUP_ID = @groupId;
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const STUDENTS_API_URL = `${serviceUrl}/Students`;
    const ASSIGNMENT_DETAIL_URL = '@Url.Action("Detail", "Assignments")';
    const STUDENT_PROFILE_URL = '@Url.Action("Profile", "Students")';
    const INDEX_URL = '@Url.Action("Index", "StudentGroups")';
    const EMPTY_TEXT = "—";

    let membersGrid;
    let assignmentGrid;

    $(() => {
        membersGrid = initDxGrid("#grid-members", {
            preset: "compactGrid",
            dataSource: [],
            searchPanel: { placeholder: "Search by ID or name..." },
            columns: [
                {
                    dataField: "studentCode", caption: "Employee ID", width: 130,
                    cellTemplate: function(container, options) {
                        $("<a>")
                            .attr("href", `${STUDENT_PROFILE_URL}?code=${options.value}`)
                            .addClass("tag-pill pill-default fw-bold")
                            .text(options.value || EMPTY_TEXT)
                            .appendTo(container);
                    }
                },
                {
                    dataField: "studentName", caption: "Full Name", minWidth: 180,
                    cellTemplate: function(container, options) {
                        $("<span>").addClass("fw-medium text-dark").text(options.value || EMPTY_TEXT).appendTo(container);
                    }
                },
                {
                    dataField: "division", caption: "Division", width: 130,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, { fontSize: "12px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "department", caption: "Department", width: 130,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, { fontSize: "12px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "section", caption: "Section", minWidth: 130,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, { fontSize: "12px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "position", caption: "Position", width: 110, alignment: "center",
                    cellTemplate: function(container, options) {
                        if (!options.value) {
                            appendText(container, EMPTY_TEXT, { color: "var(--text-secondary)" });
                            return;
                        }

                        $("<span>").addClass("tag-pill pill-default").text(options.value).appendTo(container);
                    }
                },
                {
                    type: "buttons", caption: "Actions", width: 90,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [{
                        hint: "Remove from student group", icon: "remove",
                        onClick: e => confirmRemoveMember(e.row.data)
                    }]
                }
            ]
        });

        assignmentGrid = initDxGrid("#grid-assignments", {
            preset: "compactGrid",
            dataSource: [],
            searchPanel: { placeholder: "Search assignments..." },
            onRowPrepared: function(e) {
                if (e.rowType !== "data") {
                    return;
                }

                if (e.data.status === "Expired") {
                    $(e.rowElement).css("background-color", "#fff2f0");
                }

                if (e.data.status === "Completed") {
                    $(e.rowElement).css("background-color", "#f6ffed");
                }
            },
            columns: [
                {
                    dataField: "assignmentNo", caption: "Assignment No", width: 150,
                    sortOrder: "desc", alignment: "center",
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, {
                            fontSize: "12px",
                            fontWeight: "700",
                            color: "var(--text-primary)"
                        });
                    }
                },
                {
                    dataField: "courseNames", caption: "Courses", minWidth: 200,
                    cellTemplate: function(container, options) {
                        renderCoursesCell(container, options.value);
                    }
                },
                {
                    dataField: "description", caption: "Description", minWidth: 160,
                    cellTemplate: function(container, options) {
                        const description = options.value || EMPTY_TEXT;
                        appendText(container, truncateText(description, 50), {
                            fontSize: "12px",
                            color: "var(--text-secondary)"
                        }).attr("title", description);
                    }
                },
                {
                    dataField: "completionPct", caption: "Progress", width: 140, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderProgressCell(container, options.value);
                    }
                },
                {
                    dataField: "status", caption: "Status", width: 120, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderStatusCell(container, options.value, {
                            Completed: { cls: "pill-success", text: "Completed" },
                            Upcoming: { cls: "pill-warning", text: "Upcoming" },
                            Expired: { cls: "pill-danger", text: "Expired" },
                            InProgress: { cls: "pill-info", text: "In Progress" }
                        });
                    }
                },
                {
                    dataField: "startDate", caption: "Start", width: 100, alignment: "center",
                    cellTemplate: function(container, options) {
                        appendText(container, formatDate(options.value), { fontSize: "11px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "dueDate", caption: "Due", width: 100, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderDueDateCell(container, options.value);
                    }
                },
                {
                    type: "buttons", caption: "Actions", width: 70,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [{
                        hint: "View Dashboard",
                        icon: "info",
                        onClick: function(e) {
                            window.location.href = `${ASSIGNMENT_DETAIL_URL}/${e.row.data.id}`;
                        }
                    }]
                }
            ]
        });

        loadGroupDetail();

        let confirmAddFn = null;

        const addPopup = $("#popup-add-members").dxPopup({
            title: "Add Members to Student Group",
            width: "90vw", maxWidth: 1200, height: "85vh",
            showCloseButton: true, dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            onShown: function() {
                const g = $("#grid-add-students").dxDataGrid("instance");
                if (g) g.updateDimensions();
            },
            contentTemplate: function (contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div class="sidebar-240">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0">
                                    <i class="fas fa-filter text-primary me-2"></i>Filters
                                </h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="filter-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                    <div id="filter-dept"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                    <div id="filter-section"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="btn-clear-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                            <div id="grid-add-students" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                let selectedCodes = [];

                const addGrid = initDxGrid("#grid-add-students", {
                    preset: "selectionGrid",
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "EId",
                        loadUrl: `${serviceUrl}/Students/Get`,
                        onBeforeSend: (m, opts) => opts.xhrFields = { withCredentials: true }
                    }),
                    remoteOperations: true,
                    filterRow: { visible: true },
                    searchPanel: { placeholder: "Search ID or name..." },
                    noDataText: getNoDataText("students"),
                    columns: [
                        {
                            dataField: "EId", caption: "ID", width: 110,
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(o.value).appendTo(c)
                        },
                        {
                            caption: "Name", minWidth: 160,
                            calculateCellValue: d =>
                                [d.EnglishFirstName, d.EnglishLastName].filter(Boolean).join(" "),
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("fw-medium text-dark").text(o.value).appendTo(c)
                        },
                        { dataField: "Division", caption: "Division", width: 120 },
                        { dataField: "Department", caption: "Dept.", width: 100 },
                        {
                            dataField: "Section", caption: "Section", minWidth: 120,
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("text-muted small").text(o.value || "—").appendTo(c)
                        }
                    ],
                    onSelectionChanged: function (e) {
                        selectedCodes = e.selectedRowKeys;
                        setSelectionHint("#add-hint", selectedCodes.length, "student", "to add");
                    }
                });

                function makeLookup(endpoint, q) {
                    return new DevExpress.data.CustomStore({
                        key: "Name",
                        load: () => $.ajax({
                            url: `${STUDENTS_API_URL}/${endpoint}${q || ""}`,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        }).then(res => res.data || res)
                    });
                }

                function buildFilter() {
                    const divVal = $("#filter-div").dxSelectBox("instance").option("value");
                    const deptVal = $("#filter-dept").dxSelectBox("instance").option("value");
                    const secVal = $("#filter-section").dxSelectBox("instance").option("value");
                    const filters = [];
                    if (divVal) filters.push(["Division", "=", divVal]);
                    if (deptVal) filters.push(["Department", "=", deptVal]);
                    if (secVal) filters.push(["Section", "=", secVal]);
                    applyCombinedFilter(addGrid, filters);
                }

                const divBox = $("#filter-div").dxSelectBox({
                    dataSource: makeLookup("GetDivisions"),
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Divisions", showClearButton: true,
                    onValueChanged: function (e) {
                        const deptBox = $("#filter-dept").dxSelectBox("instance");
                        deptBox.option({
                            value: null, disabled: !e.value,
                            dataSource: e.value
                                ? makeLookup("GetDepartments", `?filter=["Division","=","${e.value}"]`)
                                : []
                        });
                        $("#filter-section").dxSelectBox("instance")
                                            .option({ value: null, disabled: true, dataSource: [] });
                        buildFilter();
                    }
                }).dxSelectBox("instance");

                $("#filter-dept").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Departments", showClearButton: true, disabled: true,
                    onValueChanged: function (e) {
                        const secBox = $("#filter-section").dxSelectBox("instance");
                        const divVal = divBox.option("value");
                        const q = e.value
                            ? `?filter=[["Division","=","${divVal}"],"and",["Department","=","${e.value}"]]`
                            : (divVal ? `?filter=["Division","=","${divVal}"]` : "");
                        secBox.option({
                            value: null, disabled: !e.value,
                            dataSource: e.value ? makeLookup("GetSections", q) : []
                        });
                        buildFilter();
                    }
                });

                $("#filter-section").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Sections", showClearButton: true, disabled: true,
                    onValueChanged: buildFilter
                });

                $("#btn-clear-filter").click(function () {
                    divBox.option("value", null);
                    $("#filter-dept").dxSelectBox("instance")
                                     .option({ value: null, disabled: true, dataSource: [] });
                    $("#filter-section").dxSelectBox("instance")
                                        .option({ value: null, disabled: true, dataSource: [] });
                    addGrid.clearFilter();
                });

                confirmAddFn = async function () {
                    if (selectedCodes.length === 0) {
                        showToast("Please select at least one student.", "warning");
                        return;
                    }

                    try {
                        await $.ajax({
                            url: `${GROUPS_API_URL}/${GROUP_ID}/members`,
                            method: "POST",
                            contentType: "application/json",
                            data: JSON.stringify({ studentCodes: selectedCodes }),
                            xhrFields: { withCredentials: true }
                        });

                        showToast("Members added successfully.", "success");
                        addPopup.hide();
                        loadGroupDetail();
                    } catch (err) {
                        showToast(`Error: ${getApiErrorMessage(err, "Failed to add")}`, "error", 4000);
                    }
                };
            },
            toolbarItems: [
                {
                    toolbar: "bottom", location: "before",
                    template: () => $(`
                        <div id="add-hint" class="text-muted small fw-medium ps-1 d-flex align-items-center">
                            <i class="fas fa-info-circle text-primary me-1"></i> Check the rows to add.
                        </div>`)
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => addPopup.hide()
                    }
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Add to Student Group", type: "default", stylingMode: "contained",
                        elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                        onClick: () => confirmAddFn && confirmAddFn()
                    }
                }
            ]
        }).dxPopup("instance");

        $("#btn-add-members").click(() => addPopup.show());

        window.confirmRemoveMember = function (data) {
            DevExpress.ui.dialog.confirm(
                `Remove <b>${data.studentName || data.studentCode}</b> from this student group?`,
                "Confirm Remove"
            ).then(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${GROUP_ID}/members/${data.id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Member removed.", "success");
                    loadGroupDetail();
                } catch {
                    showToast("Failed to remove member.", "error");
                }
            });
        };

        $("#btn-delete-group").click(function () {
            DevExpress.ui.dialog.confirm(
                `<b>Delete this student group?</b><br>
                 <small class="text-muted">All members in this student group will also be removed.</small>`,
                "Confirm Delete"
            ).then(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${GROUP_ID}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Student group deleted.", "success");
                    window.location.href = INDEX_URL;
                } catch {
                    showToast("Failed to delete student group.", "error");
                }
            });
        });
    });

    async function loadGroupDetail() {
        try {
            const res = await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            const g = res.data;
            if (!g) {
                return;
            }

            const members = g.members || [];

            $("#page-title").text(g.name);
            $("#page-subtitle").text(g.description || "No description");
            $("#tab-badge-members").text(members.length);

            // Group Info panel
            $("#summary-name").text(g.name || EMPTY_TEXT);
            $("#summary-description").text(g.description || "No description");
            $("#summary-member-count").text(window.formatAdminCountLabel(members.length, 'member'));
            $("#summary-created-by").text(g.createdBy || EMPTY_TEXT);

            // Stat: Members
            $("#stat-total-members").text(members.length);

            membersGrid.option("dataSource", members);
            loadAssignmentHistory();
        } catch {
            showToast("Error loading group detail.", "error");
        }
    }

    function switchTab(tab, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.getElementById("panel-members").classList.toggle("d-none", tab !== "members");
        document.getElementById("panel-assignments").classList.toggle("d-none", tab !== "assignments");

        if (tab === "assignments" && assignmentGrid) {
            assignmentGrid.updateDimensions();
        }
    }

    async function loadAssignmentHistory() {
        try {
            const res = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/group/${GROUP_ID}/history`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            const data = res.data || [];
            $("#tab-badge-assignments").text(data.length);
            assignmentGrid.option("dataSource", data);

            updateAssignmentStats(data);
        } catch {
            showToast("Error loading assignment history.", "error");
        }
    }

    function updateAssignmentStats(assignments) {
        const total = assignments.length;
        let completed = 0;
        let inProgress = 0;
        let upcoming = 0;
        let expired = 0;

        assignments.forEach(function(a) {
            switch (a.status) {
                case "Completed": completed++; break;
                case "InProgress": inProgress++; break;
                case "Upcoming": upcoming++; break;
                case "Expired": expired++; break;
            }
        });

        $("#stat-total-assignments").text(total);
        $("#stat-completed").text(completed);
        $("#stat-inprogress").text(inProgress);

        // Average completion across all assignments
        const avgCompletion = total > 0
            ? Math.round(assignments.reduce(function(sum, a) { return sum + (a.completionPct || 0); }, 0) / total)
            : 0;
        $("#status-pie-chart").dxPieChart({
            type: "doughnut",
            innerRadius: 0.65,
            palette: ["#52c41a", "#1890ff", "#faad14", "#ff4d4f"],
            dataSource: [
                { status: "Completed", count: completed },
                { status: "In Progress", count: inProgress },
                { status: "Upcoming", count: upcoming },
                { status: "Expired", count: expired }
            ],
            centerTemplate: function(pieChart, container) {
                const svg = document.createElementNS("http://www.w3.org/2000/svg", "g");

                const label = document.createElementNS("http://www.w3.org/2000/svg", "text");
                label.setAttribute("text-anchor", "middle");
                label.setAttribute("y", "-6");
                label.setAttribute("style", "font-size:11px;fill:#8c8c8c;font-weight:600;text-transform:uppercase;letter-spacing:0.4px;");
                label.textContent = "Avg. Completion";

                const value = document.createElementNS("http://www.w3.org/2000/svg", "text");
                value.setAttribute("text-anchor", "middle");
                value.setAttribute("y", "18");
                value.setAttribute("style", "font-size:22px;fill:#52c41a;font-weight:700;");
                value.textContent = window.formatAdminPercentage(avgCompletion, '0%');

                svg.appendChild(label);
                svg.appendChild(value);
                container.appendChild(svg);
            },
            series: [{
                argumentField: "status",
                valueField: "count",
                label: {
                    visible: true,
                    position: "outside",
                    connector: { visible: true },
                    format: { type: "fixedPoint", precision: 0 },
                    font: { size: 11, color: "#595959" },
                    customizeText: function(point) {
                        return point.value > 0 ? `${point.valueText} (${point.percentText})` : "";
                    }
                }
            }],
            legend: {
                horizontalAlignment: "right",
                verticalAlignment: "bottom",
                margin: 12,
                font: { size: 11, color: "#595959" }
            },
            tooltip: { enabled: true }
        });
    }

    function appendText(container, text, styles) {
        return $("<span>").css(styles || {}).text(text).appendTo(container);
    }

    function formatDate(value) {
        return window.formatAdminDate(value, EMPTY_TEXT);
    }

    function truncateText(text, maxLength) {
        if (!text || text.length <= maxLength) {
            return text || EMPTY_TEXT;
        }

        return `${text.slice(0, maxLength)}…`;
    }

    function renderProgressCell(container, value) {
        const progress = value || 0;
        const color = progress === 100
            ? "var(--success-color)"
            : progress >= 50
                ? "var(--accent-color)"
                : "var(--warning-color)";

        $("<div>").addClass("d-flex align-items-center gap-2")
            .append(
                $("<div>").css({
                    flex: "1",
                    height: "3px",
                    background: "var(--border-color)",
                    borderRadius: "2px",
                    overflow: "hidden"
                }).append(
                    $("<div>").css({
                        height: "100%",
                        width: `${progress}%`,
                        background: color
                    })
                )
            )
            .append(
                $("<span>").css({
                    fontSize: "11px",
                    fontWeight: "600",
                    minWidth: "32px",
                    color: "var(--text-secondary)"
                }).text(window.formatAdminPercentage(progress, '0%'))
            )
            .appendTo(container);
    }

    function renderStatusCell(container, value, map) {
        const status = map[value] || { cls: "pill-default", text: value || EMPTY_TEXT };
        $(`<span class="tag-pill ${status.cls}">${status.text}</span>`).appendTo(container);
    }

    function renderDueDateCell(container, value) {
        if (!value) {
            appendText(container, EMPTY_TEXT, { fontSize: "11px", color: "var(--text-secondary)" });
            return;
        }

        const isPast = new Date(value) < new Date();
        appendText(container, formatDate(value), {
            fontSize: "11px",
            color: isPast ? "var(--danger-color)" : "var(--text-secondary)",
            fontWeight: isPast ? "600" : "400"
        });
    }

    function renderCoursesCell(container, value) {
        const courses = (value || "").split(", ").filter(function(course) {
            return course.trim();
        });

        if (!courses.length) {
            appendText(container, EMPTY_TEXT, { color: "var(--text-secondary)" });
            return;
        }

        const wrapper = $("<div>").addClass("d-flex flex-wrap gap-1").appendTo(container);
        courses.slice(0, 2).forEach(function(courseName) {
            $("<span>").addClass("tag-pill tag-pill-xs pill-default").text(courseName).appendTo(wrapper);
        });

        if (courses.length > 2) {
            appendText(wrapper, window.formatAdminCountLabel(courses.length - 2, 'more', 'more', '0 more', { prefix: '+' }), { fontSize: "11px", color: "var(--text-secondary)" });
        }
    }

    function applyCombinedFilter(gridInstance, conditions) {
        if (!conditions.length) {
            gridInstance.clearFilter();
            return;
        }

        let filter = conditions[0];
        for (let index = 1; index < conditions.length; index += 1) {
            filter = [filter, "and", conditions[index]];
        }

        gridInstance.filter(filter);
    }

    function getApiErrorMessage(error, fallbackMessage) {
        return error?.responseJSON?.message || error?.statusText || fallbackMessage;
    }
</script>
}
