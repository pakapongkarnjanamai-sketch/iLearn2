@{
    ViewBag.Title = "Manage Group Members";
    var groupId = ViewBag.GroupId is int gid ? gid : 0;
}

<style>
    .filter-panel {
        background: var(--bg-light);
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 16px;
    }
</style>

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;" id="page-title">Manage Group Members</div>
        <div class="text-secondary" style="font-size:12px;" id="page-subtitle">Loading...</div>
    </div>
    <div class="d-flex gap-2">
        <a href="javascript:void(0);" class="action-link primary" id="btn-assign-course">
            <i class="fas fa-book-open"></i> Assign Course
        </a>
        <a href="javascript:void(0);" class="action-link primary" id="btn-add-members">
            <i class="fas fa-user-plus"></i> Add Members
        </a>
        <a href="@Url.Action("Index", "StudentGroups")" class="action-link">
            <i class="fas fa-arrow-left text-secondary"></i> Back
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4">

    <!-- ?? Group Info Card ?? -->
    <div class="border rounded bg-white p-3 mb-4 d-flex align-items-center gap-3 flex-wrap">
        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:48px;height:48px;background:#e6f4ff;color:var(--accent-color);">
            <i class="fas fa-users fa-lg"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold text-dark" style="font-size:14px;" id="info-name">—</div>
            <div class="text-secondary" style="font-size:12px;" id="info-desc">—</div>
        </div>
        <div class="text-center px-3 border-start">
            <div class="fw-bold" style="font-size:22px;color:var(--accent-color);" id="info-count">—</div>
            <div class="text-secondary" style="font-size:11px;">Members</div>
        </div>
        <div class="text-center px-3 border-start">
            <div class="fw-bold" style="font-size:22px;color:var(--accent-color);" id="kpi-assignment-count">—</div>
            <div class="text-secondary" style="font-size:11px;">Assignments</div>
        </div>
        <div class="text-center px-3 border-start">
            <div class="fw-bold" style="font-size:22px;color:var(--success-color);" id="kpi-completed-count">—</div>
            <div class="text-secondary" style="font-size:11px;">Completed</div>
        </div>
    </div>

    <!-- ?? Tabs ?? -->
    <div class="border rounded bg-white">
        <div class="d-flex border-bottom px-1">
            <button id="tab-btn-members" onclick="switchTab('members', this)"
                    style="padding:10px 18px;border:none;background:none;font-size:13px;font-weight:600;
                           color:var(--accent-color);border-bottom:2px solid var(--accent-color);cursor:pointer;">
                <i class="fas fa-users me-1"></i> Members
                <span class="tag-pill pill-default ms-1" style="font-size:10px;" id="tab-badge-members">0</span>
            </button>
            <button id="tab-btn-assignments" onclick="switchTab('assignments', this)"
                    style="padding:10px 18px;border:none;background:none;font-size:13px;font-weight:600;
                           color:var(--text-secondary);border-bottom:2px solid transparent;cursor:pointer;">
                <i class="fas fa-clipboard-list me-1"></i> Assignment History
                <span class="tag-pill pill-default ms-1" style="font-size:10px;" id="tab-badge-assignments">0</span>
            </button>
        </div>
        <div id="panel-members">
            <div id="grid-members"></div>
        </div>
        <div id="panel-assignments" style="display:none;">
            <div id="grid-assignments"></div>
        </div>
    </div>

</div>

<!-- ?? Add Members Popup ?? -->
<div id="popup-add-members"></div>

<!-- ?? Assign Course Popup ?? -->
<div id="popup-assign-course"></div>

@section Scripts {
<script>
    const GROUP_ID = @groupId;
    let membersGrid;

    $(() => {

        // ?? Members Grid ??
        membersGrid = initDxGrid("#grid-members", {
            dataSource: [],
            showBorders: false,
            showRowLines: true,
            hoverStateEnabled: true,
            searchPanel: { visible: true, placeholder: "Search by ID or name..." },
            columns: [
                {
                    dataField: "studentCode", caption: "Employee ID", width: 130,
                    cellTemplate: (c, o) =>
                        $("<a>").attr("href", `@Url.Action("Profile", "Students")?code=${o.value}`)
                               .addClass("tag-pill pill-default fw-bold")
                               .text(o.value || "—").appendTo(c)
                },
                {
                    dataField: "studentName", caption: "Full Name", minWidth: 180,
                    cellTemplate: (c, o) =>
                        $("<span>").addClass("fw-medium text-dark")
                                   .text(o.value || "—").appendTo(c)
                },
                {
                    dataField: "division", caption: "Division", width: 130,
                    cellTemplate: (c, o) =>
                        $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                   .text(o.value || "—").appendTo(c)
                },
                {
                    dataField: "department", caption: "Department", width: 130,
                    cellTemplate: (c, o) =>
                        $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                   .text(o.value || "—").appendTo(c)
                },
                {
                    dataField: "section", caption: "Section", minWidth: 130,
                    cellTemplate: (c, o) =>
                        $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                   .text(o.value || "—").appendTo(c)
                },
                {
                    dataField: "position", caption: "Position", width: 110, alignment: "center",
                    cellTemplate: (c, o) => {
                        if (!o.value) { $("<span>").css("color","var(--text-secondary)").text("—").appendTo(c); return; }
                        $("<span>").addClass("tag-pill pill-default").text(o.value).appendTo(c);
                    }
                },
                {
                    type: "buttons", caption: "Actions", width: 90,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [{
                        hint: "Remove from group", icon: "remove",
                        onClick: e => confirmRemoveMember(e.row.data)
                    }]
                }
            ]
        });

        loadGroupDetail();

        // ?? Add Members Popup ??
        let confirmAddFn = null;

        const addPopup = $("#popup-add-members").dxPopup({
            title: "Add Members to Group",
            width: "90vw", maxWidth: 1200, height: "85vh",
            showCloseButton: true, dragEnabled: true,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            contentTemplate: function (contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div style="width:240px; flex-shrink:0;">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0">
                                    <i class="fas fa-filter text-primary me-2"></i>Filters
                                </h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="filter-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                    <div id="filter-dept"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                    <div id="filter-section"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="btn-clear-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column" style="min-width:0;">
                            <div id="grid-add-students" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                let selectedCodes = [];

                const addGrid = $("#grid-add-students").dxDataGrid({
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "EId",
                        loadUrl: `${serviceUrl}/Students/Get`,
                        onBeforeSend: (m, opts) => opts.xhrFields = { withCredentials: true }
                    }),
                    remoteOperations: true,
                    showBorders: false, showRowLines: true, rowAlternationEnabled: true,
                    hoverStateEnabled: true,
                    filterRow: { visible: true },
                    searchPanel: { visible: true, placeholder: "Search ID or name...", width: 240 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    scrolling: { mode: "virtual" },
                    height: "100%",
                    noDataText: "No students found.",
                    columns: [
                        {
                            dataField: "EId", caption: "ID", width: 110,
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(o.value).appendTo(c)
                        },
                        {
                            caption: "Name", minWidth: 160,
                            calculateCellValue: d =>
                                [d.EnglishFirstName, d.EnglishLastName].filter(Boolean).join(" "),
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("fw-medium text-dark").text(o.value).appendTo(c)
                        },
                        { dataField: "Division", caption: "Division", width: 120 },
                        { dataField: "Department", caption: "Dept.", width: 100 },
                        {
                            dataField: "Section", caption: "Section", minWidth: 120,
                            cellTemplate: (c, o) =>
                                $("<span>").addClass("text-muted small").text(o.value || "—").appendTo(c)
                        }
                    ],
                    onSelectionChanged: function (e) {
                        selectedCodes = e.selectedRowKeys;
                        $("#add-hint").html(
                            selectedCodes.length > 0
                                ? `<i class="fas fa-check-circle text-success me-1"></i>
                                   <b>${selectedCodes.length}</b> student(s) selected.`
                                : `<i class="fas fa-info-circle text-primary me-1"></i>
                                   Check the rows to add.`
                        );
                    }
                }).dxDataGrid("instance");

                // ?? Lookup store helper ??
                function makeLookup(endpoint, q) {
                    return new DevExpress.data.CustomStore({
                        key: "Name",
                        load: () => $.ajax({
                            url: `${serviceUrl}/Students/${endpoint}${q || ""}`,
                            method: "GET", xhrFields: { withCredentials: true }
                        }).then(res => res.data || res)
                    });
                }

                // ?? Filter helpers ??
                function buildFilter() {
                    const divVal  = $("#filter-div").dxSelectBox("instance").option("value");
                    const deptVal = $("#filter-dept").dxSelectBox("instance").option("value");
                    const secVal  = $("#filter-section").dxSelectBox("instance").option("value");
                    const conds = [];
                    if (divVal)  conds.push(["Division",   "=", divVal]);
                    if (deptVal) conds.push(["Department", "=", deptVal]);
                    if (secVal)  conds.push(["Section",    "=", secVal]);
                    if (!conds.length) { addGrid.clearFilter(); return; }
                    let f = conds[0];
                    for (let i = 1; i < conds.length; i++) f = [f, "and", conds[i]];
                    addGrid.filter(f);
                }

                const divBox = $("#filter-div").dxSelectBox({
                    dataSource: makeLookup("GetDivisions"),
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Divisions", showClearButton: true,
                    onValueChanged: function (e) {
                        const deptBox = $("#filter-dept").dxSelectBox("instance");
                        deptBox.option({
                            value: null, disabled: !e.value,
                            dataSource: e.value
                                ? makeLookup("GetDepartments", `?filter=["Division","=","${e.value}"]`)
                                : []
                        });
                        $("#filter-section").dxSelectBox("instance")
                                            .option({ value: null, disabled: true, dataSource: [] });
                        buildFilter();
                    }
                }).dxSelectBox("instance");

                $("#filter-dept").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Departments", showClearButton: true, disabled: true,
                    onValueChanged: function (e) {
                        const secBox = $("#filter-section").dxSelectBox("instance");
                        const divVal = divBox.option("value");
                        const q = e.value
                            ? `?filter=[["Division","=","${divVal}"],"and",["Department","=","${e.value}"]]`
                            : (divVal ? `?filter=["Division","=","${divVal}"]` : "");
                        secBox.option({
                            value: null, disabled: !e.value,
                            dataSource: e.value ? makeLookup("GetSections", q) : []
                        });
                        buildFilter();
                    }
                });

                $("#filter-section").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Sections", showClearButton: true, disabled: true,
                    onValueChanged: buildFilter
                });

                $("#btn-clear-filter").click(function () {
                    divBox.option("value", null);
                    $("#filter-dept").dxSelectBox("instance")
                                     .option({ value: null, disabled: true, dataSource: [] });
                    $("#filter-section").dxSelectBox("instance")
                                        .option({ value: null, disabled: true, dataSource: [] });
                    addGrid.clearFilter();
                });

                // ???? function confirm ??? toolbar button ??????
                confirmAddFn = function () {
                    if (selectedCodes.length === 0) {
                        DevExpress.ui.notify("Please select at least one student.", "warning", 3000);
                        return;
                    }
                    $.ajax({
                        url: `${serviceUrl}/StudentGroups/${GROUP_ID}/members`,
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify({ studentCodes: selectedCodes }),
                        xhrFields: { withCredentials: true }
                    }).done(function () {
                        DevExpress.ui.notify("Members added successfully.", "success", 3000);
                        addPopup.hide();
                        loadGroupDetail();
                    }).fail(function (err) {
                        DevExpress.ui.notify(
                            "Error: " + (err.responseJSON?.message || "Failed to add"),
                            "error", 4000
                        );
                    });
                };
            },
            toolbarItems: [
                {
                    toolbar: "bottom", location: "before",
                    template: () => $(`
                        <div id="add-hint" class="text-muted small fw-medium ps-1 d-flex align-items-center">
                            <i class="fas fa-info-circle text-primary me-1"></i> Check the rows to add.
                        </div>`)
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => addPopup.hide()
                    }
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Add to Group", type: "default", stylingMode: "contained",
                        elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                        onClick: () => confirmAddFn && confirmAddFn()
                    }
                }
            ]
        }).dxPopup("instance");

        // ?? Open Add Members Popup ??
        $("#btn-add-members").click(() => addPopup.show());

        // ?? Assign Course Popup ??
        let selectedCourseIds = [];

        const assignCoursePopup = $("#popup-assign-course").dxPopup({
            title: "Assign Course to Group",
            width: "90vw", maxWidth: 1200, height: "85vh",
            showCloseButton: true, dragEnabled: true,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            contentTemplate: function (contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div style="width:260px; flex-shrink:0;">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Course Type</label>
                                    <div id="ac-filter-type"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="ac-filter-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Category</label>
                                    <div id="ac-filter-cat"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="ac-btn-clear-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column" style="min-width:0;">
                            <div id="ac-grid-courses" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                let allCoursesData = [];

                const courseGrid = $("#ac-grid-courses").dxDataGrid({
                    dataSource: [],
                    showBorders: false, showRowLines: true, rowAlternationEnabled: true,
                    hoverStateEnabled: true,
                    filterRow: { visible: true },
                    searchPanel: { visible: true, placeholder: "Search code or title...", width: 250 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    scrolling: { mode: "virtual" },
                    height: "100%",
                    noDataText: "No courses found.",
                    columns: [
                        {
                            dataField: "code", caption: "Code", width: 110,
                            cellTemplate: (c, o) =>
                                $('<span>').addClass('tag-pill pill-default fw-bold').text(o.value).appendTo(c)
                        },
                        { dataField: "title", caption: "Course Title", minWidth: 180 },
                        {
                            dataField: "courseTypeName", caption: "Type", width: 130, alignment: "center",
                            cellTemplate: (c, o) => {
                                if (!o.value) return;
                                $('<span>').addClass('tag-pill pill-info').text(o.value).appendTo(c);
                            }
                        }
                    ],
                    onSelectionChanged: function (e) {
                        selectedCourseIds = e.selectedRowKeys;
                        $("#ac-selection-hint").html(
                            selectedCourseIds.length > 0
                                ? `<i class="fas fa-check-circle text-success me-1"></i> <b>${selectedCourseIds.length}</b> course(s) selected.`
                                : `<i class="fas fa-info-circle text-primary me-1"></i> Check the rows you want to assign.`
                        );
                    }
                }).dxDataGrid("instance");

                $.ajax({
                    url: `${serviceUrl}/Assignments/lookup-courses`,
                    method: "GET", xhrFields: { withCredentials: true }
                }).done(function (res) {
                    allCoursesData = res.data || [];
                    courseGrid.option("dataSource", new DevExpress.data.DataSource({
                        store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                    }));
                });

                function applyFilters() {
                    const typeVal = $("#ac-filter-type").dxSelectBox("instance").option("value");
                    const divVal  = $("#ac-filter-div").dxSelectBox("instance").option("value");
                    const catVal  = $("#ac-filter-cat").dxSelectBox("instance").option("value");
                    const conds = [];
                    if (typeVal) conds.push(["courseTypeId", "=", typeVal]);
                    if (divVal)  conds.push(["divisionId",   "=", divVal]);
                    if (catVal)  conds.push(["categoryId",   "=", catVal]);
                    if (!conds.length) { courseGrid.clearFilter(); return; }
                    let f = conds[0];
                    for (let i = 1; i < conds.length; i++) f = [f, "and", conds[i]];
                    courseGrid.filter(f);
                }

                $("#ac-filter-type").dxSelectBox({
                    dataSource: createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' }),
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Types", showClearButton: true,
                    onValueChanged: applyFilters
                });

                $("#ac-filter-div").dxSelectBox({
                    dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' }),
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Divisions", showClearButton: true,
                    onValueChanged: function (e) {
                        const catBox = $("#ac-filter-cat").dxSelectBox("instance");
                        catBox.option("value", null);
                        if (e.value) {
                            catBox.option("dataSource", createDataStore(serviceUrl, 'admin/CategoriesCRUD', {
                                key: 'id', action: 'Get', filter: ["divisionId", "=", e.value]
                            }));
                            catBox.option("disabled", false);
                        } else {
                            catBox.option({ dataSource: [], disabled: true });
                        }
                        applyFilters();
                    }
                });

                $("#ac-filter-cat").dxSelectBox({
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Categories", showClearButton: true, disabled: true,
                    onValueChanged: applyFilters
                });

                $("#ac-btn-clear-filter").click(function () {
                    $("#ac-filter-type").dxSelectBox("instance").option("value", null);
                    $("#ac-filter-div").dxSelectBox("instance").option("value", null);
                    $("#ac-filter-cat").dxSelectBox("instance").option({ value: null, disabled: true, dataSource: [] });
                    courseGrid.clearFilter();
                });
            },
            toolbarItems: [
                {
                    toolbar: "bottom", location: "before",
                    template: () => $(`<div id="ac-selection-hint" class="text-muted small fw-medium ps-1 d-flex align-items-center"><i class="fas fa-info-circle text-primary me-1"></i> Check the rows you want to assign.</div>`)
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => assignCoursePopup.hide()
                    }
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Next: Set Details", type: "default", stylingMode: "contained",
                        elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                        onClick: () => openAssignDetailsPopup()
                    }
                }
            ]
        }).dxPopup("instance");

        $("#btn-assign-course").click(function () {
            selectedCourseIds = [];
            assignCoursePopup.show();
        });

        // ?? Assign Details Popup (description + dates) ??
        const assignDetailsPopup = $("<div id='popup-assign-details'>").appendTo("body").dxPopup({
            title: "Assignment Details",
            width: 500, height: "auto",
            showCloseButton: true, dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            contentTemplate: function (contentElement) {
                $(`<div id="form-assign-details" class="px-1 pt-2"></div>`).appendTo(contentElement);
                $("#form-assign-details").dxForm({
                    labelMode: "floating",
                    formData: { description: "", startDate: null, dueDate: null },
                    items: [
                        {
                            dataField: "description",
                            label: { text: "Description" },
                            editorType: "dxTextArea",
                            editorOptions: { height: 100 },
                            validationRules: [{ type: "required", message: "Required" }]
                        },
                        {
                            itemType: "group", colCount: 2,
                            items: [
                                {
                                    dataField: "startDate",
                                    label: { text: "Start Date" },
                                    editorType: "dxDateBox",
                                    editorOptions: { displayFormat: "dd/MM/yyyy", width: "100%" },
                                    validationRules: [{ type: "required", message: "Required" }]
                                },
                                {
                                    dataField: "dueDate",
                                    label: { text: "Due Date" },
                                    editorType: "dxDateBox",
                                    editorOptions: { displayFormat: "dd/MM/yyyy", width: "100%" },
                                    validationRules: [{ type: "required", message: "Required" }]
                                }
                            ]
                        }
                    ]
                });
            },
            toolbarItems: [
                {
                    toolbar: "bottom", location: "before",
                    template: () => $(`
                        <div class="text-muted small d-flex align-items-center gap-1">
                            <i class="fas fa-book-open text-primary"></i>
                            <span id="ad-course-count" class="fw-bold text-dark"></span>
                            <span class="text-muted">course(s) selected</span>
                        </div>`)
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Back", stylingMode: "outlined",
                        onClick: () => { assignDetailsPopup.hide(); assignCoursePopup.show(); }
                    }
                },
                {
                    widget: "dxButton", toolbar: "bottom", location: "after",
                    options: {
                        text: "Assign", type: "default", stylingMode: "contained",
                        elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                        onClick: () => submitGroupAssign()
                    }
                }
            ]
        }).dxPopup("instance");

        function openAssignDetailsPopup() {
            if (selectedCourseIds.length === 0) {
                DevExpress.ui.notify("Please select at least one course.", "warning", 3000);
                return;
            }
            $("#ad-course-count").text(selectedCourseIds.length);
            $("#form-assign-details").dxForm("instance").option("formData", {
                description: "", startDate: null, dueDate: null
            });
            assignCoursePopup.hide();
            assignDetailsPopup.show();
        }

        function submitGroupAssign() {
            const form = $("#form-assign-details").dxForm("instance");
            if (!form.validate().isValid) return;
            const fd = form.option("formData");

            const payload = {
                groupId: GROUP_ID,
                courseIds: selectedCourseIds,
                description: fd.description,
                startDate: fd.startDate,
                dueDate: fd.dueDate,
                employeeCodes: []
            };

            $.ajax({
                url: `${serviceUrl}/Assignments/validate-before-assign`,
                method: "POST", contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            }).done(function (res) {
                const memberCount = res.resolvedCount || 0;
                const conflictCount = res.conflicts?.length || 0;
                const conflictNote = conflictCount > 0
                    ? `<br><small class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>${conflictCount} existing enrollment(s) will get a new attempt</small>`
                    : `<br><small class="text-success"><i class="fas fa-check-circle me-1"></i>No conflicts found</small>`;

                assignDetailsPopup.hide();

                DevExpress.ui.dialog.confirm(
                    `Assign <b>${selectedCourseIds.length}</b> course(s) to <b>${memberCount}</b> member(s)?${conflictNote}`,
                    "Confirm Assignment"
                ).then(function (confirmed) {
                    if (!confirmed) return;
                    $.ajax({
                        url: `${serviceUrl}/Enrollments/BulkAssign`,
                        method: "POST", contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    }).done(function (res) {
                        DevExpress.ui.notify("Courses assigned successfully!", "success", 2000);
                        setTimeout(() => {
                            window.location.href = `@Url.Action("Progress", "Assignments")/${res.assignmentId}`;
                        }, 1500);
                    }).fail(function (err) {
                        DevExpress.ui.notify("Error: " + (err.responseJSON?.message || "Failed to assign"), "error", 4000);
                    });
                });
            }).fail(function (err) {
                assignDetailsPopup.hide();
                DevExpress.ui.notify("Validation error: " + (err.responseJSON?.message || "Failed"), "error", 4000);
            });
        }

        // ?? Remove Member ??
        window.confirmRemoveMember = function (data) {
            DevExpress.ui.dialog.confirm(
                `Remove <b>${data.studentName || data.studentCode}</b> from this group?`,
                "Confirm Remove"
            ).then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: `${serviceUrl}/StudentGroups/${GROUP_ID}/members/${data.id}`,
                    method: "DELETE",
                    xhrFields: { withCredentials: true }
                }).done(function () {
                    DevExpress.ui.notify("Member removed.", "success", 3000);
                    loadGroupDetail();
                }).fail(function () {
                    DevExpress.ui.notify("Failed to remove member.", "error", 3000);
                });
            });
        };
    });

    // ?? Load group + members ??
    function loadGroupDetail() {
        $.ajax({
            url: `${serviceUrl}/StudentGroups/${GROUP_ID}`,
            method: "GET",
            xhrFields: { withCredentials: true }
        }).done(function (res) {
            const g = res.data;
            if (!g) return;
            const members = g.members || [];

            $("#page-title").text(g.name);
            $("#page-subtitle").text(g.description || "No description");
            $("#info-name").text(g.name);
            $("#info-desc").text(g.description || "No description");
            $("#info-count").text(members.length);
            $("#tab-badge-members").text(members.length);

            membersGrid.option("dataSource", members);
        }).fail(function () {
            DevExpress.ui.notify("Error loading group detail.", "error", 3000);
        });
    }

    // ?? Tab Switch ??
    function switchTab(tab, btn) {
        ["members", "assignments"].forEach(t => {
            const b = document.getElementById(`tab-btn-${t}`);
            b.style.color        = "var(--text-secondary)";
            b.style.borderBottom = "2px solid transparent";
        });
        btn.style.color        = "var(--accent-color)";
        btn.style.borderBottom = "2px solid var(--accent-color)";
        document.getElementById("panel-members").style.display     = tab === "members"     ? "" : "none";
        document.getElementById("panel-assignments").style.display = tab === "assignments" ? "" : "none";
        if (tab === "assignments" && !assignmentHistoryLoaded) loadAssignmentHistory();
    }

    // ?? Assignment History Grid ??
    let assignmentHistoryLoaded = false;

    const assignmentGrid = initDxGrid("#grid-assignments", {
        dataSource: [],
        showBorders: false, showRowLines: true, hoverStateEnabled: true,
        searchPanel: { visible: true, placeholder: "Search assignments..." },
        onRowPrepared: function (e) {
            if (e.rowType !== "data") return;
            if (e.data.status === "Expired")   $(e.rowElement).css("background-color", "#fff2f0");
            if (e.data.status === "Completed") $(e.rowElement).css("background-color", "#f6ffed");
        },
        columns: [
            {
                dataField: "assignmentNo", caption: "Assignment No", width: 150,
                sortOrder: "desc", alignment: "center",
                cellTemplate: (c, o) =>
                    $("<span>").css({ fontSize: "12px", fontWeight: "700", color: "var(--text-primary)" })
                               .text(o.value || "—").appendTo(c)
            },
            {
                dataField: "courseNames", caption: "Courses", minWidth: 200,
                cellTemplate: function (c, o) {
                    const courses = (o.value || "").split(", ").filter(x => x.trim());
                    if (!courses.length) { $("<span>").css("color","var(--text-secondary)").text("—").appendTo(c); return; }
                    const wrap = $("<div>").addClass("d-flex flex-wrap gap-1").appendTo(c);
                    courses.slice(0, 2).forEach(n =>
                        $("<span>").addClass("tag-pill pill-default").css("font-size","10px").text(n).appendTo(wrap)
                    );
                    if (courses.length > 2)
                        $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                   .text(`+${courses.length - 2} more`).appendTo(wrap);
                }
            },
            {
                dataField: "description", caption: "Description", minWidth: 160,
                cellTemplate: (c, o) => {
                    const t = o.value || "—";
                    $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                               .text(t.length > 50 ? t.slice(0, 50) + "…" : t)
                               .attr("title", t).appendTo(c);
                }
            },
            {
                dataField: "completionPct", caption: "Progress", width: 140, alignment: "center",
                cellTemplate: (c, o) => {
                    const pct   = o.value || 0;
                    const color = pct === 100 ? "var(--success-color)"
                                : pct >= 50  ? "var(--accent-color)"
                                :               "var(--warning-color)";
                    $("<div>").addClass("d-flex align-items-center gap-2")
                        .append(
                            $("<div>").css({ flex: "1", height: "3px", background: "var(--border-color)",
                                             borderRadius: "2px", overflow: "hidden" })
                                .append($("<div>").css({ height: "100%", width: pct + "%", background: color }))
                        )
                        .append(
                            $("<span>").css({ fontSize: "11px", fontWeight: "600",
                                              minWidth: "32px", color: "var(--text-secondary)" })
                                       .text(pct + "%")
                        )
                        .appendTo(c);
                }
            },
            {
                dataField: "status", caption: "Status", width: 120, alignment: "center",
                cellTemplate: (c, o) => {
                    const map = {
                        "Completed":  { cls: "pill-success", text: "Completed"   },
                        "Upcoming":   { cls: "pill-warning",  text: "Upcoming"    },
                        "Expired":    { cls: "pill-danger",   text: "Expired"     },
                        "InProgress": { cls: "pill-info",     text: "In Progress" }
                    };
                    const s = map[o.value] ?? { cls: "pill-default", text: o.value || "—" };
                    $(`<span class="status-pill ${s.cls}">${s.text}</span>`).appendTo(c);
                }
            },
            {
                dataField: "startDate", caption: "Start", width: 100, alignment: "center",
                cellTemplate: (c, o) =>
                    $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                               .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                               .appendTo(c)
            },
            {
                dataField: "dueDate", caption: "Due", width: 100, alignment: "center",
                cellTemplate: (c, o) => {
                    if (!o.value) { $("<span>").css("color","var(--text-secondary)").text("—").appendTo(c); return; }
                    const isPast = new Date(o.value) < new Date();
                    $("<span>").css({ fontSize: "11px",
                                      color: isPast ? "var(--danger-color)" : "var(--text-secondary)",
                                      fontWeight: isPast ? "600" : "400" })
                               .text(new Date(o.value).toLocaleDateString("en-GB")).appendTo(c);
                }
            },
            {
                type: "buttons", caption: "Actions", width: 70,
                alignment: "center", fixed: true, fixedPosition: "right",
                buttons: [{
                    hint: "View Dashboard", icon: "info",
                    onClick: e => window.location.href =
                        `@Url.Action("Progress", "Assignments")/${e.row.data.id}`
                }]
            }
        ]
    });

    function loadAssignmentHistory() {
        $.ajax({
            url: `${serviceUrl}/Assignments/group/${GROUP_ID}/history`,
            method: "GET",
            xhrFields: { withCredentials: true }
        }).done(function (res) {
            const data = res.data || [];
            assignmentHistoryLoaded = true;
            const completedCount = data.filter(d => d.status === "Completed").length;
            $("#kpi-assignment-count").text(data.length);
            $("#kpi-completed-count").text(completedCount);
            $("#tab-badge-assignments").text(data.length);
            assignmentGrid.option("dataSource", data);
        }).fail(function () {
            DevExpress.ui.notify("Error loading assignment history.", "error", 3000);
        });
    }
</script>
}
