@{
    ViewBag.Title = "Student Group";
    var groupId = ViewBag.GroupId is int gid ? gid : 0;
    var studentReportUrlTemplate = Url.Content("~/Students/Report/__STUDENT_CODE__");
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title" id="page-title">Student Group</h1>
        <div class="page-subtitle" id="page-subtitle">Loading...</div>
    </div>
    <a href="@Url.Action("Index", "StudentGroups")" class="action-link">
        <i class="fas fa-arrow-left text-secondary" aria-hidden="true"></i> Back
    </a>
</div>

<div class="container-fluid page-shell-lg px-4 py-4">

    <div class="row g-3 mb-4 flex-shrink-0">

        <!-- Group Overview -->
        <div class="col-lg-9">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="admin-section-header mb-3">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Info & Summary</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>

                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-members">0</div>
                            <div class="stat-label">Members</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-assignments">0</div>
                            <div class="stat-label">Assignments</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-success" id="stat-completed">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-warning" id="stat-inprogress">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <div class="admin-meta-item">
                            <div class="admin-meta-label">Group Name</div>
                            <div class="admin-meta-value fw-bold" id="summary-name">—</div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-7">
                        <div class="admin-meta-item h-100">
                            <div class="admin-meta-label">Description</div>
                            <div class="admin-meta-value u-whitespace-normal lh-base" id="summary-description">—</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="admin-meta-item h-100">
                            <div class="admin-meta-label">Members</div>
                            <div class="admin-meta-value">
                                <span class="tag-pill pill-primary" id="summary-member-count">0 members</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="admin-meta-item h-100">
                            <div class="admin-meta-label">Created By</div>
                            <div class="admin-meta-value" id="summary-created-by">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="@Url.Action("AddMembers", "StudentGroups", new { id = groupId })" id="btn-add-members" class="quick-action disabled" aria-disabled="true" tabindex="-1">
                        <div class="qa-icon qa-icon-success"><i id="add-members-icon" class="fas fa-user-plus" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold" id="add-members-text">Add Members</div>
                            <div class="u-fs-11 text-secondary">Add learners to this group</div>
                        </div>
                    </a>

                    <a href="@Url.Action("BulkAssign", "Assignments")?groupId=@groupId" id="btn-assign-course" class="quick-action disabled" aria-disabled="true" tabindex="-1">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-book-open" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Assign Course</div>
                            <div class="u-fs-11 text-secondary">Assign courses to this group</div>
                        </div>
                    </a>

                    <button type="button" id="btn-edit-group" class="quick-action disabled" aria-disabled="true" tabindex="-1" disabled>
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Edit Student Group</div>
                            <div class="u-fs-11 text-secondary">Change name or description</div>
                        </div>
                    </button>

                    <button type="button" id="btn-delete-group" class="quick-action danger disabled" aria-disabled="true" tabindex="-1" disabled>
                        <div class="qa-icon qa-icon-danger"><i id="delete-group-icon" class="fas fa-trash-alt" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold" id="delete-group-text">Delete Student Group</div>
                            <div class="u-fs-11 text-secondary">Delete this group and its members</div>
                        </div>
                    </button>

                </div>
            </div>
        </div>

    </div>

    <!-- ── Tabs ── -->
    <div class="border rounded bg-white flex-grow-1 d-flex flex-column u-min-h-0">
        <div class="d-flex border-bottom px-1 flex-shrink-0">
            <button id="tab-btn-members" onclick="switchTab('members', this)" class="tab-btn active">
                <i class="fas fa-users me-1" aria-hidden="true"></i> Members
                <span class="tag-pill tag-pill-xs pill-default ms-1" id="tab-badge-members">0</span>
            </button>
            <button id="tab-btn-assignments" onclick="switchTab('assignments', this)" class="tab-btn">
                <i class="fas fa-tasks me-1" aria-hidden="true"></i> Assignment History
                <span class="tag-pill tag-pill-xs pill-default ms-1" id="tab-badge-assignments">0</span>
            </button>
        </div>
        <div id="panel-members" class="flex-grow-1 u-min-h-0">
            <div id="grid-members" class="h-100"></div>
        </div>
        <div id="panel-assignments" class="d-none flex-grow-1 u-min-h-0">
            <div id="grid-assignments" class="h-100"></div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const GROUP_ID = @groupId;
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const ASSIGNMENT_DETAIL_URL = '@Url.Action("Detail", "Assignments")';
    const STUDENT_REPORT_URL_TEMPLATE = '@studentReportUrlTemplate';
    const ADD_MEMBERS_URL = '@Url.Action("AddMembers", "StudentGroups", new { id = groupId })';
    const INDEX_URL = '@Url.Action("Index", "StudentGroups")';
    const EMPTY_TEXT = "—";
    const HAS_VALID_GROUP_ID = GROUP_ID > 0;
    const DESCRIPTION_FIELD_HEIGHT = 120;

    let membersGrid;
    let assignmentGrid;
    let currentGroup = null;

    $(() => {
        membersGrid = initDxGrid("#grid-members", {
            preset: "compactGrid",
            dataSource: [],
            searchPanel: { placeholder: "Search by ID or name..." },
            columns: [
                {
                    dataField: "studentCode", caption: "Employee ID", width: 130,
                    cellTemplate: function(container, options) {
                        $("<a>")
                            .attr("href", STUDENT_REPORT_URL_TEMPLATE.replace("__STUDENT_CODE__", encodeURIComponent(options.value || "")))
                            .attr("target", "_blank")
                            .css(window.getAdminGridTextStyle("captionStrong"))
                            .text(options.value || EMPTY_TEXT)
                            .appendTo(container);
                    }
                },
                {
                    dataField: "studentName", caption: "Full Name", minWidth: 180,
                    cssClass: "fw-medium text-dark",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    dataField: "division", caption: "Division", width: 130,
                    cssClass: "cell-secondary",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    dataField: "department", caption: "Department", width: 130,
                    cssClass: "cell-secondary",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    dataField: "section", caption: "Section", minWidth: 130,
                    cssClass: "cell-secondary",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    dataField: "position", caption: "Position", width: 110, alignment: "center",
                    cssClass: "cell-muted",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    type: "buttons", caption: "Actions", width: 90,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [{
                        hint: "Remove from student group", icon: "remove",
                        onClick: e => confirmRemoveMember(e.row.data)
                    }]
                }
            ]
        });

        assignmentGrid = initDxGrid("#grid-assignments", {
            preset: "compactGrid",
            dataSource: [],
            searchPanel: { placeholder: "Search assignments..." },
            onRowPrepared: function(e) {
                if (e.rowType !== "data") {
                    return;
                }

                if (e.data.status === "Expired") {
                    $(e.rowElement).css("background-color", "var(--surface-danger-subtle)");
                }

                if (e.data.status === "Completed") {
                    $(e.rowElement).css("background-color", "var(--surface-success-subtle)");
                }
            },
            columns: [
                {
                    dataField: "assignmentNo", caption: "Assignment No", width: 150,
                    sortOrder: "desc", alignment: "center",
                    cssClass: "cell-bold",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                {
                    dataField: "courseNames", caption: "Courses", minWidth: 200,
                    cellTemplate: function(container, options) {
                        renderCoursesCell(container, options.value);
                    }
                },
                {
                    dataField: "description", caption: "Description", minWidth: 160,
                    cellTemplate: function(container, options) {
                        window.renderAdminGridTruncatedTextCell(container, options.value, 50, "captionMuted");
                    }
                },
                {
                    dataField: "completionPct", caption: "Progress", width: 140, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderProgressCell(container, options.value);
                    }
                },
                {
                    dataField: "status", caption: "Status", width: 120, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderStatusCell(container, options.value, {
                            Completed: { tone: "success", text: "Completed" },
                            Upcoming: { tone: "warning", text: "Upcoming" },
                            Expired: { tone: "danger", text: "Expired" },
                            InProgress: { tone: "primary", text: "In Progress" }
                        });
                    }
                },
                {
                    dataField: "startDate", caption: "Start", width: 100, alignment: "center",
                    dataType: "date",
                    format: ADMIN_DATE_DISPLAY_FORMAT,
                    cssClass: "cell-caption"
                },
                {
                    dataField: "dueDate", caption: "Due", width: 100, alignment: "center",
                    cellTemplate: function(container, options) {
                        renderDueDateCell(container, options.value);
                    }
                },
                {
                    type: "buttons", caption: "Actions", width: 70,
                    alignment: "center", fixed: true, fixedPosition: "right",
                    buttons: [{
                        hint: "View Dashboard",
                        icon: "info",
                        onClick: function(e) {
                            window.location.href = `${ASSIGNMENT_DETAIL_URL}/${e.row.data.id}`;
                        }
                    }]
                }
            ]
        });

        setActionPanelState(!HAS_VALID_GROUP_ID);

        if (!HAS_VALID_GROUP_ID) {
            $("#page-subtitle").text("Student group is unavailable.");
            showToast("Student group is unavailable.", "warning");
            return;
        }

        loadGroupDetail();

        $("#btn-add-members").click(function(event) {
            event.preventDefault();
            window.location.href = ADD_MEMBERS_URL;
        });

        $("#btn-edit-group").click(function(event) {
            event.preventDefault();
            if ($(this).hasClass("disabled")) {
                return;
            }

            openEditGroupDialog();
        });

        window.confirmRemoveMember = function (data) {
            showStudentGroupConfirmDialog({
                title: "Confirm Remove",
                messageHtml: `Remove <b>${data.studentName || data.studentCode}</b> from this student group?`,
                confirmButtonText: "Remove",
                confirmType: "danger",
                icon: "warning"
            }).done(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${GROUP_ID}/members/${data.id}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Member removed.", "success");
                    loadGroupDetail();
                } catch (err) {
                    showToast(getApiErrorMessage(err, "Failed to remove member."), "error");
                }
            });
        };

        $("#btn-delete-group").click(function () {
            showStudentGroupConfirmDialog({
                title: "Confirm Delete",
                messageHtml: `<b>Delete this student group?</b><br>
                 <small class="text-muted">All members in this student group will also be removed.</small>`,
                confirmButtonText: "Delete",
                confirmType: "danger",
                icon: "warning"
            }).done(async function (confirmed) {
                if (!confirmed) {
                    return;
                }

                setActionPanelState(true);
                setQuickActionLoadingState($("#btn-delete-group"), true, {
                    iconSelector: "#delete-group-icon",
                    textSelector: "#delete-group-text",
                    loadingText: "Deleting..."
                });

                try {
                    await $.ajax({
                        url: `${GROUPS_API_URL}/${GROUP_ID}`,
                        method: "DELETE",
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Student group deleted.", "success");
                    window.location.href = INDEX_URL;
                } catch (err) {
                    setActionPanelState(false);
                    setQuickActionLoadingState($("#btn-delete-group"), false, {
                        iconSelector: "#delete-group-icon",
                        textSelector: "#delete-group-text"
                    });
                    showToast(getApiErrorMessage(err, "Failed to delete student group."), "error");
                }
            });
        });
    });

    async function loadGroupDetail() {
        try {
            const res = await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            const g = res.data;
            if (!g) {
                return;
            }

            currentGroup = g;

            const members = g.members || [];

            $("#page-title").text(g.name);
            $("#page-subtitle").text(g.description || "No description");
            $("#tab-badge-members").text(members.length);

            // Group Info panel
            $("#summary-name").text(g.name || EMPTY_TEXT);
            $("#summary-description").text(g.description || "No description");
            $("#summary-member-count").text(window.formatAdminCountLabel(members.length, 'member'));
            $("#summary-created-by").text(g.createdBy || EMPTY_TEXT);

            // Stat: Members
            $("#stat-total-members").text(members.length);

            setActionPanelState(false);
            membersGrid.option("dataSource", members);
            loadAssignmentHistory();
        } catch (error) {
            console.error('[loadGroupDetail] API Error:', {
                status: error?.status,
                statusText: error?.statusText,
                responseText: error?.responseText,
                responseJSON: error?.responseJSON,
                url: `${GROUPS_API_URL}/${GROUP_ID}`,
                groupId: GROUP_ID
            });

            setActionPanelState(true);
            const errorMsg = getApiErrorMessage(error, "Error loading group detail.");
            showToast(errorMsg, "error");
        }
    }

    function setActionPanelState(disabled) {
        setQuickActionState($("#btn-add-members"), disabled);
        setQuickActionState($("#btn-assign-course"), disabled);
        setQuickActionState($("#btn-edit-group"), disabled);
        setQuickActionState($("#btn-delete-group"), disabled);
    }

    function setQuickActionState($element, disabled) {
        $element
            .toggleClass("disabled", disabled)
            .attr("aria-disabled", disabled ? "true" : "false")
            .attr("tabindex", disabled ? "-1" : "0")
            .prop("disabled", disabled);
    }

    function openEditGroupDialog() {
        if (!currentGroup) {
            showToast("Student group details are still loading.", "warning", 2500);
            return;
        }

        const dialogId = `edit-student-group-dialog-${Date.now()}`;
        const formId = `${dialogId}-form`;
        const cancelId = `${dialogId}-cancel`;
        const confirmId = `${dialogId}-confirm`;

        const dialog = DevExpress.ui.dialog.custom({
            title: "Edit Student Group",
            messageHtml: `
                <div id="${dialogId}" class="pt-2 text-start">
              
                    <div id="${formId}"></div>
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <div id="${cancelId}"></div>
                        <div id="${confirmId}"></div>
                    </div>
                </div>`,
            buttons: [],
            dragEnabled: false,
            closeOnOutsideClick: false,
            showCloseButton: true,
            width: 520
        });

        dialog.show();

        window.setTimeout(function() {
            const $formHost = $("#" + formId);
            if (!$formHost.length) {
                return;
            }

            const groupForm = $formHost.dxForm({
                labelMode: "floating",
                stylingMode: "outlined",
                colCount: 1,
                formData: {
                    name: currentGroup.name || "",
                    description: currentGroup.description || ""
                },
                items: [
                    {
                        dataField: "name",
                        label: { text: "Group Name" },
                        editorOptions: {
                            placeholder: "e.g. New Hires 2026 Q1"
                        },
                        validationRules: [
                            { type: "required", message: "Group name is required" },
                            { type: "stringLength", max: 200, message: "Max 200 characters" }
                        ]
                    },
                    {
                        dataField: "description",
                        label: { text: "Description (optional)" },
                        editorType: "dxTextArea",
                        editorOptions: {
                            height: DESCRIPTION_FIELD_HEIGHT,
                            placeholder: "Brief description of this group's purpose"
                        }
                    }
                ]
            }).dxForm("instance");

            const cancelButton = $("#" + cancelId).dxButton({
                text: "Cancel",
                stylingMode: "outlined",
                onClick: function() {
                    dialog.hide();
                }
            }).dxButton("instance");

            const confirmButton = $("#" + confirmId).dxButton({
                text: "Save Changes",
                type: "default",
                stylingMode: "contained",
                onClick: async function() {
                    if (!groupForm.validate().isValid) {
                        return;
                    }

                    const formData = groupForm.option("formData");
                    confirmButton.option({ text: "Saving...", disabled: true });
                    cancelButton.option("disabled", true);

                    try {
                        await $.ajax({
                            url: `${GROUPS_API_URL}/${GROUP_ID}`,
                            method: "PUT",
                            contentType: "application/json",
                            data: JSON.stringify(formData),
                            xhrFields: { withCredentials: true }
                        });

                        currentGroup = {
                            ...currentGroup,
                            ...formData
                        };
                        dialog.hide();
                        showToast("Student group updated successfully.", "success");
                        await loadGroupDetail();
                    } catch (error) {
                        confirmButton.option({ text: "Save Changes", disabled: false });
                        cancelButton.option("disabled", false);
                        showToast(getApiErrorMessage(error, "Failed to save student group."), "error");
                    }
                }
            }).dxButton("instance");
        }, 0);
    }

    function showStudentGroupConfirmDialog(options) {
        return showAdminConfirmDialog({
            title: options.title,
            messageHtml: options.messageHtml,
            text: options.text,
            icon: options.icon || "warning",
            confirmButtonText: options.confirmButtonText || "Confirm",
            cancelButtonText: options.cancelButtonText || "Cancel",
            confirmType: options.confirmType || "default"
        });
    }

    function setQuickActionLoadingState($element, isLoading, options) {
        if (!$element || !$element.length) {
            return;
        }

        const settings = options || {};
        const $icon = settings.iconSelector ? $(settings.iconSelector) : $element.find(".qa-icon i").first();
        const $text = settings.textSelector ? $(settings.textSelector) : $element.find(".u-fw-semibold").first();

        $element.toggleClass("disabled", isLoading).attr("aria-disabled", isLoading ? "true" : "false");

        if ($icon.length) {
            if (isLoading) {
                $icon.data("original-class", $icon.attr("class") || "");
                $icon.attr("class", "fas fa-spinner fa-spin");
            } else {
                $icon.attr("class", $icon.data("original-class") || "fas fa-spinner fa-spin");
            }
        }

        if ($text.length) {
            if (isLoading) {
                $text.data("original-text", $text.text());
                $text.text(settings.loadingText || "Processing...");
            } else {
                $text.text($text.data("original-text") || $text.text());
            }
        }
    }

    function switchTab(tab, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.getElementById("panel-members").classList.toggle("d-none", tab !== "members");
        document.getElementById("panel-assignments").classList.toggle("d-none", tab !== "assignments");

        if (tab === "assignments" && assignmentGrid) {
            assignmentGrid.updateDimensions();
        }
    }

    async function loadAssignmentHistory() {
        try {
            const res = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/group/${GROUP_ID}/history`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            const data = res.data || [];
            $("#tab-badge-assignments").text(data.length);
            assignmentGrid.option("dataSource", data);

            updateAssignmentStats(data);
        } catch (error) {
            console.error('[loadAssignmentHistory] API Error:', {
                status: error?.status,
                statusText: error?.statusText,
                responseText: error?.responseText,
                responseJSON: error?.responseJSON,
                url: `${ASSIGNMENTS_API_URL}/group/${GROUP_ID}/history`,
                groupId: GROUP_ID
            });

            showToast(getApiErrorMessage(error, "Error loading assignment history."), "error");
        }
    }

    function updateAssignmentStats(assignments) {
        const total = assignments.length;
        let completed = 0;
        let inProgress = 0;
        assignments.forEach(function(a) {
            switch (a.status) {
                case "Completed": completed++; break;
                case "InProgress": inProgress++; break;
            }
        });

        $("#stat-total-assignments").text(total);
        $("#stat-completed").text(completed);
        $("#stat-inprogress").text(inProgress);
    }

    function appendText(container, text, styles) {
        return appendAdminText(container, text, styles);
    }

    function formatDate(value) {
        return window.formatAdminDate(value, EMPTY_TEXT);
    }

    function truncateText(text, maxLength) {
        return truncateAdminText(text, maxLength);
    }

    function renderProgressCell(container, value) {
        renderAdminProgressCell(container, value);
    }

    function renderStatusCell(container, value, map) {
        renderAdminStatusCell(container, value, map);
    }

    function renderDueDateCell(container, value) {
        renderAdminDueDateCell(container, value);
    }

    function renderCoursesCell(container, value) {
        renderAdminCoursesCell(container, value, { maxVisible: 2 });
    }

    function getApiErrorMessage(error, fallbackMessage) {
        return window.getApiErrorMessage(error, fallbackMessage);
    }
</script>
}
