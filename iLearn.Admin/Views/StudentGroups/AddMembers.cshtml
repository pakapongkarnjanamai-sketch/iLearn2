@{
    ViewBag.Title = "Add Members";
    var groupId = ViewBag.GroupId is int gid ? gid : 0;
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    /* ── Unique: Assignment status option cards ── */
    .sg-status-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .sg-status-option {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        padding: 10px;
        background: var(--surface-base);
    }

    .sg-status-option.disabled {
        background: var(--surface-subtle);
        color: var(--text-secondary);
    }

    .sg-status-option label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0;
        cursor: pointer;
    }

    .sg-status-option .form-check-input {
        margin-top: 0;
    }

    .sg-status-title {
        font-size: var(--font-size-caption);
        font-weight: 600;
        color: var(--text-primary);
    }

    .sg-status-note {
        font-size: var(--font-size-xs);
        color: var(--text-secondary);
        margin-top: 4px;
    }

    /* ── Unique: Review table scroll height ── */
    .sg-review-table-wrap {
        --admin-table-wrap-max-height: clamp(200px, calc(100vh - 520px), 320px);
    }

    @@media (max-width: 991.98px) {
        .sg-status-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-user-plus text-primary me-2" aria-hidden="true"></i>Add Members</h1>
    <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
        <div class="admin-step-card active" data-step-card="1" aria-current="step">
            <div class="admin-step-title"><span class="admin-step-index">1</span>Select</div>
        </div>
        <div class="admin-step-card" data-step-card="2">
            <div class="admin-step-title"><span class="admin-step-index">2</span>Options</div>
        </div>
        <div class="admin-step-card" data-step-card="3">
            <div class="admin-step-title"><span class="admin-step-index">3</span>Review</div>
        </div>
    </div>
    <div class="admin-page-header-actions">
        <a href="@Url.Action("Detail", "StudentGroups", new { id = groupId })" class="action-link">
            <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
        </a>
        <button type="button" id="btn-prev-step" class="action-link d-none">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
        </button>
        <button type="button" id="btn-next-step" class="action-link primary">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
        </button>
        <button type="button" id="btn-preview-summary" class="action-link primary d-none">
            <i class="fas fa-file-alt" aria-hidden="true"></i> Preview Summary
        </button>
        <button type="button" id="btn-confirm" class="action-link primary d-none">
            <i class="fas fa-check-circle" aria-hidden="true"></i> Confirm Changes
        </button>
    </div>
</div>

<div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow">
    <div id="load-panel"></div>

    <div class="admin-review-main-col">
        <div class="border rounded bg-white p-3" id="wizard-main-card">
                <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="wide">
                    <div class="admin-section-header mb-2">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Select Learners</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>
                    <div class="admin-selection-layout">
                        <div class="admin-filter-shell d-flex flex-column gap-3">
                            <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2" aria-hidden="true"></i>Filters</h6>
                            <div>
                                <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                <div id="filter-div"></div>
                            </div>
                            <div>
                                <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                <div id="filter-dept"></div>
                            </div>
                            <div>
                                <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                <div id="filter-section"></div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="btn-clear-filter" type="button">
                                <i class="fas fa-times me-1" aria-hidden="true"></i> Clear Filters
                            </button>
                        </div>
                        <div class="admin-grid-shell">
                            <div class="admin-grid-head">
                                <div class="admin-grid-title">Learner Selection</div>
                                <span class="tag-pill pill-default" id="member-selection-note">0 student</span>
                            </div>
                            <div id="grid-add-students"></div>
                            <div class="admin-selection-tray" id="selected-students-tray">
                                <div class="admin-selection-tray-label">Selected</div>
                                <div class="admin-selection-tray-chips" id="selected-students-chips"></div>
                                <button type="button" class="admin-selection-tray-clear is-disabled" id="selected-students-clear">
                                    <i class="fas fa-eraser me-1" aria-hidden="true"></i>Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="step-panel-2" class="admin-wizard-panel" data-step-layout="form">
                    <div class="admin-section-header mb-2">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Assignment Options</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>

                    <div class="admin-option-card mb-2">
                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                            <div>
                                <div class="u-fs-12 u-fw-semibold text-dark">Related Assignment Enrollment</div>
                            </div>
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" id="chk-enroll-related">
                                <label class="form-check-label u-fs-12 u-fw-semibold text-dark" for="chk-enroll-related">Enroll learners to related assignments</label>
                            </div>
                        </div>
                    </div>

                    <div id="status-options-card" class="admin-option-card is-disabled mb-2">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                            <div>
                                <div class="u-fs-12 u-fw-semibold text-dark">Assignment Status Filters</div>
                            </div>
                            <div class="tag-pill pill-default" id="selected-status-count">0 statuses selected</div>
                        </div>

                        <div class="sg-status-grid">
                            <div class="sg-status-option" data-status-option="Completed">
                                <label for="status-completed">
                                    <div>
                                        <div class="sg-status-title">Completed</div>
                                        <div class="sg-status-note">Assignments where all current learners have completed the batch.</div>
                                    </div>
                                    <input class="form-check-input sg-status-checkbox" type="checkbox" id="status-completed" value="Completed" disabled>
                                </label>
                            </div>
                            <div class="sg-status-option" data-status-option="InProgress">
                                <label for="status-inprogress">
                                    <div>
                                        <div class="sg-status-title">In Progress</div>
                                        <div class="sg-status-note">Assignments that are currently active and not yet fully completed.</div>
                                    </div>
                                    <input class="form-check-input sg-status-checkbox" type="checkbox" id="status-inprogress" value="InProgress" disabled>
                                </label>
                            </div>
                            <div class="sg-status-option" data-status-option="Upcoming">
                                <label for="status-upcoming">
                                    <div>
                                        <div class="sg-status-title">Upcoming</div>
                                        <div class="sg-status-note">Assignments with a start date in the future.</div>
                                    </div>
                                    <input class="form-check-input sg-status-checkbox" type="checkbox" id="status-upcoming" value="Upcoming" disabled>
                                </label>
                            </div>
                            <div class="sg-status-option" data-status-option="Expired">
                                <label for="status-expired">
                                    <div>
                                        <div class="sg-status-title">Expired</div>
                                        <div class="sg-status-note">Assignments whose due date has already passed.</div>
                                    </div>
                                    <input class="form-check-input sg-status-checkbox" type="checkbox" id="status-expired" value="Expired" disabled>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="admin-option-card">
                        <div class="u-fs-12 u-fw-semibold text-dark mb-3">Current Related Assignment Overview</div>
                        <div id="assignment-overview-grid" class="admin-summary-grid" style="--admin-summary-grid-cols: repeat(4, minmax(0, 1fr))"></div>
                    </div>
                </div>

                <div id="step-panel-3" class="admin-wizard-panel" data-step-layout="review">
                    <div class="admin-section-header admin-review-header">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Review And Confirm</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>

                    <div class="admin-review-stack">
                        <div id="summary-cards" class="admin-summary-grid" style="--admin-summary-grid-cols: repeat(4, minmax(0, 1fr))"></div>

                        <div class="admin-table-shell">
                            <div class="admin-table-head">
                                <div class="admin-table-title">Selected Learners</div>
                                <span class="tag-pill pill-default" id="student-summary-note"></span>
                            </div>
                            <div class="admin-table-wrap sg-review-table-wrap" id="student-summary-table"></div>
                        </div>

                        <div class="admin-table-shell">
                            <div class="admin-table-head">
                                <div class="admin-table-title">Assignment Enrollment Impact</div>
                                <span class="tag-pill pill-default" id="assignment-summary-note"></span>
                            </div>
                            <div class="admin-table-wrap sg-review-table-wrap" id="assignment-summary-table"></div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

<!-- Wizard buttons moved to page-header above. -->

@section Scripts {
<script>
    const GROUP_ID = @groupId;
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const STUDENTS_API_URL = `${serviceUrl}/Students`;
    const GROUP_DETAIL_URL = '@Url.Action("Detail", "StudentGroups", new { id = groupId })';
    const EMPTY_TEXT = "—";
    const MAX_VISIBLE_SELECTION_CHIPS = 12;

    // Height Settings
    const STUDENT_SELECTION_GRID_HEIGHT = 560;

    const wizardState = {
        currentStep: 1,
        group: null,
        relatedAssignments: [],
        preview: null
    };

    let studentsGrid = null;
    const selectedStudentCache = new Map();

    $(() => {
        if (!(GROUP_ID > 0)) {
            showToast("Student group is unavailable.", "warning");
            window.location.href = '@Url.Action("Index", "StudentGroups")';
            return;
        }

        initializeStudentGrid();
        initializeFilters();
        initializeActions();
        loadPageContext();
        updateWizardUi();
    });

    async function loadPageContext() {
        try {
            const [groupResponse, assignmentResponse] = await Promise.all([
                $.ajax({
                    url: `${GROUPS_API_URL}/${GROUP_ID}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }),
                $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/group/${GROUP_ID}/history`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                })
            ]);

            wizardState.group = groupResponse.data || null;
            wizardState.relatedAssignments = assignmentResponse.data || [];

            renderGroupSnapshot();
            renderAssignmentOverview();
        } catch (error) {
            showToast(getApiErrorMessage(error, "Failed to load student group context."), "error");
            window.location.href = GROUP_DETAIL_URL;
        }
    }

    function initializeStudentGrid() {
        studentsGrid = initDxGrid("#grid-add-students", {
            preset: "wizardSelectionContinuousGrid",
            height: STUDENT_SELECTION_GRID_HEIGHT,
            dataSource: DevExpress.data.AspNet.createStore({
                key: "EId",
                loadUrl: `${STUDENTS_API_URL}/Get`,
                onBeforeSend: function(method, options) {
                    options.xhrFields = { withCredentials: true };
                }
            }),
            noDataText: getNoDataText("students"),
            columns: [
                {
                    dataField: "EId", caption: "ID", width: 120,
                    cellTemplate: function(container, options) {
                        window.renderAdminGridTextCell(container, options.value || EMPTY_TEXT, "captionStrong");
                    }
                },
                {
                    caption: "Name", minWidth: 180,
                    calculateCellValue: function(data) {
                        return [data.EnglishFirstName, data.EnglishLastName].filter(Boolean).join(" ");
                    },
                    cssClass: "fw-medium text-dark",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                },
                { dataField: "Division", caption: "Division", width: 140 },
                { dataField: "Department", caption: "Department", width: 140 },
                {
                    dataField: "Section", caption: "Section", minWidth: 140,
                    cssClass: "cell-muted",
                    customizeText: function(e) { return e.value || EMPTY_TEXT; }
                }
            ],
            onSelectionChanged: function(event) {
                const selectedStudentCodes = (event.selectedRowKeys || []).map(String);
                (event.selectedRowsData || []).forEach(function(row) {
                    if (!row || !row.EId) {
                        return;
                    }

                    selectedStudentCache.set(String(row.EId), row);
                });

                selectedStudentCache.forEach(function(_, key) {
                    if (selectedStudentCodes.indexOf(key) === -1) {
                        selectedStudentCache.delete(key);
                    }
                });

                renderSelectedStudentsTray(selectedStudentCodes);
                updateSelectionSummary();
                invalidatePreview();
            }
        });
    }

    function renderSelectedStudentsTray(selectedStudentCodes) {
        const codes = selectedStudentCodes || [];
        const $chips = $("#selected-students-chips");
        const $clearBtn = $("#selected-students-clear");

        if (codes.length === 0) {
            $chips.html('<span class="admin-selection-tray-empty">No learners selected yet.</span>');
            $clearBtn.addClass("is-disabled").prop("disabled", true);
            return;
        }

        $clearBtn.removeClass("is-disabled").prop("disabled", false);
        const visibleCodes = codes.slice(0, MAX_VISIBLE_SELECTION_CHIPS);
        const overflowCount = Math.max(codes.length - visibleCodes.length, 0);
        const chips = visibleCodes.map(function(code) {
            const row = selectedStudentCache.get(String(code));
            const normalizedCode = String(code || "");
            const safeCode = escapeHtml(normalizedCode || EMPTY_TEXT);
            const encodedCode = encodeURIComponent(normalizedCode);
            const name = row
                ? escapeHtml([row.EnglishFirstName, row.EnglishLastName].filter(Boolean).join(" ") || "")
                : "";
            const namePart = name
                ? `<span class="admin-selection-chip-sep">·</span><span class="admin-selection-chip-name" title="${name}">${name}</span>`
                : "";

            return `<span class="admin-selection-chip">
                <span class="admin-selection-chip-key">${safeCode}</span>
                ${namePart}
                <button type="button" class="admin-selection-chip-remove" data-code="${encodedCode}" aria-label="Remove ${safeCode}"><i class="fas fa-times" aria-hidden="true"></i></button>
            </span>`;
        });

        if (overflowCount > 0) {
            chips.push(`<span class="admin-selection-chip is-overflow">+${overflowCount} more</span>`);
        }

        $chips.html(chips.join(""));
        $chips.off("click", ".admin-selection-chip-remove").on("click", ".admin-selection-chip-remove", function() {
            const code = decodeURIComponent(String($(this).attr("data-code") || ""));
            if (!code || !studentsGrid) {
                return;
            }

            studentsGrid.deselectRows([code]);
        });
    }

    function initializeFilters() {
        initAdminStudentOrgFilters({
            studentsBaseUrl: STUDENTS_API_URL,
            gridInstance: studentsGrid
        });
    }

    function initializeActions() {
        $("#chk-enroll-related").on("change", function() {
            toggleStatusOptions($(this).is(":checked"));
            invalidatePreview();
        });

        $(".sg-status-checkbox").on("change", function() {
            updateSelectedStatusCount();
            invalidatePreview();
        });

        $("#btn-next-step").on("click", function() {
            if (wizardState.currentStep === 1) {
                if (getSelectedStudentCodes().length === 0) {
                    showToast("Please select at least one learner.", "warning");
                    return;
                }

                wizardState.currentStep = 2;
                updateWizardUi();
            }
        });

        $("#btn-prev-step").on("click", function() {
            if (wizardState.currentStep > 1) {
                wizardState.currentStep -= 1;
                updateWizardUi();
            }
        });

        $("#btn-preview-summary").on("click", previewSummary);
        $("#btn-confirm").on("click", confirmChanges);

        $("#selected-students-clear").on("click", function() {
            if (studentsGrid) { studentsGrid.clearSelection(); }
        });

        renderSelectedStudentsTray([]);
    }

    async function previewSummary() {
        const payload = getPayload();
        if (!payload.studentCodes.length) {
            showToast("Please select at least one learner.", "warning");
            wizardState.currentStep = 1;
            updateWizardUi();
            return;
        }

        if (payload.enrollToRelatedAssignments && payload.assignmentStatuses.length === 0) {
            showToast("Select at least one assignment status.", "warning");
            return;
        }

        setButtonLoading("#btn-preview-summary", true, "Loading Summary...");
        try {
            const response = await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}/members/preview`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            });

            wizardState.preview = response.data || null;
            renderPreviewSummary();
            wizardState.currentStep = 3;
            updateWizardUi();
        } catch (error) {
            showToast(getApiErrorMessage(error, "Failed to build summary."), "error");
        } finally {
            setButtonLoading("#btn-preview-summary", false);
        }
    }

    async function confirmChanges() {
        const payload = getPayload();

        const confirmed = await showAdminConfirmDialog({
            title: "Confirm Add Members",
            messageHtml: "<b>Apply these student group updates?</b><br><small class='text-muted'>This will add the selected learners to the group and apply the assignment enrollment options shown in the summary.</small>",
            confirmButtonText: "Confirm",
            confirmType: "default",
            icon: "question"
        });

        if (!confirmed) {
            return;
        }

        setButtonLoading("#btn-confirm", true, "Applying...");
        try {
            const response = await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}/members/confirm`,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            });

            const result = response.data || {};
            showToast(buildSuccessMessage(result), "success");
            window.location.href = GROUP_DETAIL_URL;
        } catch (error) {
            showToast(getApiErrorMessage(error, "Failed to apply student group changes."), "error");
        } finally {
            setButtonLoading("#btn-confirm", false);
        }
    }

    function getAddMembersStepNote(step) {
        switch (step) {
            case 1:
                return 'Select learners to add to this student group.';
            case 2:
                return 'Set related assignment enrollment options.';
            case 3:
                return 'Review the summary before applying changes.';
            default:
                return '';
        }
    }

    function updateWizardUi() {
        $(".admin-wizard-panel").removeClass("active");
        $(`#step-panel-${wizardState.currentStep}`).addClass("active");
        const layout = $(`#step-panel-${wizardState.currentStep}`).attr("data-step-layout") || "wide";
        $(".admin-wizard-shell")
            .toggleClass("is-form-step", layout === "form")
            .toggleClass("is-review-step", layout === "review");

        $("[data-step-card]").each(function() {
            const step = Number($(this).attr("data-step-card"));
            $(this)
                .toggleClass("active", step === wizardState.currentStep)
                .toggleClass("complete", step < wizardState.currentStep);
            if (step === wizardState.currentStep) {
                $(this).attr("aria-current", "step");
            } else {
                $(this).removeAttr("aria-current");
            }
        });

        $(".bottom-toolbar-note").html(`<i class="fas fa-info-circle text-muted me-1" aria-hidden="true"></i> ${getAddMembersStepNote(wizardState.currentStep)}`);
        $("#btn-prev-step").toggleClass("d-none", wizardState.currentStep === 1);
        $("#btn-next-step").toggleClass("d-none", wizardState.currentStep !== 1);
        $("#btn-preview-summary").toggleClass("d-none", wizardState.currentStep !== 2);
        $("#btn-confirm").toggleClass("d-none", wizardState.currentStep !== 3);
    }

    function renderGroupSnapshot() {
        const group = wizardState.group;
        const assignments = wizardState.relatedAssignments;

        $("#group-name").text(group?.name || EMPTY_TEXT);
        $("#group-description").text(group?.description || "No description");
        $("#group-member-count").text(window.formatAdminCountLabel((group?.members || []).length, "member"));
        $("#group-assignment-count").text(window.formatAdminCountLabel(assignments.length, "batch"));
        $("#assignment-status-overview").html(buildStatusOverview(assignments));
        updateSelectionSummary();
    }

    function renderAssignmentOverview() {
        const items = [
            { label: "Completed", value: countAssignmentsByStatus("Completed"), className: "u-text-success" },
            { label: "In Progress", value: countAssignmentsByStatus("InProgress"), className: "u-text-info" },
            { label: "Upcoming", value: countAssignmentsByStatus("Upcoming"), className: "u-text-warning" },
            { label: "Expired", value: countAssignmentsByStatus("Expired"), className: "u-text-danger" }
        ];

        $("#assignment-overview-grid").html(items.map(function(item) {
            return `
                <div class="admin-summary-item">
                    <div class="admin-summary-value ${item.className}">${item.value}</div>
                    <div class="admin-summary-label">${item.label}</div>
                </div>`;
        }).join(""));

    }

    function renderPreviewSummary() {
        const preview = wizardState.preview;
        if (!preview) {
            return;
        }

        $("#summary-cards").html([
            buildSummaryCard(preview.selectedStudentCount, "Selected Learners", "text-dark"),
            buildSummaryCard(preview.newMemberCount, "New Members", "u-text-success"),
            buildSummaryCard(preview.existingMemberCount, "Already In Group", "u-text-warning"),
            buildSummaryCard(preview.selectedAssignmentCount, "Assignment Batches", "u-text-info"),
            buildSummaryCard(preview.selectedCourseCount, "Courses Affected", "text-dark"),
            buildSummaryCard(preview.estimatedEnrollmentCount, "Estimated Enrollments", "u-text-info")
        ].join(""));

        $("#student-summary-note").text(window.formatAdminCountLabel(preview.selectedStudentCount, "learner"));
        $("#assignment-summary-note").text(preview.enrollToRelatedAssignments
            ? window.formatAdminCountLabel(preview.selectedAssignmentCount, "batch")
            : "Not enrolled");

        $("#student-summary-table").html(buildStudentsSummaryTable(preview.students || []));
        $("#assignment-summary-table").html(buildAssignmentsSummaryTable(preview.assignments || []));
    }

    function buildStudentsSummaryTable(students) {
        if (!students.length) {
            return buildEmptyState("fas fa-user-graduate", "No learners selected yet.");
        }

        const rows = students.map(function(student) {
            const memberState = student.isAlreadyMember
                ? '<span class="tag-pill pill-warning">Already in group</span>'
                : '<span class="tag-pill pill-success">New member</span>';

            return `
                <tr>
                    <td>
                        <div class="tag-pill pill-default fw-bold">${escapeHtml(student.studentCode || EMPTY_TEXT)}</div>
                    </td>
                    <td>
                        <div class="admin-student-name">${escapeHtml(student.studentName || student.studentCode || EMPTY_TEXT)}</div>
                    </td>
                    <td>${escapeHtml(student.position || EMPTY_TEXT)}</td>
                    <td>${memberState}</td>
                </tr>`;
        }).join("");

        return `
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Learner</th>
                        <th>Position</th>
                        <th>Membership Impact</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>`;
    }

    function buildAssignmentsSummaryTable(assignments) {
        if (!assignments.length) {
            return buildEmptyState("fas fa-tasks", "No related assignments will be updated with this action.");
        }

        const rows = assignments.map(function(assignment) {
            return `
                <tr>
                    <td>
                        <div class="fw-semibold text-dark">${escapeHtml(assignment.assignmentNo || EMPTY_TEXT)}</div>
                    </td>
                    <td>
                        <div>${escapeHtml(assignment.courseNames || EMPTY_TEXT)}</div>
                    </td>
                    <td>${renderStatusPill(assignment.status)}</td>
                    <td>${window.formatAdminDate(assignment.startDate, EMPTY_TEXT)}</td>
                    <td>${window.formatAdminDate(assignment.dueDate, EMPTY_TEXT)}</td>
                    <td>${window.formatAdminCountLabel(assignment.currentLearnerCount || 0, "learner")}</td>
                    <td>${window.formatAdminCountLabel(assignment.estimatedEnrollmentCount || 0, "enrollment")}</td>
                </tr>`;
        }).join("");

        return `
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Courses</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>Due</th>
                        <th>Current Learners</th>
                        <th>Estimated Enrollments</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>`;
    }

    function buildSummaryCard(value, label, className) {
        return buildAdminSummaryCard(value, label, className);
    }

    function buildEmptyState(iconClass, message) {
        return `
            <div class="admin-wizard-empty-state">
                <i class="${iconClass}"></i>
                <div>${message}</div>
            </div>`;
    }

    function buildStatusOverview(assignments) {
        if (!assignments.length) {
            return '<span class="text-muted">No assignments yet</span>';
        }

        const parts = [
            { status: "Completed", label: "Completed", cls: "pill-success" },
            { status: "InProgress", label: "In Progress", cls: "pill-primary" },
            { status: "Upcoming", label: "Upcoming", cls: "pill-warning" },
            { status: "Expired", label: "Expired", cls: "pill-danger" }
        ].map(function(item) {
            return `<span class="tag-pill ${item.cls} me-1 mb-1">${item.label}: ${countAssignmentsByStatus(item.status)}</span>`;
        });

        return parts.join("");
    }

    function renderStatusPill(status) {
        const map = {
            Completed: { cls: "pill-success", text: "Completed" },
            InProgress: { cls: "pill-primary", text: "In Progress" },
            Upcoming: { cls: "pill-warning", text: "Upcoming" },
            Expired: { cls: "pill-danger", text: "Expired" }
        };

        const resolved = map[status] || { cls: "pill-default", text: status || EMPTY_TEXT };
        return `<span class="tag-pill ${resolved.cls}">${resolved.text}</span>`;
    }

    function toggleStatusOptions(enabled) {
        $("#status-options-card").toggleClass("is-disabled", !enabled);
        $(".sg-status-checkbox").prop("disabled", !enabled);
        $(".sg-status-option").toggleClass("disabled", !enabled);

        if (!enabled) {
            $(".sg-status-checkbox").prop("checked", false);
        }

        updateSelectedStatusCount();
    }

    function updateSelectedStatusCount() {
        const count = getSelectedStatuses().length;
        $("#selected-status-count").text(window.formatAdminCountLabel(count, "status"));
    }

    function updateSelectionSummary() {
        const count = getSelectedStudentCodes().length;
        $("#member-selection-note").text(count > 0 ? window.formatAdminCountLabel(count, "learner") : "0 learner");
    }

    function invalidatePreview() {
        wizardState.preview = null;
    }

    function countAssignmentsByStatus(status) {
        return wizardState.relatedAssignments.filter(function(item) {
            return item.status === status;
        }).length;
    }

    function getSelectedStudentCodes() {
        return studentsGrid ? (studentsGrid.getSelectedRowKeys() || []) : [];
    }

    function getSelectedStatuses() {
        return $(".sg-status-checkbox:checked").map(function() {
            return $(this).val();
        }).get();
    }

    function getPayload() {
        return {
            studentCodes: getSelectedStudentCodes(),
            enrollToRelatedAssignments: $("#chk-enroll-related").is(":checked"),
            assignmentStatuses: getSelectedStatuses()
        };
    }

    function buildSuccessMessage(result) {
        const addedMembers = Number(result.addedMemberCount || 0);
        const assignments = Number(result.assignmentCount || 0);

        if (assignments > 0) {
            return `${window.formatAdminCountLabel(addedMembers, "member")} added and ${window.formatAdminCountLabel(assignments, "assignment batch")} updated.`;
        }

        return `${window.formatAdminCountLabel(addedMembers, "member")} added successfully.`;
    }
</script>
}