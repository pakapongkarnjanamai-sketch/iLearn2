@{
    ViewBag.Title = (ViewBag.Id == null ? "New Student Group" : "Edit Student Group");
    var isEdit = ViewBag.Id != null;
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<!-- ── Page Header ── -->
<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-users text-primary me-2" aria-hidden="true"></i>@ViewBag.Title</h1>
    @if (!isEdit)
    {
        <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
            <div class="admin-step-card active" data-step-card="1" aria-current="step">
                <div class="admin-step-title"><span class="admin-step-index">1</span>Information</div>
            </div>
            <div class="admin-step-card" data-step-card="2">
                <div class="admin-step-title"><span class="admin-step-index">2</span>Members</div>
            </div>
            <div class="admin-step-card" data-step-card="3">
                <div class="admin-step-title"><span class="admin-step-index">3</span>Review</div>
            </div>
        </div>
    }
    @if (isEdit)
    {
        <div class="admin-page-header-actions">
            <a href="@Url.Action("Index", "StudentGroups")" class="action-link">
                <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
            </a>
            <button type="button" id="btn-save" class="action-link primary">
                <i class="fas fa-save" aria-hidden="true"></i> Save Changes
            </button>
        </div>
    }
    else
    {
        <div class="admin-page-header-actions">
            <a href="@Url.Action("Index", "StudentGroups")" class="action-link">
                <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
            </a>
            <button type="button" id="btn-prev-step" class="action-link d-none">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
            </button>
            <button type="button" id="btn-next-step" class="action-link primary">
                <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
            </button>
            <button type="button" id="btn-save" class="action-link primary d-none">
                <i class="fas fa-save" aria-hidden="true"></i> Create Group
            </button>
        </div>
    }
</div>

@if (isEdit)
{
    <div class="container page-shell-sm px-4 py-4">
        <div id="load-panel"></div>

        <div class="border rounded bg-white d-flex flex-column">
            <div class="p-3">
                <div class="admin-section-header">
                    <div class="admin-section-header-main">
                        <div class="section-title mb-0 admin-section-title-fill">Group Information</div>
                    </div>
                    <div class="admin-section-divider"></div>
                </div>
            </div>
            <div class="px-3 pb-3 admin-form-card">
                <div id="form-container"></div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow admin-viewport-layout">
        <div id="load-panel"></div>

        <div class="admin-review-main-col admin-responsive-content">
            <div class="border rounded bg-white p-3 admin-viewport-fill" id="wizard-main-card">
                <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="form">
                    <div class="admin-section-header mb-2">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Group Information</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>
                    <div class="admin-detail-card">
                        <div id="form-container"></div>
                    </div>
                </div>

                <div id="step-panel-2" class="admin-wizard-panel admin-wizard-panel--selection-fill" data-step-layout="wide">
                    <div class="admin-section-header mb-2">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Initial Members</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>

                    <div class="admin-selection-layout">
                        <div class="admin-filter-shell d-flex flex-column gap-3">
                            <h6 class="admin-filter-section-title"><i class="fas fa-filter" aria-hidden="true"></i>Filters</h6>
                            <div>
                                <label class="admin-filter-label">Division</label>
                                <div id="filter-div"></div>
                            </div>
                            <div>
                                <label class="admin-filter-label">Department</label>
                                <div id="filter-dept"></div>
                            </div>
                            <div>
                                <label class="admin-filter-label">Section</label>
                                <div id="filter-section"></div>
                            </div>
                            <button type="button" id="btn-clear-filter" class="admin-filter-clear-btn">
                                <i class="fas fa-times me-1" aria-hidden="true"></i> Clear Filters
                            </button>
                        </div>
                        <div class="admin-grid-shell">
                            <div class="admin-grid-head">
                                <div class="admin-grid-title">Learner Directory</div>
                                <span class="tag-pill pill-default" id="member-selection-note">0 learner</span>
                            </div>
                            <div id="grid-initial-members" class="admin-grid-fill"></div>
                        </div>
                    </div>
                    <div class="admin-selection-tray" id="initial-members-tray">
                        <div class="admin-selection-tray-label">Selected</div>
                        <div class="admin-selection-tray-chips" id="initial-members-chips"></div>
                        <button type="button" class="admin-selection-tray-clear is-disabled" id="initial-members-clear">
                            <i class="fas fa-eraser me-1" aria-hidden="true"></i>Clear
                        </button>
                    </div>
                </div>

                <div id="step-panel-3" class="admin-wizard-panel" data-step-layout="review">
                    <div class="admin-section-header admin-review-header">
                        <div class="admin-section-header-main">
                            <div class="section-title mb-0 admin-section-title-fill">Review And Confirm</div>
                        </div>
                        <div class="admin-section-divider"></div>
                    </div>

                    <div class="admin-review-stack">
                        <div id="summary-cards" class="admin-summary-grid"></div>
                        <div id="form-review-details"></div>

                        <div class="admin-table-shell">
                            <div class="admin-table-head">
                                <div class="admin-table-title">Initial Members</div>
                                <span class="tag-pill pill-default" id="review-members-note"></span>
                            </div>
                            <div class="admin-table-wrap admin-review-table-wrap" id="selected-members-review"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
<script>
    const GROUPS_API_URL = `${serviceUrl}/StudentGroups`;
    const CATEGORIES_API_URL = `${serviceUrl}/StudentGroupCategories`;
    const STUDENTS_API_URL = `${serviceUrl}/Students`;
    const GROUP_ID = @(ViewBag.Id ?? "null");
    const INITIAL_CATEGORY_ID = @(ViewBag.CategoryId ?? "null");
    const IS_EDIT = @(isEdit ? "true" : "false");
    const INDEX_URL = '@Url.Action("Index", "StudentGroups")';
    const DETAIL_URL = '@Url.Action("Detail", "StudentGroups")';
    const EMPTY_TEXT = "—";
    const MAX_VISIBLE_SELECTION_CHIPS = 12;

    // Height Settings
    const DESCRIPTION_FIELD_HEIGHT = 120;
    const INITIAL_MEMBER_GRID_HEIGHT = "100%";

    const createState = {
        currentStep: 1,
        selectedStudentCodes: [],
        selectedStudents: new Map(),
        reviewStudents: []
    };

    let formInstance;
    let loadPanel;
    let studentsGrid = null;
    let reviewForm;
    let selectionViewportController = null;

    $(() => {
        loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: false,
            showIndicator: true,
            showPane: true,
            shading: true
        }).dxLoadPanel("instance");

        initializeForm();

        if (IS_EDIT) {
            loadGroupData();
            $("#btn-save").on("click", saveGroupChanges);
            return;
        }

        initializeStudentGrid();
        initializeFilters();
        initializeCreateActions();
        initializeReviewForm();
        updateSelectionSummary();
        updateCreateSnapshot();
        updateCreateWizardUi();
    });

    function initializeReviewForm() {
        reviewForm = $("#form-review-details").dxForm({
            readOnly: true,
            labelMode: "floating",
            stylingMode: "outlined",
            colCount: 1,
            formData: { name: "", description: "", categoryName: "" },
            items: [
                { dataField: "name", label: { text: "Group Name" } },
                { dataField: "categoryName", label: { text: "Category" } },
                {
                    dataField: "description",
                    label: { text: "Description" },
                    editorType: "dxTextArea",
                    editorOptions: { height: DESCRIPTION_FIELD_HEIGHT }
                }
            ]
        }).dxForm("instance");
    }

    function buildCategorySelectorItem() {
        return {
            dataField: "categoryId",
            label: { text: "Category (optional)" },
            editorType: "dxSelectBox",
            editorOptions: {
                dataSource: new DevExpress.data.CustomStore({
                    key: "id",
                    loadMode: "raw",
                    load: async function () {
                        const res = await $.ajax({
                            url: CATEGORIES_API_URL,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        });
                        const items = res?.data || [];
                        return items.map(c => ({
                            id: c.id,
                            name: c.name,
                            depth: c.depth || 0,
                            label: `${"— ".repeat(c.depth || 0)}${c.name}`
                        }));
                    }
                }),
                displayExpr: "label",
                valueExpr: "id",
                searchEnabled: true,
                showClearButton: !INITIAL_CATEGORY_ID,
                readOnly: !!INITIAL_CATEGORY_ID,
                placeholder: "No category (root)",
                onValueChanged: updateCreateSnapshot
            }
        };
    }

    function initializeForm() {
        formInstance = $("#form-container").dxForm({
            labelMode: "floating",
            colCount: 1,
            formData: { name: "", description: "", categoryId: INITIAL_CATEGORY_ID },
            items: [
                {
                    dataField: "name",
                    label: { text: "Group Name" },
                    editorOptions: {
                        placeholder: "e.g. New Hires 2026 Q1",
                        onValueChanged: updateCreateSnapshot
                    },
                    validationRules: [
                        { type: "required", message: "Group name is required" },
                        { type: "stringLength", max: 200, message: "Max 200 characters" }
                    ]
                },
                buildCategorySelectorItem(),
                {
                    dataField: "description",
                    label: { text: "Description" },
                    editorType: "dxTextArea",
                    editorOptions: {
                        height: DESCRIPTION_FIELD_HEIGHT,
                        placeholder: "Brief description of this group's purpose",
                        onValueChanged: updateCreateSnapshot
                    },
                    validationRules: [
                        { type: "required", message: "Description is required" },
                        {
                            type: "custom",
                            message: "Description is required",
                            validationCallback: function(e) {
                                return typeof e.value === "string" && e.value.trim().length > 0;
                            }
                        }
                    ]
                }
            ]
        }).dxForm("instance");
    }

    async function loadGroupData() {
        loadPanel.show();
        try {
            const res = await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            const group = res.data;
            if (!group) {
                showToast("Group not found.", "error");
                window.location.href = INDEX_URL;
                return;
            }

            formInstance.option("formData", {
                name: group.name || "",
                description: group.description || "",
                categoryId: group.categoryId ?? null
            });
        } catch {
            showToast("Error loading group.", "error");
            window.location.href = INDEX_URL;
        } finally {
            loadPanel.hide();
        }
    }

    function initializeStudentGrid() {
        studentsGrid = initDxGrid("#grid-initial-members", {
            preset: "wizardSelectionContinuousGrid",
            height: INITIAL_MEMBER_GRID_HEIGHT,
            dataSource: DevExpress.data.AspNet.createStore({
                key: "EId",
                loadUrl: `${STUDENTS_API_URL}/Get`,
                onBeforeSend: function(method, options) {
                    options.xhrFields = { withCredentials: true };
                }
            }),
            noDataText: getNoDataText("learners"),
            columns: [
                        {
                            dataField: "EId", caption: "ID", width: 95,
                            cellTemplate: function(container, options) {
                                window.renderAdminGridTextCell(container, options.value, 'captionStrong');
                            }
                        },
                        {
                            caption: "Name", minWidth: 160,
                            calculateCellValue: (d) => [d.EnglishFirstName, d.EnglishLastName].filter(Boolean).join(" "),
                            cssClass: "fw-medium text-dark"
                        },
                        {
                            dataField: "Position", caption: "Position", width: 90, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (!options.value) {
                                    return;
                                }

                                window.renderAdminGridTextCell(container, options.value, 'captionMuted');
                            }
                        },
                        { dataField: "Department", caption: "Dept.", width: 90 },
                        { dataField: "Section", caption: "Section", minWidth: 120,
                            cssClass: "cell-muted",
                            customizeText: function(e) { return e.value || EMPTY_TEXT; }
                        }
                    ],
            onSelectionChanged: function(event) {
                createState.selectedStudentCodes = (event.selectedRowKeys || []).map(String);
                syncSelectedStudentCache(event);
                renderInitialMembersTray(createState.selectedStudentCodes);
                updateSelectionSummary();
                updateCreateSnapshot();
            }
        });
    }

    function initializeFilters() {
        initAdminStudentOrgFilters({
            studentsBaseUrl: STUDENTS_API_URL,
            gridInstance: studentsGrid
        });
    }

    function initializeCreateActions() {
        $("#btn-next-step").on("click", async function() {
            if (createState.currentStep === 1) {
                if (!formInstance.validate().isValid) {
                    return;
                }

                createState.currentStep = 2;
                updateCreateWizardUi();
                return;
            }

            if (createState.currentStep === 2) {
                if (!formInstance.validate().isValid) {
                    createState.currentStep = 1;
                    updateCreateWizardUi();
                    return;
                }

                setButtonLoading("#btn-next-step", true, "Building Review...");
                try {
                    createState.reviewStudents = await loadReviewStudents();
                    renderCreateReview();
                    createState.currentStep = 3;
                    updateCreateWizardUi();
                } finally {
                    setButtonLoading("#btn-next-step", false);
                }
            }
        });

        $("#btn-prev-step").on("click", function() {
            if (createState.currentStep > 1) {
                createState.currentStep -= 1;
                updateCreateWizardUi();
            }
        });

        $("#btn-save").on("click", createGroup);

        $(document).on("click", "#initial-members-clear", function() {
            if (!studentsGrid) {
                return;
            }
            studentsGrid.clearSelection();
        });

        renderInitialMembersTray([]);
    }

    async function createGroup() {
        if (!formInstance.validate().isValid) {
            createState.currentStep = 1;
            updateCreateWizardUi();
            return;
        }

        const data = formInstance.option("formData");
        const payload = {
            name: data.name,
            description: data.description,
            categoryId: data.categoryId ?? null,
            studentCodes: getSelectedStudentCodes()
        };

        const confirmed = await showAdminConfirmDialog({
            title: "Create Student Group",
            messageHtml: `<b>Create this Student Group now?</b><br><small class='text-muted'>${window.formatAdminCountLabel(payload.studentCodes.length, "initial member", "initial members", "No initial members selected yet")} will be included in the first setup.</small>`,
            confirmButtonText: "Create Group",
            confirmType: "default",
            icon: "question"
        });

        if (!confirmed) {
            return;
        }

        setButtonLoading("#btn-save", true, "Creating...");
        try {
            const res = await $.ajax({
                url: GROUPS_API_URL,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            });

            showToast("Group created successfully.", "success");

            const createdId = res?.data?.id || res?.id;
            if (createdId) {
                window.location.href = `${DETAIL_URL}?id=${createdId}`;
                return;
            }

            window.location.href = INDEX_URL;
        } catch (err) {
            showToast(`Error: ${getApiErrorMessage(err, "Failed to create group")}`, "error", 4000);
        } finally {
            setButtonLoading("#btn-save", false);
        }
    }

    async function saveGroupChanges() {
        if (!formInstance.validate().isValid) {
            return;
        }

        const data = formInstance.option("formData");
        setButtonLoading("#btn-save", true, "Saving...");

        try {
            await $.ajax({
                url: `${GROUPS_API_URL}/${GROUP_ID}`,
                method: "PUT",
                contentType: "application/json",
                data: JSON.stringify({
                    name: data.name,
                    description: data.description,
                    categoryId: data.categoryId ?? null
                }),
                xhrFields: { withCredentials: true }
            });

            showToast("Group updated successfully.", "success");
            window.location.href = INDEX_URL;
        } catch (err) {
            showToast(`Error: ${getApiErrorMessage(err, "Failed to save")}`, "error", 4000);
        } finally {
            setButtonLoading("#btn-save", false);
        }
    }

    function getGroupStepNote(step) {
        switch (step) {
            case 1:
                return 'Enter group details before continuing.';
            case 2:
                return 'Select initial members, or skip to review.';
            case 3:
                return 'Review the group before creating it.';
            default:
                return '';
        }
    }

    function updateCreateWizardUi() {
        $(".admin-wizard-panel").removeClass("active");
        $(`#step-panel-${createState.currentStep}`).addClass("active");
        const layout = $(`#step-panel-${createState.currentStep}`).attr("data-step-layout") || "wide";
        const isSelectionStep = createState.currentStep === 2;
        $(".admin-wizard-shell")
            .toggleClass("is-selection-step", isSelectionStep)
            .toggleClass("is-form-step", layout === "form")
            .toggleClass("is-review-step", layout === "review");

        selectionViewportController = window.toggleAdminViewportLayout(selectionViewportController, isSelectionStep, {
            layoutSelector: ".admin-wizard-shell.admin-viewport-layout",
            contentSelector: ".admin-review-main-col.admin-responsive-content",
            refreshTargets: [studentsGrid]
        });

        $("[data-step-card]").each(function() {
            const step = Number($(this).attr("data-step-card"));
            $(this)
                .toggleClass("active", step === createState.currentStep)
                .toggleClass("complete", step < createState.currentStep);
            if (step === createState.currentStep) {
                $(this).attr("aria-current", "step");
            } else {
                $(this).removeAttr("aria-current");
            }
        });

        $("#btn-prev-step").toggleClass("d-none", createState.currentStep === 1);
        $("#btn-next-step").toggleClass("d-none", createState.currentStep === 3);
        $("#btn-save").toggleClass("d-none", createState.currentStep !== 3);

        $(".bottom-toolbar-note").html(`<i class="fas fa-info-circle text-muted me-1" aria-hidden="true"></i> ${getGroupStepNote(createState.currentStep)}`);

        refreshCreateGrid();

        if (createState.currentStep === 2) {
            renderInitialMembersTray(getSelectedStudentCodes());
        }
    }

    function refreshCreateGrid() {
        if (!studentsGrid || createState.currentStep !== 2) {
            return;
        }

        window.requestAnimationFrame(function() {
            studentsGrid.repaint();
            studentsGrid.updateDimensions();
        });
    }

    function updateCreateSnapshot() {
        if (IS_EDIT || !formInstance) {
            return;
        }

        const formData = formInstance.option("formData") || { name: "", description: "" };
        const selectedCodes = getSelectedStudentCodes();
        const previewCodes = selectedCodes.slice(0, 3);
        const remainingCount = Math.max(selectedCodes.length - previewCodes.length, 0);

        $("#snapshot-name").text(formData.name || "Not set");
        $("#snapshot-description").text(formData.description || "No description");
        $("#snapshot-member-count").text(window.formatAdminCountLabel(selectedCodes.length, "learner", "learners", "0 learners selected"));
        $("#snapshot-member-preview").text(previewCodes.length > 0
            ? `${previewCodes.join(", ")}${remainingCount > 0 ? ` +${remainingCount} more` : ""}`
            : "No initial members selected");
    }

    function updateSelectionSummary() {
        if (IS_EDIT) {
            return;
        }

        const count = getSelectedStudentCodes().length;
        $("#member-selection-note").text(count > 0 ? window.formatAdminCountLabel(count, "learner") : "0 learner");
    }

    function syncSelectedStudentCache(event) {
        const selectedRows = event.selectedRowsData || [];
        selectedRows.forEach(function(row) {
            const student = normalizeStudentProfile(row, row?.EId || row?.eid || row?.Code || row?.code);
            if (student.studentCode) {
                createState.selectedStudents.set(student.studentCode, student);
            }
        });

        (event.currentDeselectedRowKeys || []).forEach(function(code) {
            createState.selectedStudents.delete(String(code));
        });

        const activeCodes = new Set((event.selectedRowKeys || []).map(String));
        Array.from(createState.selectedStudents.keys()).forEach(function(code) {
            if (!activeCodes.has(code)) {
                createState.selectedStudents.delete(code);
            }
        });
    }

    function renderInitialMembersTray(selectedCodes) {
        const codes = selectedCodes || [];
        const $chips = $("#initial-members-chips");
        const $clearBtn = $("#initial-members-clear");

        if (!codes.length) {
            $chips.html('<span class="admin-selection-tray-empty">No learners selected yet.</span>');
            $clearBtn.addClass("is-disabled").prop("disabled", true);
            return;
        }

        $clearBtn.removeClass("is-disabled").prop("disabled", false);
        const visibleCodes = codes.slice(0, MAX_VISIBLE_SELECTION_CHIPS);
        const overflowCount = Math.max(codes.length - visibleCodes.length, 0);
        const chips = visibleCodes.map(function(code) {
            const normalizedCode = String(code);
            const student = createState.selectedStudents.get(normalizedCode);
            const safeCode = escapeHtml(normalizedCode || EMPTY_TEXT);
            const encodedCode = encodeURIComponent(normalizedCode);
            const safeName = student
                ? escapeHtml(student.studentName || "")
                : "";
            const namePart = safeName
                ? `<span class="admin-selection-chip-sep">·</span><span class="admin-selection-chip-name" title="${safeName}">${safeName}</span>`
                : "";

            return `<span class="admin-selection-chip">
                <span class="admin-selection-chip-key">${safeCode}</span>
                ${namePart}
                <button type="button" class="admin-selection-chip-remove" data-code="${encodedCode}" aria-label="Remove ${safeCode}"><i class="fas fa-times" aria-hidden="true"></i></button>
            </span>`;
        });

        if (overflowCount > 0) {
            chips.push(`<span class="admin-selection-chip is-overflow">+${overflowCount} more</span>`);
        }

        $chips.html(chips.join(""));
        $chips.off("click", ".admin-selection-chip-remove").on("click", ".admin-selection-chip-remove", function() {
            const code = decodeURIComponent(String($(this).attr("data-code") || ""));
            if (!code || !studentsGrid) {
                return;
            }

            studentsGrid.deselectRows([code]);
        });
    }

    async function loadReviewStudents() {
        const selectedCodes = getSelectedStudentCodes();
        if (!selectedCodes.length) {
            return [];
        }

        const missingCodes = selectedCodes.filter(function(code) {
            return !createState.selectedStudents.has(code);
        });

        if (missingCodes.length) {
            const results = await Promise.all(missingCodes.map(loadStudentProfileByCode));
            results.filter(Boolean).forEach(function(student) {
                createState.selectedStudents.set(student.studentCode, student);
            });
        }

        return selectedCodes.map(function(code) {
            return createState.selectedStudents.get(code) || {
                studentCode: code,
                studentName: code,
                division: null,
                department: null,
                section: null,
                position: null
            };
        });
    }

    async function loadStudentProfileByCode(code) {
        try {
            const response = await $.ajax({
                url: `${STUDENTS_API_URL}/GetStudentbyEID/${encodeURIComponent(code)}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            return normalizeStudentProfile(response, code);
        } catch {
            return {
                studentCode: String(code),
                studentName: String(code),
                division: null,
                department: null,
                section: null,
                position: null
            };
        }
    }

    function normalizeStudentProfile(source, fallbackCode) {
        const studentCode = String(source?.studentCode || source?.StudentCode || source?.EId || source?.eid || source?.Code || source?.code || fallbackCode || "");
        const studentName = source?.studentName
            || source?.StudentName
            || source?.Name
            || source?.name
            || [source?.EnglishFirstName, source?.EnglishLastName].filter(Boolean).join(" ")
            || studentCode;

        return {
            studentCode: studentCode,
            studentName: studentName,
            division: source?.division || source?.Division || null,
            department: source?.department || source?.Department || null,
            section: source?.section || source?.Section || null,
            position: source?.position || source?.Position || null
        };
    }

    function renderCreateReview() {
        const formData = formInstance.option("formData") || { name: "", description: "" };
        const students = createState.reviewStudents || [];
        const distinctDivisions = countDistinctValues(students, function(student) { return student.division; });
        const distinctDepartments = countDistinctValues(students, function(student) { return student.department; });

        $("#summary-cards").html([
            buildSummaryCard(students.length, "Initial Members", students.length > 0 ? "u-text-info" : "text-dark"),
            buildSummaryCard(distinctDivisions, "Divisions", distinctDivisions > 0 ? "text-primary" : "text-dark"),
            buildSummaryCard(distinctDepartments, "Departments", distinctDepartments > 0 ? "u-text-success" : "text-dark")
        ].join(""));

        if (reviewForm) {
            const categoryEditor = formInstance.getEditor("categoryId");
            const categoryItem = categoryEditor && typeof categoryEditor.option === "function"
                ? categoryEditor.option("selectedItem")
                : null;
            reviewForm.option("formData", {
                name: formData.name || "",
                description: formData.description || "",
                categoryName: categoryItem ? categoryItem.name : "—"
            });
        }

        $("#review-members-note").text(window.formatAdminCountLabel(students.length, "learner"));
        $("#selected-members-review").html(buildMembersReviewTable(students));
    }

    function buildSummaryCard(value, label, className) {
        return buildAdminSummaryCard(value, label, className);
    }

    function buildMembersReviewTable(students) {
        if (!students.length) {
            return `
                <div class="admin-wizard-empty-state">
                    <i class="fas fa-user-plus" aria-hidden="true"></i>
                    <div>No initial members selected yet.</div>
                </div>`;
        }

        const rows = students.map(function(student) {
            return `
                <tr>
                    <td><div class="tag-pill pill-default fw-bold">${escapeHtml(student.studentCode || EMPTY_TEXT)}</div></td>
                    <td>
                        <div class="admin-student-name">${escapeHtml(student.studentName || student.studentCode || EMPTY_TEXT)}</div>
                    </td>
                    <td>${escapeHtml(student.position || EMPTY_TEXT)}</td>
                </tr>`;
        }).join("");

        return `
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Learner</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>`;
    }

    function countDistinctValues(items, selector) {
        return new Set(items.map(selector).filter(Boolean)).size;
    }

    function getSelectedStudentCodes() {
        if (!studentsGrid) {
            return createState.selectedStudentCodes;
        }

        return (studentsGrid.getSelectedRowKeys() || []).map(String);
    }
</script>
}
