@{
    ViewBag.Title = "User Accounts";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">User Accounts</div>
        <div class="text-secondary" style="font-size:12px;">Manage employee accounts, user information, and roles.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewUser()">
        <i class="fas fa-plus"></i> New User
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        const dsRolesLookup = {
            store: createDataStore(serviceUrl, 'admin/RolesCRUD'),
            loadMode: 'raw',
            cacheRawData: true
        };
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/UsersCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search users..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'User_Accounts'),
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: { title: "User Info", showTitle: true, width: 700, height: 450 },
                    form: {
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true } },
                            { dataField: 'nid' },
                            { dataField: 'roleIds', label: { text: 'Roles' } }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "nid", caption: "National ID / Username", minWidth: 200 },
                    {
                        dataField: "roleIds",
                        caption: "Roles",
                        width: 350,
                        allowSorting: false,
                        calculateCellValue: function(rowData) {
                            if (rowData.roles) return rowData.roles.map(r => r.id);
                            if (rowData.userRoles) return rowData.userRoles.map(ur => ur.roleId);
                            return [];
                        },
                        editCellTemplate: tagBoxEditorTemplate,
                        lookup: {
                            dataSource: dsRolesLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    { dataField: "createdAt", dataType: "date", format: "yyyy-MM-dd HH:mm", visible: false }
                ]
            });

            function tagBoxEditorTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: dsRolesLookup,
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'name',
                    showSelectionControls: true,
                    onValueChanged(e) { cellInfo.setValue(e.value); }
                });
            }
        });

        function addNewUser() {
            if(gridInstance) gridInstance.addRow();
        }
    </script>
}