@{
    ViewBag.Title = "User Accounts";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">User Accounts</div>
        <div class="page-subtitle">Manage employee accounts, user information, and roles.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewUser()">
        <i class="fas fa-plus"></i> New User
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div id="grid"></div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        const dsRolesLookup = {
            store: createDataStore(serviceUrl, 'admin/RolesCRUD'),
            loadMode: 'raw',
            cacheRawData: true
        };
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/UsersCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search users..." },
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'User_Accounts'),
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: { title: "User Info", showTitle: true, width: 700, height: 450 },
                    form: {
                        items: [
                            { dataField: 'id', editorOptions: { disabled: true } },
                            { dataField: 'nid' },
                            { dataField: 'roleIds', label: { text: 'Roles' } }
                        ]
                    }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "nid", caption: "National ID / Username", minWidth: 200 },
                    { dataField: "employeeId", caption: "Employee ID", minWidth: 120, allowEditing: false },
                    { dataField: "fullName", caption: "Full Name", minWidth: 180, allowEditing: false },
                    { dataField: "email", caption: "Email", minWidth: 180, allowEditing: false },
                    { dataField: "division", caption: "Division", minWidth: 120, allowEditing: false },
                    { dataField: "department", caption: "Department", minWidth: 160, allowEditing: false },
                    { dataField: "section", caption: "Section", minWidth: 220, allowEditing: false },
                    { dataField: "position", caption: "Position", minWidth: 120, allowEditing: false },
                    {
                        // ── คอลัมน์ Roles ──────────────────────────────────────────────
                        // - calculateCellValue: แปลง userRoles[{roleId}] → array of int สำหรับ TagBox
                        // - cellTemplate: แสดง badge badge สวยงามจาก role.name
                        // - editCellTemplate: TagBox สำหรับแก้ไข
                        caption: "Roles",
                        dataField: "roleIds",
                        width: 350,
                        allowSorting: false,
                        calculateCellValue: function(rowData) {
                            // API คืน userRoles: [{roleId, role: {id, name}}]
                            if (Array.isArray(rowData.userRoles) && rowData.userRoles.length > 0) {
                                return rowData.userRoles.map(ur => ur.roleId);
                            }
                            return [];
                        },
                        cellTemplate: function(container, options) {
                            const userRoles = options.data.userRoles || [];
                            if (userRoles.length === 0) {
                                $('<span class="text-muted small">No roles assigned</span>')
                                    .appendTo(container);
                                return;
                            }
                            userRoles.forEach(ur => {
                                const name = ur.role?.name || `Role #${ur.roleId}`;
                                const isSuper = name === 'SuperAdmin';
                                $('<span>')
                                    .addClass('badge rounded-pill me-1')
                                    .css({
                                        background: isSuper ? '#ffd700' : '#e8f0fe',
                                        color:      isSuper ? '#000'    : '#0050b3',
                                        fontSize:   '.75rem'
                                    })
                                    .html((isSuper ? '<i class="fas fa-star me-1"></i>' : '') + name)
                                    .appendTo(container);
                            });
                        },
                        editCellTemplate: tagBoxEditorTemplate,
                        lookup: {
                            dataSource: dsRolesLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    { dataField: "createdAt", dataType: "date", format: ADMIN_DATETIME_DISPLAY_FORMAT, visible: false }
                ]
            });

            function tagBoxEditorTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: dsRolesLookup,
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'name',
                    showSelectionControls: true,
                    onValueChanged(e) { cellInfo.setValue(e.value); }
                });
            }
        });

        function addNewUser() {
            if(gridInstance) gridInstance.addRow();
        }
    </script>
}