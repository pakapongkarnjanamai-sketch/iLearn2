@{
    ViewBag.Title = "User Accounts";
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage employee accounts, user information, and roles.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewUser()">
                    <i class="fas fa-plus me-2"></i> New User
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/UsersCRUD'),
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search users..." },

                // ฟังก์ชัน Export ที่อ้างอิงจาก Helper ใน Layout
                export: { enabled: true, allowExportSelectedData: false },
                onExporting: (e) => handleExporting(e, 'User_Accounts'),

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: {
                        title: "User Info",
                        showTitle: true,
                        width: 700,
                        height: 450
                    },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                colCount: 2,
                                colSpan: 2,
                                items: [
                                    { dataField: 'id', editorOptions: { disabled: true }, colSpan: 2 },
                                    { dataField: 'nid', colSpan: 2 },
                                    { dataField: 'roleIds', colSpan: 2, label: { text: 'Roles' } }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "nid",
                        caption: "National ID / Username",
                        minWidth: 200,
                        cssClass: "fw-bold text-dark"
                    },

                    // --- ส่วนจัดการ Roles ---
                    {
                        dataField: "roleIds",
                        caption: "Roles",
                        width: 350,
                        allowSorting: false,

                        // 1. แปลงข้อมูล UserRoles/Roles ให้เป็น Array
                        calculateCellValue: function(rowData) {
                            if (rowData.roles) {
                                return rowData.roles.map(r => r.id);
                            }
                            if (rowData.userRoles) {
                                return rowData.userRoles.map(ur => ur.roleId);
                            }
                            return [];
                        },

                        // 2. ใช้ TagBox Template ตอนแก้ไข
                        editCellTemplate: tagBoxEditorTemplate,

                        // 3. แสดงผลในตารางเป็น Badge
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD', { key: 'id' }),
                            displayExpr: 'name',
                            valueExpr: 'id',
                        },
                        cellTemplate: function(container, options) {
                            const items = options.value || [];
                            const text = items.map(id => options.column.lookup.calculateCellValue(id)).join(", ");

                            if (text) {
                                const badges = text.split(", ").map(role => `<span class="badge bg-light text-dark border me-1">${role}</span>`).join("");
                                container.html(badges).attr('title', text);
                            } else {
                                container.html('<span class="text-muted small">-</span>');
                            }
                        }
                    },

                    { dataField: "createdAt", dataType: "date", format: "yyyy-MM-dd HH:mm", allowEditing: false, visible: false },

                    // --- คอลัมน์ Action แบบมาตรฐาน ---
                    {
                        caption: "Manage",
                        width: 120,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // ปุ่ม Edit
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit User")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // ปุ่ม Delete
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete User")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(`Are you sure you want to delete user <b>${data.nid}</b>?`, "Confirm Delete").done((res) => {
                                        if (res) gridInstance.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ],
            });

            // ฟังก์ชันสร้าง TagBox ตอนแก้ไข (สำหรับเลือกหลาย Role)
            function tagBoxEditorTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD', { key: 'id' }),
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'name',
                    showSelectionControls: true,
                    maxDisplayedTags: 3,
                    showMultiTagOnly: false,
                    applyValueMode: 'useButtons',
                    searchEnabled: true,
                    placeholder: "Select Roles...",
                    onValueChanged(e) {
                        cellInfo.setValue(e.value);
                    },
                    onSelectionChanged(e) {
                        cellInfo.component.updateDimensions();
                    }
                });
            }
        });

        // ฟังก์ชันสำหรับเรียกใช้งานปุ่ม New User ด้านบน
        function addNewUser() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}