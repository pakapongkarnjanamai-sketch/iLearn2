@{
    ViewBag.Title = "User Accounts";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage employee accounts, user information, and roles.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewUser()">
                    <i class="fas fa-plus me-2"></i> New User
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/UsersCRUD'),
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search users..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                export: { enabled: true, allowExportSelectedData: false },
                onExporting: (e) => handleExporting(e, 'User_Accounts'),

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this user account?" },
                    popup: {
                        title: "User Info",
                        showTitle: true,
                        width: 700,
                        height: 450
                    },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                colCount: 2,
                                colSpan: 2,
                                items: [
                                    { dataField: 'id', editorOptions: { disabled: true }, colSpan: 2 },
                                    { dataField: 'nid', colSpan: 2 },
                                    { dataField: 'roleIds', colSpan: 2, label: { text: 'Roles' } }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
                   
                    },
                    {
                        dataField: "nid",
                        caption: "National ID / Username",
                        minWidth: 200,
             
                    },
                    {
                        dataField: "roleIds",
                        caption: "Roles",
                        width: 350,
                        allowSorting: false,
                        calculateCellValue: function(rowData) {
                            if (rowData.roles) return rowData.roles.map(r => r.id);
                            if (rowData.userRoles) return rowData.userRoles.map(ur => ur.roleId);
                            return [];
                        },
                        editCellTemplate: tagBoxEditorTemplate,
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD', { key: 'id' }),
                            displayExpr: 'name',
                            valueExpr: 'id',
                        },
                        cellTemplate: function(container, options) {
                            const items = options.value || [];
                            const text = items.map(id => options.column.lookup.calculateCellValue(id)).join(", ");

                            if (text) {
                                // เปลี่ยนให้ Badge ดูเป็นสไตล์ที่สะอาดตา
                                const badges = text.split(", ").map(role => `<span class="badge bg-light text-primary border me-1">${role}</span>`).join("");
                                container.html(badges).attr('title', text);
                            } else {
                                container.html('<span class="text-muted small">-</span>');
                            }
                        }
                    },
                    { dataField: "createdAt", dataType: "date", format: "yyyy-MM-dd HH:mm", allowEditing: false, visible: false },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });

            // ฟังก์ชันสร้าง TagBox ตอนแก้ไข (สำหรับเลือกหลาย Role)
            function tagBoxEditorTemplate(cellElement, cellInfo) {
                return $('<div>').dxTagBox({
                    dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD', { key: 'id' }),
                    value: cellInfo.value || [],
                    valueExpr: 'id',
                    displayExpr: 'name',
                    showSelectionControls: true,
                    maxDisplayedTags: 3,
                    showMultiTagOnly: false,
                    applyValueMode: 'useButtons',
                    searchEnabled: true,
                    placeholder: "Select Roles...",
                    onValueChanged(e) {
                        cellInfo.setValue(e.value);
                    },
                    onSelectionChanged(e) {
                        cellInfo.component.updateDimensions();
                    }
                });
            }
        });

        // ฟังก์ชันสำหรับเรียกใช้งานปุ่ม New User ด้านบน
        function addNewUser() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}