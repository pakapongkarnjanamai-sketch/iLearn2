@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
    // สร้างรูปโปรไฟล์จำลองจากชื่อ
    var profileImage = "https://ui-avatars.com/api/?name=" + adminName + "&background=0062cc&color=fff&size=128";
}

@section Styles {
    <style>
        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 2rem;
        }

        /* --- Stat Cards --- */
        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid #f0f0f0;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
                border-color: var(--brand-color);
            }

            .stat-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
                background-color: var(--card-color, #0062cc);
            }

        .stat-icon {
            width: 54px;
            height: 54px;
            background-color: var(--card-bg-light, #e9f2ff);
            color: var(--card-color, #0062cc);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1rem;
        }

        .stat-value {
            font-size: 2.2rem;
            font-weight: 700;
            color: #2c3e50;
            line-height: 1.2;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: #6c757d;
            font-size: 0.95rem;
            font-weight: 500;
        }

        /* --- Quick Menu Grid --- */
        .menu-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            border: 1px solid #f0f0f0;
            transition: all 0.3s ease;
            cursor: pointer;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

            .menu-card:hover {
                border-color: var(--brand-color);
                background-color: #fcfdff;
                box-shadow: 0 4px 12px rgba(0, 98, 204, 0.1);
            }

        .menu-icon-circle {
            width: 60px;
            height: 60px;
            background: white;
            border: 2px solid var(--brand-light);
            color: var(--brand-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .menu-card:hover .menu-icon-circle {
            background: var(--brand-color);
            color: white;
            border-color: var(--brand-color);
            transform: scale(1.1);
        }

        .menu-title {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 0.5rem;
        }

        .menu-desc {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 0;
            line-height: 1.4;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 1.5rem;
            padding-left: 10px;
            border-left: 4px solid var(--brand-color);
        }
    </style>
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-4">
                    <img src="@profileImage" class="rounded-circle shadow-sm border border-2 border-white" width="72" height="72" alt="Profile">
                    <div>
                        <h2 class="fw-bold mb-1" style="color: var(--brand-dark);">Dashboard</h2>
                        <p class="text-muted mb-0">
                            Welcome back, <strong>@adminName</strong>
                            <span class="mx-2 text-primary">•</span>
                            <span class="small"><i class="far fa-clock me-1"></i> @DateTime.Now.ToString("D")</span>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="fas fa-plus me-2"></i> Create New Course
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card" style="--card-color: #0062cc; --card-bg-light: #e9f2ff;">
                <div class="stat-icon">
                    <i class="fas fa-book-reader"></i>
                </div>
                <div class="d-flex justify-content-between align-items-end w-100">
                    <div>
                        <div class="stat-value" id="count-active-courses">...</div>
                        <div class="stat-label">Active Courses</div>
                    </div>
                    <a href="@Url.Action("Index", "Courses")" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card" style="--card-color: #ffc107; --card-bg-light: #fff9db;">
                <div class="stat-icon">
                    <i class="fas fa-pen-nib"></i>
                </div>
                <div class="d-flex justify-content-between align-items-end w-100">
                    <div>
                        <div class="stat-value text-dark" id="count-draft-courses">...</div>
                        <div class="stat-label">Draft Courses</div>
                    </div>
                    <a href="@Url.Action("Drafts", "Courses")" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3">Review</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card" style="--card-color: #17a2b8; --card-bg-light: #e0f7fa;">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="d-flex justify-content-between align-items-end w-100">
                    <div>
                        <div class="stat-value" id="count-users">...</div>
                        <div class="stat-label">Total Employees</div>
                    </div>
                    <a href="@Url.Action("Index", "Users")" class="btn btn-sm btn-outline-info rounded-pill px-3">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card" style="--card-color: #6f42c1; --card-bg-light: #f3e5f5;">
                <div class="stat-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <div class="d-flex justify-content-between align-items-end w-100">
                    <div>
                        <div class="stat-value" id="count-resources">...</div>
                        <div class="stat-label">Resources Files</div>
                    </div>
                    <a href="@Url.Action("Index", "Resources")" class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="color: #6f42c1; border-color: #6f42c1;">Detail</a>
                </div>
            </div>
        </div>
    </div>

    <h5 class="section-title">Quick Management</h5>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "Courses")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-chalkboard-teacher"></i>
                </div>
                <h6 class="menu-title">Course Manager</h6>
                <p class="menu-desc">Create, edit and manage training courses.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "Enrollments")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-user-graduate"></i>
                </div>
                <h6 class="menu-title">Enrollments</h6>
                <p class="menu-desc">Monitor employee course enrollments.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "Users")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-user-cog"></i>
                </div>
                <h6 class="menu-title">User Accounts</h6>
                <p class="menu-desc">Manage users, roles and permissions.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "LearningLogs")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h6 class="menu-title">Learning Logs</h6>
                <p class="menu-desc">View detailed learning history and scores.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "Divisions")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-sitemap"></i>
                </div>
                <h6 class="menu-title">Divisions</h6>
                <p class="menu-desc">Manage company structure.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3" onclick="location.href='@Url.Action("Index", "AssignmentRules")'">
            <div class="menu-card">
                <div class="menu-icon-circle">
                    <i class="fas fa-cogs"></i>
                </div>
                <h6 class="menu-title">Auto-Assign Rules</h6>
                <p class="menu-desc">Set rules for automatic course assignment.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
   

        $(() => {
            loadDashboardStats();
        });

        function loadDashboardStats() {
            // ยิง API เดียวที่ DashboardController เพื่อให้ทำงานเร็วที่สุด
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    if (res.success && res.data) {
                        // แสดงผลพร้อม Animation ตัวเลข
                        animateCount('count-active-courses', res.data.activeCourses);
                        animateCount('count-draft-courses', res.data.draftCourses);
                        animateCount('count-users', res.data.totalUsers);
                        animateCount('count-resources', res.data.totalResources);
                    }
                },
                error: function (err) {
                    console.error("Failed to load dashboard stats", err);
                    // กรณี Error ให้แสดงขีด (-) ไว้ก่อน
                    $('#count-active-courses, #count-draft-courses, #count-users, #count-resources').text("-");
                }
            });
        }

        // Helper: Animation นับเลขขึ้น
        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            // ถ้าค่าเป็น 0 ไม่ต้อง animate นาน
            if(value === 0) {
                $el.text("0");
                return;
            }

            $({ Counter: 0 }).animate({
                Counter: value
            }, {
                duration: 800,
                easing: 'swing',
                step: function (now) {
                    $el.text(Math.ceil(now));
                },
                complete: function() {
                     $el.text(value); // จบที่ค่าจริงเสมอ
                }
            });
        }
    </script>
}