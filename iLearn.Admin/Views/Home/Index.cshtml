@using System.Security.Claims
@{
    ViewBag.Title = "Admin Dashboard";
    var roles = User.FindAll(ClaimTypes.Role).Select(claim => claim.Value).ToList();
    var hasSuperAdminRole = roles.Contains("SuperAdmin", StringComparer.OrdinalIgnoreCase);
    var learnerProgressUrl = hasSuperAdminRole ? Url.Action("Index", "Students") : Url.Action("Index", "Assignments");
    var learningActivityUrl = hasSuperAdminRole ? Url.Action("Index", "LearningLogs") : Url.Action("Gantt", "Assignments");
}


<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Admin Dashboard</h1>
        <div class="page-subtitle">Operational summary for <strong id="dashboard-scope-name">your division</strong></div>
    </div>
    <div class="page-header-actions">
        <span class="tag-pill pill-default" id="dashboard-scope-pill">
            <i class="fas fa-layer-group me-1" aria-hidden="true"></i>Loading scope
        </span>
        <a href="@Url.Action("BulkAssign", "Assignments")" class="action-link primary">
            <i class="fas fa-paper-plane" aria-hidden="true"></i> New Assignment
        </a>
        <a href="@Url.Action("Editor", "Courses")" class="action-link">
            <i class="fas fa-plus" aria-hidden="true"></i> New Course
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 admin-dashboard-shell">
    <div class="dashboard-maintenance-row is-hidden" id="maintenance-banner-row">
        <div class="dash-panel maintenance-card">
            <div class="dash-panel-header u-text-warning-strong">Maintenance In Progress</div>
            <div class="dash-panel-body">
                <div id="maintenance-status-list"></div>
            </div>
        </div>
    </div>

    <section class="dashboard-kpi-grid" aria-label="Dashboard overview">
        <a href="@Url.Action("Index", "Courses")" class="dashboard-kpi-card">
            <div class="dashboard-kpi-head">
                <div>
                    <div class="dashboard-kpi-label">Course Portfolio</div>
                    <div class="dashboard-kpi-value" id="kpi-active-courses">0</div>
                </div>
                <div class="dashboard-kpi-icon"><i class="fas fa-book" aria-hidden="true"></i></div>
            </div>
            <div class="dashboard-kpi-meta">
                <span><strong id="kpi-draft-courses">0</strong> draft</span>
                <span><strong id="kpi-resource-count">0</strong> resources</span>
            </div>
        </a>

        <a href="@Url.Action("Index", "Assignments")" class="dashboard-kpi-card">
            <div class="dashboard-kpi-head">
                <div>
                    <div class="dashboard-kpi-label">Active Assignments</div>
                    <div class="dashboard-kpi-value" id="kpi-active-assignments">0</div>
                </div>
                <div class="dashboard-kpi-icon is-warning"><i class="fas fa-list-check" aria-hidden="true"></i></div>
            </div>
            <div class="dashboard-kpi-meta">
                <span><strong id="kpi-due-soon-tasks">0</strong> due soon</span>
                <span><strong id="kpi-overdue-tasks">0</strong> overdue</span>
            </div>
        </a>

        <a href="@learnerProgressUrl" class="dashboard-kpi-card">
            <div class="dashboard-kpi-head">
                <div>
                    <div class="dashboard-kpi-label">Learner Progress</div>
                    <div class="dashboard-kpi-value" id="kpi-assigned-learners">0</div>
                </div>
                <div class="dashboard-kpi-icon is-success"><i class="fas fa-user-graduate" aria-hidden="true"></i></div>
            </div>
            <div class="dashboard-kpi-meta">
                <span><strong id="kpi-completion-rate">0%</strong> completion</span>
                <span><strong id="kpi-total-tasks">0</strong> tasks</span>
            </div>
        </a>

        <a href="@learningActivityUrl" class="dashboard-kpi-card">
            <div class="dashboard-kpi-head">
                <div>
                    <div class="dashboard-kpi-label">Learning Activity</div>
                    <div class="dashboard-kpi-value" id="kpi-learning-sessions">0</div>
                </div>
                <div class="dashboard-kpi-icon is-danger"><i class="fas fa-chart-line" aria-hidden="true"></i></div>
            </div>
            <div class="dashboard-kpi-meta">
                <span>last 30 days</span>
                <span><strong id="kpi-session-delta">0</strong> vs previous</span>
            </div>
        </a>
    </section>

    <div class="dashboard-layout-grid">
        <section class="dash-panel">
            <div class="dash-panel-header d-flex justify-content-between align-items-center">
                <span>Learning Activity Trends</span>
                <span class="dashboard-panel-subtitle">sessions per month</span>
            </div>
            <div class="dash-panel-body">
                <div id="learning-activity-chart" class="dashboard-chart is-loading">
                    <span class="skeleton skeleton-block w-100 h-100"></span>
                </div>
            </div>
        </section>

        <section class="dash-panel">
            <div class="dash-panel-header d-flex justify-content-between align-items-center">
                <span>Task Status</span>
                <span class="dashboard-panel-subtitle">assignment learning tasks</span>
            </div>
            <div class="dash-panel-body">
                <div id="task-status-chart" class="dashboard-chart-sm is-loading">
                    <span class="skeleton skeleton-block w-100 h-100"></span>
                </div>
            </div>
        </section>
    </div>

    <div class="dashboard-layout-grid">
        <section class="dash-panel">
            <div class="dash-panel-header d-flex justify-content-between align-items-center">
                <span>Priority Assignment Reports</span>
                <span class="dashboard-panel-subtitle">overdue and upcoming work</span>
            </div>
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Assignment</th>
                            <th>Status</th>
                            <th>Learners</th>
                            <th>Due</th>
                            <th>Completion</th>
                            <th>Report</th>
                        </tr>
                    </thead>
                    <tbody id="priority-assignment-rows">
                        <tr><td colspan="6"><div class="dashboard-empty-state">Loading assignments...</div></td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="dash-panel">
            <div class="dash-panel-header">Report Hub</div>
            <div class="dash-panel-body dashboard-report-list">
                <a href="@Url.Action("Index", "Assignments")" class="dashboard-report-link">
                    <div class="qa-icon qa-icon-accent"><i class="fas fa-file-lines" aria-hidden="true"></i></div>
                    <div>
                        <div class="dashboard-report-title">Assignment Reports</div>
                        <div class="dashboard-report-note">Progress, completion, and learner matrix</div>
                    </div>
                </a>
                <a href="@Url.Action("Gantt", "Assignments")" class="dashboard-report-link">
                    <div class="qa-icon qa-icon-warning"><i class="fas fa-timeline" aria-hidden="true"></i></div>
                    <div>
                        <div class="dashboard-report-title">Assignment Timeline</div>
                        <div class="dashboard-report-note">Schedule and due-date workload</div>
                    </div>
                </a>
                <a href="@Url.Action("Index", "Courses")" class="dashboard-report-link">
                    <div class="qa-icon qa-icon-success"><i class="fas fa-book-open" aria-hidden="true"></i></div>
                    <div>
                        <div class="dashboard-report-title">Course Catalog</div>
                        <div class="dashboard-report-note">Course status and content ownership</div>
                    </div>
                </a>
                <a href="@Url.Action("Index", "Categories")" class="dashboard-report-link">
                    <div class="qa-icon qa-icon-purple"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
                    <div>
                        <div class="dashboard-report-title">Category Reports</div>
                        <div class="dashboard-report-note">Course groups by division scope</div>
                    </div>
                </a>
                @if (hasSuperAdminRole)
                {
                    <a href="@Url.Action("Index", "Students")" class="dashboard-report-link">
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-users" aria-hidden="true"></i></div>
                        <div>
                            <div class="dashboard-report-title">Learner Directory</div>
                            <div class="dashboard-report-note">Employee lookup and individual reports</div>
                        </div>
                    </a>
                }
            </div>
        </section>
    </div>

    <div class="dashboard-layout-grid dashboard-layout-grid--equal">
        <section class="dash-panel">
            <div class="dash-panel-header d-flex justify-content-between align-items-center">
                <span>Courses Needing Attention</span>
                <span class="dashboard-panel-subtitle">lowest progress and overdue tasks</span>
            </div>
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Tasks</th>
                            <th>Overdue</th>
                            <th>Completion</th>
                        </tr>
                    </thead>
                    <tbody id="course-attention-rows">
                        <tr><td colspan="4"><div class="dashboard-empty-state">Loading courses...</div></td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="dash-panel">
            <div class="dash-panel-header d-flex justify-content-between align-items-center">
                <span>Course Categories</span>
                <span class="dashboard-panel-subtitle">active courses by category</span>
            </div>
            <div class="dash-panel-body">
                <div id="category-mix-chart" class="dashboard-chart-sm is-loading">
                    <span class="skeleton skeleton-block w-100 h-100"></span>
                </div>
            </div>
        </section>
    </div>

    <section class="dash-panel">
        <div class="dash-panel-header d-flex justify-content-between align-items-center">
            <span>Recent Admin Activity</span>
            <span class="dashboard-panel-subtitle">latest create and update actions</span>
        </div>
        <div class="dash-panel-body" id="recent-admin-activities">
            <div class="text-muted small">Loading recent activity...</div>
        </div>
    </section>
</div>

@section ExternalDependencies {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}

@section Scripts {
    <script>
        let adminActivityConnection;

        const dashboardUrls = {
            assignmentReport: '@Url.Content("~/Assignments/Report/__id__")',
            courseDetail: '@Url.Action("Detail", "Courses", new { id = "__id__" })',
            categoryReport: '@Url.Content("~/Categories/Report/__id__")'
        };

        const dashboardStatIds = [
            'kpi-active-courses',
            'kpi-draft-courses',
            'kpi-resource-count',
            'kpi-active-assignments',
            'kpi-due-soon-tasks',
            'kpi-overdue-tasks',
            'kpi-assigned-learners',
            'kpi-completion-rate',
            'kpi-total-tasks',
            'kpi-learning-sessions',
            'kpi-session-delta'
        ];

        $(() => {
            showStatSkeleton(dashboardStatIds);
            loadDashboardOverview();
            loadMaintenanceStatus();
            loadRecentAdminActivities();
            initializeAdminActivitySignalR();

            setInterval(loadMaintenanceStatus, 5000);
            setInterval(loadRecentAdminActivities, 60000);
        });

        function loadDashboardOverview() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Overview`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                hideStatSkeleton(dashboardStatIds);

                if (!res || !res.success || !res.data) {
                    renderDashboardError();
                    return;
                }

                renderDashboard(res.data);
            }).fail(function() {
                hideStatSkeleton(dashboardStatIds);
                renderDashboardError();
            });
        }

        function renderDashboard(data) {
            const kpi = data.kpi || {};

            updateScope(data.scope || {});
            setText('kpi-active-courses', formatNumber(kpi.activeCourses));
            setText('kpi-draft-courses', formatNumber(kpi.draftCourses));
            setText('kpi-resource-count', formatNumber(kpi.resourceCount));
            setText('kpi-active-assignments', formatNumber(kpi.activeAssignmentBatches));
            setText('kpi-due-soon-tasks', formatNumber(kpi.dueSoonTasks));
            setText('kpi-overdue-tasks', formatNumber(kpi.overdueTasks));
            setText('kpi-assigned-learners', formatNumber(kpi.assignedLearners));
            setText('kpi-completion-rate', formatPercent(kpi.completionRate));
            setText('kpi-total-tasks', formatNumber(kpi.totalLearningTasks));
            setText('kpi-learning-sessions', formatNumber(kpi.learningSessionsLast30));
            setText('kpi-session-delta', formatDelta(kpi.learningSessionDelta));

            renderLearningActivityChart(data.learningActivity || []);
            renderTaskStatusChart(data.taskStatus || []);
            renderPriorityAssignments(data.priorityAssignments || []);
            renderCourseAttention(data.courseAttention || []);
            renderCategoryMix(data.categoryMix || []);
        }

        function renderDashboardError() {
            $('#learning-activity-chart, #task-status-chart, #category-mix-chart')
                .removeClass('is-loading')
                .html('<div class="dashboard-empty-state"><i class="fas fa-triangle-exclamation me-2" aria-hidden="true"></i>Failed to load dashboard data</div>');

            $('#priority-assignment-rows').html('<tr><td colspan="6"><div class="dashboard-empty-state">Failed to load assignments</div></td></tr>');
            $('#course-attention-rows').html('<tr><td colspan="4"><div class="dashboard-empty-state">Failed to load courses</div></td></tr>');
        }

        function updateScope(scope) {
            const isGlobal = scope.isGlobal === true;
            const divisionName = scope.divisionName || 'All divisions';
            const label = isGlobal ? 'All divisions' : divisionName;
            const icon = isGlobal ? 'fa-globe' : 'fa-building';

            $('#dashboard-scope-name').text(label);
            $('#dashboard-scope-pill').html(`<i class="fas ${icon} me-1" aria-hidden="true"></i>${escapeDashboardHtml(label)}`);
        }

        function renderLearningActivityChart(items) {
            const $chart = $('#learning-activity-chart').removeClass('is-loading').empty();

            $chart.dxChart({
                dataSource: items || [],
                series: {
                    argumentField: 'month',
                    valueField: 'sessions',
                    name: 'Sessions',
                    type: 'bar',
                    color: window.getAdminCssToken('--primary-mid'),
                    cornerRadius: 2
                },
                argumentAxis: {
                    label: { font: { color: window.getAdminCssToken('--text-secondary'), size: parseInt(window.adminTypography.size.xs, 10) } }
                },
                valueAxis: {
                    grid: { visible: true, color: window.getAdminCssToken('--border-color') },
                    label: { format: '#,##0', font: { color: window.getAdminCssToken('--text-secondary'), size: parseInt(window.adminTypography.size.xs, 10) } }
                },
                legend: { visible: false },
                margin: { top: 10, bottom: 0, left: 0, right: 0 },
                tooltip: {
                    enabled: true,
                    customizeTooltip: args => ({ text: `${args.valueText} sessions` })
                }
            });
        }

        function renderTaskStatusChart(items) {
            const data = (items || []).filter(item => Number(item.count || 0) > 0);
            const total = data.reduce((sum, item) => sum + Number(item.count || 0), 0);
            const $chart = $('#task-status-chart').removeClass('is-loading').empty();

            if (!total) {
                $chart.html('<div class="dashboard-empty-state">No assignment tasks in scope</div>');
                return;
            }

            $chart.dxPieChart(
                window.createAdminPieChartConfig({
                    palettePreset: 'status4Brand',
                    centerLabel: 'Tasks',
                    centerValue: formatNumber(total),
                    baseConfig: {
                        type: 'doughnut',
                        innerRadius: 0.66,
                        dataSource: data,
                        series: [{
                            argumentField: 'status',
                            valueField: 'count',
                            label: {
                                visible: true,
                                position: 'outside',
                                customizeText: point => `${point.valueText} (${point.percentText})`,
                                font: { size: parseInt(window.adminTypography.size.xs, 10), color: 'var(--text-secondary)' },
                                connector: { visible: true, width: 1 }
                            }
                        }],
                        legend: {
                            horizontalAlignment: 'center',
                            verticalAlignment: 'bottom',
                            margin: 8,
                            font: { size: parseInt(window.adminTypography.size.xs, 10), color: 'var(--text-secondary)' }
                        },
                        tooltip: { enabled: true }
                    }
                })
            );
        }

        function renderPriorityAssignments(items) {
            if (!items.length) {
                $('#priority-assignment-rows').html('<tr><td colspan="6"><div class="dashboard-empty-state">No active assignment reports in this scope</div></td></tr>');
                return;
            }

            const rows = items.map(item => {
                const reportUrl = dashboardUrls.assignmentReport.replace('__id__', encodeURIComponent(item.assignmentId));
                const statusClass = getStatusClass(item.status);
                const progressClass = getProgressClass(item.completionRate, item.overdueTasks);

                return `<tr>
                    <td>
                        <span class="dashboard-table-title">${escapeDashboardHtml(item.assignmentNo)}</span>
                        <span class="dashboard-table-note">${escapeDashboardHtml(item.description)}</span>
                    </td>
                    <td><span class="tag-pill ${statusClass}">${escapeDashboardHtml(item.status)}</span></td>
                    <td>${formatNumber(item.learnerCount)}</td>
                    <td>${formatDate(item.dueDate)}</td>
                    <td>${renderProgress(item.completionRate, progressClass)}</td>
                    <td>
                        <a href="${reportUrl}" class="action-link action-link-xs" aria-label="Open report for ${escapeDashboardHtml(item.assignmentNo)}">
                            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i> Open
                        </a>
                    </td>
                </tr>`;
            }).join('');

            $('#priority-assignment-rows').html(rows);
        }

        function renderCourseAttention(items) {
            if (!items.length) {
                $('#course-attention-rows').html('<tr><td colspan="4"><div class="dashboard-empty-state">No course risk data in this scope</div></td></tr>');
                return;
            }

            const rows = items.map(item => {
                const courseUrl = dashboardUrls.courseDetail.replace('__id__', encodeURIComponent(item.courseId));
                const progressClass = getProgressClass(item.completionRate, item.overdueTasks);

                return `<tr>
                    <td>
                        <a href="${courseUrl}" class="dashboard-table-title">${escapeDashboardHtml(item.courseCode)} - ${escapeDashboardHtml(item.courseTitle)}</a>
                        <span class="dashboard-table-note">${escapeDashboardHtml(item.categoryName)}</span>
                    </td>
                    <td>${formatNumber(item.learnerTasks)}</td>
                    <td>${formatNumber(item.overdueTasks)}</td>
                    <td>${renderProgress(item.completionRate, progressClass)}</td>
                </tr>`;
            }).join('');

            $('#course-attention-rows').html(rows);
        }

        function renderCategoryMix(items) {
            const data = items || [];
            const $chart = $('#category-mix-chart').removeClass('is-loading').empty();

            if (!data.length) {
                $chart.html('<div class="dashboard-empty-state">No active course categories in scope</div>');
                return;
            }

            $chart.dxChart({
                rotated: true,
                dataSource: data,
                series: {
                    argumentField: 'categoryName',
                    valueField: 'courseCount',
                    type: 'bar',
                    color: window.getAdminCssToken('--primary-mid'),
                    cornerRadius: 2
                },
                argumentAxis: {
                    label: {
                        wordWrap: 'normal',
                        overlappingBehavior: 'stagger',
                        font: { color: window.getAdminCssToken('--text-secondary'), size: parseInt(window.adminTypography.size.xs, 10) }
                    }
                },
                valueAxis: {
                    grid: { visible: true, color: window.getAdminCssToken('--border-color') },
                    label: { format: '#,##0', font: { color: window.getAdminCssToken('--text-secondary'), size: parseInt(window.adminTypography.size.xs, 10) } }
                },
                legend: { visible: false },
                tooltip: {
                    enabled: true,
                    customizeTooltip: args => ({ text: `${args.valueText} active courses` })
                },
                onPointClick: function(e) {
                    const categoryId = e.target.data.categoryId;
                    if (categoryId) {
                        window.location.href = dashboardUrls.categoryReport.replace('__id__', encodeURIComponent(categoryId));
                    }
                }
            });
        }

        function renderProgress(value, fillClass) {
            const percent = clampPercent(value);
            return `<div class="dashboard-progress">
                <div class="dashboard-progress-label">
                    <span>Progress</span>
                    <strong>${formatPercent(percent)}</strong>
                </div>
                <div class="dashboard-progress-track">
                    <div class="dashboard-progress-fill ${fillClass}" style="width:${percent}%;"></div>
                </div>
            </div>`;
        }

        function getProgressClass(value, overdueTasks) {
            if (Number(overdueTasks || 0) > 0) return 'is-danger';
            if (Number(value || 0) >= 90) return 'is-success';
            if (Number(value || 0) >= 50) return 'is-warning';
            return '';
        }

        function getStatusClass(status) {
            const key = String(status || '').toLowerCase().replace(/\s+/g, '-');
            return `dashboard-status-${key}`;
        }

        function clampPercent(value) {
            const number = Number(value || 0);
            if (!Number.isFinite(number)) return 0;
            return Math.max(0, Math.min(100, Math.round(number)));
        }

        function setText(id, value) {
            $(`#${id}`).text(value);
        }

        function formatNumber(value) {
            return window.formatAdminInteger(value, '0');
        }

        function formatPercent(value) {
            return window.formatAdminPercentage(value, '0%', { precision: Number(value) % 1 === 0 ? 0 : 1 });
        }

        function formatDelta(value) {
            const number = Number(value || 0);
            if (number > 0) return `+${formatNumber(number)}`;
            return formatNumber(number);
        }

        function formatDate(value) {
            return window.formatAdminDate(value, '-');
        }

        function escapeDashboardHtml(value) {
            if (typeof window.escapeAdminHtml === 'function') {
                return window.escapeAdminHtml(value || '');
            }

            return $('<div>').text(value || '').html();
        }

        function initializeAdminActivitySignalR() {
            if (typeof signalR === 'undefined') {
                return;
            }

            adminActivityConnection = new signalR.HubConnectionBuilder()
                .withUrl(`${serviceUrl.replace(/\/api$/, '')}/hubs/admin-activity`, {
                    withCredentials: true
                })
                .withAutomaticReconnect()
                .build();

            adminActivityConnection.on('AdminActivityCreated', function(activity) {
                prependRecentAdminActivity(activity);
            });

            adminActivityConnection.start().catch(function(err) {
                console.error('Failed to connect AdminActivity hub', err);
            });
        }

        function normalizeAdminActivity(item) {
            if (!item) return null;

            return {
                id: item.id ?? item.Id,
                title: item.title ?? item.Title ?? '',
                description: item.description ?? item.Description ?? '',
                createdBy: item.createdBy ?? item.CreatedBy ?? 'SYSTEM',
                createdAt: item.createdAt ?? item.CreatedAt,
                actionType: item.actionType ?? item.ActionType ?? '',
                entityType: item.entityType ?? item.EntityType ?? ''
            };
        }

        function renderRecentAdminActivityItem(item, index, totalCount) {
            const normalized = normalizeAdminActivity(item);
            if (!normalized) return '';

            const isLast = index === totalCount - 1;
            const borderClass = !isLast ? 'pb-3 mb-3 u-border-bottom' : '';

            return `
                <div class="d-flex align-items-start gap-3 ${borderClass}" data-activity-id="${normalized.id || ''}">
                    <div class="qa-icon qa-icon-accent flex-shrink-0 u-mt-2px">
                        <i class="fas fa-user-pen" aria-hidden="true"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="u-fs-12 u-fw-semibold">${escapeDashboardHtml(normalized.title)}</div>
                        <div class="u-fs-11 text-secondary">${escapeDashboardHtml(normalized.description || '')}</div>
                    </div>
                    <div class="text-end u-minw-120">
                        <div class="u-fs-11 u-fw-semibold">${escapeDashboardHtml(normalized.createdBy || 'SYSTEM')}</div>
                        <div class="u-fs-11 text-secondary">${formatRelativeTime(normalized.createdAt)}</div>
                    </div>
                </div>`;
        }

        function prependRecentAdminActivity(activity) {
            const normalized = normalizeAdminActivity(activity);
            if (!normalized) return;

            const wrapper = $('#recent-admin-activities');
            const existing = normalized.id ? wrapper.find(`[data-activity-id="${normalized.id}"]`) : $();
            if (existing.length) {
                existing.remove();
            }

            if (wrapper.find('.text-muted.small').length) {
                wrapper.empty();
            }

            const html = renderRecentAdminActivityItem(normalized, 0, 1);
            wrapper.prepend(html);

            const items = wrapper.children('[data-activity-id]');
            items.each(function(index) {
                const $item = $(this);
                const isLast = index === items.length - 1;
                $item.toggleClass('pb-3', !isLast)
                    .toggleClass('mb-3', !isLast)
                    .toggleClass('u-border-bottom', !isLast);
            });

            if (items.length > 10) {
                items.slice(10).remove();
            }
        }

        function loadRecentAdminActivities() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/RecentAdminActivities?take=10`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#recent-admin-activities');
                const items = res && res.success ? (res.data || []) : [];

                if (!items.length) {
                    wrapper.html('<div class="text-muted small text-center py-3"><i class="fas fa-clock-rotate-left me-1" aria-hidden="true"></i>No recent admin activity</div>');
                    return;
                }

                wrapper.html(items.map(function(item, index) {
                    return renderRecentAdminActivityItem(item, index, items.length);
                }).join(''));
            }).fail(function() {
                $('#recent-admin-activities').html('<div class="text-muted small text-center py-3"><i class="fas fa-triangle-exclamation me-1" aria-hidden="true"></i>Failed to load activity</div>');
            });
        }

        function loadMaintenanceStatus() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/MaintenanceStatus`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#maintenance-status-list');
                const operations = res && res.success && res.data ? (res.data.operations || []) : [];

                if (!operations.length) {
                    $('#maintenance-banner-row').addClass('is-hidden');
                    wrapper.empty();
                    return;
                }

                const cards = operations.map(function(op) {
                    const percent = op.totalItems > 0
                        ? Math.min(100, Math.round(((op.currentItem || 0) / op.totalItems) * 100))
                        : 0;
                    const currentItemName = op.currentItemName
                        ? `<div class="u-fs-11 text-secondary u-mt-4px">Current: ${escapeDashboardHtml(op.currentItemName)}</div>`
                        : '';

                    return `
                        <div class="maintenance-card rounded p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div class="u-fs-12 fw-bold u-text-warning-strong">${escapeDashboardHtml(op.operationName)}</div>
                                    <div class="u-fs-11 text-secondary">Step: ${escapeDashboardHtml(op.currentStep || 'Processing')}</div>
                                    ${currentItemName}
                                </div>
                                <span class="tag-pill alert">
                                    <i class="fas fa-gears me-1" aria-hidden="true"></i>${op.currentItem || 0} / ${op.totalItems || 0}
                                </span>
                            </div>
                            <div class="progress u-progress-xs u-progress-track-warning">
                                <div class="u-progress-fill-warning" style="width:${percent}%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-2 u-fs-11 text-secondary">
                                <span>Success: ${op.successCount || 0} | Failed: ${op.failureCount || 0}</span>
                                <span>By ${escapeDashboardHtml(op.initiatedBy || 'SYSTEM')}</span>
                            </div>
                        </div>`;
                }).join('');

                wrapper.html(cards);
                $('#maintenance-banner-row').removeClass('is-hidden');
            }).fail(function() {
                $('#maintenance-banner-row').addClass('is-hidden');
                $('#maintenance-status-list').empty();
            });
        }

        function formatRelativeTime(value) {
            if (!value) return '-';

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '-';

            return window.formatAdminRelativeTime(date, '-');
        }
    </script>
}
