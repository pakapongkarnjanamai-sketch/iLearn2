@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Admin Dashboard</h1>
        <div class="page-subtitle">Welcome back, <strong>@adminName</strong></div>
    </div>
    <a href="@Url.Action("Editor", "Courses")" class="action-link primary">
        <i class="fas fa-plus" aria-hidden="true"></i> New Course
    </a>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <div class="row g-3 mb-4" id="maintenance-banner-row" style="display:none;">
        <div class="col-12">
            <div class="dash-panel maintenance-card">
                <div class="dash-panel-header u-text-warning-strong">Maintenance In Progress</div>
                <div class="dash-panel-body">
                    <div id="maintenance-status-list"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card blue">
                <div class="ds-lbl">Active Courses</div>
                <div class="ds-val" id="count-active-courses">0</div>
                <div class="ds-link">View All <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card yellow">
                <div class="ds-lbl">Draft Courses</div>
                <div class="ds-val" id="count-draft-courses">0</div>
                <div class="ds-link">Review <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Assignments")" class="dash-stat-card green">
                <div class="ds-lbl">Total Assignments (In Progress)</div>
                <div class="ds-val" id="count-inprogress-assignments">0</div>
                <div class="ds-link">View <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Resources")" class="dash-stat-card purple">
                <div class="ds-lbl">Resources</div>
                <div class="ds-val" id="count-resources">0</div>
                <div class="ds-link">Library <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i></div>
            </a>
        </div>
    </div>

    <!-- ── Chart + Quick Actions ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="dash-panel h-100">
                <div class="dash-panel-header d-flex justify-content-between align-items-center">
                    <span>Learning Activity Trends</span>
                    <span class="u-fs-11 text-secondary u-fw-normal">learning sessions per month (last 6 months)</span>
                </div>
                <div class="dash-panel-body">
                    <div id="learningActivityChartSkeleton" style="height:300px; padding:16px 0;">
                        <div class="skeleton skeleton-block mb-2" style="height:200px; border-radius:4px;"></div>
                        <div class="d-flex gap-2 justify-content-center">
                            <div class="skeleton skeleton-line w-40" style="height:10px;"></div>
                            <div class="skeleton skeleton-line w-40" style="height:10px;"></div>
                        </div>
                    </div>
                    <div id="learningActivityChart" style="height:300px; display:none;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dash-panel h-100">
                <div class="dash-panel-header">Quick Actions</div>
                <div class="dash-panel-body d-flex flex-column gap-2">

                    <a href="@Url.Action("Index", "Courses")" class="quick-action">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-book" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Course Manager</div>
                            <div class="u-fs-11 text-secondary">Create &amp; manage courses</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Assignments")" class="quick-action">
                        <div class="qa-icon qa-icon-warning"><i class="fas fa-tasks" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Assignments</div>
                            <div class="u-fs-11 text-secondary">Bulk course assignment</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Students")" class="quick-action">
                        <div class="qa-icon qa-icon-success"><i class="fas fa-user-graduate" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Students</div>
                            <div class="u-fs-11 text-secondary">Browse &amp; manage learners</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Resources")" class="quick-action">
                        <div class="qa-icon qa-icon-purple"><i class="fas fa-folder-open" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Resources</div>
                            <div class="u-fs-11 text-secondary">Manage learning materials</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "StudentGroups")" class="quick-action">
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-users" aria-hidden="true"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Student Groups</div>
                            <div class="u-fs-11 text-secondary">Organise learner groups</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- ── System Status + Notices ── -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">System Status</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-center pb-3 mb-3 u-border-bottom">
                        <div class="flex-grow-1">
                            <div class="u-fs-12 u-fw-semibold">Database Connection</div>
                            <div class="u-fs-11 text-secondary">API Server Status</div>
                        </div>
                        <span class="tag-pill active"><i class="fas fa-check-circle me-1" aria-hidden="true"></i>Active</span>
                    </div>

                    <div class="d-flex align-items-center pb-3 mb-3 u-border-bottom">
                        <div class="flex-grow-1">
                            <div class="u-fs-12 u-fw-semibold">Authentication Service</div>
                            <div class="u-fs-11 text-secondary">User Login System</div>
                        </div>
                        <span class="tag-pill active"><i class="fas fa-check-circle me-1" aria-hidden="true"></i>Running</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="u-fs-12 u-fw-semibold">File Storage Service</div>
                            <div class="u-fs-11 text-secondary">Resource Upload System</div>
                        </div>
                        <span class="tag-pill active"><i class="fas fa-check-circle me-1" aria-hidden="true"></i>Operational</span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">Important Notices</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3 u-border-bottom">
                        <div class="qa-icon qa-icon-accent flex-shrink-0 u-mt-2px">
                            <i class="fas fa-info-circle" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Course Content Updated</div>
                            <div class="u-fs-11 text-secondary">5 courses have been updated in the last 7 days</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3 u-border-bottom">
                        <div class="qa-icon qa-icon-warning flex-shrink-0 u-mt-2px">
                            <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Pending Course Reviews</div>
                            <div class="u-fs-11 text-secondary">
                                <span id="pending-count" class="fw-bold">0</span> draft courses waiting for approval
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="qa-icon qa-icon-success flex-shrink-0 u-mt-2px">
                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                        </div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">All Systems Operational</div>
                            <div class="u-fs-11 text-secondary">Last backup completed 2 hours ago</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="dash-panel">
                <div class="dash-panel-header d-flex justify-content-between align-items-center">
                    <span>Recent Admin Activity</span>
                    <span class="u-fs-11 text-secondary u-fw-normal">latest create / update actions</span>
                </div>
                <div class="dash-panel-body" id="recent-admin-activities">
                    <div class="text-muted small">Loading recent activity...</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section ExternalDependencies {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
}

@section Scripts {
    <script>
        let adminActivityConnection;

        $(() => {
            loadDashboardStats();
            loadLearningActivityTrends();
            loadMaintenanceStatus();
            loadRecentAdminActivities();
            initializeAdminActivitySignalR();
            setInterval(loadMaintenanceStatus, 5000);
            setInterval(loadRecentAdminActivities, 60000);

            showStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
        });

        function initializeAdminActivitySignalR() {
            if (typeof signalR === 'undefined') {
                return;
            }

            adminActivityConnection = new signalR.HubConnectionBuilder()
                .withUrl(`${serviceUrl.replace(/\/api$/, '')}/hubs/admin-activity`, {
                    withCredentials: true
                })
                .withAutomaticReconnect()
                .build();

            adminActivityConnection.on('AdminActivityCreated', function(activity) {
                prependRecentAdminActivity(activity);
            });

            adminActivityConnection.start().catch(function(err) {
                console.error('Failed to connect AdminActivity hub', err);
            });
        }

        function normalizeAdminActivity(item) {
            if (!item) return null;

            return {
                id: item.id ?? item.Id,
                title: item.title ?? item.Title ?? '',
                description: item.description ?? item.Description ?? '',
                createdBy: item.createdBy ?? item.CreatedBy ?? 'SYSTEM',
                createdAt: item.createdAt ?? item.CreatedAt,
                actionType: item.actionType ?? item.ActionType ?? '',
                entityType: item.entityType ?? item.EntityType ?? ''
            };
        }

        function renderRecentAdminActivityItem(item, index, totalCount) {
            const normalized = normalizeAdminActivity(item);
            if (!normalized) return '';

            const isLast = index === totalCount - 1;
            const borderClass = !isLast ? 'pb-3 mb-3 u-border-bottom' : '';

            return `
                <div class="d-flex align-items-start gap-3 ${borderClass}" data-activity-id="${normalized.id || ''}">
                    <div class="qa-icon qa-icon-accent flex-shrink-0 u-mt-2px">
                        <i class="fas fa-user-pen"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="u-fs-12 u-fw-semibold">${escapeHtml(normalized.title)}</div>
                        <div class="u-fs-11 text-secondary">${escapeHtml(normalized.description || '')}</div>
                    </div>
                    <div class="text-end u-minw-120">
                        <div class="u-fs-11 u-fw-semibold">${escapeHtml(normalized.createdBy || 'SYSTEM')}</div>
                        <div class="u-fs-11 text-secondary">${formatRelativeTime(normalized.createdAt)}</div>
                    </div>
                </div>`;
        }

        function prependRecentAdminActivity(activity) {
            const normalized = normalizeAdminActivity(activity);
            if (!normalized) return;

            const wrapper = $('#recent-admin-activities');
            const existing = normalized.id ? wrapper.find(`[data-activity-id="${normalized.id}"]`) : $();
            if (existing.length) {
                existing.remove();
            }

            if (wrapper.find('.text-muted.small').length) {
                wrapper.empty();
            }

            const html = renderRecentAdminActivityItem(normalized, 0, 1);
            wrapper.prepend(html);

            const items = wrapper.children('[data-activity-id]');
            items.each(function(index) {
                const $item = $(this);
                const isLast = index === items.length - 1;
                $item.toggleClass('pb-3', !isLast)
                    .toggleClass('mb-3', !isLast)
                    .toggleClass('u-border-bottom', !isLast);
            });

            if (items.length > 10) {
                items.slice(10).remove();
            }
        }

        function loadRecentAdminActivities() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/RecentAdminActivities?take=10`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#recent-admin-activities');
                const items = res && res.success ? (res.data || []) : [];

                if (!items.length) {
                    wrapper.html('<div class="text-muted small text-center py-3"><i class="fas fa-clock-rotate-left me-1"></i>No recent admin activity</div>');
                    return;
                }

                wrapper.html(items.map(function(item, index) {
                    return renderRecentAdminActivityItem(item, index, items.length);
                }).join(''));
            }).fail(function() {
                $('#recent-admin-activities').html('<div class="text-muted small text-center py-3"><i class="fas fa-triangle-exclamation me-1"></i>Failed to load activity</div>');
            });
        }

        function loadMaintenanceStatus() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/MaintenanceStatus`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#maintenance-status-list');
                const operations = res && res.success && res.data ? (res.data.operations || []) : [];

                if (!operations.length) {
                    $('#maintenance-banner-row').hide();
                    wrapper.empty();
                    return;
                }

                const cards = operations.map(function(op) {
                    const percent = op.totalItems > 0
                        ? Math.min(100, Math.round(((op.currentItem || 0) / op.totalItems) * 100))
                        : 0;
                    const currentItemName = op.currentItemName
                        ? `<div class="u-fs-11 text-secondary u-mt-4px">Current: ${escapeHtml(op.currentItemName)}</div>`
                        : '';

                    return `
                        <div class="maintenance-card rounded p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div class="u-fs-12 fw-bold u-text-warning-strong">${escapeHtml(op.operationName)}</div>
                                    <div class="u-fs-11 text-secondary">Step: ${escapeHtml(op.currentStep || 'Processing')}</div>
                                    ${currentItemName}
                                </div>
                                <span class="tag-pill alert">
                                    <i class="fas fa-gears me-1"></i>${op.currentItem || 0} / ${op.totalItems || 0}
                                </span>
                            </div>
                            <div class="progress u-progress-xs u-progress-track-warning">
                                <div class="u-progress-fill-warning" style="width:${percent}%;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-2 u-fs-11 text-secondary">
                                <span>Success: ${op.successCount || 0} | Failed: ${op.failureCount || 0}</span>
                                <span>By ${escapeHtml(op.initiatedBy || 'SYSTEM')}</span>
                            </div>
                        </div>`;
                }).join('');

                wrapper.html(cards);
                $('#maintenance-banner-row').show();
            }).fail(function() {
                $('#maintenance-banner-row').hide();
                $('#maintenance-status-list').empty();
            });
        }

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function formatRelativeTime(value) {
            if (!value) return '—';

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '—';

            return window.formatAdminRelativeTime(date, '—');
        }

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    hideStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
                    if (res.success && res.data) {
                        animateCount('count-active-courses',        res.data.activeCourses          || 0);
                        animateCount('count-draft-courses',          res.data.draftCourses            || 0);
                        animateCount('count-inprogress-assignments', res.data.inProgressAssignments   || 0);
                        animateCount('count-resources',              res.data.totalResources          || 0);
                        $('#pending-count').text(res.data.draftCourses || 0);
                    }
                },
                error: function (err) {
                    hideStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-inprogress-assignments, #count-resources').text("0");
                }
            });
        }

        function loadLearningActivityTrends() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/LearningActivityTrends`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    initLearningActivityChart(res.success && res.data ? res.data : []);
                },
                error: function (err) {
                    console.error("Failed to load learning activity trends", err);
                    initLearningActivityChart([]);
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if (value === 0) { $el.text("0"); return; }

            $({ counter: 0 }).animate({ counter: value }, {
                duration: 1200,
                easing: 'swing',
                step: function () { $el.text(Math.ceil(this.counter)); },
                complete: function () { $el.text(value); }
            });
        }

        function initLearningActivityChart(chartData) {
            $('#learningActivityChartSkeleton').hide();
            $('#learningActivityChart').show().dxChart({
                dataSource: chartData,
                series: {
                    argumentField: "month",
                    valueField: "sessions",
                    name: "Sessions",
                    type: "bar",
                    color: window.getAdminCssToken('--brand-mid'),
                    cornerRadius: 2
                },
                argumentAxis: {
                    label: { font: { color: window.getAdminCssToken('--text-secondary'), size: 11 } }
                },
                valueAxis: {
                    grid: { visible: true, color: window.getAdminCssToken('--border-color') },
                    label: { format: "#,##0", font: { color: window.getAdminCssToken('--text-secondary'), size: 11 } }
                },
                legend: { visible: false },
                margin: { top: 10, bottom: 0, left: 0, right: 0 },
                tooltip: {
                    enabled: true,
                    customizeTooltip: (args) => ({ text: args.valueText + " sessions" })
                }
            });
        }
    </script>
}