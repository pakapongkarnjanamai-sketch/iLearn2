@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Admin Dashboard</div>
        <div class="page-subtitle">Welcome back, <strong>@adminName</strong></div>
    </div>
    <a href="@Url.Action("Form", "Courses")" class="action-link primary">
        <i class="fas fa-plus"></i> New Course
    </a>
</div>

<div class="container-fluid px-4 py-4" style="max-width:1400px;">

    <!-- ── Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card blue">
                <div class="ds-lbl">Active Courses</div>
                <div class="ds-val" id="count-active-courses">0</div>
                <div class="ds-link" style="color:var(--accent-color);">View All <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card yellow">
                <div class="ds-lbl">Draft Courses</div>
                <div class="ds-val" id="count-draft-courses">0</div>
                <div class="ds-link" style="color:var(--warning-color);">Review <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Users")" class="dash-stat-card green">
                <div class="ds-lbl">Total Employees</div>
                <div class="ds-val" id="count-users">0</div>
                <div class="ds-link" style="color:var(--success-color);">Manage <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Resources")" class="dash-stat-card purple">
                <div class="ds-lbl">Resources</div>
                <div class="ds-val" id="count-resources">0</div>
                <div class="ds-link" style="color:#722ed1;">Library <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
    </div>

    <!-- ── Chart + Quick Actions ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="dash-panel h-100">
                <div class="dash-panel-header">Enrollment Trends</div>
                <div class="dash-panel-body">
                    <div id="enrollmentChart" style="height:300px;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dash-panel h-100">
                <div class="dash-panel-header">Quick Actions</div>
                <div class="dash-panel-body d-flex flex-column gap-2">

                    <a href="@Url.Action("Index", "Courses")" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);"><i class="fas fa-book"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Course Manager</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Create &amp; manage courses</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Enrollments")" class="quick-action">
                        <div class="qa-icon" style="background:#f6ffed; color:var(--success-color);"><i class="fas fa-user-check"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Enrollments</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Track course assignments</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Assignments")" class="quick-action">
                        <div class="qa-icon" style="background:var(--bg-light); color:var(--text-secondary);"><i class="fas fa-tasks"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Assignments</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Bulk course assignment</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "LearningLogs")" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);"><i class="fas fa-chart-bar"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Learning Logs</div>
                            <div style="font-size:11px; color:var(--text-secondary);">View progress &amp; scores</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- ── System Status + Notices ── -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">System Status</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-center pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">Database Connection</div>
                            <div style="font-size:11px; color:var(--text-secondary);">API Server Status</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Active</span>
                    </div>

                    <div class="d-flex align-items-center pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">Authentication Service</div>
                            <div style="font-size:11px; color:var(--text-secondary);">User Login System</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Running</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">File Storage Service</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Resource Upload System</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Operational</span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">Important Notices</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="qa-icon flex-shrink-0" style="background:#e6f4ff; color:var(--accent-color); margin-top:2px;">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Course Content Updated</div>
                            <div style="font-size:11px; color:var(--text-secondary);">5 courses have been updated in the last 7 days</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="qa-icon flex-shrink-0" style="background:#fffbe6; color:var(--warning-color); margin-top:2px;">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Pending Course Reviews</div>
                            <div style="font-size:11px; color:var(--text-secondary);">
                                <span id="pending-count" class="fw-bold">0</span> draft courses waiting for approval
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="qa-icon flex-shrink-0" style="background:#f6ffed; color:var(--success-color); margin-top:2px;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">All Systems Operational</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Last backup completed 2 hours ago</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(() => {
            loadDashboardStats();
            loadEnrollmentTrends();
        });

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    if (res.success && res.data) {
                        animateCount('count-active-courses', res.data.activeCourses || 0);
                        animateCount('count-draft-courses',  res.data.draftCourses  || 0);
                        animateCount('count-users',          res.data.totalUsers    || 0);
                        animateCount('count-resources',      res.data.totalResources || 0);
                        $('#pending-count').text(res.data.draftCourses || 0);
                    }
                },
                error: function (err) {
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-users, #count-resources').text("0");
                }
            });
        }

        function loadEnrollmentTrends() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/EnrollmentTrends`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    initEnrollmentChart(res.success && res.data ? res.data : []);
                },
                error: function (err) {
                    console.error("Failed to load enrollment trends", err);
                    initEnrollmentChart([]);
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if (value === 0) { $el.text("0"); return; }

            $({ counter: 0 }).animate({ counter: value }, {
                duration: 1200,
                easing: 'swing',
                step: function () { $el.text(Math.ceil(this.counter)); },
                complete: function () { $el.text(value); }
            });
        }

        function initEnrollmentChart(chartData) {
            $("#enrollmentChart").dxChart({
                dataSource: chartData,
                series: {
                    argumentField: "month",
                    valueField: "enrollments",
                    name: "Enrollments",
                    type: "bar",
                    color: "#1890ff",
                    cornerRadius: 2
                },
                argumentAxis: {
                    label: { font: { color: "#595959", size: 11 } }
                },
                valueAxis: {
                    grid: { visible: true, color: "#f0f0f0" },
                    label: { format: "#,##0", font: { color: "#595959", size: 11 } }
                },
                legend: { visible: false },
                margin: { top: 10, bottom: 0, left: 0, right: 0 },
                tooltip: {
                    enabled: true,
                    customizeTooltip: (args) => ({ text: args.valueText + " enrollments" })
                }
            });
        }
    </script>
}