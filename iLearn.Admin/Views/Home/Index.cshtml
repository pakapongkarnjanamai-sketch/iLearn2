@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
    var profileImage = "https://ui-avatars.com/api/?name=" + adminName + "&background=0d6efd&color=fff&size=128";
}

<style>
    /* Minimal Background */
    body {
        background-color: #f8f9fa;
    }

    /* Hover Effects for Stat Cards */
    .stat-card-hover {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
    }

        .stat-card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }

            .stat-card-hover:hover .stat-link i {
                transform: translateX(4px);
            }

    .stat-link i {
        transition: transform 0.2s ease;
    }

    /* Large Icon Box for Stat Cards */
    .icon-box-lg {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        flex-shrink: 0;
    }

    /* Quick Action Item Styles */
    .action-item {
        display: flex;
        align-items: flex-start;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        margin-bottom: 0.5rem;
    }

        .action-item:last-child {
            margin-bottom: 0;
        }

        .action-item:hover {
            background-color: #f8fbff;
            border-color: #0d6efd;
        }

    .action-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        margin-right: 1rem;
        flex-shrink: 0;
        font-size: 1.25rem;
    }

    /* Custom Badges */
    .activity-badge {
        display: inline-block;
        padding: 0.35rem 0.85rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <img src="@profileImage" class="rounded-circle border border-2 border-white shadow-sm" width="56" height="56" alt="Profile">
            <div>
                <h1 class="h4 mb-1 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted fw-medium mb-0">
                    Welcome back, <strong class="text-dark">@adminName</strong>
                    <span class="mx-2 text-light">•</span>
                    <i class="far fa-calendar me-1"></i> @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                </small>
            </div>
        </div>
        <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded-3 shadow-sm px-4 py-2 d-flex align-items-center gap-2 fw-medium">
            <i class="fas fa-plus"></i> New Course
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5">

    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="card border-0 shadow-sm rounded-4 h-100 stat-card-hover d-block">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase small mb-2" style="letter-spacing: 0.5px;">Active Courses</div>
                        <div class="fs-1 fw-bold text-dark lh-1" id="count-active-courses">0</div>
                        <div class="stat-link text-primary small fw-bold mt-3 d-flex align-items-center gap-1">
                            View All <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="icon-box-lg bg-primary bg-opacity-10 text-primary fs-3">
                        <i class="fas fa-book-reader"></i>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="card border-0 shadow-sm rounded-4 h-100 stat-card-hover d-block">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase small mb-2" style="letter-spacing: 0.5px;">Draft Courses</div>
                        <div class="fs-1 fw-bold text-dark lh-1" id="count-draft-courses">0</div>
                        <div class="stat-link text-warning small fw-bold mt-3 d-flex align-items-center gap-1">
                            Review <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="icon-box-lg bg-warning bg-opacity-10 text-warning fs-3">
                        <i class="fas fa-pen-nib"></i>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Users")" class="card border-0 shadow-sm rounded-4 h-100 stat-card-hover d-block">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase small mb-2" style="letter-spacing: 0.5px;">Total Employees</div>
                        <div class="fs-1 fw-bold text-dark lh-1" id="count-users">0</div>
                        <div class="stat-link text-info small fw-bold mt-3 d-flex align-items-center gap-1">
                            Manage <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="icon-box-lg bg-info bg-opacity-10 text-info fs-3">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Resources")" class="card border-0 shadow-sm rounded-4 h-100 stat-card-hover d-block">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-bold text-uppercase small mb-2" style="letter-spacing: 0.5px;">Resources</div>
                        <div class="fs-1 fw-bold text-dark lh-1" id="count-resources">0</div>
                        <div class="stat-link small fw-bold mt-3 d-flex align-items-center gap-1" style="color: #6f42c1;">
                            Library <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                    <div class="icon-box-lg bg-opacity-10 fs-3" style="background-color: #f8f0ff; color: #6f42c1;">
                        <i class="fas fa-folder-open"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-chart-line text-primary me-2"></i> Enrollment Trends
                    </h6>
                </div>
                <div class="card-body p-4 flex-grow-1">
                    <div id="enrollmentChart" style="height: 320px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-zap text-warning me-2"></i> Quick Actions
                    </h6>
                </div>
                <div class="card-body p-3 flex-grow-1">

                    <a href="@Url.Action("Index", "Courses")" class="action-item">
                        <div class="action-icon bg-primary bg-opacity-10 text-primary">
                            <i class="fas fa-book"></i>
                        </div>
                        <div class="action-content mt-1">
                            <h6 class="mb-1 fw-bold text-dark" style="font-size: 0.95rem;">Course Manager</h6>
                            <small class="text-muted fw-medium">Create & manage courses</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Enrollments")" class="action-item">
                        <div class="action-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div class="action-content mt-1">
                            <h6 class="mb-1 fw-bold text-dark" style="font-size: 0.95rem;">Enrollments</h6>
                            <small class="text-muted fw-medium">Track course assignments</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Assignments")" class="action-item">
                        <div class="action-icon bg-secondary bg-opacity-10 text-secondary">
                            <i class="fas fa-tasks"></i>
                        </div>
                        <div class="action-content mt-1">
                            <h6 class="mb-1 fw-bold text-dark" style="font-size: 0.95rem;">Auto-Assignments</h6>
                            <small class="text-muted fw-medium">Bulk course assignment</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "LearningLogs")" class="action-item">
                        <div class="action-icon bg-info bg-opacity-10 text-info">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                        <div class="action-content mt-1">
                            <h6 class="mb-1 fw-bold text-dark" style="font-size: 0.95rem;">Learning Logs</h6>
                            <small class="text-muted fw-medium">View progress & scores</small>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-server text-success me-2"></i> System Status
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom border-light">
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark mb-1">Database Connection</div>
                            <small class="text-muted fw-medium">API Server Status</small>
                        </div>
                        <span class="activity-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                            <i class="fas fa-check-circle me-1"></i> Active
                        </span>
                    </div>

                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom border-light">
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark mb-1">Authentication Service</div>
                            <small class="text-muted fw-medium">User Login System</small>
                        </div>
                        <span class="activity-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                            <i class="fas fa-check-circle me-1"></i> Running
                        </span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark mb-1">File Storage Service</div>
                            <small class="text-muted fw-medium">Resource Upload System</small>
                        </div>
                        <span class="activity-badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                            <i class="fas fa-check-circle me-1"></i> Operational
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-bell text-warning me-2"></i> Important Notices
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3 pb-3 border-bottom border-light">
                        <div class="d-flex align-items-start gap-3">
                            <div class="icon-box bg-info bg-opacity-10 text-info px-2 py-2 rounded-3 mt-1">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <div style="flex: 1;">
                                <div class="fw-bold text-dark mb-1">Course Content Updated</div>
                                <small class="text-muted fw-medium">5 courses have been updated in the last 7 days</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 pb-3 border-bottom border-light">
                        <div class="d-flex align-items-start gap-3">
                            <div class="icon-box bg-warning bg-opacity-10 text-warning px-2 py-2 rounded-3 mt-1">
                                <i class="fas fa-exclamation-circle"></i>
                            </div>
                            <div style="flex: 1;">
                                <div class="fw-bold text-dark mb-1">Pending Course Reviews</div>
                                <small class="text-muted fw-medium">You have <span id="pending-count" class="fw-bold">0</span> draft courses waiting for approval</small>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex align-items-start gap-3">
                            <div class="icon-box bg-success bg-opacity-10 text-success px-2 py-2 rounded-3 mt-1">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div style="flex: 1;">
                                <div class="fw-bold text-dark mb-1">All Systems Operational</div>
                                <small class="text-muted fw-medium">Last backup completed 2 hours ago</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(() => {
            loadDashboardStats();
            initEnrollmentChart();
        });

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    if (res.success && res.data) {
                        animateCount('count-active-courses', res.data.activeCourses || 0);
                        animateCount('count-draft-courses', res.data.draftCourses || 0);
                        animateCount('count-users', res.data.totalUsers || 0);
                        animateCount('count-resources', res.data.totalResources || 0);

                        // Update pending count in notices
                        $('#pending-count').text(res.data.draftCourses || 0);
                    }
                },
                error: function (err) {
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-users, #count-resources').text("0");
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if(value === 0) {
                $el.text("0");
                return;
            }

            $({ counter: 0 }).animate({
                counter: value
            }, {
                duration: 1200,
                easing: 'swing',
                step: function () {
                    $el.text(Math.ceil(this.counter));
                },
                complete: function() {
                    $el.text(value);
                }
            });
        }

        function initEnrollmentChart() {
            const chartData = [
                { month: "Aug", enrollments: 120 },
                { month: "Sep", enrollments: 150 },
                { month: "Oct", enrollments: 190 },
                { month: "Nov", enrollments: 140 },
                { month: "Dec", enrollments: 250 },
                { month: "Jan", enrollments: 300 }
            ];

            $("#enrollmentChart").dxChart({
                dataSource: chartData,
                palette: ["#0d6efd"],
                margin: { top: 20, bottom: 0, left: 0, right: 0 }, // ปรับให้กราฟสวยขึ้นใน Card
                series: {
                    argumentField: "month",
                    valueField: "enrollments",
                    name: "Enrollments",
                    type: "bar",
                    color: "#0d6efd",
                    cornerRadius: 4 // มุมของแท่งกราฟมนขึ้นนิดหน่อย
                },
                argumentAxis: {
                    label: { overlappingBehavior: "stagger", font: { color: "#6c7c93", weight: 500 } }
                },
                valueAxis: {
                    grid: { visible: true, color: "#f0f0f0" },
                    label: { format: "#,##0", font: { color: "#6c7c93", weight: 500 } }
                },
                legend: { visible: false },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function(args) {
                        return { text: args.valueText + " enrollments" };
                    }
                }
            });
        }
    </script>
}