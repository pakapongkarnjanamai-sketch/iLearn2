@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
    var profileImage = "https://ui-avatars.com/api/?name=" + adminName + "&background=0062cc&color=fff&size=128";
}

<div class="page-header px-4 py-3 d-flex justify-content-between align-items-center flex-wrap">
    <div class="d-flex align-items-center gap-3">
        <img src="@profileImage" class="rounded-circle shadow-sm border border-2 border-white" width="48" height="48" alt="Profile">
        <div>
            <h1 class="page-title mb-0">Dashboard</h1>
            <p class="text-muted small mb-0 mt-1">
                Welcome back, <strong>@adminName</strong>
                <span class="mx-2 text-primary">•</span>
                <span><i class="far fa-clock me-1"></i> @DateTime.Now.ToString("D")</span>
            </p>
        </div>
    </div>
    <div class="mt-3 mt-md-0">
        <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded shadow-sm px-3">
            <i class="fas fa-plus me-1"></i> Create New Course
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-4">

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid var(--brand-color) !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Active Courses</div>
                        <div class="h3 mb-0 fw-bold text-dark" id="count-active-courses">...</div>
                    </div>
                    <div class="text-primary opacity-50">
                        <i class="fas fa-book-reader fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="@Url.Action("Index", "Courses")" class="text-primary text-decoration-none small fw-bold">View Courses <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-xl-0">
            <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #ffc107 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Draft Courses</div>
                        <div class="h3 mb-0 fw-bold text-dark" id="count-draft-courses">...</div>
                    </div>
                    <div class="text-warning opacity-50">
                        <i class="fas fa-pen-nib fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="@Url.Action("Drafts", "Courses")" class="text-warning text-decoration-none small fw-bold">Review Drafts <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3 mb-md-0">
            <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #17a2b8 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Total Employees</div>
                        <div class="h3 mb-0 fw-bold text-dark" id="count-users">...</div>
                    </div>
                    <div class="text-info opacity-50">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="@Url.Action("Index", "Users")" class="text-info text-decoration-none small fw-bold">Manage Users <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="border-left: 4px solid #6f42c1 !important;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Resources Files</div>
                        <div class="h3 mb-0 fw-bold text-dark" id="count-resources">...</div>
                    </div>
                    <div class="opacity-50" style="color: #6f42c1;">
                        <i class="fas fa-folder-open fa-2x"></i>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a href="@Url.Action("Index", "Resources")" class="text-decoration-none small fw-bold" style="color: #6f42c1;">Detail Resources <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-bold text-dark py-3">
                    <i class="fas fa-chart-line text-primary me-2"></i> Enrollments Overview
                </div>
                <div class="card-body">
                    <div id="enrollmentChart" style="height: 350px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom fw-bold text-dark py-3">
                    <i class="fas fa-bolt text-warning me-2"></i> Quick Management
                </div>
                <div class="card-body p-2" style="max-height: 350px; overflow-y: auto;">
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("Index", "Courses")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light">
                            <i class="fas fa-chalkboard-teacher text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Course Manager</h6>
                                <small class="text-muted">Create, edit and manage training courses.</small>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "Enrollments")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light">
                            <i class="fas fa-user-graduate text-success fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Enrollments</h6>
                                <small class="text-muted">Monitor employee course enrollments.</small>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "LearningLogs")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded mb-1 bg-light">
                            <i class="fas fa-chart-line text-info fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Learning Logs</h6>
                                <small class="text-muted">View detailed learning history and scores.</small>
                            </div>
                        </a>

                        <a href="@Url.Action("Index", "AssignmentRules")" class="list-group-item list-group-item-action d-flex align-items-center py-3 border-0 rounded bg-light">
                            <i class="fas fa-cogs text-secondary fs-4 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Auto-Assign Rules</h6>
                                <small class="text-muted">Set rules for automatic course assignment.</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(() => {
            // โหลดข้อมูลตัวเลขจาก API เดิม
            loadDashboardStats();

            // สร้างกราฟจำลองการลงทะเบียน (สามารถต่อกับ API ได้ในอนาคต)
            initEnrollmentChart();
        });

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    if (res.success && res.data) {
                        animateCount('count-active-courses', res.data.activeCourses);
                        animateCount('count-draft-courses', res.data.draftCourses);
                        animateCount('count-users', res.data.totalUsers);
                        animateCount('count-resources', res.data.totalResources);
                    }
                },
                error: function (err) {
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-users, #count-resources').text("-");
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if(value === 0) {
                $el.text("0");
                return;
            }

            $({ Counter: 0 }).animate({
                Counter: value
            }, {
                duration: 800,
                easing: 'swing',
                step: function (now) {
                    $el.text(Math.ceil(now));
                },
                complete: function() {
                     $el.text(value);
                }
            });
        }

        function initEnrollmentChart() {
            // ข้อมูลจำลองสำหรับแสดงกราฟ DevExtreme
            const chartData = [
                { month: "Aug", enrollments: 120 },
                { month: "Sep", enrollments: 150 },
                { month: "Oct", enrollments: 190 },
                { month: "Nov", enrollments: 140 },
                { month: "Dec", enrollments: 250 },
                { month: "Jan", enrollments: 300 }
            ];

            $("#enrollmentChart").dxChart({
                dataSource: chartData,
                palette: "Office",
                series: {
                    argumentField: "month",
                    valueField: "enrollments",
                    name: "Enrollments",
                    type: "bar",
                    color: "var(--brand-color)"
                },
                legend: { visible: false },
                tooltip: {
                    enabled: true,
                    format: { type: "largeNumber", precision: 0 }
                }
            });
        }
    </script>
}