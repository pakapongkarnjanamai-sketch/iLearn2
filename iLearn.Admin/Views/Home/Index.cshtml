@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
    var profileImage = "https://ui-avatars.com/api/?name=" + adminName + "&background=0d6efd&color=fff&size=128";
}

<style>
    /* Dashboard minimal white theme */
    body {
        background-color: #ffffff;
    }

    /* Header styling */
    .dashboard-header {
        background-color: #ffffff;
        border-bottom: 1px solid #e8ecf1;
        padding: 2rem 0;
        margin-bottom: 2rem;
    }

    /* Stats cards */
    .stat-card {
        background-color: #ffffff;
        border: 1px solid #e8ecf1;
        border-radius: 12px;
        transition: all 0.3s ease;
        height: 100%;
    }

    .stat-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
    }

    .stat-card .card-body {
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background-color: #f8fbff;
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6c7c93;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1a3a52;
        line-height: 1;
    }

    .stat-link {
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        transition: gap 0.2s ease;
    }

    .stat-link:hover {
        gap: 0.75rem;
    }

    /* Chart card */
    .chart-card {
        background-color: #ffffff;
        border: 1px solid #e8ecf1;
        border-radius: 12px;
        height: 100%;
    }

    .chart-card .card-header {
        background-color: #ffffff;
        border-bottom: 1px solid #e8ecf1;
        padding: 1.25rem;
        border-radius: 12px 12px 0 0;
    }

    .chart-card .card-header h6 {
        color: #1a3a52;
        font-weight: 600;
        margin: 0;
    }

    .chart-card .card-body {
        padding: 1.5rem;
    }

    /* Quick actions card */
    .quick-actions-card {
        background-color: #ffffff;
        border: 1px solid #e8ecf1;
        border-radius: 12px;
        height: 100%;
    }

    .quick-actions-card .card-header {
        background-color: #ffffff;
        border-bottom: 1px solid #e8ecf1;
        padding: 1.25rem;
        border-radius: 12px 12px 0 0;
    }

    .action-item {
        display: flex;
        align-items: flex-start;
        padding: 1rem;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        margin-bottom: 0.75rem;
        cursor: pointer;
    }

    .action-item:last-child {
        margin-bottom: 0;
    }

    .action-item:hover {
        background-color: #f8fbff;
        border-color: #0d6efd;
    }

    .action-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background-color: #f0f4f9;
        margin-right: 1rem;
        flex-shrink: 0;
        font-size: 1.25rem;
    }

    .action-content h6 {
        font-weight: 600;
        color: #1a3a52;
        margin-bottom: 0.25rem;
    }

    .action-content small {
        color: #6c7c93;
        font-size: 0.85rem;
    }

    /* Recent activity */
    .activity-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .activity-badge.active {
        background-color: #d1f5d9;
        color: #0d6920;
    }

    .activity-badge.draft {
        background-color: #fff3cd;
        color: #664d03;
    }

    .activity-badge.pending {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 1.5rem 0;
            margin-bottom: 1.5rem;
        }

        .stat-card .card-body {
            flex-direction: column;
            text-align: center;
        }

        .stat-link {
            justify-content: center;
        }
    }
</style>

<!-- Header -->
<div class="dashboard-header px-4">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <img src="@profileImage" class="rounded-circle border border-2 border-white" width="56" height="56" alt="Profile" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div>
                    <h1 class="h5 mb-1 fw-bold text-dark">Dashboard</h1>
                    <small class="text-muted mb-0">
                        Welcome back, <strong>@adminName</strong>
                        <span class="mx-2">•</span>
                        <i class="far fa-calendar me-1"></i> @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                    </small>
                </div>
            </div>
            <a href="@Url.Action("Form", "Courses")" class="btn btn-primary rounded-2 px-4 py-2 d-flex align-items-center gap-2">
                <i class="fas fa-plus"></i> New Course
            </a>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container-fluid px-4 pb-5">

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="card-body">
                    <div class="stat-info">
                        <div class="stat-label">Active Courses</div>
                        <div class="stat-value text-primary" id="count-active-courses">0</div>
                        <a href="@Url.Action("Index", "Courses")" class="stat-link text-primary">
                            View All <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="stat-icon text-primary">
                        <i class="fas fa-book-reader fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="card-body">
                    <div class="stat-info">
                        <div class="stat-label">Draft Courses</div>
                        <div class="stat-value text-warning" id="count-draft-courses">0</div>
                        <a href="@Url.Action("Drafts", "Courses")" class="stat-link text-warning">
                            Review <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="stat-icon" style="background-color: #fffbf0; color: #ffc107;">
                        <i class="fas fa-pen-nib fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="card-body">
                    <div class="stat-info">
                        <div class="stat-label">Total Employees</div>
                        <div class="stat-value text-info" id="count-users">0</div>
                        <a href="@Url.Action("Index", "Users")" class="stat-link text-info">
                            Manage <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="stat-icon" style="background-color: #f0fbff; color: #17a2b8;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="stat-card">
                <div class="card-body">
                    <div class="stat-info">
                        <div class="stat-label">Resources</div>
                        <div class="stat-value" id="count-resources" style="color: #6f42c1;">0</div>
                        <a href="@Url.Action("Index", "Resources")" class="stat-link" style="color: #6f42c1;">
                            Library <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="stat-icon" style="background-color: #f8f0ff; color: #6f42c1;">
                        <i class="fas fa-folder-open fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart & Actions Row -->
    <div class="row g-3 mb-4">
        <!-- Enrollment Chart -->
        <div class="col-lg-8">
            <div class="chart-card">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-chart-line text-primary me-2"></i>
                        Enrollment Trends
                    </h6>
                </div>
                <div class="card-body">
                    <div id="enrollmentChart" style="height: 320px;"></div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="quick-actions-card">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-zap text-warning me-2"></i>
                        Quick Actions
                    </h6>
                </div>
                <div class="card-body p-0">
                    <a href="@Url.Action("Index", "Courses")" class="action-item">
                        <div class="action-icon text-primary">
                            <i class="fas fa-book"></i>
                        </div>
                        <div class="action-content">
                            <h6>Course Manager</h6>
                            <small>Create & manage courses</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Enrollments")" class="action-item">
                        <div class="action-icon text-success">
                            <i class="fas fa-user-check"></i>
                        </div>
                        <div class="action-content">
                            <h6>Enrollments</h6>
                            <small>Track course assignments</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Assignments")" class="action-item">
                        <div class="action-icon text-secondary">
                            <i class="fas fa-tasks"></i>
                        </div>
                        <div class="action-content">
                            <h6>Auto-Assignments</h6>
                            <small>Bulk course assignment</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "LearningLogs")" class="action-item">
                        <div class="action-icon text-info">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                        <div class="action-content">
                            <h6>Learning Logs</h6>
                            <small>View progress & scores</small>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Resources")" class="action-item">
                        <div class="action-icon" style="color: #6f42c1;">
                            <i class="fas fa-file"></i>
                        </div>
                        <div class="action-content">
                            <h6>Resources</h6>
                            <small>Manage SCORM files</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Info Row -->
    <div class="row g-3">
        <!-- System Status -->
        <div class="col-lg-6">
            <div class="chart-card">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-pulse text-success me-2"></i>
                        System Status
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3 pb-3" style="border-bottom: 1px solid #e8ecf1;">
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark">Database Connection</div>
                            <small class="text-muted">API Server Status</small>
                        </div>
                        <span class="activity-badge active">
                            <i class="fas fa-check-circle me-1"></i> Active
                        </span>
                    </div>

                    <div class="d-flex align-items-center mb-3 pb-3" style="border-bottom: 1px solid #e8ecf1;">
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark">Authentication Service</div>
                            <small class="text-muted">User Login System</small>
                        </div>
                        <span class="activity-badge active">
                            <i class="fas fa-check-circle me-1"></i> Running
                        </span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="fw-semibold text-dark">File Storage Service</div>
                            <small class="text-muted">Resource Upload System</small>
                        </div>
                        <span class="activity-badge active">
                            <i class="fas fa-check-circle me-1"></i> Operational
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Important Notices -->
        <div class="col-lg-6">
            <div class="chart-card">
                <div class="card-header">
                    <h6>
                        <i class="fas fa-bell text-warning me-2"></i>
                        Important Notices
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3 pb-3" style="border-bottom: 1px solid #e8ecf1;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas fa-info-circle text-info mt-1" style="flex-shrink: 0;"></i>
                            <div style="flex: 1;">
                                <div class="fw-semibold text-dark mb-1">Course Content Updated</div>
                                <small class="text-muted">5 courses have been updated in the last 7 days</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 pb-3" style="border-bottom: 1px solid #e8ecf1;">
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas fa-exclamation-circle text-warning mt-1" style="flex-shrink: 0;"></i>
                            <div style="flex: 1;">
                                <div class="fw-semibold text-dark mb-1">Pending Course Reviews</div>
                                <small class="text-muted">You have <span id="pending-count">0</span> draft courses waiting for approval</small>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="fas fa-check-circle text-success mt-1" style="flex-shrink: 0;"></i>
                            <div style="flex: 1;">
                                <div class="fw-semibold text-dark mb-1">All Systems Operational</div>
                                <small class="text-muted">Last backup completed 2 hours ago</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(() => {
            loadDashboardStats();
            initEnrollmentChart();
        });

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    if (res.success && res.data) {
                        animateCount('count-active-courses', res.data.activeCourses || 0);
                        animateCount('count-draft-courses', res.data.draftCourses || 0);
                        animateCount('count-users', res.data.totalUsers || 0);
                        animateCount('count-resources', res.data.totalResources || 0);
                        
                        // Update pending count in notices
                        $('#pending-count').text(res.data.draftCourses || 0);
                    }
                },
                error: function (err) {
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-users, #count-resources').text("0");
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if(value === 0) {
                $el.text("0");
                return;
            }

            // Animate number increment
            $({ counter: 0 }).animate({
                counter: value
            }, {
                duration: 1200,
                easing: 'swing',
                step: function () {
                    $el.text(Math.ceil(this.counter));
                },
                complete: function() {
                    $el.text(value);
                }
            });
        }

        function initEnrollmentChart() {
            // Sample data for enrollment trends
            const chartData = [
                { month: "Aug", enrollments: 120 },
                { month: "Sep", enrollments: 150 },
                { month: "Oct", enrollments: 190 },
                { month: "Nov", enrollments: 140 },
                { month: "Dec", enrollments: 250 },
                { month: "Jan", enrollments: 300 }
            ];

            $("#enrollmentChart").dxChart({
                dataSource: chartData,
                palette: ["#0d6efd"],
                series: {
                    argumentField: "month",
                    valueField: "enrollments",
                    name: "Enrollments",
                    type: "bar",
                    color: "#0d6efd"
                },
                argumentAxis: {
                    label: { overlappingBehavior: "stagger" }
                },
                valueAxis: {
                    grid: { visible: true },
                    label: { format: "#,##0" }
                },
                legend: { visible: false },
                tooltip: {
                    enabled: true,
                    customizeTooltip: function(args) {
                        return {
                            text: args.valueText + " enrollments"
                        };
                    }
                }
            });
        }
    </script>
}