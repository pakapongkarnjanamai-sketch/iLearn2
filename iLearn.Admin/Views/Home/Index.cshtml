@{
    ViewBag.Title = "Admin Dashboard";
    var adminName = User.Identity?.Name ?? "Administrator";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Admin Dashboard</div>
        <div class="page-subtitle">Welcome back, <strong>@adminName</strong></div>
    </div>
    <a href="@Url.Action("Form", "Courses")" class="action-link primary">
        <i class="fas fa-plus"></i> New Course
    </a>
</div>

<div class="container-fluid px-4 py-4" style="max-width:1400px;">

    <div class="row g-3 mb-4" id="maintenance-banner-row" style="display:none;">
        <div class="col-12">
            <div class="dash-panel" style="border:1px solid #ffe58f; background:#fffbe6;">
                <div class="dash-panel-header" style="color:#d48806;">Maintenance In Progress</div>
                <div class="dash-panel-body">
                    <div id="maintenance-status-list"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Stat Cards ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card blue">
                <div class="ds-lbl">Active Courses</div>
                <div class="ds-val" id="count-active-courses">0</div>
                <div class="ds-link" style="color:var(--accent-color);">View All <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Courses")" class="dash-stat-card yellow">
                <div class="ds-lbl">Draft Courses</div>
                <div class="ds-val" id="count-draft-courses">0</div>
                <div class="ds-link" style="color:var(--warning-color);">Review <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Assignments")" class="dash-stat-card green">
                <div class="ds-lbl">Total Assignments (In Progress)</div>
                <div class="ds-val" id="count-inprogress-assignments">0</div>
                <div class="ds-link" style="color:var(--success-color);">View <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
        <div class="col-lg-3 col-md-6">
            <a href="@Url.Action("Index", "Resources")" class="dash-stat-card purple">
                <div class="ds-lbl">Resources</div>
                <div class="ds-val" id="count-resources">0</div>
                <div class="ds-link" style="color:#722ed1;">Library <i class="fas fa-arrow-right ms-1"></i></div>
            </a>
        </div>
    </div>

    <!-- ── Chart + Quick Actions ── -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="dash-panel h-100">
                <div class="dash-panel-header d-flex justify-content-between align-items-center">
                    <span>Learning Activity Trends</span>
                    <span style="font-size:11px; color:var(--text-secondary); font-weight:400;">learning sessions per month (last 6 months)</span>
                </div>
                <div class="dash-panel-body">
                    <div id="learningActivityChartSkeleton" style="height:300px; padding:16px 0;">
                        <div class="skeleton skeleton-block mb-2" style="height:200px; border-radius:4px;"></div>
                        <div class="d-flex gap-2 justify-content-center">
                            <div class="skeleton skeleton-line w-40" style="height:10px;"></div>
                            <div class="skeleton skeleton-line w-40" style="height:10px;"></div>
                        </div>
                    </div>
                    <div id="learningActivityChart" style="height:300px; display:none;"></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="dash-panel h-100">
                <div class="dash-panel-header">Quick Actions</div>
                <div class="dash-panel-body d-flex flex-column gap-2">

                    <a href="@Url.Action("Index", "Courses")" class="quick-action">
                        <div class="qa-icon" style="background:#e6f4ff; color:var(--accent-color);"><i class="fas fa-book"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Course Manager</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Create &amp; manage courses</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Assignments")" class="quick-action">
                        <div class="qa-icon" style="background:#fff7e6; color:var(--warning-color);"><i class="fas fa-tasks"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Assignments</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Bulk course assignment</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Students")" class="quick-action">
                        <div class="qa-icon" style="background:#f6ffed; color:var(--success-color);"><i class="fas fa-user-graduate"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Students</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Browse &amp; manage learners</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "Resources")" class="quick-action">
                        <div class="qa-icon" style="background:#f9f0ff; color:#722ed1;"><i class="fas fa-folder-open"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Resources</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Manage learning materials</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Index", "StudentGroups")" class="quick-action">
                        <div class="qa-icon" style="background:var(--bg-light); color:var(--text-secondary);"><i class="fas fa-users"></i></div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Student Groups</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Organise learner groups</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- ── System Status + Notices ── -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">System Status</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-center pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">Database Connection</div>
                            <div style="font-size:11px; color:var(--text-secondary);">API Server Status</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Active</span>
                    </div>

                    <div class="d-flex align-items-center pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">Authentication Service</div>
                            <div style="font-size:11px; color:var(--text-secondary);">User Login System</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Running</span>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div style="font-size:12px; font-weight:600;">File Storage Service</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Resource Upload System</div>
                        </div>
                        <span class="status-pill active"><i class="fas fa-check-circle me-1"></i>Operational</span>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dash-panel">
                <div class="dash-panel-header">Important Notices</div>
                <div class="dash-panel-body">

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="qa-icon flex-shrink-0" style="background:#e6f4ff; color:var(--accent-color); margin-top:2px;">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Course Content Updated</div>
                            <div style="font-size:11px; color:var(--text-secondary);">5 courses have been updated in the last 7 days</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 pb-3 mb-3" style="border-bottom:1px solid var(--border-color);">
                        <div class="qa-icon flex-shrink-0" style="background:#fffbe6; color:var(--warning-color); margin-top:2px;">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">Pending Course Reviews</div>
                            <div style="font-size:11px; color:var(--text-secondary);">
                                <span id="pending-count" class="fw-bold">0</span> draft courses waiting for approval
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="qa-icon flex-shrink-0" style="background:#f6ffed; color:var(--success-color); margin-top:2px;">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div>
                            <div style="font-size:12px; font-weight:600;">All Systems Operational</div>
                            <div style="font-size:11px; color:var(--text-secondary);">Last backup completed 2 hours ago</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="dash-panel">
                <div class="dash-panel-header d-flex justify-content-between align-items-center">
                    <span>Recent Admin Activity</span>
                    <span style="font-size:11px; color:var(--text-secondary); font-weight:400;">latest create / update actions</span>
                </div>
                <div class="dash-panel-body" id="recent-admin-activities">
                    <div class="text-muted small">Loading recent activity...</div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(() => {
            loadDashboardStats();
            loadLearningActivityTrends();
            loadMaintenanceStatus();
            loadRecentAdminActivities();
            setInterval(loadMaintenanceStatus, 5000);
            setInterval(loadRecentAdminActivities, 10000);

            showStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
        });

        function loadRecentAdminActivities() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/RecentAdminActivities?take=10`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#recent-admin-activities');
                const items = res && res.success ? (res.data || []) : [];

                if (!items.length) {
                    wrapper.html('<div class="text-muted small text-center py-3"><i class="fas fa-clock-rotate-left me-1"></i>No recent admin activity</div>');
                    return;
                }

                wrapper.html(items.map(function(item, index) {
                    const borderClass = index < items.length - 1 ? 'pb-3 mb-3' : '';
                    const borderStyle = index < items.length - 1 ? 'border-bottom:1px solid var(--border-color);' : '';
                    return `
                        <div class="d-flex align-items-start gap-3 ${borderClass}" style="${borderStyle}">
                            <div class="qa-icon flex-shrink-0" style="background:#e6f4ff; color:var(--accent-color); margin-top:2px;">
                                <i class="fas fa-user-pen"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div style="font-size:12px; font-weight:600;">${escapeHtml(item.title)}</div>
                                <div style="font-size:11px; color:var(--text-secondary);">${escapeHtml(item.description || '')}</div>
                            </div>
                            <div class="text-end" style="min-width:120px;">
                                <div style="font-size:11px; font-weight:600; color:var(--text-primary);">${escapeHtml(item.createdBy || 'SYSTEM')}</div>
                                <div style="font-size:11px; color:var(--text-secondary);">${formatRelativeTime(item.createdAt)}</div>
                            </div>
                        </div>`;
                }).join(''));
            }).fail(function() {
                $('#recent-admin-activities').html('<div class="text-muted small text-center py-3"><i class="fas fa-triangle-exclamation me-1"></i>Failed to load activity</div>');
            });
        }

        function loadMaintenanceStatus() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/MaintenanceStatus`,
                method: 'GET',
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                const wrapper = $('#maintenance-status-list');
                const operations = res && res.success && res.data ? (res.data.operations || []) : [];

                if (!operations.length) {
                    $('#maintenance-banner-row').hide();
                    wrapper.empty();
                    return;
                }

                const cards = operations.map(function(op) {
                    const percent = op.totalItems > 0
                        ? Math.min(100, Math.round(((op.currentItem || 0) / op.totalItems) * 100))
                        : 0;
                    const currentItemName = op.currentItemName
                        ? `<div style="font-size:11px; color:var(--text-secondary); margin-top:4px;">Current: ${escapeHtml(op.currentItemName)}</div>`
                        : '';

                    return `
                        <div class="border rounded p-3 mb-2" style="background:#fff; border-color:#ffe58f !important;">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div style="font-size:12px; font-weight:700; color:#ad6800;">${escapeHtml(op.operationName)}</div>
                                    <div style="font-size:11px; color:var(--text-secondary);">Step: ${escapeHtml(op.currentStep || 'Processing')}</div>
                                    ${currentItemName}
                                </div>
                                <span class="status-pill" style="background:#fff7e6; color:#d48806; border:1px solid #ffd591;">
                                    <i class="fas fa-gears me-1"></i>${op.currentItem || 0} / ${op.totalItems || 0}
                                </span>
                            </div>
                            <div class="progress" style="height:8px; background:#fff1b8; border-radius:999px; overflow:hidden;">
                                <div style="height:100%; width:${percent}%; background:#faad14; transition:width .2s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-2" style="font-size:11px; color:var(--text-secondary);">
                                <span>Success: ${op.successCount || 0} | Failed: ${op.failureCount || 0}</span>
                                <span>By ${escapeHtml(op.initiatedBy || 'SYSTEM')}</span>
                            </div>
                        </div>`;
                }).join('');

                wrapper.html(cards);
                $('#maintenance-banner-row').show();
            }).fail(function() {
                $('#maintenance-banner-row').hide();
                $('#maintenance-status-list').empty();
            });
        }

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }

        function formatRelativeTime(value) {
            if (!value) return '—';

            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return '—';

            const diffMs = Date.now() - date.getTime();
            const diffMinutes = Math.floor(diffMs / 60000);

            if (diffMinutes < 1) return 'just now';
            if (diffMinutes < 60) return `${diffMinutes} min ago`;

            const diffHours = Math.floor(diffMinutes / 60);
            if (diffHours < 24) return `${diffHours} hr ago`;

            const diffDays = Math.floor(diffHours / 24);
            if (diffDays < 7) return `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;

            return date.toLocaleString('en-GB', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function loadDashboardStats() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/Stats`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    hideStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
                    if (res.success && res.data) {
                        animateCount('count-active-courses',        res.data.activeCourses          || 0);
                        animateCount('count-draft-courses',          res.data.draftCourses            || 0);
                        animateCount('count-inprogress-assignments', res.data.inProgressAssignments   || 0);
                        animateCount('count-resources',              res.data.totalResources          || 0);
                        $('#pending-count').text(res.data.draftCourses || 0);
                    }
                },
                error: function (err) {
                    hideStatSkeleton(['count-active-courses', 'count-draft-courses', 'count-inprogress-assignments', 'count-resources']);
                    console.error("Failed to load dashboard stats", err);
                    $('#count-active-courses, #count-draft-courses, #count-inprogress-assignments, #count-resources').text("0");
                }
            });
        }

        function loadLearningActivityTrends() {
            $.ajax({
                url: `${serviceUrl}/admin/Dashboard/LearningActivityTrends`,
                method: "GET",
                xhrFields: { withCredentials: true },
                success: function (res) {
                    initLearningActivityChart(res.success && res.data ? res.data : []);
                },
                error: function (err) {
                    console.error("Failed to load learning activity trends", err);
                    initLearningActivityChart([]);
                }
            });
        }

        function animateCount(elementId, value) {
            const $el = $(`#${elementId}`);
            if (value === 0) { $el.text("0"); return; }

            $({ counter: 0 }).animate({ counter: value }, {
                duration: 1200,
                easing: 'swing',
                step: function () { $el.text(Math.ceil(this.counter)); },
                complete: function () { $el.text(value); }
            });
        }

        function initLearningActivityChart(chartData) {
            $('#learningActivityChartSkeleton').hide();
            $('#learningActivityChart').show().dxChart({
                dataSource: chartData,
                series: {
                    argumentField: "month",
                    valueField: "sessions",
                    name: "Sessions",
                    type: "bar",
                    color: "#1890ff",
                    cornerRadius: 2
                },
                argumentAxis: {
                    label: { font: { color: "#595959", size: 11 } }
                },
                valueAxis: {
                    grid: { visible: true, color: "#f0f0f0" },
                    label: { format: "#,##0", font: { color: "#595959", size: 11 } }
                },
                legend: { visible: false },
                margin: { top: 10, bottom: 0, left: 0, right: 0 },
                tooltip: {
                    enabled: true,
                    customizeTooltip: (args) => ({ text: args.valueText + " sessions" })
                }
            });
        }
    </script>
}