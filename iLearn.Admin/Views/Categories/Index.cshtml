@{
    ViewBag.Title = "Category Management";
}

@section Styles {
    <style>
        @@media (max-width: 991.98px) {
            .page-header {
                align-items: flex-start !important;
            }

            .page-header-actions {
                width: 100%;
            }
        }

    </style>
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="admin-monitor-bar">
      
        <div class="admin-monitor-filters" id="category-filter-chips" role="group" aria-label="Category status filters"></div>
    </div>
    <div class="page-header-actions">
         <a href="@Url.Action("Index", "Courses")" class="action-link">
            <i class="fas fa-book" aria-hidden="true"></i> Manage Course
        </a>
        <button type="button" class="action-link primary" onclick="addNewCategory()">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Category
        </button>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>
</div>

<!-- ── Edit Modal ── -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="editModalTitle">Edit Category</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                    <input type="text" id="edit-name" class="form-control" placeholder="Enter category name...">
                    <div class="invalid-feedback">Name is required.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Division</label>
                    <select id="edit-division" class="form-select">
                        <option value="">Select a division</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="edit-active" checked>
                        <label class="form-check-label fw-semibold" for="edit-active">Status (Active)</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" id="btn-save" onclick="saveCategory()">Save</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const CATEGORIES_API_URL = `${serviceUrl}/admin/CategoriesCRUD`;
        const DIVISIONS_API_URL = `${serviceUrl}/Divisions`;
        const DETAIL_URL = '@Url.Action("Detail", "Categories")';
        const CATEGORY_FILTER_ITEMS = [
            { key: "all", label: "All" },
            { key: "active", label: "Active" },
            { key: "inactive", label: "Inactive" }
        ];

        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        let allDivisions = [];
        let editingId = null;
        let editModal;
        let gridInstance;

        function applyQuickFilter(filterKey) {
            if (!gridInstance) {
                return;
            }

            window.applyAdminQuickFilter(gridInstance, filterKey, {
                getConditions: function (activeFilterKey) {
                    return [["isActive", "=", activeFilterKey === "active"]];
                },
                onApplied: function (activeKey) {
                    setActiveQuickFilter(activeKey);
                }
            });
        }

        function setActiveQuickFilter(activeFilterKey) {
            window.updateAdminFilterChipState("#category-filter-chips", activeFilterKey);
        }

        function renderQuickFilters() {
            window.renderAdminFilterChips("#category-filter-chips", CATEGORY_FILTER_ITEMS, "all");
        }

        function loadDivisions() {
            $.ajax({
                url: DIVISIONS_API_URL,
                method: "GET",
                xhrFields: { withCredentials: true }
            }).done(function (res) {
                allDivisions = Array.isArray(res) ? res : (res.data || []);
                const $sel = $("#edit-division");
                $sel.find("option:not(:first)").remove();
                allDivisions.forEach(d => {
                    $sel.append(`<option value="${d.id}">${escapeAdminHtml(d.name)}</option>`);
                });
            });
        }

        function openAddModal() {
            editingId = null;
            $("#editModalTitle").text("Create Category");
            $("#edit-name").val("").removeClass("is-invalid");
            $("#edit-division").val("");
            $("#edit-active").prop("checked", true);
            editModal.show();
        }

        function openEditModal(id, name, divisionId, isActive) {
            editingId = id;
            $("#editModalTitle").text("Edit Category");
            $("#edit-name").val(name).removeClass("is-invalid");
            $("#edit-division").val(divisionId || "");
            $("#edit-active").prop("checked", isActive === true || isActive === "true");
            editModal.show();
        }

        function saveCategory() {
            const name = $("#edit-name").val().trim();
            if (!name) {
                $("#edit-name").addClass("is-invalid");
                return;
            }
            const divVal = $("#edit-division").val();
            const divisionId = divVal ? parseInt(divVal) : null;
            const isActive = $("#edit-active").is(":checked");
            const payload = { name, divisionId, isActive };

            if (editingId) {
                $.ajax({
                    url: `${CATEGORIES_API_URL}/Put`,
                    method: "PUT",
                    data: { key: editingId, values: JSON.stringify(payload) },
                    xhrFields: { withCredentials: true }
                }).done(function () {
                    editModal.hide();
                    showToast("Category updated.", "success");
                    gridInstance.refresh();
                }).fail(function (err) {
                    showToast(getApiErrorMessage(err, "Couldn't update category."), "error");
                });
            } else {
                $.ajax({
                    url: `${CATEGORIES_API_URL}/Post`,
                    method: "POST",
                    data: { values: JSON.stringify(payload) },
                    xhrFields: { withCredentials: true }
                }).done(function () {
                    editModal.hide();
                    showToast("Category created.", "success");
                    gridInstance.refresh();
                }).fail(function (err) {
                    showToast(getApiErrorMessage(err, "Couldn't create category."), "error");
                });
            }
        }

        function deleteCategory(id, name) {
            DevExpress.ui.dialog.confirm(
                `Delete category "<b>${escapeAdminHtml(name)}</b>"? You can only delete categories that are inactive and unused.`,
                "Delete Category"
            ).then(function (confirmed) {
                if (!confirmed) return;
                $.ajax({
                    url: `${CATEGORIES_API_URL}/Delete`,
                    method: "DELETE",
                    data: { key: id },
                    xhrFields: { withCredentials: true }
                }).done(function () {
                    showToast("Category deleted.", "success");
                    gridInstance.refresh();
                }).fail(function (err) {
                    showToast(getApiErrorMessage(err, "Couldn't delete category."), "error");
                });
            });
        }

        $(function () {
            editModal = new bootstrap.Modal(document.getElementById("editModal"));
            loadDivisions();
            renderQuickFilters();

            window.bindAdminFilterChips("#category-filter-chips", function (filterKey) {
                applyQuickFilter(filterKey);
            });

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search by category name or division...", {
                height: "100%",
                dataSource: categoriesStore,
                remoteOperations: true,

                onRowDblClick: function (e) {
                    if (e.data?.id) window.location.href = `${DETAIL_URL}?id=${e.data.id}`;
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 70,
                        alignment: "center",
                     
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 200,
                        cellTemplate: function (container, options) {
                            const wrapper = $("<div>").addClass("d-flex align-items-center gap-2");
                            $("<i>").addClass("fas fa-layer-group").css({ color: "var(--primary-color)", opacity: .75 }).appendTo(wrapper);
                            $("<a>").attr("href", `${DETAIL_URL}?id=${options.data.id}`)
                                    .addClass("fw-bold text-dark text-decoration-none")
                                    .text(options.value).appendTo(wrapper);
                            wrapper.appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionName",
                        caption: "Division",
                        width: 180,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            if (options.value) {
                                window.renderAdminGridTextCell(container, options.value, "captionAccent");
                            } else {
                                appendAdminText(container, "—", { color: "var(--text-secondary)", fontStyle: "italic" });
                            }
                        }
                    },
                    {
                        dataField: "courseCount",
                        caption: "Courses",
                        width: 120,
                        alignment: "center",
                 
                        customizeText: function(e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            window.renderAdminGridStatusCell(container, options.value ? "Active" : "Inactive", options.value ? "success" : "default");
                        }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Category Details",
                                icon: "fa fa-eye",
                                onClick: function (e) {
                                    window.location.href = `${DETAIL_URL}?id=${e.row.data.id}`;
                                }
                            },
                            {
                                hint: "Edit Category",
                                icon: "fa fa-pencil-alt",
                                onClick: function (e) {
                                    const d = e.row.data;
                                    openEditModal(d.id, d.name, d.divisionId, d.isActive);
                                }
                            },
                            {
                                hint: "Delete Category",
                                icon: "fa fa-trash",
                                cssClass: "dx-datagrid-dangerous-button",
                                visible: function (e) {
                                    return !e.row.data.isActive && (e.row.data.courseCount || 0) === 0;
                                },
                                onClick: function (e) {
                                    deleteCategory(e.row.data.id, e.row.data.name);
                                }
                            }
                        ]
                    }
                ]
            }));

            window.enableAdminViewportLayout({
                refreshTargets: [gridInstance]
            });

            $("#edit-name").on("input", function () {
                if ($(this).val().trim()) $(this).removeClass("is-invalid");
            });
        });

        function addNewCategory() { openAddModal(); }
        window.addNewCategory = addNewCategory;
    </script>
}