@{
    ViewBag.Title = "Category Management";
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* กล่องสำหรับใส่ Icon ใน Header ให้เป็นสัดส่วนเดียวกับหน้าอื่นๆ */
    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        flex-shrink: 0;
    }
</style>

<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-tags fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                    <small class="text-muted">Manage course categories and assign them to divisions.</small>
                </div>
            </div>
            <div>
                <button class="btn btn-primary rounded-3 shadow-sm px-4 py-2" onclick="addNewCategory()">
                    <i class="fas fa-plus me-1"></i> New Category
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5">
    <div class="row g-4">
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4">
                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 1.1rem;">
                        <i class="fas fa-sitemap me-2 text-primary"></i> Filter by Division
                    </h6>
                </div>
                <div class="card-body px-3 pb-4">
                    <div id="divisionTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="rounded-3 overflow-hidden border border-light">
                        <div id="grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        // เปลี่ยนฟังก์ชันหลักเป็น async เพื่อให้รองรับการดึงข้อมูลสร้าง TreeView
        $(async () => {

            // ==========================================
            // 1. สร้าง DataGrid หลัก (Categories)
            // ==========================================
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                height: "calc(100vh - 230px)", // จำกัดความสูงให้อยู่ในหน้าจอ
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // --- ปรับแต่ง UI ตารางหลักให้คลีน ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

               // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        // ปรับหน้าตา popup ให้มุมมน (ผ่าน wrapper class)
                        wrapperAttr: { class: "rounded-4" }
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: { placeholder: "Enter category name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            placeholder: "Select a Division..."
                                        }
                                    },
                                    {
                                        itemType: "empty"
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            // ปรับสไตล์ Badge ให้ดูนุ่มนวลโปร่งใสขึ้น
                            if (isActive) {
                                $("<span>")
                                    .addClass("badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill fw-normal")
                                    .html('<i class="fas fa-check-circle me-1"></i> Active')
                                    .appendTo(container);
                            } else {
                                $("<span>")
                                    .addClass("badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-1 rounded-pill fw-normal")
                                    .html('<i class="fas fa-times-circle me-1"></i> Inactive')
                                    .appendTo(container);
                            }
                        }
                    },
                    // --- คอลัมน์ Action ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                // เงื่อนไข: ให้แสดงปุ่มลบ (visible: true) ก็ต่อเมื่อ isActive มีค่าเป็น false เท่านั้น
                                visible: function(e) {
                                    return e.row.data.isActive === false;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. ดึงข้อมูล Divisions และสร้าง TreeView ด้านซ้าย
            // ==========================================
            try {
                // ดึงข้อมูล Division ทั้งหมด
                const divisionsData = await divisionsStore.load();

                // เรียงลำดับชื่อ A-Z
                divisionsData.sort((a, b) => (a.name > b.name) ? 1 : -1);

                // สร้างโครงสร้างข้อมูลสำหรับ TreeView
                const treeData = [{
                    id: 'root',
                    text: 'All Categories',
                    icon: 'home',
                    expanded: true,
                    isRoot: true,
                    // สร้าง Node ย่อยเป็นรายชื่อ Division
                    items: divisionsData.map(d => ({
                        id: 'div_' + d.id,
                        text: d.isActive ? d.name : `🚫 ${d.name} (Draft)`,
                        icon: 'folder',
                        divisionId: d.id
                    }))
                }];

                // สร้าง dxTreeView
                $("#divisionTreeView").dxTreeView({
                    dataSource: treeData,
                    height: "calc(100vh - 280px)",
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรอง (Filter)
                        if (node.isRoot) {
                            grid.clearFilter(); // ล้าง Filter ดูทั้งหมด
                        } else if (node.divisionId) {
                            grid.filter(["divisionId", "=", node.divisionId]); // กรองตาม Division ID
                        }
                    },
                    onContentReady: function(e) {
                        // เลือก Root (All Categories) เป็นค่าเริ่มต้น
                        e.component.selectItem('root');
                    }
                });

            } catch (err) {
                console.error("Error loading divisions for treeview", err);
            }
        });

        // ฟังก์ชันสำหรับปุ่ม New Category ด้านบน
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}