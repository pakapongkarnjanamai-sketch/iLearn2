@{
    ViewBag.Title = "Category Management";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage course categories and assign them to divisions.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewCategory()">
                    <i class="fas fa-plus me-2"></i> New Category
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 500,
                        height: 450
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            placeholder: "Select Division (Optional)"
                                        }
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Active Status" },
                                        label: { visible: false }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
              
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
        
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "badge-active" : "badge-inactive";
                            const icon = isActive ? "fa-check-circle" : "fa-times-circle";
                            const text = isActive ? "Active" : "Inactive";

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${text}`)
                                .appendTo(container);
                        }
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                            {
                                hint: "View Courses in this Category",
                                icon: "folder", // ไอคอนโฟลเดอร์สำหรับนำทางไปดูหลักสูตรย่อย
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Index", "Courses")?categoryId=' + e.row.data.id;
                                }
                            },
                            "delete"
                        ]
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม New Category ด้านบน
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}