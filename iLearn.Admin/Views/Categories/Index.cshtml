@{
    ViewBag.Title = "Category Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Category Management</div>
        <div class="page-subtitle">Manage course categories and assign them to divisions.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewCategory()">
        <i class="fas fa-plus"></i> New Category
    </a>
</div>

<div class="container-fluid px-4 py-3 pb-5" style="height: calc(100vh - 115px);">
    <div class="row g-3 h-100">

        <div class="col-md-4 col-lg-3 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column">
                <div class="panel-header">Filter by Division</div>
                <div class="p-2 flex-grow-1 overflow-hidden">
                    <div id="divisionTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column overflow-hidden">
                <div id="grid" class="flex-grow-1"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        let availableDivisions = [];
        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        // lookup column — raw+cached ดึงครั้งเดียว resolve label ในฝั่ง client
        const dsDivisionsLookup = { store: divisionsStore, loadMode: 'raw', cacheRawData: true };
        // form selectbox — paginate lazy search
        const dsDivisionsSelect = { store: divisionsStore, paginate: true, pageSize: 20 };

        $(async () => {

            // ==========================================
            // 1. สร้าง DataGrid หลัก (Categories)
            // ==========================================
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // --- ปรับแต่ง UI ตารางหลักให้คลีน ---
                showBorders: false, // ปิดขอบตาราง
                rowAlternationEnabled: true, 
                showRowLines: true, // โชว์แค่เส้นใต้แถว
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },
                onInitNewRow: function(e) {
                    if (availableDivisions.length === 1) {
                        e.data.divisionId = availableDivisions[0].id;
                    }
                },

               // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        wrapperAttr: { class: "rounded-4 shadow-lg" } // เพิ่มเงาให้ Popup
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: { placeholder: "Enter category name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: dsDivisionsSelect,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            placeholder: "Select a Division..."
                                        }
                                    },
                                    {
                                        itemType: "empty"
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: dsDivisionsLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>").addClass("status-pill pill-success")
                                    .html('<i class="fas fa-check me-1"></i> Active')
                                    .appendTo(container);
                            } else {
                                $("<span>").addClass("status-pill pill-default")
                                    .html('<i class="fas fa-times me-1"></i> Inactive')
                                    .appendTo(container);
                            }
                        }
                    },
                    // --- คอลัมน์ Action ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                // ให้แสดงปุ่มลบ (visible: true) ก็ต่อเมื่อ isActive มีค่าเป็น false เท่านั้น
                                visible: function(e) {
                                    return e.row.data.isActive === false;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. ดึงข้อมูล Divisions และสร้าง TreeView ด้านซ้าย
            // ==========================================
            try {
                const divisionsData = await divisionsStore.load();
                availableDivisions = Array.isArray(divisionsData) ? divisionsData : [];
                divisionsData.sort((a, b) => (a.name > b.name) ? 1 : -1);

                const treeData = [{
                    id: 'root',
                    text: 'All Categories',
                    icon: 'home',
                    expanded: true,
                    isRoot: true,
                    items: divisionsData.map(d => ({
                        id: 'div_' + d.id,
                        text: d.isActive ? d.name : `🚫 ${d.name} (Draft)`,
                        icon: 'folder',
                        divisionId: d.id
                    }))
                }];

                $("#divisionTreeView").dxTreeView({
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.divisionId) {
                            grid.filter(["divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading divisions for treeview", err);
            }
        });

        // ฟังก์ชันสำหรับปุ่ม New Category
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}