@{
    ViewBag.Title = "Category Management";
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage course categories and assign them to divisions.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewCategory()">
                    <i class="fas fa-plus me-2"></i> New Category
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 500,
                        height: 450
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            placeholder: "Select Division (Optional)"
                                        }
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Active Status" },
                                        label: { visible: false }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "badge-active" : "badge-inactive";
                            const icon = isActive ? "fa-check-circle" : "fa-times-circle";
                            const text = isActive ? "Active" : "Inactive";

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${text}`)
                                .appendTo(container);
                        }
                    },

                    // --- คอลัมน์ Action แบบมาตรฐาน ---
                    {
                        caption: "Manage",
                        width: 180, // กว้างขึ้นนิดหน่อยเพราะมี 3 ปุ่ม
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // Edit Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Category")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // View Courses Button (นำทางไปหน้าคอร์สและกรองตามหมวดหมู่นี้)
                            $("<button>")
                                .addClass("btn-icon text-info")
                                .attr("title", "View Courses in this Category")
                                .html('<i class="fas fa-book-open"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Index", "Courses")?categoryId=' + data.id)
                                .appendTo($group);

                            // Delete Button
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Category")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(
                                        `Are you sure you want to delete category "<strong>${data.name}</strong>"?`,
                                        "Confirm Delete"
                                    ).done((res) => {
                                        if (res) gridInstance.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับปุ่ม New Category ด้านบน
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}