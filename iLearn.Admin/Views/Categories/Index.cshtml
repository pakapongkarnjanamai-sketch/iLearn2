@{
    ViewBag.Title = "Category Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Category Management</div>
        <div class="page-subtitle">Manage course categories and assign them to divisions.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewCategory()">
        <i class="fas fa-plus"></i> New Category
    </a>
</div>

<div class="container-fluid px-4 py-3 pb-5 h-100">
    <div class="row g-3 h-100">

        <div class="col-md-4 col-lg-3 h-100">
            <div class="border rounded bg-white h-100 d-flex flex-column">
                <div class="panel-header">Filter by Division</div>
                <div class="p-2 flex-grow-1 overflow-hidden">
                    <div id="divisionTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 h-100">
            <div id="grid" class="h-100"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        const ROOT_NODE_ID = 'root';
        const ALL_CATEGORIES_LABEL = 'All Categories';

        let gridInstance;
        let availableDivisions = [];

        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        const dsDivisionsLookup = { store: divisionsStore, loadMode: 'raw', cacheRawData: true };
        const dsDivisionsSelect = { store: divisionsStore, paginate: true, pageSize: 20 };

        $(async () => {
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                onInitNewRow: function(e) {
                    if (availableDivisions.length === 1) {
                        e.data.divisionId = availableDivisions[0].id;
                    }
                },

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        wrapperAttr: { class: "rounded-4 shadow-lg" }
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: { placeholder: "Enter category name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: dsDivisionsSelect,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            placeholder: "Select a Division..."
                                        }
                                    },
                                    {
                                        itemType: "empty"
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: dsDivisionsLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            $(buildStatusPill(options.value)).appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) {
                                    return e.row.data.isActive === false;
                                }
                            }
                        ]
                    }
                ]
            });

            try {
                await loadDivisionsAndTree();
            } catch (err) {
                console.error("Error loading divisions for treeview", err);
            }
        });

        function buildStatusPill(isActive) {
            if (isActive) {
                return '<span class="tag-pill pill-success"><i class="fas fa-check me-1"></i> Active</span>';
            }

            return '<span class="tag-pill pill-default"><i class="fas fa-times me-1"></i> Inactive</span>';
        }

        async function loadDivisionsAndTree() {
            const divisionsData = await divisionsStore.load();
            availableDivisions = Array.isArray(divisionsData) ? divisionsData : [];
            availableDivisions.sort(sortDivisionsByName);

            $("#divisionTreeView").dxTreeView({
                dataSource: buildDivisionTreeData(availableDivisions),
                dataStructure: 'tree',
                keyExpr: 'id',
                displayExpr: 'text',
                itemsExpr: 'items',
                selectionMode: 'single',
                selectByClick: true,
                onItemSelectionChanged: function(e) {
                    applyDivisionFilter(e.itemData);
                },
                onContentReady: function(e) {
                    e.component.selectItem(ROOT_NODE_ID);
                }
            });
        }

        function buildDivisionTreeData(divisions) {
            return [{
                id: ROOT_NODE_ID,
                text: ALL_CATEGORIES_LABEL,
                icon: 'home',
                expanded: true,
                isRoot: true,
                items: divisions.map(function(division) {
                    return {
                        id: `div_${division.id}`,
                        text: division.isActive ? division.name : `Draft: ${division.name}`,
                        icon: 'folder',
                        divisionId: division.id
                    };
                })
            }];
        }

        function sortDivisionsByName(left, right) {
            return left.name.localeCompare(right.name);
        }

        function applyDivisionFilter(node) {
            const grid = getGridInstance();
            if (!grid || !node) {
                return;
            }

            if (node.isRoot) {
                grid.clearFilter();
                return;
            }

            if (node.divisionId) {
                grid.filter(["divisionId", "=", node.divisionId]);
            }
        }

        function getGridInstance() {
            const gridElement = $("#grid");
            if (!gridElement.length || !gridElement.data("dxDataGrid")) {
                return null;
            }

            return gridElement.dxDataGrid("instance");
        }

        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }

        window.addNewCategory = addNewCategory;
    </script>
}