@{
    ViewBag.Title = "Category Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Category Management</div>
        <div class="page-subtitle">Manage categories by division.</div>
    </div>
    <div class="page-header-actions">
        <button type="button" class="action-link primary" onclick="addNewCategory()">
            <i class="fas fa-plus"></i> Create Category
        </button>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">

    <!-- ── DataGrid ── -->
    <div class="panel flex-grow-1 d-flex flex-column">
        <div class="panel-header">Categories</div>
        <div class="panel-body p-0 flex-grow-1 overflow-hidden">
            <div id="grid" class="h-100"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        const divisionsStore = createDataStore(serviceUrl, 'Divisions', {
            key: 'id',
            loadUrl: `${serviceUrl}/Divisions`
        });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');
        const DETAIL_URL = '@Url.Action("Detail", "Categories")';

        const dsDivisionsSelect = { store: divisionsStore, paginate: true, pageSize: 20 };

        $(() => {

            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search by category name or division...", {
                dataSource: categoriesStore,
                remoteOperations: true,

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Delete this category? You can only delete categories that are inactive and unused." },
                    popup: {
                        title: "Edit Category",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Information",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: { placeholder: "Enter category name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: dsDivisionsSelect,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            placeholder: "Select a division"
                                        }
                                    },
                                    {
                                        itemType: "empty"
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 70,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append($("<i>").addClass("fas fa-layer-group").css({ color: "var(--accent-color)", opacity: ".75" }))
                                .append(
                                    $("<a>").attr("href", `${DETAIL_URL}?id=${options.row.data.id}`)
                                        .addClass("fw-bold text-dark text-decoration-none")
                                        .text(options.value)
                                )
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionName",
                        caption: "Division",
                        width: 180,
                        allowEditing: false,
                        cellTemplate: function(container, options) {
                            const name = options.value;
                            if (name) {
                                $("<span>").addClass("tag-pill pill-info").text(name).appendTo(container);
                            } else {
                                $("<span>").addClass("text-muted fst-italic").text("—").appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "courseCount",
                        caption: "Courses",
                        width: 120,
                        alignment: "center",
                        allowEditing: false,
                        cellTemplate: function(container, options) {
                            const count = options.value || 0;
                            if (count === 0) {
                                $("<span>").addClass("tag-pill pill-default").text("None").appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-success")
                                    .text(count + " course" + (count > 1 ? "s" : "")).appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            if (options.value) {
                                $("<span>").addClass("tag-pill pill-success")
                                    .html('<i class="fas fa-check me-1"></i> Active')
                                    .appendTo(container);
                            } else {
                                $("<span>").addClass("tag-pill pill-default")
                                    .html('<i class="fas fa-times me-1"></i> Inactive')
                                    .appendTo(container);
                            }
                        }
                    },
                    {
                        type: "buttons",
                                caption: "Quick Actions",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Category Details",
                                icon: "fas fa-eye",
                                onClick: function(e) {
                                    window.location.href = `${DETAIL_URL}?id=${e.row.data.id}`;
                                }
                            },
                            "edit",
                            {
                                name: "delete",
                                visible: function(e) {
                                    return e.row.data.isActive === false && (e.row.data.courseCount || 0) === 0;
                                }
                            }
                        ]
                    }
                ],
            }));
        });

        function addNewCategory() {
            if (gridInstance) gridInstance.addRow();
        }

        window.addNewCategory = addNewCategory;
    </script>
}