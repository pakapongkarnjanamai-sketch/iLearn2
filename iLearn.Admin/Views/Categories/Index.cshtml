@{
    ViewBag.Title = "Category Management";
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* Override ความสูงของ TreeView และ Grid เพื่อให้เต็มการ์ดพอดี */
    .dx-treeview, .dx-datagrid {
        height: 100% !important;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                <i class="fas fa-tags fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted">Manage course categories and assign them to divisions.</small>
            </div>
        </div>
        <div>
            <button class="btn btn-primary rounded-3 shadow-sm px-4 py-2 fw-medium" onclick="addNewCategory()">
                <i class="fas fa-plus me-1"></i> New Category
            </button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5" style="height: calc(100vh - 180px);">
    <div class="row g-4 h-100">

        <div class="col-md-4 col-lg-3 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-sitemap me-2 text-primary"></i> Filter by Division
                    </h6>
                </div>
                <div class="card-body px-3 pb-4 flex-grow-1 overflow-hidden">
                    <div id="divisionTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9 h-100">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-body p-0 flex-grow-1 overflow-hidden ">
                    <div id="grid"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        $(async () => {

            // ==========================================
            // 1. สร้าง DataGrid หลัก (Categories)
            // ==========================================
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // --- ปรับแต่ง UI ตารางหลักให้คลีน ---
                showBorders: false, // ปิดขอบตาราง
                rowAlternationEnabled: true, 
                showRowLines: true, // โชว์แค่เส้นใต้แถว
                hoverStateEnabled: true,
                scrolling: { mode: "virtual" },

               // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 450,
                        height: "auto",
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true,
                        wrapperAttr: { class: "rounded-4 shadow-lg" } // เพิ่มเงาให้ Popup
                    },
                    form: {
                        labelLocation: "top",
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: { placeholder: "Enter category name..." },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            placeholder: "Select a Division..."
                                        }
                                    },
                                    {
                                        itemType: "empty"
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch",
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            if (isActive) {
                                $("<span>")
                                    .addClass("badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1 rounded-pill fw-medium")
                                    .html('<i class="fas fa-check me-1"></i> Active')
                                    .appendTo(container);
                            } else {
                                $("<span>")
                                    .addClass("badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-1 rounded-pill fw-medium")
                                    .html('<i class="fas fa-times me-1"></i> Inactive')
                                    .appendTo(container);
                            }
                        }
                    },
                    // --- คอลัมน์ Action ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                            {
                                name: "delete",
                                // ให้แสดงปุ่มลบ (visible: true) ก็ต่อเมื่อ isActive มีค่าเป็น false เท่านั้น
                                visible: function(e) {
                                    return e.row.data.isActive === false;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. ดึงข้อมูล Divisions และสร้าง TreeView ด้านซ้าย
            // ==========================================
            try {
                const divisionsData = await divisionsStore.load();
                divisionsData.sort((a, b) => (a.name > b.name) ? 1 : -1);

                const treeData = [{
                    id: 'root',
                    text: 'All Categories',
                    icon: 'home',
                    expanded: true,
                    isRoot: true,
                    items: divisionsData.map(d => ({
                        id: 'div_' + d.id,
                        text: d.isActive ? d.name : `🚫 ${d.name} (Draft)`,
                        icon: 'folder',
                        divisionId: d.id
                    }))
                }];

                $("#divisionTreeView").dxTreeView({
                    dataSource: treeData,
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;
                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        if (node.isRoot) {
                            grid.clearFilter();
                        } else if (node.divisionId) {
                            grid.filter(["divisionId", "=", node.divisionId]);
                        }
                    },
                    onContentReady: function(e) {
                        e.component.selectItem('root');
                    }
                });
            } catch (err) {
                console.error("Error loading divisions for treeview", err);
            }
        });

        // ฟังก์ชันสำหรับปุ่ม New Category
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}