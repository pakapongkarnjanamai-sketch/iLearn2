@{
    ViewBag.Title = "Category Management";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage course categories and assign them to divisions.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewCategory()">
                    <i class="fas fa-plus me-2"></i> New Category
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="row">
        <div class="col-md-4 col-lg-3 mb-4 mb-md-0">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-sitemap me-2 text-primary"></i>Filter by Division</h6>
                </div>
                <div class="card-body p-2">
                    <div id="divisionTreeView"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8 col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div id="grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD');
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD');

        // เปลี่ยนฟังก์ชันหลักเป็น async เพื่อให้รองรับการดึงข้อมูลสร้าง TreeView
        $(async () => {

            // ==========================================
            // 1. สร้าง DataGrid หลัก (Categories)
            // ==========================================
            gridInstance = initDxGrid("#grid", {
                dataSource: categoriesStore,
                height: "calc(100vh - 230px)", // จำกัดความสูงให้อยู่ในหน้าจอ
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search categories..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

               // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this category?" },
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 450,
                        height: "auto", // ให้หน้าต่างยืดหดตามความสูงของเนื้อหาอัตโนมัติ
                        position: { my: "center", at: "center", of: window },
                        dragEnabled: true,
                        hideOnOutsideClick: true // คลิกพื้นหลังเพื่อปิด popup ได้
                    },
                    form: {
                        labelLocation: "top", // เอา Label ไว้ด้านบนของ Input
                        colCount: 1,
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        editorOptions: {
                                            placeholder: "Enter category name..."
                                        },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            searchEnabled: true, // เปิดให้พิมพ์ค้นหาชื่อแผนกได้
                                            placeholder: "Select a Division..."
                                        }
                                    },
                                    {
                                        itemType: "empty" // เพิ่มช่องว่างเล็กน้อยก่อนถึงสวิตช์
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxSwitch", // เปลี่ยนเป็นปุ่มเปิด-ปิด (Switch) ให้ดูทันสมัย
                                        label: { text: "Status (Active)" },
                                        editorOptions: {
                                            switchedOnText: "Yes",
                                            switchedOffText: "No"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        lookup: {
                            dataSource: [{ id: true, name: 'Active' }, { id: false, name: 'Inactive' }],
                            displayExpr: 'name', valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "bg-success text-white" : "bg-secondary text-white";
                            const icon = isActive ? "fa-check-circle" : "fa-times-circle";
                            const text = isActive ? "Active" : "Inactive";

                            $("<span>")
                                .addClass(`badge border px-2 py-1 ${badgeClass}`)
                                .html(`<i class="fas ${icon} me-1"></i> ${text}`)
                                .appendTo(container);
                        }
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            "edit",
                          
                            {
                                name: "delete",
                                // เงื่อนไข: ให้แสดงปุ่มลบ (visible: true) ก็ต่อเมื่อ isActive มีค่าเป็น false เท่านั้น
                                visible: function(e) {
                                    return e.row.data.isActive === false;
                                }
                            }
                        ]
                    }
                ]
            });

            // ==========================================
            // 2. ดึงข้อมูล Divisions และสร้าง TreeView ด้านซ้าย
            // ==========================================
            try {
                // ดึงข้อมูล Division ทั้งหมด
                const divisionsData = await divisionsStore.load();

                // เรียงลำดับชื่อ A-Z
                divisionsData.sort((a, b) => (a.name > b.name) ? 1 : -1);

                // สร้างโครงสร้างข้อมูลสำหรับ TreeView
                const treeData = [{
                    id: 'root',
                    text: 'All Categories',
                    icon: 'home',
                    expanded: true,
                    isRoot: true,
                    // สร้าง Node ย่อยเป็นรายชื่อ Division
                    items: divisionsData.map(d => ({
                        id: 'div_' + d.id,
                        text: d.isActive ? d.name : `🚫 ${d.name} (Draft)`,
                        icon: 'folder',
                        divisionId: d.id
                    }))
                }];

                // สร้าง dxTreeView
                $("#divisionTreeView").dxTreeView({
                    dataSource: treeData,
                    height: "calc(100vh - 280px)", // จำกัดความสูงให้อยู่ในหน้าจอ
                    dataStructure: 'tree',
                    keyExpr: 'id',
                    displayExpr: 'text',
                    itemsExpr: 'items',
                    selectionMode: 'single',
                    selectByClick: true,
                    onItemSelectionChanged: function(e) {
                        const node = e.itemData;

                        const gridElement = $("#grid");
                        if (!gridElement.length || !gridElement.data("dxDataGrid")) return;

                        const grid = gridElement.dxDataGrid("instance");

                        // ระบบกรอง (Filter)
                        if (node.isRoot) {
                            grid.clearFilter(); // ล้าง Filter ดูทั้งหมด
                        } else if (node.divisionId) {
                            grid.filter(["divisionId", "=", node.divisionId]); // กรองตาม Division ID
                        }
                    },
                    onContentReady: function(e) {
                        // เลือก Root (All Categories) เป็นค่าเริ่มต้น
                        e.component.selectItem('root');
                    }
                });

            } catch (err) {
                console.error("Error loading divisions for treeview", err);
            }
        });

        // ฟังก์ชันสำหรับปุ่ม New Category ด้านบน
        function addNewCategory() {
            if (gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}