@{
    ViewBag.Title = "Category Management";
}

@section Styles {
    <style>
        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 700;
            color: var(--brand-dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* --- Content Card --- */
        .content-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
            border: none;
            overflow: hidden;
            height: calc(100vh - 240px);
            display: flex;
            flex-direction: column;
        }

        /* --- Custom Grid Styles --- */
        .dx-datagrid-headers {
            background-color: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

            .dx-datagrid-headers .dx-header-row > td {
                font-weight: 700 !important;
                color: #495057 !important;
                padding-top: 15px;
                padding-bottom: 15px;
            }

        /* --- Badges & Icons --- */
        .badge-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-active {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .badge-inactive {
            background-color: #f8d7da;
            color: #842029;
        }

        .btn-icon {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s;
            border: none;
            background: #f8f9fa;
            color: #6c757d;
        }

            .btn-icon:hover {
                transform: translateY(-2px);
                background-color: var(--brand-light);
                color: var(--brand-color);
            }

        .action-group {
            display: flex;
            gap: 6px;
            justify-content: center;
        }
    </style>
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-tags"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage course categories and assign them to divisions.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewCategory()">
                    <i class="fas fa-plus me-2"></i> New Category
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-4" id="grid-categories"></div>
    </div>
</div>

@section Scripts {
    <script>


        // DataStores
        const divisionsStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });
        const categoriesStore = createDataStore(serviceUrl, 'admin/CategoriesCRUD', { key: 'id' });

        let gridInstance;

        $(() => {
            gridInstance = $("#grid-categories").dxDataGrid({
                dataSource: categoriesStore,
                remoteOperations: true,
                columnAutoWidth: true,
                showBorders: false,
                height: "100%",
                scrolling: { mode: "virtual" },
                selection: { mode: 'single' },
                hoverStateEnabled: true,
                rowAlternationEnabled: false,
                showRowLines: true,
                searchPanel: { visible: true, width: 300, placeholder: "Search categories..." },
                headerFilter: { visible: true },

                // Editing Configuration (Popup)
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowAdding: true,
                    allowDeleting: true,
                    useIcons: true,
                    popup: {
                        title: "Category Information",
                        showTitle: true,
                        width: 500,
                        height: 450
                    },
                    form: {
                        items: [
                            {
                                itemType: "group",
                                caption: "Category Details",
                                items: [
                                    {
                                        dataField: "name",
                                        label: { text: "Category Name" },
                                        validationRules: [{ type: "required", message: "Name is required" }]
                                    },
                                    {
                                        dataField: "divisionId",
                                        label: { text: "Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: divisionsStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            showClearButton: true,
                                            placeholder: "Select Division (Optional)"
                                        }
                                    },
                                    {
                                        dataField: "isActive",
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Active Status" },
                                        label: { visible: false }
                                    }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        alignment: "center",
                        allowEditing: false,
                        sortOrder: 'desc',
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Category Name",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        width: 200,
                        lookup: {
                            dataSource: divisionsStore,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "isActive",
                        caption: "Status",
                        width: 120,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const isActive = options.value;
                            const badgeClass = isActive ? "badge-active" : "badge-inactive";
                            const icon = isActive ? "fa-check-circle" : "fa-times-circle";
                            const text = isActive ? "Active" : "Inactive";

                            $("<span>")
                                .addClass(`badge-status ${badgeClass}`)
                                .html(`<i class="fas ${icon}"></i> ${text}`)
                                .appendTo(container);
                        }
                    },
                    {
                        caption: "Manage",
                        width: 180,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // Edit Button
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Category")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // View Courses Button
                            $("<button>")
                                .addClass("btn-icon text-info")
                                .attr("title", "View Courses in this Category")
                                .html('<i class="fas fa-book-open"></i>')
                                .on("click", () => window.location.href = '@Url.Action("Index", "Courses")?categoryId=' + data.id)
                                .appendTo($group);

                            // Delete Button
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Category")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    confirmDelete(data.id, data.name);
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ],
                // ซ่อน command column เดิมของ DevExtreme
                onContentReady: function(e) {
                    // e.component.columnOption("command:edit", "visible", false);
                    // (เราไม่ได้เปิด command column ตั้งแต่แรกโดยการไม่ใส่ 'type: buttons' ใน columns)
                }
            }).dxDataGrid("instance");
        });

        function addNewCategory() {
            gridInstance.addRow();
        }

        function confirmDelete(id, name) {
            DevExpress.ui.dialog.confirm(
                `Are you sure you want to delete category "<strong>${name}</strong>"?`,
                "Confirm Delete"
            ).done(function (dialogResult) {
                if (dialogResult) {
                    // ใช้ store.remove หรือ grid.deleteRow ก็ได้
                    categoriesStore.remove(id).done(() => {
                        DevExpress.ui.notify("Category deleted successfully", "success", 2000);
                        gridInstance.refresh();
                    }).fail((err) => {
                        DevExpress.ui.notify("Failed to delete category", "error", 2000);
                    });
                }
            });
        }
    </script>
}