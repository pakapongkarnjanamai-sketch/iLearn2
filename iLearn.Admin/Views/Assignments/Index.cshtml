@{
    ViewBag.Title = "Assignments History";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-tasks"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        View assignment history and track employee learning progress.
                    </div>
                </div>
            </h1>
            <div>
                <a href="@Url.Action("Form", "Assignments")" class="btn btn-primary rounded shadow-sm px-3">
                    <i class="fas fa-plus me-2"></i> New Assignment
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                // เปลี่ยนมารับข้อมูลจาก Custom API ที่เราเขียน Grouping ไว้
                dataSource: new DevExpress.data.CustomStore({
                    key: "id",
                    load: function () {
                        return $.ajax({
                            url: `${serviceUrl}/Assignments/history`, // เรียก API ใหม่
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        });
                    }
                }),
                remoteOperations: false, // ปิด remoteOperations เพราะเรา Group และส่งมาทั้งหมดแล้ว
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search assignments..." },

                editing: {
                    mode: "popup",
                    allowUpdating: false,
                    allowDeleting: true,
                    allowAdding: false,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this ENTIRE assignment? (All associated courses will be removed)" }
                },
                columns: [
                    {
                        dataField: "assignmentNo",
                        caption: "Assignment No",
                        width: 150,
                        alignment: "center",
                        sortOrder: "desc"
                    },
                    {
                        // เปลี่ยนจาก courseId เป็น courseNames
                        dataField: "courseNames",
                        caption: "Assigned Courses",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            // แสดงชื่อวิชาหลายๆ อันแบบแบ่งบรรทัดสวยๆ
                            const courses = options.value ? options.value.split(', ') : [];
                            let html = '<div class="d-flex flex-wrap gap-1">';
                            courses.forEach(c => {
                                html += `<span class="badge bg-light text-dark border">${c}</span>`;
                            });
                            html += '</div>';
                            $(html).appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 150
                    },
                    {
                        dataField: "employeeCodes",
                        caption: "Target Users",
                        width: 120,
                        alignment: "center",
                        cellTemplate: (container, options) => {
                            const count = options.value ? options.value.split(',').length : 0;
                            $("<span>").addClass("badge bg-primary px-2 py-1").text(`${count} Users`).appendTo(container);
                        }
                    },
                    {
                        dataField: "startDate",
                        caption: "Start Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110,
                        alignment: "center"
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110,
                        alignment: "center"
                    },
                    {
                        type: "buttons",
                        caption: "Actions",
                        width: 110,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Progress Dashboard",
                                icon: "eye",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Progress", "Assignments")/' + e.row.data.id;
                                }
                            },
                            "delete"
                        ]
                    }
                ]
            });
        });
    </script>
}