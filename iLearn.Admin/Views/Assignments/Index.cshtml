@{
    ViewBag.Title = "Assignments History";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Assignments History</div>
        <div class="page-subtitle">View and manage all course assignments</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Gantt", "Assignments")" class="action-link">
            <i class="fas fa-project-diagram text-secondary"></i> Gantt View
        </a>
        <a href="@Url.Action("Form", "Assignments")" class="action-link primary">
            <i class="fas fa-plus"></i> New Assignment
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4">

    <!-- ── KPI Bar ── -->
    <div class="row g-2 mb-4" id="kpi-bar">
        <div class="col-6 col-md">
            <div class="kpi-card kpi-all active" onclick="filterByStatus(null, this)">
                <div class="kpi-label">All</div>
                <div class="kpi-number" id="kpi-all">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-inprogress" onclick="filterByStatus('InProgress', this)">
                <div class="kpi-label" style="color:var(--accent-color);">In Progress</div>
                <div class="kpi-number" style="color:var(--accent-color);" id="kpi-inprogress">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-upcoming" onclick="filterByStatus('Upcoming', this)">
                <div class="kpi-label" style="color:var(--warning-color);">Upcoming</div>
                <div class="kpi-number" style="color:var(--warning-color);" id="kpi-upcoming">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-expired" onclick="filterByStatus('Expired', this)">
                <div class="kpi-label" style="color:var(--danger-color);">Expired</div>
                <div class="kpi-number" style="color:var(--danger-color);" id="kpi-expired">—</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="kpi-card kpi-completed" onclick="filterByStatus('Completed', this)">
                <div class="kpi-label" style="color:var(--success-color);">Completed</div>
                <div class="kpi-number" style="color:var(--success-color);" id="kpi-completed">—</div>
            </div>
        </div>
    </div>

    <!-- ── DataGrid ── -->
    <div class="border rounded bg-white">
        <div class="panel-header">Assignment List</div>
        <div id="grid"></div>
    </div>

</div>

@section Scripts {
    <script>
        let gridInstance;
        let allData = [];
        let activeStatus = null;

        // ── Status badge ──
        function statusBadge(status) {
            const map = {
                "Completed":  { cls: "pill-success", text: "Completed"   },
                "Upcoming":   { cls: "pill-warning",  text: "Upcoming"    },
                "Expired":    { cls: "pill-danger",   text: "Expired"     },
                "InProgress": { cls: "pill-info",     text: "In Progress" }
            };
            const s = map[status] ?? { cls: "pill-default", text: status || "Unknown" };
            return `<span class="status-pill ${s.cls}">${s.text}</span>`;
        }

        function updateKpi(data) {
            $("#kpi-all").text(data.length);
            $("#kpi-inprogress").text(data.filter(d => d.status === "InProgress").length);
            $("#kpi-upcoming").text(data.filter(d => d.status === "Upcoming").length);
            $("#kpi-expired").text(data.filter(d => d.status === "Expired").length);
            $("#kpi-completed").text(data.filter(d => d.status === "Completed").length);
        }

        function filterByStatus(status, el) {
            activeStatus = status;
            $(".kpi-card").removeClass("active");
            $(el).addClass("active");
            applyFilters();
        }

        function applyFilters() {
            let filtered = allData;
            if (activeStatus) filtered = filtered.filter(d => d.status === activeStatus);
            gridInstance.option("dataSource", filtered);
        }

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: [],
                remoteOperations: true,
                selection: { mode: "single" },
                showBorders: false,
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                searchPanel: { visible: true, placeholder: "Search assignments..." },
                headerFilter: { visible: true },
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.status === "Expired")
                        $(e.rowElement).css("background-color", "#fff2f0");
                    if (e.rowType === "data" && e.data.status === "Completed")
                        $(e.rowElement).css("background-color", "#f6ffed");
                },
                columns: [
                    {
                        dataField: "assignmentNo", caption: "Assignment No", width: 145,
                        alignment: "center", sortOrder: "desc",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600", color: "var(--text-primary)" })
                                       .text(o.value || "-").appendTo(c)
                    },
                    {
                        dataField: "createdBy", caption: "Created By", width: 140,
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.value || "-").appendTo(c)
                    },
                    {
                        dataField: "courseNames", caption: "Courses", minWidth: 220,
                        cellTemplate: function (c, o) {
                            const courses = o.value ? o.value.split(", ").filter(x => x.trim()) : [];
                            if (!courses.length) { $("<span>").css("color", "var(--text-secondary)").text("—").appendTo(c); return; }
                            const wrap = $("<div>").addClass("d-flex flex-wrap gap-1").appendTo(c);
                            courses.slice(0, 3).forEach(name =>
                                $("<span>").addClass("tag-pill pill-default")
                                           .text(name).appendTo(wrap)
                            );
                            if (courses.length > 3)
                                $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                           .text(`+${courses.length - 3} more`).appendTo(wrap);
                        }
                    },
                    {
                        dataField: "description", caption: "Description", minWidth: 180,
                        cellTemplate: (c, o) => {
                            const t = o.value || "-";
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(t.length > 55 ? t.slice(0, 55) + "…" : t)
                                       .attr("title", t).appendTo(c);
                        }
                    },
                    {
                        caption: "Students", width: 90, alignment: "center",
                        calculateCellValue: d =>
                            d.studentCount || (d.employeeCodes ? d.employeeCodes.split(",").filter(x => x.trim()).length : 0),
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", fontWeight: "600", color: "var(--accent-color)" })
                                       .text(o.value).appendTo(c)
                    },
                    {
                        caption: "Progress", width: 130, alignment: "center",
                        calculateCellValue: d => {
                            const total = d.totalEnrollmentCount || 0;
                            const done  = d.completedEnrollmentCount || 0;
                            return total > 0 ? Math.round((done / total) * 100) : 0;
                        },
                        cellTemplate: (c, o) => {
                            const pct   = o.value;
                            const color = pct === 100 ? "var(--success-color)" : pct >= 50 ? "var(--accent-color)" : "var(--warning-color)";
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append(
                                    $("<div>").css({ flex: "1", height: "3px", background: "var(--border-color)",
                                                     borderRadius: "2px", overflow: "hidden" })
                                        .append($("<div>").css({ height: "100%", width: pct + "%", background: color }))
                                )
                                .append(
                                    $("<span>").css({ fontSize: "11px", fontWeight: "600",
                                                      minWidth: "32px", color: "var(--text-secondary)" })
                                               .text(pct + "%")
                                )
                                .appendTo(c);
                        }
                    },
                    {
                        dataField: "startDate", caption: "Start", dataType: "date",
                        format: "dd/MM/yyyy", width: 100, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    },
                    {
                        dataField: "dueDate", caption: "Due", dataType: "date",
                        format: "dd/MM/yyyy", width: 100, alignment: "center",
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    },
                    {
                        dataField: "status", caption: "Status", width: 130, alignment: "center",
                        cellTemplate: (c, o) => $(statusBadge(o.value)).appendTo(c)
                    },
                    {
                        type: "buttons", caption: "Actions", width: 70,
                        alignment: "center", fixed: true, fixedPosition: "right",
                        buttons: [{
                            hint: "View Progress", icon: "info",
                            onClick: e => window.location.href = `@Url.Action("Progress", "Assignments")/${e.row.data.id}`
                        }]
                    }
                ]
            });

            $.ajax({
                url: `${serviceUrl}/Assignments/history`,
                method: "GET",
                data: { pageSize: 100 },
                xhrFields: { withCredentials: true }
            }).done(function (res) {
                allData = Array.isArray(res) ? res : (res.data || []);
                updateKpi(allData);
                gridInstance.option("dataSource", allData);
            }).fail(() => showToast("Error loading assignment history.", "error"));
        });
    </script>
}