@{
    ViewBag.Title = "Assignment Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">@ViewBag.Title</h1>
        <div class="page-subtitle">Track assignment progress and completion.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Gantt", "Assignments")" class="action-link">
            Timeline
        </a>
        <a href="@Url.Action("BulkAssign", "Assignments")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Assignment
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>

@section Scripts {
    <script>
        const assignmentDetailUrl = '@Url.Action("Detail", "Assignments")';
        const assignmentsStore = createDataStore(serviceUrl, 'admin/AssignmentsCRUD', { key: 'id' });

        const STATUS_MAP = {
            "Completed":  { tone: "success", text: "Completed" },
            "Upcoming":   { tone: "warning", text: "Upcoming" },
            "Expired":    { tone: "danger", text: "Expired" },
            "InProgress": { tone: "primary", text: "In Progress" }
        };

        $(function () {
            initDxGrid("#grid", buildAdminGridOptions("Search by assignment no., course, or creator...", {
                dataSource: assignmentsStore,
                remoteOperations: true,

                onRowDblClick: function (e) {
                    navigateToDetail(e.data?.id);
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true,
                },
                columns: [
                    {
                        dataField: "assignmentNo",
                        caption: "Assignment No",
                        width: 150,
                        alignment: "center",
                        cssClass: "cell-code",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        dataField: "createdBy",
                        caption: "Created By",
                        width: 140,
                        cssClass: "cell-secondary",
                        customizeText: function(e) { return e.value || "—"; }
                    },
                    {
                        dataField: "courseNames",
                        caption: "Courses",
                        minWidth: 200,
                        cellTemplate: function (container, options) {
                            renderAdminCoursesCell(container, options.value);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 180,
                        cssClass: "cell-secondary",
                        customizeText: function(e) {
                            var text = e.value || "—";
                            return text.length > 55 ? text.slice(0, 55) + "\u2026" : text;
                        }
                    },
                    {
                        dataField: "studentCount",
                        caption: "Students",
                        width: 90,
                        alignment: "center",
                        cssClass: "cell-accent",
                        customizeText: function(e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "startDate",
                        caption: "Start",
                        width: 110,
                        alignment: "center",
                        dataType: "date",
                        cssClass: "cell-caption",
                        format: ADMIN_DATE_DISPLAY_FORMAT
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due",
                        width: 110,
                        alignment: "center",
                        dataType: "date",
                        cellTemplate: function (container, options) {
                            renderAdminDueDateCell(container, options.value);
                        }
                    },
                    {
                        dataField: "status",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            renderAdminStatusCell(container, options.value, STATUS_MAP);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Assignment Details",
                                icon: "info",
                                onClick: function (e) {
                                    navigateToDetail(e.row.data.id);
                                }
                            }
                        ]
                    }
                ]
            }));

            function navigateToDetail(id) {
                if (id) window.location.href = `${assignmentDetailUrl}/${id}`;
            }
        });
    </script>
}