@{
    ViewBag.Title = "Assignments History";
}



<!-- Header -->
<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 48px; height: 48px; background-color: #f0f4f9;">
                    <i class="fas fa-tasks text-primary fs-5"></i>
                </div>
                <div>
                    <h1 class="h5 mb-1 fw-bold text-dark">@ViewBag.Title</h1>
                    <small class="text-muted">View and manage all course assignments. Track employee learning progress.</small>
                </div>
            </div>
            <a href="@Url.Action("Form", "Assignments")" class="btn btn-primary rounded-2 px-4 py-2 d-flex align-items-center gap-2">
                <i class="fas fa-plus"></i> New Assignment
            </a>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container-fluid px-4 pb-5">
    <div class="card border rounded-3" style="border-color: #e8ecf1 !important; box-shadow: none;">
        <div class="card-body p-0">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                // Load data from API
                dataSource: new DevExpress.data.CustomStore({
                    key: "id",
                    load: function () {
                        return $.ajax({
                            url: `${serviceUrl}/Assignments/history`,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        });
                    }
                }),
                remoteOperations: false,
                selection: { mode: 'single' },

                // Minimal styling
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: false,

                // Search & Filter
                searchPanel: {
                    visible: true,
                    placeholder: "Search assignments..."
                },
                headerFilter: { visible: true },

                // Edit mode
                editing: {
                    mode: "popup",
                    allowUpdating: false,
                    allowDeleting: true,
                    allowAdding: false,
                    useIcons: true,
                    texts: {
                        confirmDeleteMessage: "Are you sure you want to delete this assignment?\n(All associated course enrollments will be removed)"
                    }
                },

                columns: [
                    {
                        dataField: "assignmentNo",
                        caption: "Assignment No",
                        width: 140,
                        alignment: "center",
                        sortOrder: "desc",
                        cellTemplate: function(container, options) {
                            $("<span class='fw-bold text-dark'>")
                                .text(options.value || '-')
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "courseNames",
                        caption: "Assigned Courses",
                        minWidth: 280,
                        cellTemplate: function(container, options) {
                            const courses = options.value ? options.value.split(', ').filter(c => c.trim()) : [];
                            
                            if (courses.length === 0) {
                                $("<span class='text-muted'>-</span>").appendTo(container);
                                return;
                            }

                            const wrapper = $("<div class='d-flex flex-wrap gap-1'></div>").appendTo(container);
                            courses.forEach(course => {
                                $(`<span class='badge bg-light text-dark border' style="border-color: #e8ecf1 !important; padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.85rem; font-weight: 500;">${course}</span>`)
                                    .appendTo(wrapper);
                            });
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 200,
                        cellTemplate: function(container, options) {
                            const text = options.value || '-';
                            const truncated = text.length > 60 ? text.substring(0, 60) + '...' : text;
                            $("<span class='text-muted'>")
                                .text(truncated)
                                .attr('title', text)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "employeeCodes",
                        caption: "Assigned To",
                        width: 130,
                        alignment: "center",
                        cellTemplate: function(container, options) {
                            const count = options.value ? options.value.split(',').length : 0;
                            $("<span class='badge' style='background-color: #f8fbff; border: 1px solid #0d6efd; border-opacity: 0.25; color: #0d6efd; padding: 0.4rem 1rem; border-radius: 20px; font-size: 0.85rem; font-weight: 600;'>")
                                .html(`<i class="fas fa-users me-1"></i> ${count}`)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "startDate",
                        caption: "Start Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 120,
                        alignment: "center"
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 120,
                        alignment: "center"
                    },
                    {
                        type: "buttons",
                        caption: "Actions",
                        width: 110,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Progress",
                                icon: "info",
                                onClick: function(e) {
                                    window.location.href = `@Url.Action("Progress", "Assignments")/${e.row.data.id}`;
                                }
                            },
                            {
                                hint: "Delete",
                                icon: "trash",
                                onClick: function(e) {
                                    if (confirm('Delete this assignment? All associated enrollments will be removed.')) {
                                        gridInstance.deleteRow(e.row.rowIndex);
                                    }
                                }
                            }
                        ]
                    }
                ]
            });
        });
    </script>
}

