@{
    ViewBag.Title = "Assignments History";
}

<style>
    /* ตั้งค่าพื้นหลังของหน้าให้เป็นสีเทาอ่อน สไตล์มินิมอล */
    body {
        background-color: #f8f9fa;
    }

    /* กล่องสำหรับใส่ Icon ใน Header ให้เป็นสัดส่วนเดียวกับหน้าอื่นๆ */
    .icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        flex-shrink: 0;
    }
</style>

<div class="bg-white border-bottom mb-4">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10 text-primary">
                    <i class="fas fa-tasks fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                    <small class="text-muted">View assignment history and track employee learning progress.</small>
                </div>
            </div>
            <div>
                <a href="@Url.Action("Form", "Assignments")" class="btn btn-primary rounded-3 shadow-sm px-4 py-2">
                    <i class="fas fa-plus me-1"></i> New Assignment
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5">
    <div class="card border-0 shadow-sm rounded-4 h-100">
        <div class="card-body p-4">
            <div class="rounded-3 overflow-hidden">
                <div id="grid"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", {
                // เปลี่ยนมารับข้อมูลจาก Custom API ที่เราเขียน Grouping ไว้
                dataSource: new DevExpress.data.CustomStore({
                    key: "id",
                    load: function () {
                        return $.ajax({
                            url: `${serviceUrl}/Assignments/history`, // เรียก API ใหม่
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        });
                    }
                }),
                remoteOperations: false, // ปิด remoteOperations เพราะเรา Group และส่งมาทั้งหมดแล้ว
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search assignments..." },

                // ปิด border เพื่อความคลีน
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,

                editing: {
                    mode: "popup",
                    allowUpdating: false,
                    allowDeleting: true,
                    allowAdding: false,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this ENTIRE assignment? \n(All associated courses will be removed)" }
                },
                columns: [
                    {
                        dataField: "assignmentNo",
                        caption: "Assignment No",
                        width: 150,
                        alignment: "center",
                        sortOrder: "desc",
                        cellTemplate: function(container, options) {
                            $("<span>").addClass("fw-bold text-dark").text(options.value).appendTo(container);
                        }
                    },
                    {
                        // เปลี่ยนจาก courseId เป็น courseNames
                        dataField: "courseNames",
                        caption: "Assigned Courses",
                        minWidth: 250,
                        cellTemplate: function(container, options) {
                            // แสดงชื่อวิชาหลายๆ อันแบบแบ่งบรรทัดสวยๆ โดยใช้สไตล์ป้ายขอบมนสีเทา
                            const courses = options.value ? options.value.split(', ') : [];
                            let html = '<div class="d-flex flex-wrap gap-2">';
                            courses.forEach(c => {
                                html += `<span class="badge bg-light text-dark border px-3 py-1 rounded-pill fw-normal">${c}</span>`;
                            });
                            html += '</div>';
                            $(html).appendTo(container);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 150
                    },
                    {
                        dataField: "employeeCodes",
                        caption: "Target Users",
                        width: 120,
                        alignment: "center",
                        cellTemplate: (container, options) => {
                            const count = options.value ? options.value.split(',').length : 0;
                            // ปรับสไตล์ป้ายแสดงจำนวนผู้เรียนให้ดูซอฟต์ลง
                            $("<span>")
                                .addClass("badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill fw-normal")
                                .text(`${count} Users`)
                                .appendTo(container);
                        }
                    },
                    {
                        dataField: "startDate",
                        caption: "Start Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110,
                        alignment: "center"
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110,
                        alignment: "center"
                    },
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 130,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "View Progress Dashboard",
                                icon: "info",
                                onClick: function(e) {
                                    window.location.href = '@Url.Action("Progress", "Assignments")/' + e.row.data.id;
                                }
                            },
                            "delete"
                        ]
                    }
                ]
            });
        });
    </script>
}