@{
    ViewBag.Title = "Assignment Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">@ViewBag.Title</div>
        <div class="page-subtitle">Track assignment progress and completion.</div>
    </div>
    <div class="page-header-actions">
        <a href="@Url.Action("Gantt", "Assignments")" class="action-link">
            Timeline
        </a>
        <a href="@Url.Action("Form", "Assignments")" class="action-link primary">
            <i class="fas fa-plus"></i> Create Assignment
        </a>
    </div>
</div>

<div class="container page-shell-lg px-4 py-3 pb-4 d-flex flex-column gap-3">

    <!-- ── KPI Bar ── -->
    <div class="row g-2" id="kpi-bar">
        <div class="col-6 col-md">
            <button type="button" class="kpi-card active" aria-pressed="true" onclick="filterByStatus(null, this)">
                <div class="kpi-label">All</div>
                <div class="kpi-number" id="kpi-all">—</div>
            </button>
        </div>
        <div class="col-6 col-md">
            <button type="button" class="kpi-card" aria-pressed="false" onclick="filterByStatus('InProgress', this)">
                <div class="kpi-label">In Progress</div>
                <div class="kpi-number" id="kpi-inprogress">—</div>
            </button>
        </div>
        <div class="col-6 col-md">
            <button type="button" class="kpi-card" aria-pressed="false" onclick="filterByStatus('Upcoming', this)">
                <div class="kpi-label">Upcoming</div>
                <div class="kpi-number" id="kpi-upcoming">—</div>
            </button>
        </div>
        <div class="col-6 col-md">
            <button type="button" class="kpi-card" aria-pressed="false" onclick="filterByStatus('Expired', this)">
                <div class="kpi-label">Expired</div>
                <div class="kpi-number" id="kpi-expired">—</div>
            </button>
        </div>
        <div class="col-6 col-md">
            <button type="button" class="kpi-card" aria-pressed="false" onclick="filterByStatus('Completed', this)">
                <div class="kpi-label">Completed</div>
                <div class="kpi-number" id="kpi-completed">—</div>
            </button>
        </div>
    </div>

    <!-- ── DataGrid ── -->
    <div class="panel">
        <div class="panel-header">Assignments</div>
        <div class="panel-body p-0">
            <div id="grid"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const ASSIGNMENTS_HISTORY_URL = `${serviceUrl}/Assignments/history`;
        const ASSIGNMENT_DETAIL_URL = `@Url.Action("Detail", "Assignments")`;
        const EMPTY_TEXT = "—";
        const DEFAULT_LOAD_SIZE = 100;

        let gridInstance;
        let activeStatus = null;

        function statusBadge(status) {
            const map = {
                "Completed":  { cls: "pill-success", text: "Completed"   },
                "Upcoming":   { cls: "pill-warning",  text: "Upcoming"    },
                "Expired":    { cls: "pill-danger",   text: "Expired"     },
                "InProgress": { cls: "pill-info",     text: "In Progress" }
            };
            const s = map[status] ?? { cls: "pill-default", text: status || "Not Set" };
            return `<span class="tag-pill ${s.cls}">${s.text}</span>`;
        }

        function formatDate(value) {
            return window.formatAdminDate(value, EMPTY_TEXT);
        }

        function renderCoursesCell(container, value) {
            renderAdminCoursesCell(container, value);
        }

        function updateActiveKpiCard(element) {
            $(".kpi-card").removeClass("active").attr("aria-pressed", "false");
            $(element).addClass("active").attr("aria-pressed", "true");
        }

        function calculateStudentCount(data) {
            return data.studentCount || (data.employeeCodes ? data.employeeCodes.split(",").filter(code => code.trim()).length : 0);
        }

        function calculateCompletionPct(data) {
            const total = data.totalEnrollmentCount || 0;
            const completed = data.completedEnrollmentCount || 0;
            return total > 0 ? Math.round((completed / total) * 100) : 0;
        }

        function navigateToAssignmentDetail(assignmentId) {
            window.location.href = `${ASSIGNMENT_DETAIL_URL}/${assignmentId}`;
        }

        function updateKpi(summary) {
            $("#kpi-all").text(summary?.all ?? 0);
            $("#kpi-inprogress").text(summary?.inProgress ?? 0);
            $("#kpi-upcoming").text(summary?.upcoming ?? 0);
            $("#kpi-expired").text(summary?.expired ?? 0);
            $("#kpi-completed").text(summary?.completed ?? 0);
        }

        function filterByStatus(status, el) {
            activeStatus = status;
            updateActiveKpiCard(el);
            gridInstance.pageIndex(0);
            gridInstance.refresh();
        }

        window.filterByStatus = filterByStatus;

        function getSortParams(loadOptions) {
            const sort = Array.isArray(loadOptions.sort) && loadOptions.sort.length
                ? loadOptions.sort[0]
                : null;

            return {
                sortBy: sort?.selector || "assignmentNo",
                sortDescending: sort?.desc !== false
            };
        }

        function createAssignmentsStore() {
            return new DevExpress.data.CustomStore({
                key: "id",
                load: function(loadOptions) {
                    const sort = getSortParams(loadOptions);
                    const take = loadOptions.take || DEFAULT_LOAD_SIZE;
                    const skip = loadOptions.skip || 0;

                    return $.ajax({
                        url: ASSIGNMENTS_HISTORY_URL,
                        method: "GET",
                        data: {
                            page: Math.floor(skip / take) + 1,
                            pageSize: take,
                            search: loadOptions.searchValue || null,
                            status: activeStatus,
                            sortBy: sort.sortBy,
                            sortDescending: sort.sortDescending
                        },
                        xhrFields: { withCredentials: true }
                    }).then(function(response) {
                        updateKpi(response.summary);

                        return {
                            data: response.data || [],
                            totalCount: response.totalCount || 0
                        };
                    }).catch(function() {
                        showToast("Couldn't load assignments. Please refresh and try again.", "error");
                        return {
                            data: [],
                            totalCount: 0
                        };
                    });
                }
            });
        }

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createAssignmentsStore(),
                remoteOperations: {
                    paging: true,
                    sorting: true,
                    filtering: true
                },
                selection: { mode: "single" },
                rowAlternationEnabled: false,
                showRowLines: true,
                hoverStateEnabled: true,
                searchPanel: { visible: true, placeholder: "Search by assignment no., course, or creator..." },
                headerFilter: { visible: false },
                export: { enabled: true, allowExportSelectedData: true },   
                onExporting: (e) => handleExporting(e, 'Assignments_History'),
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.status === "Expired") {
                        $(e.rowElement).css("background-color", "var(--surface-danger-subtle)");
                    }

                    if (e.rowType === "data" && e.data.status === "Completed") {
                        $(e.rowElement).css("background-color", "var(--surface-success-subtle)");
                    }
                },
                columns: [
                    {
                        dataField: "assignmentNo", caption: "Assignment No", width: 145,
                        alignment: "center", sortOrder: "desc",
                        cellTemplate: function(container, options) {
                            appendAdminText(container, options.value || "-", {
                                fontSize: "12px",
                                fontWeight: "600",
                                color: "var(--text-primary)"
                            });
                        }
                    },
                    {
                        dataField: "createdBy", caption: "Created By", width: 140,
                        cellTemplate: function(container, options) {
                            appendAdminText(container, options.value || "-", {
                                fontSize: "12px",
                                color: "var(--text-secondary)"
                            });
                        }
                    },
                    {
                        dataField: "courseNames", caption: "Courses", minWidth: 220,
                        cellTemplate: function(container, options) {
                            renderCoursesCell(container, options.value);
                        }
                    },
                    {
                        dataField: "description", caption: "Description", minWidth: 180,
                        cellTemplate: function(container, options) {
                            const description = options.value || "-";
                            appendAdminText(container, truncateAdminText(description, 55), {
                                fontSize: "12px",
                                color: "var(--text-secondary)"
                            }).attr("title", description);
                        }
                    },
                    {
                        dataField: "studentCount", caption: "Students", width: 90, alignment: "center",
                        cellTemplate: function(container, options) {
                            appendAdminText(container, String(options.value ?? 0), {
                                fontSize: "12px",
                                fontWeight: "600",
                                color: "var(--accent-color)"
                            });
                        }
                    },
                    {
                        dataField: "completedEnrollmentCount", caption: "Progress", width: 130, alignment: "center",
                        allowSorting: false,
                        cellTemplate: function(container, options) {
                            renderAdminProgressCell(container, calculateCompletionPct(options.data));
                        }
                    },
                    {
                        dataField: "startDate", caption: "Start", dataType: "date",
                        format: ADMIN_DATE_DISPLAY_FORMAT, width: 100, alignment: "center",
                        cellTemplate: function(container, options) {
                            appendAdminText(container, formatDate(options.value), {
                                fontSize: "11px",
                                color: "var(--text-secondary)"
                            });
                        }
                    },
                    {
                        dataField: "dueDate", caption: "Due", dataType: "date",
                        format: ADMIN_DATE_DISPLAY_FORMAT, width: 100, alignment: "center",
                        cellTemplate: function(container, options) {
                            appendAdminText(container, formatDate(options.value), {
                                fontSize: "11px",
                                color: "var(--text-secondary)"
                            });
                        }
                    },
                    {
                        dataField: "status", caption: "Status", width: 130, alignment: "center",
                        cellTemplate: function(container, options) {
                            $(statusBadge(options.value)).appendTo(container);
                        }
                    },
                    {
                        type: "buttons", caption: "Quick Actions", width: 70,
                        alignment: "center", fixed: true, fixedPosition: "right",
                        buttons: [{
                            hint: "Open Assignment Details", icon: "info",
                            onClick: function(e) {
                                navigateToAssignmentDetail(e.row.data.id);
                            }
                        }]
                    }
                ]
            });
        });
    </script>
}