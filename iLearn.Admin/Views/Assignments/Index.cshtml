@{
    ViewBag.Title = "Assignment Management";
}

@section Styles {
    <style>
        .assignment-monitor-bar {
            display: flex;
            flex: 1 1 640px;
            flex-direction: column;
            gap: 10px;
            min-width: 320px;
        }

        .assignment-monitor-head {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .assignment-monitor-kicker {
            font-size: var(--font-size-caption);
            line-height: var(--text-caption-line-height);
            font-weight: var(--font-weight-semibold);
            letter-spacing: var(--letter-spacing-normal);
            text-transform: uppercase;
            color: var(--text-secondary);
        }

        .assignment-monitor-note {
            font-size: var(--font-size-sm);
            line-height: var(--text-secondary-line-height);
            color: var(--text-primary);
        }

        .assignment-monitor-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .assignment-filter-chip {
            appearance: none;
            border: 1px solid var(--border-color);
            background: var(--surface-panel);
            color: var(--text-primary);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: var(--font-size-caption);
            line-height: 1.2;
            font-weight: var(--font-weight-semibold);
            cursor: pointer;
            transition: background-color 0.18s ease-out, border-color 0.18s ease-out, color 0.18s ease-out;
        }

        .assignment-filter-chip:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .assignment-filter-chip:focus-visible {
            outline: 2px solid var(--primary-color);
            outline-offset: 2px;
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .assignment-filter-chip.is-active {
            background: var(--primary-subtle);
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .assignment-filter-chip.is-clear {
            color: var(--text-secondary);
        }

        .assignment-filter-chip.is-clear:hover,
        .assignment-filter-chip.is-clear:focus-visible {
            color: var(--danger-color);
            border-color: var(--danger-color);
        }

        @@media (max-width: 991.98px) {
            .page-header {
                align-items: flex-start !important;
            }

            .page-header-actions {
                width: 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .assignment-filter-chip {
                transition: none;
            }
        }
    </style>
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div class="assignment-monitor-bar">
      
        <div class="assignment-monitor-filters" role="group" aria-label="Assignment quick filters">
            <button type="button" class="assignment-filter-chip is-active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="assignment-filter-chip" data-filter="InProgress" aria-pressed="false">In Progress</button>
            <button type="button" class="assignment-filter-chip" data-filter="Upcoming" aria-pressed="false">Upcoming</button>
            <button type="button" class="assignment-filter-chip" data-filter="Expired" aria-pressed="false">Expired</button>
            <button type="button" class="assignment-filter-chip" data-filter="Completed" aria-pressed="false">Completed</button>
            <button type="button" class="assignment-filter-chip" data-filter="dueSoon" aria-pressed="false">Due in 7 days</button>
            <button type="button" class="assignment-filter-chip" data-filter="overdue" aria-pressed="false">Overdue</button>
            <button type="button" class="assignment-filter-chip is-clear" data-filter="clear" aria-pressed="false">Clear filters</button>
        </div>
    </div>

    <div class="page-header-actions">
        <a href="@Url.Action("Gantt", "Assignments")" class="action-link">
            Timeline
        </a>
        <a href="@Url.Action("BulkAssign", "Assignments")" class="action-link primary">
            <i class="fas fa-plus" aria-hidden="true"></i> Create Assignment
        </a>
    </div>
</div>

<div class="container-fluid admin-viewport-layout px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100 admin-viewport-fill"></div>
    </div>
</div>

@section Scripts {
    <script>
        const assignmentDetailUrl = '@Url.Action("Detail", "Assignments")';
        const assignmentsStore = createDataStore(serviceUrl, 'admin/AssignmentsCRUD', { key: 'id' });

        const STATUS_MAP = {
            "Completed": { tone: "success", text: "Completed" },
            "Upcoming": { tone: "warning", text: "Upcoming" },
            "Expired": { tone: "danger", text: "Expired" },
            "InProgress": { tone: "primary", text: "In Progress" }
        };

        const QUICK_FILTER_SUMMARY = {
            all: "Showing all assignments",
            InProgress: "Showing assignments that are currently in progress",
            Upcoming: "Showing assignments that have not started yet",
            Expired: "Showing expired assignments",
            Completed: "Showing completed assignments",
            dueSoon: "Showing assignments due in the next 7 days",
            overdue: "Showing overdue assignments"
        };

        $(function () {
            const grid = initDxGrid("#grid", buildAdminGridOptions("Search by assignment no., course, or creator...", {
                height: "100%",
                dataSource: assignmentsStore,
                remoteOperations: true,

                onRowDblClick: function (e) {
                    navigateToDetail(e.data?.id);
                },
                groupPanel: {
                    emptyPanelText: '@ViewBag.Title',
                    visible: true
                },
                columns: [
                    {
                        dataField: "assignmentNo",
                        caption: "Assignment No",
                        width: 150,
                        alignment: "center",
                        cssClass: "cell-code",
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        dataField: "createdBy",
                        caption: "Created By",
                        width: 140,
                        cssClass: "cell-secondary",
                        customizeText: function (e) { return e.value || "—"; }
                    },
                    {
                        dataField: "courseNames",
                        caption: "Courses",
                        minWidth: 200,
                        cellTemplate: function (container, options) {
                            renderAdminCoursesCell(container, options.value);
                        }
                    },
                    {
                        dataField: "description",
                        caption: "Description",
                        minWidth: 180,
                        cssClass: "cell-secondary",
                        customizeText: function (e) {
                            var text = e.value || "—";
                            return text.length > 55 ? text.slice(0, 55) + "\u2026" : text;
                        }
                    },
                    {
                        dataField: "studentCount",
                        caption: "Learners",
                        width: 90,
                        alignment: "center",
                        cssClass: "cell-accent",
                        customizeText: function (e) { return String(e.value ?? 0); }
                    },
                    {
                        dataField: "startDate",
                        caption: "Start",
                        width: 110,
                        alignment: "center",
                        dataType: "date",
                        cssClass: "cell-caption",
                        format: ADMIN_DATE_DISPLAY_FORMAT
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due",
                        width: 110,
                        alignment: "center",
                        dataType: "date",
                        cellTemplate: function (container, options) {
                            renderAdminDueDateCell(container, options.value);
                        }
                    },
                    {
                        dataField: "status",
                        caption: "Status",
                        width: 130,
                        alignment: "center",
                        cellTemplate: function (container, options) {
                            renderAdminStatusCell(container, options.value, STATUS_MAP);
                        }
                    },
                    {
                        type: "buttons",
                        caption: "",
                        width: 60,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: [
                            {
                                hint: "Open Assignment Details",
                                icon: "info",
                                onClick: function (e) {
                                    navigateToDetail(e.row.data.id);
                                }
                            }
                        ]
                    }
                ]
            }));

            bindQuickFilters(grid);

            window.enableAdminViewportLayout({
                refreshTargets: [grid]
            });

            function bindQuickFilters(gridInstance) {
                $(".assignment-filter-chip").on("click", function () {
                    const filterKey = String($(this).data("filter") || "all");
                    applyQuickFilter(gridInstance, filterKey);
                });
            }

            function applyQuickFilter(gridInstance, filterKey) {
                const today = startOfDay(new Date());
                const next7Days = startOfDay(new Date());
                next7Days.setDate(next7Days.getDate() + 7);

                if (filterKey === "clear" || filterKey === "all") {
                    gridInstance.clearFilter();
                    setActiveQuickFilter("all");
                    updateFilterSummary(QUICK_FILTER_SUMMARY.all);
                    return;
                }

                if (filterKey === "dueSoon") {
                    gridInstance.filter([
                        ["dueDate", ">=", today],
                        "and",
                        ["dueDate", "<=", next7Days],
                        "and",
                        ["status", "<>", "Completed"]
                    ]);
                    setActiveQuickFilter(filterKey);
                    updateFilterSummary(QUICK_FILTER_SUMMARY[filterKey]);
                    return;
                }

                if (filterKey === "overdue") {
                    gridInstance.filter([
                        ["dueDate", "<", today],
                        "and",
                        ["status", "<>", "Completed"]
                    ]);
                    setActiveQuickFilter(filterKey);
                    updateFilterSummary(QUICK_FILTER_SUMMARY[filterKey]);
                    return;
                }

                gridInstance.filter(["status", "=", filterKey]);
                setActiveQuickFilter(filterKey);
                updateFilterSummary(QUICK_FILTER_SUMMARY[filterKey] || QUICK_FILTER_SUMMARY.all);
            }

            function setActiveQuickFilter(activeFilterKey) {
                $(".assignment-filter-chip").each(function () {
                    const filterKey = String($(this).data("filter") || "all");
                    const isActive = filterKey === activeFilterKey;

                    $(this)
                        .toggleClass("is-active", isActive)
                        .attr("aria-pressed", isActive ? "true" : "false");
                });
            }

            function updateFilterSummary(text) {
                $("#assignment-filter-summary").text(text || QUICK_FILTER_SUMMARY.all);
            }

            function startOfDay(value) {
                const date = new Date(value);
                date.setHours(0, 0, 0, 0);
                return date;
            }

            function navigateToDetail(id) {
                if (id) window.location.href = `${assignmentDetailUrl}/${id}`;
            }
        });
    </script>
}