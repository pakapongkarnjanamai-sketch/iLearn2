    function setActiveCourseFilter(ruleId, title) {
        $("#course-list").find(".course-item").removeClass("active");
        $("#course-list").find(`.course-item[data-rule="${ruleId}"]`).addClass("active");
        $("#student-grid-subtitle").text(`— ${title}`);
        const grid = $("#student-grid").dxDataGrid("instance");
        if (!grid) {
            return;
        }

        grid.option("dataSource", getStudentsForRule(ruleId));
        grid.searchByText("");
    }

    function groupStudentsByRuleId(students) {
        const grouped = new Map();

        students.forEach(student => {
            const key = student.assignmentRuleId ?? 0;
            if (!grouped.has(key)) {
                grouped.set(key, []);
            }

            grouped.get(key).push(student);
        });

        return grouped;
    }

    function getStudentsForRule(ruleId) {
        return studentsByRuleId.get(ruleId ?? 0) || [];
    }

    function getCourseCompletionPercent(course) {
        return course.totalStudents > 0
            ? Math.round((course.completedStudents / course.totalStudents) * 100)
            : 0;
    }

    function formatDate(value, fallback = EMPTY_TEXT) {
        return window.formatAdminDate(value, fallback);
    }

    function reloadDetail(message) {
        showToast(message, "success");
        window.setTimeout(() => window.location.reload(), 600);
    }

    function showConfirmDialog(options) {
        const deferred = $.Deferred();
        const confirmType = options.confirmClass === "btn-danger" ? "danger" : "default";

        showAdminConfirmDialog({
            title: options.title,
            messageHtml: options.html,
            text: options.text,
            icon: options.icon || "warning",
            confirmButtonText: options.confirmButtonText,
            cancelButtonText: options.cancelButtonText,
            confirmType: confirmType
        }).done(function(confirmed) {
            deferred.resolve({ isConfirmed: confirmed });
        });

        return deferred.promise();
    }

    function getProgressColor(progress) {
        if (progress === 100) {
            return "var(--success-color)";
        }

        if (progress > 0) {
            return "var(--accent-color)";
        }

        return "var(--border-color)";
    }

    function renderStudentStatusCell(container, isCompleted, progress) {
        let dotClass = "dot-default";
        let label = "Pending";

        if (isCompleted) {
            dotClass = "dot-success";
            label = "Completed";
        } else if (progress > 0) {
            dotClass = "dot-warning";
            label = "In Progress";
        }

        $("<span>").css({ fontSize: "12px" })
            .append($("<span>").addClass(`status-dot ${dotClass}`))
            .append(label)
            .appendTo(container);
    }

    function confirmRemoveCourse(ruleId, title) {
        showConfirmDialog({
            title: "Remove assigned course?",
            html: `Course <b>${window.escapeHtml(title || EMPTY_TEXT)}</b> will be removed from this assignment.`,
            confirmButtonText: "Remove",
            confirmClass: "btn-danger",
            cancelButtonText: "Cancel"
        }).then(async function(result) {
            if (!result.isConfirmed) {
                return;
            }

            loadPanel.option("message", "Removing course...");
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/courses/${ruleId}`,
                    method: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                if (response.assignmentDeleted) {
                    showToast(response.message || "Assignment removed.", "success");
                    window.setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 600);
                    return;
                }

                reloadDetail(response.message || "Course removed.");
            } catch (error) {
                loadPanel.hide();
                showToast(window.getApiErrorMessage(error, "Error removing course."), "error", 4000);
            }
        });
    }

    function confirmRemoveStudent(studentCode, studentName) {
        showConfirmDialog({
            title: "Remove student from assignment?",
            html: `<b>${window.escapeHtml(studentCode || EMPTY_TEXT)}</b> ${window.escapeHtml(studentName || EMPTY_TEXT)} will be removed from all assigned courses in this assignment.`,
            confirmButtonText: "Remove",
            confirmClass: "btn-danger",
            cancelButtonText: "Cancel"
        }).then(async function(result) {
            if (!result.isConfirmed) {
                return;
            }

            loadPanel.option("message", "Removing student...");
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/students/${encodeURIComponent(studentCode)}`,
                    method: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                reloadDetail(response.message || "Student removed.");
            } catch (error) {
                loadPanel.hide();
                showToast(window.getApiErrorMessage(error, "Error removing student."), "error", 4000);
            }
        });
    }

    function getDefaultReassignmentDates() {
        const today = new Date();
        const defaultStartDate = currentStartDate || today;
        const defaultDueDate = currentDueDate
            || new Date(defaultStartDate.getFullYear(), defaultStartDate.getMonth(), defaultStartDate.getDate() + 7);

        return {
            startDate: defaultStartDate,
            dueDate: defaultDueDate
        };
    }

    function getReassignmentStudentCodes() {
        return [...new Set((dashboardData?.students || [])
            .map(student => student.studentCode)
            .filter(Boolean))];
    }

    function buildConflictPreviewHtml(items, title, toneClass, iconClass) {
        if (!items.length) {
            return "";
        }

        const previewItems = items.slice(0, 5).map(function(item) {
            return `
                <li class="mb-1">
                    <span class="fw-semibold">${window.escapeHtml(item.studentCode)}</span>
                    <span class="text-secondary mx-1">→</span>
                    <span>${window.escapeHtml(item.courseTitle)}</span>
                </li>`;
        }).join("");

        const remainingCount = items.length - 5;
        const moreText = remainingCount > 0
            ? `<div class="u-fs-11 text-secondary mt-2">${window.formatAdminCountLabel(remainingCount, 'more', 'more', '0 more', { prefix: '+' })}</div>`
            : "";

        return `
            <div class="border rounded p-3 mt-3 ${toneClass}">
                <div class="u-fw-semibold u-fs-12 mb-2">
                    <i class="fas ${iconClass} me-1"></i>${title} (${window.formatAdminCountLabel(items.length, 'item')})
                </div>
                <ul class="mb-0 ps-3 u-fs-12">${previewItems}</ul>
                ${moreText}
            </div>`;
    }

    function showReassignmentSummaryDialog(validationResult, payload) {
        const resolvedCount = validationResult.resolvedCount
            || payload.employeeCodes.length
            || dashboardData?.totalStudents
            || dashboardData?.totalEmployees
            || 0;
        const targetText = payload.groupId
            ? `${window.escapeHtml(dashboardData?.studentGroupName || "Selected group")} (${window.formatAdminCountLabel(resolvedCount, 'student')})`
            : window.formatAdminCountLabel(resolvedCount, 'student');
        const inProgressConflicts = validationResult.inProgressConflicts || [];
        const completedConflicts = validationResult.completedConflicts || [];

        const summaryHtml = `
            <div class="text-start dialog-body-sm">
                <div class="border rounded p-3 bg-light-subtle mb-3">
                    <div class="u-fs-11 text-uppercase text-secondary u-fw-semibold mb-1">Assignment Criteria</div>
                    <div class="u-fs-12 mb-1"><strong>Description:</strong> ${window.escapeHtml(payload.description || EMPTY_TEXT)}</div>
                    <div class="u-fs-12 mb-1"><strong>Period:</strong> ${formatDate(payload.startDate)} → ${formatDate(payload.dueDate)}</div>
                    <div class="u-fs-12 mb-1"><strong>Courses:</strong> ${payload.courseIds.length}</div>
                    <div class="u-fs-12"><strong>Target:</strong> ${targetText}</div>
                </div>
                <div class="u-fs-12 text-secondary">Courses and target students are copied from the current assignment. Only the criteria above will be changed.</div>
                ${buildConflictPreviewHtml(inProgressConflicts, "In-progress enrollments will be reset", "border-warning-subtle bg-warning-subtle", "fa-rotate-right")}
                ${buildConflictPreviewHtml(completedConflicts, "Completed enrollments will be re-assigned", "border-info-subtle bg-info-subtle", "fa-check-circle")}
            </div>`;

        return showAdminConfirmDialog({
            title: "Create Reassignment?",
            messageHtml: summaryHtml,
            icon: "question",
            confirmButtonText: "Create Reassignment",
            cancelButtonText: "Cancel",
            confirmType: "default",
            width: 560
        });
    }

    async function executeReassignment(payload) {
        loadPanel.option("message", "Creating reassignment...");
        loadPanel.show();

        try {
            const response = await $.ajax({
                url: BULK_ASSIGN_URL,
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                xhrFields: { withCredentials: true }
            });

            showToast("Reassignment created successfully.", "success", 2000);
            window.setTimeout(() => window.location.href = `@Url.Action("Detail", "Assignments")/${response.assignmentId}`, 1500);
        } catch (error) {
            loadPanel.hide();
            showToast(window.getApiErrorMessage(error, "Failed to create reassignment."), "error", 4000);
        }
    }

    async function handleReassignment(e) {
        e.preventDefault();
        if (!dashboardData) {
            return;
        }

        loadPanel.option("message", "Preparing reassignment...");
        loadPanel.show();

        let reassignData;
        try {
            const response = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/reassign-data/${ASSIGNMENT_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            if (!response.success || !response.data?.courseIds?.length) {
                loadPanel.hide();
                showToast("No courses available for reassignment.", "warning", 3000);
                return;
            }

            reassignData = response.data;
            loadPanel.hide();
        } catch (error) {
            loadPanel.hide();
            showToast(window.getApiErrorMessage(error, "Unable to prepare reassignment."), "error", 4000);
            return;
        }

        const dialogId = `reassignment-dialog-${Date.now()}`;
        const formId = `${dialogId}-form`;
        const cancelId = `${dialogId}-cancel`;
        const confirmId = `${dialogId}-confirm`;
        const defaults = getDefaultReassignmentDates();
        const lockedTargetText = reassignData.studentGroupId
            ? window.escapeHtml(dashboardData.studentGroupName || "Selected group")
            : window.formatAdminCountLabel(getReassignmentStudentCodes().length, 'student');

        const dialog = DevExpress.ui.dialog.custom({
            title: "Reassignment",
            messageHtml: `
                <div id="${dialogId}" class="pt-2 text-start">
                    <div class="u-fs-12 text-secondary mb-3">
                        Courses and target students are copied from the current assignment. You can change only the assignment criteria below.
                    </div>
                    <div class="border rounded p-3 bg-light-subtle mb-3 u-fs-12">
                        <div class="mb-1"><strong>Courses:</strong> ${reassignData.courseIds.length}</div>
                        <div><strong>Target:</strong> ${lockedTargetText}</div>
                    </div>
                    <div id="${formId}"></div>
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <div id="${cancelId}"></div>
                        <div id="${confirmId}"></div>
                    </div>
                </div>`,
            buttons: [],
            dragEnabled: false,
            closeOnOutsideClick: false,
            showCloseButton: true,
            width: 520
        });

        dialog.show();

        window.setTimeout(function() {
            const $formHost = $("#" + formId);
            if (!$formHost.length) {
                return;
            }

            const criteriaForm = $formHost.dxForm({
                labelMode: "floating",
                formData: {
                    description: dashboardData.description || "",
                    startDate: defaults.startDate,
                    dueDate: defaults.dueDate
                },
                items: [
                    {
                        dataField: "description",
                        editorType: "dxTextArea",
                        editorOptions: { height: 100 },
                        validationRules: [{ type: "required", message: "Required" }]
                    },
                    {
                        itemType: "group",
                        colCount: 2,
                        items: [
                            {
                                dataField: "startDate",
                                editorType: "dxDateBox",
                                editorOptions: { width: "100%", displayFormat: ADMIN_DATE_DISPLAY_FORMAT },
                                validationRules: [{ type: "required", message: "Required" }]
                            },
                            {
                                dataField: "dueDate",
                                editorType: "dxDateBox",
                                editorOptions: { width: "100%", displayFormat: ADMIN_DATE_DISPLAY_FORMAT },
                                validationRules: [{ type: "required", message: "Required" }]
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            $("#" + cancelId).dxButton({
                text: "Cancel",
                stylingMode: "outlined",
                onClick: function() {
                    dialog.hide();
                }
            });

            $("#" + confirmId).dxButton({
                text: "Continue",
                type: "default",
                stylingMode: "contained",
                onClick: async function() {
                    if (!criteriaForm.validate().isValid) {
                        return;
                    }

                    const formData = criteriaForm.option("formData");
                    if (new Date(formData.dueDate) <= new Date(formData.startDate)) {
                        showToast("Due date must be after start date.", "warning", 2500);
                        return;
                    }

                    const employeeCodes = reassignData.studentGroupId ? [] : getReassignmentStudentCodes();
                    if (!reassignData.studentGroupId && employeeCodes.length === 0) {
                        showToast("No students available for reassignment.", "warning", 3000);
                        return;
                    }

                    const payload = {
                        courseIds: reassignData.courseIds,
                        employeeCodes: employeeCodes,
                        groupId: reassignData.studentGroupId || null,
                        startDate: formData.startDate,
                        dueDate: formData.dueDate,
                        description: formData.description,
                        confirmReassignInProgress: false,
                        confirmReassignCompleted: false
                    };

                    dialog.hide();
                    loadPanel.option("message", "Validating reassignment...");
                    loadPanel.show();

                    try {
                        const validationResult = await $.ajax({
                            url: ASSIGNMENT_VALIDATE_URL,
                            method: "POST",
                            contentType: "application/json",
                            data: JSON.stringify(payload),
                            xhrFields: { withCredentials: true }
                        });

                        loadPanel.hide();
                        payload.confirmReassignInProgress = (validationResult.inProgressConflicts || []).length > 0;
                        payload.confirmReassignCompleted = (validationResult.completedConflicts || []).length > 0;

                        showReassignmentSummaryDialog(validationResult, payload).done(function(confirmed) {
                            if (confirmed) {
                                executeReassignment(payload);
                            }
                        });
                    } catch (error) {
                        loadPanel.hide();
                        showToast(window.getApiErrorMessage(error, "Unable to validate reassignment."), "error", 4000);
                    }
                }
            });
        }, 0);
    }

    function confirmResetEnrollment(options) {
        const { title, messageHtml, ruleIds, studentCodes, loadingMessage, successMessage, errorMessage } = options;

        const dialog = DevExpress.ui.dialog.custom({
            title: title,
            messageHtml: messageHtml,
            buttons: [
                { text: "Cancel", onClick: function() { return false; } },
                { text: "Reset", type: "danger", onClick: function() { return true; } }
            ]
        });

        dialog.show().done(async function(confirmed) {
            if (!confirmed) return;

            loadPanel.option("message", loadingMessage);
            loadPanel.show();

            try {
                const payload = { ruleIds: ruleIds };
                if (studentCodes) payload.studentCodes = studentCodes;

                const response = await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/reset-enrollments`,
                    method: "POST",
                    contentType: "application/json",
                    xhrFields: { withCredentials: true },
                    data: JSON.stringify(payload)
                });

                reloadDetail(response.message || successMessage);
            } catch (error) {
                loadPanel.hide();
                showToast(window.getApiErrorMessage(error, errorMessage), "error", 4000);
            }
        });
    }

    function confirmResetCourse(ruleId, title) {
        confirmResetEnrollment({
            title: "Reset All Students",
            messageHtml: `Reset enrollment progress for all students in:<br><b><i class="fas fa-book me-1"></i>${window.escapeHtml(title)}</b><br><br><span style="color:var(--danger-color);font-size:11px;"><i class="fas fa-exclamation-triangle me-1"></i>Progress will be cleared. This action cannot be undone.</span>`,
            ruleIds: [ruleId],
            studentCodes: null,
            loadingMessage: "Resetting enrollments...",
            successMessage: "Enrollments reset successfully.",
            errorMessage: "Error resetting enrollments."
        });
    }

    function confirmResetStudent(ruleId, studentCode, studentName) {
        confirmResetEnrollment({
            title: "Reset Student Enrollment",
            messageHtml: `Reset enrollment progress for:<br><b><i class="fas fa-user me-1"></i>${window.escapeHtml(studentCode)} ${window.escapeHtml(studentName)}</b><br><br><span style="color:var(--danger-color);font-size:11px;"><i class="fas fa-exclamation-triangle me-1"></i>Progress will be cleared. This action cannot be undone.</span>`,
            ruleIds: [ruleId],
            studentCodes: [studentCode],
            loadingMessage: "Resetting enrollment...",
            successMessage: "Enrollment reset successfully.",
            errorMessage: "Error resetting enrollment."
        });
    }

    function handleDeleteAssignment(e) {
        e.preventDefault();
        showConfirmDialog({
            title: "Delete this assignment?",
            html: `<div class="text-secondary">All related enrollments will be permanently removed.</div>`,
            confirmButtonText: "Delete",
            confirmClass: "btn-danger",
            cancelButtonText: "Cancel"
        }).then(async function(result) {
            if (!result.isConfirmed) return;

            loadPanel.option("message", "Deleting...");
            loadPanel.show();

            try {
                await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}`,
                    type: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                showToast("Deleted successfully.", "success", 2000);
                setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 1500);
            } catch {
                showToast("Error deleting.", "error");
                loadPanel.hide();
            }
        });
    }

    function openExtendDueDatePopup() {
        const dialogId = `extend-due-date-dialog-${Date.now()}`;
        const pickerId = `${dialogId}-picker`;
        const cancelId = `${dialogId}-cancel`;
        const confirmId = `${dialogId}-confirm`;
        const minDate = currentStartDate
            ? new Date(currentStartDate.getFullYear(), currentStartDate.getMonth(), currentStartDate.getDate() + 1)
            : new Date();

        const dialog = DevExpress.ui.dialog.custom({
            title: "Extend Due Date",
            messageHtml: `
                <div id="${dialogId}" class="pt-2">
                    <div class="mb-3">
                        <div style="font-size:11px;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.4px;margin-bottom:6px;">
                            New Due Date
                        </div>
                        <div id="${pickerId}"></div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end mt-3">
                        <div id="${cancelId}"></div>
                        <div id="${confirmId}"></div>
                    </div>
                </div>`,
            buttons: [],
            dragEnabled: false,
            closeOnOutsideClick: false,
            showCloseButton: true,
            width: 360
        });

        dialog.show();

        window.setTimeout(function() {
            const $picker = $("#" + pickerId);
            if (!$picker.length) {
                return;
            }

            $picker.dxDateBox({
                type: "date",
                value: currentDueDate,
                min: minDate,
                displayFormat: ADMIN_DATE_DISPLAY_FORMAT,
                stylingMode: "outlined",
                width: "100%"
            });

            $("#" + cancelId).dxButton({
                text: "Cancel",
                stylingMode: "outlined",
                onClick: function() {
                    dialog.hide();
                }
            });

            $("#" + confirmId).dxButton({
                text: "Confirm",
                type: "default",
                stylingMode: "contained",
                onClick: function() {
                    const newDate = $picker.dxDateBox("instance").option("value");
                    if (!newDate) {
                        showToast("Please select a date.", "warning", 2500);
                        return;
                    }

                    if (currentStartDate && new Date(newDate) <= currentStartDate) {
                        showToast("Due date must be after start date.", "warning", 2500);
                        return;
                    }

                    dialog.hide();
                    loadPanel.option("message", "Updating...");
                    loadPanel.show();

                    $.ajax({
                        url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/extend-due-date`,
                        type: "PATCH",
                        contentType: "application/json",
                        xhrFields: { withCredentials: true },
                        data: JSON.stringify({ newDueDate: newDate }),
                        success: function() {
                            loadPanel.hide();
                            currentDueDate = newDate;
                            const formatted = window.formatAdminDate(newDate, EMPTY_TEXT);
                            const sDate = $("#lbl-schedule").data("start");
                            $("#lbl-schedule").text(`${sDate} → ${formatted}`);
                            showToast("Due date extended.", "success");
                        },
                        error: function(xhr) {
                            loadPanel.hide();
                            showToast(xhr.responseJSON?.message || "Error.", "error", 4000);
                        }
                    });
                }
            });
        }, 0);
    }

    function showApiError(msg) {
        loadPanel.hide();
        showToast(msg, "error", 4000);
    }
</script>
}