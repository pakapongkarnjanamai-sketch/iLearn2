        const courseIds = grid ? grid.getSelectedRowKeys() : [];
        if (!courseIds.length) {
            showToast("Please select at least one course.", "warning");
            return;
        }

        loadPanel.option("message", "Adding courses...");
        loadPanel.show();

        try {
            const response = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/courses`,
                method: "POST",
                contentType: "application/json",
                xhrFields: { withCredentials: true },
                data: JSON.stringify({ courseIds: courseIds })
            });

            addCoursePopup.hide();
            reloadDetail(response.message || "Courses updated.");
        } catch (error) {
            loadPanel.hide();
            showToast(window.getApiErrorMessage(error, "Error adding courses."), "error", 4000);
        }
