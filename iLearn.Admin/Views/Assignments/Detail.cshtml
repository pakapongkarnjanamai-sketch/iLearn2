@{
    ViewBag.Title = "Assignment Detail";
}

<style>
    /* ── Meta List (local) ── */
    .meta-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .meta-item:last-child { border-bottom: none; }
    .meta-label { font-size: 11px; color: var(--text-secondary); font-weight: 600;
                  text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .meta-value { font-size: 13px; color: var(--text-primary); }

    /* ✅ Deleted course banner */
    .deleted-course-banner {
        background: #fff2f0;
        border: 1px solid #ffa39e;
        border-radius: 4px;
        padding: 8px 12px;
        font-size: 12px;
        color: var(--danger-color);
        display: none;
    }
    .deleted-course-banner i { margin-right: 6px; }
</style>

<!-- ── Page Header ────────────────────────────────────────────────── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">@ViewBag.Title</div>
        <div class="text-secondary" id="lbl-assignment-no" style="font-size:12px;">Loading...</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Report", "Assignments", new { id = ViewBag.AssignmentId })"
           target="_blank" class="action-link">
            <i class="fas fa-file-alt text-secondary"></i> Export Report
        </a>
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-arrow-left text-secondary"></i> Back
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4" >
    <div id="load-panel"></div>

    <!-- ✅ Deleted Course Banner — แสดงเฉพาะเมื่อ assignment นี้มี course ที่ถูกลบ -->
    <div class="deleted-course-banner mb-3" id="deleted-course-banner">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Note:</strong>
        The following course(s) in this assignment have been deleted and are no longer available:
        <span id="deleted-course-names" class="fw-bold ms-1"></span>.
        Historical progress data is preserved for record-keeping.
    </div>

    <!-- ── Row 1: Meta / Stats / Chart ──────────────────────────── -->
    <div class="row g-3 mb-4">

        <!-- Meta Info -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Assignment Info</div>

                <div class="meta-item">
                    <div class="meta-label">Assignment No.</div>
                    <div class="meta-value fw-bold" id="lbl-assignment-no-detail">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Description</div>
                    <div class="meta-value" id="lbl-description">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Schedule</div>
                    <div class="meta-value" id="lbl-schedule">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Created By</div>
                    <div class="meta-value" id="lbl-created-by">-</div>
                </div>

                <div class="d-flex flex-column gap-2 mt-3 pt-3" style="border-top:1px solid var(--border-color);">
                    <a href="javascript:void(0);" id="btn-extend-due-date" class="action-link">
                        <i class="fas fa-calendar-plus" style="color:var(--warning-color);"></i>
                        Extend Due Date
                    </a>
                    <a href="javascript:void(0);" id="btn-delete-assignment" class="action-link danger">
                        <i class="fas fa-trash-alt" style="color:var(--danger-color);"></i>
                        Delete Assignment
                    </a>
                </div>
            </div>
        </div>

        <!-- Stat Cards -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="section-title">Summary</div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-emp">0</div>
                            <div class="stat-label">Students</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-courses">0</div>
                            <div class="stat-label">Courses</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-completed" style="color:var(--success-color);">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-inprogress" style="color:var(--warning-color);">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 text-center bg-white mt-auto flex-grow-1 d-flex flex-column justify-content-center">
                    <div class="stat-label mb-1">Overall Completion</div>
                    <div class="stat-value" id="stat-progress-text" style="color:var(--success-color); font-size: 28px;">0%</div>
                </div>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-6">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Status Distribution</div>
                <div id="status-pie-chart" style="height:220px;"></div>
            </div>
        </div>
    </div>

    <!-- ── Row 2: Course Cards + Student Grid ───────────────────── -->
    <div class="row g-3 mb-4">
        <!-- Course List -->
        <div class="col-xl-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Assigned Courses
                    <span class="float-end fw-normal text-secondary" style="font-size:11px;">
                        Click to filter
                    </span>
                </div>
                <div id="course-list" class="d-flex flex-column" style="max-height:420px; overflow-y:auto;"></div>
            </div>
        </div>

        <!-- Student DataGrid -->
        <div class="col-xl-8">
            <div class="border rounded bg-white h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title mb-0" style="border:none; padding:0;">
                        Student Tracking
                        <span class="text-secondary fw-normal ms-2" id="student-grid-subtitle"
                              style="font-size:11px; text-transform:none; letter-spacing:0;">— All</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="course-selector" style="width:220px;"></div>
                        <a href="javascript:void(0);" id="btn-export-students" class="action-link" title="Export to Excel">
                            <i class="fas fa-file-excel text-secondary"></i> Export
                        </a>
                    </div>
                </div>
                <div id="student-grid"></div>
            </div>
        </div>
    </div>

    <!-- ── Row 3: Pivot Table ────────────────────────────────────── -->
    <div class="border rounded bg-white p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center" style="margin-bottom:12px;">
            <div class="section-title mb-0" style="border:none; padding:0;">Student × Course Matrix</div>
            <a href="javascript:void(0);" id="btn-export-pivot" class="action-link" title="Export Pivot to Excel">
                <i class="fas fa-file-excel text-secondary"></i> Export
            </a>
        </div>
        <div id="pivot-container"></div>
    </div>
</div>

<div id="extend-due-date-popup"></div>

@section Scripts {
<script>
    const ASSIGNMENT_ID = @ViewBag.AssignmentId;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const ASSIGNMENT_DASHBOARD_URL = `${ASSIGNMENTS_API_URL}/dashboard/${ASSIGNMENT_ID}`;
    const ASSIGNMENT_INDEX_URL = `@Url.Action("Index", "Assignments")`;
    const STUDENT_PROFILE_URL = `@Url.Action("Profile", "Students")`;
    const EMPTY_TEXT = "—";

    let loadPanel;
    let currentDueDate = null;
    let currentStartDate = null;
    let studentsByRuleId = new Map();
    let pivotRows = [];

    $(() => {
        loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: true,
            showIndicator: true,
            showPane: false,
            shading: true,
            message: "Loading..."
        }).dxLoadPanel("instance");

        initializeDashboard();

        $("#btn-delete-assignment").click(handleDeleteAssignment);
        $("#btn-extend-due-date").click(openExtendDueDatePopup);
    });

    async function initializeDashboard() {
        try {
            const response = await $.ajax({
                url: ASSIGNMENT_DASHBOARD_URL,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            if (!response.success || !response.data) {
                showApiError("Invalid data format.");
                return;
            }

            const data = response.data;
            const firstRuleId = data.courses.length > 0 ? data.courses[0].assignmentRuleId : null;
            const dropdownOptions = data.courses.map(course => ({
                assignmentRuleId: course.assignmentRuleId,
                displayText: course.isCourseDeleted ? `${course.courseCode} [Deleted]` : `${course.courseCode}`
            }));

            initializeHeader(data);
            initializeStats(data);
            initializeStatusChart(data.chartData);
            initializeCourseList(data.courses, firstRuleId);
            initializeCourseSelector(dropdownOptions, firstRuleId);
            studentsByRuleId = groupStudentsByRuleId(data.students || []);
            pivotRows = buildPivotRows(data.students || []);
            initializeStudentGrid(getStudentsForRule(firstRuleId));

            initializeExportButtons();

            if (firstRuleId) {
                setActiveCourseFilter(firstRuleId, dropdownOptions[0]?.displayText || EMPTY_TEXT);
            }

            loadPanel.hide();

            deferPivotInitialization();
        } catch {
            showApiError("Error loading dashboard data.");
        }
    }

    function initializeHeader(data) {
        const refNo = data.assignmentNo || "-";
        const startText = formatDate(data.startDate, "-");
        const dueText = data.dueDate ? formatDate(data.dueDate, "No Limit") : "No Limit";

        currentDueDate = data.dueDate ? new Date(data.dueDate) : null;
        currentStartDate = data.startDate ? new Date(data.startDate) : null;

        $("#lbl-assignment-no").text(`Ref: ${refNo}`);
        $("#lbl-assignment-no-detail").text(refNo);
        $("#lbl-description").text(data.description || "-");
        $("#lbl-schedule").attr("data-start", startText).text(`${startText} → ${dueText}`);
        $("#lbl-created-by").text(data.createdBy || "-");

        if (!data.hasDeletedCourse) {
            return;
        }

        const deletedNames = data.courses
            .filter(course => course.isCourseDeleted)
            .map(course => course.courseTitle)
            .join(", ");
        $("#deleted-course-names").text(deletedNames);
        $("#deleted-course-banner").show();
    }

    function initializeStats(data) {
        const totalStudents = data.totalStudents ?? data.totalEmployees;
        const chartData = data.chartData || {};

        $("#stat-total-emp").text(totalStudents ?? 0);
        $("#stat-total-courses").text(data.totalCourses ?? 0);
        $("#stat-completed").text(chartData.completed ?? 0);
        $("#stat-inprogress").text(chartData.inProgress ?? 0);
        $("#stat-progress-text").text(`${data.completionRate ?? 0}%`);
    }

    function initializeStatusChart(chartData) {
        $("#status-pie-chart").dxPieChart({
            type: "doughnut",
            innerRadius: 0.7,
            palette: ["#52c41a", "#faad14", "#d9d9d9"],
            dataSource: [
                { status: "Completed", count: chartData.completed ?? 0 },
                { status: "In Progress", count: chartData.inProgress ?? 0 },
                { status: "Not Started", count: chartData.notStarted ?? 0 }
            ],
            series: [{
                argumentField: "status",
                valueField: "count",
                label: {
                    visible: true,
                    position: "outside",
                    customizeText: point => `${point.valueText} (${point.percentText})`,
                    font: { size: 11, color: "#595959" },
                    connector: { visible: true, width: 1 }
                }
            }],
            legend: {
                horizontalAlignment: "right",
                verticalAlignment: "center",
                margin: 0,
                font: { size: 12, color: "#595959" }
            },
            tooltip: { enabled: true }
        });
    }

    function initializeCourseList(courses, firstRuleId) {
        const $courseList = $("#course-list").empty();
        courses.forEach(course => {
            $(buildCourseCardHtml(course, course.assignmentRuleId === firstRuleId)).appendTo($courseList);
        });

        $courseList.find(".course-item").on("click", function() {
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            $("#course-selector").dxSelectBox("instance").option("value", ruleId);
            setActiveCourseFilter(ruleId, title);
        });
    }

    function buildCourseCardHtml(course, isActive) {
        const percent = course.totalStudents > 0 ? Math.round((course.completedStudents / course.totalStudents) * 100) : 0;
        const leftColor = course.isCourseDeleted
            ? "#ffa39e"
            : getProgressColor(percent, true);
        const deletedBadge = course.isCourseDeleted
            ? `<span class="status-pill ms-1" style="background:#fff1f0;border:1px solid #ffa39e;color:var(--danger-color);font-size:9px;"><i class="fas fa-trash-alt me-1"></i>Deleted</span>`
            : "";

        return `
            <div class="course-item ${percent === 100 ? "done" : ""} ${isActive ? "active" : ""}"
                 data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}"
                 style="border-left-color:${leftColor}; ${course.isCourseDeleted ? "opacity:0.75;" : ""}">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center flex-wrap gap-1">
                        <span class="fw-bold" style="font-size:11px; ${course.isCourseDeleted ? "text-decoration:line-through;color:var(--danger-color);" : ""}">${course.courseCode}</span>
                        <span class="text-secondary ms-1" style="font-size:11px;">${course.courseTitle}</span>
                        ${deletedBadge}
                    </div>
                    <span class="fw-bold ms-2" style="font-size:11px; color:${leftColor}; white-space:nowrap;">${percent}%</span>
                </div>
                <div class="progress-slim">
                    <div style="height:100%; width:${percent}%; background:${leftColor};"></div>
                </div>
                <div class="d-flex gap-3 mt-2" style="font-size:11px; color:var(--text-secondary);">
                    <span style="color:var(--success-color);">✓ ${course.completedStudents}</span>
                    <span style="color:var(--text-secondary);">◐ ${course.totalStudents - course.completedStudents}</span>
                    <span class="ms-auto">${course.totalStudents} students</span>
                </div>
            </div>`;
    }

    function initializeCourseSelector(options, firstRuleId) {
        $("#course-selector").dxSelectBox({
            dataSource: options,
            valueExpr: "assignmentRuleId",
            displayExpr: "displayText",
            value: firstRuleId,
            stylingMode: "underlined",
            placeholder: "Select course...",
            onValueChanged: function(e) {
                const $card = $("#course-list").find(`.course-item[data-rule="${e.value}"]`);
                setActiveCourseFilter(e.value, $card.data("title") || EMPTY_TEXT);
            }
        });
    }

    function initializeStudentGrid(students) {
        initDxGrid("#student-grid", {
            preset: "compactGrid",
            dataSource: students,
            rowAlternationEnabled: false,
            filterRow: { visible: false },
            searchPanel: { placeholder: "Search student...", width: 160 },
            export: { enabled: false },
            onExporting: function(e) {
                handleExporting(e, `Student_Tracking_${ASSIGNMENT_ID}`);
            },
            onRowPrepared: function(e) {
                if (e.rowType === "data" && e.data.isCompleted) {
                    $(e.rowElement).css("background-color", "#f6ffed");
                }
            },
            columns: [
                {
                    dataField: "studentCode",
                    caption: "ID",
                    width: 100,
                    cellTemplate: function(container, options) {
                        $("<a>")
                            .attr("href", `${STUDENT_PROFILE_URL}?code=${options.value}`)
                            .css({ fontSize: "11px", fontWeight: "600" })
                            .addClass("tag-pill pill-default")
                            .text(options.value)
                            .appendTo(container);
                    }
                },
                {
                    dataField: "studentName",
                    caption: "Name",
                    minWidth: 120,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || "-", { fontSize: "12px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "progress",
                    caption: "Progress",
                    width: 140,
                    alignment: "center",
                    cellTemplate: function(container, options) {
                        renderProgressCell(container, options.value || 0, false);
                    }
                },
                {
                    dataField: "isCompleted",
                    caption: "Status",
                    width: 110,
                    cellTemplate: function(container, options) {
                        renderStudentStatusCell(container, options.value, options.data.progress);
                    }
                },
                {
                    dataField: "completedDate",
                    caption: "Completed On",
                    dataType: "date",
                    format: "dd/MM/yyyy",
                    alignment: "center",
                    width: 110,
                    cellTemplate: function(container, options) {
                        appendText(container, formatDate(options.value), { fontSize: "11px", color: "var(--text-secondary)" });
                    }
                }
            ]
        });
    }

    function deferPivotInitialization() {
        const initialize = function() {
            initializePivotGrid(pivotRows);
        };

        if (typeof window.requestIdleCallback === "function") {
            window.requestIdleCallback(initialize, { timeout: 500 });
            return;
        }

        window.setTimeout(initialize, 0);
    }

    function initializePivotGrid(students) {
        $("#pivot-container").dxPivotGrid({
            allowSortingBySummary: true,
            allowFiltering: true,
            showBorders: true,
            showColumnTotals: false,
            showRowTotals: false,
            showRowGrandTotals: false,
            showColumnGrandTotals: false,
            height: 560,
            export: { enabled: false },
            onExporting: function(e) {
                handlePivotExporting(e, `Pivot_Matrix_${ASSIGNMENT_ID}`);
            },
            fieldChooser: { enabled: false },
            onCellPrepared: function(e) {
                if (e.area !== "data" || !e.cell.text) {
                    return;
                }

                const value = e.cell.text;
                if (value === "Completed") {
                    e.cellElement.css({ color: "var(--success-color)", fontWeight: 600, fontSize: "11px" });
                    e.cellElement.html('<i class="fas fa-check"></i>');
                    return;
                }

                if (value === "In Progress") {
                    e.cellElement.css({ color: "var(--warning-color)", fontWeight: 600, fontSize: "11px" });
                    return;
                }

                if (value === "Pending") {
                    e.cellElement.css({ color: "var(--text-secondary)", fontSize: "11px" });
                }
            },
            dataSource: {
                fields: [
                    { dataField: "studentCode", area: "row", caption: "Student ID", width: 120, sortOrder: "asc" },
                    { dataField: "studentName", area: "row", caption: "Name", width: 180 },
                    { dataField: "courseCode", area: "column", caption: "Course" },
                    {
                        dataField: "status",
                        area: "data",
                        caption: "Status",
                        summaryType: "custom",
                        calculateCustomSummary: function(options) {
                            if (options.summaryProcess === "start") {
                                options.totalValue = "-";
                            }
                            if (options.summaryProcess === "calculate") {
                                options.totalValue = options.value;
                            }
                        }
                    }
                ],
                store: students
            }
        });
    }

    function initializeExportButtons() {
        $("#btn-export-students").off("click").on("click", function() {
            const grid = $("#student-grid").dxDataGrid("instance");
            handleExporting({ component: grid, cancel: false }, `Student_Tracking_${ASSIGNMENT_ID}`);
        });

        $("#btn-export-pivot").off("click").on("click", function() {
            const pivot = $("#pivot-container").dxPivotGrid("instance");
            handlePivotExporting({ component: pivot, cancel: false }, `Pivot_Matrix_${ASSIGNMENT_ID}`);
        });
    }

    function setActiveCourseFilter(ruleId, title) {
        $("#course-list").find(".course-item").removeClass("active");
        $("#course-list").find(`.course-item[data-rule="${ruleId}"]`).addClass("active");
        $("#student-grid-subtitle").text(`— ${title}`);
        const grid = $("#student-grid").dxDataGrid("instance");
        if (!grid) {
            return;
        }

        grid.option("dataSource", getStudentsForRule(ruleId));
        grid.searchByText("");
    }

    function groupStudentsByRuleId(students) {
        const grouped = new Map();

        students.forEach(student => {
            const key = student.assignmentRuleId ?? 0;
            if (!grouped.has(key)) {
                grouped.set(key, []);
            }

            grouped.get(key).push(student);
        });

        return grouped;
    }

    function getStudentsForRule(ruleId) {
        return studentsByRuleId.get(ruleId ?? 0) || [];
    }

    function buildPivotRows(students) {
        return students.map(student => ({
            studentCode: student.studentCode,
            studentName: student.studentName || student.studentCode,
            courseCode: student.courseCode || "-",
            status: student.status
        }));
    }

    function appendText(container, text, styles) {
        return $("<span>").css(styles || {}).text(text).appendTo(container);
    }

    function formatDate(value, fallback = EMPTY_TEXT) {
        return value ? new Date(value).toLocaleDateString("en-GB") : fallback;
    }

    function getProgressColor(progress, includeZeroBorder) {
        if (progress === 100) {
            return "var(--success-color)";
        }

        if (progress > 0) {
            return "var(--accent-color)";
        }

        return includeZeroBorder ? "var(--border-color)" : "var(--border-color)";
    }

    function renderProgressCell(container, progress, useWarningForPartial) {
        const color = progress === 100
            ? "var(--success-color)"
            : progress > 0
                ? (useWarningForPartial ? "var(--warning-color)" : "var(--accent-color)")
                : "var(--border-color)";

        $("<div>").addClass("d-flex align-items-center gap-2")
            .append(
                $("<div>").css({
                    flex: "1",
                    height: "3px",
                    background: "var(--border-color)",
                    borderRadius: "2px",
                    overflow: "hidden"
                }).append(
                    $("<div>").css({
                        height: "100%",
                        width: `${progress}%`,
                        background: color
                    })
                )
            )
            .append(
                $("<span>").css({
                    fontSize: "11px",
                    fontWeight: "600",
                    minWidth: "32px",
                    color: "var(--text-secondary)"
                }).text(`${progress}%`)
            )
            .appendTo(container);
    }

    function renderStudentStatusCell(container, isCompleted, progress) {
        let dotClass = "dot-default";
        let label = "Pending";

        if (isCompleted) {
            dotClass = "dot-success";
            label = "Completed";
        } else if (progress > 0) {
            dotClass = "dot-warning";
            label = "In Progress";
        }

        $("<span>").css({ fontSize: "12px" })
            .append($("<span>").addClass(`status-dot ${dotClass}`))
            .append(label)
            .appendTo(container);
    }

    function handleDeleteAssignment(e) {
        e.preventDefault();
        DevExpress.ui.dialog.confirm(
            `<div class="py-2">
                <div class="fw-bold mb-1">Delete this assignment?</div>
                <div class="text-muted" style="font-size:12px;">
                    All related enrollments will be permanently removed.
                </div>
            </div>`,
            "Confirm Deletion"
        ).done(async function(ok) {
            if (!ok) {
                return;
            }

            loadPanel.option("message", "Deleting...");
            loadPanel.show();

            try {
                await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}`,
                    type: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                showToast("Deleted successfully.", "success", 2000);
                setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 1500);
            } catch {
                showToast("Error deleting.", "error");
                loadPanel.hide();
            }
        });
    }

    function openExtendDueDatePopup() {
        const popup = $("#extend-due-date-popup").dxPopup({
                title: "Extend Due Date",
                width: 340,
                height: "auto",
                showCloseButton: true,
                dragEnabled: false,
                contentTemplate: function (content) {
                    $("<div>").addClass("p-2").append(
                        $("<div>").addClass("mb-3").append(
                            $("<div>").css({ fontSize: "11px", fontWeight: "600", color: "var(--text-secondary)",
                                            textTransform: "uppercase", letterSpacing: "0.4px", marginBottom: "6px" })
                                       .text("New Due Date"),
                            $("<div>").attr("id", "new-due-date-picker")
                        ),
                        $("<div>").addClass("d-flex gap-2 justify-content-end mt-3").append(
                            $("<div>").attr("id", "btn-popup-cancel"),
                            $("<div>").attr("id", "btn-popup-confirm")
                        )
                    ).appendTo(content);

                    const minDate = currentStartDate
                        ? new Date(currentStartDate.getFullYear(), currentStartDate.getMonth(), currentStartDate.getDate() + 1)
                        : new Date();

                    $("#new-due-date-picker").dxDateBox({
                        type: "date", value: currentDueDate, min: minDate,
                        displayFormat: "dd/MM/yyyy", stylingMode: "outlined", width: "100%"
                    });

                    $("#btn-popup-cancel").dxButton({
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => $("#extend-due-date-popup").dxPopup("instance").hide()
                    });

                    $("#btn-popup-confirm").dxButton({
                        text: "Confirm", type: "default", stylingMode: "contained",
                        onClick: function () {
                            const newDate = $("#new-due-date-picker").dxDateBox("instance").option("value");
                            if (!newDate) { showToast("Please select a date.", "warning", 2500); return; }
                            if (currentStartDate && new Date(newDate) <= currentStartDate) {
                                showToast("Due date must be after start date.", "warning", 2500);
                                return;
                            }
                            loadPanel.option("message", "Updating..."); loadPanel.show();
                            $.ajax({
                                url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/extend-due-date`,
                                type: "PATCH",
                                contentType: "application/json",
                                xhrFields: { withCredentials: true },
                                data: JSON.stringify({ newDueDate: newDate }),
                                success: function () {
                                    $("#extend-due-date-popup").dxPopup("instance").hide();
                                    loadPanel.hide();
                                    currentDueDate = newDate;
                                    const formatted = new Date(newDate).toLocaleDateString("en-GB");
                                    const sDate = $("#lbl-schedule").data("start");
                                    $("#lbl-schedule").text(`${sDate} → ${formatted}`);
                                    showToast("Due date extended.", "success");
                                },
                                error: function (xhr) {
                                    loadPanel.hide();
                                    showToast(xhr.responseJSON?.message || "Error.", "error", 4000);
                                }
                            });
                        }
                    });
                }
            }).dxPopup("instance");
        popup.show();
    }

    function showApiError(msg) {
        loadPanel.hide();
        showToast(msg, "error", 4000);
    }
</script>
}