@{
    ViewBag.Title = "Assignment Detail";
}

<style>
    /* ── Meta List (local) ── */
    .meta-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .meta-item:last-child { border-bottom: none; }
    .meta-label { font-size: 11px; color: var(--text-secondary); font-weight: 600;
                  text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .meta-value { font-size: 13px; color: var(--text-primary); }

    /* ✅ Deleted course banner */
    .deleted-course-banner {
        background: #fff2f0;
        border: 1px solid #ffa39e;
        border-radius: 4px;
        padding: 8px 12px;
        font-size: 12px;
        color: var(--danger-color);
        display: none;
    }
    .deleted-course-banner i { margin-right: 6px; }

    #course-selector {
        display: none;
    }

    .assignment-student-panel {
        display: flex;
        flex-direction: column;
    }

    .assignment-student-toolbar {
        flex: 0 0 auto;
    }

    .assignment-student-grid-wrap {
        flex: 1 1 auto;
        min-height: 0;
    }
</style>

<!-- ── Page Header ────────────────────────────────────────────────── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">@ViewBag.Title</div>
        <div class="page-subtitle" id="lbl-assignment-no">Loading...</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-arrow-left text-secondary"></i> Back
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4" >
    <div id="load-panel"></div>

    <!-- ✅ Deleted Course Banner — แสดงเฉพาะเมื่อ assignment นี้มี course ที่ถูกลบ -->
    <div class="deleted-course-banner mb-3" id="deleted-course-banner">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Note:</strong>
        The following course(s) in this assignment have been deleted and are no longer available:
        <span id="deleted-course-names" class="fw-bold ms-1"></span>.
        Historical progress data is preserved for record-keeping.
    </div>

    <!-- ── Row 1: Meta / Stats / Chart ──────────────────────────── -->
    <div class="row g-3 mb-4">

        <!-- Meta Info -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Assignment Info</div>

                <div class="meta-item">
                    <div class="meta-label">Assignment No.</div>
                    <div class="meta-value fw-bold" id="lbl-assignment-no-detail">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Description</div>
                    <div class="meta-value" id="lbl-description">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Schedule</div>
                    <div class="meta-value" id="lbl-schedule">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Created By</div>
                    <div class="meta-value" id="lbl-created-by">-</div>
                </div>
            </div>
        </div>

        <!-- Stat Cards -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="section-title">Summary</div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-emp">0</div>
                            <div class="stat-label">Students</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-courses">0</div>
                            <div class="stat-label">Courses</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-success" id="stat-completed">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-warning" id="stat-inprogress">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 text-center bg-white mt-auto flex-grow-1 d-flex flex-column justify-content-center">
                    <div class="stat-label mb-1">Overall Completion</div>
                    <div class="stat-value u-text-success u-fs-28" id="stat-progress-text">0%</div>
                </div>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Status Distribution</div>
                <div id="status-pie-chart" style="height:220px;"></div>
            </div>
        </div>

        <!-- Actions -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btn-add-course" class="quick-action">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-plus-circle"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Add Course</div>
                            <div class="u-fs-11 text-secondary">Assign course to this plan</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-add-students" class="quick-action">
                        <div class="qa-icon qa-icon-success"><i class="fas fa-user-plus"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Add Students</div>
                            <div class="u-fs-11 text-secondary">Enroll learners to this plan</div>
                        </div>
                    </a>

                    <a href="@Url.Action("Report", "Assignments", new { id = ViewBag.AssignmentId })"
                       target="_blank" class="quick-action">
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-file-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Export Report</div>
                            <div class="u-fs-11 text-secondary">Open printable summary</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-extend-due-date" class="quick-action">
                        <div class="qa-icon qa-icon-warning"><i class="fas fa-calendar-plus"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Extend Due Date</div>
                            <div class="u-fs-11 text-secondary">Change submission deadline</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-delete-assignment" class="quick-action danger">
                        <div class="qa-icon qa-icon-danger"><i class="fas fa-trash-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Delete Assignment</div>
                            <div class="u-fs-11 text-secondary">Remove this plan permanently</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- ── Row 2: Course Cards + Student Grid ───────────────────── -->
    <div class="row g-3 mb-4">
        <!-- Course List -->
        <div class="col-xl-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title section-title-plain mb-0">Courses</div>
                </div>
                <div id="course-list" class="d-flex flex-column u-maxh-420 u-overflow-y-auto"></div>
            </div>
        </div>

        <!-- Student DataGrid -->
        <div class="col-xl-8">
            <div class="border rounded bg-white h-100 p-3 assignment-student-panel">
                <div class="d-flex justify-content-between align-items-center mb-3 assignment-student-toolbar">
                    <div class="section-title section-title-plain mb-0">
                        Students
                        <span class="text-secondary fw-normal ms-2" id="student-grid-subtitle"
                              class="u-fs-11 u-text-transform-none u-letter-spacing-0">— All</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="course-selector" class="u-w-220"></div>
                    </div>
                </div>
                <div class="assignment-student-grid-wrap">
                    <div id="student-grid"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="extend-due-date-popup"></div>
<div id="add-course-popup"></div>
<div id="add-students-popup"></div>

@section Scripts {
<script>
    const ASSIGNMENT_ID = @ViewBag.AssignmentId;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const ASSIGNMENT_DASHBOARD_URL = `${ASSIGNMENTS_API_URL}/dashboard/${ASSIGNMENT_ID}`;
    const ASSIGNMENT_INDEX_URL = `@Url.Action("Index", "Assignments")`;
    const ASSIGNMENT_LOOKUP_COURSES_URL = `${ASSIGNMENTS_API_URL}/lookup-courses`;
    const STUDENT_PROFILE_URL = `@Url.Action("Profile", "Students")`;
    const EMPTY_TEXT = "—";
    const DATE_FORMAT = "en-GB";

    let loadPanel;
    let currentDueDate = null;
    let currentStartDate = null;
    let studentsByRuleId = new Map();
    let addCoursePopup;
    let addStudentsPopup;
    let extendDueDatePopup = null;

    $(() => {
        loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: true,
            showIndicator: true,
            showPane: false,
            shading: true,
            message: "Loading..."
        }).dxLoadPanel("instance");

        initializeManagementPopups();
        initializeDashboard();

        $("#btn-delete-assignment").click(handleDeleteAssignment);
        $("#btn-extend-due-date").click(openExtendDueDatePopup);
        $("#btn-add-course").click(() => addCoursePopup.show());
        $("#btn-add-students").click(() => addStudentsPopup.show());
    });

    function initializeManagementPopups() {
        addCoursePopup = $("#add-course-popup").dxPopup({
            title: "Add Courses",
            width: "90vw",
            maxWidth: 1100,
            height: "85vh",
            showCloseButton: true,
            dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            onShown: function() {
                const g = $("#add-course-grid").dxDataGrid("instance");
                if (g) g.updateDimensions();
            },
            contentTemplate: function(contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div class="sidebar-260">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Course Type</label>
                                    <div id="add-filter-course-type"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="add-filter-course-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Category</label>
                                    <div id="add-filter-course-cat"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="add-btn-clear-course-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                            <div id="add-course-grid" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                let allCoursesData = [];

                const courseGrid = initDxGrid("#add-course-grid", {
                    preset: "selectionGrid",
                    dataSource: new DevExpress.data.DataSource({
                        store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                    }),
                    remoteOperations: false,
                    filterRow: { visible: true },
                    searchPanel: { placeholder: "Search code or title...", width: 220 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    columns: [
                        {
                            dataField: "code", caption: "Code", width: 120,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(options.value).appendTo(container);
                            }
                        },
                        { dataField: "title", caption: "Course Title", minWidth: 220 },
                        {
                            dataField: "courseTypeName", caption: "Type", width: 140, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    $("<span>").addClass("tag-pill pill-info").text(options.value).appendTo(container);
                                }
                            }
                        }
                    ]
                });

                $.ajax({
                    url: ASSIGNMENT_LOOKUP_COURSES_URL,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    allCoursesData = res.data || [];
                    courseGrid.option("dataSource", new DevExpress.data.DataSource({
                        store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                    }));
                });

                function applyAddCourseFilters() {
                    const typeVal = $("#add-filter-course-type").dxSelectBox("instance").option("value");
                    const divVal  = $("#add-filter-course-div").dxSelectBox("instance").option("value");
                    const catVal  = $("#add-filter-course-cat").dxSelectBox("instance").option("value");
                    const conditions = [];
                    if (typeVal) conditions.push(["courseTypeId", "=", typeVal]);
                    if (divVal)  conditions.push(["divisionId",   "=", divVal]);
                    if (catVal)  conditions.push(["categoryId",   "=", catVal]);
                    applyAddCombinedFilter(courseGrid, conditions);
                }

                $("#add-filter-course-type").dxSelectBox({
                    dataSource: createDataStore(serviceUrl, "admin/CourseTypesCRUD", { key: "id" }),
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Types", showClearButton: true,
                    onValueChanged: applyAddCourseFilters
                });

                $("#add-filter-course-div").dxSelectBox({
                    dataSource: createDataStore(serviceUrl, "admin/DivisionsCRUD", { key: "id" }),
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Divisions", showClearButton: true,
                    onValueChanged: function(e) {
                        const catBox = $("#add-filter-course-cat").dxSelectBox("instance");
                        catBox.option("value", null);
                        if (e.value) {
                            catBox.option("dataSource", createDataStore(serviceUrl, "admin/CategoriesCRUD", {
                                key: "id", action: "Get", filter: ["divisionId", "=", e.value]
                            }));
                            catBox.option("disabled", false);
                        } else {
                            catBox.option({ dataSource: [], disabled: true });
                        }
                        applyAddCourseFilters();
                    }
                });

                $("#add-filter-course-cat").dxSelectBox({
                    displayExpr: "name", valueExpr: "id",
                    placeholder: "All Categories", showClearButton: true,
                    disabled: true,
                    onValueChanged: applyAddCourseFilters
                });

                $("#add-btn-clear-course-filter").click(function() {
                    $("#add-filter-course-type").dxSelectBox("instance").option("value", null);
                    $("#add-filter-course-div").dxSelectBox("instance").option("value", null);
                    $("#add-filter-course-cat").dxSelectBox("instance").option({ value: null, disabled: true, dataSource: [] });
                    courseGrid.clearFilter();
                });
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Cancel",
                        stylingMode: "outlined",
                        onClick: function() { addCoursePopup.hide(); }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Add Selected",
                        type: "default",
                        stylingMode: "contained",
                        onClick: addSelectedCourses
                    }
                }
            ]
        }).dxPopup("instance");

        addStudentsPopup = $("#add-students-popup").dxPopup({
            title: "Add Students",
            width: "90vw",
            maxWidth: 1280,
            height: "85vh",
            showCloseButton: true,
            dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            onShown: function() {
                const g = $("#add-students-grid").dxDataGrid("instance");
                if (g) g.updateDimensions();
            },
            contentTemplate: function(contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div class="sidebar-240">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="add-filter-emp-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                    <div id="add-filter-emp-dept"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                    <div id="add-filter-emp-section"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Position</label>
                                    <div id="add-filter-emp-position"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="add-btn-clear-emp-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                            <div id="add-students-grid" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                const empGrid = initDxGrid("#add-students-grid", {
                    preset: "selectionGrid",
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "EId",
                        loadUrl: `${serviceUrl}/Students/Get`,
                        onBeforeSend: function(method, ajaxOptions) {
                            ajaxOptions.xhrFields = { withCredentials: true };
                        }
                    }),
                    remoteOperations: true,
                    filterRow: { visible: true },
                    searchPanel: { placeholder: "Search ID or name...", width: 220 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    columns: [
                        {
                            dataField: "EId", caption: "ID", width: 110,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(options.value).appendTo(container);
                            }
                        },
                        {
                            caption: "Name", minWidth: 180,
                            calculateCellValue: function(data) {
                                return [data.EnglishFirstName, data.EnglishLastName].filter(Boolean).join(" ");
                            },
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                            }
                        },
                        {
                            dataField: "Position", caption: "Position", width: 120, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    $("<span>").addClass("tag-pill pill-default").text(options.value).appendTo(container);
                                }
                            }
                        },
                        { dataField: "Department", caption: "Department", width: 120 },
                        {
                            dataField: "Section", caption: "Section", minWidth: 140,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("text-muted small").text(options.value || EMPTY_TEXT).appendTo(container);
                            }
                        }
                    ]
                });

                function buildAddEmpFilterQuery() {
                    const filters = [];
                    const divVal  = $("#add-filter-emp-div").dxSelectBox("instance").option("value");
                    const deptVal = $("#add-filter-emp-dept").dxSelectBox("instance").option("value");
                    const secVal  = $("#add-filter-emp-section").dxSelectBox("instance").option("value");
                    const posVals = $("#add-filter-emp-position").dxTagBox("instance").option("value") || [];

                    if (divVal)  filters.push(["Division",   "=", divVal]);
                    if (deptVal) filters.push(["Department", "=", deptVal]);
                    if (secVal)  filters.push(["Section",    "=", secVal]);
                    if (posVals.length > 0) {
                        let posFilter = ["Position", "=", posVals[0]];
                        for (let i = 1; i < posVals.length; i++) {
                            posFilter = [posFilter, "or", ["Position", "=", posVals[i]]];
                        }
                        filters.push(posFilter);
                    }
                    applyAddCombinedFilter(empGrid, filters);
                }

                function makeAddEmpLookupStore(endpoint, extraQuery) {
                    return new DevExpress.data.CustomStore({
                        key: "Name",
                        load: () => $.ajax({
                            url: `${serviceUrl}/Students/${endpoint}${extraQuery || ""}`,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        }).then(res => res.data || res)
                    });
                }

                const addEmpDivBox = $("#add-filter-emp-div").dxSelectBox({
                    dataSource: makeAddEmpLookupStore("GetDivisions", ""),
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Divisions", showClearButton: true,
                    onValueChanged: function(e) {
                        const deptBox    = $("#add-filter-emp-dept").dxSelectBox("instance");
                        const sectionBox = $("#add-filter-emp-section").dxSelectBox("instance");
                        deptBox.option({ value: null, disabled: !e.value, dataSource: e.value
                            ? makeAddEmpLookupStore("GetDepartments", `?filter=["Division","=","${e.value}"]`)
                            : [] });
                        sectionBox.option({ value: null, disabled: true, dataSource: [] });
                        buildAddEmpFilterQuery();
                    }
                }).dxSelectBox("instance");

                const addEmpDeptBox = $("#add-filter-emp-dept").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Departments", showClearButton: true, disabled: true,
                    onValueChanged: function(e) {
                        const sectionBox = $("#add-filter-emp-section").dxSelectBox("instance");
                        const divVal = addEmpDivBox.option("value");
                        const q = e.value
                            ? `?filter=[["Division","=","${divVal}"],"and",["Department","=","${e.value}"]]`
                            : (divVal ? `?filter=["Division","=","${divVal}"]` : "");
                        sectionBox.option({ value: null, disabled: !e.value, dataSource: e.value
                            ? makeAddEmpLookupStore("GetSections", q)
                            : [] });
                        buildAddEmpFilterQuery();
                    }
                }).dxSelectBox("instance");

                $("#add-filter-emp-section").dxSelectBox({
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Sections", showClearButton: true, disabled: true,
                    onValueChanged: buildAddEmpFilterQuery
                });

                $("#add-filter-emp-position").dxTagBox({
                    dataSource: makeAddEmpLookupStore("GetPositions", ""),
                    displayExpr: "Name", valueExpr: "Name",
                    placeholder: "All Positions",
                    showClearButton: true,
                    showSelectionControls: true,
                    applyValueMode: "useButtons",
                    onValueChanged: buildAddEmpFilterQuery
                });

                $("#add-btn-clear-emp-filter").click(function() {
                    addEmpDivBox.option("value", null);
                    addEmpDeptBox.option({ value: null, disabled: true, dataSource: [] });
                    $("#add-filter-emp-section").dxSelectBox("instance").option({ value: null, disabled: true, dataSource: [] });
                    $("#add-filter-emp-position").dxTagBox("instance").option("value", []);
                    empGrid.clearFilter();
                });
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Cancel",
                        stylingMode: "outlined",
                        onClick: function() { addStudentsPopup.hide(); }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Add Selected",
                        type: "default",
                        stylingMode: "contained",
                        onClick: addSelectedStudents
                    }
                }
            ]
        }).dxPopup("instance");
    }

    function applyAddCombinedFilter(grid, conditions) {
        if (conditions.length === 0) {
            grid.clearFilter();
            return;
        }
        let combined = conditions[0];
        for (let i = 1; i < conditions.length; i++) {
            combined = [combined, "and", conditions[i]];
        }
        grid.filter(combined);
    }

    async function initializeDashboard() {
        try {
            const response = await $.ajax({
                url: ASSIGNMENT_DASHBOARD_URL,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            if (!response.success || !response.data) {
                showApiError("Invalid data format.");
                return;
            }


            const data = response.data;
            const courses = Array.isArray(data.courses) ? data.courses : [];
            const students = Array.isArray(data.students) ? data.students : [];
            const firstRuleId = courses.length > 0 ? courses[0].assignmentRuleId : null;
            const dropdownOptions = courses.map(course => ({
                assignmentRuleId: course.assignmentRuleId,
                displayText: course.isCourseDeleted ? `${course.courseCode} [Deleted]` : `${course.courseCode}`
            }));

            initializeHeader(data);
            initializeStats(data);
            initializeStatusChart(data.chartData);
            initializeCourseList(courses, firstRuleId);
            initializeCourseSelector(dropdownOptions, firstRuleId);
            studentsByRuleId = groupStudentsByRuleId(students);
            initializeStudentGrid(getStudentsForRule(firstRuleId));

            if (firstRuleId) {
                setActiveCourseFilter(firstRuleId, dropdownOptions[0]?.displayText || EMPTY_TEXT);
            }

            loadPanel.hide();
        } catch (error) {
            if (error?.status === 404) {
                showToast("Assignment no longer exists. Redirecting...", "info", 2000);
                window.setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 1500);
                return;
            }
            showApiError("Error loading dashboard data.");
        }
    }

    function initializeHeader(data) {
        const refNo = data.assignmentNo || EMPTY_TEXT;
        const startText = formatDate(data.startDate, EMPTY_TEXT);
        const dueText = data.dueDate ? formatDate(data.dueDate, "No Limit") : "No Limit";
        const courses = Array.isArray(data.courses) ? data.courses : [];

        currentDueDate = data.dueDate ? new Date(data.dueDate) : null;
        currentStartDate = data.startDate ? new Date(data.startDate) : null;

        $("#lbl-assignment-no").text(`Ref: ${refNo}`);
        $("#lbl-assignment-no-detail").text(refNo);
        $("#lbl-description").text(data.description || "-");
        $("#lbl-schedule").attr("data-start", startText).text(`${startText} → ${dueText}`);
        $("#lbl-created-by").text(data.createdBy || "-");

        if (!data.hasDeletedCourse) {
            return;
        }

        const deletedNames = courses
            .filter(course => course.isCourseDeleted)
            .map(course => course.courseTitle)
            .join(", ");
        $("#deleted-course-names").text(deletedNames);
        $("#deleted-course-banner").show();
    }

    function initializeStats(data) {
        const totalStudents = data.totalStudents ?? data.totalEmployees;
        const chartData = data.chartData || {};

        $("#stat-total-emp").text(totalStudents ?? 0);
        $("#stat-total-courses").text(data.totalCourses ?? 0);
        $("#stat-completed").text(chartData.completed ?? 0);
        $("#stat-inprogress").text(chartData.inProgress ?? 0);
        $("#stat-progress-text").text(`${data.completionRate ?? 0}%`);
    }

    function initializeStatusChart(chartData) {
        $("#status-pie-chart").dxPieChart({
            type: "doughnut",
            innerRadius: 0.7,
            palette: ["#52c41a", "#faad14", "#d9d9d9"],
            dataSource: [
                { status: "Completed", count: chartData.completed ?? 0 },
                { status: "In Progress", count: chartData.inProgress ?? 0 },
                { status: "Not Started", count: chartData.notStarted ?? 0 }
            ],
            series: [{
                argumentField: "status",
                valueField: "count",
                label: {
                    visible: true,
                    position: "outside",
                    customizeText: point => `${point.valueText} (${point.percentText})`,
                    font: { size: 11, color: "#595959" },
                    connector: { visible: true, width: 1 }
                }
            }],
            legend: {
                horizontalAlignment: "right",
                verticalAlignment: "center",
                margin: 0,
                font: { size: 12, color: "#595959" }
            },
            tooltip: { enabled: true }
        });
    }

    function initializeCourseList(courses, firstRuleId) {
        const $courseList = $("#course-list").empty();
        courses.forEach(course => {
            $(buildCourseCardHtml(course, course.assignmentRuleId === firstRuleId)).appendTo($courseList);
        });

        $courseList.find(".course-item").on("click", function() {
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            $("#course-selector").dxSelectBox("instance").option("value", ruleId);
            setActiveCourseFilter(ruleId, title);
        });

        $courseList.find(".btn-remove-course").on("click", function(e) {
            e.preventDefault();
            e.stopPropagation();
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            confirmRemoveCourse(ruleId, title);
        });
    }

    function buildCourseCardHtml(course, isActive) {
        const percent = getCourseCompletionPercent(course);
        const remaining = course.totalStudents - course.completedStudents;
        const leftColor = course.isCourseDeleted
            ? "#ffa39e"
            : getProgressColor(percent);
        const deletedBadge = course.isCourseDeleted
            ? `<span class="tag-pill tag-pill-xs pill-danger ms-1"><i class="fas fa-ban me-1"></i>Deleted</span>`
            : "";

        return `
            <div class="course-item ${percent === 100 ? "done" : ""} ${isActive ? "active" : ""} ${course.isCourseDeleted ? "opacity-75" : ""}"
                 data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}"
                 style="border-left-color:${leftColor};">

                <!-- Row 1: Code badge + remove button -->
                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <div class="d-flex align-items-center gap-1">
                        <span class="course-item-code ${course.isCourseDeleted ? "course-item-code--deleted" : ""}">${course.courseCode}</span>
                        ${deletedBadge}
                    </div>
                    <a href="javascript:void(0);" class="course-item-remove btn-remove-course"
                       data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}">
                        <i class="fas fa-times"></i>
                    </a>
                </div>

                <!-- Row 2: Course title -->
                <div class="course-item-title ${course.isCourseDeleted ? "course-item-title--deleted" : ""} mb-2">${course.courseTitle}</div>

                <!-- Row 3: Progress bar + percent -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="progress-slim flex-grow-1">
                        <div style="height:100%; width:${percent}%; background:${leftColor};"></div>
                    </div>
                    <span class="course-item-pct" style="color:${leftColor};">${percent}%</span>
                </div>

                <!-- Row 4: Stats -->
                <div class="d-flex gap-3 u-fs-11">
                    <span class="u-text-success"><i class="fas fa-check me-1"></i>${course.completedStudents} done</span>
                    <span class="text-secondary">${remaining} left</span>
                </div>

            </div>`;
    }

    function initializeCourseSelector(options, firstRuleId) {
        $("#course-selector").dxSelectBox({
            dataSource: options,
            valueExpr: "assignmentRuleId",
            displayExpr: "displayText",
            value: firstRuleId,
            stylingMode: "underlined",
            placeholder: "Select course...",
            onValueChanged: function(e) {
                const $card = $("#course-list").find(`.course-item[data-rule="${e.value}"]`);
                setActiveCourseFilter(e.value, $card.data("title") || EMPTY_TEXT);
            }
        });
    }

    function initializeStudentGrid(students) {
        initDxGrid("#student-grid", {
            preset: "compactGrid",
            minVisibleRows: 8,
            dataSource: students,
            rowAlternationEnabled: false,
            filterRow: { visible: false },
            searchPanel: { placeholder: "Search student...", width: 160 },
            export: { enabled: false },
            onExporting: function(e) {
                handleExporting(e, `Student_Tracking_${ASSIGNMENT_ID}`);
            },
            onRowPrepared: function(e) {
                if (e.rowType === "data" && e.data.isCompleted) {
                    $(e.rowElement).css("background-color", "#f6ffed");
                }
            },
            columns: [
                {
                    dataField: "studentCode",
                    caption: "ID",
                    width: 100,
                    cellTemplate: function(container, options) {
                        $("<a>")
                            .attr("href", `${STUDENT_PROFILE_URL}?code=${options.value}`)
                            .css({ fontSize: "11px", fontWeight: "600" })
                            .addClass("tag-pill pill-default")
                            .text(options.value)
                            .appendTo(container);
                    }
                },
                {
                    dataField: "studentName",
                    caption: "Name",
                    minWidth: 120,
                    cellTemplate: function(container, options) {
                        appendText(container, options.value || EMPTY_TEXT, { fontSize: "12px", color: "var(--text-secondary)" });
                    }
                },
                {
                    dataField: "progress",
                    caption: "Progress",
                    width: 140,
                    alignment: "center",
                    cellTemplate: function(container, options) {
                        renderProgressCell(container, options.value || 0, false);
                    }
                },
                {
                    dataField: "isCompleted",
                    caption: "Status",
                    width: 110,
                    cellTemplate: function(container, options) {
                        renderStudentStatusCell(container, options.value, options.data.progress);
                    }
                },
                {
                    dataField: "completedDate",
                    caption: "Completed On",
                    dataType: "date",
                    format: "dd/MM/yyyy",
                    alignment: "center",
                    width: 110,
                    cellTemplate: function(container, options) {
                        appendText(container, formatDate(options.value), { fontSize: "11px", color: "var(--text-secondary)" });
                    }
                },
                {
                    caption: "",
                    width: 84,
                    alignment: "center",
                    allowFiltering: false,
                    allowSorting: false,
                    cellTemplate: function(container, options) {
                        $("<a>")
                            .attr("href", "javascript:void(0);")
                            .addClass("action-link action-link-xs")
                            .html('<i class="fas fa-user-minus u-text-danger"></i>')
                            .on("click", function(e) {
                                e.preventDefault();
                                confirmRemoveStudent(options.data.studentCode, options.data.studentName || options.data.studentCode);
                            })
                            .appendTo(container);
                    }
                }
            ]
        });
    }

    async function addSelectedCourses() {
        const grid = $("#add-course-grid").dxDataGrid("instance");
        const courseIds = grid ? grid.getSelectedRowKeys() : [];
        if (!courseIds.length) {
            showToast("Please select at least one course.", "warning");
            return;
        }

        loadPanel.option("message", "Adding courses...");
        loadPanel.show();

        try {
            const response = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/courses`,
                method: "POST",
                contentType: "application/json",
                xhrFields: { withCredentials: true },
                data: JSON.stringify({ courseIds: courseIds })
            });

            addCoursePopup.hide();
            reloadDetail(response.message || "Courses updated.");
        } catch (error) {
            loadPanel.hide();
            showToast(getApiErrorMessage(error, "Error adding courses."), "error", 4000);
        }
    }

    async function addSelectedStudents() {
        const grid = $("#add-students-grid").dxDataGrid("instance");
        const studentCodes = grid ? grid.getSelectedRowKeys() : [];
        if (!studentCodes.length) {
            showToast("Please select at least one student.", "warning");
            return;
        }

        loadPanel.option("message", "Adding students...");
        loadPanel.show();

        try {
            const response = await $.ajax({
                url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/students`,
                method: "POST",
                contentType: "application/json",
                xhrFields: { withCredentials: true },
                data: JSON.stringify({ employeeCodes: studentCodes })
            });

            addStudentsPopup.hide();
            reloadDetail(response.message || "Students updated.");
        } catch (error) {
            loadPanel.hide();
            showToast(getApiErrorMessage(error, "Error adding students."), "error", 4000);
        }
    }

    function setActiveCourseFilter(ruleId, title) {
        $("#course-list").find(".course-item").removeClass("active");
        $("#course-list").find(`.course-item[data-rule="${ruleId}"]`).addClass("active");
        $("#student-grid-subtitle").text(`— ${title}`);
        const grid = $("#student-grid").dxDataGrid("instance");
        if (!grid) {
            return;
        }

        grid.option("dataSource", getStudentsForRule(ruleId));
        grid.searchByText("");
    }

    function groupStudentsByRuleId(students) {
        const grouped = new Map();

        students.forEach(student => {
            const key = student.assignmentRuleId ?? 0;
            if (!grouped.has(key)) {
                grouped.set(key, []);
            }

            grouped.get(key).push(student);
        });

        return grouped;
    }

    function getStudentsForRule(ruleId) {
        return studentsByRuleId.get(ruleId ?? 0) || [];
    }

    function getCourseCompletionPercent(course) {
        return course.totalStudents > 0
            ? Math.round((course.completedStudents / course.totalStudents) * 100)
            : 0;
    }

    function appendText(container, text, styles) {
        return $("<span>").css(styles || {}).text(text).appendTo(container);
    }

    function formatDate(value, fallback = EMPTY_TEXT) {
        return value ? new Date(value).toLocaleDateString(DATE_FORMAT) : fallback;
    }

    function getApiErrorMessage(error, fallbackMessage) {
        return error?.responseJSON?.message || error?.statusText || fallbackMessage;
    }

    function reloadDetail(message) {
        showToast(message, "success");
        window.setTimeout(() => window.location.reload(), 600);
    }

    function showConfirmDialog(options) {
        if (window.SwalAdmin && typeof window.SwalAdmin.fire === "function") {
            return window.SwalAdmin.fire(options);
        }

        if (window.Swal && typeof window.Swal.fire === "function") {
            return window.Swal.fire(options);
        }

        const deferred = $.Deferred();
        DevExpress.ui.dialog.confirm(options.html || options.text || "Please confirm this action.", options.title || "Confirm")
            .done(function(confirmed) {
                deferred.resolve({ isConfirmed: confirmed });
            });

        return deferred.promise();
    }

    function getProgressColor(progress) {
        if (progress === 100) {
            return "var(--success-color)";
        }

        if (progress > 0) {
            return "var(--accent-color)";
        }

        return "var(--border-color)";
    }

    function renderProgressCell(container, progress, useWarningForPartial) {
        const color = progress === 100
            ? "var(--success-color)"
            : progress > 0
                ? (useWarningForPartial ? "var(--warning-color)" : "var(--accent-color)")
                : "var(--border-color)";

        $("<div>").addClass("d-flex align-items-center gap-2")
            .append(
                $("<div>").css({
                    flex: "1",
                    height: "3px",
                    background: "var(--border-color)",
                    borderRadius: "2px",
                    overflow: "hidden"
                }).append(
                    $("<div>").css({
                        height: "100%",
                        width: `${progress}%`,
                        background: color
                    })
                )
            )
            .append(
                $("<span>").css({
                    fontSize: "11px",
                    fontWeight: "600",
                    minWidth: "32px",
                    color: "var(--text-secondary)"
                }).text(`${progress}%`)
            )
            .appendTo(container);
    }

    function renderStudentStatusCell(container, isCompleted, progress) {
        let dotClass = "dot-default";
        let label = "Pending";

        if (isCompleted) {
            dotClass = "dot-success";
            label = "Completed";
        } else if (progress > 0) {
            dotClass = "dot-warning";
            label = "In Progress";
        }

        $("<span>").css({ fontSize: "12px" })
            .append($("<span>").addClass(`status-dot ${dotClass}`))
            .append(label)
            .appendTo(container);
    }

    function confirmRemoveCourse(ruleId, title) {
        showConfirmDialog({
            title: "Remove assigned course?",
            html: `Course <b>${escapeHtml(title || EMPTY_TEXT)}</b> will be removed from this assignment.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Remove",
            cancelButtonText: "Cancel"
        }).then(async function(result) {
            if (!result.isConfirmed) {
                return;
            }

            loadPanel.option("message", "Removing course...");
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/courses/${ruleId}`,
                    method: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                if (response.assignmentDeleted) {
                    showToast(response.message || "Assignment removed.", "success");
                    window.setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 600);
                    return;
                }

                reloadDetail(response.message || "Course removed.");
            } catch (error) {
                loadPanel.hide();
                showToast(getApiErrorMessage(error, "Error removing course."), "error", 4000);
            }
        });
    }

    function confirmRemoveStudent(studentCode, studentName) {
        showConfirmDialog({
            title: "Remove student from assignment?",
            html: `<b>${escapeHtml(studentCode || EMPTY_TEXT)}</b> ${escapeHtml(studentName || EMPTY_TEXT)} will be removed from all assigned courses in this assignment.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Remove",
            cancelButtonText: "Cancel"
        }).then(async function(result) {
            if (!result.isConfirmed) {
                return;
            }

            loadPanel.option("message", "Removing student...");
            loadPanel.show();

            try {
                const response = await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/students/${encodeURIComponent(studentCode)}`,
                    method: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                reloadDetail(response.message || "Student removed.");
            } catch (error) {
                loadPanel.hide();
                showToast(getApiErrorMessage(error, "Error removing student."), "error", 4000);
            }
        });
    }

    function escapeHtml(value) {
        return $("<div>").text(value || "").html();
    }

    function handleDeleteAssignment(e) {
        e.preventDefault();
        DevExpress.ui.dialog.confirm(
            `<div class="py-2">
                <div class="fw-bold mb-1">Delete this assignment?</div>
                <div class="text-muted dialog-body-sm">
                    All related enrollments will be permanently removed.
                </div>
            </div>`,
            "Confirm Deletion"
        ).done(async function(ok) {
            if (!ok) {
                return;
            }

            loadPanel.option("message", "Deleting...");
            loadPanel.show();

            try {
                await $.ajax({
                    url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}`,
                    type: "DELETE",
                    xhrFields: { withCredentials: true }
                });

                showToast("Deleted successfully.", "success", 2000);
                setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 1500);
            } catch {
                showToast("Error deleting.", "error");
                loadPanel.hide();
            }
        });
    }

    function openExtendDueDatePopup() {
        if (!extendDueDatePopup) {
            extendDueDatePopup = $("#extend-due-date-popup").dxPopup({
                title: "Extend Due Date",
                width: 340,
                height: "auto",
                showCloseButton: true,
                dragEnabled: false,
                deferRendering: false,
                onShowing: function() {
                    const picker = $("#new-due-date-picker").dxDateBox("instance");
                    if (picker) {
                        const minDate = currentStartDate
                            ? new Date(currentStartDate.getFullYear(), currentStartDate.getMonth(), currentStartDate.getDate() + 1)
                            : new Date();
                        picker.option({ value: currentDueDate, min: minDate });
                    }
                },
                contentTemplate: function (content) {
                    $("<div>").addClass("p-2").append(
                        $("<div>").addClass("mb-3").append(
                            $("<div>").css({ fontSize: "11px", fontWeight: "600", color: "var(--text-secondary)",
                                            textTransform: "uppercase", letterSpacing: "0.4px", marginBottom: "6px" })
                                       .text("New Due Date"),
                            $("<div>").attr("id", "new-due-date-picker")
                        ),
                        $("<div>").addClass("d-flex gap-2 justify-content-end mt-3").append(
                            $("<div>").attr("id", "btn-popup-cancel"),
                            $("<div>").attr("id", "btn-popup-confirm")
                        )
                    ).appendTo(content);

                    const minDate = currentStartDate
                        ? new Date(currentStartDate.getFullYear(), currentStartDate.getMonth(), currentStartDate.getDate() + 1)
                        : new Date();

                    $("#new-due-date-picker").dxDateBox({
                        type: "date", value: currentDueDate, min: minDate,
                        displayFormat: "dd/MM/yyyy", stylingMode: "outlined", width: "100%"
                    });

                    $("#btn-popup-cancel").dxButton({
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => extendDueDatePopup.hide()
                    });

                    $("#btn-popup-confirm").dxButton({
                        text: "Confirm", type: "default", stylingMode: "contained",
                        onClick: function () {
                            const newDate = $("#new-due-date-picker").dxDateBox("instance").option("value");
                            if (!newDate) { showToast("Please select a date.", "warning", 2500); return; }
                            if (currentStartDate && new Date(newDate) <= currentStartDate) {
                                showToast("Due date must be after start date.", "warning", 2500);
                                return;
                            }
                            loadPanel.option("message", "Updating..."); loadPanel.show();
                            $.ajax({
                                url: `${ASSIGNMENTS_API_URL}/${ASSIGNMENT_ID}/extend-due-date`,
                                type: "PATCH",
                                contentType: "application/json",
                                xhrFields: { withCredentials: true },
                                data: JSON.stringify({ newDueDate: newDate }),
                                success: function () {
                                    extendDueDatePopup.hide();
                                    loadPanel.hide();
                                    currentDueDate = newDate;
                                    const formatted = new Date(newDate).toLocaleDateString(DATE_FORMAT);
                                    const sDate = $("#lbl-schedule").data("start");
                                    $("#lbl-schedule").text(`${sDate} → ${formatted}`);
                                    showToast("Due date extended.", "success");
                                },
                                error: function (xhr) {
                                    loadPanel.hide();
                                    showToast(xhr.responseJSON?.message || "Error.", "error", 4000);
                                }
                            });
                        }
                    });
                }
            }).dxPopup("instance");
        }
        extendDueDatePopup.show();
    }

    function showApiError(msg) {
        loadPanel.hide();
        showToast(msg, "error", 4000);
    }
</script>
}