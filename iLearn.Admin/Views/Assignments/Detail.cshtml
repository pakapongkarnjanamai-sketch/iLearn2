    async function addSelectedStudents() {
        const grid = $("#add-students-grid").dxDataGrid("instance");
        const studentCodes = grid ? grid.getSelectedRowKeys() : [];
        if (!studentCodes.length) {
            showToast("Please select at least one student.", "warning");
            return;
