@{
    ViewBag.Title = "Assignment Detail";
    var reportByNoUrlTemplate = Url.Content("~/Assignments/Report/__ASSIGNMENT_NO__");
    var reportByIdUrl = Url.Content($"~/Assignments/Report/{ViewBag.AssignmentId}");
    var studentReportUrlTemplate = Url.Content("~/Students/Report/__STUDENT_CODE__");
}

<style>
    /* ── Meta List (local) ── */
    .meta-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .meta-item:last-child { border-bottom: none; }
    .meta-label { font-size: 11px; color: var(--text-secondary); font-weight: 600;
                  text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .meta-value { font-size: 13px; color: var(--text-primary); }

    /* ✅ Deleted course banner */
    .deleted-course-banner {
        background: var(--surface-danger-subtle);
        border: 1px solid var(--border-danger);
        border-radius: var(--radius-sm);
        padding: 8px 12px;
        font-size: 12px;
        color: var(--danger-color);
        display: none;
    }
    .deleted-course-banner i { margin-right: 6px; }

    #course-selector {
        display: none;
    }

    .assignment-panel-title {
        flex: 1 1 auto;
        min-width: 0;
    }
</style>

<!-- ── Page Header ────────────────────────────────────────────────── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">@ViewBag.Title</h1>
        <div class="page-subtitle" id="lbl-assignment-no">Loading...</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-arrow-left text-secondary" aria-hidden="true"></i> Back
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4" >
    <div id="load-panel"></div>

    <!-- ✅ Deleted Course Banner — แสดงเฉพาะเมื่อ assignment นี้มี course ที่ถูกลบ -->
    <div class="deleted-course-banner mb-3" id="deleted-course-banner">
        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
        <strong>Note:</strong>
        The following course(s) in this assignment have been deleted and are no longer available:
        <span id="deleted-course-names" class="fw-bold ms-1"></span>.
        Historical progress data is preserved for record-keeping.
    </div>

    <!-- ── Row 1: Meta / Stats / Chart ──────────────────────────── -->
    <div class="row g-3 mb-4">

        <!-- Meta Info -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Info</div>

                <div class="meta-item">
                    <div class="meta-label">Assignment No.</div>
                    <div class="meta-value fw-bold" id="lbl-assignment-no-detail">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Description</div>
                    <div class="meta-value" id="lbl-description">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Schedule</div>
                    <div class="meta-value" id="lbl-schedule">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Created By</div>
                    <div class="meta-value" id="lbl-created-by">-</div>
                </div>
                <div class="meta-item" id="meta-student-group" style="display:none;">
                    <div class="meta-label">Student Group</div>
                    <div class="meta-value" id="lbl-student-group">-</div>
                </div>
            </div>
        </div>

        <!-- Summary + Status Distribution -->
        <div class="col-lg-6">
            <div class="border rounded bg-white h-100 p-3 d-flex flex-column">
                <div class="section-title">Summary</div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-emp">0</div>
                            <div class="stat-label">Students</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-courses">0</div>
                            <div class="stat-label">Courses</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-success" id="stat-completed">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value u-text-warning" id="stat-inprogress">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-stretch justify-content-center flex-grow-1 px-3 pt-3 pb-3" style="min-height:240px;">
                    <div id="status-pie-chart" style="width:100%;height:100%;min-height:240px;"></div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Actions</div>
                <div class="d-flex flex-column gap-2">

                    <a href="javascript:void(0);" id="btn-add-course" class="quick-action">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-plus-circle"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Add Course</div>
                            <div class="u-fs-11 text-secondary">Assign course to this plan</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-add-students" class="quick-action">
                        <div class="qa-icon qa-icon-success"><i class="fas fa-user-plus"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Add Students</div>
                            <div class="u-fs-11 text-secondary">Enroll learners to this plan</div>
                        </div>
                    </a>

                          <a href="@reportByIdUrl"
                       id="btn-report-link" target="_blank" class="quick-action">
                        <div class="qa-icon qa-icon-muted"><i class="fas fa-file-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Report</div>
                            <div class="u-fs-11 text-secondary">Open printable summary</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-reassignment" class="quick-action">
                        <div class="qa-icon qa-icon-accent"><i class="fas fa-redo-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Reassignment</div>
                            <div class="u-fs-11 text-secondary">Create new assignment from this data</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-extend-due-date" class="quick-action">
                        <div class="qa-icon qa-icon-warning"><i class="fas fa-calendar-plus"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Extend Due Date</div>
                            <div class="u-fs-11 text-secondary">Change submission deadline</div>
                        </div>
                    </a>

                    <a href="javascript:void(0);" id="btn-delete-assignment" class="quick-action danger">
                        <div class="qa-icon qa-icon-danger"><i class="fas fa-trash-alt"></i></div>
                        <div>
                            <div class="u-fs-12 u-fw-semibold">Delete Assignment</div>
                            <div class="u-fs-11 text-secondary">Remove this plan permanently</div>
                        </div>
                    </a>

                </div>
            </div>
        </div>
    </div>

    <!-- ── Row 2: Course Cards + Student Grid ───────────────────── -->
    <div class="row g-3">
        <!-- Course List -->
        <div class="col-xl-4">
            <div class="border rounded bg-white d-flex flex-column">
                <div class="p-3 d-flex justify-content-between align-items-center">
                    <div class="section-title mb-0 assignment-panel-title">Courses</div>
                </div>
                <div class="px-3 pb-3">
                    <div id="course-list" class="d-flex flex-column"></div>
                </div>
            </div>
        </div>

        <!-- Student DataGrid -->
        <div class="col-xl-8">
            <div class="border rounded bg-white">
                <div class="p-3 d-flex justify-content-between align-items-center">
                    <div class="section-title mb-0 assignment-panel-title">
                        Students
                        <span class="text-secondary fw-normal ms-2" id="student-grid-subtitle"
                              class="u-fs-11 u-text-transform-none u-letter-spacing-0">— All</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="course-selector" class="u-w-220"></div>
                    </div>
                </div>
                <div class="px-3 pb-3">
                    <div id="student-grid"></div>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="add-course-popup"></div>
<div id="add-students-popup"></div>

@section Scripts {
<script>
    const ASSIGNMENT_ID = @ViewBag.AssignmentId;
    const ASSIGNMENTS_API_URL = `${serviceUrl}/Assignments`;
    const ASSIGNMENT_DASHBOARD_URL = `${ASSIGNMENTS_API_URL}/dashboard/${ASSIGNMENT_ID}`;
    const ASSIGNMENT_INDEX_URL = `@Url.Action("Index", "Assignments")`;
    const ASSIGNMENT_REPORT_BY_NO_URL_TEMPLATE = '@reportByNoUrlTemplate';
    const ASSIGNMENT_LOOKUP_COURSES_URL = `${ASSIGNMENTS_API_URL}/lookup-courses`;
    const ASSIGNMENT_VALIDATE_URL = `${ASSIGNMENTS_API_URL}/validate-before-assign`;
    const BULK_ASSIGN_URL = `${serviceUrl}/Enrollments/BulkAssign`;
    const STUDENT_REPORT_URL_TEMPLATE = '@studentReportUrlTemplate';
    const EMPTY_TEXT = "—";

    let loadPanel;
    let currentDueDate = null;
    let currentStartDate = null;
    let studentsByRuleId = new Map();
    let addCoursePopup;
    let addStudentsPopup;
    let dashboardData = null;

    $(() => {
        loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: true,
            showIndicator: true,
            showPane: false,
            shading: true,
            message: "Loading..."
        }).dxLoadPanel("instance");

        initializeManagementPopups();
        initializeDashboard();

        $("#btn-delete-assignment").click(handleDeleteAssignment);
        $("#btn-extend-due-date").click(openExtendDueDatePopup);
        $("#btn-add-course").click(() => addCoursePopup.show());
        $("#btn-add-students").click(() => addStudentsPopup.show());
        $("#btn-reassignment").click(handleReassignment);
    });

    function initializeManagementPopups() {
        addCoursePopup = $("#add-course-popup").dxPopup({
            title: "Add Courses",
            width: "90vw",
            maxWidth: 1100,
            height: "85vh",
            showCloseButton: true,
            dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            onShown: function() {
                const g = $("#add-course-grid").dxDataGrid("instance");
                if (g) g.updateDimensions();
            },
            contentTemplate: function(contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div class="sidebar-260">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Course Type</label>
                                    <div id="add-filter-course-type"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="add-filter-course-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Category</label>
                                    <div id="add-filter-course-cat"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="add-btn-clear-course-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                            <div id="add-course-grid" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                let allCoursesData = [];

                const courseGrid = initDxGrid("#add-course-grid", {
                    preset: "selectionGrid",
                    dataSource: new DevExpress.data.DataSource({
                        store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                    }),
                    remoteOperations: false,
                    filterRow: { visible: true },
                    searchPanel: { placeholder: "Search code or title...", width: 220 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    columns: [
                        {
                            dataField: "code", caption: "Code", width: 120,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(options.value).appendTo(container);
                            }
                        },
                        { dataField: "title", caption: "Course Title", minWidth: 220 },
                        {
                            dataField: "courseTypeName", caption: "Type", width: 140, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    $("<span>").addClass("tag-pill pill-info").text(options.value).appendTo(container);
                                }
                            }
                        }
                    ]
                });

                $.ajax({
                    url: ASSIGNMENT_LOOKUP_COURSES_URL,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    allCoursesData = res.data || [];
                    courseGrid.option("dataSource", new DevExpress.data.DataSource({
                        store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                    }));
                });

                initAdminCourseFilters({
                    serviceUrl: serviceUrl,
                    gridInstance: courseGrid,
                    typeSel: "#add-filter-course-type",
                    divSel: "#add-filter-course-div",
                    catSel: "#add-filter-course-cat",
                    clearSel: "#add-btn-clear-course-filter"
                });
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Cancel",
                        stylingMode: "outlined",
                        onClick: function() { addCoursePopup.hide(); }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Add Selected",
                        type: "default",
                        stylingMode: "contained",
                        onClick: addSelectedCourses
                    }
                }
            ]
        }).dxPopup("instance");

        addStudentsPopup = $("#add-students-popup").dxPopup({
            title: "Add Students",
            width: "90vw",
            maxWidth: 1280,
            height: "85vh",
            showCloseButton: true,
            dragEnabled: true,
            deferRendering: false,
            wrapperAttr: { class: "shadow-lg rounded-4" },
            onShown: function() {
                const g = $("#add-students-grid").dxDataGrid("instance");
                if (g) g.updateDimensions();
            },
            contentTemplate: function(contentElement) {
                $(`
                    <div class="d-flex h-100 gap-3">
                        <div class="sidebar-240">
                            <div class="filter-panel h-100 d-flex flex-column gap-3">
                                <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                    <div id="add-filter-emp-div"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                    <div id="add-filter-emp-dept"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                    <div id="add-filter-emp-section"></div>
                                </div>
                                <div>
                                    <label class="small fw-bold text-muted mb-1 d-block">Position</label>
                                    <div id="add-filter-emp-position"></div>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="add-btn-clear-emp-filter">
                                    <i class="fas fa-times me-1"></i> Clear Filters
                                </button>
                            </div>
                        </div>
                        <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                            <div id="add-students-grid" class="flex-grow-1"></div>
                        </div>
                    </div>
                `).appendTo(contentElement);

                const empGrid = initDxGrid("#add-students-grid", {
                    preset: "selectionGrid",
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "EId",
                        loadUrl: `${serviceUrl}/Students/Get`,
                        onBeforeSend: function(method, ajaxOptions) {
                            ajaxOptions.xhrFields = { withCredentials: true };
                        }
                    }),
                    remoteOperations: true,
                    filterRow: { visible: true },
                    searchPanel: { placeholder: "Search ID or name...", width: 220 },
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    columns: [
                        {
                            dataField: "EId", caption: "ID", width: 110,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("tag-pill pill-default fw-bold").text(options.value).appendTo(container);
                            }
                        },
                        {
                            caption: "Name", minWidth: 180,
                            calculateCellValue: function(data) {
                                return [data.EnglishFirstName, data.EnglishLastName].filter(Boolean).join(" ");
                            },
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                            }
                        },
                        {
                            dataField: "Position", caption: "Position", width: 120, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    $("<span>").addClass("tag-pill pill-default").text(options.value).appendTo(container);
                                }
                            }
                        },
                        { dataField: "Department", caption: "Department", width: 120 },
                        {
                            dataField: "Section", caption: "Section", minWidth: 140,
                            cellTemplate: function(container, options) {
                                $("<span>").addClass("text-muted small").text(options.value || EMPTY_TEXT).appendTo(container);
                            }
                        }
                    ]
                });

                initAdminStudentOrgFilters({
                    studentsBaseUrl: `${serviceUrl}/Students`,
                    gridInstance: empGrid,
                    divSelector: "#add-filter-emp-div",
                    deptSelector: "#add-filter-emp-dept",
                    sectionSelector: "#add-filter-emp-section",
                    positionSelector: "#add-filter-emp-position",
                    clearSelector: "#add-btn-clear-emp-filter"
                });
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Cancel",
                        stylingMode: "outlined",
                        onClick: function() { addStudentsPopup.hide(); }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Add Selected",
                        type: "default",
                        stylingMode: "contained",
                        onClick: addSelectedStudents
                    }
                }
            ]
        }).dxPopup("instance");
    }

    async function initializeDashboard() {
        try {
            const response = await $.ajax({
                url: ASSIGNMENT_DASHBOARD_URL,
                method: "GET",
                xhrFields: { withCredentials: true }
            });

            if (!response.success || !response.data) {
                showApiError("Invalid data format.");
                return;
            }


            const data = response.data;
            dashboardData = data;
            const courses = Array.isArray(data.courses) ? data.courses : [];
            const students = Array.isArray(data.students) ? data.students : [];
            const firstRuleId = courses.length > 0 ? courses[0].assignmentRuleId : null;
            const dropdownOptions = courses.map(course => ({
                assignmentRuleId: course.assignmentRuleId,
                displayText: course.isCourseDeleted ? `${course.courseCode} [Deleted]` : `${course.courseCode}`
            }));

            initializeHeader(data);
            initializeStats(data);
            initializeStatusChart(data.chartData, data.completionRate);
            initializeCourseList(courses, firstRuleId);
            initializeCourseSelector(dropdownOptions, firstRuleId);
            studentsByRuleId = groupStudentsByRuleId(students);
            initializeStudentGrid(getStudentsForRule(firstRuleId));

            if (firstRuleId) {
                setActiveCourseFilter(firstRuleId, dropdownOptions[0]?.displayText || EMPTY_TEXT);
            }

            loadPanel.hide();
        } catch (error) {
            console.error('[initializeDashboard] API Error:', {
                status: error?.status,
                statusText: error?.statusText,
                responseText: error?.responseText,
                responseJSON: error?.responseJSON,
                message: error?.message,
                name: error?.name,
                stack: error?.stack,
                url: ASSIGNMENT_DASHBOARD_URL,
                assignmentId: ASSIGNMENT_ID
            });

            if (error?.status === 404) {
                showToast("Assignment no longer exists. Redirecting...", "info", 2000);
                window.setTimeout(() => window.location.href = ASSIGNMENT_INDEX_URL, 1500);
                return;
            }

            const errorMsg = window.getApiErrorMessage(error, "Error loading dashboard data.");
            showApiError(errorMsg);
        }
    }

    function initializeHeader(data) {
        const refNo = data.assignmentNo || EMPTY_TEXT;
        const startText = formatDate(data.startDate, EMPTY_TEXT);
        const dueText = data.dueDate ? formatDate(data.dueDate, "No Limit") : "No Limit";
        const courses = Array.isArray(data.courses) ? data.courses : [];

        currentDueDate = data.dueDate ? new Date(data.dueDate) : null;
        currentStartDate = data.startDate ? new Date(data.startDate) : null;

        $("#lbl-assignment-no").text(`No: ${refNo}`);
        $("#lbl-assignment-no-detail").text(refNo);
        $("#lbl-description").text(data.description || "-");
        $("#lbl-schedule").attr("data-start", startText).text(`${startText} → ${dueText}`);
        $("#lbl-created-by").text(data.createdBy || "-");
        if (refNo && refNo !== EMPTY_TEXT) {
            $("#btn-report-link").attr(
                "href",
                ASSIGNMENT_REPORT_BY_NO_URL_TEMPLATE.replace("__ASSIGNMENT_NO__", encodeURIComponent(refNo))
            );
        }

        if (data.studentGroupId) {
            $("#lbl-student-group").html(
                `<a href="@Url.Action("Detail", "StudentGroups")?id=${data.studentGroupId}" class="action-link">${window.escapeHtml(data.studentGroupName || '-')}</a>` +
                ` <span class="text-secondary u-fs-11">(ID: ${data.studentGroupId})</span>`
            );
            $("#meta-student-group").show();
        }

        if (!data.hasDeletedCourse) {
            return;
        }

        const deletedNames = courses
            .filter(course => course.isCourseDeleted)
            .map(course => course.courseTitle)
            .join(", ");
        $("#deleted-course-names").text(deletedNames);
        $("#deleted-course-banner").show();
    }

    function initializeStats(data) {
        const totalStudents = data.totalStudents ?? data.totalEmployees;
        const chartData = data.chartData || {};

        $("#stat-total-emp").text(totalStudents ?? 0);
        $("#stat-total-courses").text(data.totalCourses ?? 0);
        $("#stat-completed").text(chartData.completed ?? 0);
        $("#stat-inprogress").text(chartData.inProgress ?? 0);
    }

    function initializeStatusChart(chartData, completionRate) {
        const safeChartData = chartData || {};
        const rate = completionRate ?? 0;
        $("#status-pie-chart").dxPieChart(
            window.createAdminPieChartConfig({
                palettePreset: "status3",
                centerLabel: 'Completion',
                centerValue: window.formatAdminPercentage(rate, '0%'),
                baseConfig: {
                    type: "doughnut",
                    innerRadius: 0.65,
                    dataSource: [
                        { status: "Completed", count: safeChartData.completed ?? 0 },
                        { status: "In Progress", count: safeChartData.inProgress ?? 0 },
                        { status: "Not Started", count: safeChartData.notStarted ?? 0 }
                    ],
                    series: [{
                        argumentField: "status",
                        valueField: "count",
                        label: {
                            visible: true,
                            position: "outside",
                            customizeText: point => `${point.valueText} (${point.percentText})`,
                            font: { size: 11, color: "var(--text-secondary)" },
                            connector: { visible: true, width: 1 }
                        }
                    }],
                    legend: {
                        horizontalAlignment: "right",
                        verticalAlignment: "bottom",
                        margin: 12,
                        font: { size: 11, color: "var(--text-secondary)" }
                    },
                    tooltip: { enabled: true }
                }
            })
        );
    }

    function initializeCourseList(courses, firstRuleId) {
        const $courseList = $("#course-list").empty();
        courses.forEach(course => {
            $(buildCourseCardHtml(course, course.assignmentRuleId === firstRuleId)).appendTo($courseList);
        });

        $courseList.find(".course-item").on("click", function() {
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            $("#course-selector").dxSelectBox("instance").option("value", ruleId);
            setActiveCourseFilter(ruleId, title);
        });

        $courseList.find(".btn-remove-course").on("click", function(e) {
            e.preventDefault();
            e.stopPropagation();
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            confirmRemoveCourse(ruleId, title);
        });

        $courseList.find(".btn-reset-course").on("click", function(e) {
            e.preventDefault();
            e.stopPropagation();
            const ruleId = $(this).data("rule");
            const title = $(this).data("title");
            confirmResetCourse(ruleId, title);
        });
    }

    function buildCourseCardHtml(course, isActive) {
        const percent = getCourseCompletionPercent(course);
        const remaining = course.totalStudents - course.completedStudents;
        const leftColor = course.isCourseDeleted
            ? "var(--border-danger)"
            : getProgressColor(percent);
        const deletedBadge = course.isCourseDeleted
            ? `<span class="tag-pill tag-pill-xs pill-danger ms-1"><i class="fas fa-ban me-1"></i>Deleted</span>`
            : "";

        return `
            <div class="course-item ${percent === 100 ? "done" : ""} ${isActive ? "active" : ""} ${course.isCourseDeleted ? "opacity-75" : ""}"
                 data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}"
                 style="border-left-color:${leftColor};">

                <!-- Row 1: Code badge + remove button -->
                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <div class="d-flex align-items-center gap-1">
                        <span class="course-item-code ${course.isCourseDeleted ? "course-item-code--deleted" : ""}">${course.courseCode}</span>
                        ${deletedBadge}
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="javascript:void(0);" class="course-item-remove btn-reset-course"
                           data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}"
                           title="Reset all students">
                            <i class="fas fa-sync-alt"></i>
                        </a>
                        <a href="javascript:void(0);" class="course-item-remove btn-remove-course"
                           data-rule="${course.assignmentRuleId}" data-title="${course.courseTitle}">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>

                <!-- Row 2: Course title -->
                <div class="course-item-title ${course.isCourseDeleted ? "course-item-title--deleted" : ""} mb-2">${course.courseTitle}</div>

                <!-- Row 3: Progress bar + percent -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="progress-slim flex-grow-1">
                        <div style="height:100%; width:${percent}%; background:${leftColor};"></div>
                    </div>
                    <span class="course-item-pct" style="color:${leftColor};">${window.formatAdminPercentage(percent, '0%')}</span>
                </div>

                <!-- Row 4: Stats -->
                <div class="d-flex gap-3 u-fs-11">
                    <span class="u-text-success"><i class="fas fa-check me-1"></i>${window.formatAdminCountLabel(course.completedStudents, 'done', 'done')}</span>
                    <span class="text-secondary">${window.formatAdminCountLabel(remaining, 'left', 'left')}</span>
                </div>

            </div>`;
    }

    function initializeCourseSelector(options, firstRuleId) {
        $("#course-selector").dxSelectBox({
            dataSource: options,
            valueExpr: "assignmentRuleId",
            displayExpr: "displayText",
            value: firstRuleId,
            stylingMode: "underlined",
            placeholder: "Select course...",
            onValueChanged: function(e) {
                const $card = $("#course-list").find(`.course-item[data-rule="${e.value}"]`);
                setActiveCourseFilter(e.value, $card.data("title") || EMPTY_TEXT);
            }
        });
    }

    function initializeStudentGrid(students) {
        initDxGrid("#student-grid", {
            preset: "compactGrid",
            height: "auto",
            minVisibleRows: 8,
            dataSource: students,
            rowAlternationEnabled: false,
            filterRow: { visible: false },
            searchPanel: { placeholder: "Search student...", width: 160 },
            export: { enabled: false },
            onExporting: function(e) {
                handleExporting(e, `Student_Tracking_${ASSIGNMENT_ID}`);
