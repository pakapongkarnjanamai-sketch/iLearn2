@{
    ViewBag.Title = "Assignment Scheduler";
}

<style>
    #scheduler-container { height: calc(100vh - 230px); min-height: 500px; }

    /* ── KPI row ── */
    .sched-kpi-row {
        display: flex;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border-color);
        background: #fafafa;
        flex-wrap: wrap;
    }
    .sched-kpi {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--text-secondary);
    }
    .sched-kpi .dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .sched-kpi .val { font-weight: 700; color: var(--text-primary); }

    /* ── Toolbar strip ── */
    .sched-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border-color);
        background: #fff;
    }
    .sched-filter-btn {
        padding: 4px 12px;
        font-size: 12px;
        border-radius: 14px;
        border: 1px solid var(--border-color);
        background: #fff;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all .15s;
    }
    .sched-filter-btn.active,
    .sched-filter-btn:hover {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #fff;
    }
    .sched-filter-btn.btn-all.active        { background:#595959; border-color:#595959; }
    .sched-filter-btn.btn-inprogress.active  { background:var(--accent-color);  border-color:var(--accent-color); }
    .sched-filter-btn.btn-upcoming.active    { background:var(--warning-color); border-color:var(--warning-color); }
    .sched-filter-btn.btn-expired.active     { background:var(--danger-color);  border-color:var(--danger-color); }
    .sched-filter-btn.btn-completed.active   { background:var(--success-color); border-color:var(--success-color); }

    /* ── Legend ── */
    .sched-legend {
        display: flex;
        gap: 16px;
        align-items: center;
        padding: 8px 16px 0;
        flex-wrap: wrap;
        font-size: 11px;
        color: var(--text-secondary);
    }
    .legend-item { display: flex; align-items: center; gap: 5px; }
    .legend-dot  { width: 10px; height: 10px; border-radius: 50%; }

    /* ── Tooltip card ── */
    .appt-tooltip {
        padding: 8px 4px;
        min-width: 260px;
    }
    .appt-tooltip .appt-title {
        font-weight: 700;
        font-size: 13px;
        color: var(--text-primary);
        margin-bottom: 8px;
        line-height: 1.3;
    }
    .appt-tooltip .appt-row {
        display: flex;
        gap: 6px;
        font-size: 11px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }
    .appt-tooltip .appt-row .lbl { min-width: 70px; font-weight: 600; flex-shrink: 0; }
    .appt-tooltip .badge-status {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 600;
        color: #fff;
    }
    .appt-tooltip .progress-bar-wrap {
        height: 5px;
        background: #e8e8e8;
        border-radius: 3px;
        margin-top: 8px;
    }
    .appt-tooltip .progress-bar-fill {
        height: 5px;
        border-radius: 3px;
    }

    /* ── Custom appointment bar content ── */
    .appt-bar { display: flex; align-items: center; gap: 6px; padding: 2px 6px; overflow: hidden; white-space: nowrap; height: 100%; }
    .appt-bar .appt-bar-no   { font-weight: 700; font-size: 11px; }
    .appt-bar .appt-bar-desc { font-size: 11px; opacity: .85; }
    .appt-bar .appt-bar-pct  { margin-left: auto; font-size: 10px; font-weight: 700; opacity: .9; }
</style>

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Assignment Scheduler</div>
        <div class="text-secondary" style="font-size:12px;">Timeline view – assignment schedule planning</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-table text-secondary"></i> List View
        </a>
        <a href="@Url.Action("Gantt", "Assignments")" class="action-link">
            <i class="fas fa-project-diagram text-secondary"></i> Gantt View
        </a>
      
    </div>
</div>

<div class="container-fluid px-0 py-0">
    <div class="border rounded bg-white mx-4 mt-3 mb-4" style="overflow:hidden;">

        <!-- ── KPI bar ── -->
        <div class="sched-kpi-row">
            <div class="sched-kpi">
                <span class="dot" style="background:#595959"></span>
                All: <span class="val" id="kpi-all">—</span>
            </div>
            <div class="sched-kpi">
                <span class="dot" style="background:#1890ff"></span>
                In Progress: <span class="val" id="kpi-inprogress">—</span>
            </div>
            <div class="sched-kpi">
                <span class="dot" style="background:#faad14"></span>
                Upcoming: <span class="val" id="kpi-upcoming">—</span>
            </div>
            <div class="sched-kpi">
                <span class="dot" style="background:#ff4d4f"></span>
                Expired: <span class="val" id="kpi-expired">—</span>
            </div>
            <div class="sched-kpi">
                <span class="dot" style="background:#52c41a"></span>
                Completed: <span class="val" id="kpi-completed">—</span>
            </div>
        </div>

        <!-- ── Status filter toolbar ── -->
        <div class="sched-toolbar">
            <span style="font-size:12px;font-weight:600;color:var(--text-secondary);margin-right:4px;">Status:</span>
            <button class="sched-filter-btn btn-all active"        onclick="applyFilter(null,this)">All</button>
            <button class="sched-filter-btn btn-inprogress"        onclick="applyFilter('InProgress',this)">In Progress</button>
            <button class="sched-filter-btn btn-upcoming"          onclick="applyFilter('Upcoming',this)">Upcoming</button>
            <button class="sched-filter-btn btn-expired"           onclick="applyFilter('Expired',this)">Expired</button>
            <button class="sched-filter-btn btn-completed"         onclick="applyFilter('Completed',this)">Completed</button>
        </div>

        <!-- ── Legend ── -->
        <div class="sched-legend">
            <span class="legend-item"><span class="legend-dot" style="background:#1890ff"></span> In Progress</span>
            <span class="legend-item"><span class="legend-dot" style="background:#faad14"></span> Upcoming</span>
            <span class="legend-item"><span class="legend-dot" style="background:#ff4d4f"></span> Expired</span>
            <span class="legend-item"><span class="legend-dot" style="background:#52c41a"></span> Completed</span>
        </div>

        <!-- ── Scheduler ── -->
        <div id="scheduler-container"></div>

    </div>
</div>

<!-- ── Appointment tooltip template (hidden, cloned per tooltip) ── -->
<div id="appt-tooltip-tpl" style="display:none;">
    <div class="appt-tooltip">
        <div class="appt-title" id="tt-title"></div>
        <div class="appt-row"><span class="lbl">No.:</span>        <span id="tt-no"></span></div>
        <div class="appt-row"><span class="lbl">Description:</span><span id="tt-desc"></span></div>
        <div class="appt-row"><span class="lbl">Status:</span>     <span id="tt-status"></span></div>
        <div class="appt-row"><span class="lbl">Courses:</span>    <span id="tt-courses"></span></div>
        <div class="appt-row"><span class="lbl">Students:</span>   <span id="tt-students"></span></div>
        <div class="appt-row"><span class="lbl">Period:</span>     <span id="tt-period"></span></div>
        <div class="progress-bar-wrap">
            <div class="progress-bar-fill" id="tt-progress-fill"></div>
        </div>
        <div style="font-size:10px;color:var(--text-secondary);margin-top:3px;text-align:right;" id="tt-progress-label"></div>
    </div>
</div>

@section Scripts {
<script>
    const STATUS_COLORS = {
        InProgress: "#1890ff",
        Upcoming:   "#faad14",
        Expired:    "#ff4d4f",
        Completed:  "#52c41a"
    };

    const STATUS_LABELS = {
        InProgress: "In Progress",
        Upcoming:   "Upcoming",
        Expired:    "Expired",
        Completed:  "Completed"
    };

    const STATUS_RESOURCES = [
        { id: "InProgress", text: "In Progress", color: "#1890ff" },
        { id: "Upcoming",   text: "Upcoming",    color: "#faad14" },
        { id: "Expired",    text: "Expired",     color: "#ff4d4f" },
        { id: "Completed",  text: "Completed",   color: "#52c41a" }
    ];

    let allData      = [];
    let activeStatus = null;
    let schedulerInstance;

    // ── Map history item → scheduler appointment ─────────────────
    function mapToAppointment(item) {
        const start = item.startDate ? new Date(item.startDate) : new Date(item.createdAt);
        let   end   = item.dueDate   ? new Date(item.dueDate)   : new Date(start.getTime() + 7 * 86400000);
        if (end <= start) end = new Date(start.getTime() + 86400000);

        const total = item.totalEnrollmentCount || 0;
        const done  = item.completedEnrollmentCount || 0;
        const progress = total > 0 ? Math.round((done / total) * 100) : 0;

        return {
            id:           item.id,
            text:         item.assignmentNo + " – " + (item.description || ""),
            startDate:    start,
            endDate:      end,
            allDay:       true,
            status:       item.status,
            assignmentNo: item.assignmentNo,
            description:  item.description || "",
            courseNames:  item.courseNames || "",
            studentCount: item.studentCount,
            courseCount:   item.courseCount,
            progress:     progress,
            completedCount: done,
            totalCount:     total,
            createdBy:    item.createdBy || ""
        };
    }

    // ── KPI ───────────────────────────────────────────────────────
    function updateKpi(data) {
        $("#kpi-all").text(data.length);
        $("#kpi-inprogress").text(data.filter(d => d.status === "InProgress").length);
        $("#kpi-upcoming").text(data.filter(d => d.status === "Upcoming").length);
        $("#kpi-expired").text(data.filter(d => d.status === "Expired").length);
        $("#kpi-completed").text(data.filter(d => d.status === "Completed").length);
    }

    // ── Filter ────────────────────────────────────────────────────
    function applyFilter(status, el) {
        activeStatus = status;
        $(".sched-filter-btn").removeClass("active");
        $(el).addClass("active");
        refreshDataSource();
    }

    function getFiltered() {
        const appts = allData.map(mapToAppointment);
        if (!activeStatus) return appts;
        return appts.filter(a => a.status === activeStatus);
    }

    function refreshDataSource() {
        if (schedulerInstance) {
            schedulerInstance.option("dataSource", getFiltered());
        }
    }

    // ── Format date as dd/MM/yyyy ─────────────────────────────────
    function fmtDate(d) {
        if (!d) return "—";
        const dt = new Date(d);
        return String(dt.getDate()).padStart(2, "0") + "/"
             + String(dt.getMonth() + 1).padStart(2, "0") + "/"
             + dt.getFullYear();
    }

    // ── Tooltip content ───────────────────────────────────────────
    function buildTooltip(model) {
        const appt  = model.appointmentData;
        const color = STATUS_COLORS[appt.status] || "#aaa";
        const label = STATUS_LABELS[appt.status] || appt.status;
        const pct   = appt.progress ?? 0;

        const $tpl = $("#appt-tooltip-tpl").clone().show().removeAttr("id");
        $tpl.find("#tt-title").text(appt.assignmentNo || appt.text);
        $tpl.find("#tt-no").text(appt.assignmentNo || "—");
        $tpl.find("#tt-desc").text(appt.description || "—");
        $tpl.find("#tt-status").html(
            `<span class="badge-status" style="background:${color}">${label}</span>`
        );
        $tpl.find("#tt-courses").text(appt.courseNames || "—");
        $tpl.find("#tt-students").text(
            `${appt.completedCount ?? 0} / ${appt.totalCount ?? 0} completed` +
            ` (${appt.studentCount ?? 0} students, ${appt.courseCount ?? 0} courses)`
        );
        $tpl.find("#tt-period").text(`${fmtDate(appt.startDate)} – ${fmtDate(appt.endDate)}`);
        $tpl.find("#tt-progress-fill").css({ width: pct + "%", background: color });
        $tpl.find("#tt-progress-label").text(`Progress: ${pct}%`);

        return $tpl;
    }

    // ── Build scheduler ───────────────────────────────────────────
    function buildScheduler(appointments) {
        const today = new Date();

        schedulerInstance = $("#scheduler-container").dxScheduler({
            dataSource:    appointments,
            keyExpr:       "id",
            textExpr:      "text",
            startDateExpr: "startDate",
            endDateExpr:   "endDate",
            allDayExpr:    "allDay",
            currentDate:   today,
            currentView:   "3 Months",
            views: [
                {
                    type:          "timelineMonth",
                    name:          "3 Months",
                    intervalCount: 3
                },
                {
                    type:          "timelineMonth",
                    name:          "1 Month",
                    intervalCount: 1
                },
                {
                    type:          "timelineWeek",
                    name:          "Week",
                    intervalCount: 1
                },
                {
                    type:          "agenda",
                    name:          "Agenda",
                    agendaDuration: 30
                }
            ],
            firstDayOfWeek:        1,
            crossScrollingEnabled: true,
            height:                "100%",
            editing:               false,
            resources: [{
                fieldExpr:   "status",
                dataSource:  STATUS_RESOURCES,
                label:       "Status"
            }],
            appointmentTemplate: function (data) {
                const pct = data.progress ?? 0;
                return $("<div>").addClass("appt-bar")
                    .append($("<span>").addClass("appt-bar-no").text(data.assignmentNo || ""))
                    .append($("<span>").addClass("appt-bar-desc").text(data.description || ""))
                    .append($("<span>").addClass("appt-bar-pct").text(pct + "%"));
            },
            appointmentTooltipTemplate: function (model) {
                return buildTooltip(model);
            },
            onAppointmentRendered: function (e) {
                if (e.appointmentData) {
                    var color = STATUS_COLORS[e.appointmentData.status] || "#aaa";
                    $(e.appointmentElement)
                        .css("background-color", color)
                        .css("border-color", color);
                }
            },
            onAppointmentClick: function (e) {
                e.cancel = true;
                if (e.appointmentData && e.appointmentData.id) {
                    window.location.href = "@Url.Action("Progress", "Assignments")/" + e.appointmentData.id;
                }
            },
            onAppointmentDblClick: function (e) {
                e.cancel = true;
            }
        }).dxScheduler("instance");
    }

    // ── Bootstrap ─────────────────────────────────────────────────
    $(() => {
        $.ajax({
            url: `${serviceUrl}/Assignments/history`,
            method: "GET",
            data: { pageSize: 500 },
            xhrFields: { withCredentials: true }
        }).done(function (res) {
            allData = Array.isArray(res) ? res : (res.data || []);
            updateKpi(allData);
            buildScheduler(getFiltered());
        }).fail(() => DevExpress.ui.notify("Error loading assignment data.", "error", 3000));
    });
</script>
}
