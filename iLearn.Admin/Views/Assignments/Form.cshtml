@{
    ViewBag.Title = "Bulk Course Assignments";
    // รับค่า courseId จาก URL (ถ้ามี)
    var preselectedCourseId = Context.Request.Query["courseId"].ToString();
}

<style>
    body { background-color: #f8f9fa; }

    /* Action Card Styles */
    .action-card {
        border: 2px dashed #e8ecf1;
        border-radius: 12px;
        background-color: #ffffff;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-align: center;
        padding: 2.5rem 1.5rem;
    }
    .action-card:hover {
        border-color: #0d6efd;
        background-color: #f8fbff;
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
    }
    
    /* Fixed Bottom Toolbar */
    .fixed-bottom-toolbar {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        background: #ffffff;
        padding: 1rem 2rem;
        box-shadow: 0 -4px 15px rgba(0,0,0,0.05);
        z-index: 1000;
        border-top: 1px solid #e8ecf1;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    /* Filter Panel Style */
    .filter-panel {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        border: 1px solid #e8ecf1;
    }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                <i class="fas fa-users-cog fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted fw-medium">Assign training courses to multiple employees based on specific criteria.</small>
            </div>
        </div>
        <button class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3 fw-medium" onclick="history.back()">
            <i class="fas fa-arrow-left me-1"></i> Back
        </button>
    </div>
</div>

<div class="container px-4 pb-5" style="margin-bottom: 80px;">
    <div id="load-panel"></div>

   
        <div class="row g-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-edit text-primary me-2"></i> Assignment Criteria</h6>
                </div>
                <div class="card-body p-4">
                    <div id="form-assignment"></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="card border-0 shadow-sm rounded-4 flex-grow-1">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-bullseye text-primary me-2"></i> Target Selection</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="action-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-select-courses">
                                <i class="fas fa-book-open fa-2x text-primary mb-3"></i>
                                <h6 class="fw-bold text-dark mb-1">Select Courses</h6>
                                <p class="text-muted small mb-0 fw-medium" id="selected-courses-text">No course selected</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="action-card h-100 d-flex flex-column align-items-center justify-content-center" id="btn-select-employees">
                                <i class="fas fa-users fa-2x text-primary mb-3"></i>
                                <h6 class="fw-bold text-dark mb-1">Select Employees</h6>
                                <p class="text-muted small mb-0 fw-medium" id="selected-employees-text">No employee selected</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
 
</div>

<div class="fixed-bottom-toolbar">
    <button class="btn btn-light border px-4 py-2 fw-medium rounded-3" onclick="history.back()">Cancel</button>
    <button class="btn btn-primary px-4 py-2 fw-medium rounded-3 shadow-sm" id="btn-save">
        <i class="fas fa-save me-2"></i> Save & Review
    </button>
</div>

<div id="courses-popup"></div>
<div id="employees-popup"></div>
<div id="summary-popup"></div> 

@section Scripts {
    <script>
        // 🌟 1. รับค่า courseId จาก Query String และนำไปใส่เป็นค่า Default
        const initialCourseId = '@preselectedCourseId';
        let selectedCourseIds = initialCourseId ? [parseInt(initialCourseId)] : [];
        let selectedEmployeeCodes = [];
        let currentPayload = null;

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)", position: { of: "body" }, visible: false, shading: true
            }).dxLoadPanel("instance");

            // อัปเดต UI ทันทีหากมีการแนบ courseId มาจากหน้า Dashboard
            if (selectedCourseIds.length > 0) {
                updateCardUI("#btn-select-courses", "#selected-courses-text", selectedCourseIds.length, "course");
            }

            // --- Main Form ---
            const form = $("#form-assignment").dxForm({
                labelMode: "floating",
                formData: { description: "", startDate: null, dueDate: null },
                items: [
                    { dataField: "description", editorType: "dxTextArea", editorOptions: { height: 120 }, validationRules: [{ type: "required", message: "Required" }] },
                    { itemType: "group", colCount: 2, items: [
                        { dataField: "startDate", editorType: "dxDateBox", editorOptions: { width: "100%", displayFormat: "dd/MM/yyyy" }, validationRules: [{ type: "required", message: "Required" }] },
                        { dataField: "dueDate", editorType: "dxDateBox", editorOptions: { width: "100%", displayFormat: "dd/MM/yyyy" }, validationRules: [{ type: "required", message: "Required" }] }
                    ]}
                ]
            }).dxForm("instance");

            // --- Courses Popup ---
            const coursesPopup = $("#courses-popup").dxPopup({
                title: "Select Courses", width: 900, height: 650,
                contentTemplate: function(contentElement) {
                    const layout = $(`
                        <div class="row h-100 g-3">
                            <div class="col-md-4 border-end pe-3">
                                <div class="filter-panel h-100">
                                    <h6 class="fw-bold mb-3"><i class="fas fa-filter text-muted me-2"></i>Filters</h6>
                                    <div class="mb-3">
                                        <label class="small fw-bold text-muted mb-1">Division</label>
                                        <div id="filter-course-div"></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="small fw-bold text-muted mb-1">Category</label>
                                        <div id="filter-course-cat"></div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary w-100 mt-2" id="btn-clear-course-filter">Clear Filters</button>
                                </div>
                            </div>
                            <div class="col-md-8 h-100 pb-3">
                                <div id="grid-courses"></div>
                            </div>
                        </div>
                    `).appendTo(contentElement);

                    const courseGrid = $("#grid-courses").dxDataGrid({
                        dataSource: new DevExpress.data.CustomStore({
                            key: "id",
                            load: () => $.ajax({
                                url: `${serviceUrl}/Assignments/lookup-courses`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            }).then(res => res.data)
                        }),
                        showBorders: true, showRowLines: true, filterRow: { visible: true },
                        searchPanel: { visible: true, placeholder: "Search code or title..." },
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        scrolling: { mode: "virtual" }, height: "100%",
                        columns: [
                            { dataField: "code", caption: "Code", width: 100, cssClass: "fw-bold" },
                            { dataField: "title", caption: "Course Title" }
                        ],
                        selectedRowKeys: selectedCourseIds,
                        onSelectionChanged: function(e) {
                            selectedCourseIds = e.selectedRowKeys;
                            updateCardUI("#btn-select-courses", "#selected-courses-text", selectedCourseIds.length, "course");
                        }
                    }).dxDataGrid("instance");

                    const divBox = $("#filter-course-div").dxSelectBox({
                        dataSource: new DevExpress.data.CustomStore({
                            key: "id", 
                            load: () => $.ajax({
                                url: `${serviceUrl}/admin/DivisionsCRUD/Get`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            }).then(res => res.data)
                        }),
                        displayExpr: "name", valueExpr: "id", placeholder: "All Divisions",
                        onValueChanged: function(e) {
                            const catBox = $("#filter-course-cat").dxSelectBox("instance");
                            if(e.value) {
                                courseGrid.filter(["divisionId", "=", e.value]);
                                catBox.option("dataSource", new DevExpress.data.CustomStore({
                                    key: "id", 
                                    load: () => $.ajax({
                                        url: `${serviceUrl}/admin/CategoriesCRUD/Get?filter=["divisionId","=",${e.value}]`,
                                        method: "GET",
                                        xhrFields: { withCredentials: true }
                                    }).then(res => res.data)
                                }));
                                catBox.option("value", null);
                            } else {
                                courseGrid.clearFilter();
                                catBox.option("dataSource", []);
                            }
                        }
                    }).dxSelectBox("instance");

                    const catBox = $("#filter-course-cat").dxSelectBox({
                        displayExpr: "name", valueExpr: "id", placeholder: "All Categories",
                        onValueChanged: function(e) {
                            if(e.value) {
                                courseGrid.filter([["divisionId", "=", divBox.option("value")], "and", ["categoryId", "=", e.value]]);
                            } else if(divBox.option("value")) {
                                courseGrid.filter(["divisionId", "=", divBox.option("value")]);
                            } else {
                                courseGrid.clearFilter();
                            }
                        }
                    }).dxSelectBox("instance");

                    $("#btn-clear-course-filter").click(() => { divBox.option("value", null); catBox.option("value", null); courseGrid.clearFilter(); });
                },
                toolbarItems: [{ widget: "dxButton", toolbar: "bottom", location: "after", options: { text: "Done", type: "default", onClick: () => coursesPopup.hide() } }]
            }).dxPopup("instance");

            // --- Employees Popup ---
            const employeesPopup = $("#employees-popup").dxPopup({
                title: "Select Employees", width: 1000, height: 650,
                contentTemplate: function(contentElement) {
                    const layout = $(`
                        <div class="row h-100 g-3">
                            <div class="col-md-4 border-end pe-3">
                                <div class="filter-panel h-100">
                                    <h6 class="fw-bold mb-3"><i class="fas fa-filter text-muted me-2"></i>Filters</h6>
                                    <div class="mb-3">
                                        <label class="small fw-bold text-muted mb-1">Division</label>
                                        <div id="filter-emp-div"></div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="small fw-bold text-muted mb-1">Department</label>
                                        <div id="filter-emp-dept"></div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary w-100 mt-2" id="btn-clear-emp-filter">Clear Filters</button>
                                </div>
                            </div>
                            <div class="col-md-8 h-100 pb-3">
                                <div id="grid-employees"></div>
                            </div>
                        </div>
                    `).appendTo(contentElement);

                    const empGrid = $("#grid-employees").dxDataGrid({
                        dataSource: DevExpress.data.AspNet.createStore({
                            key: "EId", 
                            loadUrl: `${serviceUrl}/Students/Get`,
                            onBeforeSend: function(method, ajaxOptions) {
                                ajaxOptions.xhrFields = { withCredentials: true }; 
                            }
                        }),
                        remoteOperations: true,
                        showBorders: true, showRowLines: true, filterRow: { visible: true },
                        searchPanel: { visible: true, placeholder: "Search ID or Name..." },
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        scrolling: { mode: "virtual" }, height: "100%",
                        columns: [
                            { dataField: "EId", caption: "ID", width: 90, cssClass: "fw-bold" },
                            { 
                                caption: "Name", 
                                calculateCellValue: (d) => `${d.EnglishFirstName || ''} ${d.EnglishLastName || ''}` 
                            },
                            { dataField: "Department", caption: "Department", width: 100 }
                        ],
                        selectedRowKeys: selectedEmployeeCodes,
                        onSelectionChanged: function(e) {
                            selectedEmployeeCodes = e.selectedRowKeys;
                            updateCardUI("#btn-select-employees", "#selected-employees-text", selectedEmployeeCodes.length, "employee");
                        }
                    }).dxDataGrid("instance");

                    const empDivBox = $("#filter-emp-div").dxSelectBox({
                        dataSource: new DevExpress.data.CustomStore({
                            key: "Name", 
                            load: () => $.ajax({
                                url: `${serviceUrl}/Students/GetDivisions`,
                                method: "GET",
                                xhrFields: { withCredentials: true }
                            }).then(res => res.data)
                        }),
                        displayExpr: "Name", valueExpr: "Name", placeholder: "All Divisions",
                        onValueChanged: function(e) {
                            const empDeptBox = $("#filter-emp-dept").dxSelectBox("instance");
                            if(e.value) {
                                empGrid.filter(["Division", "=", e.value]);
                                empDeptBox.option("dataSource", new DevExpress.data.CustomStore({
                                    key: "Name", 
                                    load: () => $.ajax({
                                        url: `${serviceUrl}/Students/GetDepartments?filter=["Division","=","${e.value}"]`,
                                        method: "GET",
                                        xhrFields: { withCredentials: true }
                                    }).then(res => res.data)
                                }));
                                empDeptBox.option("value", null);
                            } else {
                                empGrid.clearFilter();
                                empDeptBox.option("dataSource", []);
                            }
                        }
                    }).dxSelectBox("instance");

                    const empDeptBox = $("#filter-emp-dept").dxSelectBox({
                        displayExpr: "Name", valueExpr: "Name", placeholder: "All Departments",
                        onValueChanged: function(e) {
                            if(e.value) {
                                empGrid.filter([["Division", "=", empDivBox.option("value")], "and", ["Department", "=", e.value]]);
                            } else if(empDivBox.option("value")) {
                                empGrid.filter(["Division", "=", empDivBox.option("value")]);
                            } else {
                                empGrid.clearFilter();
                            }
                        }
                    }).dxSelectBox("instance");

                    $("#btn-clear-emp-filter").click(() => { empDivBox.option("value", null); empDeptBox.option("value", null); empGrid.clearFilter(); });
                },
                toolbarItems: [{ widget: "dxButton", toolbar: "bottom", location: "after", options: { text: "Done", type: "default", onClick: () => employeesPopup.hide() } }]
            }).dxPopup("instance");

            // Event binding for Cards
            $("#btn-select-courses").click(() => coursesPopup.show());
            $("#btn-select-employees").click(() => employeesPopup.show());

            function updateCardUI(cardId, textId, count, itemName) {
                if (count > 0) {
                    $(textId).text(`${count} ${itemName}(s) selected`).removeClass("text-muted").addClass("text-success fw-bold");
                    $(cardId).css({"border-color": "#2da44e", "background-color": "#f0fdf4"});
                } else {
                    $(textId).text(`No ${itemName} selected`).removeClass("text-success fw-bold").addClass("text-muted fw-medium");
                    $(cardId).css({"border-color": "", "background-color": ""});
                }
            }


            // 🌟 2. Summary Popup (หน้าต่างสรุปผลการตรวจสอบ) 🌟
            const summaryPopup = $("#summary-popup").dxPopup({
                title: "Assignment Summary",
                width: 750,
                height: "auto",
                maxHeight: window.innerHeight * 0.8,
                showCloseButton: true,
                dragEnabled: true,
                deferRendering: false, // 🌟 เพิ่มบรรทัดนี้: บังคับให้ Render DOM ทันทีตั้งแต่โหลดหน้า
                wrapperAttr: { class: "shadow-lg rounded-4" },
                contentTemplate: function(contentElement) {
                    // 🌟 ปรับวิธีแนบ content ลงใน Popup
                    contentElement.append($("<div id='summary-content'></div>"));
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Cancel", stylingMode: "outlined", onClick: () => summaryPopup.hide() }
                    },
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Confirm & Assign", type: "default", stylingMode: "contained",
                            elementAttr: { class: "btn-primary shadow-sm rounded-3 px-3 fw-medium" },
                            onClick: () => {
                                summaryPopup.hide();
                                executeBulkAssign(currentPayload);
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            // ฟังก์ชันวาดหน้าจอสรุปผล
            function showSummaryDialog(res, payload) {
                currentPayload = payload;
                const conflicts = res.conflicts || [];
                const totalExpected = payload.courseIds.length * payload.employeeCodes.length;
                const validCount = totalExpected - conflicts.length;

                let conflictHtml = "";
                if (conflicts.length > 0) {
                    // แสดงรายชื่อคนซ้ำ
                    const listItems = conflicts.map(c => `
                        <li class="mb-2 pb-2 border-bottom border-danger border-opacity-10 last-no-border">
                            <span class="fw-bold text-dark">${c.studentCode}</span> 
                            <span class="text-muted mx-1">in</span> 
                            <span class="fw-medium">${c.courseTitle}</span>
                            <div class="small text-danger mt-1"><i class="fas fa-exclamation-circle me-1"></i> Already assigned & in progress</div>
                        </li>
                    `).join('');

                    conflictHtml = `
                        <div class="alert border-warning bg-warning bg-opacity-10 mt-4 rounded-4 shadow-sm p-4">
                            <h6 class="text-warning-emphasis fw-bold mb-3">
                                <i class="fas fa-exclamation-triangle me-2"></i> Exceptions Found (${conflicts.length})
                            </h6>
                            <ul class="mb-0 small list-unstyled" style="max-height: 180px; overflow-y: auto;">
                                ${listItems}
                            </ul>
                            <div class="mt-3 pt-3 border-top border-warning border-opacity-25">
                                <div class="fw-bold text-dark"><i class="fas fa-info-circle text-primary me-1"></i> If you proceed:</div>
                                <div class="small text-muted mt-1">A <b>New Attempt</b> will be created for these employees, overriding their current progress schedule.</div>
                            </div>
                        </div>
                    `;
                } else {
                    conflictHtml = `
                        <div class="alert border-success bg-success bg-opacity-10 mt-4 rounded-4 text-center py-4">
                            <i class="fas fa-check-circle text-success fa-3x mb-2"></i>
                            <h6 class="text-success fw-bold mb-0">All clear! No assignment conflicts found.</h6>
                            <small class="text-muted">You are ready to proceed.</small>
                        </div>
                    `;
                }

                const html = `
                    <div class="px-2">
                        <p class="text-muted mb-4 fw-medium">Please review the details below before confirming the assignment.</p>
                        
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-4 border text-center">
                                    <div class="text-muted small text-uppercase fw-bold mb-1">Target Courses</div>
                                    <div class="fs-3 fw-bold text-primary">${payload.courseIds.length}</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-4 border text-center">
                                    <div class="text-muted small text-uppercase fw-bold mb-1">Target Employees</div>
                                    <div class="fs-3 fw-bold text-info">${payload.employeeCodes.length}</div>
                                </div>
                            </div>
                        </div>

                        ${conflictHtml}
                    </div>
                `;

                $("#summary-content").html(html);
                summaryPopup.show();
            }


            // --- Save Action (เริ่มตรวจสอบผ่าน API) ---
            $('#btn-save').click(function () {
                if (!form.validate().isValid) return;
                if (selectedCourseIds.length === 0) { DevExpress.ui.notify("Please select at least one course.", "error", 3000); return; }
                if (selectedEmployeeCodes.length === 0) { DevExpress.ui.notify("Please select at least one employee.", "error", 3000); return; }

                const formData = form.option('formData');
                const payload = {
                    courseIds: selectedCourseIds,
                    employeeCodes: selectedEmployeeCodes,
                    startDate: formData.startDate,
                    dueDate: formData.dueDate,
                    description: formData.description
                };

                loadPanel.option("message", "Validating data...");
                loadPanel.show();

                $.ajax({
                    url: `${serviceUrl}/Assignments/validate-before-assign`,
                    method: 'POST', contentType: 'application/json',
                    data: JSON.stringify(payload), xhrFields: { withCredentials: true },
                    success: function (res) {
                        loadPanel.hide();
                        // นำผลลัพธ์มาสร้างเป็น Summary Popup ให้ Admin ดูสรุป
                        showSummaryDialog(res, payload);
                    },
                    error: function () {
                        loadPanel.hide();
                        DevExpress.ui.notify("Error connecting to validation service.", "error", 3000);
                    }
                });
            });

            // ฟังก์ชันบันทึกข้อมูลจริง
            function executeBulkAssign(payload) {
                loadPanel.option("message", "Assigning courses...");
                loadPanel.show();
                $.ajax({
                    url: `${serviceUrl}/Enrollments/BulkAssign`, 
                    method: "POST", contentType: "application/json",
                    data: JSON.stringify(payload), xhrFields: { withCredentials: true },
                    success: function (res) {
                        DevExpress.ui.notify("Assigned successfully!", "success", 3000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Assignments")', 1500);
                    },
                    error: function (err) {
                        DevExpress.ui.notify("Error: " + (err.responseJSON?.message || "Failed to assign"), "error", 4000);
                        loadPanel.hide();
                    }
                });
            }
        });
    </script>
}