@{
    ViewBag.Title = "Bulk Course Assignments";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-users-cog"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Assign training courses to multiple employees based on specific criteria.
                    </div>
                </div>
            </h1>
            <div>
                <button id="btn-cancel-top" class="btn btn-light border shadow-sm rounded px-3" onclick="history.back()">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div id="load-panel"></div>

    <div id="courses-popup"></div>
    <div id="employees-popup"></div>

    <div class="row justify-content-center g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                        <i class="fas fa-filter text-primary"></i> Assignment Criteria
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div id="criteria-form"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="fixed-bottom bg-white shadow-lg py-3 border-top" style="z-index: 100;">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                <i class="fas fa-info-circle me-1"></i> Please review selected courses and employees before assigning.
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light border px-4 shadow-sm" onclick="history.back()">Cancel</button>
                <div id="btn-assign"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const PRESELECTED_COURSE_ID = @(ViewBag.CourseId ?? "null");

        // ---------------------------------------------------------
        // 1. Data Sources สำหรับฝั่งหลักสูตร (Courses)
        // ---------------------------------------------------------

        const activeCoursesDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "id",
                loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetActive`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "code"
        });

        const popupCategoryDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "id",
                loadUrl: `${serviceUrl}/admin/CategoriesCRUD/Get`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "name",
            paginate: true,
            pageSize: 50
        });

        // ---------------------------------------------------------
        // 2. Data Sources สำหรับฝั่งพนักงาน (Employees)
        // ---------------------------------------------------------

        const divisionDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "Name",
                loadUrl: `${serviceUrl}/Students/GetDivisions`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "Name"
        });

        const departmentDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "Name",
                loadUrl: `${serviceUrl}/Students/GetDepartments`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "Name"
        });

        // เก็บข้อมูลพนักงานที่เลือกมาแสดงใน TagBox
        let selectedEmployeesData = [];

        // ---------------------------------------------------------
        // 3. UI Components Logic
        // ---------------------------------------------------------

        let criteriaForm;
        let coursesGrid;
        let categoryGrid;
        let employeesGrid;
        let coursesPopup;
        let employeesPopup;

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Processing..."
            }).dxLoadPanel("instance");

            // --- 1. สร้าง Popup สำหรับเลือก Courses ---
            const handleCategorySelection = function(e) {
                const addedItems = e.addedItems;
                const removedItems = e.removedItems;

                addedItems.forEach(cat => {
                    activeCoursesDataSource.store().load({ filter: ["categoryId", "=", cat.id] })
                        .done(function(courses) {
                            const ids = courses.map(c => c.id);
                            if(ids.length > 0) coursesGrid.selectRows(ids, true);
                        });
                });

                removedItems.forEach(cat => {
                    activeCoursesDataSource.store().load({ filter: ["categoryId", "=", cat.id] })
                        .done(function(courses) {
                            const ids = courses.map(c => c.id);
                            if(ids.length > 0) coursesGrid.deselectRows(ids);
                        });
                });
            };

                    // --- 1. ปรับปรุง Courses Popup ---
        coursesPopup = $("#courses-popup").dxPopup({
            title: "Browse Active Courses",
            width: function() {
                // ใช้ 90% ของหน้าจอ แต่ไม่เกิน 1400px
                return Math.min(window.innerWidth * 0.9, 1400);
            },
            height: function() {
                // ใช้ 85% ของความสูงหน้าจอ แต่ไม่เกิน 800px
                return Math.min(window.innerHeight * 0.85, 800);
            },
            maxWidth: 1400,
            maxHeight: 800,
            minWidth: 800,
            minHeight: 500,
            showCloseButton: true,
            dragEnabled: true,
            resizeEnabled: true, // เพิ่มความสามารถในการปรับขนาด
            contentTemplate: function(container) {
                const wrapper = $("<div class='d-flex h-100 gap-3'>").appendTo(container);

                // --- Panel ซ้าย: Categories (ปรับเป็น % แทน px) ---
                const leftPanel = $("<div style='width: 35%; min-width: 300px; max-width: 450px; display: flex; flex-direction: column;'>").appendTo(wrapper);
                const leftToolbar = $("<div class='d-flex justify-content-between align-items-center mb-2'>").appendTo(leftPanel);
                $("<h6 class='fw-bold mb-0 text-dark'>").text("Categories").appendTo(leftToolbar);

                const $catGrid = $("<div class='flex-grow-1 border rounded'>").appendTo(leftPanel);

                categoryGrid = $catGrid.dxDataGrid({
                    dataSource: popupCategoryDataSource,
                    keyExpr: "id",
                    showBorders: false,
                    hoverStateEnabled: true,
                    scrolling: { mode: "virtual" },
                    height: "100%",
                    columnAutoWidth: true, // เพิ่มเพื่อให้ column ปรับขนาดอัตโนมัติ
                    columns: [
                        { dataField: "division.name", caption: "Division", width: 100, alignment: "center" },
                        { dataField: "name", caption: "Category Name", minWidth: 150 }
                    ],
                    onSelectionChanged: handleCategorySelection,
                    onRowClick: function(e) {
                        if (e.rowType === "data") {
                            coursesGrid.filter(["categoryId", "=", e.data.id]);
                        }
                    }
                }).dxDataGrid("instance");

                // --- Panel ขวา: Courses (ใช้ flex เต็มที่) ---
                const rightPanel = $("<div style='flex: 1; display: flex; flex-direction: column; min-width: 400px;'>").appendTo(wrapper);
                $("<h6 class='fw-bold mb-2 text-dark'>").text("Courses").appendTo(rightPanel);

                const $courseGrid = $("<div class='flex-grow-1 border rounded'>").appendTo(rightPanel);

                coursesGrid = $courseGrid.dxDataGrid({
                    dataSource: activeCoursesDataSource,
                    keyExpr: "id",
                    showBorders: false,
                    hoverStateEnabled: true,
                    rowAlternationEnabled: true,
                    filterRow: { visible: true },
                    headerFilter: { visible: true },
                    scrolling: { mode: "virtual" },
                    height: "100%",
                    columnAutoWidth: true,
                    selection: { mode: "multiple", showCheckBoxesMode: "always" },
                    columns: [
                        { dataField: "code", caption: "Course Code", width: 140, alignment: "center" },
                        { dataField: "title", caption: "Course Title", minWidth: 200 },
                        {
                            dataField: "type",
                            caption: "Type",
                            width: 120,
                            alignment: "center",
                            customizeText: function(cellInfo) {
                                if (cellInfo.value === 1) return "E-Learning";
                                if (cellInfo.value === 2) return "Classroom";
                                if (cellInfo.value === 3) return "Exam";
                                return cellInfo.value;
                            }
                        },
                        { dataField: "description", caption: "Description", visible: false }
                    ]
                }).dxDataGrid("instance");

                return container;
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Select Courses",
                        icon: "check",
                        type: "default",
                        stylingMode: "contained",
                        onClick: function() {
                            const selectedKeys = coursesGrid.getSelectedRowKeys();
                            criteriaForm.updateData("courseIds", selectedKeys);
                            coursesPopup.hide();
                        }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: { text: "Cancel", onClick: () => coursesPopup.hide() }
                }
            ],
            onShowing: function() {
                const currentCourseIds = criteriaForm.option("formData.courseIds") || [];
                if (coursesGrid) coursesGrid.selectRows(currentCourseIds, false);
                if (categoryGrid) {
                    categoryGrid.option("onSelectionChanged", null);
                    categoryGrid.clearSelection();
                    categoryGrid.option("onSelectionChanged", handleCategorySelection);
                }
            }
        }).dxPopup("instance");

        // --- 2. ปรับปรุง Employees Popup ---
        employeesPopup = $("#employees-popup").dxPopup({
            title: "Browse Employees",
            width: function() {
                return Math.min(window.innerWidth * 0.9, 1600);
            },
            height: function() {
                return Math.min(window.innerHeight * 0.85, 850);
            },
            maxWidth: 1600,
            maxHeight: 850,
            minWidth: 900,
            minHeight: 550,
            showCloseButton: true,
            dragEnabled: true,
            resizeEnabled: true, // เพิ่มความสามารถในการปรับขนาด
            contentTemplate: function(container) {
                const wrapper = $("<div class='d-flex h-100 gap-3'>").appendTo(container);

                // --- Panel ซ้าย: Employee Filters (ปรับเป็น % และกำหนด min/max) ---
                const leftPanel = $("<div style='width: 28%; min-width: 280px; max-width: 380px; display: flex; flex-direction: column;'>").appendTo(wrapper);
                $("<h6 class='fw-bold mb-3 text-dark'>").text("Employee Filters").appendTo(leftPanel);

                const filterFormDiv = $("<div>").appendTo(leftPanel);
                const empFilterForm = filterFormDiv.dxForm({
                    formData: { division: null, department: null },
                    labelMode: "floating",
                    items: [
                        {
                            dataField: "division",
                            label: { text: "Division" },
                            editorType: "dxSelectBox",
                            editorOptions: {
                                dataSource: divisionDataSource,
                                displayExpr: "Name", valueExpr: "Name",
                                showClearButton: true, searchEnabled: true,
                                onValueChanged: function(e) {
                                    if (e.value) departmentDataSource.filter(["Division", "=", e.value]);
                                    else departmentDataSource.filter(null);
                                    departmentDataSource.load();
                                    empFilterForm.updateData("department", null);
                                }
                            }
                        },
                        {
                            dataField: "department",
                            label: { text: "Department" },
                            editorType: "dxSelectBox",
                            editorOptions: {
                                dataSource: departmentDataSource,
                                displayExpr: "Name", valueExpr: "Name",
                                showClearButton: true, searchEnabled: true
                            }
                        },
                        {
                            itemType: "button",
                            horizontalAlignment: "right",
                            buttonOptions: {
                                text: "Search Employees",
                                icon: "search",
                                type: "default",
                                stylingMode: "contained",
                                width: "100%", // ปรับให้ปุ่มเต็มความกว้าง
                                onClick: function() {
                                    const filters = empFilterForm.option("formData");
                                    if (!filters.division) {
                                        DevExpress.ui.notify("Please select a Division.", "warning", 3000);
                                        return;
                                    }

                                    loadPanel.option("message", "Finding employees...");
                                    loadPanel.show();

                                    let apiUrl = `${serviceUrl}/Students/divisions?skip=0&take=500&divisions=${encodeURIComponent(filters.division)}`;
                                    $.ajax({
                                        url: apiUrl,
                                        method: "GET",
                                        xhrFields: { withCredentials: true },
                                        success: function(response) {
                                            let empData = response.data || [];
                                            if (filters.department) {
                                                empData = empData.filter(emp => emp.department === filters.department);
                                            }
                                            employeesGrid.option("dataSource", empData);
                                            DevExpress.ui.notify(`Found ${empData.length} employees`, "success", 2000);
                                        },
                                        error: function() {
                                            DevExpress.ui.notify("Failed to load employees data", "error", 3000);
                                        },
                                        complete: () => loadPanel.hide()
                                    });
                                }
                            }
                        }
                    ]
                }).dxForm("instance");

                // --- Panel ขวา: Employees Grid ---
                const rightPanel = $("<div style='flex: 1; display: flex; flex-direction: column; min-width: 500px;'>").appendTo(wrapper);
                $("<h6 class='fw-bold mb-2 text-dark'>").text("Employees").appendTo(rightPanel);

                const $empGrid = $("<div class='flex-grow-1 border rounded'>").appendTo(rightPanel);

                employeesGrid = $empGrid.dxDataGrid({
                    dataSource: [],
                    keyExpr: "eId",
                    showBorders: false,
                    rowAlternationEnabled: true,
                    hoverStateEnabled: true,
                    filterRow: { visible: true },
                    headerFilter: { visible: true },
                    scrolling: { mode: "virtual" },
                    height: "100%",
                    columnAutoWidth: true,
                    selection: { mode: "multiple", showCheckBoxesMode: "always", selectAllMode: "allPages" },
                    columns: [
                        { dataField: "eId", caption: "Emp ID", width: 90, alignment: "center" },
                        {
                            caption: "Employee Name",
                            minWidth: 180,
                            calculateCellValue: function(rowData) {
                                return rowData.englishFirstName + " " + rowData.englishLastName;
                            }
                        },
                        { dataField: "division", caption: "Division", width: 100, alignment: "center" },
                        { dataField: "department", caption: "Department", width: 130, alignment: "center" },
                        { dataField: "position", caption: "Position", minWidth: 150 }
                    ],
                    noDataText: "Select Division and click Search"
                }).dxDataGrid("instance");

                return container;
            },
            toolbarItems: [
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: {
                        text: "Select Employees",
                        icon: "check",
                        type: "default",
                        stylingMode: "contained",
                        onClick: function() {
                            const selectedRowsData = employeesGrid.getSelectedRowsData();
                            const selectedKeys = employeesGrid.getSelectedRowKeys();

                            selectedRowsData.forEach(row => {
                                if(!selectedEmployeesData.find(e => e.eId === row.eId)) {
                                    selectedEmployeesData.push(row);
                                }
                            });

                            let currentVals = criteriaForm.option("formData.employeeCodes") || [];
                            let newVals = [...new Set([...currentVals, ...selectedKeys])];

                            const tagBox = criteriaForm.getEditor("employeeCodes");
                            tagBox.option("dataSource", selectedEmployeesData);
                            criteriaForm.updateData("employeeCodes", newVals);

                            employeesPopup.hide();
                        }
                    }
                },
                {
                    widget: "dxButton",
                    toolbar: "bottom",
                    location: "after",
                    options: { text: "Cancel", onClick: () => employeesPopup.hide() }
                }
            ]
        }).dxPopup("instance");

            // --- 3. สร้าง Form หลัก สำหรับรับเงื่อนไข ---
            criteriaForm = $("#criteria-form").dxForm({
                formData: {
                    description: "",
                    startDate: new Date(),
                    courseIds: PRESELECTED_COURSE_ID ? [PRESELECTED_COURSE_ID] : [],
                    employeeCodes: []
                },
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        itemType: "group",
                        caption: "1. General Info",
                        items: [
                            { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 70 } }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "2. Target Courses",
                        items: [
                            {
                                dataField: "courseIds",
                                label: { text: "Selected Courses" },
                                editorType: "dxTagBox",
                                editorOptions: {
                                    dataSource: activeCoursesDataSource,
                                    valueExpr: "id",
                                    displayExpr: "code",
                                    placeholder: "Browse courses...",
                                    showClearButton: true,
                                    openOnFieldClick: false,
                                    buttons: [
                                        {
                                            name: "browse",
                                            location: "after",
                                            options: {
                                                icon: "search",
                                                hint: "Browse All Courses",
                                                onClick: () => coursesPopup.show()
                                            }
                                        },
                                        "clear"
                                    ]
                                },
                                validationRules: [{ type: "required", message: "Please select at least one course" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "3. Schedule",
                        colCount: 2,
                        items: [
                            { dataField: "startDate", label: { text: "Start Date" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" }, validationRules: [{ type: "required", message: "Start date is required" }] },
                            { dataField: "dueDate", label: { text: "Due Date" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" } }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "4. Target Employee",
                        items: [
                            {
                                dataField: "employeeCodes",
                                label: { text: "Selected Employees" },
                                editorType: "dxTagBox",
                                editorOptions: {
                                    dataSource: selectedEmployeesData,
                                    valueExpr: "eId",
                                    displayExpr: function(item) {
                                        return item ? `${item.eId} - ${item.englishFirstName} ${item.englishLastName}` : "";
                                    },
                                    placeholder: "Browse employees...",
                                    showClearButton: true,
                                    openOnFieldClick: false,
                                    buttons: [
                                        {
                                            name: "browse",
                                            location: "after",
                                            options: {
                                                icon: "search",
                                                hint: "Browse Employees",
                                                onClick: () => employeesPopup.show()
                                            }
                                        },
                                        "clear"
                                    ]
                                },
                                validationRules: [{ type: "required", message: "Please select at least one employee" }]
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- เมื่อกดปุ่ม ยืนยันการ Assign ---
            $("#btn-assign").dxButton({
                text: "Confirm & Assign",
                icon: "check",
                type: "default",
                stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 btn-primary" },
                onClick: function() {
                    const isFormValid = criteriaForm.validate().isValid;

                    if (!isFormValid) {
                        DevExpress.ui.notify("Please complete the required criteria.", "warning", 3000);
                        return;
                    }

                    const formData = criteriaForm.option("formData");

                    // หา division เพื่อส่งไป API (ดึงจากพนักงานคนแรกที่เลือก หรือปล่อยว่างถ้าเลือกผสม)
                    let assignDivision = "";
                    if (formData.employeeCodes && formData.employeeCodes.length > 0) {
                        const firstEmp = selectedEmployeesData.find(e => e.eId === formData.employeeCodes[0]);
                        if (firstEmp) assignDivision = firstEmp.division;
                    }

                    const payload = {
                        description: formData.description,
                        courseIds: formData.courseIds,
                        startDate: formData.startDate,
                        dueDate: formData.dueDate,
                        employeeCodes: formData.employeeCodes,
                        division: assignDivision
                    };

                    DevExpress.ui.dialog.confirm(
                        `Are you sure you want to assign <b>${formData.courseIds.length} course(s)</b> to <b>${formData.employeeCodes.length} employees</b>?`,
                        "Confirm Assignment"
                    ).done(function(dialogResult) {
                        if (dialogResult) executeBulkAssign(payload);
                    });
                }
            });

            function executeBulkAssign(payload) {
                loadPanel.option("message", "Assigning courses...");
                loadPanel.show();

                $.ajax({
                    url: `${serviceUrl}/Enrollments/BulkAssign`,
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    xhrFields: { withCredentials: true },
                    success: function(res) {
                        DevExpress.ui.notify("Courses assigned successfully!", "success", 3000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Enrollments")', 1500);
                    },
                    error: function(err) {
                        DevExpress.ui.notify("Error: " + (err.responseJSON?.message || "Failed to assign course"), "error", 4000);
                    },
                    complete: () => loadPanel.hide()
                });
            }
        });
    </script>
}