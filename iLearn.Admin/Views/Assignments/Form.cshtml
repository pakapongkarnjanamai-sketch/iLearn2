@{
    ViewBag.Title = "Bulk Course Assignments";
    var preselectedCourseId = Context.Request.Query["courseId"].ToString();
    var preselectedCourseIds = Context.Request.Query["courseIds"].ToString();
    var preselectedGroupId = Context.Request.Query["groupId"].ToString();
    var preselectedDescription = Context.Request.Query["description"].ToString();
}

<style>
    .target-col-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--text-secondary, #595959);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .target-mode-btn {
        background: var(--bg-secondary, #fafafa);
        border: 1px solid var(--border-color, #f0f0f0);
        color: var(--text-secondary, #8c8c8c);
        font-size: 11px;
        font-weight: 500;
        padding: 3px 12px;
        transition: all 0.15s;
    }
    .target-mode-btn:hover {
        border-color: var(--primary-color, #0050b3);
        color: var(--primary-color, #0050b3);
    }
    .target-mode-btn.active {
        background: var(--primary-color, #0050b3);
        border-color: var(--primary-color, #0050b3);
        color: #fff;
    }
</style>

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="page-title">Bulk Course Assignments</div>
        <div class="page-subtitle">Assign training courses to multiple students</div>
    </div>
    <a href="javascript:history.back();" class="action-link">
        <i class="fas fa-arrow-left text-secondary"></i> Back
    </a>
</div>

<div class="container page-shell-md px-4 py-4">
    <div id="load-panel"></div>

    <!-- ── Assignment Criteria ── -->
    <div class="border rounded bg-white p-3 mb-3">
        <div class="section-title">Assignment Criteria</div>
        <div id="form-assignment"></div>
    </div>

    <!-- ── Target Selection ── -->
    <div class="border rounded bg-white p-3">
        <div class="section-title">Target Selection</div>
        <div class="row g-3">
            <!-- Courses Column -->
            <div class="col-md-6 d-flex flex-column">
                <div class="d-flex align-items-center mb-2" style="min-height: 28px;">
                    <span class="target-col-label">
                        <i class="fas fa-book me-1"></i> Courses
                    </span>
                </div>
                <div class="target-card flex-grow-1 d-flex flex-column align-items-center justify-content-center" id="btn-select-courses">
                    <i class="fas fa-book fa-2x mb-2 target-card-icon"></i>
                    <div class="fw-bold text-dark mb-1 target-card-title">Select Courses</div>
                    <div class="text-secondary target-card-subtitle" id="selected-courses-text">No course selected</div>
                </div>
            </div>
            <!-- Students Column -->
            <div class="col-md-6 d-flex flex-column">
                <div class="d-flex align-items-center mb-2" style="min-height: 28px;">
                    <span class="target-col-label">
                        <i class="fas fa-user-graduate me-1"></i> Students
                    </span>
                    <div class="d-flex gap-1 ms-auto">
                        <button class="btn btn-sm rounded-pill target-mode-btn active" id="mode-individual"
                                onclick="switchTargetMode('individual')">
                            <i class="fas fa-user-graduate me-1"></i> Individual
                        </button>
                        <button class="btn btn-sm rounded-pill target-mode-btn" id="mode-group"
                                onclick="switchTargetMode('group')">
                            <i class="fas fa-users me-1"></i> Group
                        </button>
                    </div>
                </div>
                <!-- Individual card -->
                <div id="card-individual" class="flex-grow-1 d-flex">
                    <div class="target-card flex-grow-1 d-flex flex-column align-items-center justify-content-center" id="btn-select-employees">
                        <i class="fas fa-user-graduate fa-2x mb-2 target-card-icon"></i>
                        <div class="fw-bold text-dark mb-1 target-card-title">Select Students</div>
                        <div class="text-secondary target-card-subtitle" id="selected-employees-text">No student selected</div>
                    </div>
                </div>
                <!-- Group card -->
                <div id="card-group" class="d-none flex-grow-1 d-flex flex-column">
                    <div class="target-card flex-grow-1 d-flex flex-column align-items-center justify-content-center" id="btn-select-group">
                        <i class="fas fa-users fa-2x mb-2 target-card-icon"></i>
                        <div class="fw-bold text-dark mb-1 target-card-title">Select Student Group</div>
                        <div class="text-secondary target-card-subtitle" id="selected-group-text">No group selected</div>
                        <div id="group-reset-row" class="d-none mt-3">
                            <a href="javascript:void(0);" class="action-link text-danger small" id="btn-reset-group">
                                <i class="fas fa-times me-1"></i> Clear selection
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Fixed Bottom Toolbar ── -->
<div class="bottom-toolbar">
    <a href="javascript:history.back();" class="action-link">Cancel</a>
    <a href="javascript:void(0);" class="action-link primary" id="btn-save">
        <i class="fas fa-save"></i> Save &amp; Review
    </a>
</div>

<div id="courses-popup"></div>
<div id="employees-popup"></div>
<div id="groups-popup"></div>
<div id="summary-popup"></div>

@section Scripts {
    <script>
        const initialCourseId = '@preselectedCourseId';
        const initialCourseIds = '@preselectedCourseIds';
        const initialGroupId = '@preselectedGroupId';
        const initialDescription = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(preselectedDescription ?? ""))';
        const ASSIGNMENT_VALIDATE_URL = `${serviceUrl}/Assignments/validate-before-assign`;
        const ASSIGNMENT_LOOKUP_COURSES_URL = `${serviceUrl}/Assignments/lookup-courses`;
        const BULK_ASSIGN_URL = `${serviceUrl}/Enrollments/BulkAssign`;
        const ASSIGNMENT_DETAIL_URL = `@Url.Action("Detail", "Assignments")`;
        const EMPTY_TEXT = "—";

        let selectedCourseIds = initialCourseIds
            ? initialCourseIds.split(',').map(id => parseInt(id, 10)).filter(id => !isNaN(id))
            : initialCourseId ? [parseInt(initialCourseId, 10)] : [];
        let selectedStudentCodes = [];
        let selectedGroupId = null;
        let selectedGroupName = null;
        let selectedGroupMemberCount = 0;
        let currentTargetMode = 'individual'; // 'individual' or 'group'
        let currentPayload = null;

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)", position: { of: "body" }, visible: false, shading: true
            }).dxLoadPanel("instance");

            // อัปเดต UI ทันทีหากมีการแนบ courseId มาจากหน้า Dashboard
            if (selectedCourseIds.length > 0) {
                updateCardUI("#btn-select-courses", "#selected-courses-text", selectedCourseIds.length, "course");
            }

            // --- Main Form ---
            const form = $("#form-assignment").dxForm({
                labelMode: "floating",
                formData: { description: initialDescription || "", startDate: null, dueDate: null },
                items: [
                    { dataField: "description", editorType: "dxTextArea", editorOptions: { height: 120 }, validationRules: [{ type: "required", message: "Required" }] },
                    { itemType: "group", colCount: 2, items: [
                        { dataField: "startDate", editorType: "dxDateBox", editorOptions: { width: "100%", displayFormat: ADMIN_DATE_DISPLAY_FORMAT }, validationRules: [{ type: "required", message: "Required" }] },
                        { dataField: "dueDate", editorType: "dxDateBox", editorOptions: { width: "100%", displayFormat: ADMIN_DATE_DISPLAY_FORMAT }, validationRules: [{ type: "required", message: "Required" }] }
                    ]}

                ]
            }).dxForm("instance");

            // --- Courses Popup ---
            const coursesPopup = $("#courses-popup").dxPopup({
                title: "Select Courses", width: "90vw", maxWidth: 1100, height: "85vh",
                showCloseButton: true, dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    const g = $("#grid-courses").dxDataGrid("instance");
                    if (g) g.updateDimensions();
                },
                contentTemplate: function(contentElement) {
                    $(`

                        <div class="d-flex h-100 gap-3">
                            <div class="sidebar-260">
                                <div class="filter-panel h-100 d-flex flex-column gap-3">
                                    <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Course Type</label>
                                        <div id="filter-course-type"></div>
                                    </div>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                        <div id="filter-course-div"></div>
                                    </div>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Category</label>
                                        <div id="filter-course-cat"></div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="btn-clear-course-filter">
                                        <i class="fas fa-times me-1"></i> Clear Filters
                                    </button>
                                </div>
                            </div>
                            <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                                <div id="grid-courses" class="flex-grow-1"></div>
                            </div>
                        </div>
                    `).appendTo(contentElement);

                    // ── DataStore สำหรับ grid ──
                    let allCoursesData = [];
                    const coursesLocalStore = new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData });

                    const courseGrid = initDxGrid("#grid-courses", {
                        preset: "selectionGrid",
                        dataSource: new DevExpress.data.DataSource({ store: coursesLocalStore }),
                        filterRow: { visible: true },
                        searchPanel: { placeholder: "Search code or title..." },
                        noDataText: getNoDataText("courses"),
                        columns: [
                            {
                                dataField: "code", caption: "Code", width: 110,
                                cellTemplate: function(container, options) {
                                    $('<span>').addClass('tag-pill pill-default fw-bold').text(options.value).appendTo(container);
                                }
                            },
                            { dataField: "title", caption: "Course Title", minWidth: 180 },
                            {
                                dataField: "courseTypeName", caption: "Type", width: 130, alignment: "center",
                                cellTemplate: function(container, options) {
                                    if (!options.value) {
                                        return;
                                    }

                                    $('<span>').addClass('tag-pill pill-info').text(options.value).appendTo(container);
                                }
                            }
                        ],
                        selectedRowKeys: selectedCourseIds,
                        onSelectionChanged: function(e) {
                            selectedCourseIds = e.selectedRowKeys;
                            updateCardUI("#btn-select-courses", "#selected-courses-text", selectedCourseIds.length, "course");
                            setSelectionHint("#course-selection-hint", selectedCourseIds.length, "course", "you want to assign");
                        }
                    });

                    $.ajax({
                        url: ASSIGNMENT_LOOKUP_COURSES_URL,
                        method: "GET", xhrFields: { withCredentials: true }
                    }).done(function(res) {
                        allCoursesData = res.data || [];
                        courseGrid.option("dataSource", new DevExpress.data.DataSource({
                            store: new DevExpress.data.ArrayStore({ key: "id", data: allCoursesData })
                        }));
                        courseGrid.option("selectedRowKeys", selectedCourseIds);
                    });

                    function applyFilters() {
                        const typeVal = $("#filter-course-type").dxSelectBox("instance").option("value");
                        const divVal  = $("#filter-course-div").dxSelectBox("instance").option("value");
                        const catVal  = $("#filter-course-cat").dxSelectBox("instance").option("value");

                        const conditions = [];
                        if (typeVal) conditions.push(["courseTypeId", "=", typeVal]);
                        if (divVal)  conditions.push(["divisionId",   "=", divVal]);
                        if (catVal)  conditions.push(["categoryId",   "=", catVal]);

                        applyCombinedFilter(courseGrid, conditions);
                    }

                    // ── Filter: Course Type ──
                    $("#filter-course-type").dxSelectBox({
                        dataSource: createDataStore(serviceUrl, 'admin/CourseTypesCRUD', { key: 'id' }),
                        displayExpr: "name", valueExpr: "id",
                        placeholder: "All Types", showClearButton: true,
                        onValueChanged: applyFilters
                    });

                    // ── Filter: Division ──
                    $("#filter-course-div").dxSelectBox({
                        dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' }),
                        displayExpr: "name", valueExpr: "id",
                        placeholder: "All Divisions", showClearButton: true,
                        onValueChanged: function(e) {
                            const catBox = $("#filter-course-cat").dxSelectBox("instance");
                            catBox.option("value", null);
                            if (e.value) {
                                catBox.option("dataSource", createDataStore(serviceUrl, 'admin/CategoriesCRUD', {
                                    key: 'id', action: 'Get', filter: ["divisionId", "=", e.value]
                                }));
                                catBox.option("disabled", false);
                            } else {
                                catBox.option("dataSource", []);
                                catBox.option("disabled", true);
                            }
                            applyFilters();
                        }
                    });

                    // ── Filter: Category ──
                    $("#filter-course-cat").dxSelectBox({
                        displayExpr: "name", valueExpr: "id",
                        placeholder: "All Categories", showClearButton: true,
                        disabled: true,
                        onValueChanged: applyFilters
                    });

                    // ── Clear ──
                    $("#btn-clear-course-filter").click(function() {
                        $("#filter-course-type").dxSelectBox("instance").option("value", null);
                        $("#filter-course-div").dxSelectBox("instance").option("value", null);
                        $("#filter-course-cat").dxSelectBox("instance").option({ value: null, disabled: true, dataSource: [] });
                        courseGrid.clearFilter();
                    });
                },
                //  ปรับแต่ง Toolbar ซ้าย-ขวา 
                toolbarItems: [
                    {
                        toolbar: "bottom",
                        location: "before",
                        template: function() {
                            return createSelectionHintElement("course-selection-hint", "course", "you want to assign");
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Done", type: "default", stylingMode: "contained",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: () => coursesPopup.hide()
                        }
                    }
                ]
            }).dxPopup("instance");

            // --- Students Popup ---
            const employeesPopup = $("#employees-popup").dxPopup({
                title: "Select Employees", width: "90vw", maxWidth: 1280, height: "85vh",
                showCloseButton: true, dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    const g = $("#grid-students").dxDataGrid("instance");
                    if (g) g.updateDimensions();
                },
                contentTemplate: function(contentElement) {
                    $(`

                        <div class="d-flex h-100 gap-3">
                            <div class="sidebar-240">
                                <div class="filter-panel h-100 d-flex flex-column gap-3">
                                    <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2"></i>Filters</h6>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                                        <div id="filter-emp-div"></div>
                                    </div>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Department</label>
                                        <div id="filter-emp-dept"></div>
                                    </div>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Section</label>
                                        <div id="filter-emp-section"></div>
                                    </div>
                                    <div>
                                        <label class="small fw-bold text-muted mb-1 d-block">Position</label>
                                        <div id="filter-emp-position"></div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-secondary w-100 mt-auto" id="btn-clear-emp-filter">
                                        <i class="fas fa-times me-1"></i> Clear Filters
                                    </button>
                                </div>
                            </div>
                            <div class="flex-grow-1 d-flex flex-column u-min-w-0">
                                <div id="grid-students" class="flex-grow-1"></div>
                            </div>
                        </div>
                    `).appendTo(contentElement);

                    const empGrid = initDxGrid("#grid-students", {
                        preset: "selectionGrid",
                        dataSource: DevExpress.data.AspNet.createStore({
                            key: "EId",
                            loadUrl: `${serviceUrl}/Students/Get`,
                            onBeforeSend: function(method, ajaxOptions) {
                                ajaxOptions.xhrFields = { withCredentials: true };
                            }
                        }),
                        remoteOperations: true,
                        filterRow: { visible: true },
                        searchPanel: { placeholder: "Search ID or name..." },
                        noDataText: getNoDataText("students"),
                        columns: [
                            {
                                dataField: "EId", caption: "ID", width: 95,
                                cellTemplate: function(container, options) {
                                    $('<span>').addClass('tag-pill pill-default fw-bold').text(options.value).appendTo(container);
                                }
                            },
                            {
                                caption: "Name", minWidth: 160,
                                calculateCellValue: (d) => [d.EnglishFirstName, d.EnglishLastName].filter(Boolean).join(" "),
                                cellTemplate: function(container, options) {
                                    $("<span>").addClass("fw-medium text-dark").text(options.value).appendTo(container);
                                }
                            },
                            {
                                dataField: "Position", caption: "Position", width: 90, alignment: "center",
                                cellTemplate: function(container, options) {
                                    if (!options.value) {
                                        return;
                                    }

                                    $('<span>').addClass('tag-pill pill-default').text(options.value).appendTo(container);
                                }
                            },
                            { dataField: "Department", caption: "Dept.", width: 90 },
                            { dataField: "Section", caption: "Section", minWidth: 120,
                                cellTemplate: function(container, options) {
                                    $("<span>").addClass("text-muted small").text(options.value || EMPTY_TEXT).appendTo(container);
                                }
                            }
                        ],
                        selectedRowKeys: selectedStudentCodes,
                        onSelectionChanged: function(e) {
                            selectedStudentCodes = e.selectedRowKeys;
                            updateCardUI("#btn-select-employees", "#selected-employees-text", selectedStudentCodes.length, "student");
                            setSelectionHint("#emp-selection-hint", selectedStudentCodes.length, "student", "you want to assign");
                        }
                    });

                    function buildEmpFilterQuery() {
                        const filters = [];
                        const divVal  = $("#filter-emp-div").dxSelectBox("instance").option("value");
                        const deptVal = $("#filter-emp-dept").dxSelectBox("instance").option("value");
                        const secVal  = $("#filter-emp-section").dxSelectBox("instance").option("value");
                        const posVals = $("#filter-emp-position").dxTagBox("instance").option("value") || [];

                        if (divVal)  filters.push(["Division",   "=", divVal]);
                        if (deptVal) filters.push(["Department", "=", deptVal]);
                        if (secVal)  filters.push(["Section",    "=", secVal]);
                        if (posVals.length > 0) {
                            let posFilter = ["Position", "=", posVals[0]];
                            for (let i = 1; i < posVals.length; i++) {
                                posFilter = [posFilter, "or", ["Position", "=", posVals[i]]];
                            }
                            filters.push(posFilter);
                        }

                        applyCombinedFilter(empGrid, filters);
                    }

                    function makeEmpLookupStore(endpoint, extraQuery) {
                        return new DevExpress.data.CustomStore({
                            key: "Name",
                            load: () => $.ajax({
                                url: `${serviceUrl}/Students/${endpoint}${extraQuery || ""}`,
                                method: "GET", xhrFields: { withCredentials: true }
                            }).then(res => res.data || res)
                        });
                    }

                    // ── Filter: Division ──
                    const empDivBox = $("#filter-emp-div").dxSelectBox({
                        dataSource: makeEmpLookupStore("GetDivisions", ""),
                        displayExpr: "Name", valueExpr: "Name",
                        placeholder: "All Divisions", showClearButton: true,
                        onValueChanged: function(e) {
                            const deptBox    = $("#filter-emp-dept").dxSelectBox("instance");
                            const sectionBox = $("#filter-emp-section").dxSelectBox("instance");
                            deptBox.option({ value: null, disabled: !e.value, dataSource: e.value
                                ? makeEmpLookupStore("GetDepartments", `?filter=["Division","=","${e.value}"]`)
                                : [] });
                            sectionBox.option({ value: null, disabled: true, dataSource: [] });
                            buildEmpFilterQuery();
                        }
                    }).dxSelectBox("instance");

                    // ── Filter: Department ──
                    const empDeptBox = $("#filter-emp-dept").dxSelectBox({
                        displayExpr: "Name", valueExpr: "Name",
                        placeholder: "All Departments", showClearButton: true, disabled: true,
                        onValueChanged: function(e) {
                            const sectionBox = $("#filter-emp-section").dxSelectBox("instance");
                            const divVal = empDivBox.option("value");
                            const q = e.value
                                ? `?filter=[["Division","=","${divVal}"],"and",["Department","=","${e.value}"]]`
                                : (divVal ? `?filter=["Division","=","${divVal}"]` : "");
                            sectionBox.option({ value: null, disabled: !e.value, dataSource: e.value
                                ? makeEmpLookupStore("GetSections", q)
                                : [] });
                            buildEmpFilterQuery();
                        }
                    }).dxSelectBox("instance");

                    // ── Filter: Section ──
                    const empSectionBox = $("#filter-emp-section").dxSelectBox({
                        displayExpr: "Name", valueExpr: "Name",
                        placeholder: "All Sections", showClearButton: true, disabled: true,
                        onValueChanged: buildEmpFilterQuery
                    }).dxSelectBox("instance");

                    // ── Filter: Position (multi-select) ──
                    $("#filter-emp-position").dxTagBox({
                        dataSource: makeEmpLookupStore("GetPositions", ""),
                        displayExpr: "Name", valueExpr: "Name",
                        placeholder: "All Positions",
                        showClearButton: true,
                        showSelectionControls: true,
                        applyValueMode: "useButtons",
                        onValueChanged: buildEmpFilterQuery
                    });

                    // ── Clear all filters ──
                    $("#btn-clear-emp-filter").click(function() {
                        empDivBox.option("value", null);
                        empDeptBox.option({ value: null, disabled: true, dataSource: [] });
                        empSectionBox.option({ value: null, disabled: true, dataSource: [] });
                        $("#filter-emp-position").dxTagBox("instance").option("value", []);
                        empGrid.clearFilter();
                    });
                },
                // 🌟 ปรับแต่ง Toolbar ซ้าย-ขวา 🌟
                toolbarItems: [
                    {
                        toolbar: "bottom",
                        location: "before",
                        template: function() {
                            return createSelectionHintElement("emp-selection-hint", "student", "you want to assign");
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Done", type: "default", stylingMode: "contained",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: () => employeesPopup.hide()
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-select-courses").click(() => coursesPopup.show());
            $("#btn-select-employees").click(() => employeesPopup.show());

            // --- Groups Popup ---
            const groupsPopup = $("#groups-popup").dxPopup({
                title: "Select Student Group", width: "70vw", maxWidth: 900, height: "70vh",
                showCloseButton: true, dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                onShown: function() {
                    const g = $("#grid-groups").dxDataGrid("instance");
                    if (g) g.updateDimensions();
                },
                contentTemplate: function(contentElement) {
                    $('<div id="grid-groups" class="h-100"></div>').appendTo(contentElement);

                    initDxGrid("#grid-groups", {
                        dataSource: {
                            store: new DevExpress.data.CustomStore({
                                key: "id",
                                load: () => $.ajax({
                                    url: `${serviceUrl}/StudentGroups`,
                                    method: "GET",
                                    xhrFields: { withCredentials: true }
                                }).then(res => res.data || [])
                            })
                        },
                        filterRow: { visible: true },
                        searchPanel: { placeholder: "Search group name..." },
                        noDataText: getNoDataText("student groups"),
                        selection: { mode: "single" },
                        columns: [
                            { dataField: "name", caption: "Group Name", minWidth: 200,
                                cellTemplate: function(container, options) {
                                    $('<span>').addClass('fw-medium text-dark').text(options.value).appendTo(container);
                                }
                            },
                            { dataField: "description", caption: "Description", minWidth: 200,
                                cellTemplate: function(container, options) {
                                    $('<span>').addClass('text-muted small').text(options.value || EMPTY_TEXT).appendTo(container);
                                }
                            },
                            { dataField: "memberCount", caption: "Members", width: 100, alignment: "center",
                                cellTemplate: function(container, options) {
                                    $('<span>').addClass('tag-pill pill-info fw-bold').text(options.value || 0).appendTo(container);
                                }
                            }
                        ],
                        onRowDblClick: function(e) {
                            selectGroup(e.data);
                            groupsPopup.hide();
                        }
                    });
                },
                toolbarItems: [
                    {
                        toolbar: "bottom",
                        location: "before",
                        template: function() {
                            return $('<span class="text-muted small"><i class="fas fa-info-circle me-1"></i>Double-click a row to select</span>');
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Done", type: "default", stylingMode: "contained",
                            elementAttr: { class: "rounded-3 fw-medium px-4 shadow-sm" },
                            onClick: function() {
                                const grid = $("#grid-groups").dxDataGrid("instance");
                                const rows = grid.getSelectedRowsData();
                                if (rows.length > 0) {
                                    selectGroup(rows[0]);
                                }
                                groupsPopup.hide();
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            $("#btn-select-group").click(() => groupsPopup.show());
            $("#btn-reset-group").click(() => clearGroupSelection());

            // --- Target Mode Toggle ---
            window.switchTargetMode = function(mode) {
                currentTargetMode = mode;
                $(".target-mode-btn").removeClass("active");
                $(`#mode-${mode}`).addClass("active");
                if (mode === 'individual') {
                    $("#card-individual").removeClass("d-none");
                    $("#card-group").addClass("d-none");
                } else {
                    $("#card-individual").addClass("d-none");
                    $("#card-group").removeClass("d-none");
                }
            };

            function selectGroup(group) {
                selectedGroupId = group.id;
                selectedGroupName = group.name;
                selectedGroupMemberCount = group.memberCount || 0;
                updateGroupCardUI();
            }

            function clearGroupSelection() {
                selectedGroupId = null;
                selectedGroupName = null;
                selectedGroupMemberCount = 0;
                updateGroupCardUI();
            }

            function updateGroupCardUI() {
                if (selectedGroupId) {
                    $("#selected-group-text")
                        .text(`${selectedGroupName} (${window.formatAdminCountLabel(selectedGroupMemberCount, 'member')})`)
                        .removeClass("text-muted").addClass("text-success fw-bold");
                    $("#btn-select-group").css({"border-color": "#2da44e", "background-color": "#f0fdf4"});
                    $("#group-reset-row").removeClass("d-none");
                } else {
                    $("#selected-group-text")
                        .text("No group selected")
                        .removeClass("text-success fw-bold").addClass("text-muted fw-medium");
                    $("#btn-select-group").css({"border-color": "", "background-color": ""});
                    $("#group-reset-row").addClass("d-none");
                }
            }

            // Pre-select group if groupId is passed via query string
            if (initialGroupId) {
                switchTargetMode('group');
                $.ajax({
                    url: `${serviceUrl}/StudentGroups/${initialGroupId}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    if (res.data) {
                        selectGroup({
                            id: res.data.id,
                            name: res.data.name,
                            memberCount: (res.data.members || []).length
                        });
                    }
                });
            }

            function updateCardUI(cardId, textId, count, itemName) {
                if (count > 0) {
                    $(textId).text(`${window.formatAdminCountLabel(count, itemName)} selected`).removeClass("text-muted").addClass("text-success fw-bold");
                    $(cardId).css({"border-color": "#2da44e", "background-color": "#f0fdf4"});
                } else {
                    $(textId).text(`No ${itemName} selected`).removeClass("text-success fw-bold").addClass("text-muted fw-medium");
                    $(cardId).css({"border-color": "", "background-color": ""});
                }
            }

            function applyCombinedFilter(grid, conditions) {
                if (conditions.length === 0) {
                    grid.clearFilter();
                    return;
                }

                let combined = conditions[0];
                for (let i = 1; i < conditions.length; i += 1) {
                    combined = [combined, "and", conditions[i]];
                }

                grid.filter(combined);
            }

            function getApiErrorMessage(error, fallbackMessage) {
                return error?.responseJSON?.message || error?.statusText || fallbackMessage;
            }

            function createConflictListHtml(conflicts, alertClass, iconClass, title, itemRenderer, footer) {
                if (conflicts.length === 0) {
                    return "";
                }

                const items = conflicts.map(itemRenderer).join("");
                return `
                    <div class="alert border-${alertClass} bg-${alertClass} bg-opacity-10 mt-3 rounded-4 p-3">
                        <h6 class="text-${alertClass}-emphasis fw-bold mb-3">
                            <i class="fas ${iconClass} me-2"></i>
                            ${title} (${window.formatAdminCountLabel(conflicts.length, 'item')})
                        </h6>
                        <ul class="mb-0 small list-unstyled u-maxh-150 u-overflow-y-auto">${items}</ul>
                        <div class="mt-2 pt-2 border-top border-${alertClass} border-opacity-25 small text-muted">${footer}</div>
                    </div>`;
            }

            const summaryPopup = $("#summary-popup").dxPopup({
                title: "Assignment Summary",
                width: 780,
                height: "auto",
                maxHeight: window.innerHeight * 0.85,
                showCloseButton: true,
                dragEnabled: true,
                deferRendering: false,
                wrapperAttr: { class: "shadow-lg rounded-4" },
                contentTemplate: function(contentElement) {
                    contentElement.append($("<div id='summary-content'></div>"));
                },
                toolbarItems: [
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: { text: "Cancel", stylingMode: "outlined", onClick: () => summaryPopup.hide() }
                    },
                    {
                        widget: "dxButton", toolbar: "bottom", location: "after",
                        options: {
                            text: "Confirm & Assign", type: "default", stylingMode: "contained",
                            elementAttr: { class: "btn-primary shadow-sm rounded-3 px-3 fw-medium" },
                            onClick: () => {
                                currentPayload.confirmReassignInProgress = (currentPayload.inProgressConflicts || []).length > 0;
                                currentPayload.confirmReassignCompleted = (currentPayload.completedConflicts || []).length > 0;
                                summaryPopup.hide();
                                executeBulkAssign(currentPayload);
                            }
                        }
                    }
                ]
            }).dxPopup("instance");

            function showSummaryDialog(res, payload) {
                currentPayload = payload;
                const inProgress = res.inProgressConflicts || [];
                const completed  = res.completedConflicts  || [];
                const resolvedCount = res.resolvedCount || payload.employeeCodes.length || selectedGroupMemberCount || 0;
                currentPayload.inProgressConflicts = inProgress;
                currentPayload.completedConflicts = completed;

                // --- Format dates ---
                const fmtDate = (d) => window.formatAdminDate(d, '—');
                const totalEnrollments = payload.courseIds.length * resolvedCount;

                // --- Assignment Details ---
                const detailsHtml = `
                    <div class="border rounded p-3 mb-3" style="background: var(--bg-light, #fafafa);">
                        <div class="row g-2 align-items-start">
                            <div class="col-md-7">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Description</div>
                                <div class="text-dark small">${payload.description || '<span class="text-muted fst-italic">—</span>'}</div>
                            </div>
                            <div class="col-md-5">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Period</div>
                                <div class="text-dark small">
                                    <i class="fas fa-calendar-alt text-muted me-1"></i>
                                    ${fmtDate(payload.startDate)} — ${fmtDate(payload.dueDate)}
                                </div>
                            </div>
                        </div>
                    </div>`;

                // --- Stat Metrics ---
                const targetLabel = payload.groupId
                          ? `<div class="text-dark fw-bold">${window.formatAdminInteger(resolvedCount, '0')}</div>
                       <div class="text-muted small mt-1" style="font-size: 10px;">${selectedGroupName || 'Group'}</div>`
                          : `<div class="text-dark fw-bold">${window.formatAdminInteger(resolvedCount, '0')}</div>`;

                const statsHtml = `
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="border rounded p-2 text-center" style="background: #fff;">
                                <div class="text-muted small text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Courses</div>
                                <div class="fs-4 fw-bold text-primary mt-1">${payload.courseIds.length}</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2 text-center" style="background: #fff;">
                                <div class="text-muted small text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">
                                    ${payload.groupId ? '<i class="fas fa-users me-1"></i>Students' : '<i class="fas fa-user-graduate me-1"></i>Students'}
                                </div>
                                <div class="fs-4 mt-1">${targetLabel}</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-2 text-center" style="background: #fff;">
                                <div class="text-muted small text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Enrollments</div>
                                <div class="fs-4 fw-bold mt-1" style="color: var(--brand-color, #0050b3);">${totalEnrollments}</div>
                            </div>
                        </div>
                    </div>`;

                // --- Conflict sections ---
                const inProgressHtml = createConflictListHtml(
                    inProgress,
                    "warning",
                    "fa-exclamation-triangle",
                    "In-Progress — will be reset",
                    c => `
                        <li class="mb-2 pb-2 border-bottom border-warning border-opacity-25">
                            <span class="tag-pill pill-default fw-bold">${c.studentCode}</span>
                            <span class="text-muted mx-1">→</span>
                            <span class="fw-medium">${c.courseTitle}</span>
                        </li>`,
                    '<i class="fas fa-info-circle me-1"></i>Progress will be <b>reset</b> and students will start over.'
                );

                const completedHtml = createConflictListHtml(
                    completed,
                    "info",
                    "fa-redo",
                    "Already Completed — will re-assign",
                    c => {
                        const dateStr = c.completedDate
                            ? window.formatAdminDate(c.completedDate, '—')
                            : '—';
                        return `
                        <li class="mb-2 pb-2 border-bottom border-info border-opacity-25">
                            <span class="tag-pill pill-default fw-bold">${c.studentCode}</span>
                            <span class="text-muted mx-1">→</span>
                            <span class="fw-medium">${c.courseTitle}</span>
                            <span class="text-muted small ms-2"><i class="fas fa-check-circle me-1"></i>${dateStr}</span>
                        </li>`;
                    },
                    '<i class="fas fa-info-circle me-1"></i>Previous records are kept in history. Students will be <b>re-enrolled</b>.'
                );

                let allClearHtml = "";
                if (inProgress.length === 0 && completed.length === 0) {
                    allClearHtml = `
                        <div class="border rounded text-center py-4 mt-1" style="background: #f6ffed; border-color: #b7eb8f !important;">
                            <i class="fas fa-check-circle fa-2x mb-2" style="color: #52c41a;"></i>
                            <div class="fw-bold text-dark" style="font-size: 13px;">No conflicts found</div>
                            <div class="text-muted small">Ready to proceed.</div>
                        </div>`;
                }

                const html = `
                    <div class="px-1">
                        ${detailsHtml}
                        ${statsHtml}
                        ${inProgressHtml}
                        ${completedHtml}
                        ${allClearHtml}
                    </div>
                `;

                $("#summary-content").html(html);
                summaryPopup.show();
            }

            $('#btn-save').click(async function () {
                if (!form.validate().isValid) {
                    return;
                }

                if (selectedCourseIds.length === 0) {
                    showToast("Please select at least one course.", "error");
                    return;
                }

                if (currentTargetMode === 'individual' && selectedStudentCodes.length === 0) {
                    showToast("Please select at least one student.", "error");
                    return;
                }

                if (currentTargetMode === 'group' && !selectedGroupId) {
                    showToast("Please select a student group.", "error");
                    return;
                }

                const isGroupMode = currentTargetMode === 'group';
                const formData = form.option('formData');
                const payload = {
                    courseIds: selectedCourseIds,
                    employeeCodes: isGroupMode ? [] : selectedStudentCodes,
                    groupId: isGroupMode ? selectedGroupId : null,
                    startDate: formData.startDate,
                    dueDate: formData.dueDate,
                    description: formData.description,
                    confirmReassignInProgress: false,
                    confirmReassignCompleted: false
                };

                loadPanel.option("message", "Validating data...");
                loadPanel.show();

                try {
                    const response = await $.ajax({
                        url: ASSIGNMENT_VALIDATE_URL,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });

                    loadPanel.hide();
                    showSummaryDialog(response, payload);
                } catch {
                    loadPanel.hide();
                    showToast("Error connecting to validation service.", "error");
                }
            });

            async function executeBulkAssign(payload) {
                loadPanel.option("message", "Assigning courses...");
                loadPanel.show();

                try {
                    const response = await $.ajax({
                        url: BULK_ASSIGN_URL,
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });

                        showToast("Assigned successfully!", "success", 2000);
                        setTimeout(() => window.location.href = `${ASSIGNMENT_DETAIL_URL}/${response.assignmentId}`, 1500);
                } catch (err) {
                    showToast(`Error: ${getApiErrorMessage(err, "Failed to assign")}`, "error", 4000);
                    loadPanel.hide();
                }
            }
        });
    </script>
}