@{
    ViewBag.Title = "Bulk Course Assignments";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-users-cog"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Assign training courses to multiple employees based on specific criteria.
                    </div>
                </div>
            </h1>
            <div>
                <button id="btn-cancel-top" class="btn btn-light border shadow-sm rounded px-3" onclick="history.back()">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-5">
    <div id="load-panel"></div>

    <div id="courses-popup"></div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                        <i class="fas fa-filter text-primary"></i> Assignment Criteria
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div id="criteria-form"></div>

                    <hr class="my-4" />

                    <button id="btn-search-emp" class="btn btn-primary w-100 shadow-sm" style="padding: 10px;">
                        <i class="fas fa-search me-2"></i> Find Employees
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 1.1rem;">
                        <i class="fas fa-list text-primary"></i> Target Employees
                    </h5>
                    <span class="badge bg-primary px-3 py-2 rounded-pill shadow-sm" id="selected-count" style="font-size: 0.9rem;">
                        0 Selected
                    </span>
                </div>
                <div class="card-body p-0">
                    <div id="employees-grid"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="fixed-bottom bg-white shadow-lg py-3 border-top" style="z-index: 100;">
        <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                <i class="fas fa-info-circle me-1"></i> Please review selected employees before assigning the courses.
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light border px-4 shadow-sm" onclick="history.back()">Cancel</button>
                <div id="btn-assign"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const PRESELECTED_COURSE_ID = @(ViewBag.CourseId ?? "null");

        // ---------------------------------------------------------
        // 1. Data Sources สำหรับฝั่งหลักสูตร (Courses)
        // ---------------------------------------------------------

        const courseDivisionStore = createDataStore(serviceUrl, 'admin/DivisionsCRUD', { key: 'id' });

        const courseCategoryDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "id",
                loadUrl: `${serviceUrl}/admin/CategoriesCRUD/Get`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "name"
        });

        const activeCoursesDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "id",
                loadUrl: `${serviceUrl}/admin/CoursesCRUD/GetActive`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "code"
        });

        // ---------------------------------------------------------
        // 2. Data Sources สำหรับฝั่งพนักงาน (Employees)
        // ---------------------------------------------------------

        const divisionDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "Name",
                loadUrl: `${serviceUrl}/Students/GetDivisions`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "Name"
        });

        const departmentDataSource = new DevExpress.data.DataSource({
            store: DevExpress.data.AspNet.createStore({
                key: "Name",
                loadUrl: `${serviceUrl}/Students/GetDepartments`,
                onBeforeSend: function(method, ajaxOptions) {
                    ajaxOptions.xhrFields = { withCredentials: true };
                }
            }),
            sort: "Name"
        });


        // ---------------------------------------------------------
        // 3. UI Components Logic
        // ---------------------------------------------------------

        let criteriaForm;
        let employeesGrid;
        let coursesGrid;
        let coursesPopup;

        // ฟังก์ชันอัปเดตตัวกรองสำหรับหลักสูตร
        function updateCourseFilter() {
            const divId = criteriaForm.option("formData.courseDivisionId");
            const catId = criteriaForm.option("formData.courseCategoryId");

            const filters = [];
            if (catId) {
                filters.push(["categoryId", "=", catId]);
            } else if (divId) {
                filters.push(["category.divisionId", "=", divId]);
            }

            if (filters.length > 0) {
                activeCoursesDataSource.filter(filters);
            } else {
                activeCoursesDataSource.filter(null);
            }

            activeCoursesDataSource.load();

            if (coursesGrid) {
                coursesGrid.refresh();
            }
        }

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: false,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Processing..."
            }).dxLoadPanel("instance");

            // --- สร้าง Popup สำหรับเลือก Courses ---
            coursesPopup = $("#courses-popup").dxPopup({
                title: "Browse Active Courses",
                width: 1000,
                height: 650,
                showCloseButton: true,
                dragEnabled: true,
                contentTemplate: function(container) {
                    const $grid = $("<div>").appendTo(container);
                    coursesGrid = $grid.dxDataGrid({
                        dataSource: activeCoursesDataSource,
                        keyExpr: "id",
                        showBorders: true,
                        hoverStateEnabled: true,
                        rowAlternationEnabled: true,
                        filterRow: { visible: true },
                        headerFilter: { visible: true },
                        scrolling: { mode: "virtual" },
                        height: "100%",
                        selection: { mode: "multiple", showCheckBoxesMode: "always" },
                        columns: [
                            { dataField: "code", caption: "Course Code", width: 180, alignment: "center" },
                            { dataField: "title", caption: "Course Title" },
                            { dataField: "category.name", caption: "Category" },
                            { dataField: "category.division.name", caption: "Division", alignment: "center", width: 120 },
                            { dataField: "description", caption: "Description", visible: false }
                        ]
                    }).dxDataGrid("instance");
                    return container;
                },
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Select Courses",
                            icon: "check",
                            type: "default",
                            stylingMode: "contained",
                            onClick: function() {
                                const selectedKeys = coursesGrid.getSelectedRowKeys();
                                criteriaForm.updateData("courseIds", selectedKeys);
                                coursesPopup.hide();
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancel",
                            onClick: () => coursesPopup.hide()
                        }
                    }
                ],
                onShowing: function() {
                    const currentCourseIds = criteriaForm.option("formData.courseIds") || [];
                    if (coursesGrid) {
                        coursesGrid.selectRows(currentCourseIds, false);
                    }
                }
            }).dxPopup("instance");

            // --- สร้าง Form สำหรับรับเงื่อนไข ---
            criteriaForm = $("#criteria-form").dxForm({
                formData: {
                    description: "",
                    startDate: new Date(),
                    courseDivisionId: null,
                    courseCategoryId: null,
                    courseIds: PRESELECTED_COURSE_ID ? [PRESELECTED_COURSE_ID] : [],
                    division: null,
                    department: null
                },
                colCount: 1,
                labelMode: "floating",
                stylingMode: "outlined",
                items: [
                    {
                        itemType: "group",
                        caption: "1. General Info",
                        items: [
                            { dataField: "description", label: { text: "Description" }, editorType: "dxTextArea", editorOptions: { height: 70 } }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "2. Target Courses",
                        items: [
                            {
                                itemType: "group",
                                colCount: 2,
                                items: [
                                    {
                                        dataField: "courseDivisionId",
                                        label: { text: "Course Division" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: courseDivisionStore,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            placeholder: "Filter by Division...",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            onValueChanged: function(e) {
                                                // กรอง Category อัตโนมัติเมื่อเลือกแผนก
                                                if (e.value) {
                                                    courseCategoryDataSource.filter(["divisionId", "=", e.value]);
                                                } else {
                                                    courseCategoryDataSource.filter(null);
                                                }
                                                courseCategoryDataSource.load();

                                                if (e.event) {
                                                    criteriaForm.updateData("courseCategoryId", null);
                                                    criteriaForm.updateData("courseIds", []); // เคลียร์หลักสูตรที่เลือกไว้
                                                }
                                                updateCourseFilter();
                                            }
                                        }
                                    },
                                    {
                                        dataField: "courseCategoryId",
                                        label: { text: "Course Category" },
                                        editorType: "dxSelectBox",
                                        editorOptions: {
                                            dataSource: courseCategoryDataSource,
                                            displayExpr: "name",
                                            valueExpr: "id",
                                            placeholder: "Filter by Category...",
                                            showClearButton: true,
                                            searchEnabled: true,
                                            onValueChanged: function(e) {
                                                if (e.event) {
                                                    criteriaForm.updateData("courseIds", []);

                                                    // ดึงแผนกให้อัตโนมัติถ้าเลือกหมวดหมู่ก่อน
                                                    const selectedItem = e.component.option("selectedItem");
                                                    if (selectedItem && selectedItem.divisionId) {
                                                        const currentDiv = criteriaForm.option("formData.courseDivisionId");
                                                        if (currentDiv !== selectedItem.divisionId) {
                                                            criteriaForm.updateData("courseDivisionId", selectedItem.divisionId);
                                                        }
                                                    }
                                                }
                                                updateCourseFilter();
                                            }
                                        }
                                    }
                                ]
                            },
                            {
                                dataField: "courseIds",
                                label: { text: "Select Courses" },
                                editorType: "dxTagBox",
                                editorOptions: {
                                    dataSource: activeCoursesDataSource,
                                    valueExpr: "id",
                                    displayExpr: "code",
                                    placeholder: "Select or Browse courses...",
                                    showClearButton: true,
                                    openOnFieldClick: false,
                                    buttons: [
                                        {
                                            name: "browse",
                                            location: "after",
                                            options: {
                                                icon: "search",
                                                hint: "Browse All Courses",
                                                onClick: function() {
                                                    coursesPopup.show();
                                                }
                                            }
                                        },
                                        "clear"
                                    ]
                                },
                                validationRules: [{ type: "required", message: "Please select at least one course" }]
                            }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "3. Schedule",
                        colCount: 2,
                        items: [
                            { dataField: "startDate", label: { text: "Start Date" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" }, validationRules: [{ type: "required", message: "Start date is required" }] },
                            { dataField: "dueDate", label: { text: "Due Date" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" } }
                        ]
                    },
                    {
                        itemType: "group",
                        caption: "4. Target Employee",
                        colCount: 2,
                        items: [
                            {
                                dataField: "division",
                                label: { text: "Employee Division" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: divisionDataSource,
                                    displayExpr: "Name",
                                    valueExpr: "Name",
                                    placeholder: "Select Division...",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    onValueChanged: function(e) {
                                        if (e.value) {
                                            departmentDataSource.filter(["Division", "=", e.value]);
                                        } else {
                                            departmentDataSource.filter(null);
                                        }
                                        departmentDataSource.load();

                                        if (e.event) {
                                            criteriaForm.updateData("department", null);
                                        }
                                    }
                                },
                                validationRules: [{ type: "required", message: "Division is required to find employees." }]
                            },
                            {
                                dataField: "department",
                                label: { text: "Employee Department" },
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: departmentDataSource,
                                    displayExpr: "Name",
                                    valueExpr: "Name",
                                    placeholder: "Select Department...",
                                    searchEnabled: true,
                                    showClearButton: true,
                                    onValueChanged: function(e) {
                                        if (e.event && e.value) {
                                            const selectedItem = e.component.option("selectedItem");
                                            if (selectedItem && selectedItem.Division) {
                                                const currentDiv = criteriaForm.option("formData.division");
                                                if (currentDiv !== selectedItem.Division) {
                                                    criteriaForm.updateData("division", selectedItem.Division);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        ]
                    }
                ]
            }).dxForm("instance");

            // --- สร้าง DataGrid สำหรับแสดงและเลือกพนักงาน ---
            employeesGrid = $("#employees-grid").dxDataGrid({
                dataSource: [],
                keyExpr: "eId",
                showBorders: false,
                rowAlternationEnabled: true,
                hoverStateEnabled: true,
                height: 600,
                scrolling: { mode: "virtual" },
                searchPanel: { visible: true, width: 250, placeholder: "Search in grid..." },
                filterRow: { visible: true },
                headerFilter: { visible: true },
                selection: { mode: "multiple", selectAllMode: "allPages", showCheckBoxesMode: "always" },
                columns: [
                    { dataField: "eId", caption: "Emp ID", width: 100, alignment: "center" },
                    {
                        caption: "Employee Name",
                        calculateCellValue: function(rowData) {
                            return rowData.englishFirstName + " " + rowData.englishLastName;
                        }
                    },
                    { dataField: "division", caption: "Division", width: 100, alignment: "center" },
                    { dataField: "department", caption: "Department", width: 120, alignment: "center" },
                    { dataField: "section", caption: "Section", width: 180 },
                    { dataField: "position", caption: "Position", width: 120, alignment: "center" }
                ],
                onSelectionChanged: function(e) {
                    const selectedRows = e.component.getSelectedRowKeys().length;
                    $("#selected-count").text(`${selectedRows} Selected`);
                },
                noDataText: "Please fill the division and click 'Find Employees'"
            }).dxDataGrid("instance");

            // --- เมื่อกดปุ่ม Find Employees ---
            $("#btn-search-emp").click(function() {
                const filters = criteriaForm.option("formData");

                if (!filters.division) {
                    DevExpress.ui.notify("Please select a Division before finding employees.", "warning", 3000);
                    criteriaForm.validate();
                    return;
                }

                loadPanel.option("message", "Finding employees...");
                loadPanel.show();

                let apiUrl = `${serviceUrl}/Students/divisions?skip=0&take=500`;

                if (filters.division) apiUrl += `&divisions=${encodeURIComponent(filters.division)}`;

                $.ajax({
                    url: apiUrl,
                    method: "GET",
                    xhrFields: { withCredentials: true },
                    success: function(response) {
                        let empData = response.data || [];

                        // กรองตาม Department ถ้ามีการเลือก
                        if (filters.department) {
                            empData = empData.filter(emp => emp.department === filters.department);
                        }

                        employeesGrid.option("dataSource", empData);
                        DevExpress.ui.notify(`Found ${empData.length} employees`, "success", 2000);
                    },
                    error: function(err) {
                        console.error(err);
                        DevExpress.ui.notify("Failed to load employees data", "error", 3000);
                    },
                    complete: () => loadPanel.hide()
                });
            });

            // --- เมื่อกดปุ่ม ยืนยันการ Assign ---
            $("#btn-assign").dxButton({
                text: "Confirm & Assign",
                icon: "check",
                type: "default",
                stylingMode: "contained",
                elementAttr: { class: "shadow-sm px-4 btn-primary" },
                onClick: function() {
                    const isFormValid = criteriaForm.validate().isValid;
                    const selectedEmployees = employeesGrid.getSelectedRowKeys();

                    if (!isFormValid) {
                        DevExpress.ui.notify("Please complete the required criteria.", "warning", 3000);
                        return;
                    }
                    if (selectedEmployees.length === 0) {
                        DevExpress.ui.notify("Please select at least one employee from the list.", "error", 3000);
                        return;
                    }

                    const formData = criteriaForm.option("formData");

                    const payload = {
                        description: formData.description,
                        courseIds: formData.courseIds,
                        startDate: formData.startDate,
                        dueDate: formData.dueDate,
                        employeeCodes: selectedEmployees,
                        division: formData.division
                    };

                    DevExpress.ui.dialog.confirm(
                        `Are you sure you want to assign <b>${formData.courseIds.length} course(s)</b> to <b>${selectedEmployees.length} employees</b>?`,
                        "Confirm Assignment"
                    ).done(function(dialogResult) {
                        if (dialogResult) executeBulkAssign(payload);
                    });
                }
            });

            function executeBulkAssign(payload) {
                loadPanel.option("message", "Assigning courses...");
                loadPanel.show();

                $.ajax({
                    url: `${serviceUrl}/Enrollments/BulkAssign`,
                    method: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    xhrFields: { withCredentials: true },
                    success: function(res) {
                        DevExpress.ui.notify("Courses assigned successfully!", "success", 3000);
                        setTimeout(() => window.location.href = '@Url.Action("Index", "Enrollments")', 1500);
                    },
                    error: function(err) {
                        DevExpress.ui.notify("Error: " + (err.responseJSON?.message || "Failed to assign course"), "error", 4000);
                    },
                    complete: () => loadPanel.hide()
                });
            }
        });
    </script>
}