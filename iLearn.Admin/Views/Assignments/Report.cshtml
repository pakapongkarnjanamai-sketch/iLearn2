@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "_ReportLayout";
    ViewData["Title"] = "Assignment Report";
    ViewData["ReportTitle"] = "Assignment Report";
    ViewData["ReportIcon"] = "fa-file-alt";
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "";
}

@section Styles {
    <style>
        .assignment-info-panel,
        .assignment-summary-panel {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .assignment-identity {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-color);
        }

        .assignment-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: var(--bg-light);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            font-size: var(--font-size-lg);
            font-weight: 700;
        }

        .assignment-name {
            font-size: var(--font-size-xl);
            line-height: var(--text-heading-line-height);
            font-weight: 700;
            color: var(--text-primary);
            max-width: 26ch;
        }

        .assignment-context {
            margin-top: 4px;
            font-size: var(--font-size-sm);
            line-height: var(--text-secondary-line-height);
            color: var(--text-secondary);
        }

        .assignment-info-list {
            display: flex;
            flex-direction: column;
        }

        .assignment-info-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 8px 0;
            font-size: var(--font-size-sm);
            line-height: var(--text-secondary-line-height);
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }

        .assignment-info-row:last-child {
            border-bottom: none;
        }

        .assignment-info-label {
            min-width: 92px;
            font-weight: 500;
        }

        .assignment-info-value {
            color: var(--text-primary);
            font-weight: 600;
        }

        .assignment-report-grid {
            align-items: start;
        }

        .assignment-matrix-shell .sticky-col {
            position: sticky;
            left: 0;
            background-color: var(--surface-base);
            z-index: 2;
            box-shadow: 1px 0 0 0 var(--border-color);
        }

        .assignment-matrix-shell .table-hover tbody tr:hover .sticky-col {
            background-color: color-mix(in srgb, var(--bg-light) 88%, var(--surface-base));
        }

        .assignment-matrix-shell th.sticky-col {
            background-color: color-mix(in srgb, var(--bg-light) 92%, var(--surface-base));
            z-index: 3;
        }

        .assignment-matrix-shell .table th:not(.sticky-col) {
            min-width: 160px;
            text-align: center;
            vertical-align: middle;
        }

        .assignment-matrix-shell .table td {
            vertical-align: middle;
        }
    </style>
}

@section ToolbarActions {
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.print()">
            <i class="fas fa-print"></i> Print
        </button>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="exportAllToExcel()">
            <i class="fas fa-file-excel"></i> Export
        </button>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.close()">
            <i class="fas fa-times"></i> Close
        </button>
}

    <div id="report-content" class="report-page">
        <div class="report-empty-state">
            <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
            <span class="fs-6">Loading data...</span>
        </div>
    </div>

@section Scripts {
    <script>
        const INITIAL_ASSIGNMENT_ID = @(ViewBag.AssignmentId ?? 0);
        const INITIAL_ASSIGNMENT_NO = "@(ViewBag.AssignmentNo ?? "")";
        const serviceUrl    = "@apiBaseUrl";
        let ASSIGNMENT_ID = INITIAL_ASSIGNMENT_ID;

        // Helper: Format Date
        function formatDate(dateString) {
            return window.formatAdminDate(dateString, "-");
        }

        function esc(value) {
            return window.escapeAdminHtml ? window.escapeAdminHtml(value) : $("<span>").text(value).html();
        }

        // Resolve Assignment No → ID, then fetch dashboard
        async function loadReport() {
            try {
                if (!ASSIGNMENT_ID && INITIAL_ASSIGNMENT_NO) {
                    const resolveRes = await fetch(`${serviceUrl}/Assignments/resolve/${encodeURIComponent(INITIAL_ASSIGNMENT_NO)}`, { credentials: "include" });
                    const resolveData = await resolveRes.json();
                    if (!resolveRes.ok || !resolveData.success) {
                        document.getElementById("report-content").innerHTML = '<div class="text-danger text-center py-4">Assignment not found.</div>';
                        return;
                    }
                    ASSIGNMENT_ID = resolveData.data;
                }

                const res = await fetch(`${serviceUrl}/Assignments/dashboard/${ASSIGNMENT_ID}`, { credentials: "include" });
                const data = await res.json();
                if (!data.success || !data.data) {
                    document.getElementById("report-content").innerHTML = '<div class="text-danger text-center py-4">Failed to load report data.</div>';
                    return;
                }
                renderReport(data.data);
            } catch {
                document.getElementById("report-content").innerHTML = '<div class="text-danger text-center py-4">Network error.</div>';
            }
        }

        loadReport();

        // ─── Component: Pivot Table ───
        function buildPivotTable(courses, students) {
            const studentMap = {};
            students.forEach(s => {
                if (!studentMap[s.studentCode]) studentMap[s.studentCode] = {};
                studentMap[s.studentCode][s.assignmentRuleId] = s;
            });
            const uniqueStudents = Object.keys(studentMap).sort();

            // ปรับ Course Code ให้เป็นตัวหนา และ Course Title ให้ตัวเล็กลง ตัดคำอัตโนมัติ
            const colHeaders = courses.map(c =>
                `<th class="text-center align-middle u-minw-160">
                    <div class="fw-bold text-dark">${c.courseCode}</div>
                    <div class="text-muted mt-1 u-fs-10 u-fw-normal u-whitespace-normal u-leading-tight">${c.courseTitle}</div>
                </th>`
            ).join("");

            const dataRows = uniqueStudents.map(code => {
                const enrollments = studentMap[code];
                const name = Object.values(enrollments)[0]?.studentName || code;
                let completedCount = 0;

                const cells = courses.map(c => {
                    const e = enrollments[c.assignmentRuleId];
                    if (!e) return `<td class="text-center align-middle"><span class="status-pending">—</span></td>`;

                    if (e.isCompleted) {
                        completedCount++;
                        const d = e.completedDate ? window.formatAdminDate(e.completedDate, "") : "";
                        return `<td class="text-center align-middle status-done">
                                    <i class="fas fa-check"></i>
                                    <div class="u-fs-10 text-secondary">${d}</div>
                                </td>`;
                    } else if (e.progress > 0) {
                        return `<td class="text-center align-middle status-active u-fs-11">${window.formatAdminPercentage(e.progress, '0%')}</td>`;
                    } else {
                        return `<td class="text-center align-middle status-pending u-fs-11">Pending</td>`;
                    }
                }).join("");

                const totalCourses = courses.length;

                // ใช้คลาส .sticky-col สำหรับคอลัมน์แรกเพื่อคงความกว้างและการแช่แข็งเมื่อเลื่อนแกน X
                return `<tr>
                            <td class="sticky-col align-middle">
                                <div class="fw-bold">${code}</div>
                                <div class="text-muted u-fs-11">${name !== code ? name : ""}</div>
                            </td>
                            ${cells}
                            <td class="text-center align-middle fw-bold bg-light">${completedCount} / ${totalCourses}</td>
                        </tr>`;
            }).join("");

            return `<div class="report-table-shell assignment-matrix-shell">
                        <div class="report-table-scroll">
                            <table class="table table-bordered table-hover pivot-table m-0">
                                <thead class="sticky-thead">
                                    <tr>
                                        <th class="sticky-col align-middle u-minw-180">Learner \\ Course</th>
                                        ${colHeaders}
                                        <th class="text-center align-middle bg-light u-minw-80">Total</th>
                                    </tr>
                                </thead>
                                <tbody>${dataRows}</tbody>
                            </table>
                        </div>
                    </div>`;
        }

        // ─── Component: Main Render ───
        function renderReport(data) {
            _reportData = data;
            const cd = data.chartData;

            // Course Rows Data
            const courseRows = (data.courses || []).map(c => {
                const pct = c.totalStudents > 0 ? Math.round((c.completedStudents / c.totalStudents) * 100) : 0;
                const colorClass = pct === 100
                    ? "var(--success-color)"
                    : pct > 0
                        ? "var(--warning-color)"
                        : "var(--border-color)";
                return `<tr>
                    <td class="fw-bold align-middle">${c.courseCode}</td>
                    <td class="align-middle">${c.courseTitle}</td>
                    <td class="align-middle text-center">${c.totalStudents}</td>
                    <td class="align-middle text-center fw-semibold">${c.completedStudents}</td>
                    <td class="align-middle text-center">${c.totalStudents - c.completedStudents}</td>
                    <td class="align-middle u-minw-150">
                        <div class="d-flex justify-content-between u-fs-11">
                            <span class="text-muted">Progress</span><span class="fw-bold">${window.formatAdminPercentage(pct, '0%')}</span>
                        </div>
                        <div class="progress-slim">
                            <div style="height:100%; width:${pct}%; background:${colorClass};"></div>
                        </div>
                    </td>
                </tr>`;
            }).join("");

           // Student Rows Data
            const studentGroups = {};
            (data.students || []).forEach(s => {
                if (!studentGroups[s.studentCode]) studentGroups[s.studentCode] = [];
                studentGroups[s.studentCode].push(s);
            });
            const studentRows = Object.entries(studentGroups).map(([code, rows]) => {
                const name = rows[0]?.studentName || "";

                // คำนวณค่า Total, Done, Left
                const total = rows.length;
                const done = rows.filter(r => r.isCompleted).length;
                const left = total - done;

                // คำนวณ % Progress (หาค่าเฉลี่ยของ Progress ทุกวิชา)
                const overallPct = Math.round(rows.reduce((a, r) => a + r.progress, 0) / rows.length);

                // กำหนดสีของหลอด Progress
                const colorClass = overallPct === 100
                    ? "var(--success-color)"
                    : overallPct > 0
                        ? "var(--warning-color)"
                        : "var(--border-color)";

                return `<tr>
                    <td class="align-middle">
                        <div class="fw-bold">${code}</div>
                        <div class="text-muted u-fs-11">${name}</div>
                    </td>
                    <td class="align-middle text-center">${total}</td>
                    <td class="align-middle text-center fw-semibold">${done}</td>
                    <td class="align-middle text-center">${left}</td>
                    <td class="align-middle u-minw-150">
                        <div class="d-flex justify-content-between u-fs-11">
                            <span class="text-muted">Progress</span><span class="fw-bold">${window.formatAdminPercentage(overallPct, '0%')}</span>
                        </div>
                        <div class="progress-slim">
                            <div style="height:100%; width:${overallPct}%; background:${colorClass};"></div>
                        </div>
                    </td>
                </tr>`;
            }).join("");

            // Format dates for display
            const displayStartDate = formatDate(data.startDate);
            const displayDueDate = formatDate(data.dueDate);
            const learnerCount = Object.keys(studentGroups).length;
            const useCompactTopFold = (data.courses || []).length <= 2 && learnerCount <= 3;
            const summaryChartHeight = useCompactTopFold ? 172 : 200;
            const assignmentDescription = data.description ? esc(String(data.description)) : "-";
            const createdBy = data.createdBy ? esc(String(data.createdBy)) : "-";
            const topFoldClass = "report-grid report-grid--sidebar assignment-report-grid";

            // Inject HTML Layout
            document.getElementById("report-content").innerHTML = `
                <div class="report-stack">
                    <div class="${topFoldClass}">
                        <section class="report-section">
                            <div class="report-section-head">
                                <div class="report-section-title-wrap">
                                    <h2 class="report-section-title">Assignment Information</h2>
                                </div>
                            </div>

                            <div class="report-panel assignment-info-panel">
                                <div class="assignment-identity">
                                    <div class="assignment-avatar">A</div>
                                    <div>
                                        <div class="assignment-name">${esc(String(data.assignmentNo || "-"))}</div>
                                        <div class="assignment-context">${assignmentDescription}</div>
                                    </div>
                                </div>

                                <div class="assignment-info-list">
                                    <div class="assignment-info-row">
                                        <span class="assignment-info-label">Created By</span>
                                        <span class="assignment-info-value">${createdBy}</span>
                                    </div>
                                    <div class="assignment-info-row">
                                        <span class="assignment-info-label">Start</span>
                                        <span class="assignment-info-value">${displayStartDate}</span>
                                    </div>
                                    <div class="assignment-info-row">
                                        <span class="assignment-info-label">Due</span>
                                        <span class="assignment-info-value">${displayDueDate}</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="report-section">
                            <div class="report-section-head">
                                <div class="report-section-title-wrap">
                                    <h2 class="report-section-title">Completion Summary</h2>
                                </div>
                            </div>

                            <div class="report-panel assignment-summary-panel">

                                <div class="report-metrics">
                                    <div class="report-metric">
                                        <div class="report-metric-value">${data.totalEmployees}</div>
                                        <div class="report-metric-label">Learners</div>
                                    </div>
                                    <div class="report-metric">
                                        <div class="report-metric-value">${data.totalCourses}</div>
                                        <div class="report-metric-label">Courses</div>
                                    </div>
                                    <div class="report-metric">
                                        <div class="report-metric-value">${window.formatAdminPercentage(data.completionRate, '0%')}</div>
                                        <div class="report-metric-label">Completion</div>
                                    </div>
                                </div>

                                <div class="report-chart-block">
                                    <div class="report-kicker">Completion Distribution</div>
                                    <div id="report-pie-chart" style="height: ${summaryChartHeight}px;"></div>
                                </div>
                            </div>
                        </section>
                    </div>

                    <section class="report-section">
                        <div class="report-section-head">
                            <div class="report-section-title-wrap">
                                <h2 class="report-section-title">Course Overview</h2>
                            </div>
                            <button class="report-action-btn" onclick="exportCourseOverview()">
                                <i class="fas fa-file-excel"></i> Export
                            </button>
                        </div>

                        <div class="report-table-shell">
                            <div class="report-table-scroll">
                                <table class="table table-hover m-0 assignment-overview-table">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Course</th>
                                            <th class="text-center">Total</th>
                                            <th class="text-center">Done</th>
                                            <th class="text-center">Left</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>${courseRows}</tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                    <section class="report-section">
                        <div class="report-section-head">
                            <div class="report-section-title-wrap">
                                <h2 class="report-section-title">Learner × Course Matrix</h2>
                            </div>
                            <button class="report-action-btn" onclick="exportPivotMatrix()">
                                <i class="fas fa-file-excel"></i> Export
                            </button>
                        </div>
                        ${buildPivotTable(data.courses, data.students)}
                    </section>

                    <section class="report-section">
                        <div class="report-section-head">
                            <div class="report-section-title-wrap">
                                <h2 class="report-section-title">Learner Tracking</h2>
                            </div>
                            <button class="report-action-btn" onclick="exportStudentTracking()">
                                <i class="fas fa-file-excel"></i> Export
                            </button>
                        </div>

                        <div class="report-table-shell">
                            <div class="report-table-scroll">
                                <table class="table table-hover m-0 assignment-tracking-table">
                                    <thead>
                                        <tr>
                                            <th>Learner</th>
                                            <th class="text-center">Total</th>
                                            <th class="text-center">Done</th>
                                            <th class="text-center">Left</th>
                                            <th>Progress</th>
                                        </tr>
                                    </thead>
                                    <tbody>${studentRows}</tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
            `;

            // Render Chart (Clean Palette)
            $("#report-pie-chart").dxPieChart(
                window.createAdminPieChartConfig({
                    palettePreset: "status3",
                    centerLabel: 'Completion',
                    centerValue: window.formatAdminPercentage(data.completionRate, '0%'),
                    baseConfig: {
                        type: "doughnut",
                        innerRadius: 0.7,
                        size: {
                            height: summaryChartHeight
                        },
                        dataSource: [
                            { status: "Completed",   count: cd.completed  },
                            { status: "In Progress", count: cd.inProgress },
                            { status: "Not Started", count: cd.notStarted }
                        ],
                        series: [{
                            argumentField: "status", valueField: "count",
                            label: {
                                visible: true,
                                position: "outside",
                                customizeText: p => `${p.valueText} (${p.percentText})`,
                                font: { size: parseInt(useCompactTopFold ? window.adminTypography.size.micro : window.adminTypography.size.xs, 10), color: "var(--text-secondary)" },
                                connector: { visible: true, width: 1 }
                            }
                        }],
                        legend: {
                            horizontalAlignment: "right", verticalAlignment: "center",
                            margin: 0, font: { size: parseInt(useCompactTopFold ? window.adminTypography.size.xs : window.adminTypography.size.caption, 10), color: "var(--text-secondary)" }
                        },
                        tooltip: { enabled: true }
                    }
                })
            );
        }

        // ─── Store report data for Excel export ───
        let _reportData = null;

        // ─── Excel Export Helpers ───
        function getExportFileName(prefix) {
            const assignmentNo = (_reportData?.assignmentNo || 'Unknown').replace(/[\\/:*?"<>|]/g, '_');
            const now = new Date();
            const ts = [
                now.getFullYear(),
                String(now.getMonth() + 1).padStart(2, '0'),
                String(now.getDate()).padStart(2, '0'),
                String(now.getHours()).padStart(2, '0'),
                String(now.getMinutes()).padStart(2, '0')
            ].join('');
            return `${prefix}_${assignmentNo}_${ts}.xlsx`;
        }

        function saveWorkbook(workbook, fileName) {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), fileName);
            });
        }

        function styleHeaderRow(ws) {
            const row = ws.getRow(1);
            row.font = { bold: true, size: parseInt(window.adminTypography.size.xs, 10) };
            row.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF5F5F5' } };
            row.alignment = { vertical: 'middle' };
            row.eachCell(cell => cell.border = { bottom: { style: 'thin', color: { argb: 'FFD9D9D9' } } });
        }

        function addCourseOverviewSheet(wb) {
            const ws = wb.addWorksheet('Course Overview');
            ws.columns = [
                { header: 'Code',       key: 'code',  width: 15 },
                { header: 'Course',     key: 'title', width: 40 },
                { header: 'Total',      key: 'total', width: 10 },
                { header: 'Done',       key: 'done',  width: 10 },
                { header: 'Left',       key: 'left',  width: 10 },
                { header: 'Progress %', key: 'pct',   width: 12 }
            ];
            (_reportData.courses || []).forEach(function(c) {
                const pct = c.totalStudents > 0 ? Math.round((c.completedStudents / c.totalStudents) * 100) : 0;
                ws.addRow({ code: c.courseCode, title: c.courseTitle, total: c.totalStudents, done: c.completedStudents, left: c.totalStudents - c.completedStudents, pct });
            });
            styleHeaderRow(ws);
        }

        function addMatrixSheet(wb) {
            const courses = _reportData.courses || [];
            const studentMap = {};
            (_reportData.students || []).forEach(function(s) {
                if (!studentMap[s.studentCode]) studentMap[s.studentCode] = {};
                studentMap[s.studentCode][s.assignmentRuleId] = s;
            });

            const ws = wb.addWorksheet('Learner Course Matrix');
            const headers = ['Employee ID', 'Name', ...courses.map(c => c.courseCode), 'Total'];
            ws.addRow(headers);

            Object.keys(studentMap).sort().forEach(function(code) {
                const enrollments = studentMap[code];
                const name = Object.values(enrollments)[0]?.studentName || '';
                let completedCount = 0;
                const row = [code, name];
                courses.forEach(function(c) {
                    const e = enrollments[c.assignmentRuleId];
                    if (!e)            { row.push('—'); }
                    else if (e.isCompleted) { completedCount++; row.push(e.completedDate ? window.formatAdminDate(e.completedDate, '') : 'Done'); }
                    else if (e.progress > 0) { row.push(e.progress + '%'); }
                    else               { row.push('Pending'); }
                });
                row.push(`${completedCount} / ${courses.length}`);
                ws.addRow(row);
            });

            ws.columns.forEach(col => col.width = Math.max(col.width || 10, 14));
            styleHeaderRow(ws);
        }

        function addStudentTrackingSheet(wb) {
            const ws = wb.addWorksheet('Learner Tracking');
            ws.columns = [
                { header: 'Employee ID', key: 'code',  width: 15 },
                { header: 'Name',        key: 'name',  width: 30 },
                { header: 'Total',       key: 'total', width: 10 },
                { header: 'Done',        key: 'done',  width: 10 },
                { header: 'Left',        key: 'left',  width: 10 },
                { header: 'Progress %',  key: 'pct',   width: 12 }
            ];
            const studentGroups = {};
            (_reportData.students || []).forEach(function(s) {
                if (!studentGroups[s.studentCode]) studentGroups[s.studentCode] = [];
                studentGroups[s.studentCode].push(s);
            });
            Object.entries(studentGroups).forEach(function([code, rows]) {
                const total = rows.length;
                const done  = rows.filter(r => r.isCompleted).length;
                const pct   = Math.round(rows.reduce((a, r) => a + r.progress, 0) / rows.length);
                ws.addRow({ code, name: rows[0]?.studentName || '', total, done, left: total - done, pct });
            });
            styleHeaderRow(ws);
        }

        async function exportCourseOverview()  {
            if (!_reportData) return;
            await window.ensureExportDependencies();
            const wb = new ExcelJS.Workbook();
            addCourseOverviewSheet(wb);
            saveWorkbook(wb, getExportFileName('Course_Overview'));
        }

        async function exportPivotMatrix() {
            if (!_reportData) return;
            await window.ensureExportDependencies();
            const wb = new ExcelJS.Workbook();
            addMatrixSheet(wb);
            saveWorkbook(wb, getExportFileName('Student_Course_Matrix'));
        }

        async function exportStudentTracking() {
            if (!_reportData) return;
            await window.ensureExportDependencies();
            const wb = new ExcelJS.Workbook();
            addStudentTrackingSheet(wb);
            saveWorkbook(wb, getExportFileName('Student_Tracking'));
        }

        async function exportAllToExcel() {
            if (!_reportData) return;
            await window.ensureExportDependencies();
            const wb = new ExcelJS.Workbook();
            addCourseOverviewSheet(wb);
            addMatrixSheet(wb);
            addStudentTrackingSheet(wb);
            saveWorkbook(wb, getExportFileName('Assignment_Report'));
        }
    </script>
}