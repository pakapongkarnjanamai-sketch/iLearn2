@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var apiBaseUrl = Configuration["ApiSettings:BaseUrl"] ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Assignment Report</title>
    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <link href="~/css/admin-minimal.css" rel="stylesheet" />


    <style>
        body {
            font-family: var(--font-stack);
            background: #fff;
            color: var(--text-primary);
            font-size: 13px;
            padding-top: 50px;
        }

        /* ── Header & Toolbar ── */
        .toolbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 999;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            padding: 10px 24px;
        }

        .toolbar-btn {
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            background: #fff;
            color: var(--text-secondary);
            transition: 0.2s;
        }

            .toolbar-btn:hover {
                background: var(--bg-light);
                color: var(--text-primary);
            }

        /* ── Table Customizations over Bootstrap ── */
        .table {
            font-size: 12px;
            border-color: var(--border-color) !important;
            margin-bottom: 0;
        }

            .table th {
                background: var(--bg-light);
                font-weight: 600;
                color: var(--text-secondary);
            }

        .table-hover tbody tr:hover {
            background-color: var(--bg-light);
        }

        /* ── Sticky Column for Pivot Matrix ── */
        .sticky-col {
            position: sticky;
            left: 0;
            background-color: #fff;
            z-index: 2;
            border-right: 2px solid var(--border-color) !important;
        }

        .table-hover tbody tr:hover .sticky-col {
            background-color: var(--bg-light);
        }

        th.sticky-col {
            background-color: var(--bg-light);
            z-index: 3; /* ให้อยู่เหนือ column อื่นๆ ตอน scroll */
        }

        /* ── Status Indicators ── */
        .status-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .status-done {
            color: var(--success-color);
        }

            .status-done .status-dot {
                background: var(--success-color);
            }

        .status-active {
            color: var(--warning-color);
        }

            .status-active .status-dot {
                background: var(--warning-color);
            }

        .status-pending {
            color: var(--text-secondary);
        }

            .status-pending .status-dot {
                background: #d9d9d9;
            }

        .progress-slim {
            height: 4px;
            background: var(--border-color);
            border-radius: 2px;
            overflow: hidden;
            margin-top: 4px;
        }

        @@media print {
            .toolbar {
                display: none !important;
            }

            body {
                padding-top: 0;
            }
        }
    </style>
</head>
<body>

    <div class="toolbar d-flex align-items-center gap-2">
        <span class="fw-bold fs-6 flex-grow-1">Data Report</span>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.close()">
            <i class="fas fa-times"></i> Close
        </button>
        <button class="toolbar-btn d-flex align-items-center gap-2" onclick="window.print()">
            <i class="fas fa-print"></i> Print
        </button>
    </div>

    <div id="report-content" class="container-fluid py-4" style="max-width: 1400px;">
        <div class="d-flex flex-column justify-content-center align-items-center text-muted" style="min-height: 70vh;">
            <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
            <span class="fs-6">Loading data...</span>
        </div>
    </div>

    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>
    <script src="~/src/devextreme-license.js"></script>
    <script src="~/lib/html2canvas/html2canvas.min.js"></script>
    <script>
        const ASSIGNMENT_ID = @ViewBag.AssignmentId;
        const serviceUrl    = "@apiBaseUrl";

        // Helper: Format Date
        function formatDate(dateString) {
            if (!dateString) return "-";
            const options = { year: 'numeric', month: 'short', day: 'numeric' };
            return new Date(dateString).toLocaleDateString("en-GB", options);
        }

        // Fetch Data
        fetch(`${serviceUrl}/Assignments/dashboard/${ASSIGNMENT_ID}`, { credentials: "include" })
            .then(r => r.json())
            .then(res => {
                if (!res.success || !res.data) {
                    document.getElementById("report-content").innerHTML = '<div class="text-danger text-center py-4">Failed to load report data.</div>';
                    return;
                }
                renderReport(res.data);
            })
            .catch(() => {
                document.getElementById("report-content").innerHTML = '<div class="text-danger text-center py-4">Network error.</div>';
            });

        // ─── Component: Pivot Table ───
        function buildPivotTable(courses, students) {
            const studentMap = {};
            students.forEach(s => {
                if (!studentMap[s.studentCode]) studentMap[s.studentCode] = {};
                studentMap[s.studentCode][s.assignmentRuleId] = s;
            });
            const uniqueStudents = Object.keys(studentMap).sort();

            // ปรับ Course Code ให้เป็นตัวหนา และ Course Title ให้ตัวเล็กลง ตัดคำอัตโนมัติ
            const colHeaders = courses.map(c =>
                `<th class="text-center align-middle" style="min-width:160px;">
                    <div class="fw-bold text-dark">${c.courseCode}</div>
                    <div class="text-muted mt-1" style="font-size:10px; font-weight:normal; white-space:normal; line-height:1.2;">${c.courseTitle}</div>
                </th>`
            ).join("");

            const dataRows = uniqueStudents.map(code => {
                const enrollments = studentMap[code];
                const name = Object.values(enrollments)[0]?.studentName || code;
                let completedCount = 0;

                const cells = courses.map(c => {
                    const e = enrollments[c.assignmentRuleId];
                    if (!e) return `<td class="text-center align-middle"><span class="status-pending">—</span></td>`;

                    if (e.isCompleted) {
                        completedCount++;
                        const d = e.completedDate ? new Date(e.completedDate).toLocaleDateString("en-GB") : "";
                        return `<td class="text-center align-middle status-done">
                                    <i class="fas fa-check"></i>
                                    <div style="font-size:10px;color:#8c8c8c">${d}</div>
                                </td>`;
                    } else if (e.progress > 0) {
                        return `<td class="text-center align-middle status-active" style="font-size:11px;">${e.progress}%</td>`;
                    } else {
                        return `<td class="text-center align-middle status-pending" style="font-size:11px;">Pending</td>`;
                    }
                }).join("");

                const totalCourses = courses.length;

                // ใช้คลาส .sticky-col สำหรับคอลัมน์แรกเพื่อคงความกว้างและการแช่แข็งเมื่อเลื่อนแกน X
                return `<tr>
                            <td class="sticky-col align-middle">
                                <div class="fw-bold">${code}</div>
                                <div class="text-muted" style="font-size:11px;">${name !== code ? name : ""}</div>
                            </td>
                            ${cells}
                            <td class="text-center align-middle fw-bold bg-light">${completedCount} / ${totalCourses}</td>
                        </tr>`;
            }).join("");

            return `<div class="table-responsive border rounded bg-white " style="max-height: 600px;">
                        <table class="table table-bordered table-hover pivot-table m-0">
                            <thead style="position: sticky; top: 0; z-index: 4;">
                                <tr>
                                    <th class="sticky-col align-middle" style="min-width:180px;">Student \\ Course</th>
                                    ${colHeaders}
                                    <th class="text-center align-middle bg-light" style="min-width:80px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>${dataRows}</tbody>
                        </table>
                    </div>`;
        }

        // ─── Component: Main Render ───
        function renderReport(data) {
            const cd = data.chartData;

            // Course Rows Data
            const courseRows = (data.courses || []).map(c => {
                const pct = c.totalStudents > 0 ? Math.round((c.completedStudents / c.totalStudents) * 100) : 0;
                const colorClass = pct === 100 ? "var(--success-color)" : pct > 0 ? "var(--accent-color)" : "var(--border-color)";
                return `<tr>
                    <td class="fw-bold align-middle">${c.courseCode}</td>
                    <td class="align-middle">${c.courseTitle}</td>
                    <td class="align-middle text-center">${c.totalStudents}</td>
                    <td class="align-middle text-center" style="color:var(--success-color)">${c.completedStudents}</td>
                    <td class="align-middle text-center">${c.totalStudents - c.completedStudents}</td>
                    <td class="align-middle" style="width:150px;">
                        <div class="d-flex justify-content-between" style="font-size:11px;">
                            <span class="text-muted">Progress</span><span class="fw-bold">${pct}%</span>
                        </div>
                        <div class="progress-slim">
                            <div style="height:100%; width:${pct}%; background:${colorClass};"></div>
                        </div>
                    </td>
                </tr>`;
            }).join("");

           // Student Rows Data
            const studentGroups = {};
            (data.students || []).forEach(s => {
                if (!studentGroups[s.studentCode]) studentGroups[s.studentCode] = [];
                studentGroups[s.studentCode].push(s);
            });
            const studentRows = Object.entries(studentGroups).map(([code, rows]) => {
                const name = rows[0]?.studentName || "";

                // คำนวณค่า Total, Done, Left
                const total = rows.length;
                const done = rows.filter(r => r.isCompleted).length;
                const left = total - done;

                // คำนวณ % Progress (หาค่าเฉลี่ยของ Progress ทุกวิชา)
                const overallPct = Math.round(rows.reduce((a, r) => a + r.progress, 0) / rows.length);

                // กำหนดสีของหลอด Progress
                const colorClass = overallPct === 100 ? "var(--success-color)" : overallPct > 0 ? "var(--accent-color)" : "var(--border-color)";

                return `<tr>
                    <td class="align-middle">
                        <div class="fw-bold">${code}</div>
                        <div class="text-muted" style="font-size:11px;">${name}</div>
                    </td>
                    <td class="align-middle text-center">${total}</td>
                    <td class="align-middle text-center" style="color:var(--success-color)">${done}</td>
                    <td class="align-middle text-center">${left}</td>
                    <td class="align-middle" style="width:150px;">
                        <div class="d-flex justify-content-between" style="font-size:11px;">
                            <span class="text-muted">Progress</span><span class="fw-bold">${overallPct}%</span>
                        </div>
                        <div class="progress-slim">
                            <div style="height:100%; width:${overallPct}%; background:${colorClass};"></div>
                        </div>
                    </td>
                </tr>`;
            }).join("");

            // Format dates for display
            const displayStartDate = formatDate(data.startDate);
            const displayDueDate = formatDate(data.dueDate);

            // Inject HTML Layout
            document.getElementById("report-content").innerHTML = `
                <div class="row g-4 mb-5">

                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                            <h2 class="fs-6 fw-bold m-0 text-dark">Status Summary</h2>
                            <button class="btn btn-outline-primary btn-sm py-1 px-2" style="font-size: 11px;" onclick="exportSummaryImage()">
                                <i class="fas fa-download"></i> Save Image
                            </button>
                        </div>

                        <div id="export-target" class="bg-white p-4 border rounded ">
                            <div class="text-center mb-3">
                                <div class="small text-muted text-uppercase" style="letter-spacing: 0.5px;">Assignment No.</div>
                                <h3 class="fs-5 fw-bold m-0 text-dark">${data.assignmentNo || "-"}</h3>
                            </div>

                            <div class="text-center mb-4 bg-light p-2 rounded">
                                <i class="far fa-calendar-alt text-muted me-1"></i>
                                <span class="fw-bold" style="font-size: 12px;">${displayStartDate}</span>
                                <i class="fas fa-arrow-right text-muted mx-2" style="font-size: 10px;"></i>
                                <span class="fw-bold text-danger" style="font-size: 12px;">${displayDueDate}</span>
                            </div>

                            <div class="d-flex justify-content-around text-center border-bottom pb-4 mb-4">
                                <div>
                                    <div class="fs-4 fw-bold">${data.totalEmployees}</div>
                                    <div class="small text-muted">Students</div>
                                </div>
                                <div>
                                    <div class="fs-4 fw-bold">${data.totalCourses}</div>
                                    <div class="small text-muted">Courses</div>
                                </div>
                                <div>
                                    <div class="fs-4 fw-bold" style="color: var(--success-color);">${data.completionRate}%</div>
                                    <div class="small text-muted">Completion</div>
                                </div>
                            </div>

                            <div id="report-pie-chart" style="height: 220px;"></div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="border-bottom pb-2 mb-3">
                            <h2 class="fs-6 fw-bold m-0 text-dark">Course Overview</h2>
                        </div>
                        <div class="border rounded overflow-hidden bg-white ">
                            <table class="table table-hover m-0">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Course</th>
                                        <th class="text-center">Total</th>
                                        <th class="text-center">Done</th>
                                        <th class="text-center">Left</th>
                                        <th>Progress</th>
                                    </tr>
                                </thead>
                                <tbody>${courseRows}</tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-5">
                    <div class="border-bottom pb-2 mb-3">
                        <h2 class="fs-6 fw-bold m-0 text-dark">Student × Course Matrix</h2>
                    </div>
                    ${buildPivotTable(data.courses, data.students)}
                </div>

                <div class="mb-5">
                    <div class="border-bottom pb-2 mb-3">
                        <h2 class="fs-6 fw-bold m-0 text-dark">Student Tracking</h2>
                    </div>
                    <div class="border rounded overflow-hidden bg-white ">
                        <table class="table table-hover m-0">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th class="text-center">Total</th>
                                    <th class="text-center">Done</th>
                                    <th class="text-center">Left</th>
                                    <th>Progress</th>
                                </tr>
                            </thead>
                            <tbody>${studentRows}</tbody>
                        </table>
                    </div>
                </div>
            `;

            // Render Chart (Clean Palette)
            $("#report-pie-chart").dxPieChart({
                type: "doughnut", innerRadius: 0.7,
                palette: ["#52c41a", "#faad14", "#d9d9d9"],
                dataSource: [
                    { status: "Completed",   count: cd.completed  },
                    { status: "In Progress", count: cd.inProgress },
                    { status: "Not Started", count: cd.notStarted }
                ],
                series: [{
                    argumentField: "status", valueField: "count",
                    label: {
                        visible: true,
                        position: "outside",
                        customizeText: p => `${p.valueText} (${p.percentText})`,
                        font: { size: 11, color: "#595959" },
                        connector: { visible: true, width: 1 }
                    }
                }],
                legend: {
                    horizontalAlignment: "right", verticalAlignment: "center",
                    margin: 0, font: { size: 12, color: "#595959" }
                },
                tooltip: { enabled: true }
            });
        }

        // ─── Component: Export Image Function ───
        function exportSummaryImage() {
            const targetDiv = document.getElementById("export-target");
            html2canvas(targetDiv, {
                scale: 2,
                backgroundColor: "#ffffff",
                logging: false
            }).then(canvas => {
                const link = document.createElement("a");
                link.download = `Assignment_Summary_${ASSIGNMENT_ID}.png`;
                link.href = canvas.toDataURL("image/png");
                link.click();
            }).catch(err => {
                console.error("Error generating image:", err);
                alert("ไม่สามารถบันทึกรูปภาพได้ กรุณาลองใหม่อีกครั้ง");
            });
        }
    </script>
</body>
</html>