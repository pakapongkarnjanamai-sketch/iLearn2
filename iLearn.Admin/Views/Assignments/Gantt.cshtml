@{
    ViewBag.Title = "Assignment Schedule";
}

@section ExternalDependencies {
    <link href="~/css/devextreme/dx-gantt.min.css" rel="stylesheet" />
}

@section PreDxScripts {
    <script src="~/js/devextreme/dx-gantt.min.js"></script>
}

<style>
    #gantt-container { height: calc(100vh - 220px); }

    /* ?? Toolbar strip ?? */
    .gantt-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border-color);
        background: #fff;
    }
    .gantt-filter-btn {
        padding: 4px 12px;
        font-size: 12px;
        border-radius: 14px;
        border: 1px solid var(--border-color);
        background: #fff;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all .15s;
    }
    .gantt-filter-btn.active,
    .gantt-filter-btn:hover {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #fff;
    }
    .gantt-filter-btn.btn-all.active    { background:#595959; border-color:#595959; }
    .gantt-filter-btn.btn-inprogress.active { background:var(--accent-color);  border-color:var(--accent-color); }
    .gantt-filter-btn.btn-upcoming.active   { background:var(--warning-color); border-color:var(--warning-color); }
    .gantt-filter-btn.btn-expired.active    { background:var(--danger-color);  border-color:var(--danger-color); }
    .gantt-filter-btn.btn-completed.active  { background:var(--success-color); border-color:var(--success-color); }

    /* ?? KPI row ?? */
    .gantt-kpi-row {
        display: flex;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border-color);
        background: #fafafa;
        flex-wrap: wrap;
    }
    .gantt-kpi {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--text-secondary);
    }
    .gantt-kpi .dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .gantt-kpi .val { font-weight: 700; color: var(--text-primary); }

    /* ?? Legend ?? */
    .gantt-legend {
        display: flex;
        gap: 16px;
        align-items: center;
        padding: 8px 16px 0;
        flex-wrap: wrap;
        font-size: 11px;
        color: var(--text-secondary);
    }
    .legend-item { display: flex; align-items: center; gap: 5px; }
    .legend-bar  { width: 22px; height: 9px; border-radius: 3px; }
</style>

<!-- ?? Page Header ?? -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Assignment Schedule</div>
        <div class="text-secondary" style="font-size:12px;">Gantt view – overview and planning</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-table text-secondary"></i> List View
        </a>
        <a href="@Url.Action("Form", "Assignments")" class="action-link primary">
            <i class="fas fa-plus"></i> New Assignment
        </a>
    </div>
</div>

<div class="container-fluid px-0 py-0">

    <div class="border rounded bg-white mx-4 mt-3 mb-4" style="overflow:hidden;">

        <!-- ?? KPI bar ?? -->
        <div class="gantt-kpi-row" id="kpi-row">
            <div class="gantt-kpi">
                <span class="dot" style="background:#595959"></span>
                All: <span class="val" id="kpi-all">—</span>
            </div>
            <div class="gantt-kpi">
                <span class="dot" style="background:var(--accent-color)"></span>
                In Progress: <span class="val" id="kpi-inprogress">—</span>
            </div>
            <div class="gantt-kpi">
                <span class="dot" style="background:var(--warning-color)"></span>
                Upcoming: <span class="val" id="kpi-upcoming">—</span>
            </div>
            <div class="gantt-kpi">
                <span class="dot" style="background:var(--danger-color)"></span>
                Expired: <span class="val" id="kpi-expired">—</span>
            </div>
            <div class="gantt-kpi">
                <span class="dot" style="background:var(--success-color)"></span>
                Completed: <span class="val" id="kpi-completed">—</span>
            </div>
        </div>

        <!-- ?? Toolbar: scale + status filter ?? -->
        <div class="gantt-toolbar">
            <span style="font-size:12px;font-weight:600;color:var(--text-secondary);margin-right:4px;">Scale:</span>
            <div id="dx-scale-toolbar"></div>

            <div style="width:1px;height:22px;background:var(--border-color);margin:0 6px;"></div>

            <span style="font-size:12px;font-weight:600;color:var(--text-secondary);margin-right:4px;">Status:</span>
            <button class="gantt-filter-btn btn-all active"        onclick="applyFilter(null,this)">All</button>
            <button class="gantt-filter-btn btn-inprogress"        onclick="applyFilter('InProgress',this)">In Progress</button>
            <button class="gantt-filter-btn btn-upcoming"          onclick="applyFilter('Upcoming',this)">Upcoming</button>
            <button class="gantt-filter-btn btn-expired"           onclick="applyFilter('Expired',this)">Expired</button>
            <button class="gantt-filter-btn btn-completed"         onclick="applyFilter('Completed',this)">Completed</button>
        </div>

        <!-- ?? Legend ?? -->
        <div class="gantt-legend">
            <span class="legend-item"><span class="legend-bar" style="background:#1890ff"></span> In Progress</span>
            <span class="legend-item"><span class="legend-bar" style="background:#faad14"></span> Upcoming</span>
            <span class="legend-item"><span class="legend-bar" style="background:#ff4d4f"></span> Expired</span>
            <span class="legend-item"><span class="legend-bar" style="background:#52c41a"></span> Completed</span>
            <span class="legend-item"><span class="legend-bar" style="background:#aaaaaa"></span> No schedule</span>
        </div>

        <!-- ?? Gantt ?? -->
        <div id="gantt-container"></div>

    </div>
</div>

@section Scripts {
<script>
    let allTasks   = [];
    let activeStatus = null;
    let ganttInstance;

    // ?? KPI counts (parent tasks only) ???????????????????????????
    function updateKpi(tasks) {
        const parents = tasks.filter(t => t.parentId === 0);
        $("#kpi-all").text(parents.length);
        $("#kpi-inprogress").text(parents.filter(t => t.status === "InProgress").length);
        $("#kpi-upcoming").text(parents.filter(t => t.status === "Upcoming").length);
        $("#kpi-expired").text(parents.filter(t => t.status === "Expired").length);
        $("#kpi-completed").text(tasks.filter(t => t.status === "Completed" && t.parentId === 0).length);
    }

    // ?? Filter: keep matched parents + their children ?????????????
    function applyFilter(status, el) {
        activeStatus = status;
        $(".gantt-filter-btn").removeClass("active");
        $(el).addClass("active");
        rebuildGantt();
    }

    function getFilteredTasks() {
        if (!activeStatus) return allTasks;

        const matchedParentIds = new Set(
            allTasks
                .filter(t => t.parentId === 0 && t.status === activeStatus)
                .map(t => t.id)
        );

        return allTasks.filter(t =>
            (t.parentId === 0 && matchedParentIds.has(t.id)) ||
            (t.parentId !== 0 && matchedParentIds.has(t.parentId))
        );
    }

    // ?? Build / rebuild the Gantt with current data ???????????????
    function rebuildGantt() {
        const filtered = getFilteredTasks();

        if (ganttInstance) {
            ganttInstance.option("tasks.dataSource", filtered);
            return;
        }

        ganttInstance = $("#gantt-container").dxGantt({
            tasks: {
                dataSource: filtered,
                keyExpr:      "id",
                parentIdExpr: "parentId",
                titleExpr:    "title",
                startExpr:    "start",
                endExpr:      "end",
                progressExpr: "progress",
                colorExpr:    "color"
            },
            rootValue: 0,
            scaleType: "weeks",
            scaleTypeRange: { min: "days", max: "years" },
            taskTitlePosition: "outside",
            showResources: false,
            showDependencies: false,
            showRowLines: true,
            height: "100%",
            editing: { enabled: false },
            toolbar: {
                items: ["zoomIn", "zoomOut", "separator", "expandAll", "collapseAll", "separator", "fullScreen"]
            },
            columns: [
                { dataField: "title",    caption: "Assignment / Course",  width: 280 },
                { dataField: "start",    caption: "Start",   dataType: "date", format: "dd/MM/yyyy", width: 95 },
                { dataField: "end",      caption: "Due",     dataType: "date", format: "dd/MM/yyyy", width: 95 },
                {
                    caption: "Progress", width: 70, alignment: "center",
                    calculateCellValue: d => d.progress + "%"
                }
            ],
            onTaskClick: function (e) {
                if (e.data && e.data.parentId === 0 && e.data.rawId) {
                    window.location.href = "@Url.Action("Progress", "Assignments")/" + e.data.rawId;
                }
            }
        }).dxGantt("instance");
    }

    // ?? Scale toolbar (dxSelectBox) ???????????????????????????????
    function initScaleToolbar() {
        $("#dx-scale-toolbar").dxSelectBox({
            items: [
                { value: "days",    text: "Days"    },
                { value: "weeks",   text: "Weeks"   },
                { value: "months",  text: "Months"  },
                { value: "quarters",text: "Quarters"},
                { value: "years",   text: "Years"   }
            ],
            valueExpr: "value",
            displayExpr: "text",
            value: "weeks",
            width: 110,
            height: 28,
            stylingMode: "outlined",
            onValueChanged: function (e) {
                if (ganttInstance) ganttInstance.option("scaleType", e.value);
            }
        });
    }

    // ?? Bootstrap ?????????????????????????????????????????????????
    $(() => {
        initScaleToolbar();

        $.ajax({
            url: `${serviceUrl}/Assignments/gantt`,
            method: "GET",
            xhrFields: { withCredentials: true }
        }).done(function (res) {
            allTasks = Array.isArray(res) ? res : [];
            updateKpi(allTasks);
            rebuildGantt();
        }).fail(() => DevExpress.ui.notify("Error loading Gantt data.", "error", 3000));
    });
</script>
}
