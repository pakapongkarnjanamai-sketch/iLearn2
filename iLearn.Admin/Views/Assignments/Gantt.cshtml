@{
    ViewBag.Title = "Assignment Schedule";
}

@section ExternalDependencies {
    <link href="~/css/devextreme/dx-gantt.min.css" rel="stylesheet" />
}

@section PreDxScripts {
    <script src="~/js/devextreme/dx-gantt.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <div class="page-title">Assignment Schedule</div>
        <div class="page-subtitle">Read-only Gantt View</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-table text-secondary"></i> List View
        </a>
    </div>
</div>

<div class="container-fluid px-0 py-0">
    <div class="border rounded bg-white mx-4 p-3 mb-4">
        <div id="gantt-container" style="height: calc(100vh - 180px);"></div>
    </div>
</div>

@section Scripts {
    <script>
        // 💡 ตั้งค่า jsPDF ให้ DevExtreme รู้จัก
        window.jsPDF = window.jspdf.jsPDF;

        $(() => {
            // 1. ดึงข้อมูลจาก API
            $.ajax({
                url: `${serviceUrl}/Assignments/gantt`,
                method: "GET",
                xhrFields: { withCredentials: true }
            }).done(function (res) {

                // 💡 กรองเอาเฉพาะ "ตัวแม่" (กรณีที่ API ยังส่งตัวลูกมาด้วย)
                const parentTasksOnly = Array.isArray(res) ? res.filter(t => t.parentId === 0) : [];

                // 2. แปลงข้อมูลวันที่ให้ถูกต้องตามฟิลด์ที่ API ส่งมา (startDate, dueDate)
                const tasks = parentTasksOnly.map(t => ({
                    ...t,
                    // API ส่ง title ที่มีรหัสงานมาให้แล้ว เราสามารถใช้ตรงๆ ได้ หรือจะจัดรูปแบบใหม่ก็ได้
                    displayTitle: t.assignmentNo ? `${t.assignmentNo} - ${t.title || ''}` : t.title,
                    startDate: t.startDate ? new Date(t.startDate) : new Date(),
                    dueDate: t.dueDate ? new Date(t.dueDate) : new Date()
                }));

                // 3. สร้าง Gantt แบบ Read-only พร้อมปุ่ม Export
                $("#gantt-container").dxGantt({
                    tasks: {
                        dataSource: tasks,
                        keyExpr: "id",
                        parentIdExpr: "parentId",
                        titleExpr: "title",      // ใช้ title ที่ API ส่งมา (รวม AssignmentNo ไว้แล้ว)
                        startExpr: "startDate",  // ดึงค่า startDate ที่แปลงแล้ว
                        endExpr: "dueDate",      // ดึงค่า dueDate ที่แปลงแล้ว
                        progressExpr: "progress",
                        colorExpr: "color"
                    },
                    rootValue: 0,
                    scaleType: "months", // เริ่มต้นที่รายเดือน
                    scaleTypeRange: { min: "months", max: "years" }, // ล็อกไม่ให้ซูมลึกกว่ารายเดือน
                    taskTitlePosition: "outside", // เอาชื่อและรหัสงานไปไว้ข้างนอกแท่ง
                    showResources: false,
                    showDependencies: false,
                    showRowLines: true,

                    // 💡 ปิดการแก้ไข และไม่อนุญาตให้คลิกเลือก (Read-only 100%)
                    editing: { enabled: false },
                    allowSelection: false,

                    // 💡 ล็อกความกว้างของแผงตารางด้านซ้ายให้กว้างพอดีกับ 3 คอลัมน์
                    taskListWidth: 350,
                    columns: [
                        { dataField: "assignmentNo", caption: "Assignment No.", width: 130 },
                        { dataField: "startDate",    caption: "Start",   dataType: "date", format: "dd/MM/yyyy", width: 95 },
                        { dataField: "dueDate",      caption: "Due",     dataType: "date", format: "dd/MM/yyyy", width: 95 }
                    ],

                    // 💡 เพิ่มปุ่ม Export สีเด่นๆ ลงใน Toolbar
                    toolbar: {
                        items: [
                            "zoomIn", "zoomOut", "separator", "expandAll", "collapseAll", "separator", "fullScreen",
                            "separator",
                            {
                                widget: "dxButton",
                                options: {
                                    icon: "exportpdf",
                                    text: "Export PDF",
                                    hint: "Export Gantt Chart to PDF",
                                    type: "default",          // ทำให้ปุ่มเป็นสีน้ำเงิน
                                    stylingMode: "contained",
                                    onClick: function () {
                                        const ganttInstance = $("#gantt-container").dxGantt("instance");
                                        const doc = new jsPDF("landscape"); // ตั้งกระดาษเป็นแนวนอน

                                        DevExpress.pdfExporter.exportGantt({
                                            jsPDFDocument: doc,
                                            component: ganttInstance
                                        }).then(function() {
                                            doc.save("Assignment_Schedule.pdf");
                                        });
                                    }
                                }
                            }
                        ]
                    }
                });

            }).fail(() => DevExpress.ui.notify("Error loading Gantt data.", "error", 3000));
        });
    </script>
}