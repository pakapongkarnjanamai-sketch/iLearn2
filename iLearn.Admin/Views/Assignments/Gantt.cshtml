@{
    ViewBag.Title = "Assignment Schedule";
}

@section ExternalDependencies {
    <link href="~/css/devextreme/dx-gantt.min.css" rel="stylesheet" />
}

@section PreDxScripts {
    <script src="~/js/devextreme/dx-gantt.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <div class="page-title">Assignment Schedule</div>
        <div class="page-subtitle">Read-only Gantt View</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-table text-secondary"></i> List View
        </a>
    </div>
</div>

<div class="container-fluid px-0 py-0">
    <div class="border rounded bg-white mx-4 p-3 mb-4">
        <div id="gantt-container" style="height: calc(100vh - 180px);"></div>
    </div>
</div>

@section Scripts {
    <script>
        const ASSIGNMENTS_GANTT_URL = `${serviceUrl}/Assignments/gantt`;

        window.jsPDF = window.jspdf.jsPDF;

        function normalizeGanttTasks(items) {
            if (!Array.isArray(items)) {
                return [];
            }

            return items.map(item => ({
                ...item,
                startDate: item.startDate ? new Date(item.startDate) : new Date(),
                dueDate: item.dueDate ? new Date(item.dueDate) : new Date()
            }));
        }

        $(() => {
            $.ajax({
                url: ASSIGNMENTS_GANTT_URL,
                method: "GET",
                xhrFields: { withCredentials: true }
            }).done(function (res) {
                const tasks = normalizeGanttTasks(res);

                $("#gantt-container").dxGantt({
                    tasks: {
                        dataSource: tasks,
                        keyExpr: "id",
                        parentIdExpr: "parentId",
                        titleExpr: "title",
                        startExpr: "startDate",
                        endExpr: "dueDate",
                        progressExpr: "progress",
                        colorExpr: "color"
                    },
                    rootValue: 0,
                    scaleType: "months",
                    scaleTypeRange: { min: "months", max: "years" },
                    taskTitlePosition: "outside",
                    showResources: false,
                    showDependencies: false,
                    showRowLines: true,
                    editing: { enabled: false },
                    allowSelection: false,
                    taskListWidth: 350,
                    columns: [
                        { dataField: "assignmentNo", caption: "Assignment No.", width: 130 },
                        { dataField: "startDate",    caption: "Start",   dataType: "date", format: "dd/MM/yyyy", width: 95 },
                        { dataField: "dueDate",      caption: "Due",     dataType: "date", format: "dd/MM/yyyy", width: 95 }
                    ],
                    toolbar: {
                        items: [
                            "zoomIn", "zoomOut", "separator", "expandAll", "collapseAll", "separator", "fullScreen",
                            "separator",
                            {
                                widget: "dxButton",
                                options: {
                                    icon: "exportpdf",
                                    text: "Export PDF",
                                    hint: "Export Gantt Chart to PDF",
                                    type: "default",
                                    stylingMode: "contained",
                                    onClick: function () {
                                        const ganttInstance = $("#gantt-container").dxGantt("instance");
                                        const doc = new jsPDF("landscape");

                                        DevExpress.pdfExporter.exportGantt({
                                            jsPDFDocument: doc,
                                            component: ganttInstance
                                        }).then(function() {
                                            doc.save("Assignment_Schedule.pdf");
                                        });
                                    }
                                }
                            }
                        ]
                    }
                });

            }).fail(() => showToast("Error loading Gantt data.", "error"));
        });
    </script>
}