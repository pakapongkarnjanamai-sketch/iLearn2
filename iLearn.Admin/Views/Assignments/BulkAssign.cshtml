@{
    ViewBag.Title = "Bulk Course Assignments";
    var preselectedCourseId = Context.Request.Query["courseId"].ToString();
    var preselectedCourseIds = Context.Request.Query["courseIds"].ToString();
    var preselectedGroupId = Context.Request.Query["groupId"].ToString();
    var preselectedDescription = Context.Request.Query["description"].ToString();
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    /* ── Unique: Target Mode ── */
    .assign-target-mode-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .target-mode-btn {
        background: var(--surface-subtle);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        cursor: pointer;
        font-size: var(--font-size-xs);
        font-weight: 500;
        padding: 2px var(--space-sm);
        transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    }

    .target-mode-btn:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .target-mode-btn.active {
        background: var(--primary-color);
        color: var(--text-inverse);
    }

    /* ── Unique: Conflict Lists ── */
    .assign-review-card,
    .assign-conflict-card {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--surface-base);
        padding: var(--space-md);
    }

    .assign-conflict-card + .assign-conflict-card {
        margin-top: 12px;
    }

    .assign-conflict-list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: clamp(120px, calc(100vh - 520px), 200px);
        overflow-y: auto;
    }

    .assign-conflict-list li {
        padding: 0 0 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--border-color);
    }

    .assign-conflict-list li:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    /* ── Unique: Scrollable review tables ── */
    .assign-review-table-wrap {
        --admin-table-wrap-max-height: clamp(160px, calc(100vh - 600px), 260px);
    }

    /* ── Form Overrides ── */
    .dx-layout-manager .dx-field-item {
        padding-bottom: 12px;
    }

    .dx-texteditor-input,
    .dx-texteditor-input-container {
        font-size: var(--font-size-sm);
    }

    /* Inline grid wrappers in selection panels — fill height when shared viewport rules apply. */
    @@media (min-width: 768px) {
        body .admin-review-flow.is-selection-step .admin-wizard-panel--selection-fill.active .assign-inline-grid,
        body .admin-review-flow.is-selection-step .admin-wizard-panel--selection-fill.active .assign-inline-grid > .dx-widget {
            display: flex;
            flex: 1 1 auto;
            flex-direction: column;
            min-height: 0;
        }
    }
</style>

