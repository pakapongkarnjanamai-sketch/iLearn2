<!-- ── Wizard buttons moved to page-header above. ── -->

@section Scripts {
    <script>
        const initialCourseId = '@preselectedCourseId';
        const initialCourseIds = '@preselectedCourseIds';
        const initialGroupId = '@preselectedGroupId';
        const initialDescription = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(preselectedDescription ?? ""))';
        const ASSIGNMENT_VALIDATE_URL = `${serviceUrl}/Assignments/validate-before-assign`;
        const BULK_ASSIGN_URL = `${serviceUrl}/Enrollments/BulkAssign`;
        const ASSIGNMENT_DETAIL_URL = `@Url.Action("Detail", "Assignments")`;
        const EMPTY_TEXT = "—";
        const MAX_VISIBLE_SELECTION_CHIPS = 12;

        // Height Settings
        const DESCRIPTION_FIELD_HEIGHT = 96;
        const COURSE_GRID_HEIGHT = 560;
        const STUDENT_GRID_HEIGHT = 540;
        const GROUP_GRID_HEIGHT = 540;

        const hasPreselectedGroupId = Boolean(initialGroupId);

        let selectedCourseIds = initialCourseIds
            ? initialCourseIds.split(',').map(id => parseInt(id, 10)).filter(id => !isNaN(id))
            : initialCourseId ? [parseInt(initialCourseId, 10)] : [];
        let selectedStudentCodes = [];
        let selectedGroupId = null;
        let selectedGroupName = null;
        let selectedGroupMemberCount = 0;
        let currentTargetMode = 'individual'; // 'individual' or 'group'
        let currentPayload = null;
        let form;
        let loadPanel;
        let courseGrid;
        let studentGrid;
        let groupGrid;
        const courseDataCache = new Map();
        const studentDataCache = new Map();
        let studentGridInitialized = false;
        let groupGridInitialized = false;
        let reviewForm;

        $(() => {
            loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)", position: { of: "body" }, visible: false, shading: true
            }).dxLoadPanel("instance");

            form = $("#form-assignment").dxForm({
                labelMode: "floating",
                formData: { description: initialDescription || "", dateRange: [null, null] },
                items: [
                    {
                        dataField: "description",
                        editorType: "dxTextArea",
                        validationRules: [{ type: "required", message: "Required" }],
                        editorOptions: { height: DESCRIPTION_FIELD_HEIGHT, onValueChanged: updateSnapshotFromForm }
                    },
                    {
                        dataField: "dateRange",
                        label: { text: "Schedule" },
                        editorType: "dxDateRangeBox",
                        validationRules: [{ type: "required", message: "Required" }],
                        editorOptions: {
                            width: "100%",
                            displayFormat: ADMIN_DATE_DISPLAY_FORMAT,
                            startDateLabel: "Start Date",
                            endDateLabel: "Due Date",
                            onValueChanged: updateSnapshotFromForm
                        }
                    }
                ]
            }).dxForm("instance");

            initializeCourseSelection();
            initializeReviewForm();
            updateSnapshotFromForm();
            updateCourseSelectionUi();
            updateStudentSelectionUi();
            updateGroupSelectionUi();
            renderCourseSelectionTray();
            renderStudentSelectionTray();
            updateWizardUi(1);

            $("#btn-reset-group").click(() => clearGroupSelection(true));
            $("#course-tray-clear").on("click", function() {
                if (courseGrid) { courseGrid.clearSelection(); }
            });
            $("#student-tray-clear").on("click", function() {
                if (studentGrid) { studentGrid.clearSelection(); }
            });

            if (initialGroupId) {
                switchTargetMode('group');
                $.ajax({
                    url: `${serviceUrl}/StudentGroups/${initialGroupId}`,
                    method: "GET",
                    xhrFields: { withCredentials: true }
                }).done(function(res) {
                    if (res.data) {
                        selectedGroupId = res.data.id;
                        selectedGroupName = res.data.name;
                        selectedGroupMemberCount = (res.data.members || []).length;
                        if (groupGrid) {
                            groupGrid.option("selectedRowKeys", [res.data.id]);
                        }
                        updateGroupSelectionUi();
                    }
                });
            }

            function initializeReviewForm() {
                reviewForm = $("#form-review-details").dxForm({
                    readOnly: true,
                    labelMode: "floating",
                    stylingMode: "outlined",
                    colCount: 2,
                    formData: { description: "", startDate: EMPTY_TEXT, dueDate: EMPTY_TEXT, targetMode: "", target: "" },
                    items: [
                        {
                            dataField: "description",
                            label: { text: "Description" },
                            colSpan: 2,
                            editorType: "dxTextArea",
                            editorOptions: { height: DESCRIPTION_FIELD_HEIGHT }
                        },
                        { dataField: "startDate", label: { text: "Start Date" } },
                        { dataField: "dueDate", label: { text: "Due Date" } },
                        { dataField: "targetMode", label: { text: "Target Type" } },
                        { dataField: "target", label: { text: "Target" } }
                    ]
                }).dxForm("instance");
            }

            function initializeCourseSelection() {
                courseGrid = initDxGrid("#grid-courses-inline", {
                    preset: "wizardSelectionContinuousGrid",
                    height: COURSE_GRID_HEIGHT,
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "id",
                        loadUrl: `${serviceUrl}/admin/CoursesCRUD/Get`,
                        onBeforeSend: function(method, ajaxOptions) {
                            ajaxOptions.xhrFields = { withCredentials: true };
                        }
                    }),
                    remoteOperations: true,
                    headerFilter: { visible: false },
                    filterRow: { visible: true },
                    searchPanel: { visible: false },
                    selection: { selectAllMode: 'allPages' },
                    noDataText: getNoDataText("courses"),
                    columns: [
                        {
                            dataField: "code", caption: "Code", minWidth: 160,
                            cellTemplate: function(container, options) {
                                $('<span>').addClass('tag-pill pill-default fw-bold').text(options.value).appendTo(container);
                            }
                        },
                        { dataField: "title", caption: "Course Title", minWidth: 180 },
                        {
                            dataField: "courseTypeName", caption: "Type", minWidth: 140, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (!options.value) {
                                    return;
                                }

                                $('<span>').addClass('tag-pill pill-info').text(options.value).appendTo(container);
                            }
                        }
                    ],
                    selectedRowKeys: selectedCourseIds,
                    onSelectionChanged: function(e) {
                        selectedCourseIds = e.selectedRowKeys;
                        (e.selectedRowsData || []).forEach(function(row) { courseDataCache.set(row.id, row); });
                        updateCourseSelectionUi();
                        renderCourseSelectionTray();
                    }
                });

                initAdminCourseFilters({
                    serviceUrl: serviceUrl,
                    gridInstance: courseGrid
                });
            }

            function initializeStudentSelection() {
                studentGrid = initDxGrid("#grid-students-inline", {
                    preset: "wizardSelectionContinuousGrid",
                    height: STUDENT_GRID_HEIGHT,
                    dataSource: DevExpress.data.AspNet.createStore({
                        key: "EId",
                        loadUrl: `${serviceUrl}/Students/Get`,
                        onBeforeSend: function(method, ajaxOptions) {
                            ajaxOptions.xhrFields = { withCredentials: true };
                        }
                    }),
                    remoteOperations: true,
                    headerFilter: { visible: false },
                    filterRow: { visible: true },
                    searchPanel: { visible: false },
                    selection: { selectAllMode: 'allPages' },
                    noDataText: getNoDataText("students"),
                    columns: [
                        {
                            dataField: "EId", caption: "ID", width: 95,
                            cellTemplate: function(container, options) {
                                $('<span>').addClass('tag-pill pill-default fw-bold').text(options.value).appendTo(container);
                            }
                        },
                        {
                            caption: "Name", minWidth: 160,
                            calculateCellValue: (d) => [d.EnglishFirstName, d.EnglishLastName].filter(Boolean).join(" "),
                            cssClass: "fw-medium text-dark"
                        },
                        {
                            dataField: "Position", caption: "Position", width: 90, alignment: "center",
                            cellTemplate: function(container, options) {
                                if (!options.value) {
                                    return;
                                }

                                $('<span>').addClass('tag-pill pill-default').text(options.value).appendTo(container);
                            }
                        },
                        { dataField: "Department", caption: "Dept.", width: 90 },
                        { dataField: "Section", caption: "Section", minWidth: 120,
                            cssClass: "cell-muted",
                            customizeText: function(e) { return e.value || EMPTY_TEXT; }
                        }
                    ],
                    selectedRowKeys: selectedStudentCodes,
                    onSelectionChanged: function(e) {
                        selectedStudentCodes = e.selectedRowKeys;
                        (e.selectedRowsData || []).forEach(function(row) { studentDataCache.set(String(row.EId), row); });
                        updateStudentSelectionUi();
                        renderStudentSelectionTray();
                    }
                });

                initAdminStudentOrgFilters({
                    studentsBaseUrl: `${serviceUrl}/Students`,
                    gridInstance: studentGrid,
                    divSelector: "#filter-emp-div",
                    deptSelector: "#filter-emp-dept",
                    sectionSelector: "#filter-emp-section",
                    positionSelector: "#filter-emp-position",
                    clearSelector: "#btn-clear-emp-filter"
                });
            }

            function initializeGroupSelection() {
                groupGrid = initDxGrid("#grid-groups-inline", {
                    preset: "wizardSelectionContinuousGrid",
                    height: GROUP_GRID_HEIGHT,
                    dataSource: new DevExpress.data.CustomStore({
                        key: "id",
                        loadMode: "raw",
                        load: () => $.ajax({
                            url: `${serviceUrl}/StudentGroups`,
                            method: "GET",
                            xhrFields: { withCredentials: true }
                        }).then(function(res) {
                            return res?.data || [];
                        })
                    }),
                    remoteOperations: false,
                    filterRow: { visible: true },
                    searchPanel: { visible: false },
                    noDataText: getNoDataText("student groups"),
                    export: { enabled: false },
                    selection: {
                        mode: "single",
                        showCheckBoxesMode: "always",
                        allowSelectAll: false
                    },
                    columns: [
                        { dataField: "name", caption: "Group Name", minWidth: 200,
                            cssClass: "fw-medium text-dark"
                        },
                        { dataField: "description", caption: "Description", minWidth: 200,
                            cssClass: "cell-muted",
                            customizeText: function(e) { return e.value || EMPTY_TEXT; }
                        },
                        { dataField: "memberCount", caption: "Members", width: 100, alignment: "center",
                            cellTemplate: function(container, options) {
                                $('<span>').addClass('tag-pill pill-info fw-bold').text(options.value || 0).appendTo(container);
                            }
                        }
                    ],
                    selectedRowKeys: selectedGroupId ? [selectedGroupId] : [],
                    onSelectionChanged: function(e) {
                        const selectedGroup = (e.selectedRowsData || [])[0] || null;
                        if (selectedGroup) {
                            selectedGroupId = selectedGroup.id;
                            selectedGroupName = selectedGroup.name;
                            selectedGroupMemberCount = selectedGroup.memberCount || 0;
                        } else {
                            selectedGroupId = null;
                            selectedGroupName = null;
                            selectedGroupMemberCount = 0;
                        }
                        updateGroupSelectionUi();
                    }
                });
            }

            function switchTargetMode(mode) {
                currentTargetMode = mode;
                $(".target-mode-btn").removeClass("active");
                $(`#mode-${mode}`).addClass("active");
                if (mode === 'individual') {
                    $("#target-panel-individual").removeClass("d-none");
                    $("#target-panel-group").addClass("d-none");
                } else {
                    $("#target-panel-individual").addClass("d-none");
                    $("#target-panel-group").removeClass("d-none");
                }
                updateTargetModeNote();
                refreshVisibleSelectionGrids();
            }

            window.switchTargetMode = switchTargetMode;
            $("#mode-individual").on("click", function() { switchTargetMode("individual"); });
            $("#mode-group").on("click", function() { switchTargetMode("group"); });

            function refreshGridInstance(gridInstance) {
                if (!gridInstance) {
                    return;
                }

                gridInstance.repaint();
                gridInstance.updateDimensions();
            }

            function refreshVisibleSelectionGrids() {
                window.requestAnimationFrame(function() {
                    const currentStep = getCurrentStep();

                    if (currentStep === 1) {
                        refreshGridInstance(courseGrid);
                        return;
                    }

                    if (currentStep !== 2) {
                        return;
                    }

                    if (currentTargetMode === 'group') {
                        refreshGridInstance(groupGrid);
                        return;
                    }

                    refreshGridInstance(studentGrid);
                });
            }

            function clearGroupSelection(shouldClearGrid) {
                selectedGroupId = null;
                selectedGroupName = null;
                selectedGroupMemberCount = 0;
                if (shouldClearGrid && groupGrid) {
                    groupGrid.clearSelection();
                }
                updateGroupSelectionUi();
            }

            function clearCourseSelection() {
                selectedCourseIds = [];
                courseDataCache.clear();
                if (courseGrid) {
                    courseGrid.clearSelection();
                }
                updateCourseSelectionUi();
                renderCourseSelectionTray();
            }

            function updateCourseSelectionUi() {
                const count = selectedCourseIds.length;
                $("#course-selection-note").text(count > 0
                    ? window.formatAdminCountLabel(count, 'course')
                    : "0 course");
                $("#snapshot-course-count").text(window.formatAdminCountLabel(count, 'course'));
                updateTargetSnapshot();
            }

            function updateStudentSelectionUi() {
                const count = selectedStudentCodes.length;
                $("#student-selection-note").text(count > 0
                    ? window.formatAdminCountLabel(count, 'student')
                    : "0 student");
                updateTargetSnapshot();
            }

            function updateGroupSelectionUi() {
                $("#group-selection-note").text(selectedGroupId
                    ? window.formatAdminCountLabel(selectedGroupMemberCount, 'member')
                    : "0 group");
                $("#group-reset-row").toggleClass("d-none", !selectedGroupId);
                updateTargetSnapshot();
            }

            function updateTargetModeNote() {
                $("#target-selection-note").text(currentTargetMode === 'group'
                    ? "Choose one student group to assign the selected courses."
                    : "Select one or more students for this assignment batch.");
                updateTargetSnapshot();
            }

            function updateSnapshotFromForm() {
                const formData = form ? form.option("formData") : { description: initialDescription || "", dateRange: [null, null] };
                const [startDate, dueDate] = formData.dateRange || [null, null];
                $("#snapshot-description").text(formData.description || "No description");
                $("#snapshot-period").text(startDate || dueDate
                    ? `${window.formatAdminDate(startDate, EMPTY_TEXT)} — ${window.formatAdminDate(dueDate, EMPTY_TEXT)}`
                    : "Not set");
            }

            function updateTargetSnapshot() {
                const isGroupMode = currentTargetMode === 'group';
                const targetCount = isGroupMode ? selectedGroupMemberCount : selectedStudentCodes.length;
                const targetName = isGroupMode
                    ? (selectedGroupName || 'No group selected')
                    : (targetCount > 0 ? `${window.formatAdminCountLabel(targetCount, 'student')} selected` : 'No target selected');

                $("#snapshot-target-mode").text(isGroupMode ? 'Student group' : 'Individual students');
                $("#snapshot-target-count").text(window.formatAdminCountLabel(targetCount, 'student'));
                $("#snapshot-target-name").text(targetName);
            }

            function getApiErrorMessage(error, fallbackMessage) {
                return window.getApiErrorMessage(error, fallbackMessage);
            }

            function renderReviewStep(res, payload) {
                currentPayload = payload;
                const inProgress = res.inProgressConflicts || [];
                const completed  = res.completedConflicts  || [];
                const resolvedCount = res.resolvedCount || payload.employeeCodes.length || selectedGroupMemberCount || 0;
                currentPayload.inProgressConflicts = inProgress;
                currentPayload.completedConflicts = completed;

                const fmtDate = (d) => window.formatAdminDate(d, '—');
                const totalEnrollments = payload.courseIds.length * resolvedCount;

                $("#review-summary-cards").html([
                    buildSummaryCard(payload.courseIds.length, "Courses", "text-primary"),
                    buildSummaryCard(resolvedCount, payload.groupId ? "Group Members" : "Learners", "text-dark"),
                    buildSummaryCard(totalEnrollments, "Estimated Enrollments", "text-primary"),
                    buildSummaryCard(inProgress.length + completed.length, "Conflicts", (inProgress.length + completed.length) > 0 ? "u-text-warning" : "u-text-success")
                ].join(""));

                reviewForm.option("formData", {
                    description: payload.description || "",
                    startDate: fmtDate(payload.startDate),
                    dueDate: fmtDate(payload.dueDate),
                    targetMode: payload.groupId ? "Student Group" : "Individual Students",
                    target: payload.groupId
                        ? (selectedGroupName || "Selected group")
                        : window.formatAdminCountLabel(resolvedCount, "student")
                });

                // Courses table
                const courseRows = courseGrid ? (courseGrid.getSelectedRowsData() || []) : [];
                const courseCount = selectedCourseIds.length;
                $("#review-courses-note").text(window.formatAdminCountLabel(courseCount, "course"));
                $("#review-courses-table").html(buildCoursesReviewTable(courseRows));

                // Learners table
                if (payload.groupId) {
                    $("#review-learners-title").text("Target Group");
                    $("#review-learners-note").text(window.formatAdminCountLabel(resolvedCount, "member"));
                    $("#review-learners-table").html(buildGroupReviewPanel(selectedGroupName, resolvedCount));
                } else {
                    const studentRows = studentGrid ? (studentGrid.getSelectedRowsData() || []) : [];
                    const totalStudents = selectedStudentCodes.length;
                    $("#review-learners-title").text("Selected Learners");
                    $("#review-learners-note").text(window.formatAdminCountLabel(totalStudents, "student"));
                    $("#review-learners-table").html(buildLearnersReviewTable(studentRows, totalStudents));
                }

                $("#review-conflicts").html(buildConflictSections(inProgress, completed));
            }

            $("#btn-next-step").click(function () {
                const currentStep = getCurrentStep();

                if (currentStep === 1) {
                    if (selectedCourseIds.length === 0) {
                        showToast("Please select at least one course.", "error");
                        return;
                    }

                    updateWizardUi(hasPreselectedGroupId ? 3 : 2);
                    return;
                }

                if (currentStep === 2) {
                    if (currentTargetMode === 'individual' && selectedStudentCodes.length === 0) {
                        showToast("Please select at least one student.", "error");
                        return;
                    }

                    if (currentTargetMode === 'group' && !selectedGroupId) {
                        showToast("Please select a student group.", "error");
                        return;
                    }

                    updateWizardUi(3);
                }
            });

            $("#btn-prev-step").click(function () {
                const currentStep = getCurrentStep();
                if (currentStep > 1) {
                    if (hasPreselectedGroupId && currentStep === 3) {
                        updateWizardUi(1);
                        return;
                    }

                    updateWizardUi(currentStep - 1);
                }
            });

            $("#btn-review-step").click(async function () {
                if (!form.validate().isValid) {
                    return;
                }

                if (currentTargetMode === 'individual' && selectedStudentCodes.length === 0) {
                    showToast("Please select at least one student.", "error");
                    return;
                }

                if (currentTargetMode === 'group' && !selectedGroupId) {
                    showToast("Please select a student group.", "error");
                    return;
                }

                const isGroupMode = currentTargetMode === 'group';
                const formData = form.option('formData');
                const [rangeStart, rangeEnd] = formData.dateRange || [null, null];
                const payload = {
                    courseIds: selectedCourseIds,
                    employeeCodes: isGroupMode ? [] : selectedStudentCodes,
                    groupId: isGroupMode ? selectedGroupId : null,
                    startDate: rangeStart,
                    dueDate: rangeEnd,
                    description: formData.description,
                    confirmReassignInProgress: false,
                    confirmReassignCompleted: false
                };

                loadPanel.option("message", "Validating data...");
                loadPanel.show();

                try {
                    const response = await $.ajax({
                        url: ASSIGNMENT_VALIDATE_URL,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });

                    loadPanel.hide();
                    renderReviewStep(response, payload);
                    updateWizardUi(4);
                } catch {
                    loadPanel.hide();
                    showToast("Error connecting to validation service.", "error");
                }
            });

            $("#btn-confirm-assign").click(function () {
                if (!currentPayload) {
                    showToast("Please review the assignment summary first.", "warning");
                    return;
                }

                currentPayload.confirmReassignInProgress = (currentPayload.inProgressConflicts || []).length > 0;
                currentPayload.confirmReassignCompleted = (currentPayload.completedConflicts || []).length > 0;
                executeBulkAssign(currentPayload);
            });

            async function executeBulkAssign(payload) {
                loadPanel.option("message", "Assigning courses...");
                loadPanel.show();

                try {
                    const response = await $.ajax({
                        url: BULK_ASSIGN_URL,
                        method: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        xhrFields: { withCredentials: true }
                    });

                    showToast("Assigned successfully!", "success", 2000);
                    setTimeout(() => window.location.href = `${ASSIGNMENT_DETAIL_URL}/${response.assignmentId}`, 1500);
                } catch (err) {
                    showToast(`Error: ${getApiErrorMessage(err, "Failed to assign")}`, "error", 4000);
                    loadPanel.hide();
                }
            }

            function getCurrentStep() {
                return Number($(".admin-step-card.active").attr("data-step-card") || 1);
            }

            function getStepNote(step) {
                switch (step) {
                    case 1:
                        return 'Select the courses to include in this assignment.';
                    case 2:
                        return 'Choose the target learners for this assignment.';
                    case 3:
                        return 'Set the schedule and description for this batch.';
                    case 4:
                        return 'Review the summary before confirming the assignment batch.';
                    default:
                        return '';
                }
            }

            function updateWizardUi(step) {
                $(".admin-wizard-panel").removeClass("active");
                $(`#step-panel-${step}`).addClass("active");
                const layout = $(`#step-panel-${step}`).attr("data-step-layout") || "wide";
                $(".admin-wizard-shell")
                    .toggleClass("is-form-step", layout === "form")
                    .toggleClass("is-review-step", layout === "review");

                if (step === 2) {
                    if (!studentGridInitialized) {
                        initializeStudentSelection();
                        studentGridInitialized = true;
                    }
                    if (!groupGridInitialized) {
                        initializeGroupSelection();
                        groupGridInitialized = true;
                    }
                }

                $("[data-step-card]").each(function () {
                    const cardStep = Number($(this).attr("data-step-card"));
                    $(this)
                        .toggleClass("active", cardStep === step)
                        .toggleClass("complete", cardStep < step);
                    if (cardStep === step) {
                        $(this).attr("aria-current", "step");
                    } else {
                        $(this).removeAttr("aria-current");
                    }
                });

                $(".bottom-toolbar-note").html(`<i class="fas fa-info-circle text-muted me-1" aria-hidden="true"></i> ${getStepNote(step)}`);
                $("#btn-prev-step").toggleClass("d-none", step === 1);
                $("#btn-next-step").toggleClass("d-none", !(step === 1 || step === 2));
                $("#btn-review-step").toggleClass("d-none", step !== 3);
                $("#btn-confirm-assign").toggleClass("d-none", step !== 4);
                refreshVisibleSelectionGrids();
            }

            function renderCourseSelectionTray() {
                const ids = selectedCourseIds;
                const $clearBtn = $("#course-tray-clear");
                if (!ids.length) {
                    $("#course-tray-chips").html('<span class="admin-selection-tray-empty">No courses selected yet.</span>');
                    $clearBtn.addClass("is-disabled").prop("disabled", true);
                    return;
                }
                $clearBtn.removeClass("is-disabled").prop("disabled", false);
                const visibleIds = ids.slice(0, MAX_VISIBLE_SELECTION_CHIPS);
                const overflowCount = Math.max(ids.length - visibleIds.length, 0);
                const chips = visibleIds.map(function(id) {
                    const row = courseDataCache.get(id);
                    const code = row ? window.escapeHtml(row.code || String(id)) : String(id);
                    const name = row ? window.escapeHtml(row.title || "") : "";
                    const namePart = name
                        ? `<span class="assign-chip-sep">·</span><span class="assign-chip-name" title="${name}">${name}</span>`
                        : "";
                    return `<span class="assign-chip">
                        <span class="assign-chip-code">${code}</span>${namePart}
                        <button type="button" class="assign-chip-remove" data-id="${id}" aria-label="Remove ${code}"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </span>`;
                });

                if (overflowCount > 0) {
                    chips.push(`<span class="assign-chip is-overflow">+${overflowCount} more</span>`);
                }

                $("#course-tray-chips").html(chips.join(""));
                $("#course-tray-chips").off("click", ".assign-chip-remove").on("click", ".assign-chip-remove", function() {
                    const id = parseInt($(this).data("id"), 10);
                    if (courseGrid) { courseGrid.deselectRows([id]); }
                });
            }

            function renderStudentSelectionTray() {
                const codes = selectedStudentCodes;
                const $clearBtn = $("#student-tray-clear");
                if (!codes.length) {
                    $("#student-tray-chips").html('<span class="admin-selection-tray-empty">No learners selected yet.</span>');
                    $clearBtn.addClass("is-disabled").prop("disabled", true);
                    return;
                }
                $clearBtn.removeClass("is-disabled").prop("disabled", false);
                const visibleCodes = codes.slice(0, MAX_VISIBLE_SELECTION_CHIPS);
                const overflowCount = Math.max(codes.length - visibleCodes.length, 0);
                const chips = visibleCodes.map(function(code) {
                    const row = studentDataCache.get(String(code));
                    const normalizedCode = String(code || "");
                    const displayCode = window.escapeHtml(normalizedCode);
                    const encodedCode = encodeURIComponent(normalizedCode);
                    const name = row
                        ? window.escapeHtml([row.EnglishFirstName, row.EnglishLastName].filter(Boolean).join(" ") || "")
                        : "";
                    const namePart = name
                        ? `<span class="assign-chip-sep">·</span><span class="assign-chip-name" title="${name}">${name}</span>`
                        : "";
                    return `<span class="assign-chip">
                        <span class="assign-chip-code">${displayCode}</span>${namePart}
                        <button type="button" class="assign-chip-remove" data-code="${encodedCode}" aria-label="Remove ${displayCode}"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </span>`;
                });

                if (overflowCount > 0) {
                    chips.push(`<span class="assign-chip is-overflow">+${overflowCount} more</span>`);
                }

                $("#student-tray-chips").html(chips.join(""));
                $("#student-tray-chips").off("click", ".assign-chip-remove").on("click", ".assign-chip-remove", function() {
                    const code = decodeURIComponent(String($(this).attr("data-code") || ""));
                    if (studentGrid) { studentGrid.deselectRows([String(code)]); }
                });
            }

            function buildSummaryCard(value, label, className) {
                return buildAdminSummaryCard(value, label, className);
            }

            function buildCoursesReviewTable(rows) {
                if (!rows.length) {
                    return `<div class="admin-wizard-empty-state"><i class="fas fa-book" aria-hidden="true"></i><div>Course details not available for this view.</div></div>`;
                }

                const tableRows = rows.map(function(row, i) {
                    return `<tr>
                        <td>${i + 1}</td>
                        <td><span class="tag-pill pill-default fw-bold">${window.escapeHtml(row.code || EMPTY_TEXT)}</span></td>
                        <td class="fw-medium text-dark">${window.escapeHtml(row.title || EMPTY_TEXT)}</td>
                        <td><span class="tag-pill pill-info">${window.escapeHtml(row.courseTypeName || EMPTY_TEXT)}</span></td>
                    </tr>`;
                }).join('');

                return `<table class="admin-table">
                    <thead><tr><th>#</th><th>Code</th><th>Course Title</th><th>Type</th></tr></thead>
                    <tbody>${tableRows}</tbody>
                </table>`;
            }

            function buildLearnersReviewTable(rows, totalCount) {
                if (!rows.length) {
                    return totalCount > 0
                        ? `<div class="admin-wizard-empty-state"><i class="fas fa-users" aria-hidden="true"></i><div>${window.formatAdminCountLabel(totalCount, "student")} selected — detail view requires current page data.</div></div>`
                        : `<div class="admin-wizard-empty-state"><i class="fas fa-user" aria-hidden="true"></i><div>No learners selected.</div></div>`;
                }

                const tableRows = rows.map(function(row) {
                    const name = [row.EnglishFirstName, row.EnglishLastName].filter(Boolean).join(' ') || EMPTY_TEXT;
                    const org = [row.Department, row.Section].filter(Boolean).join(' / ') || EMPTY_TEXT;
                    return `<tr>
                        <td><span class="tag-pill pill-default fw-bold">${window.escapeHtml(row.EId || EMPTY_TEXT)}</span></td>
                        <td>
                            <div class="admin-student-name">${window.escapeHtml(name)}</div>
                        </td>
                        <td>${window.escapeHtml(row.Position || EMPTY_TEXT)}</td>
                    </tr>`;
                }).join('');

                return `<table class="admin-table">
                    <thead><tr><th>ID</th><th>Learner</th><th>Position</th></tr></thead>
                    <tbody>${tableRows}</tbody>
                </table>`;
            }

            function buildGroupReviewPanel(groupName, memberCount) {
                return `<div class="p-3 d-flex align-items-center gap-3">
                    <i class="fas fa-users fa-2x text-primary" aria-hidden="true"></i>
                    <div>
                        <div class="fw-semibold text-dark">${window.escapeHtml(groupName || EMPTY_TEXT)}</div>
                    </div>
                </div>`;
            }

            function buildConflictSections(inProgress, completed) {
                if (inProgress.length === 0 && completed.length === 0) {
                    return `
                        <div class="assign-review-card text-center">
                            <i class="fas fa-check-circle fa-2x mb-2 u-text-success"></i>
                            <div class="fw-bold text-dark">No conflicts found</div>
                            <div class="text-muted small">Ready to proceed.</div>
                        </div>`;
                }

                const sections = [];

                if (inProgress.length > 0) {
                    sections.push(`
                        <div class="assign-conflict-card">
                            <div class="fw-bold mb-2 text-dark"><i class="fas fa-exclamation-triangle text-warning me-2"></i>In-Progress Will Be Reset</div>
                            <ul class="assign-conflict-list">${inProgress.map(c => `
                                <li>
                                    <span class="tag-pill pill-default fw-bold">${c.studentCode}</span>
                                    <span class="text-muted mx-1">→</span>
                                    <span class="fw-medium">${c.courseTitle}</span>
                                </li>`).join('')}</ul>
                            <div class="text-muted small mt-2">Progress will be reset and learners will start over.</div>
                        </div>`);
                }

                if (completed.length > 0) {
                    sections.push(`
                        <div class="assign-conflict-card">
                            <div class="fw-bold mb-2 text-dark"><i class="fas fa-redo text-info me-2"></i>Completed Will Be Reassigned</div>
                            <ul class="assign-conflict-list">${completed.map(c => `
                                <li>
                                    <span class="tag-pill pill-default fw-bold">${c.studentCode}</span>
                                    <span class="text-muted mx-1">→</span>
                                    <span class="fw-medium">${c.courseTitle}</span>
                                    <span class="text-muted small ms-2"><i class="fas fa-check-circle me-1"></i>${window.formatAdminDate(c.completedDate, EMPTY_TEXT)}</span>
                                </li>`).join('')}</ul>
                            <div class="text-muted small mt-2">Previous history is retained and learners will be re-enrolled.</div>
                        </div>`);
                }

                return sections.join('');
            }
        });
    </script>
}