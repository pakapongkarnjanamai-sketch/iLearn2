@{
    ViewBag.Title = "Bulk Course Assignments";
    var preselectedCourseId = Context.Request.Query["courseId"].ToString();
    var preselectedCourseIds = Context.Request.Query["courseIds"].ToString();
    var preselectedGroupId = Context.Request.Query["groupId"].ToString();
    var preselectedDescription = Context.Request.Query["description"].ToString();
}

@section WizardStyles {
    <link href="~/css/admin-wizard.css" rel="stylesheet" asp-append-version="true" />
}

<style>
    /* ── Unique: Target Mode ── */
    .assign-target-mode-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .target-mode-btn {
        background: var(--surface-subtle);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        cursor: pointer;
        font-size: var(--font-size-xs);
        font-weight: 500;
        padding: 2px var(--space-sm);
        transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    }

    .target-mode-btn:hover {
        border-color: var(--primary-color);
        color: var(--primary-color);
    }

    .target-mode-btn.active {
        background: var(--primary-color);
        color: var(--text-inverse);
    }

    /* ── Unique: Conflict Lists ── */
    .assign-review-card,
    .assign-conflict-card {
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--surface-base);
        padding: var(--space-md);
    }

    .assign-conflict-card + .assign-conflict-card {
        margin-top: 12px;
    }

    .assign-conflict-list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: clamp(120px, calc(100vh - 520px), 200px);
        overflow-y: auto;
    }

    .assign-conflict-list li {
        padding: 0 0 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--border-color);
    }

    .assign-conflict-list li:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    /* ── Unique: Scrollable review tables ── */
    .assign-review-table-wrap {
        --admin-table-wrap-max-height: clamp(160px, calc(100vh - 600px), 260px);
    }

    /* ── Unique: Selection tray ── */
    .assign-selection-tray {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 8px 0 2px;
        border-top: 1px solid var(--border-color);
        margin-top: 6px;
    }

    .assign-tray-label {
        font-size: var(--font-size-xs);
        font-weight: 600;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding-top: 3px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .assign-tray-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        flex: 1;
        min-width: 0;
        max-height: 80px;
        overflow-y: auto;
    }

    .assign-chip {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--primary-subtle, #e6f0fb);
        color: var(--primary-dark, #003a8c);
        border: 1px solid color-mix(in srgb, var(--primary-color) 30%, transparent);
        border-radius: var(--radius-sm);
        font-size: var(--font-size-xs);
        font-weight: 500;
        padding: 2px 3px 2px 6px;
        max-width: 220px;
    }

    .assign-chip-code {
        font-weight: 700;
        flex-shrink: 0;
    }

    .assign-chip-sep {
        opacity: 0.5;
        flex-shrink: 0;
    }

    .assign-chip-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 130px;
    }

    .assign-chip-remove {
        background: none;
        border: none;
        cursor: pointer;
        color: inherit;
        opacity: 0.55;
        padding: 2px 4px;
        font-size: var(--font-size-micro);
        line-height: 1;
        border-radius: 2px;
        min-width: 20px;
        min-height: 20px;
        transition: opacity 0.1s, background 0.1s;
        flex-shrink: 0;
    }

    .assign-chip-remove:hover {
        opacity: 1;
        background: color-mix(in srgb, var(--primary-color) 12%, transparent);
    }

    .assign-chip.is-overflow {
        border-style: dashed;
        background: var(--surface-subtle);
        color: var(--text-secondary);
        font-weight: 600;
    }

    /* ── Form Overrides ── */
    .dx-layout-manager .dx-field-item {
        padding-bottom: 12px;
    }

    .dx-texteditor-input,
    .dx-texteditor-input-container {
        font-size: var(--font-size-sm);
    }

    /* ── Responsive ── */

</style>

<!-- ── Page Header ── -->
<div class="page-header admin-page-header--wizard d-flex flex-wrap gap-3 mb-0">
    <h1 class="page-title"><i class="fas fa-tasks text-primary me-2" aria-hidden="true"></i>Bulk Course Assignments</h1>
    <div class="admin-wizard-steps admin-wizard-steps--inline" role="group" aria-label="Progress steps">
        <div class="admin-step-card active" data-step-card="1" aria-current="step">
            <div class="admin-step-title"><span class="admin-step-index">1</span>Course</div>
        </div>
        <div class="admin-step-card" data-step-card="2">
            <div class="admin-step-title"><span class="admin-step-index">2</span>Learner</div>
        </div>
        <div class="admin-step-card" data-step-card="3">
            <div class="admin-step-title"><span class="admin-step-index">3</span>Dates</div>
        </div>
        <div class="admin-step-card" data-step-card="4">
            <div class="admin-step-title"><span class="admin-step-index">4</span>Review</div>
        </div>
    </div>
    <div class="admin-page-header-actions">
        <a href="javascript:history.back();" class="action-link">
            <i class="fas fa-times text-secondary" aria-hidden="true"></i> Cancel
        </a>
        <button type="button" class="action-link d-none" id="btn-prev-step">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Previous
        </button>
        <button type="button" class="action-link primary" id="btn-next-step">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> Continue
        </button>
        <button type="button" class="action-link primary d-none" id="btn-review-step">
            <i class="fas fa-file-alt" aria-hidden="true"></i> Review Assignment
        </button>
        <button type="button" class="action-link primary d-none" id="btn-confirm-assign">
            <i class="fas fa-save" aria-hidden="true"></i> Confirm &amp; Assign
        </button>
    </div>
</div>

<div class="container-fluid px-4 py-3 d-flex flex-column gap-3 admin-wizard-shell admin-wizard-shell--fill admin-review-flow">
    <div id="load-panel"></div>

    <div class="admin-review-main-col">
        <div class="border rounded bg-white p-3" id="wizard-main-card">
        <div id="step-panel-1" class="admin-wizard-panel active" data-step-layout="wide">
            <div class="admin-section-header mb-2">
                <div class="admin-section-header-main">
                    <div class="section-title mb-0 admin-section-title-fill">Course Selection</div>
                </div>
                <div class="admin-section-divider"></div>
            </div>

            <div class="admin-selection-layout">
                <div class="admin-filter-shell d-flex flex-column gap-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-filter text-primary me-2" aria-hidden="true"></i>Filters</h6>
                    <div>
                        <label class="small fw-bold text-muted mb-1 d-block">Course Type</label>
                        <div id="filter-course-type"></div>
                    </div>
                    <div>
                        <label class="small fw-bold text-muted mb-1 d-block">Division</label>
                        <div id="filter-course-div"></div>
                    </div>
                    <div>
                        <label class="small fw-bold text-muted mb-1 d-block">Category</label>
