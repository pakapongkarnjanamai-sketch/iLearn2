                    </div>
                </div>
            </div>
        </div>

        <div id="step-panel-2" class="admin-wizard-panel" data-step-layout="wide">
            <div class="admin-section-header mb-2">
                <div class="admin-section-header-main">
                    <div class="section-title mb-0 admin-section-title-fill">Learner Selection</div>
                </div>
                <div class="admin-section-divider"></div>
            </div>

            <div class="d-flex gap-1 mb-2">
                    <button type="button" class="target-mode-btn active" id="mode-individual">
                        <i class="fas fa-user-graduate me-1" aria-hidden="true"></i> Individual
