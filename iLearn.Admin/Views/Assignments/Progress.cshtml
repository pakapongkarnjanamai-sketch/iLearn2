@{
    ViewBag.Title = "Assignment Dashboard";
}

<style>
    /* ── Meta List (local) ── */
    .meta-item { padding: 8px 0; border-bottom: 1px solid var(--border-color); }
    .meta-item:last-child { border-bottom: none; }
    .meta-label { font-size: 11px; color: var(--text-secondary); font-weight: 600;
                  text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 3px; }
    .meta-value { font-size: 13px; color: var(--text-primary); }
</style>

<!-- ── Page Header ────────────────────────────────────────────────── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Assignment Dashboard</div>
        <div class="text-secondary" id="lbl-assignment-no" style="font-size:12px;">Loading...</div>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Report", "Assignments", new { id = ViewBag.AssignmentId })"
           target="_blank" class="action-link">
            <i class="fas fa-file-alt text-secondary"></i> Export Report
        </a>
        <a href="@Url.Action("Index", "Assignments")" class="action-link">
            <i class="fas fa-arrow-left text-secondary"></i> Back
        </a>
    </div>
</div>

<div class="container-fluid px-4 py-4" >
    <div id="load-panel"></div>

    <!-- ── Row 1: Meta / Stats / Chart ──────────────────────────── -->
    <div class="row g-3 mb-4">

        <!-- Meta Info -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Assignment Info</div>

                <div class="meta-item">
                    <div class="meta-label">Assignment No.</div>
                    <div class="meta-value fw-bold" id="lbl-assignment-no-detail">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Description</div>
                    <div class="meta-value" id="lbl-description">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Schedule</div>
                    <div class="meta-value" id="lbl-schedule">-</div>
                </div>
                <div class="meta-item">
                    <div class="meta-label">Created By</div>
                    <div class="meta-value" id="lbl-created-by">-</div>
                </div>

                <div class="d-flex flex-column gap-2 mt-3 pt-3" style="border-top:1px solid var(--border-color);">
                    <a href="javascript:void(0);" id="btn-extend-due-date" class="action-link">
                        <i class="fas fa-calendar-plus" style="color:var(--warning-color);"></i>
                        Extend Due Date
                    </a>
                    <a href="javascript:void(0);" id="btn-delete-assignment" class="action-link danger">
                        <i class="fas fa-trash-alt" style="color:var(--danger-color);"></i>
                        Delete Assignment
                    </a>
                </div>
            </div>
        </div>

        <!-- Stat Cards -->
        <div class="col-lg-3">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Summary</div>
                <div class="row g-2 text-center mb-3">
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-emp">0</div>
                            <div class="stat-label">Students</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-total-courses">0</div>
                            <div class="stat-label">Courses</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-completed" style="color:var(--success-color);">0</div>
                            <div class="stat-label">Completed</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3 bg-white stat-block">
                            <div class="stat-value" id="stat-inprogress" style="color:var(--warning-color);">0</div>
                            <div class="stat-label">In Progress</div>
                        </div>
                    </div>
                </div>
                <div class="border rounded p-3 text-center bg-white">
                    <div class="stat-label mb-1">Overall Completion</div>
                    <div class="stat-value" id="stat-progress-text" style="color:var(--success-color);">0%</div>
                </div>
            </div>
        </div>

        <!-- Pie Chart -->
        <div class="col-lg-6">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Status Distribution</div>
                <div id="status-pie-chart" style="height:220px;"></div>
            </div>
        </div>
    </div>

    <!-- ── Row 2: Course Cards + Student Grid ───────────────────── -->
    <div class="row g-3 mb-4">
        <!-- Course List -->
        <div class="col-xl-4">
            <div class="border rounded bg-white h-100 p-3">
                <div class="section-title">Assigned Courses
                    <span class="float-end fw-normal text-secondary" style="font-size:11px;">
                        Click to filter
                    </span>
                </div>
                <div id="course-list" class="d-flex flex-column" style="max-height:420px; overflow-y:auto;"></div>
            </div>
        </div>

        <!-- Student DataGrid -->
        <div class="col-xl-8">
            <div class="border rounded bg-white h-100 p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="section-title mb-0" style="border:none; padding:0;">
                        Student Tracking
                        <span class="text-secondary fw-normal ms-2" id="student-grid-subtitle"
                              style="font-size:11px; text-transform:none; letter-spacing:0;">— All</span>
                    </div>
                    <div id="course-selector" style="width:220px;"></div>
                </div>
                <div id="student-grid"></div>
            </div>
        </div>
    </div>

    <!-- ── Row 3: Pivot Table ────────────────────────────────────── -->
    <div class="border rounded bg-white p-3 mb-4">
        <div class="section-title">Student × Course Matrix</div>
        <div id="pivot-container"></div>
    </div>
</div>

<div id="extend-due-date-popup"></div>

@section Scripts {
<script>
    const ASSIGNMENT_ID = @ViewBag.AssignmentId;

    $(() => {
        const loadPanel = $("#load-panel").dxLoadPanel({
            shadingColor: "rgba(255,255,255,0.8)",
            position: { of: "body" },
            visible: true,
            showIndicator: true,
            showPane: false,
            shading: true,
            message: "Loading..."
        }).dxLoadPanel("instance");

        $.ajax({
            url: `${serviceUrl}/Assignments/dashboard/${ASSIGNMENT_ID}`,
            method: "GET",
            xhrFields: { withCredentials: true }
        }).done(function (res) {
            if (!res.success || !res.data) { showApiError("Invalid data format."); return; }
            const data = res.data;

            // ── Header ──────────────────────────────────────────────────────────
            const refNo = data.assignmentNo || "-";
            $("#lbl-assignment-no").text(`Ref: ${refNo}`);
            $("#lbl-assignment-no-detail").text(refNo);
            $("#lbl-description").text(data.description || "-");

            currentDueDate   = data.dueDate   ? new Date(data.dueDate)   : null;
            currentStartDate = data.startDate ? new Date(data.startDate) : null;

            const sDate = data.startDate ? new Date(data.startDate).toLocaleDateString("en-GB") : "-";
            const dDate = data.dueDate   ? new Date(data.dueDate).toLocaleDateString("en-GB")   : "No Limit";
            $("#lbl-schedule")
                .attr("data-start", sDate)
                .text(`${sDate} → ${dDate}`);
            if (data.createdBy) $("#lbl-created-by").text(data.createdBy);

            // ── Stats ────────────────────────────────────────────────────────────
            const totalStudents = data.totalStudents ?? data.totalEmployees;
            const cd = data.chartData;
            $("#stat-total-emp").text(totalStudents);
            $("#stat-total-courses").text(data.totalCourses);
            $("#stat-completed").text(cd.completed);
            $("#stat-inprogress").text(cd.inProgress);
            $("#stat-progress-text").text(`${data.completionRate}%`);

            // ── Pie Chart ────────────────────────────────────────────────────────
            $("#status-pie-chart").dxPieChart({
                type: "doughnut",
                innerRadius: 0.7,
                palette: ["#52c41a", "#faad14", "#d9d9d9"],
                dataSource: [
                    { status: "Completed",   count: cd.completed  },
                    { status: "In Progress", count: cd.inProgress },
                    { status: "Not Started", count: cd.notStarted }
                ],
                series: [{
                    argumentField: "status",
                    valueField: "count",
                    label: {
                        visible: true,
                        position: "outside",
                        customizeText: p => `${p.valueText} (${p.percentText})`,
                        font: { size: 11, color: "#595959" },
                        connector: { visible: true, width: 1 }
                    }
                }],
                legend: {
                    horizontalAlignment: "right",
                    verticalAlignment: "center",
                    margin: 0,
                    font: { size: 12, color: "#595959" }
                },
                tooltip: { enabled: true }
            });

            // ── Course List ──────────────────────────────────────────────────────
            const courseMap = {};
            data.courses.forEach(c => { courseMap[c.assignmentRuleId] = c; });

            const dropdownOptions = data.courses.map(c => ({
                assignmentRuleId: c.assignmentRuleId,
                displayText: `${c.courseCode}`
            }));
            const firstRuleId = dropdownOptions.length > 0 ? dropdownOptions[0].assignmentRuleId : null;

            const $courseList = $("#course-list");
            data.courses.forEach(c => {
                const pct       = c.totalStudents > 0 ? Math.round((c.completedStudents / c.totalStudents) * 100) : 0;
                const leftColor = pct === 100 ? "var(--success-color)" : pct > 0 ? "var(--accent-color)" : "var(--border-color)";
                const isDone    = pct === 100;

                $(`<div class="course-item ${isDone ? "done" : ""} ${c.assignmentRuleId === firstRuleId ? "active" : ""}"
                        data-rule="${c.assignmentRuleId}" data-title="${c.courseTitle}"
                        style="border-left-color:${leftColor};">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold" style="font-size:11px;">${c.courseCode}</span>
                            <span class="text-secondary ms-2" style="font-size:11px;">${c.courseTitle}</span>
                        </div>
                        <span class="fw-bold ms-2" style="font-size:11px; color:${leftColor}; white-space:nowrap;">${pct}%</span>
                    </div>
                    <div class="progress-slim">
                        <div style="height:100%; width:${pct}%; background:${leftColor};"></div>
                    </div>
                    <div class="d-flex gap-3 mt-2" style="font-size:11px; color:var(--text-secondary);">
                        <span style="color:var(--success-color);">✓ ${c.completedStudents}</span>
                        <span style="color:var(--text-secondary);">◐ ${c.totalStudents - c.completedStudents}</span>
                        <span class="ms-auto">${c.totalStudents} students</span>
                    </div>
                </div>`).appendTo($courseList);
            });

            $courseList.find(".course-item").on("click", function () {
                const ruleId = $(this).data("rule");
                const title  = $(this).data("title");
                $courseList.find(".course-item").removeClass("active");
                $(this).addClass("active");
                $("#course-selector").dxSelectBox("instance").option("value", ruleId);
                $("#student-grid-subtitle").text(`— ${title}`);
                $("#student-grid").dxDataGrid("instance").filter(["assignmentRuleId", "=", ruleId]);
            });

            // ── Course Selector Dropdown ─────────────────────────────────────────
            $("#course-selector").dxSelectBox({
                dataSource: dropdownOptions,
                valueExpr: "assignmentRuleId",
                displayExpr: "displayText",
                value: firstRuleId,
                stylingMode: "underlined",
                placeholder: "Select course...",
                onValueChanged: function (e) {
                    $("#student-grid").dxDataGrid("instance").filter(["assignmentRuleId", "=", e.value]);
                    $courseList.find(".course-item").removeClass("active");
                    const $card = $courseList.find(`.course-item[data-rule="${e.value}"]`).addClass("active");
                    $("#student-grid-subtitle").text(`— ${$card.data("title")}`);
                }
            });

            // ── Student DataGrid ─────────────────────────────────────────────────
            $("#student-grid").dxDataGrid({
                dataSource: data.students,
                showBorders: false,
                showRowLines: true,
                rowAlternationEnabled: false,
                hoverStateEnabled: true,
                filterRow: { visible: false },
                searchPanel: { visible: true, placeholder: "Search student...", width: 160 },
                height: 420,
                scrolling: { mode: "virtual" },
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.isCompleted)
                        $(e.rowElement).css("background-color", "#f6ffed");
                },
                columns: [
                    {
                        dataField: "studentCode",
                        caption: "ID",
                        width: 100,
                        cellTemplate: (c, o) =>
                            $("<a>").attr("href", `@Url.Action("Profile", "Students")?code=${o.value}`)
                                   .css({ fontSize: "11px", fontWeight: "600" })
                                   .addClass("tag-pill pill-default")
                                   .text(o.value).appendTo(c)
                    },
                    {
                        dataField: "studentName",
                        caption: "Name",
                        minWidth: 120,
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "12px", color: "var(--text-secondary)" })
                                       .text(o.value || "-").appendTo(c)
                    },
                    {
                        dataField: "progress",
                        caption: "Progress",
                        width: 140,
                        alignment: "center",
                        cellTemplate: (c, o) => {
                            const pct   = o.value || 0;
                            const color = pct === 100 ? "var(--success-color)" : pct > 0 ? "var(--accent-color)" : "var(--border-color)";
                            $("<div>").addClass("d-flex align-items-center gap-2")
                                .append(
                                    $("<div>").css({ flex: "1", height: "3px", background: "var(--border-color)", borderRadius: "2px", overflow: "hidden" })
                                        .append($("<div>").css({ height: "100%", width: pct + "%", background: color }))
                                )
                                .append(
                                    $("<span>").css({ fontSize: "11px", fontWeight: "600", minWidth: "32px", color: "var(--text-secondary)" })
                                               .text(pct + "%")
                                )
                                .appendTo(c);
                        }
                    },
                    {
                        dataField: "isCompleted",
                        caption: "Status",
                        width: 110,
                        cellTemplate: (c, o) => {
                            let dotCls, label;
                            if (o.value) {
                                dotCls = "dot-success"; label = "Completed";
                            } else if (o.data.progress > 0) {
                                dotCls = "dot-warning"; label = "In Progress";
                            } else {
                                dotCls = "dot-default"; label = "Pending";
                            }
                            $("<span>").css({ fontSize: "12px" })
                                .append($("<span>").addClass(`status-dot ${dotCls}`))
                                .append(label)
                                .appendTo(c);
                        }
                    },
                    {
                        dataField: "completedDate",
                        caption: "Completed On",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        alignment: "center",
                        width: 110,
                        cellTemplate: (c, o) =>
                            $("<span>").css({ fontSize: "11px", color: "var(--text-secondary)" })
                                       .text(o.value ? new Date(o.value).toLocaleDateString("en-GB") : "—")
                                       .appendTo(c)
                    }
                ]
            });

            if (firstRuleId) {
                $("#student-grid").dxDataGrid("instance").filter(["assignmentRuleId", "=", firstRuleId]);
                $("#student-grid-subtitle").text(`— ${dropdownOptions[0]?.displayText || ""}`);
            }

            // ── Pivot Table (HTML — same as Report) ──────────────────────────────
            $("#pivot-container").html(buildPivotTable(data.courses, data.students));

            loadPanel.hide();
        }).fail(() => showApiError("Error loading dashboard data."));

        // ── buildPivotTable — identical logic to Report.cshtml ──────────────────
        function buildPivotTable(courses, students) {
            // สร้าง map: studentCode → { assignmentRuleId → studentRecord }
            const studentMap = {};
            students.forEach(s => {
                if (!studentMap[s.studentCode]) studentMap[s.studentCode] = {};
                studentMap[s.studentCode][s.assignmentRuleId] = s;
            });
            const uniqueStudents = Object.keys(studentMap).sort();

            // Column headers
            const colHeaders = courses.map(c =>
                `<th class="text-center align-middle" style="min-width:160px;">
                    <div class="fw-bold text-dark" style="font-size:11px;">${c.courseCode}</div>
                    <div class="text-muted mt-1" style="font-size:10px; font-weight:normal; white-space:normal; line-height:1.2;">${c.courseTitle}</div>
                </th>`
            ).join("");

            // Data rows
            const dataRows = uniqueStudents.map(code => {
                const enrollments = studentMap[code];
                const name        = Object.values(enrollments)[0]?.studentName || code;
                let completedCount = 0;

                const cells = courses.map(c => {
                    const e = enrollments[c.assignmentRuleId];
                    if (!e) return `<td class="text-center"><span class="status-pending">—</span></td>`;

                    if (e.isCompleted) {
                        completedCount++;
                        const d = e.completedDate
                            ? new Date(e.completedDate).toLocaleDateString("en-GB")
                            : "";
                        return `<td class="text-center status-done">
                                    <i class="fas fa-check"></i>
                                    <div style="font-size:10px; color:#8c8c8c;">${d}</div>
                                </td>`;
                    } else if (e.progress > 0) {
                        return `<td class="text-center status-active" style="font-size:11px;">${e.progress}%</td>`;
                    } else {
                        return `<td class="text-center status-pending" style="font-size:11px;">Pending</td>`;
                    }
                }).join("");

                return `<tr>
                    <td class="sticky-col align-middle">
                        <a href="@Url.Action("Profile", "Students")?code=${code}"
                           class="fw-bold text-dark" style="font-size:12px; text-decoration:none;">${code}</a>
                        <div class="text-muted" style="font-size:11px;">${name !== code ? name : ""}</div>
                    </td>
                    ${cells}
                    <td class="text-center align-middle fw-bold" style="background:var(--bg-light); font-size:12px;">
                        ${completedCount} / ${courses.length}
                    </td>
                </tr>`;
            }).join("");

            return `<div class="table-responsive border rounded" style="max-height:560px;">
                        <table class="table table-bordered table-hover pivot-table m-0">
                            <thead style="position:sticky; top:0; z-index:4;">
                                <tr>
                                    <th class="sticky-col align-middle" style="min-width:180px;">Student \\ Course</th>
                                    ${colHeaders}
                                    <th class="text-center align-middle" style="min-width:80px; background:var(--bg-light);">Total</th>
                                </tr>
                            </thead>
                            <tbody>${dataRows}</tbody>
                        </table>
                    </div>`;
        }

        // ── Delete ────────────────────────────────────────────────────────────────
        $("#btn-delete-assignment").click(function (e) {
            e.preventDefault();
            DevExpress.ui.dialog.confirm(
                `<div class="py-2">
                    <div class="fw-bold mb-1">Delete this assignment?</div>
                    <div class="text-muted" style="font-size:12px;">
                        All related enrollments will be permanently removed.
                    </div>
                </div>`,
                "Confirm Deletion"
            ).done(function (ok) {
                if (!ok) return;
                loadPanel.option("message", "Deleting..."); loadPanel.show();
                $.ajax({
                    url: `${serviceUrl}/Assignments/${ASSIGNMENT_ID}`,
                    type: "DELETE",
                    xhrFields: { withCredentials: true },
                    success: function () {
                        showToast("Deleted successfully.", "success", 2000);
                        setTimeout(() => window.location.href = "@Url.Action("Index", "Assignments")", 1500);
                    },
                    error: function () {
                        showToast("Error deleting.", "error");
                        loadPanel.hide();
                    }
                });
            });
        });

        // ── Extend Due Date ───────────────────────────────────────────────────────
        let currentDueDate = null, currentStartDate = null;

        $("#btn-extend-due-date").click(function () {
            const popup = $("#extend-due-date-popup").dxPopup({
                title: "Extend Due Date",
                width: 340,
                height: "auto",
                showCloseButton: true,
                dragEnabled: false,
                contentTemplate: function (content) {
                    $("<div>").addClass("p-2").append(
                        $("<div>").addClass("mb-3").append(
                            $("<div>").css({ fontSize: "11px", fontWeight: "600", color: "var(--text-secondary)",
                                            textTransform: "uppercase", letterSpacing: "0.4px", marginBottom: "6px" })
                                       .text("New Due Date"),
                            $("<div>").attr("id", "new-due-date-picker")
                        ),
                        $("<div>").addClass("d-flex gap-2 justify-content-end mt-3").append(
                            $("<div>").attr("id", "btn-popup-cancel"),
                            $("<div>").attr("id", "btn-popup-confirm")
                        )
                    ).appendTo(content);

                    const minDate = currentStartDate
                        ? new Date(currentStartDate.getFullYear(), currentStartDate.getMonth(), currentStartDate.getDate() + 1)
                        : new Date();

                    $("#new-due-date-picker").dxDateBox({
                        type: "date", value: currentDueDate, min: minDate,
                        displayFormat: "dd/MM/yyyy", stylingMode: "outlined", width: "100%"
                    });

                    $("#btn-popup-cancel").dxButton({
                        text: "Cancel", stylingMode: "outlined",
                        onClick: () => $("#extend-due-date-popup").dxPopup("instance").hide()
                    });

                    $("#btn-popup-confirm").dxButton({
                        text: "Confirm", type: "default", stylingMode: "contained",
                        onClick: function () {
                            const newDate = $("#new-due-date-picker").dxDateBox("instance").option("value");
                            if (!newDate) { showToast("Please select a date.", "warning", 2500); return; }
                            if (currentStartDate && new Date(newDate) <= currentStartDate) {
                                showToast("Due date must be after start date.", "warning", 2500);
                                return;
                            }
                            loadPanel.option("message", "Updating..."); loadPanel.show();
                            $.ajax({
                                url: `${serviceUrl}/Assignments/${ASSIGNMENT_ID}/extend-due-date`,
                                type: "PATCH",
                                contentType: "application/json",
                                xhrFields: { withCredentials: true },
                                data: JSON.stringify({ newDueDate: newDate }),
                                success: function () {
                                    $("#extend-due-date-popup").dxPopup("instance").hide();
                                    loadPanel.hide();
                                    currentDueDate = newDate;
                                    const formatted = new Date(newDate).toLocaleDateString("en-GB");
                                    const sDate = $("#lbl-schedule").data("start");
                                    $("#lbl-schedule").text(`${sDate} → ${formatted}`);
                                    showToast("Due date extended.", "success");
                                },
                                error: function (xhr) {
                                    loadPanel.hide();
                                    showToast(xhr.responseJSON?.message || "Error.", "error", 4000);
                                }
                            });
                        }
                    });
                }
            }).dxPopup("instance");
            popup.show();
        });

        function showApiError(msg) { loadPanel.hide(); showToast(msg, "error", 4000); }
    });
</script>
}