@{
    ViewBag.Title = "Assignment Dashboard";
}

<style>
    body {
        background-color: #f8f9fa;
    }

    /* Minimal Typography Stats */
    .stat-number {
        font-size: 2.25rem;
        font-weight: 700;
        color: #2b3643;
        line-height: 1.1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #6c7c93;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Status Dots for clean UI */
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    .dot-completed {
        background-color: #2da44e;
    }

    .dot-progress {
        background-color: #dbab09;
    }

    .dot-notstarted {
        background-color: #d1d5da;
    }

    /* Action Card (คล้ายหน้า Course Dashboard) */
    .action-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        text-decoration: none;
        border: 1px solid #e8ecf1;
        background-color: #ffffff;
    }

        .action-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }

        .action-card.delete-card:hover {
            border-color: #dc3545 !important;
        }
</style>

<div class="bg-white border-bottom mb-4 py-4">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-chart-pie fs-5"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold text-dark">@ViewBag.Title</h1>
                <small class="text-muted" id="lbl-assignment-no">Loading assignment details...</small>
            </div>
        </div>
        <a href="@Url.Action("Index", "Assignments")" class="btn btn-light border shadow-sm btn-sm px-3 py-2 rounded-3">
            <i class="fas fa-arrow-left me-1"></i> Back to Assignments
        </a>
    </div>
</div>

<div class="container-fluid px-4 pb-5 mb-5">
    <div id="load-panel"></div>

    <div class="row g-4 mb-4">

        <div class="col-lg-4 d-flex flex-column gap-4">
            <div class="card border-0 shadow-sm rounded-4 flex-grow-1">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-info-circle text-primary me-2"></i> Assignment Details
                    </h6>
                </div>
                <div class="card-body px-4 py-4 d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <div class="stat-label mb-1">Description</div>
                        <div id="lbl-description" class="text-dark fw-medium" style="font-size: 1rem;">-</div>
                    </div>
                    <div>
                        <div class="stat-label mb-1">Schedule Period</div>
                        <div id="lbl-schedule" class="text-dark fw-medium" style="font-size: 1rem;">-</div>
                    </div>
                </div>
            </div>

            <a href="javascript:void(0);" id="btn-delete-assignment" class="action-card delete-card d-flex align-items-center p-3 rounded-4 shadow-sm">
                <div class="icon-box bg-danger bg-opacity-10 text-danger me-3">
                    <i class="fas fa-trash-alt fs-5"></i>
                </div>
                <div>
                    <h6 class="mb-1 fw-bold text-dark">Delete Assignment</h6>
                    <small class="text-muted" style="font-size: 0.8rem;">Remove completely from system</small>
                </div>
            </a>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="row h-100 align-items-center">
                        <div class="col-md-6 border-end pe-4">
                            <h6 class="mb-4 fw-bold text-dark">
                                <i class="fas fa-chart-line text-primary me-2"></i> Progress Overview
                            </h6>
                            <div class="row text-center mb-4">
                                <div class="col-6">
                                    <div class="stat-number text-primary" id="stat-total-emp">0</div>
                                    <div class="stat-label mt-2">Employees</div>
                                </div>
                                <div class="col-6">
                                    <div class="stat-number text-primary" id="stat-total-courses">0</div>
                                    <div class="stat-label mt-2">Courses</div>
                                </div>
                            </div>
                            <div class="bg-light p-3 rounded-3 border text-center">
                                <div class="stat-label mb-1">Overall Completion</div>
                                <div class="stat-number text-success" id="stat-progress-text" style="font-size: 2rem;">0%</div>
                            </div>
                        </div>
                        <div class="col-md-6 ps-4">
                            <div id="status-pie-chart" style="height: 220px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-book me-2 text-primary"></i> Assigned Courses
                    </h6>
                    <p class="text-muted small mt-1 mb-0">Select a course to filter employees.</p>
                </div>
                <div class="card-body p-0 flex-grow-1 overflow-hidden rounded-bottom-4 border-top">
                    <div id="course-summary-grid"></div>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-users me-2 text-primary"></i> Employee Tracking
                    </h6>
                    <div style="width: 250px;">
                        <div id="course-selector"></div>
                    </div>
                </div>
                <div class="card-body p-0 flex-grow-1 overflow-hidden rounded-bottom-4 border-top">
                    <div id="student-progress-grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ASSIGNMENT_ID = @ViewBag.AssignmentId;

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: true,
                showIndicator: true,
                showPane: false,
                shading: true,
                message: "Loading dashboard data..."
            }).dxLoadPanel("instance");

            // ยิง API เฉพาะทางที่เราเพิ่งสร้าง ได้ข้อมูลครบจบในเส้นเดียว!
            $.ajax({
                url: `${serviceUrl}/Assignments/dashboard/${ASSIGNMENT_ID}`,
                method: "GET",
                xhrFields: { withCredentials: true }
            }).done(function(res) {
                if(!res.success || !res.data) {
                    showApiError("Invalid data format received.");
                    return;
                }

                const data = res.data;

                // 1. Bind Header & Info
                $("#lbl-assignment-no").text(`Ref: ${data.assignmentNo || '-'}`);
                $("#lbl-description").text(data.description || '-');

                const sDate = data.startDate ? new Date(data.startDate).toLocaleDateString('en-GB') : '-';
                const dDate = data.dueDate ? new Date(data.dueDate).toLocaleDateString('en-GB') : '-';
                $("#lbl-schedule").text(`${sDate} to ${dDate}`);

                // 2. Bind Stat Cards
                $("#stat-total-emp").text(data.totalEmployees);
                $("#stat-total-courses").text(data.totalCourses);
                $("#stat-progress-text").text(`${data.completionRate}%`);

                // 3. Render Chart
                $("#status-pie-chart").dxPieChart({
                    type: "doughnut",
                    innerRadius: 0.65,
                    palette: ["#2da44e", "#dbab09", "#d1d5da"], // Green, Yellow, Gray
                    dataSource: [
                        { status: "Completed", count: data.chartData.completed },
                        { status: "In Progress", count: data.chartData.inProgress },
                        { status: "Not Started", count: data.chartData.notStarted }
                    ],
                    series: [{ argumentField: "status", valueField: "count", label: { visible: false } }],
                    legend: {
                        verticalAlignment: "bottom",
                        horizontalAlignment: "center",
                        margin: 0,
                        font: { size: 12, color: "#586069" }
                    },
                    tooltip: {
                        enabled: true,
                        customizeTooltip: function (arg) { return { text: `${arg.argumentText}: ${arg.valueText}` }; }
                    }
                });

                // 4. Render Course Summary Grid (Clean Style)
                $("#course-summary-grid").dxDataGrid({
                    dataSource: data.courses,
                    keyExpr: "assignmentRuleId",
                    showBorders: false,
                    showRowLines: true,
                    rowAlternationEnabled: false,
                    hoverStateEnabled: true,
                    selection: { mode: "single" },
                    height: 380,
                    scrolling: { mode: "virtual" },
                    columns: [
                        { dataField: "courseCode", caption: "Code", width: 90, cssClass: "fw-medium" },
                        { dataField: "courseTitle", caption: "Title" },
                        {
                            caption: "Progress", alignment: "right", width: 90,
                            cellTemplate: (container, options) => {
                                const isDone = options.data.completedStudents === options.data.totalStudents && options.data.totalStudents > 0;
                                const textClass = isDone ? "text-success fw-bold" : "text-muted";
                                $(`<span class="small ${textClass}">${options.data.completedStudents} / ${options.data.totalStudents}</span>`).appendTo(container);
                            }
                        }
                    ],
                    onSelectionChanged: function(e) {
                        const val = e.selectedRowKeys.length > 0 ? e.selectedRowKeys[0] : "ALL";
                        $("#course-selector").dxSelectBox("instance").option("value", val);
                    }
                });

                // 5. Setup Course Selector Dropdown (Minimal Style)
                const dropdownOptions = [{ assignmentRuleId: "ALL", displayText: "All Assigned Courses" }];
                data.courses.forEach(c => dropdownOptions.push({ assignmentRuleId: c.assignmentRuleId, displayText: `${c.courseCode}` }));

                $("#course-selector").dxSelectBox({
                    dataSource: dropdownOptions,
                    valueExpr: "assignmentRuleId",
                    displayExpr: "displayText",
                    value: "ALL",
                    stylingMode: "underlined", // ขีดเส้นใต้แบบคลีนๆ
                    onValueChanged: function(e) {
                        const studentGrid = $("#student-progress-grid").dxDataGrid("instance");
                        const summaryGrid = $("#course-summary-grid").dxDataGrid("instance");

                        if(e.value === "ALL") {
                            studentGrid.clearFilter();
                            summaryGrid.clearSelection();
                        } else {
                            studentGrid.filter(["assignmentRuleId", "=", e.value]);
                            if (summaryGrid.getSelectedRowKeys().indexOf(e.value) === -1) {
                                summaryGrid.selectRows([e.value], false);
                            }
                        }
                    }
                });

                // 6. Render Student Grid (ใช้ Local Array ทำงานไวสุดๆ)
                $("#student-progress-grid").dxDataGrid({
                    dataSource: data.students,
                    showBorders: false,
                    showRowLines: true,
                    rowAlternationEnabled: false,
                    hoverStateEnabled: true,
                    filterRow: { visible: true },
                    height: 380,
                    scrolling: { mode: "virtual" },
                    columns: [
                        { dataField: "studentCode", caption: "Employee ID", width: 130, cssClass: "fw-medium" },
                        {
                            dataField: "progress",
                            caption: "Progress",
                            alignment: "center",
                            width: 100,
                            customizeText: (e) => e.value + "%"
                        },
                        {
                            dataField: "isCompleted",
                            caption: "Status",
                            width: 130,
                            cellTemplate: function(container, options) {
                                if (options.value) {
                                    $(`<div><span class="status-dot dot-completed"></span><span class="small fw-medium text-success">Completed</span></div>`).appendTo(container);
                                } else if (options.data.progress > 0) {
                                    $(`<div><span class="status-dot dot-progress"></span><span class="small text-muted">In Progress</span></div>`).appendTo(container);
                                } else {
                                    $(`<div><span class="status-dot dot-notstarted"></span><span class="small text-muted">Pending</span></div>`).appendTo(container);
                                }
                            }
                        },
                        {
                            dataField: "completedDate", caption: "Completed On", dataType: "date",
                            format: "dd/MM/yyyy", alignment: "right", cssClass: "text-muted small"
                        }
                    ]
                });

                loadPanel.hide();

            }).fail(() => showApiError("Error loading dashboard data."));


            // --- ระบบลบ Assignment (เหมือนเดิมแต่ย้ายปุ่มมาอยู่ใน Card) ---
            $("#btn-delete-assignment").click(function(e) {
                e.preventDefault();
                DevExpress.ui.dialog.confirm(
                    `<div class="text-center">
                        <i class="fas fa-exclamation-triangle text-danger fa-3x mb-3"></i>
                        <h5 class="fw-bold text-dark">Delete Assignment?</h5>
                        <p class="mb-0 text-muted">Are you sure you want to permanently delete this assignment?</p>
                        <p class="text-danger small mt-2 fw-bold bg-danger bg-opacity-10 p-2 rounded-2">
                           <i class="fas fa-info-circle me-1"></i> Warning: All related employee enrollments will also be removed!
                        </p>
                    </div>`,
                    "Confirm Deletion"
                ).done(function(dialogResult) {
                    if(dialogResult) {
                        loadPanel.option("message", "Deleting assignment...");
                        loadPanel.show();
                        $.ajax({
                            url: `${serviceUrl}/Assignments/${ASSIGNMENT_ID}`,
                            type: 'DELETE',
                            xhrFields: { withCredentials: true },
                            success: function() {
                                DevExpress.ui.notify("Deleted successfully.", "success", 2000);
                                setTimeout(() => window.location.href = '@Url.Action("Index", "Assignments")', 1500);
                            },
                            error: function() {
                                DevExpress.ui.notify("Error deleting assignment.", "error", 4000);
                                loadPanel.hide();
                            }
                        });
                    }
                });
            });

            function showApiError(msg) {
                loadPanel.hide();
                DevExpress.ui.notify(msg, "error", 4000);
            }
        });
    </script>
}