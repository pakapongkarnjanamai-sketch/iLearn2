@{
    ViewBag.Title = "Assignments Progress Dashboard";
}

<style>
    /* Minimal & Clean White Theme */
    body {
        background-color: #ffffff;
    }

    /* Icon box styling */
    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        flex-shrink: 0;
        background-color: #f0f4f9;
    }

    /* Card styling - ultra minimal */
    .card {
        border: 1px solid #e8ecf1 !important;
        background-color: #ffffff !important;
    }

    .card-header {
        background-color: #ffffff !important;
        border-bottom: 1px solid #e8ecf1 !important;
        padding: 1rem !important;
    }

    /* Stat card - subtle blue */
    .stat-card {
        background: linear-gradient(135deg, #f8fbff 0%, #f0f7ff 100%);
        border: 1px solid #e8ecf1 !important;
    }

    .stat-value {
        color: #1a3a52;
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-label {
        color: #6c7c93;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* Grid minimal styling */
    .dx-datagrid {
        background-color: transparent !important;
    }

    .dx-datagrid-container {
        background-color: transparent !important;
    }

    /* Filter hint badge */
    .filter-hint {
        background-color: #f5f7fa;
        border: 1px solid #dce1e6;
        color: #5a6c7d;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 1200px) {
        .stat-value {
            font-size: 2rem;
        }
    }

    @@media (max-width: 768px) {
        .card-header h5 {
            flex-wrap: wrap;
        }
        
        #course-selector {
            width: 100% !important;
            margin-top: 0.5rem;
        }
    }
</style>

<!-- Header -->
<div class="bg-white" style="border-bottom: 1px solid #e8ecf1;">
    <div class="container-fluid px-4 py-4">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box text-primary">
                    <i class="fas fa-chart-pie fs-5"></i>
                </div>
                <div>
                    <h1 class="h4 mb-1 fw-bold text-dark">@ViewBag.Title</h1>
                    <small class="text-muted">Track course completion and monitor employee learning progress across assignments.</small>
                </div>
            </div>
            <a href="@Url.Action("Index", "Assignments")" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-2" style="border: 1px solid #dce1e6;">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="container-fluid px-4 py-4 pb-5 mb-5">
    <div id="load-panel"></div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card rounded-3 h-100">
                <div class="card-header pb-0 border-0">
                    <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                        <i class="fas fa-list-check me-2 text-muted" style="opacity: 0.6;"></i> Assignment Details
                    </h6>
                </div>
                <div class="card-body pt-3">
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Reference No</small>
                        <div class="fw-bold text-dark" id="lbl-assignment-no" style="font-size: 1.1rem;">-</div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Description</small>
                        <div id="lbl-description" style="font-size: 0.95rem; line-height: 1.4;">-</div>
                    </div>
                    <div>
                        <small class="text-muted d-block mb-1">Schedule</small>
                        <div id="lbl-schedule" style="font-size: 0.95rem;">-</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card stat-card rounded-3 h-100">
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-6 d-flex flex-column justify-content-center" style="border-right: 1px solid #e8ecf1;">
                            <div class="stat-value text-primary" id="stat-total-courses">0</div>
                            <div class="stat-label">Total Courses</div>
                        </div>
                        <div class="col-6 d-flex flex-column justify-content-center ps-3">
                            <div class="stat-value text-primary" id="stat-total-emp">0</div>
                            <div class="stat-label">Target Employees</div>
                        </div>
                    </div>

                    <div class="mt-4 pt-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted fw-semibold" style="font-size: 0.9rem;">Overall Completion Rate</span>
                            <span class="fw-bold text-primary" id="stat-progress-text" style="font-size: 1.1rem;">0%</span>
                        </div>
                        <div class="progress rounded-2" style="height: 8px; background-color: #e8ecf1;">
                            <div id="stat-progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 0%; border-radius: 2px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Tables Row -->
    <div class="row g-3">
        <!-- Left Panel: Course Summary -->
        <div class="col-xl-5">
            <div class="card rounded-3 h-100 d-flex flex-column">
                <div class="card-header pb-0 border-0">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                            <i class="fas fa-book me-2 text-muted" style="opacity: 0.6;"></i> Course Summary
                        </h6>
                    </div>
                    <div class="filter-hint">
                        <i class="fas fa-info-circle" style="font-size: 0.85rem;"></i>
                        <span>Click a row to filter employees by course</span>
                    </div>
                </div>
                <div class="card-body p-0 flex-grow-1 overflow-hidden">
                    <div id="course-summary-grid"></div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Student Details -->
        <div class="col-xl-7">
            <div class="card rounded-3 h-100 d-flex flex-column">
                <div class="card-header pb-0 border-0">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2" style="flex-wrap: wrap;">
                        <h6 class="mb-0 fw-bold text-dark" style="font-size: 0.95rem;">
                            <i class="fas fa-users me-2 text-muted" style="opacity: 0.6;"></i> Employee Progress
                        </h6>
                        <div style="min-width: 250px;">
                            <div id="course-selector"></div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0 flex-grow-1 overflow-hidden">
                    <div id="student-progress-grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ASSIGNMENT_ID = @ViewBag.AssignmentId;

        $(() => {
            const loadPanel = $("#load-panel").dxLoadPanel({
                shadingColor: "rgba(255,255,255,0.8)",
                position: { of: "body" },
                visible: true,
                showIndicator: true,
                showPane: true,
                shading: true,
                message: "Loading assignment data..."
            }).dxLoadPanel("instance");

            const getCourses = $.ajax({ url: `${serviceUrl}/admin/CoursesCRUD/Get?skip=0&take=5000`, method: "GET", xhrFields: { withCredentials: true } });
            const getRule = $.ajax({ url: `${serviceUrl}/admin/AssignmentsCRUD/Get?key=${ASSIGNMENT_ID}`, method: "GET", xhrFields: { withCredentials: true } });

            $.when(getCourses, getRule).done(function(coursesRes, ruleRes) {
                let coursesData = coursesRes[0] || {};
                let ruleData = ruleRes[0] || {};

                let coursesMap = {};
                if(coursesData.data) {
                    coursesData.data.forEach(c => { coursesMap[c.id] = c; });
                }

                if(ruleData.data && ruleData.data.length > 0) {
                    const currentRule = ruleData.data[0];
                    const assignmentNo = currentRule.assignmentNo;

                    $("#lbl-assignment-no").text(assignmentNo || 'N/A');
                    $("#lbl-description").text(currentRule.description || '-');

                    const sDate = currentRule.startDate ? new Date(currentRule.startDate).toLocaleDateString('en-GB') : '-';
                    const dDate = currentRule.dueDate ? new Date(currentRule.dueDate).toLocaleDateString('en-GB') : '-';
                    $("#lbl-schedule").html(`<i class="far fa-calendar-alt text-muted me-2" style="opacity: 0.6;"></i> ${sDate} <i class="fas fa-arrow-right mx-2 text-muted" style="opacity: 0.4;"></i> ${dDate}`);

                    let ruleFilter = assignmentNo ? ["assignmentNo", "=", assignmentNo] : ["id", "=", ASSIGNMENT_ID];

                    createDataStore(serviceUrl, 'admin/AssignmentsCRUD').load({ filter: ruleFilter }).then(function(allRules) {

                        let enrollFilter = [];
                        allRules.forEach((r, i) => {
                            if (i > 0) enrollFilter.push("or");
                            enrollFilter.push(["assignmentRuleId", "=", r.id]);
                        });

                        $.ajax({
                            url: `${serviceUrl}/admin/EnrollmentsCRUD/Get`,
                            method: "GET",
                            data: { skip: 0, take: 20000, filter: JSON.stringify(enrollFilter) },
                            xhrFields: { withCredentials: true }
                        }).done(function(enrollRes) {
                            const allEnrollments = enrollRes.data || [];

                            // Calculate overall stats
                            const totalEnrollments = allEnrollments.length;
                            const completedEnrollments = allEnrollments.filter(e => e.isCompleted).length;
                            const overallProgress = totalEnrollments === 0 ? 0 : Math.round((completedEnrollments / totalEnrollments) * 100);
                            const uniqueStudents = new Set(allEnrollments.map(e => e.studentCode)).size;

                            $("#stat-total-courses").text(allRules.length);
                            $("#stat-total-emp").text(uniqueStudents);
                            $("#stat-progress-text").text(`${overallProgress}%`);
                            $("#stat-progress-bar").css("width", `${overallProgress}%`);

                            let courseSummaryData = allRules.map(rule => {
                                let ruleEnrollments = allEnrollments.filter(e => e.assignmentRuleId === rule.id);
                                let ruleTotal = ruleEnrollments.length;
                                let ruleCompleted = ruleEnrollments.filter(e => e.isCompleted).length;
                                let rulePercent = ruleTotal === 0 ? 0 : Math.round((ruleCompleted / ruleTotal) * 100);

                                return {
                                    id: rule.id,
                                    courseCode: coursesMap[rule.courseId]?.code || 'N/A',
                                    courseTitle: coursesMap[rule.courseId]?.title || `Unknown (ID: ${rule.courseId})`,
                                    totalStudents: ruleTotal,
                                    completedStudents: ruleCompleted,
                                    progressPercent: rulePercent
                                };
                            });

                            // --- 1. Course Summary Grid (Left) ---
                            $("#course-summary-grid").dxDataGrid({
                                dataSource: courseSummaryData,
                                keyExpr: "id",
                                showBorders: false,
                                rowAlternationEnabled: false,
                                hoverStateEnabled: true,
                                height: 450,
                                scrolling: { mode: "virtual" },
                                selection: { mode: "single" },
                                onSelectionChanged: function(e) {
                                    const selectBox = $("#course-selector").dxSelectBox("instance");
                                    if(e.selectedRowKeys.length > 0) {
                                        selectBox.option("value", e.selectedRowKeys[0]);
                                    } else {
                                        selectBox.option("value", "ALL");
                                    }
                                },
                                columns: [
                                    { 
                                        dataField: "courseCode", 
                                        caption: "Code", 
                                        width: 80, 
                                        alignment: "center",
                                        cssClass: "text-muted fw-semibold"
                                    },
                                    { 
                                        dataField: "courseTitle", 
                                        caption: "Course Title",
                                        cssClass: "fw-semibold"
                                    },
                                    { 
                                        dataField: "totalStudents", 
                                        caption: "Total", 
                                        width: 70, 
                                        alignment: "center",
                                        cellTemplate: function(container, options) {
                                            $(`<span class="text-muted fw-semibold">${options.value}</span>`).appendTo(container);
                                        }
                                    },
                                    { 
                                        dataField: "completedStudents", 
                                        caption: "Done", 
                                        width: 70, 
                                        alignment: "center",
                                        cellTemplate: function(container, options) {
                                            $(`<span class="fw-bold text-success">${options.value}</span>`).appendTo(container);
                                        }
                                    },
                                    {
                                        dataField: "progressPercent",
                                        caption: "Progress",
                                        width: 110,
                                        alignment: "center",
                                        cellTemplate: function(container, options) {
                                            const val = options.value;
                                            const width = Math.max(val, 5);
                                            const color = val >= 80 ? '#10b981' : val >= 50 ? '#3b82f6' : '#ef4444';
                                            const progressBar = `
                                                <div class="progress" style="height: 6px; background-color: #e8ecf1; border-radius: 3px;">
                                                    <div class="progress-bar" style="width: ${val}%; background-color: ${color}; border-radius: 3px;"></div>
                                                </div>
                                                <small class="text-muted fw-semibold mt-1 d-block">${val}%</small>`;
                                            $(progressBar).appendTo(container);
                                        }
                                    }
                                ]
                            });

                            const dropdownOptions = allRules.map(r => ({
                                id: r.id,
                                displayText: `${coursesMap[r.courseId]?.code || ''} - ${coursesMap[r.courseId]?.title || ''}`
                            }));
                            dropdownOptions.unshift({ id: "ALL", displayText: "All Courses" });

                            // --- 2. Course Filter Dropdown ---
                            $("#course-selector").dxSelectBox({
                                dataSource: dropdownOptions,
                                valueExpr: "id",
                                displayExpr: "displayText",
                                value: "ALL",
                                searchEnabled: true,
                                placeholder: "Filter by course...",
                                stylingMode: "outlined",
                                onValueChanged: function(e) {
                                    const studentGrid = $("#student-progress-grid").dxDataGrid("instance");
                                    const summaryGrid = $("#course-summary-grid").dxDataGrid("instance");

                                    if(e.value === "ALL") {
                                        studentGrid.filter(enrollFilter);
                                        summaryGrid.clearSelection();
                                    } else {
                                        studentGrid.filter(["assignmentRuleId", "=", e.value]);
                                        const currentSelected = summaryGrid.getSelectedRowKeys();
                                        if (currentSelected.indexOf(e.value) === -1) {
                                            summaryGrid.selectRows([e.value], false);
                                        }
                                    }
                                }
                            });

                            // --- 3. Student Progress Grid (Right) ---
                            $("#student-progress-grid").dxDataGrid({
                                dataSource: {
                                    store: createDataStore(serviceUrl, 'admin/EnrollmentsCRUD'),
                                    filter: enrollFilter
                                },
                                showBorders: false,
                                rowAlternationEnabled: false,
                                hoverStateEnabled: true,
                                filterRow: { visible: false },
                                searchPanel: { visible: true, width: 200, placeholder: "Search Emp ID..." },
                                scrolling: { mode: "virtual" },
                                height: 450,
                                export: { enabled: true, allowExportSelectedData: true },
                                columns: [
                                    { 
                                        dataField: "studentCode", 
                                        caption: "Emp ID", 
                                        width: 100, 
                                        alignment: "center",
                                        cssClass: "fw-semibold text-muted"
                                    },
                                    {
                                        caption: "Course",
                                        width: 90,
                                        alignment: "center",
                                        calculateCellValue: function(rowData) {
                                            const rule = allRules.find(r => r.id === rowData.assignmentRuleId);
                                            return rule && coursesMap[rule.courseId] ? coursesMap[rule.courseId].code : "-";
                                        },
                                        cssClass: "text-muted fw-semibold"
                                    },
                                    {
                                        caption: "Employee",
                                        minWidth: 150,
                                        calculateCellValue: function(rowData) {
                                            return `${rowData.studentCode || ''}`;
                                        },
                                        cellTemplate: function(container, options) {
                                            const data = options.data;
                                            const rule = allRules.find(r => r.id === data.assignmentRuleId);
                                            const courseName = rule && coursesMap[rule.courseId] ? coursesMap[rule.courseId].code : '';
                                            $(`<div class="fw-semibold text-dark">${data.studentCode}</div><small class="text-muted">${courseName}</small>`).appendTo(container);
                                        }
                                    },
                                    {
                                        dataField: "progress",
                                        caption: "Progress",
                                        minWidth: 140,
                                        cellTemplate: function(container, options) {
                                            const val = options.value || 0;
                                            const color = val === 100 ? '#10b981' : '#3b82f6';
                                            const progressBar = `
                                                <div class="progress shadow-sm" style="height: 6px; background-color: #e8ecf1; border-radius: 3px; overflow: hidden;">
                                                    <div class="progress-bar" style="width: ${val}%; background-color: ${color}; border-radius: 3px;"></div>
                                                </div>
                                                <small class="text-muted fw-semibold mt-1 d-block">${val}%</small>`;
                                            $(progressBar).appendTo(container);
                                        }
                                    },
                                    {
                                        dataField: "isCompleted",
                                        caption: "Status",
                                        width: 110,
                                        alignment: "center",
                                        cellTemplate: function(container, options) {
                                            if (options.value) {
                                                $(`<span class="badge bg-success bg-opacity-10 text-success fw-semibold" style="font-size: 0.85rem;">
                                                    <i class="fas fa-check-circle me-1"></i> Done
                                                </span>`).appendTo(container);
                                            } else {
                                                $(`<span class="badge bg-warning bg-opacity-10 text-warning fw-semibold" style="font-size: 0.85rem;">
                                                    <i class="fas fa-hourglass-half me-1"></i> In Progress
                                                </span>`).appendTo(container);
                                            }
                                        }
                                    },
                                    { 
                                        dataField: "completedDate", 
                                        caption: "Completed", 
                                        dataType: "datetime", 
                                        format: "dd/MM/yyyy HH:mm", 
                                        alignment: "center", 
                                        width: 140,
                                        cssClass: "text-muted"
                                    }
                                ],
                                onContentReady: () => loadPanel.hide()
                            });

                        }).fail(() => showApiError());
                    });
                } else {
                    showApiError();
                }
            }).fail(() => showApiError());

            function showApiError() {
                loadPanel.hide();
                DevExpress.ui.notify("Unable to load assignment data. Please try again.", "error", 4000);
            }
        });
    </script>
}