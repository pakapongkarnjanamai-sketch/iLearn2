@{
    ViewBag.Title = "Auto-Assign Rules";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-cogs"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Set rules for automatic course assignment based on organization structure.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewRule()">
                    <i class="fas fa-plus me-2"></i> New Rule
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;
        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/AssignmentRulesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search rules..." },

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this assignment rule?" },
                    popup: {
                        title: "Assignment Rule Config",
                        showTitle: true,
                        width: 700,
                        height: 'auto'
                    },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                caption: 'Select Course',
                                colCount: 1,
                                items: [
                                    {
                                        dataField: 'courseId',
                                        label: { text: "Course" }
                                    }
                                ]
                            },
                            {
                                itemType: 'group',
                                caption: 'Target Audience (Leave empty for "All")',
                                colCount: 2,
                                items: [
                                    { dataField: 'division', label: { text: "Division" } },
                                    { dataField: 'department', label: { text: "Department" } },
                                    { dataField: 'section', label: { text: "Section" } },
                                    { dataField: 'position', label: { text: "Position" } }
                                ]
                            },
                            {
                                itemType: 'group',
                                caption: 'Schedule Control',
                                colCount: 2,
                                items: [
                                    {
                                        dataField: 'startDate',
                                        dataType: 'date',
                                        editorOptions: { displayFormat: 'dd/MM/yyyy', showClearButton: true }
                                    },
                                    {
                                        dataField: 'dueDate',
                                        dataType: 'date',
                                        editorOptions: { displayFormat: 'dd/MM/yyyy', showClearButton: true }
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "courseId",
                        caption: "Course",
                        minWidth: 200,
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/CoursesCRUD'),
                            displayExpr: 'title',
                            valueExpr: 'id'
                        },
                        validationRules: [{ type: "required", message: "Course is required" }]
                    },
                    {
                        dataField: "division",
                        caption: "Division",
                        width: 120,
                        cellTemplate: (container, options) => {
                            renderBadge(container, options.value, "bg-info", "All Divisions");
                        }
                    },
                    {
                        dataField: "department",
                        caption: "Department",
                        width: 120,
                        cellTemplate: (container, options) => {
                            renderBadge(container, options.value, "bg-success", "All Depts");
                        }
                    },
                    {
                        dataField: "section",
                        caption: "Section",
                        width: 120
                    },
                    {
                        dataField: "position",
                        caption: "Position",
                        width: 120
                    },
                    {
                        dataField: "startDate",
                        caption: "Start",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110
                    },
                    {
                        dataField: "dueDate",
                        caption: "Due Date",
                        dataType: "date",
                        format: "dd/MM/yyyy",
                        width: 110
                    },
                    {
                        type: "buttons",
                        caption: "Actions",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        // Helper function สำหรับวาด Badge สวยๆ ในตาราง
        function renderBadge(container, value, badgeClass, emptyText) {
            if (value) {
                $("<span>").addClass("badge " + badgeClass + " px-2 py-1").text(value).appendTo(container);
            } else {
                $("<span>").addClass("text-muted small").html("<i>" + emptyText + "</i>").appendTo(container);
            }
        }

        function addNewRule() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}