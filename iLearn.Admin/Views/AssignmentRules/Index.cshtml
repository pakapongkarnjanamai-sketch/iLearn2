@{
    ViewBag.Title = "Auto-Assign Rules";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-cogs"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Set rules for automatic course assignment based on division or role.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewRule()">
                    <i class="fas fa-plus me-2"></i> New Rule
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/AssignmentRulesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search rules..." },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this assignment rule?" },
                    popup: {
                        title: "Assignment Rule Info",
                        showTitle: true,
                        width: 500,
                        height: 'auto'
                    },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                colCount: 1,
                                items: [
                                    { dataField: 'courseId' },
                                    {
                                        dataField: 'divisionId',
                                        editorOptions: { showClearButton: true },
                                        helpText: "Leave empty for All Divisions"
                                    },
                                    {
                                        dataField: 'roleId',
                                        editorOptions: { showClearButton: true },
                                        helpText: "Leave empty for All Roles"
                                    }
                                ]
                            }
                        ]
                    }
                },
                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
              
                    },
                    {
                        dataField: "courseId",
                        caption: "Course",
                        minWidth: 250,
                     
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/CoursesCRUD'),
                            displayExpr: 'title',
                            valueExpr: 'id'
                        },
                        validationRules: [{ type: "required", message: "Course is required" }]
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division (Target)",
                        width: 200,
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            if (options.displayValue) {
                                $("<span>").addClass("badge bg-light text-info border px-2 py-1").text(options.displayValue).appendTo(container);
                            } else {
                                $("<span>").addClass("text-muted small").html('<i>All Divisions</i>').appendTo(container);
                            }
                        }
                    },
                    {
                        dataField: "roleId",
                        caption: "Role (Target)",
                        width: 200,
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            if (options.displayValue) {
                                $("<span>").addClass("badge bg-light text-secondary border px-2 py-1").text(options.displayValue).appendTo(container);
                            } else {
                                $("<span>").addClass("text-muted small").html('<i>All Roles</i>').appendTo(container);
                            }
                        }
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับเรียกใช้งานปุ่ม New Rule ด้านบน
        function addNewRule() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}