@{
    ViewBag.Title = "Roles Management";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage system roles, permissions, and role types.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewRole()">
                    <i class="fas fa-plus me-2"></i> New Role
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // กำหนด Enum สำหรับ RoleType ใน Frontend
        const roleTypes = [
            { id: 0, name: 'User' },
            { id: 1, name: 'Manager' },
            { id: 2, name: 'Admin' },
            { id: 3, name: 'SuperAdmin' }
        ];

        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search roles..." },
                groupPanel: { emptyPanelText: 'Drag a column header here to group', visible: true },

                // --- ปรับแต่ง UI ตารางหลัก ---
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,

                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'Roles_Data'),

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    texts: { confirmDeleteMessage: "Are you sure you want to delete this role?" },
                    popup: {
                        title: "Role Information",
                        showTitle: true,
                        width: 500,
                        height: 'auto'
                    },
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                colCount: 1,
                                items: [
                                    { dataField: 'name', validationRules: [{ type: "required" }] },
                                    { dataField: 'divisionId' },
                                    { dataField: 'roleType', validationRules: [{ type: "required" }] }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
            
                    },
                    {
                        dataField: "name",
                        caption: "Role Name",
                        minWidth: 200,
                
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "roleType",
                        caption: "Role Type",
                        lookup: {
                            dataSource: roleTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            if(text) {
                                // ทำให้ Type ดูโดดเด่นขึ้นด้วย Badge แบบสว่าง
                                $("<span>").addClass("badge bg-light text-primary border px-2 py-1").text(text).appendTo(container);
                            }
                        }
                    },

                    // --- คอลัมน์ Action แบบ Native DevExtreme ---
                    {
                        type: "buttons",
                        caption: "Manage",
                        width: 100,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        buttons: ["edit", "delete"]
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับเรียกใช้งานปุ่ม New Role ด้านบน
        function addNewRole() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}