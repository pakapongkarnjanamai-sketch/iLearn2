@{
    ViewBag.Title = "Roles Management";
}

<div class="page-header">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm page-title-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div>
                    @ViewBag.Title
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.9rem;">
                        Manage system roles, permissions, and role types.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="addNewRole()">
                    <i class="fas fa-plus me-2"></i> New Role
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="content-card">
        <div class="p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // กำหนด Enum สำหรับ RoleType ใน Frontend
        const roleTypes = [
            { id: 0, name: 'User' },
            { id: 1, name: 'Manager' },
            { id: 2, name: 'Admin' },
            { id: 3, name: 'SuperAdmin' }
        ];

        let gridInstance;

        $(() => {
            // ใช้ initDxGrid ตามมาตรฐานระบบ
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { placeholder: "Search roles..." },
                groupPanel: { emptyPanelText: 'Drag a column header here to group', visible: true },

                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'Roles_Data'),

                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    form: {
                        items: [
                            {
                                itemType: 'group',
                                colCount: 2,
                                colSpan: 2,
                                items: [
                                    { dataField: 'id', editorOptions: { disabled: true } },
                                    { dataField: 'name' },
                                    { dataField: 'divisionId' },
                                    { dataField: 'roleType' }
                                ]
                            }
                        ]
                    }
                },

                columns: [
                    {
                        dataField: "id",
                        caption: "ID",
                        width: 80,
                        allowUpdating: false,
                        alignment: "center",
                        cssClass: "text-muted"
                    },
                    {
                        dataField: "name",
                        caption: "Role Name",
                        minWidth: 200,
                        cssClass: "fw-bold text-dark"
                    },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "roleType",
                        caption: "Role Type",
                        lookup: {
                            dataSource: roleTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        },
                        cellTemplate: function(container, options) {
                            const text = options.displayValue;
                            if(text) {
                                // ทำให้ Type ดูโดดเด่นขึ้นด้วย Badge
                                $("<span>").addClass("badge bg-info text-dark").text(text).appendTo(container);
                            }
                        }
                    },

                    // --- คอลัมน์ Action แบบมาตรฐาน ---
                    {
                        caption: "Manage",
                        width: 120,
                        alignment: "center",
                        fixed: true,
                        fixedPosition: "right",
                        cellTemplate: function(container, options) {
                            const data = options.data;
                            const $group = $("<div>").addClass("action-group");

                            // ปุ่ม Edit
                            $("<button>")
                                .addClass("btn-icon text-primary")
                                .attr("title", "Edit Role")
                                .html('<i class="fas fa-edit"></i>')
                                .on("click", () => gridInstance.editRow(options.rowIndex))
                                .appendTo($group);

                            // ปุ่ม Delete
                            $("<button>")
                                .addClass("btn-icon text-danger")
                                .attr("title", "Delete Role")
                                .html('<i class="fas fa-trash-alt"></i>')
                                .on("click", () => {
                                    DevExpress.ui.dialog.confirm(`Are you sure you want to delete role <b>${data.name}</b>?`, "Confirm Delete").done((res) => {
                                        if (res) gridInstance.deleteRow(options.rowIndex);
                                    });
                                })
                                .appendTo($group);

                            $group.appendTo(container);
                        }
                    }
                ]
            });
        });

        // ฟังก์ชันสำหรับเรียกใช้งานปุ่ม New Role ด้านบน
        function addNewRole() {
            if(gridInstance) {
                gridInstance.addRow();
            }
        }
    </script>
}