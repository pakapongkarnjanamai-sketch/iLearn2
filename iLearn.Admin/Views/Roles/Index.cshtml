@{
    ViewBag.Title = "Roles Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <div class="fw-bold text-dark" style="font-size:15px;">Roles Management</div>
        <div class="text-secondary" style="font-size:12px;">Manage system roles, permissions, and role types.</div>
    </div>
    <a href="javascript:void(0);" class="action-link primary" onclick="addNewRole()">
        <i class="fas fa-plus"></i> New Role
    </a>
</div>

<div class="container-fluid px-4 py-3">
    <div class="border rounded bg-white">
        <div id="grid"></div>
    </div>
</div>

@section Scripts {
    <script>
        const roleTypes = [
            { id: 0, name: 'User' },
            { id: 1, name: 'Manager' },
            { id: 2, name: 'Admin' },
            { id: 3, name: 'SuperAdmin' }
        ];
        const dsDivisionsLookup = {
            store: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
            loadMode: 'raw',
            cacheRawData: true
        };
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search roles..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'Roles_Data'),
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: { title: "Role Information", showTitle: true, width: 500, height: 'auto' }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Role Name", minWidth: 200, validationRules: [{ type: "required" }] },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        lookup: {
                            dataSource: dsDivisionsLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "roleType",
                        caption: "Role Type",
                        validationRules: [{ type: "required" }],
                        lookup: {
                            dataSource: roleTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    }
                ]
            });
        });

        function addNewRole() {
            if(gridInstance) gridInstance.addRow();
        }
    </script>
}