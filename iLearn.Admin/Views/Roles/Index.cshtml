@{
    ViewBag.Title = "Roles Management";
}

<!-- ── Page Header ── -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title">Roles Management</h1>
        <div class="page-subtitle">Manage system roles, permissions, and role types.</div>
    </div>
    <button type="button" class="action-link primary" onclick="addNewRole()">
        <i class="fas fa-plus" aria-hidden="true"></i> New Role
    </button>
</div>

<div class="container-fluid px-4 py-3 pb-4 h-100 d-flex flex-column gap-3">
    <div class="row g-3 h-100 admin-responsive-content">
        <div id="grid" class="h-100"></div>
    </div>
</div>



@section Scripts {
    <script>
        const roleTypes = [

            { id: 0, name: 'Admin' },
            { id: 1, name: 'SuperAdmin' }
        ];
        const dsDivisionsLookup = {
            store: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
            loadMode: 'raw',
            cacheRawData: true
        };
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", buildAdminGridOptions("Search roles...", {
                dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                remoteOperations: true,
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'Roles_Data'),
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: { title: "Role Information", showTitle: true, width: 500, height: 'auto' }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Role Name", minWidth: 200, validationRules: [{ type: "required" }] },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        lookup: {
                            dataSource: dsDivisionsLookup,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "roleType",
                        caption: "Role Type",
                        validationRules: [{ type: "required" }],
                        lookup: {
                            dataSource: roleTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    }
                ]
            }));
        });

        function addNewRole() {
            if(gridInstance) gridInstance.addRow();
        }
    </script>
}