@{
    ViewBag.Title = "Roles Management";
}

<div class="page-header shadow-sm border-0 mb-4 rounded">
    <div class="container-fluid px-4 py-2">
        <div class="d-flex align-items-center justify-content-between">
            <h1 class="page-title mb-0 d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 1.2rem;">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div>
                    <div class="fw-bold text-dark" style="font-size: 1.25rem;">@ViewBag.Title</div>
                    <div class="text-muted fw-normal mt-1" style="font-size: 0.85rem;">
                        Manage system roles, permissions, and role types.
                    </div>
                </div>
            </h1>
            <div>
                <button class="btn btn-primary rounded shadow-sm px-3" onclick="addNewRole()">
                    <i class="fas fa-plus me-2"></i> New Role
                </button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid px-4 pb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div id="grid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const roleTypes = [
            { id: 0, name: 'User' },
            { id: 1, name: 'Manager' },
            { id: 2, name: 'Admin' },
            { id: 3, name: 'SuperAdmin' }
        ];
        let gridInstance;

        $(() => {
            gridInstance = initDxGrid("#grid", {
                dataSource: createDataStore(serviceUrl, 'admin/RolesCRUD'),
                remoteOperations: true,
                selection: { mode: 'single' },
                searchPanel: { visible: true, placeholder: "Search roles..." },
                showBorders: false,
                rowAlternationEnabled: true,
                showRowLines: true,
                hoverStateEnabled: true,
                export: { enabled: true },
                onExporting: (e) => handleExporting(e, 'Roles_Data'),
                editing: {
                    mode: "popup",
                    allowUpdating: true,
                    allowDeleting: true,
                    allowAdding: true,
                    useIcons: true,
                    popup: { title: "Role Information", showTitle: true, width: 500, height: 'auto' }
                },
                columns: [
                    { dataField: "id", caption: "ID", width: 80, allowUpdating: false, alignment: "center" },
                    { dataField: "name", caption: "Role Name", minWidth: 200, validationRules: [{ type: "required" }] },
                    {
                        dataField: "divisionId",
                        caption: "Division",
                        lookup: {
                            dataSource: createDataStore(serviceUrl, 'admin/DivisionsCRUD'),
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    },
                    {
                        dataField: "roleType",
                        caption: "Role Type",
                        validationRules: [{ type: "required" }],
                        lookup: {
                            dataSource: roleTypes,
                            displayExpr: 'name',
                            valueExpr: 'id'
                        }
                    }
                ]
            });
        });

        function addNewRole() {
            if(gridInstance) gridInstance.addRow();
        }
    </script>
}