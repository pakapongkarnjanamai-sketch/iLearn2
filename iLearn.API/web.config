<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 210 MB = allow multipart envelope overhead above 200 MB SCORM payload -->
        <requestLimits maxAllowedContentLength="220200960" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
