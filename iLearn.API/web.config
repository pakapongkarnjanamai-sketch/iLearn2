<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 110 MB = allow multipart envelope overhead above 100 MB SCORM payload -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
