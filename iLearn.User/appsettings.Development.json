{
  "ApiSettings": {
      "BaseUrl": "https://localhost:7128/api"
  },
  "LearnerProxyAuth": {
    "SharedSecret": "__SET_LEARNER_PROXY_SHARED_SECRET_VIA_USER_SECRETS_OR_ENV__",
