@using System.Security.Claims
@{
    ViewData["Title"] = "Learning Player";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";

    // รับ EnrollmentId
    var enrollmentId = ViewBag.EnrollmentId ?? ViewBag.PlayerId ?? 0;
    // รับ StudentCode
    var studentCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

@section Styles {
    <style>
        :root {
            --sidebar-width: 400px;
            --primary-color: #007bff;
            --secondary-bg: #f5f7fa;
            --success-color: #28a745;
        }

        body {
            overflow: hidden;
        }

        .viewer-container {
            display: grid;
            grid-template-columns: 1fr var(--sidebar-width);
            gap: 0;
            height: calc(100vh);
            background-color: var(--secondary-bg);
        }

        /* --- Player Section --- */
        .scorm-section {
            display: flex;
            flex-direction: column;
            background: #000;
            position: relative;
        }

        .scorm-toolbar {
            height: 50px;
            padding: 0 20px;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scorm-body {
            flex: 1;
            position: relative;
            background: #e9ecef;
        }

        iframe#scormFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: none;
            background: #fff;
        }

        /* Overlay */
        .start-overlay {
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .start-btn {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            font-size: 32px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0,123,255,0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .start-btn:hover {
                transform: scale(1.05);
                background: #0056b3;
                box-shadow: 0 8px 25px rgba(0,123,255,0.4);
            }

        /* --- Summary Modal (ปรับปรุงใหม่) --- */
        .summary-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 999; /* Z-index สูงๆ */
            backdrop-filter: blur(2px);
        }

        .summary-card {
            background: white;
            width: 500px;
            border-radius: 12px;
            padding: 0;
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            overflow: hidden;
            animation: slideUp 0.3s ease-out;
        }
        @@keyframes slideUp {
            from

        {
            transform: translateY(20px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }

        }

        .summary-header {
            background: var(--primary-color);
            color: white;
            padding: 20px;
            text-align: center;
        }

        .summary-content {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
        }

        .summary-footer {
            padding: 15px 20px;
            border-top: 1px solid #eee;
            background: #f8f9fa;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .info-label {
            color: #6c757d;
            font-weight: 500;
        }

        .info-value {
            color: #212529;
            font-weight: 600;
            text-align: right;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 0.9rem;
        }

            .summary-table th {
                text-align: left;
                padding: 8px;
                border-bottom: 2px solid #dee2e6;
                color: #495057;
            }

            .summary-table td {
                padding: 8px;
                border-bottom: 1px solid #eee;
                vertical-align: middle;
            }

                .summary-table td:last-child {
                    text-align: right;
                    font-family: monospace;
                    font-size: 1rem;
                }

        .total-time-box {
            background-color: #e8f5e9;
            border: 1px solid #c8e6c9;
            color: #2e7d32;
            padding: 10px;
            border-radius: 6px;
            margin-top: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        /* --- Sidebar --- */
        .info-section {
            background: #fff;
            border-left: 1px solid #dee2e6;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .course-header-panel {
            padding: 20px;
            background-color: #fff;
            border-bottom: 1px solid #f0f0f0;
        }

        .info-status-bar {
            padding: 15px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .toc-header {
            padding: 15px 20px;
            background-color: #fff;
            font-weight: 700;
            color: #495057;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
        }

        .course-toc {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #fcfcfc;
        }

        .resource-item {
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 8px;
            padding: 12px;
            position: relative;
            overflow: hidden;
        }

            .resource-item.active {
                border-color: var(--primary-color);
                background-color: #f0f7ff;
            }

        .item-progress-track {
            height: 4px;
            background: #e9ecef;
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
        }

        .item-progress-fill {
            height: 100%;
            background: var(--success-color);
            width: 0%;
            transition: width 0.5s ease;
        }

        .resource-type-badge {
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e2e6ea;
            color: #6c757d;
            display: inline-block;
            margin-top: 4px;
        }

        .save-btn-container {
            padding: 15px;
            border-top: 1px solid #dee2e6;
            background: #fff;
        }

        .btn-save-course {
            width: 100%;
            background-color: var(--success-color);
            color: white;
            font-weight: bold;
            border: none;
            padding: 12px;
            border-radius: 6px;
            transition: all 0.3s;
            font-size: 1rem;
        }

            .btn-save-course:disabled {
                background-color: #ccc;
                cursor: not-allowed;
            }

            .btn-save-course:hover:not(:disabled) {
                background-color: #218838;
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(40,167,69,0.3);
            }

        @@media (max-width: 992px) {
            body {
                overflow: visible;
            }

            .viewer-container {
                grid-template-columns: 1fr;
                height: auto;
                overflow-y: auto;
            }

            .scorm-section {
                height: 50vh;
                min-height: 300px;
            }

            .info-section {
                height: auto;
                border-left: none;
                border-top: 1px solid #dee2e6;
            }
        }
    </style>
}

<div class="container-fluid p-0 viewer-container">

    <div class="scorm-section" id="fullscreenArea">
        <div class="scorm-toolbar">
            <div class="d-flex align-items-center overflow-hidden">
                <button class="btn btn-sm btn-light me-2 d-lg-none" onclick="scrollToToc()">
                    <i class="fas fa-list"></i>
                </button>
                <div class="fw-bold text-truncate" id="lessonTitle" style="max-width: 600px;">
                    Loading...
                </div>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary border-0" onclick="toggleFullscreen()" title="Fullscreen">
                    <i class="fas fa-expand fa-lg"></i>
                </button>
            </div>
        </div>

        <div class="scorm-body">
            <div id="startOverlay" class="start-overlay">
                <button class="start-btn" onclick="startCourse()">
                    <i class="fas fa-play ps-1"></i>
                </button>
            
                <p id="overlayMessage" class="text-muted mt-4 ">กดปุ่ม Play เพื่อเข้าสู่เนื้อหา</p>
            </div>

            <div id="summaryModal" class="summary-overlay">
                <div class="summary-card">
                    <div class="summary-header">
                        <h5 class="mb-0"><i class="fas fa-clipboard-list me-2"></i> สรุปผลการเรียน</h5>
                    </div>
                    <div class="summary-content">
                        <div class="info-row">
                            <span class="info-label">ผู้เรียน:</span>
                            <span class="info-value" id="sumStudentName">-</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">หลักสูตร:</span>
                            <span class="info-value text-primary text-truncate" style="max-width: 300px;" id="sumCourseName">-</span>
                        </div>

                        <hr class="my-3 text-muted" style="opacity: 0.2;">

                        <h6 class="text-muted small text-uppercase fw-bold mb-2">รายละเอียดเนื้อหา</h6>
                        <table class="summary-table">
                            <thead>
                                <tr>
                                    <th>หัวข้อเรื่อง</th>
                                    <th width="80" class="text-end">เวลา</th>
                                </tr>
                            </thead>
                            <tbody id="summaryDetailsList">
                            </tbody>
                        </table>

                        <div class="total-time-box">
                            <span>เวลารวมทั้งหมด</span>
                            <span id="sumTotalTime">00:00:00</span>
                        </div>
                    </div>

                    <div class="summary-footer">
                        <button class="btn btn-light" onclick="closeSummary()">ยกเลิก</button>
                        <button class="btn btn-primary px-4" id="btnConfirmSave" onclick="executeSave()">
                            <i class="fas fa-check me-1"></i> ตกลง
                        </button>
                    </div>
                </div>
            </div>

            <iframe id="scormFrame" sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"></iframe>
        </div>
    </div>

    <div class="info-section" id="tocSection">
        <div class="course-header-panel">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold text-dark mb-1" id="courseTitleDisplay">...</h5>
                    <div class="text-muted small">
                        <i class="fas fa-user-circle me-1"></i>
                        <span id="studentCodeDisplay" class="fw-bold text-primary">-</span>
                    </div>
                </div>
                <span class="badge bg-secondary" id="versionDisplay">v.1</span>
            </div>
        </div>

        <div class="info-status-bar">
            <div class="row g-0 text-center bg-white border rounded overflow-hidden">
                <div class="col-6 border-end p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Total Status</small>
                    <div id="statusDisplay" class="fw-bold mt-1 text-secondary" style="font-size: 0.9rem;">-</div>
                </div>
                <div class="col-6 p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Total Progress</small>
                    <div id="totalProgressDisplay" class="fw-bold mt-1 text-dark" style="font-size: 0.9rem;">0%</div>
                </div>
            </div>
        </div>

        <div class="toc-header">
            <i class="fas fa-list-ul me-2 text-primary"></i> เนื้อหาหลักสูตร
        </div>

        <div class="course-toc" id="courseTocList">
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted small">กำลังโหลดข้อมูล...</p>
            </div>
        </div>

        <div class="save-btn-container">
            <button id="btnPreSave" class="btn-save-course" disabled onclick="showSummaryBeforeSave()">
                <i class="fas fa-save me-2"></i> บันทึกการเรียนรู้
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Configuration ---
        const ENROLLMENT_ID = "@enrollmentId";
        const currentStudentCode = '@studentCode';
        const baseUrl = (typeof serviceUrl !== 'undefined') ? serviceUrl : '';

        // --- State ---
        let currentData = null;
        let selectedResourceIndex = -1;

        $(function() {
            initScormAdapter();
            loadCourseData();
        });

        // 1. Load Data
        async function loadCourseData() {
            if(!ENROLLMENT_ID || ENROLLMENT_ID == 0) {
                 showError("ไม่พบ Enrollment ID");
                 return;
            }
            try {
                const url = `${baseUrl}/enrollments/player-info/${ENROLLMENT_ID}?studentCode=${encodeURIComponent(currentStudentCode)}`;
                const response = await $.ajax({
                    url: url, method: 'GET', dataType: 'json', xhrFields: { withCredentials: true }
                });

                if (response && response.success) {
                    currentData = response.data;
                    if(currentData.resources) {
                        currentData.resources.forEach(r => {
                            r.clientProgress = 0;
                            r.clientStatus = "incomplete";
                            r.scormTime = "00:00:00";
                        });
                    }
                    renderUI(currentData);
                    recalcTotalProgress();
                } else {
                    showError("ไม่สามารถโหลดข้อมูลได้: " + (response.message || "Unknown error"));
                }
            } catch (err) {
                console.error(err);
                showError("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์");
            }
        }

        // 2. Render UI
        function renderUI(data) {
            $("#courseTitleDisplay").text(data.courseTitle || "ไม่มีชื่อหลักสูตร");
            $("#studentCodeDisplay").text(currentStudentCode || "-");
            $("#versionDisplay").text("v." + (data.courseVersionId || "1"));

            const listContainer = $("#courseTocList");
            listContainer.empty();

            if (!data.resources || data.resources.length === 0) {
                listContainer.html('<div class="alert alert-warning m-3">ไม่พบเนื้อหาในหลักสูตรนี้</div>');
                return;
            }

            data.resources.forEach((item, index) => {
                let iconClass = "far fa-file";
                if (item.type === "Lesson") iconClass = "fas fa-book-open text-primary";
                else if (item.type === "Exam") iconClass = "fas fa-pencil-alt text-warning";

                const html = `
                    <div class="resource-item" id="res-item-${index}" onclick="selectResource(${index})">
                        <div class="d-flex align-items-center">
                            <div class="me-3 fs-4" style="width: 30px; text-align: center;">
                                <i class="${iconClass}"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-truncate" title="${item.name}">${item.name}</div>
                                <span class="resource-type-badge">${item.type}</span>
                            </div>
                            <div class="ms-2 fw-bold small text-muted" id="res-percent-${index}">0%</div>
                        </div>
                        <div class="item-progress-track">
                            <div class="item-progress-fill" id="res-bar-${index}"></div>
                        </div>
                    </div>
                `;
                listContainer.append(html);
            });
            if (data.resources.length > 0) selectResource(0);
        }

        // 3. Select Resource
        function selectResource(index) {
            if (!currentData || !currentData.resources[index]) return;
            selectedResourceIndex = index;
            const resource = currentData.resources[index];

            $(".resource-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");
            $("#lessonTitle").text(resource.name);

            $("#scormFrame").attr("src", "");
            $("#scormFrame").hide();
            $("#startOverlay").fadeIn(200);
        }

        // 4. Start Course
        function startCourse() {
            if (selectedResourceIndex === -1) return;
            const resource = currentData.resources[selectedResourceIndex];
            if (!resource || !resource.launchUrl) {
                DevExpress.ui.notify("Invalid Launch URL", "error", 2000);
                return;
            }
            $("#startOverlay").fadeOut(200);
            const iframe = document.getElementById("scormFrame");
            iframe.style.display = "block";
            iframe.src = resource.launchUrl;
        }

        // 5. Recalculate Progress (Logic: 100% Only to Save)
        function recalcTotalProgress() {
            if(!currentData || !currentData.resources) return;

            let totalP = 0;
            const count = currentData.resources.length;

            currentData.resources.forEach((r, idx) => {
                const p = r.clientProgress || 0;
                totalP += p;
                $(`#res-percent-${idx}`).text(p + "%");
                $(`#res-bar-${idx}`).css("width", p + "%");
                if (p === 100) $(`#res-percent-${idx}`).addClass("text-success").removeClass("text-muted");
            });

            const avg = count > 0 ? Math.floor(totalP / count) : 0;
            $("#totalProgressDisplay").text(avg + "%");

            const statusElem = $("#statusDisplay");
            if (avg === 100) {
                statusElem.text("COMPLETED").addClass("text-success").removeClass("text-secondary");
                $("#btnPreSave").prop("disabled", false);
            } else {
                statusElem.text("INCOMPLETE").addClass("text-secondary").removeClass("text-success");
                $("#btnPreSave").prop("disabled", true);
            }
        }

        // 6. [NEW] Show Summary Before Save
        function showSummaryBeforeSave() {
            if (!currentData) return;

            // 6.1 Set Header Info
            $("#sumStudentName").text(currentStudentCode);
            $("#sumCourseName").text(currentData.courseTitle);

            // 6.2 Loop Resources and Calculate Total Time
            const listContainer = $("#summaryDetailsList");
            listContainer.empty();

            let totalSeconds = 0;

            currentData.resources.forEach((r) => {
                const timeStr = r.scormTime || "00:00:00";
                const sec = timeToSeconds(timeStr);
                totalSeconds += sec;

                const shortName = r.name.length > 40 ? r.name.substring(0, 38) + "..." : r.name;

                const row = `
                    <tr>
                        <td>
                            <div class="text-truncate" title="${r.name}">${shortName}</div>
                        </td>
                        <td>${formatTime(sec)}</td>
                    </tr>
                `;
                listContainer.append(row);
            });

            // 6.3 Set Total Time
            $("#sumTotalTime").text(formatTime(totalSeconds));

            // 6.4 Show Modal
            $("#summaryModal").css("display", "flex").hide().fadeIn();
        }

        // 7. [NEW] Execute Real Save (Called when clicking "ตกลง")
        function executeSave() {
             if (selectedResourceIndex === -1 || !currentData) return;
             const resource = currentData.resources[selectedResourceIndex];

             // Payload
             const payload = {
                StudentCode: currentStudentCode,
                EnrollmentId: parseInt(ENROLLMENT_ID),
                ResourceId: resource.id,
                Status: resource.clientStatus,
                Progress: resource.clientProgress,
                SessionTime: resource.scormTime
            };

            const btn = $("#btnConfirmSave");
            const oldHtml = btn.html();
            btn.prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> กำลังบันทึก...');

            $.ajax({
                url: baseUrl + '/learninglogs/update-progress',
                method: 'POST',
                contentType: 'application/json',
                xhrFields: { withCredentials: true },
                data: JSON.stringify(payload),
                success: function(res) {
                    btn.prop("disabled", false).html(oldHtml);
                    closeSummary();
                    DevExpress.ui.notify("บันทึกข้อมูลเรียบร้อยแล้ว", "success", 3000);
                },
                error: function(err) {
                    console.error("Save Error:", err);
                    btn.prop("disabled", false).html(oldHtml);
                    DevExpress.ui.notify("เกิดข้อผิดพลาดในการบันทึก", "error", 3000);
                }
            });
        }

        function closeSummary() { $("#summaryModal").fadeOut(); }

        // --- Helpers ---
        function timeToSeconds(timeStr) {
            // รองรับ "00:00:00" หรือ "HH:MM:SS"
            if (!timeStr) return 0;
            // ถ้าเป็น SCORM 2004 PT..H..M..S ให้แปลงก่อน (แต่ในโค้ดนี้เราแปลงตอนรับค่าแล้ว)
            // สมมติว่าเป็น HH:MM:SS
            const parts = timeStr.split(':');
            let s = 0;
            if (parts.length === 3) {
                s += parseInt(parts[0]) * 3600;
                s += parseInt(parts[1]) * 60;
                s += parseInt(parts[2]);
            } else if (parts.length === 2) {
                s += parseInt(parts[0]) * 60;
                s += parseInt(parts[1]);
            }
            return isNaN(s) ? 0 : s;
        }

        function formatTime(totalSeconds) {
            const h = Math.floor(totalSeconds / 3600);
            const m = Math.floor((totalSeconds % 3600) / 60);
            const s = Math.floor(totalSeconds % 60);
            const pad = (n) => n.toString().padStart(2, '0');
            return `${pad(h)}:${pad(m)}:${pad(s)}`;
        }

        function formatScormTime(timeStr) {
            // Helper เพื่อแปลง SCORM PT... เป็น HH:MM:SS เก็บไว้ในตัวแปร
            if (!timeStr) return "00:00:00";
            if (timeStr.indexOf("P") === 0) {
                 const matches = timeStr.match(/PT(\d+H)?(\d+M)?(\d+(\.\d+)?S)?/);
                 if (!matches) return "00:00:00";
                 const h = (matches[1] ? parseFloat(matches[1]) : 0);
                 const m = (matches[2] ? parseFloat(matches[2]) : 0);
                 const s = (matches[3] ? parseFloat(matches[3]) : 0);
                 const pad = (n) => n.toString().padStart(2, '0');
                 return `${pad(h)}:${pad(m)}:${pad(Math.floor(s))}`;
            }
            if(timeStr.indexOf(":") > -1) { return timeStr.split(".")[0]; }
            return timeStr;
        }

        function showError(msg) {
            $("#courseTocList").html(`<div class="text-danger p-3 text-center"><i class="fas fa-exclamation-triangle me-1"></i> ${msg}</div>`);
        }
        function scrollToToc() { document.getElementById('tocSection').scrollIntoView({ behavior: 'smooth' }); }
        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) elem.requestFullscreen().catch(err => console.log(err));
            else document.exitFullscreen();
        }

        // --- SCORM Adapter ---
        function initScormAdapter() {
            function updateResourceData(type, value) {
                if(selectedResourceIndex === -1 || !currentData) return;
                const resource = currentData.resources[selectedResourceIndex];
                let needsRecalc = false;

                if (type === "status") {
                     const val = value.toString().toLowerCase();
                     resource.clientStatus = val;
                     if (val === "completed" || val === "passed") {
                         resource.clientProgress = 100;
                         needsRecalc = true;
                     }
                }
                if (type === "progress") {
                    let p = parseFloat(value);
                    if (p <= 1.0) p = p * 100;
                    if (p > resource.clientProgress) {
                        resource.clientProgress = Math.round(p);
                        needsRecalc = true;
                    }
                }
                if (type === "time") {
                    resource.scormTime = formatScormTime(value);
                }

                if (needsRecalc) recalcTotalProgress();
            }

