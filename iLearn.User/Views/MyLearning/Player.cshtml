                flushSelectedResourceRuntime({ includeSessionTime: true, reason: "resource-switch" });
            }

            console.log(`\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);
            console.log(`📌 Selected Resource [${index}]: ${currentData.resources[index].name}`);
            console.log(`━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);

            // 🔴 CRITICAL: หยุด iframe เดิมทันที
            const iframe = document.getElementById("scormFrame");
            iframe.src = "about:blank"; // ล้าง iframe ทันที
            iframe.style.display = "none";

            // อัปเดต UI
            selectedResourceIndex = index;
            const resource = currentData.resources[index];

            $(".resource-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");
