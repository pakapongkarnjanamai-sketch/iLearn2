        // ========================================
        // ContentItem Selection
        // ========================================
        function selectContentItem(index) {
            if (!currentData || !currentData.contentItems[index]) return;
            const previousContentItem = getSelectedContentItem();
            if (!isReadOnly && previousContentItem && previousContentItem.id !== currentData.contentItems[index].id) {
                flushSelectedContentItemRuntime({ includeSessionTime: true, reason: "contentItem-switch" });
            }

            console.log(`\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);
            console.log(`📌 Selected ContentItem [${index}]: ${currentData.contentItems[index].name}`);
            console.log(`━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━`);

            // 🔴 CRITICAL: หยุด iframe เดิมทันที
            const iframe = document.getElementById("scormFrame");
            iframe.src = "about:blank"; // ล้าง iframe ทันที
            iframe.style.display = "none";

            // อัปเดต UI
            selectedContentItemIndex = index;
            const contentItem = currentData.contentItems[index];

            $(".contentItem-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");

            // แสดง Start Overlay
            $("#startOverlay").fadeIn(200);
            sessionStartTime = null;

            // รีเซ็ต SCORM Model ทันทีเมื่อเลือกบทใหม่
            resetScormModel(contentItem);
            console.log(`✅ SCORM Model cleared for new Learn `);
            console.log(`🛑 Previous iframe stopped`);
        }

        // ========================================
        // Start Course
        // ========================================
        function startCourse() {
            if (selectedContentItemIndex === -1) return;
            const contentItem = currentData.contentItems[selectedContentItemIndex];

            if (!contentItem.launchUrl) {
                showToast("Invalid Launch URL", "error");
                return;
            }

            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            console.log(`🚀 Starting ContentItem [${selectedContentItemIndex}]: ${contentItem.name}`);
            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

            // 1. โหลด SCORM Model จาก runtime state ล่าสุด
            resetScormModel(contentItem);

            $("#startOverlay").fadeOut(200);
            sessionStartTime = new Date();
            contentItem.hasPendingRuntimeCommit = true;
            contentItem.sessionTerminalStatus = null;
            const iframe = document.getElementById("scormFrame");

            // 3. บังคับโหลดใหม่ (Clear Cache iframe)
            iframe.src = "about:blank";
            setTimeout(() => {
                iframe.style.display = "block";
                iframe.src = contentItem.launchUrl;
                console.log(`🌐 Loading: ${contentItem.launchUrl}`);
                console.log(`📦 Initial cmiModel:`, JSON.stringify(cmiModel, null, 2));
            }, 100);
        }

        // ========================================
        // Update ContentItem Data (SCORM Callbacks)
        // ========================================
        function updateContentItemData(key, value) {
            if (isReadOnly) {
                console.log(`⚠️ Read-only mode - ignoring update`);
                return;
            }

            if (selectedContentItemIndex === -1 || !currentData) {
                console.log(`⚠️ No contentItem selected - ignoring update`);
                return;
            }

            // 🔴 CRITICAL: ตรวจสอบว่า iframe ยังแสดงอยู่หรือไม่
            const iframe = document.getElementById("scormFrame");
            if (iframe.style.display === "none" || iframe.src === "about:blank") {
                console.log(`⚠️ Iframe not active - ignoring SCORM update from old content`);
                return;
            }

            let contentItem = currentData.contentItems[selectedContentItemIndex];
            let needsRecalc = false;
            const valStr = String(value).toLowerCase().trim();

            console.log(`📊 updateContentItemData - ContentItem [${selectedContentItemIndex}] ${key}: ${value}`);

            if (key === "status") {
                console.log(`📊 ContentItem [${selectedContentItemIndex}] Status Update: ${valStr}`);
                if (valStr === "passed") {
                    contentItem.clientStatus = "passed";
                    contentItem.clientProgress = 100;
                    contentItem.sessionTerminalStatus = "passed";
                    needsRecalc = true;
                    captureSessionTime(contentItem);
                    console.log(`✅ Status: PASSED (100%)`);
                }
                else if (valStr === "completed") {
                    contentItem.clientStatus = contentItem.clientSuccessStatus === "failed" ? "failed" : "passed";
                    if (contentItem.clientStatus === "failed") {
                        contentItem.sessionTerminalStatus = "failed";
                        needsRecalc = true;
                        console.log(`❌ Status remains FAILED because success_status is failed`);
                    } else {
                        contentItem.clientProgress = 100;
                        contentItem.sessionTerminalStatus = "passed";
                        needsRecalc = true;
                        captureSessionTime(contentItem);
                        console.log(`✅ Status: COMPLETED → PASSED (100%)`);
                    }
                }
                else if (valStr === "failed") {
                    contentItem.clientStatus = "failed";
                    contentItem.sessionTerminalStatus = "failed";
                    needsRecalc = true;
                    console.log(`❌ Status: FAILED`);
                }
                else {
                    if (contentItem.sessionTerminalStatus !== "passed" && contentItem.sessionTerminalStatus !== "failed") {
                        contentItem.clientStatus = "incomplete";
                        contentItem.clientProgress = getIncompleteContentItemProgress(contentItem);
                        needsRecalc = true;
                        console.log(`⏳ Status: INCOMPLETE`);
                    }
                }
            }
            else if (key === "successStatus") {
                contentItem.clientSuccessStatus = valStr;
                console.log(`📊 ContentItem [${selectedContentItemIndex}] Success Status Update: ${valStr}`);

                if (valStr === "passed") {
                    contentItem.clientStatus = "passed";
                    contentItem.clientProgress = 100;
                    contentItem.sessionTerminalStatus = "passed";
                    needsRecalc = true;
                    captureSessionTime(contentItem);
                    console.log(`✅ Success Status: PASSED (100%)`);
                }
                else if (valStr === "failed") {
                    contentItem.clientStatus = "failed";
                    contentItem.sessionTerminalStatus = "failed";
                    needsRecalc = true;
                    captureSessionTime(contentItem);
                    console.log(`❌ Success Status: FAILED`);
                }
                else if (contentItem.clientStatus !== "passed" && contentItem.clientStatus !== "failed") {
                    contentItem.clientStatus = "incomplete";
                    needsRecalc = true;
                    console.log(`⏳ Success Status: UNKNOWN`);
                }
            }
            else if (key === "completionStatus") {
                contentItem.clientCompletionStatus = valStr;
                console.log(`📊 ContentItem [${selectedContentItemIndex}] Completion Status Update: ${valStr}`);

                if (valStr === "completed") {
                    if (contentItem.clientSuccessStatus === "failed" || contentItem.clientStatus === "failed") {
                        contentItem.clientStatus = "failed";
                        contentItem.sessionTerminalStatus = "failed";
                        needsRecalc = true;
                        console.log(`❌ Completion Status: COMPLETED but success status is FAILED`);
                    }
                    else if (contentItem.clientSuccessStatus === "passed" || String(contentItem.type).toLowerCase() !== "exam") {
                        contentItem.clientStatus = "passed";
                        contentItem.clientProgress = 100;
                        contentItem.sessionTerminalStatus = "passed";
                        needsRecalc = true;
                        captureSessionTime(contentItem);
                        console.log(`✅ Completion Status: COMPLETED`);
                    }
                    else {
                        contentItem.clientStatus = "incomplete";
                        needsRecalc = true;
                        console.log(`⏳ Completion Status: COMPLETED, waiting for exam success_status`);
                    }
                }
                else if (valStr === "incomplete" || valStr === "not attempted" || valStr === "unknown") {
                    if (contentItem.sessionTerminalStatus !== "passed" && contentItem.sessionTerminalStatus !== "failed") {
                        contentItem.clientStatus = "incomplete";
                        contentItem.clientProgress = getIncompleteContentItemProgress(contentItem);
                        needsRecalc = true;
                        console.log(`⏳ Completion Status: INCOMPLETE`);
                    }
                }
            }
            else if (key === "progress") {
                let prog = parseFloat(value) || 0;
                if (prog > 100) prog = 100;
                if (prog > contentItem.clientProgress) {
                    contentItem.clientProgress = prog;
                    needsRecalc = true;
                    console.log(`📈 Progress: ${prog}%`);
                }
            }
            else if (key === "score") {
                contentItem.clientScore = parseFloat(value) || 0;
                console.log(`🎯 Score: ${contentItem.clientScore}`);
            }

            if (needsRecalc) {
                recalcTotalProgress();
            }
        }

        function getIncompleteContentItemProgress(contentItem) {
            const score = Number(contentItem?.clientScore);
            if (String(contentItem?.type || '').toLowerCase() === "learn" && Number.isFinite(score) && score > 0 && score < 100) {
                return score;
            }

            const progress = Number(contentItem?.clientProgress);
            if (Number.isFinite(progress) && progress > 0 && progress < 100) {
                return progress;
            }

            return 0;
        }

        // ========================================
        // Capture Session Time
        // ========================================
        function captureSessionTime(contentItem) {
            if (contentItem.isCompleted) return; // Already saved on DB
            if (sessionStartTime) {
                const now = new Date();
                const diffSec = Math.round((now - sessionStartTime) / 1000);
                const date = new Date(0);
                date.setSeconds(diffSec);
                const timeString = date.toISOString().substr(11, 8);
                const existingSessionTime = getPreferredCmiModelValue(contentItem, "cmi.core.session_time", "cmi.session_time", contentItem.clientTime || "");
                const effectiveSessionTime = parseClockTimeToSeconds(existingSessionTime) > parseClockTimeToSeconds(timeString)
                    ? existingSessionTime
                    : timeString;

                contentItem.clientTime = effectiveSessionTime;
                cmiModel["cmi.core.session_time"] = effectiveSessionTime;
                cmiModel["cmi.session_time"] = effectiveSessionTime;
                console.log(`⏱️ Session Time: ${effectiveSessionTime}`);
            }
        }

        // ========================================
        // Recalculate Total Progress
        // ========================================
        function recalcTotalProgress() {
            if(!currentData || !currentData.contentItems) return;
            let totalContentItems = currentData.contentItems.length;
            let passedCount = 0;

            console.log(`\n🔄 Recalculating Progress...`);
            currentData.contentItems.forEach((r, idx) => {
                if (!isReadOnly) {
                    const bar = $(`#res-bar-${idx}`);
                    bar.css("width", r.clientProgress + "%");

                    // Color logic
                    if (r.clientStatus === 'failed') {
                        bar.css("background-color", "var(--danger-color)");
                        $(`#res-item-${idx}`).addClass("item-failed");
                    } else {
                        bar.css("background-color", "var(--brand-color)");
                        $(`#res-item-${idx}`).removeClass("item-failed");
                    }
                }

                // Check passed
                const isPassed = (r.clientStatus === "passed" || r.clientStatus === "completed");
                const iconContainer = $(`#res-status-icon-${idx}`);

                if (isPassed) {
                    passedCount++;
                    iconContainer.html('<i class="fas fa-check-circle text-success"></i>');
                } else if (r.clientStatus === "failed") {
                    iconContainer.html('<i class="fas fa-times-circle text-danger"></i>');
                } else {
                    iconContainer.html('');
                }
                console.log(`  [${idx}] ${r.name}: ${r.clientStatus} (${r.clientProgress}%)`);
            });

            if (!isReadOnly) {
                const completionProgress = totalContentItems > 0 ? Math.floor((passedCount / totalContentItems) * 100) : 0;
                currentData.progress = completionProgress;
                setCourseProgressDisplay(completionProgress);

                const allPassed = (passedCount === totalContentItems);
                const hasFailed = currentData.contentItems.some(r => r.clientStatus === "failed");

                console.log(`📊 Summary: ${passedCount}/${totalContentItems} passed, Completion: ${completionProgress}%`);
                if (allPassed) {
                    setCourseStatusDisplay("พร้อมแสดงผล", "success");
                    $("#btnPreSave").prop("disabled", false);
                    console.log(`✅ All contentItems PASSED - Save button enabled`);
                } else {
                    if (hasFailed) {
                        setCourseStatusDisplay("ไม่ผ่านเกณฑ์", "danger");
                        console.log(`❌ Has FAILED contentItems`);
                    } else {
                        setCourseStatusDisplay("กำลังเรียน", "muted");
                        console.log(`⏳ Still in progress`);
                    }
                    $("#btnPreSave").prop("disabled", true);
                }
            } else {
                const readOnlyProgress = currentData.isCompleted ? 100 : normalizeProgressValue(currentData.progress || 0);
                setCourseProgressDisplay(readOnlyProgress);

                if (currentData.isCompleted) {
                    setCourseStatusDisplay("เรียนจบแล้ว", "success");
                } else {
                    setCourseStatusDisplay("ดูอย่างเดียว", "warning");
                }
            }
        }

        // ========================================
        // Show Learning Result
        // ========================================
        function showLearningResult() {
            if (!currentData) return;
            console.log(`📋 Showing learning result...`);

            if (selectedContentItemIndex !== -1) {
                const r = currentData.contentItems[selectedContentItemIndex];
                if (!r.isCompleted) captureSessionTime(r);
            }

            Promise.resolve(flushSelectedContentItemRuntime({ includeSessionTime: true, reason: "view-result" }))
                .then(function() {
                    renderLearningResultModal();
                })
                .catch(function(err) {
                    console.error("❌ Result sync failed:", err);
                    showToast("ไม่สามารถซิงก์ผลล่าสุดได้ แต่ยังสามารถดูผลปัจจุบันบนหน้าจอได้", "warning");
                    renderLearningResultModal();
                });
        }

        function renderLearningResultModal() {
            $("#sumLearnerName").text(currentLearnerCode);
            $("#sumCourseName").text(currentData.courseTitle);
            const tbody = $("#summaryDetailsList");
            tbody.empty();

            currentData.contentItems.forEach(r => {
                const timeDisplay = r.clientTime || "00:00:00";
                const row = `
                    <tr>
                        <td><div class="text-truncate summary-item-name">${r.name}</div></td>
                        <td class="text-end">${timeDisplay}</td>
                    </tr>
                `;
                tbody.append(row);
            });
            $("#summaryModal").css("display", "flex").hide().fadeIn();
        }

        function closeSummary() {
            $("#summaryModal").fadeOut();
        }

        function goBackToMyLearning() {
            window.location.href = '@Url.Action("Index", "MyLearning")';
        }

        // ========================================
        // SCORM ADAPTER
        // ========================================
        function initScormAdapter() {
            console.log(`🔌 Initializing SCORM Adapter...`);

            // Helper function to check if iframe is active
            function isIframeActive() {
                const iframe = document.getElementById("scormFrame");
                return iframe && iframe.style.display !== "none" && iframe.src !== "about:blank";
            }

            // ========================================
            // SCORM 1.2 API
            // ========================================
            window.API = {
                LMSInitialize: function(p) {
                    console.log("🎬 SCORM 1.2: LMSInitialize");
                    return "true";
                },

                LMSGetValue: function(e) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ LMSGetValue blocked - iframe not active`);
                        return "";
                    }

                    const value = cmiModel.hasOwnProperty(e) ? cmiModel[e] : "";
                    console.log(`📖 SCORM 1.2 GetValue("${e}") = "${value}"`);
                    return value;
                },

                LMSSetValue: function(e, v) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ LMSSetValue blocked - iframe not active: "${e}" = "${v}"`);
                        return "true";
                    }

                    console.log(`📝 SCORM 1.2 SetValue("${e}", "${v}")`);
                    setCmiModelValue(e, v);
                    syncScorm12RuntimeAliases(e, v);
                    markSelectedContentItemDirty();

                    if (e === "cmi.core.lesson_status") {
                        syncScorm12StatusAliases(v);
                        updateContentItemData("status", v);
                    }
                    if (e === "cmi.core.score.raw") {
                        updateContentItemData("score", v);
                    }

                    return "true";
                },

                LMSCommit: function(p) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ LMSCommit blocked - iframe not active`);
                        return "true";
                    }
                    console.log("💾 SCORM 1.2: LMSCommit");
                    flushSelectedContentItemRuntime({ includeSessionTime: false, reason: "scorm12-commit" });
                    return "true";
                },

                LMSFinish: function(p) {
                    console.log("🏁 SCORM 1.2: LMSFinish");
                    flushSelectedContentItemRuntime({ includeSessionTime: true, reason: "scorm12-finish" });
                    sessionStartTime = null;
                    return "true";
                },

                LMSGetLastError: function() { return "0"; },
                LMSGetErrorString: function(e) { return ""; },
                LMSGetDiagnostic: function(e) { return ""; }
            };

            // ========================================
            // SCORM 2004 API
            // ========================================
            window.API_1484_11 = {
                Initialize: function(p) {
                    console.log("🎬 SCORM 2004: Initialize");
                    return "true";
                },

                Terminate: function(p) {
                    console.log("🏁 SCORM 2004: Terminate");
                    flushSelectedContentItemRuntime({ includeSessionTime: true, reason: "scorm2004-terminate" });
                    sessionStartTime = null;
                    return "true";
                },

                GetValue: function(e) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ GetValue blocked - iframe not active`);
                        return "";
                    }

                    const value = cmiModel.hasOwnProperty(e) ? cmiModel[e] : "";
                    console.log(`📖 SCORM 2004 GetValue("${e}") = "${value}"`);
                    return value;
                },

                SetValue: function(e, v) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ SetValue blocked - iframe not active: "${e}" = "${v}"`);
                        return "true";
                    }

                    console.log(`📝 SCORM 2004 SetValue("${e}", "${v}")`);
                    setCmiModelValue(e, v);
                    markSelectedContentItemDirty();

                    if (e === "cmi.success_status") {
                        updateContentItemData("successStatus", v);
                    }
                    if (e === "cmi.completion_status") {
                        updateContentItemData("completionStatus", v);
                    }
                    if (e === "cmi.progress_measure") {
                        updateContentItemData("progress", parseFloat(v) * 100);
                    }
                    if (e === "cmi.score.raw") {
                        updateContentItemData("score", v);
                    }

                    return "true";
                },

                Commit: function(p) {
                    if (!isIframeActive()) {
                        console.log(`⚠️ Commit blocked - iframe not active`);
                        return "true";
                    }
                    console.log("💾 SCORM 2004: Commit");
                    flushSelectedContentItemRuntime({ includeSessionTime: false, reason: "scorm2004-commit" });
                    return "true";
                },

                GetLastError: function() { return "0"; },
                GetErrorString: function(e) { return ""; },
                GetDiagnostic: function(e) { return ""; }
            };

            console.log("✅ SCORM ADAPTER READY");
        }

        // ========================================
        // Utility Functions
        // ========================================
        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) {
                elem.requestFullscreen().catch(err => {
                    console.log(`Error attempting to enable full-screen mode: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
        }

        function scrollToToc() {
            document.getElementById("tocSection").scrollIntoView({ behavior: 'smooth' });
        }

        function showError(msg) {
            console.error(`❌ Error: ${msg}`);
            showToast(msg, "error");
        }

        // ========================================
        // Debug Helper
        // ========================================
        function debugScormState() {
            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            console.log("🔍 SCORM State Debug");
            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            console.log("Selected ContentItem:", selectedContentItemIndex);
            console.log("Current cmiModel:", JSON.stringify(cmiModel, null, 2));
            console.log("ContentItems Status:");
            if (currentData && currentData.contentItems) {
                currentData.contentItems.forEach((r, i) => {
                    console.log(`  [${i}] ${r.name}:`, {
                        clientStatus: r.clientStatus,
                        clientProgress: r.clientProgress,
                        clientScore: r.clientScore,
                        clientTime: r.clientTime
                    });
                });
            }
            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        }

        // Make debug function available globally
        window.debugScormState = debugScormState;
    </script>
}