@{
    ViewData["Title"] = "Learning Player";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
    // สมมติว่าส่ง ID มาจาก Controller (ในตัวอย่าง URL คือเลข 1)
    var playerId = ViewBag.PlayerId ?? 1;
}

@section Styles {
    <style>
        :root {
            --sidebar-width: 400px;
            --primary-color: #007bff;
            --secondary-bg: #f5f7fa;
        }

        body {
            overflow: hidden;
        }
        /* ป้องกัน Scroll ซ้อน */

        .viewer-container {
            display: grid;
            grid-template-columns: 1fr var(--sidebar-width);
            gap: 0; /* ติดกันเลยเพื่อให้ดูเหมือนแอป */
            height: calc(100vh - 60px); /* ปรับความสูงตาม Header ของ Layout คุณ */
            background-color: var(--secondary-bg);
        }

        /* --- Left Side: Player --- */
        .scorm-section {
            display: flex;
            flex-direction: column;
            background: #000; /* พื้นหลังสีดำเวลาโหลด */
            position: relative;
        }

        .scorm-toolbar {
            height: 50px;
            padding: 0 20px;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scorm-body {
            flex: 1;
            position: relative;
            background: #e9ecef;
        }

        iframe#scormFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: none;
            background: #fff;
        }

        /* Start Overlay */
        .start-overlay {
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .start-btn {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            font-size: 32px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0,123,255,0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .start-btn:hover {
                transform: scale(1.05);
                background: #0056b3;
                box-shadow: 0 8px 25px rgba(0,123,255,0.4);
            }

        /* --- Right Side: Info & TOC --- */
        .info-section {
            background: #fff;
            border-left: 1px solid #dee2e6;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .course-header-panel {
            padding: 20px;
            background-color: #fff;
            border-bottom: 1px solid #f0f0f0;
        }

        .info-status-bar {
            padding: 15px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .toc-header {
            padding: 15px 20px;
            background-color: #fff;
            font-weight: 700;
            color: #495057;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
        }

        .course-toc {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #fcfcfc;
        }

        /* Resource Item Styling */
        .resource-item {
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 8px;
            padding: 12px;
            position: relative;
            overflow: hidden;
        }

            .resource-item:hover {
                border-color: #b3d7ff;
                transform: translateY(-1px);
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            }

            .resource-item.active {
                border-color: var(--primary-color);
                background-color: #f0f7ff;
            }

                .resource-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background-color: var(--primary-color);
                }

        .resource-type-badge {
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e2e6ea;
            color: #6c757d;
            margin-top: 4px;
            display: inline-block;
        }

        .status-icon-check {
            color: #28a745;
            font-size: 1.1rem;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .viewer-container {
                grid-template-columns: 1fr;
                height: auto;
                overflow-y: auto;
            }

            .scorm-section {
                height: 50vh;
                min-height: 300px;
            }

            .info-section {
                height: auto;
                border-left: none;
                border-top: 1px solid #dee2e6;
            }
        }
    </style>
}

<div class="container-fluid p-0 viewer-container">

    <div class="scorm-section" id="fullscreenArea">
        <div class="scorm-toolbar">
            <div class="d-flex align-items-center overflow-hidden">
                <button class="btn btn-sm btn-light me-2 d-lg-none" onclick="scrollToToc()">
                    <i class="fas fa-list"></i>
                </button>
                <div class="fw-bold text-truncate" id="lessonTitle" style="max-width: 300px;">
                    Loading...
                </div>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary border-0" onclick="toggleFullscreen()" title="Fullscreen">
                    <i class="fas fa-expand fa-lg"></i>
                </button>
            </div>
        </div>

        <div class="scorm-body">
            <div id="startOverlay" class="start-overlay">
                <button class="start-btn" onclick="startCourse()">
                    <i class="fas fa-play ps-1"></i>
                </button>
                <h4 class="mt-4 fw-bold text-dark">พร้อมที่จะเรียนรู้?</h4>
                <p id="overlayMessage" class="text-muted">กดปุ่ม Play เพื่อเริ่มบทเรียน</p>
            </div>

            <iframe id="scormFrame"
                    sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
            </iframe>
        </div>
    </div>

    <div class="info-section" id="tocSection">

        <div class="course-header-panel">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold text-dark mb-1" id="courseTitleDisplay">...</h5>
                    <div class="text-muted small">
                        <i class="fas fa-user-circle me-1"></i>
                        Student: <span id="studentCodeDisplay" class="fw-bold text-primary">-</span>
                    </div>
                </div>
                <span class="badge bg-secondary" id="versionDisplay">v.1</span>
            </div>
        </div>

        <div class="info-status-bar">
            <div class="row g-0 text-center bg-white border rounded overflow-hidden">
                <div class="col-6 border-end p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 1px;">Status</small>
                    <div id="statusDisplay" class="fw-bold mt-1 text-secondary">-</div>
                </div>
                <div class="col-6 p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 1px;">Score</small>
                    <div id="scoreDisplay" class="fw-bold mt-1 text-dark">-</div>
                </div>
            </div>
        </div>

        <div class="toc-header">
            <i class="fas fa-list-ul me-2 text-primary"></i> เนื้อหาหลักสูตร
        </div>

        <div class="course-toc" id="courseTocList">
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted small">กำลังโหลดข้อมูล...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Configuration ---
        const PLAYER_ID = "@playerId";
        const API_URL = `https://localhost:7128/api/Enrollments/player-info/${PLAYER_ID}`;

        // --- State ---
        let currentData = null;
        let selectedResourceIndex = -1;

        $(function() {
            initScormAdapter(); // เตรียม SCORM API ไว้ก่อน
            loadCourseData();   // ดึงข้อมูล
        });

        // 1. Fetch Data
        async function loadCourseData() {
            try {
                const response = await $.ajax({
                    url: API_URL,
                    method: 'GET',
                    dataType: 'json',
                    xhrFields: { withCredentials: true }
                });

                if (response && response.success) {
                    currentData = response.data;
                    renderUI(currentData);
                } else {
                    showError("ไม่สามารถโหลดข้อมูลได้: " + (response.message || "Unknown error"));
                }

            } catch (err) {
                console.error(err);
                showError("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์");
            }
        }

        // 2. Render UI
        function renderUI(data) {
            // Header Info
            $("#courseTitleDisplay").text(data.courseTitle || "ไม่มีชื่อหลักสูตร");
            $("#studentCodeDisplay").text(data.studentCode || "-");
            $("#versionDisplay").text("v." + (data.courseVersionId || "1"));

            // Render Resources List
            const listContainer = $("#courseTocList");
            listContainer.empty();

            if (!data.resources || data.resources.length === 0) {
                listContainer.html('<div class="alert alert-warning m-3">ไม่พบเนื้อหาในหลักสูตรนี้</div>');
                return;
            }

            data.resources.forEach((item, index) => {
                // Determine Icon based on Type
                let iconClass = "far fa-file";
                if (item.type === "Lesson") iconClass = "fas fa-book-open text-primary";
                else if (item.type === "Exam") iconClass = "fas fa-pencil-alt text-warning";

                // Check Completion
                const completedBadge = item.isCompleted
                    ? `<i class="fas fa-check-circle status-icon-check ms-auto" title="Completed"></i>`
                    : ``;

                const html = `
                    <div class="resource-item d-flex align-items-center"
                         id="res-item-${index}"
                         onclick="selectResource(${index})">

                        <div class="me-3 fs-4" style="width: 30px; text-align: center;">
                            <i class="${iconClass}"></i>
                        </div>

                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-bold text-truncate" title="${item.name}">${item.name}</div>
                            <span class="resource-type-badge">${item.type}</span>
                        </div>

                        ${completedBadge}
                    </div>
                `;
                listContainer.append(html);
            });

            // Select first item automatically
            if (data.resources.length > 0) {
                selectResource(0);
            }
        }

        // 3. Handle Selection
        function selectResource(index) {
            if (!currentData || !currentData.resources[index]) return;

            selectedResourceIndex = index;
            const resource = currentData.resources[index];

            // Update Active UI
            $(".resource-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");

            // Update Header Title
            $("#lessonTitle").text(resource.name);

            // Reset SCORM Info Display
            $("#scoreDisplay").text("-").removeClass("text-success");

            // Set Status Display based on history
            const statusElem = $("#statusDisplay");
            if (resource.isCompleted) {
                statusElem.text("Completed").addClass("text-success").removeClass("text-muted");
            } else {
                statusElem.text("Not Attempted").addClass("text-muted").removeClass("text-success");
            }

            // Show Overlay (Ready to play)
            $("#scormFrame").attr("src", ""); // Clear old iframe
            $("#scormFrame").hide();
            $("#startOverlay").fadeIn(200);

            // Scroll to top on mobile
            if(window.innerWidth < 992) {
                 window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // 4. Start Content
        function startCourse() {
            if (selectedResourceIndex === -1) return;

            const resource = currentData.resources[selectedResourceIndex];
            if (!resource || !resource.launchUrl) {
                DevExpress.ui.notify("Invalid Launch URL", "error", 2000);
                return;
            }

            $("#startOverlay").fadeOut(200);
            const iframe = document.getElementById("scormFrame");
            iframe.style.display = "block";
            iframe.src = resource.launchUrl;

            console.log("Launching:", resource.launchUrl);
        }

        // --- Helper ---
        function showError(msg) {
            $("#courseTocList").html(`<div class="text-danger p-3 text-center"><i class="fas fa-exclamation-triangle me-1"></i> ${msg}</div>`);
            $("#courseTitleDisplay").text("Error");
        }

        function scrollToToc() {
             document.getElementById('tocSection').scrollIntoView({ behavior: 'smooth' });
        }

        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) {
                elem.requestFullscreen().catch(err => {
                    console.log(`Error attempting to enable full-screen mode: ${err.message} (${err.name})`);
                });
            } else {
                document.exitFullscreen();
            }
        }

        // ==========================================
        // SCORM 1.2 / 2004 MOCK ADAPTER
        // ==========================================
        function initScormAdapter() {
            const Adapter = {
                // Initialize
                LMSInitialize: function(p) { return "true"; },
                Initialize: function(p) { return "true"; },

                // Get Value
                LMSGetValue: function(element) { return ""; },
                GetValue: function(element) { return ""; },

                // Set Value (Updates UI Immediately)
                LMSSetValue: function(element, value) {
                    console.log(`[SCORM] Set ${element} = ${value}`);

                    // Update Score
                    if (element.includes("score.raw")) {
                        $("#scoreDisplay").text(value);
                    }

                    // Update Status
                    if (element.includes("lesson_status") || element.includes("completion_status")) {
                         const statusDisplay = $("#statusDisplay");
                         statusDisplay.removeClass("text-muted text-success text-danger text-warning");

                         if(value === "completed" || value === "passed") {
                             statusDisplay.text("Completed").addClass("text-success");
                             // Optional: Mark sidebar as checked immediately
                             $(`#res-item-${selectedResourceIndex} .status-icon-check`).remove();
                             $(`#res-item-${selectedResourceIndex}`).append(`<i class="fas fa-check-circle status-icon-check ms-auto" title="Completed"></i>`);
                         } else if (value === "failed") {
                             statusDisplay.text("Failed").addClass("text-danger");
                         } else {
                             statusDisplay.text(value).addClass("text-primary");
                         }
                    }
                    return "true";
                },
                SetValue: function(e, v) { return this.LMSSetValue(e, v); },

                // Commit/Finish
                LMSCommit: function(p) { return "true"; },
                Commit: function(p) { return "true"; },

                LMSFinish: function(p) { return "true"; },
                Terminate: function(p) { return "true"; },

                // Error Handling
                LMSGetLastError: function() { return "0"; },
                LMSGetErrorString: function(e) { return "No error"; },
                LMSGetDiagnostic: function(e) { return "No error"; }
            };

            // Expose to window
            window.API = Adapter;      // SCORM 1.2
            window.API_1484_11 = Adapter; // SCORM 2004
        }
    </script>
}