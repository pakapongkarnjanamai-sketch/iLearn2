@{
    ViewData["Title"] = "Learning Player (Full Debug)";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
    var playerId = ViewBag.PlayerId ?? 1;
}

@section Styles {
    <style>
        :root {
            --sidebar-width: 400px;
            --primary-color: #007bff;
            --secondary-bg: #f5f7fa;
        }

        body {
            overflow: hidden;
        }

        .viewer-container {
            display: grid;
            grid-template-columns: 1fr var(--sidebar-width);
            gap: 0;
            height: calc(100vh - 60px);
            background-color: var(--secondary-bg);
        }

        /* --- Left Side: Player --- */
        .scorm-section {
            display: flex;
            flex-direction: column;
            background: #000;
            position: relative;
        }

        .scorm-toolbar {
            height: 50px;
            padding: 0 20px;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scorm-body {
            flex: 1;
            position: relative;
            background: #e9ecef;
        }

        iframe#scormFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: none;
            background: #fff;
        }

        /* Start Overlay */
        .start-overlay {
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .start-btn {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            font-size: 32px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0,123,255,0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .start-btn:hover {
                transform: scale(1.05);
                background: #0056b3;
                box-shadow: 0 8px 25px rgba(0,123,255,0.4);
            }

        /* --- Right Side: Info & TOC --- */
        .info-section {
            background: #fff;
            border-left: 1px solid #dee2e6;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .course-header-panel {
            padding: 20px;
            background-color: #fff;
            border-bottom: 1px solid #f0f0f0;
        }

        .info-status-bar {
            padding: 15px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .toc-header {
            padding: 15px 20px;
            background-color: #fff;
            font-weight: 700;
            color: #495057;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
        }

        .course-toc {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #fcfcfc;
        }

        /* Resource Item Styling */
        .resource-item {
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 8px;
            padding: 12px;
            position: relative;
            overflow: hidden;
        }

            .resource-item:hover {
                border-color: #b3d7ff;
                transform: translateY(-1px);
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            }

            .resource-item.active {
                border-color: var(--primary-color);
                background-color: #f0f7ff;
            }

                .resource-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background-color: var(--primary-color);
                }

        .resource-type-badge {
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e2e6ea;
            color: #6c757d;
            margin-top: 4px;
            display: inline-block;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .viewer-container

        {
            grid-template-columns: 1fr;
            height: auto;
            overflow-y: auto;
        }

        .scorm-section {
            height: 50vh;
            min-height: 300px;
        }

        .info-section {
            height: auto;
            border-left: none;
            border-top: 1px solid #dee2e6;
        }

        }
    </style>
}

<div class="container-fluid p-0 viewer-container">

    <div class="scorm-section" id="fullscreenArea">
        <div class="scorm-toolbar">
            <div class="d-flex align-items-center overflow-hidden">
                <button class="btn btn-sm btn-light me-2 d-lg-none" onclick="scrollToToc()">
                    <i class="fas fa-list"></i>
                </button>
                <div class="fw-bold text-truncate" id="lessonTitle" style="max-width: 300px;">
                    Loading...
                </div>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary border-0" onclick="toggleFullscreen()" title="Fullscreen">
                    <i class="fas fa-expand fa-lg"></i>
                </button>
            </div>
        </div>

        <div class="scorm-body">
            <div id="startOverlay" class="start-overlay">
                <button class="start-btn" onclick="startCourse()">
                    <i class="fas fa-play ps-1"></i>
                </button>
                <h4 class="mt-4 fw-bold text-dark">พร้อมที่จะเรียนรู้?</h4>
                <p id="overlayMessage" class="text-muted">กดปุ่ม Play เพื่อเริ่มบทเรียน</p>
            </div>

            <iframe id="scormFrame"
                    sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
            </iframe>
        </div>
    </div>

    <div class="info-section" id="tocSection">

        <div class="course-header-panel">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold text-dark mb-1" id="courseTitleDisplay">...</h5>
                    <div class="text-muted small">
                        <i class="fas fa-user-circle me-1"></i>
                        Student: <span id="studentCodeDisplay" class="fw-bold text-primary">-</span>
                    </div>
                </div>
                <span class="badge bg-secondary" id="versionDisplay">v.1</span>
            </div>
        </div>

        <div class="info-status-bar">
            <div class="row g-0 text-center bg-white border rounded overflow-hidden">
                <div class="col-4 border-end p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Status</small>
                    <div id="statusDisplay" class="fw-bold mt-1 text-secondary" style="font-size: 0.9rem;">-</div>
                </div>
                <div class="col-4 border-end p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Progress</small>
                    <div id="scoreDisplay" class="fw-bold mt-1 text-dark" style="font-size: 0.9rem;">-</div>
                </div>
                <div class="col-4 p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Time</small>
                    <div id="timeDisplay" class="fw-bold mt-1 text-primary" style="font-size: 0.9rem;">-</div>
                </div>
            </div>
        </div>

        <div class="toc-header">
            <i class="fas fa-list-ul me-2 text-primary"></i> เนื้อหาหลักสูตร
        </div>

        <div class="course-toc" id="courseTocList">
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted small">กำลังโหลดข้อมูล...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Configuration ---
        const PLAYER_ID = "@playerId";
        const API_URL = `https://localhost:7128/api/Enrollments/player-info/${PLAYER_ID}`;

        // --- State ---
        let currentData = null;
        let selectedResourceIndex = -1;

        $(function() {
            initScormAdapter(); // Prepare SCORM API (Logging Mode)
            loadCourseData();   // Fetch Data
        });

        // 1. Fetch Data
        async function loadCourseData() {
            try {
                const response = await $.ajax({
                    url: API_URL,
                    method: 'GET',
                    dataType: 'json',
                    xhrFields: { withCredentials: true }
                });

                if (response && response.success) {
                    currentData = response.data;
                    renderUI(currentData);
                } else {
                    showError("ไม่สามารถโหลดข้อมูลได้: " + (response.message || "Unknown error"));
                }

            } catch (err) {
                console.error(err);
                showError("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์");
            }
        }

        // 2. Render UI (No isCompleted Checks)
        function renderUI(data) {
            $("#courseTitleDisplay").text(data.courseTitle || "ไม่มีชื่อหลักสูตร");
            $("#studentCodeDisplay").text(data.studentCode || "-");
            $("#versionDisplay").text("v." + (data.courseVersionId || "1"));

            const listContainer = $("#courseTocList");
            listContainer.empty();

            if (!data.resources || data.resources.length === 0) {
                listContainer.html('<div class="alert alert-warning m-3">ไม่พบเนื้อหาในหลักสูตรนี้</div>');
                return;
            }

            data.resources.forEach((item, index) => {
                let iconClass = "far fa-file";
                if (item.type === "Lesson") iconClass = "fas fa-book-open text-primary";
                else if (item.type === "Exam") iconClass = "fas fa-pencil-alt text-warning";

                // แสดงรายการทั้งหมดโดยไม่มีเงื่อนไข isCompleted
                const html = `
                    <div class="resource-item d-flex align-items-center"
                         id="res-item-${index}"
                         onclick="selectResource(${index})">

                        <div class="me-3 fs-4" style="width: 30px; text-align: center;">
                            <i class="${iconClass}"></i>
                        </div>

                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-bold text-truncate" title="${item.name}">${item.name}</div>
                            <span class="resource-type-badge">${item.type}</span>
                        </div>
                    </div>
                `;
                listContainer.append(html);
            });

            // Select first item automatically
            if (data.resources.length > 0) {
                selectResource(0);
            }
        }

        // 3. Handle Selection
        function selectResource(index) {
            if (!currentData || !currentData.resources[index]) return;

            selectedResourceIndex = index;
            const resource = currentData.resources[index];

            // Update Active UI
            $(".resource-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");

            // Update Header Title
            $("#lessonTitle").text(resource.name);

            // Reset Info Display
            $("#scoreDisplay").text("-");
            $("#timeDisplay").text("00:00:00");
            $("#statusDisplay").text("Ready").addClass("text-muted").removeClass("text-success text-danger text-primary");

            // Show Overlay
            $("#scormFrame").attr("src", "");
            $("#scormFrame").hide();
            $("#startOverlay").fadeIn(200);

            if(window.innerWidth < 992) {
                 window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        // 4. Start Content
        function startCourse() {
            if (selectedResourceIndex === -1) return;

            const resource = currentData.resources[selectedResourceIndex];
            if (!resource || !resource.launchUrl) {
                DevExpress.ui.notify("Invalid Launch URL", "error", 2000);
                return;
            }

            $("#startOverlay").fadeOut(200);
            const iframe = document.getElementById("scormFrame");
            iframe.style.display = "block";
            iframe.src = resource.launchUrl;

            console.log("--- Launching Course ---");
            console.log("URL:", resource.launchUrl);
        }

        // --- Helper: Parse ISO 8601 Duration (PT#H#M#S) ---
        function parseISODuration(isoDuration) {
            if(!isoDuration) return "00:00:00";

            // Regex match PT..H..M..S
            const matches = isoDuration.match(/PT(\d+H)?(\d+M)?(\d+(\.\d+)?S)?/);
            if (!matches) return isoDuration;

            const hours = (matches[1] ? parseFloat(matches[1]) : 0);
            const minutes = (matches[2] ? parseFloat(matches[2]) : 0);
            const seconds = (matches[3] ? parseFloat(matches[3]) : 0);

            const f = (num) => num.toString().padStart(2, '0');
            return `${f(hours)}:${f(minutes)}:${f(Math.floor(seconds))}`;
        }

        // --- Other Helpers ---
        function showError(msg) {
            $("#courseTocList").html(`<div class="text-danger p-3 text-center"><i class="fas fa-exclamation-triangle me-1"></i> ${msg}</div>`);
            $("#courseTitleDisplay").text("Error");
        }

        function scrollToToc() {
             document.getElementById('tocSection').scrollIntoView({ behavior: 'smooth' });
        }

        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) {
                elem.requestFullscreen().catch(err => console.log(err));
            } else {
                document.exitFullscreen();
            }
        }

        // ==========================================
        // SCORM ADAPTER (1.2 & 2004) with LOGGING
        // ==========================================
        function initScormAdapter() {

            // 1. ฟังก์ชันอัปเดต UI เมื่อ SCORM ส่งค่ามา
            function updateScormUI(element, value) {

                // --- A. Status (สถานะ) ---
                if (element === "cmi.completion_status" || element === "cmi.success_status" || element === "cmi.core.lesson_status") {
                     const statusDisplay = $("#statusDisplay");
                     statusDisplay.removeClass("text-muted text-success text-danger text-primary");

                     const lowerVal = value.toString().toLowerCase();
                     if(lowerVal === "completed" || lowerVal === "passed") {
                         statusDisplay.text("COMPLETED").addClass("text-success");
                     } else if (lowerVal === "failed") {
                         statusDisplay.text("FAILED").addClass("text-danger");
                     } else if (lowerVal === "incomplete") {
                         statusDisplay.text("INCOMPLETE").addClass("text-warning");
                     } else {
                         statusDisplay.text(value).addClass("text-primary");
                     }
                }

                // --- B. Progress/Score (เปอร์เซ็นต์) ---
                // SCORM 2004: cmi.progress_measure (0.0 - 1.0)
                if (element === "cmi.progress_measure") {
                    const percent = Math.round(parseFloat(value) * 100);
                    $("#scoreDisplay").text(percent + "%");
                }
                // SCORM 1.2: cmi.core.score.raw
                else if (element === "cmi.score.raw" || element === "cmi.core.score.raw") {
                    $("#scoreDisplay").text("Score: " + value);
                }

                // --- C. Time (เวลาที่ใช้) ---
                // SCORM 2004: cmi.session_time (PT..H..M..S)
                if (element === "cmi.session_time") {
                    const readableTime = parseISODuration(value);
                    $("#timeDisplay").text(readableTime);
                    console.log(`%c[Time Updated] ${readableTime}`, "color: #17a2b8");
                }
                // SCORM 1.2: cmi.core.session_time (HH:MM:SS) -> ใช้ได้เลย
                else if (element === "cmi.core.session_time") {
                    $("#timeDisplay").text(value);
                }
            }

            // 2. SCORM 1.2 API
            window.API = {
                LMSInitialize: function(p) { return "true"; },
                LMSGetValue: function(e) { return ""; },
                LMSSetValue: function(e, v) {
                    console.log(`[SCORM 1.2] Set ${e} = ${v}`);
                    updateScormUI(e, v);
                    return "true";
                },
                LMSCommit: function(p) { return "true"; },
                LMSFinish: function(p) { return "true"; },
                LMSGetLastError: function() { return "0"; },
                LMSGetErrorString: function(e) { return "No error"; },
                LMSGetDiagnostic: function(e) { return "No error"; }
            };

            // 3. SCORM 2004 API
            window.API_1484_11 = {
                Initialize: function(p) {
                    console.log("%c[SCORM 2004] Initialize", "background: #28a745; color: white;");
                    return true;
                },
                Terminate: function(p) {
                    console.log("%c[SCORM 2004] Terminate", "background: #dc3545; color: white;");
                    return true;
                },
                GetValue: function(element) {
                    console.log(`[SCORM 2004] GetValue: ${element}`);
                    return "";
                },
                SetValue: function(element, value) {
                    // Log แบบละเอียด
                    console.log(`%c[SCORM 2004] SetValue`, "color: #007bff", `${element} =`, value);

                    // Update หน้าจอ
                    updateScormUI(element, value);

                    return true;
                },
                Commit: function(p) {
                    console.log("[SCORM 2004] Commit");
                    return true;
                },
                GetLastError: function() { return 0; },
                GetErrorString: function(e) { return "No error"; },
                GetDiagnostic: function(e) { return "No error"; }
            };

            console.log("SCORM MOCK ADAPTER READY (Tracking Status, Progress, Time)");
        }
    </script>
}