        function startCourse() {
            if (selectedResourceIndex === -1) return;
            const resource = currentData.resources[selectedResourceIndex];

            if (!resource.launchUrl) {
                showToast("Invalid Launch URL", "error");
                return;
            }

            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            console.log(`🚀 Starting Resource [${selectedResourceIndex}]: ${resource.name}`);
            console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");

            // 1. โหลด SCORM Model จาก runtime state ล่าสุด
            resetScormModel(resource);

            $("#startOverlay").fadeOut(200);
