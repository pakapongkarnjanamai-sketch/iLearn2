        // ========================================
        // Update Resource Data (SCORM Callbacks)
        // ========================================
        function updateResourceData(key, value) {
            if (isReadOnly) {
                console.log(`⚠️ Read-only mode - ignoring update`);
                return;
            }

            if (selectedResourceIndex === -1 || !currentData) {
                console.log(`⚠️ No resource selected - ignoring update`);
                return;
            }

            // 🔴 CRITICAL: ตรวจสอบว่า iframe ยังแสดงอยู่หรือไม่
            const iframe = document.getElementById("scormFrame");
            if (iframe.style.display === "none" || iframe.src === "about:blank") {
                console.log(`⚠️ Iframe not active - ignoring SCORM update from old content`);
                return;
            }

            let resource = currentData.resources[selectedResourceIndex];
            let needsRecalc = false;
            const valStr = String(value).toLowerCase().trim();

            console.log(`📊 updateResourceData - Resource [${selectedResourceIndex}] ${key}: ${value}`);

            if (key === "status") {
                console.log(`📊 Resource [${selectedResourceIndex}] Status Update: ${valStr}`);
                if (valStr === "passed") {
                    resource.clientStatus = "passed";
                    resource.clientProgress = 100;
                    needsRecalc = true;
                    captureSessionTime(resource);
                    console.log(`✅ Status: PASSED (100%)`);
                }
                else if (valStr === "completed") {
                    resource.clientStatus = resource.clientSuccessStatus === "failed" ? "failed" : "passed";
                    if (resource.clientStatus === "failed") {
                        needsRecalc = true;
                        console.log(`❌ Status remains FAILED because success_status is failed`);
                    } else {
                        resource.clientProgress = 100;
                        needsRecalc = true;
                        captureSessionTime(resource);
                        console.log(`✅ Status: COMPLETED → PASSED (100%)`);
                    }
                }
                else if (valStr === "failed") {
                    resource.clientStatus = "failed";
                    needsRecalc = true;
                    console.log(`❌ Status: FAILED`);
                }
                else {
                    if (resource.clientStatus !== "passed" && resource.clientStatus !== "failed") {
                        resource.clientStatus = "incomplete";
                        console.log(`⏳ Status: INCOMPLETE`);
                    }
                }
            }
            else if (key === "successStatus") {
                resource.clientSuccessStatus = valStr;
                console.log(`📊 Resource [${selectedResourceIndex}] Success Status Update: ${valStr}`);

                if (valStr === "passed") {
                    resource.clientStatus = "passed";
                    resource.clientProgress = 100;
                    needsRecalc = true;
                    captureSessionTime(resource);
                    console.log(`✅ Success Status: PASSED (100%)`);
                }
                else if (valStr === "failed") {
                    resource.clientStatus = "failed";
                    needsRecalc = true;
                    captureSessionTime(resource);
                    console.log(`❌ Success Status: FAILED`);
                }
                else if (resource.clientStatus !== "passed" && resource.clientStatus !== "failed") {
                    resource.clientStatus = "incomplete";
                    needsRecalc = true;
                    console.log(`⏳ Success Status: UNKNOWN`);
                }
            }
            else if (key === "completionStatus") {
                resource.clientCompletionStatus = valStr;
                console.log(`📊 Resource [${selectedResourceIndex}] Completion Status Update: ${valStr}`);

                if (valStr === "completed") {
                    if (resource.clientSuccessStatus === "failed" || resource.clientStatus === "failed") {
                        resource.clientStatus = "failed";
                        needsRecalc = true;
                        console.log(`❌ Completion Status: COMPLETED but success status is FAILED`);
                    }
                    else if (resource.clientSuccessStatus === "passed" || String(resource.type).toLowerCase() !== "exam") {
                        resource.clientStatus = "passed";
                        resource.clientProgress = 100;
                        needsRecalc = true;
                        captureSessionTime(resource);
                        console.log(`✅ Completion Status: COMPLETED`);
                    }
                    else {
                        resource.clientStatus = "incomplete";
                        needsRecalc = true;
                        console.log(`⏳ Completion Status: COMPLETED, waiting for exam success_status`);
                    }
                }
                else if (valStr === "incomplete" || valStr === "not attempted" || valStr === "unknown") {
                    if (resource.clientStatus !== "passed" && resource.clientStatus !== "failed") {
                        resource.clientStatus = "incomplete";
                        needsRecalc = true;
                        console.log(`⏳ Completion Status: INCOMPLETE`);
                    }
                }
            }
            else if (key === "progress") {
                let prog = parseFloat(value) || 0;
                if (prog > 100) prog = 100;
                if (prog > resource.clientProgress) {
                    resource.clientProgress = prog;
                    needsRecalc = true;
                    console.log(`📈 Progress: ${prog}%`);
                }
            }
            else if (key === "score") {
                resource.clientScore = parseFloat(value) || 0;
                console.log(`🎯 Score: ${resource.clientScore}`);
            }

            if (needsRecalc) {
                recalcTotalProgress();
            }
        }

        // ========================================
        // Capture Session Time
        // ========================================
        function captureSessionTime(resource) {
            if (resource.isCompleted) return; // Already saved on DB
            if (sessionStartTime) {
                const now = new Date();
                const diffSec = Math.round((now - sessionStartTime) / 1000);
                const date = new Date(0);
                date.setSeconds(diffSec);
                const timeString = date.toISOString().substr(11, 8);
                resource.clientTime = timeString;
                console.log(`⏱️ Session Time: ${timeString}`);
            }
        }

        // ========================================
        // Recalculate Total Progress
        // ========================================
        function recalcTotalProgress() {
            if(!currentData || !currentData.resources) return;
            let totalResources = currentData.resources.length;
            let passedCount = 0;
            let totalP = 0;

            console.log(`\n🔄 Recalculating Progress...`);
            currentData.resources.forEach((r, idx) => {
                if (!isReadOnly) {
                    const bar = $(`#res-bar-${idx}`);
                    bar.css("width", r.clientProgress + "%");

                    // Color logic
                    if (r.clientStatus === 'failed') {
                        bar.css("background-color", "var(--danger-color)");
                        $(`#res-item-${idx}`).addClass("item-failed");
                    } else {
                        bar.css("background-color", "var(--brand-color)");
                        $(`#res-item-${idx}`).removeClass("item-failed");
                    }
                }

                // Check passed
                const isPassed = (r.clientStatus === "passed" || r.clientStatus === "completed");
                const iconContainer = $(`#res-status-icon-${idx}`);

                if (isPassed) {
                    passedCount++;
                    iconContainer.html('<i class="fas fa-check-circle text-success"></i>');
                } else if (r.clientStatus === "failed") {
                    iconContainer.html('<i class="fas fa-times-circle text-danger"></i>');
                } else {
                    iconContainer.html('');
                }

                totalP += r.clientProgress;
                console.log(`  [${idx}] ${r.name}: ${r.clientStatus} (${r.clientProgress}%)`);
            });

            if (!isReadOnly) {
                const avg = totalResources > 0 ? Math.floor(totalP / totalResources) : 0;
                $("#totalProgressDisplay").text(avg + "%");

                const allPassed = (passedCount === totalResources);
                const hasFailed = currentData.resources.some(r => r.clientStatus === "failed");

                console.log(`📊 Summary: ${passedCount}/${totalResources} passed, Average: ${avg}%`);
                if (allPassed) {
                    $("#statusDisplay").text("ผ่านการทดสอบ").addClass("text-success").removeClass("text-secondary text-danger");
                    $("#btnPreSave").prop("disabled", false);
                    $("#saveHintText").hide();
                    console.log(`✅ All resources PASSED - Save button enabled`);
                } else {
                    if (hasFailed) {
                        $("#statusDisplay").text("ไม่ผ่านเกณฑ์").addClass("text-danger").removeClass("text-secondary");
                        $("#saveHintText").text("* คุณทำแบบทดสอบไม่ผ่าน กรุณาทำใหม่").addClass("text-danger").show();
                        console.log(`❌ Has FAILED resources`);
                    } else {
                        $("#statusDisplay").text("กำลังเรียน").removeClass("text-success text-danger").addClass("text-secondary");
                        $("#saveHintText").text("* กรุณาเรียนและทำแบบทดสอบให้ผ่านเพื่อบันทึก").removeClass("text-danger").show();
                        console.log(`⏳ Still in progress`);
                    }
                    $("#btnPreSave").prop("disabled", true);
                }
            }
        }

