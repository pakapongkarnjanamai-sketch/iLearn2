@{
    ViewData["Title"] = "Learning Player (Detailed Summary)";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
    var playerId = ViewBag.PlayerId ?? 1;
}

@section Styles {
    <style>
        :root {
            --sidebar-width: 400px;
            --primary-color: #007bff;
            --secondary-bg: #f5f7fa;
            --success-color: #28a745;
        }

        body {
            overflow: hidden;
        }

        .viewer-container {
            display: grid;
            grid-template-columns: 1fr var(--sidebar-width);
            gap: 0;
            height: calc(100vh);
            background-color: var(--secondary-bg);
        }

        /* --- Left Side: Player --- */
        .scorm-section {
            display: flex;
            flex-direction: column;
            background: #000;
            position: relative;
        }

        .scorm-toolbar {
            height: 50px;
            padding: 0 20px;
            background: #fff;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .scorm-body {
            flex: 1;
            position: relative;
            background: #e9ecef;
        }

        iframe#scormFrame {
            width: 100%;
            height: 100%;
            border: none;
            display: none;
            background: #fff;
        }

        /* Start Overlay */
        .start-overlay {
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        .start-btn {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: none;
            font-size: 32px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0,123,255,0.3);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .start-btn:hover {
                transform: scale(1.05);
                background: #0056b3;
                box-shadow: 0 8px 25px rgba(0,123,255,0.4);
            }

        /* --- Summary Modal (Updated) --- */
        .summary-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 20;
        }

        .summary-card {
            background: white;
            width: 450px; /* ขยายความกว้างนิดหน่อย */
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            text-align: center;
            display: flex;
            flex-direction: column;
            max-height: 80vh; /* กันล้นจอ */
        }

        .summary-details-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 10px;
            margin: 15px 0;
            text-align: left;
            overflow-y: auto;
            max-height: 200px;
        }

        .summary-item-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            margin-bottom: 6px;
            border-bottom: 1px dashed #dee2e6;
            padding-bottom: 4px;
        }

            .summary-item-row:last-child {
                border-bottom: none;
                margin-bottom: 0;
            }

        /* --- Right Side: Info & TOC --- */
        .info-section {
            background: #fff;
            border-left: 1px solid #dee2e6;
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }

        .course-header-panel {
            padding: 20px;
            background-color: #fff;
            border-bottom: 1px solid #f0f0f0;
        }

        .info-status-bar {
            padding: 15px;
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .toc-header {
            padding: 15px 20px;
            background-color: #fff;
            font-weight: 700;
            color: #495057;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
        }

        .course-toc {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background-color: #fcfcfc;
        }

        /* Resource Item Styling */
        .resource-item {
            cursor: pointer;
            transition: all 0.2s;
            background: #fff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            margin-bottom: 8px;
            padding: 12px;
            position: relative;
            overflow: hidden;
        }

            .resource-item:hover {
                border-color: #b3d7ff;
                transform: translateY(-1px);
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            }

            .resource-item.active {
                border-color: var(--primary-color);
                background-color: #f0f7ff;
            }

                .resource-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    bottom: 0;
                    width: 4px;
                    background-color: var(--primary-color);
                }

        /* Small Progress Bar inside Item */
        .item-progress-track {
            height: 4px;
            background: #e9ecef;
            border-radius: 2px;
            margin-top: 8px;
            overflow: hidden;
        }

        .item-progress-fill {
            height: 100%;
            background: var(--success-color);
            width: 0%;
            transition: width 0.5s ease;
        }

        .resource-type-badge {
            font-size: 0.7rem;
            padding: 2px 6px;
            border-radius: 4px;
            background: #e2e6ea;
            color: #6c757d;
            margin-top: 4px;
            display: inline-block;
        }

        /* Save Button */
        .save-btn-container {
            padding: 15px;
            border-top: 1px solid #dee2e6;
            background: #fff;
        }

        .btn-save-course {
            width: 100%;
            background-color: var(--success-color);
            color: white;
            font-weight: bold;
            border: none;
            padding: 10px;
            border-radius: 5px;
            transition: all 0.3s;
        }

            .btn-save-course:disabled {
                background-color: #ccc;
                cursor: not-allowed;
            }

            .btn-save-course:hover:not(:disabled) {
                background-color: #218838;
                transform: translateY(-2px);
            }

        /* Responsive */
        @@media (max-width: 992px) {

            body {
                overflow: visible;
            }


            .viewer-container

        {
            grid-template-columns: 1fr;
            height: auto;
            overflow-y: auto;
        }

        .scorm-section {
            height: 50vh;
            min-height: 300px;
        }

        .info-section {
            height: auto;
            border-left: none;
            border-top: 1px solid #dee2e6;
        }

        }
    </style>
}

<div class="container-fluid p-0 viewer-container">

    <div class="scorm-section" id="fullscreenArea">
        <div class="scorm-toolbar">
            <div class="d-flex align-items-center overflow-hidden">
                <button class="btn btn-sm btn-light me-2 d-lg-none" onclick="scrollToToc()">
                    <i class="fas fa-list"></i>
                </button>
                <div class="fw-bold text-truncate" id="lessonTitle" style="max-width: 600px;">
                    Loading...
                </div>
            </div>
            <div>
                <button class="btn btn-sm btn-outline-secondary border-0" onclick="toggleFullscreen()" title="Fullscreen">
                    <i class="fas fa-expand fa-lg"></i>
                </button>
            </div>
        </div>

        <div class="scorm-body">
            <div id="startOverlay" class="start-overlay">
                <button class="start-btn" onclick="startCourse()">
                    <i class="fas fa-play ps-1"></i>
                </button>
                <h4 class="mt-4 fw-bold text-dark">เริ่มเรียนบทนี้?</h4>
                <p id="overlayMessage" class="text-muted">กดปุ่ม Play เพื่อเข้าสู่เนื้อหา</p>
            </div>

            <div id="summaryModal" class="summary-overlay">
                <div class="summary-card">
                    <div class="mb-2 text-success">
                        <i class="fas fa-check-circle fa-3x"></i>
                    </div>
                    <h5 class="fw-bold mb-3">บันทึกผลการเรียนเรียบร้อย!</h5>

                    <div class="text-start w-100">
                        <small class="text-muted">นักเรียน:</small> <span id="sumStudentName" class="fw-bold text-dark"></span><br>
                        <small class="text-muted">หลักสูตร:</small> <span id="sumCourseName" class="fw-bold text-primary"></span>
                    </div>

                    <div class="summary-details-box w-100" id="summaryDetailsList">
                    </div>

                    <button class="btn btn-primary w-100 mt-auto" onclick="closeSummary()">ตกลง</button>
                </div>
            </div>

            <iframe id="scormFrame"
                    sandbox="allow-forms allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox">
            </iframe>
        </div>
    </div>

    <div class="info-section" id="tocSection">

        <div class="course-header-panel">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="fw-bold text-dark mb-1" id="courseTitleDisplay">...</h5>
                    <div class="text-muted small">
                        <i class="fas fa-user-circle me-1"></i>
                        <span id="studentCodeDisplay" class="fw-bold text-primary">-</span>
                    </div>
                </div>
                <span class="badge bg-secondary" id="versionDisplay">v.1</span>
            </div>
        </div>

        <div class="info-status-bar">
            <div class="row g-0 text-center bg-white border rounded overflow-hidden">
                <div class="col-6 border-end p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Total Status</small>
                    <div id="statusDisplay" class="fw-bold mt-1 text-secondary" style="font-size: 0.9rem;">-</div>
                </div>
                <div class="col-6 p-2">
                    <small class="text-uppercase text-muted" style="font-size: 0.65rem;">Total Progress</small>
                    <div id="totalProgressDisplay" class="fw-bold mt-1 text-dark" style="font-size: 0.9rem;">0%</div>
                </div>
            </div>
        </div>

        <div class="toc-header">
            <i class="fas fa-list-ul me-2 text-primary"></i> เนื้อหาหลักสูตร
        </div>

        <div class="course-toc" id="courseTocList">
            <div class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted small">กำลังโหลดข้อมูล...</p>
            </div>
        </div>

        <div class="save-btn-container">
            <button id="btnSaveCourse" class="btn-save-course" disabled onclick="saveCourseData()">
                <i class="fas fa-save me-2"></i> บันทึกการเรียนรู้
            </button>
        
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- Configuration ---
        const PLAYER_ID = "@playerId";
        const API_URL = `https://localhost:7128/api/Enrollments/player-info/${PLAYER_ID}`;

        // --- State ---
        let currentData = null;
        let selectedResourceIndex = -1;

        $(function() {
            initScormAdapter();
            loadCourseData();
        });

        // 1. Fetch Data
        async function loadCourseData() {
            try {
                const response = await $.ajax({
                    url: API_URL,
                    method: 'GET',
                    dataType: 'json',
                    xhrFields: { withCredentials: true }
                });

                if (response && response.success) {
                    currentData = response.data;

                    // Initialize Progress & Time Data
                    if(currentData.resources) {
                        currentData.resources.forEach(r => {
                            r.clientProgress = 0; // 0-100
                            r.clientStatus = "incomplete";
                            r.scormTime = "00:00:00"; // Store time string from SCORM
                        });
                    }

                    renderUI(currentData);
                    recalcTotalProgress(); // Initial check
                } else {
                    showError("ไม่สามารถโหลดข้อมูลได้: " + (response.message || "Unknown error"));
                }

            } catch (err) {
                console.error(err);
                showError("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์");
            }
        }

        // 2. Render UI
        function renderUI(data) {
            $("#courseTitleDisplay").text(data.courseTitle || "ไม่มีชื่อหลักสูตร");
            $("#studentCodeDisplay").text(data.studentCode || "-");
            $("#versionDisplay").text("v." + (data.courseVersionId || "1"));

            const listContainer = $("#courseTocList");
            listContainer.empty();

            if (!data.resources || data.resources.length === 0) {
                listContainer.html('<div class="alert alert-warning m-3">ไม่พบเนื้อหาในหลักสูตรนี้</div>');
                return;
            }

            data.resources.forEach((item, index) => {
                let iconClass = "far fa-file";
                if (item.type === "Lesson") iconClass = "fas fa-book-open text-primary";
                else if (item.type === "Exam") iconClass = "fas fa-pencil-alt text-warning";

                const html = `
                    <div class="resource-item"
                         id="res-item-${index}"
                         onclick="selectResource(${index})">

                        <div class="d-flex align-items-center">
                            <div class="me-3 fs-4" style="width: 30px; text-align: center;">
                                <i class="${iconClass}"></i>
                            </div>

                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-truncate" title="${item.name}">${item.name}</div>
                                <span class="resource-type-badge">${item.type}</span>
                            </div>

                            <div class="ms-2 fw-bold small text-muted" id="res-percent-${index}">0%</div>
                        </div>

                        <div class="item-progress-track">
                            <div class="item-progress-fill" id="res-bar-${index}"></div>
                        </div>
                    </div>
                `;
                listContainer.append(html);
            });

            // Select first item automatically
            if (data.resources.length > 0) {
                selectResource(0);
            }
        }

        // 3. Handle Selection
        function selectResource(index) {
            if (!currentData || !currentData.resources[index]) return;

            selectedResourceIndex = index;
            const resource = currentData.resources[index];

            // Update Active UI
            $(".resource-item").removeClass("active");
            $(`#res-item-${index}`).addClass("active");

            // Update Header Title
            $("#lessonTitle").text(resource.name);

            // Show Overlay
            $("#scormFrame").attr("src", "");
            $("#scormFrame").hide();
            $("#startOverlay").fadeIn(200);

            if(window.innerWidth < 992) {
                 // Mobile scroll logic
            }
        }

        // 4. Start Content
        function startCourse() {
            if (selectedResourceIndex === -1) return;

            const resource = currentData.resources[selectedResourceIndex];
            if (!resource || !resource.launchUrl) {
                DevExpress.ui.notify("Invalid Launch URL", "error", 2000);
                return;
            }

            $("#startOverlay").fadeOut(200);
            const iframe = document.getElementById("scormFrame");
            iframe.style.display = "block";
            iframe.src = resource.launchUrl;
        }

        // 5. Calculate Total Progress & Update UI
        function recalcTotalProgress() {
            if(!currentData || !currentData.resources) return;

            let totalP = 0;
            const count = currentData.resources.length;

            currentData.resources.forEach((r, idx) => {
                // Update Individual Bar
                const p = r.clientProgress || 0;
                totalP += p;

                $(`#res-percent-${idx}`).text(p + "%");
                $(`#res-bar-${idx}`).css("width", p + "%");

                // Change color if completed
                if (p === 100) {
                    $(`#res-percent-${idx}`).addClass("text-success").removeClass("text-muted");
                }
            });

            // Calc Average
            const avg = count > 0 ? Math.floor(totalP / count) : 0;

            // Update Total UI
            $("#totalProgressDisplay").text(avg + "%");

            const statusElem = $("#statusDisplay");
            if (avg === 100) {
                statusElem.text("COMPLETED").addClass("text-success").removeClass("text-secondary");
                // Enable Save Button
                $("#btnSaveCourse").prop("disabled", false);
              
            } else {
                statusElem.text("INCOMPLETE").addClass("text-secondary").removeClass("text-success");
                // Disable Save Button
                $("#btnSaveCourse").prop("disabled", true);
               
            }
        }

        // 6. Save Function & Show Modal with Time Detail
        function saveCourseData() {
            // Set Header Info
            $("#sumStudentName").text(currentData.studentCode);
            $("#sumCourseName").text(currentData.courseTitle);

            // Generate Detail List
            const listContainer = $("#summaryDetailsList");
            listContainer.empty();

            let totalHTML = "";
            currentData.resources.forEach((r, index) => {
                // Safe formatting for name length
                const shortName = r.name.length > 35 ? r.name.substring(0, 32) + "..." : r.name;

                // Display Time stored in r.scormTime
                const displayTime = r.scormTime || "00:00:00";

                totalHTML += `
                    <div class="summary-item-row">
                        <span class="text-truncate" title="${r.name}">${shortName}</span>
                        <span class="fw-bold text-success">${displayTime}</span>
                    </div>
                `;
            });
            listContainer.html(totalHTML);

            // Show Modal
            $("#summaryModal").css("display", "flex").hide().fadeIn();

            // Simulate AJAX Save
            console.log("Saving data...", currentData.resources.map(r => ({
                id: r.id,
                progress: r.clientProgress,
                time: r.scormTime
            })));
        }

        function closeSummary() {
             $("#summaryModal").fadeOut();
        }

        // --- Helper: Parse Time String (Handles SCORM 1.2 & 2004) ---
        function formatScormTime(timeStr) {
            if (!timeStr) return "00:00:00";

            // Check if SCORM 2004 ISO Format (PT...)
            if (timeStr.indexOf("P") === 0) {
                 const matches = timeStr.match(/PT(\d+H)?(\d+M)?(\d+(\.\d+)?S)?/);
                 if (!matches) return timeStr;
                 const h = (matches[1] ? parseFloat(matches[1]) : 0);
                 const m = (matches[2] ? parseFloat(matches[2]) : 0);
                 const s = (matches[3] ? parseFloat(matches[3]) : 0);
                 const f = (n) => n.toString().padStart(2, '0');
                 return `${f(h)}:${f(m)}:${f(Math.floor(s))}`;
            }

            // Assume SCORM 1.2 HH:MM:SS
            // Simple validation: if it has colons
            if(timeStr.indexOf(":") > -1) {
                // Optional: Round seconds if needed, but usually fine to return as is
                return timeStr.split(".")[0]; // remove milliseconds if any
            }

            return timeStr;
        }

        function showError(msg) {
            $("#courseTocList").html(`<div class="text-danger p-3 text-center"><i class="fas fa-exclamation-triangle me-1"></i> ${msg}</div>`);
            $("#courseTitleDisplay").text("Error");
        }
        function scrollToToc() {
             document.getElementById('tocSection').scrollIntoView({ behavior: 'smooth' });
        }
        function toggleFullscreen() {
            const elem = document.getElementById("fullscreenArea");
            if (!document.fullscreenElement) {
                elem.requestFullscreen().catch(err => console.log(err));
            } else {
                document.exitFullscreen();
            }
        }

        // ==========================================
        // SCORM ADAPTER (Logic Updated for Time Tracking)
        // ==========================================
        function initScormAdapter() {

            // Helper to update specific resource data
            function updateResourceData(type, value) {
                if(selectedResourceIndex === -1 || !currentData) return;

                const resource = currentData.resources[selectedResourceIndex];
                let needsRecalc = false;

                // 1. Completion Status
                if (type === "status") {
                     const val = value.toString().toLowerCase();
                     resource.clientStatus = val;

                     if (val === "completed" || val === "passed") {
                         resource.clientProgress = 100;
                         needsRecalc = true;
                     }
                }

                // 2. Progress Measure
                if (type === "progress") {
                    let p = parseFloat(value);
                    if (p <= 1.0) p = p * 100;
                    if (p > resource.clientProgress) {
                        resource.clientProgress = Math.round(p);
                        needsRecalc = true;
                    }
                }

                // 3. Session Time (New!)
                if (type === "time") {
                    // Convert to consistent format (00:00:00)
                    resource.scormTime = formatScormTime(value);
                }

                if (needsRecalc) {
                    recalcTotalProgress();
                }
            }

            // --- SCORM 1.2 ---
            window.API = {
                LMSInitialize: function(p) { return "true"; },
                LMSGetValue: function(e) { return ""; },
                LMSSetValue: function(e, v) {
                    if (e === "cmi.core.lesson_status") updateResourceData("status", v);
                    if (e === "cmi.core.score.raw") updateResourceData("progress", v);
                    if (e === "cmi.core.session_time") updateResourceData("time", v);
                    return "true";
                },
                LMSCommit: function(p) { return "true"; },
                LMSFinish: function(p) { return "true"; },
                LMSGetLastError: function() { return "0"; },
                LMSGetErrorString: function(e) { return "No error"; },
                LMSGetDiagnostic: function(e) { return "No error"; }
            };

            // --- SCORM 2004 ---
            window.API_1484_11 = {
                Initialize: function(p) { return true; },
                Terminate: function(p) { return true; },
                GetValue: function(element) { return ""; },
                SetValue: function(element, value) {
                    if (element === "cmi.completion_status" || element === "cmi.success_status") {
                        updateResourceData("status", value);
                    }
                    if (element === "cmi.progress_measure") {
                        updateResourceData("progress", value);
                    }
                    if (element === "cmi.session_time") {
                        updateResourceData("time", value);
                    }
                    return true;
                },
                Commit: function(p) { return true; },
                GetLastError: function() { return 0; },
                GetErrorString: function(e) { return "No error"; },
                GetDiagnostic: function(e) { return "No error"; }
            };

            console.log("SCORM ADAPTER READY (Status, Progress, & Time Tracking)");
        }
    </script>
}