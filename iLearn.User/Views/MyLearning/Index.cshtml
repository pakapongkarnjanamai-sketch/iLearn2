@using System.Security.Claims
@{
    ViewData["Title"] = "หน้าหลัก";
    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="container-fluid py-4">
    @if (!isAuthenticated)
    {
   
    }
    else
    {
     
        var empName = User.Identity.Name;
        var empCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var dept = User.FindFirst("Department")?.Value;

        <div class="card shadow-sm mb-4 border-0 bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fa fa-user fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 text-primary">@empName</h5>
                        <small class="text-muted">
                            รหัสพนักงาน: <strong>@empCode</strong> |
                            แผนก: <strong>@dept</strong>
                        </small>
                    </div>
                </div>
                <a href="@Url.Action("Logout", "Home")" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="fa fa-sign-out"></i> ออกจากระบบ
                </a>
            </div>
        </div>


        <div id="loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">กำลังโหลดข้อมูลวิชาเรียน...</p>
        </div>

        <div id="courseList" class="row g-4" style="display:none;">
        </div>

        <div id="emptyState" class="text-center py-5" style="display:none;">
            <div class="mb-3">
                <i class="fa fa-folder-open-o fa-4x text-muted"></i>
            </div>
            <h4>คุณยังไม่มีคอร์สเรียน</h4>
            <p class="text-muted">โปรดติดต่อ HR หรือ Admin เพื่อลงทะเบียนเรียน</p>
        </div>
    }
</div>

@section Scripts {
    <script>
   
        $(document).ready(function () {
            var isAuth = '@isAuthenticated'.toLowerCase() === 'true';

            if (isAuth) {
                // --- LOGIC สำหรับคน Login แล้ว (โหลดคอร์ส) ---
                var currentEmpCode = '@(User.FindFirst(ClaimTypes.NameIdentifier)?.Value)';
                loadMyCourses(currentEmpCode);
            } else {
                // --- LOGIC สำหรับคนยังไม่ Login (แสดง Popup) ---
                initLoginPopup();
            }
        });

        // ================= Functions ฝั่ง Course List =================
        function loadMyCourses(empCode) {
            if (!empCode) {
                $('#loading').hide();
                return;
            }

            // เรียก API แบบที่ปรับปรุงแล้ว (ส่ง studentCode ไปด้วย)
            $.ajax({
                url: serviceUrl + '/enrollments/my-courses?studentCode=' + encodeURIComponent(empCode),
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function (response) {
                    $('#loading').hide();
                    const courses = response.data || response;

                    if (!courses || courses.length === 0) {
                        $('#emptyState').show();
                        return;
                    }

                    renderCourses(courses);
                    $('#courseList').fadeIn();
                },
                error: function (err) {
                    console.error("Error loading courses:", err);
                    $('#loading').hide();
                    DevExpress.ui.notify("ไม่สามารถโหลดข้อมูลคอร์สได้", "error", 3000);
                }
            });
        }

        function renderCourses(courses) {
            const container = $('#courseList');
            container.empty();

            courses.forEach(enrollment => {
                const statusVal = (enrollment.status || enrollment.Status || '').toString().toLowerCase();
                const isCompleted = statusVal === 'completed' || statusVal === 'passed' || statusVal === 'finished';
                const statusBadge = isCompleted
                    ? '<span class="badge bg-success">เรียนจบแล้ว</span>'
                    : '<span class="badge bg-warning text-dark">กำลังเรียน</span>';

                const btnText = isCompleted ? 'ทบทวนบทเรียน' : 'เข้าเรียน';
                const btnClass = isCompleted ? 'btn-outline-primary' : 'btn-primary';

                const title = enrollment.courseTitle || 'ไม่มีชื่อวิชา';
                const courseId = enrollment.courseId || '-';
                const enrollmentId = enrollment.id;
                const createdDate = new Date(enrollment.createdAt || Date.now()).toLocaleDateString('th-TH');

                const cardHtml = `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 hover-shadow">
                            <div class="bg-gradient text-white d-flex align-items-center justify-content-center" style="height: 160px; background: linear-gradient(135deg,#0069d9 0%,#6610f2 100%);">
                                <i class="fa fa-book fa-3x"></i>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    ${statusBadge}
                                </div>
                                <h5 class="card-title text-truncate" title="${title}">
                                    ${title}
                                </h5>
                                <p class="card-text text-muted small mb-4">
                                    รหัสวิชา: ${courseId} <br>
                                    ลงทะเบียนเมื่อ: ${createdDate}
                                </p>
                                <div class="mt-auto d-grid">
                                    <a href="/MyLearning/Player?enrollmentId=${enrollmentId}" class="btn ${btnClass} w-100 rounded-pill">
                                        <i class="fa fa-play-circle me-1"></i> ${btnText}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.append(cardHtml);
            });
        }
    </script>

    <style>
        /* Styles สำหรับ Login */
        .dx-field {
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }

        .dx-field-label {
            width: 35%;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .dx-field-value {
            width: 65%;
        }

        /* Styles สำหรับ Course Card */
        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            transition: all 0.3s ease;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
        }
    </style>
}