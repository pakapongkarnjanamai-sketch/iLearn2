@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var empName = User.Identity?.Name ?? "Guest";
    var empCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "-";
    var dept = User.FindFirst("Department")?.Value ?? "-";
    var div = User.FindFirst("Division")?.Value ?? "-";
}

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .text-brand {
            color: var(--brand-color) !important;
        }

        .bg-brand {
            background-color: var(--brand-color) !important;
        }

        .border-brand {
            border-color: var(--brand-color) !important;
        }

        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2.5rem 0 1.5rem;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 600;
            font-size: 1.2rem;
            color: #2c3e50;
            letter-spacing: -0.5px;
        }

        /* --- Modern Tabs (Filter) --- */
        .nav-pills {
            gap: 0.5rem;
        }

            .nav-pills .nav-link {
                color: #6c757d;
                font-weight: 600;
                border-radius: 8px;
                padding: 0.5rem 1.5rem;
                transition: all 0.2s ease;
                background-color: #f8f9fa;
                border: 1px solid transparent;
                cursor: pointer;
            }

                .nav-pills .nav-link:hover {
                    background-color: #e9ecef;
                    color: var(--brand-color);
                }

                .nav-pills .nav-link.active {
                    background-color: rgba(2, 125, 131, 0.1);
                    color: var(--brand-color);
                    border-color: rgba(2, 125, 131, 0.2);
                }

        /* --- Course Card (New Design) --- */
        .my-course-card {
            border: none;
            border-radius: 8px;
            background: white;
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .my-course-card:hover {
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            }

        /* ========== Horizontal Scroll Carousel (My Courses) ========== */
        .my-courses-carousel {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 0.5rem;
            scrollbar-width: thin;
            scrollbar-color: rgba(2,125,131,0.3) transparent;
        }

        .my-courses-carousel::-webkit-scrollbar {
            height: 6px;
        }

        .my-courses-carousel::-webkit-scrollbar-thumb {
            background: rgba(2,125,131,0.3);
            border-radius: 3px;
        }

        .my-courses-carousel::-webkit-scrollbar-track {
            background: transparent;
        }

        .my-courses-carousel .carousel-card {
            flex: 0 0 220px;
            max-width: 220px;
            scroll-snap-align: start;
        }

        /* Expanded grid mode (toggle) */
        .my-courses-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .my-courses-grid .carousel-card {
            flex: 0 0 calc(16.666% - 0.85rem);
            max-width: calc(16.666% - 0.85rem);
        }

        @@media (max-width: 1399px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(20% - 0.8rem);
                max-width: calc(20% - 0.8rem);
            }
        }

        @@media (max-width: 1199px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(25% - 0.75rem);
                max-width: calc(25% - 0.75rem);
            }
        }

        @@media (max-width: 991px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(33.333% - 0.67rem);
                max-width: calc(33.333% - 0.67rem);
            }
        }

        @@media (max-width: 767px) {
            .my-courses-grid .carousel-card,
            .my-courses-carousel .carousel-card {
                flex: 0 0 180px;
                max-width: 180px;
            }
        }

        /* Compact card overrides for My Courses carousel */
        .my-courses-carousel .course-thumb,
        .my-courses-grid .course-thumb {
            height: 70px;
        }

        .my-courses-carousel .course-code-text,
        .my-courses-grid .course-code-text {
            font-size: 0.75rem;
        }

        .my-courses-carousel .course-body,
        .my-courses-grid .course-body {
            padding: 0.5rem 0.6rem;
        }

        .my-courses-carousel .course-title,
        .my-courses-grid .course-title {
            font-size: 0.78rem;
            line-height: 1.35;
            margin-bottom: 0.3rem;
            -webkit-line-clamp: 2;
        }

        .my-courses-carousel .progress-section,
        .my-courses-grid .progress-section {
            padding-top: 0.5rem;
        }

        .my-courses-carousel .due-date-row,
        .my-courses-grid .due-date-row {
            font-size: 0.7rem;
        }

        .my-courses-carousel .progress-wrapper-inline,
        .my-courses-grid .progress-wrapper-inline {
            height: 5px;
        }

        .my-courses-carousel .progress-info,
        .my-courses-grid .progress-info {
            margin-bottom: 0.4rem;
        }

        .my-courses-carousel .progress-info .text-primary,
        .my-courses-grid .progress-info .text-primary {
            font-size: 0.75rem;
        }

        .my-courses-carousel .btn-continue,
        .my-courses-grid .btn-continue {
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
            margin-top: 0.2rem;
        }

        .my-courses-carousel .category-badge,
        .my-courses-grid .category-badge {
            font-size: 0.6rem;
            padding: 0.05rem 0.4rem;
        }

        /* Toggle button */
        .btn-view-toggle {
            color: var(--brand-color);
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            border: none;
            background: none;
            transition: all 0.2s;
        }

        .btn-view-toggle:hover {
            text-decoration: underline;
        }

        .course-thumb {
            height: 130px;
            background-color: #eee;
            position: relative;
            overflow: hidden;
        }

            .course-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

       

        /* Course Code Overlay */
        .course-code-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            z-index: 2;
        }

        .course-code-text {
            color: white;
            font-weight: 700;
            font-size: 1rem;
            text-align: center;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
            line-height: 1.4;
            word-break: break-word;
        }

        .course-type-label {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.2rem 0.75rem;
            border-radius: 12px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border: 1px solid rgba(255, 255, 255, 0.3);
            margin-bottom: 0.4rem;
            text-shadow: 0 1px 2px rgba(0,0,0,0.3);
        }

        /* ซ่อน Play Overlay และ Play Icon */
        .course-overlay {
            display: none !important;
        }

        .play-icon {
            display: none !important;
        }

        /* Card Body */
        .course-body {
            padding: 0.75rem 1rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--dx-color-border);
            border-radius: 0 0 8px 8px;
        }

        .course-title {
            font-weight: 600;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 0.5rem;
            color: #2c3e50;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Progress Section */
        .progress-section {
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid #f8f9fa;
        }

        /* DueDate Row */
        .due-date-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
        }

        .due-date-row .category-badge {
            font-size: 0.7rem;
            padding: 0.1rem 0.5rem;
        }

        /* Progress Info */
        .progress-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .progress-wrapper-inline {
            flex: 1;
            height: 8px;
            background-color: #ecf0f1;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--brand-color);
            border-radius: 4px;
            transition: width 1s ease-in-out;
        }

        .btn-continue {
            margin-top: 0.4rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            transition: all 0.2s;
        }

           

        /* ========== Compact Catalog Cards (Grid Mode) ========== */
        .catalog-content .course-thumb {
            height: 130px;
        }

        .catalog-content .course-code-text {
            font-size: 0.9rem;
        }

        .catalog-content .course-body {
            padding: 0.65rem 0.85rem;
        }

        .catalog-content .course-title {
            font-size: 0.85rem;
            line-height: 1.45;
            margin-bottom: 0.4rem;
        }

        .catalog-content .btn-continue {
            font-size: 0.78rem;
            padding: 0.3rem 0.6rem;
        }

        .catalog-content .progress-section {
            padding-top: 0.6rem;
        }

        /* ========== Catalog List View ========== */
        .catalog-list-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.55rem 0.75rem;
            background: white;
            border: 1px solid #f0f0f0;
            border-radius: 6px;
            margin-bottom: 0.35rem;
            transition: all 0.2s ease;
            cursor: default;
        }

        .catalog-list-item:hover {
            border-color: rgba(2, 125, 131, 0.3);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .catalog-list-item .list-code-badge {
            flex-shrink: 0;
            background: var(--brand-color);
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
            white-space: nowrap;
            letter-spacing: 0.3px;
            min-width: 70px;
            text-align: center;
        }

        .catalog-list-item .list-info {
            flex: 1;
            min-width: 0;
        }

        .catalog-list-item .list-title {
            font-weight: 600;
            font-size: 0.85rem;
            color: #2c3e50;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .catalog-list-item .list-action {
            flex-shrink: 0;
        }

        .catalog-list-item .btn-list-view {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            white-space: nowrap;
        }

        /* ========== Catalog View Toggle ========== */
        .catalog-view-toggle {
            display: inline-flex;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
            overflow: hidden;
        }

        .catalog-view-toggle .toggle-btn {
            border: none;
            background: white;
            padding: 0.3rem 0.6rem;
            font-size: 0.8rem;
            color: #999;
            cursor: pointer;
            transition: all 0.15s;
            line-height: 1;
        }

        .catalog-view-toggle .toggle-btn:not(:last-child) {
            border-right: 1px solid #e0e0e0;
        }

        .catalog-view-toggle .toggle-btn.active {
            background: var(--brand-color);
            color: white;
        }

        .catalog-view-toggle .toggle-btn:hover:not(.active) {
            background: #f5f5f5;
            color: #555;
        }

        /* Profile Stats */
        .stat-box {
            background: white;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

        /* Catalog Section */
        .catalog-section {
            background: white;
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            min-height: 400px;
        }

        .category-badge {
            background: rgba(2, 125, 131, 0.1);
            color: var(--brand-color);
            padding: 0.25rem 0.75rem;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* ========== Category Sidebar ========== */
        .catalog-layout {
            display: flex;
            gap: 2rem;
        }

        .category-sidebar {
            flex: 0 0 280px;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

            .category-sidebar h5 {
                font-size: 1rem;
                font-weight: 700;
                color: #2c3e50;
                margin-bottom: 1rem;
                padding-bottom: 0.75rem;
                border-bottom: 2px solid var(--brand-color);
            }

        .category-menu-item {
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8f9fa;
            border: 1px solid transparent;
        }

            .category-menu-item:hover {
                background: rgba(2, 125, 131, 0.05);
                border-color: rgba(2, 125, 131, 0.2);
            }

            .category-menu-item.active {
                background: rgba(2, 125, 131, 0.1);
                border-color: var(--brand-color);
                color: var(--brand-color);
                font-weight: 600;
            }

            .category-menu-item .category-name {
                flex: 1;
                font-size: 0.9rem;
            }

            .category-menu-item .course-count {
                background: white;
                padding: 0.15rem 0.5rem;
                border-radius: 12px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #6c757d;
            }

            .category-menu-item.active .course-count {
                background: var(--brand-color);
                color: white;
            }

        .catalog-content {
            flex: 1;
            min-width: 0;
        }

        /* ========== Course Type Section ========== */
        .course-type-section {
            margin-bottom: 1.5rem;
        }

        .course-type-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .type-badge {
            padding: 0.35rem 0.9rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: white;
        }

        /* ========== Search Highlight ========== */
        .search-highlight {
            background-color: yellow;
            font-weight: bold;
            padding: 0 2px;
            border-radius: 2px;
        }

        /* ========== Responsive ========== */
        @@media (max-width: 991px) {
            .catalog-layout {
                flex-direction: column;
            }

            .category-sidebar {
                flex: 1;
                position: relative;
                top: 0;
            }
        }
    </style>
}

@if (!isAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">กรุณาเข้าสู่ระบบ</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">เข้าสู่ระบบ</a>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width:90px;height:90px;background-color:var(--brand-color);">
                            <i class="fas fa-user" style="font-size:2.5rem;color:#fff;"></i>
                        </div>
                        <div>
                            <h2 class="page-title mb-1">สวัสดี, @empName</h2>
                            <p class="text-muted mb-0">
                                <i class="fas fa-id-card text-brand me-1"></i> @empCode
                                <span class="mx-2">|</span>
                                <i class="fas fa-building text-brand me-1"></i>@div - @dept
                            </p>
                        </div>
                        <a href="javascript:void(0)" id="btnLogout"
                           class="btn btn-sm d-flex align-items-center gap-2"
                           style="border:1.5px solid var(--brand-color);color:var(--brand-color);border-radius:8px;padding:0.4rem 1rem;font-weight:600;font-size:0.85rem;background:transparent;transition:all 0.2s;">
                            <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
                        </a>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="stat-box text-center">
                                <div class="stat-number text-brand" id="statEnrolled">-</div>
                                <div class="stat-label">มอบหมาย</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-box text-center">
                                <div class="stat-number text-brand" id="statCompleted">-</div>
                                <div class="stat-label">เรียนจบแล้ว</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container pb-4">

        <div class="mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-book-reader text-brand me-2"></i>
                        หลักสูตรของฉัน
                    </h5>
                </div>

                <ul class="nav nav-pills" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link" onclick="filterMyCourses('all')">
                            <i class="fas fa-th-large me-1 small"></i> ทั้งหมด
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active" onclick="filterMyCourses('not-started')">
                            <i class="fas fa-hourglass-start me-1 small"></i> ยังไม่เริ่ม
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" onclick="filterMyCourses('progress')">
                            <i class="fas fa-spinner me-1 small"></i> กำลังเรียน
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" onclick="filterMyCourses('completed')">
                            <i class="fas fa-check-circle me-1 small"></i> เรียนจบแล้ว
                        </a>
                    </li>
                </ul>
            </div>

            <div id="myCoursesContainer" class="my-courses-carousel"></div>
            <div class="text-center mt-2" id="viewToggleContainer" style="display:none;">
                <button class="btn-view-toggle" id="btnViewToggle" onclick="toggleMyCoursesView()">
                    <i class="fas fa-th-large me-1"></i> ดูทั้งหมด
                </button>
            </div>
        </div>

        <div class="catalog-section">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-graduation-cap text-brand me-2"></i>
                        คลังหลักสูตร
                    </h5>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <ul class="nav nav-pills" id="catalog-type-filter">
                        <li class="nav-item">
                            <a class="nav-link active" onclick="filterCatalogByType('all')">
                                <i class="fas fa-th-large me-1 small"></i> ทั้งหมด
                            </a>
                        </li>
                    </ul>
                    <div id="searchBoxContainer"></div>
                    <div class="catalog-view-toggle">
                        <button class="toggle-btn active" id="btnListView" onclick="setCatalogView('list')" title="มุมมองรายการ">
                            <i class="fas fa-list"></i>
                        </button>
                        <button class="toggle-btn" id="btnGridView" onclick="setCatalogView('grid')" title="มุมมองกริด">
                            <i class="fas fa-th"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="catalog-layout" id="catalogLayout" style="display: none;">
                <div class="category-sidebar">
                    <h5>
                        <i class="fas fa-folder-tree me-2"></i>
                        หมวดหมู่
                    </h5>
                    <div id="categoryMenu"></div>
                </div>

                <div class="catalog-content" id="catalogContent"></div>
            </div>
        </div>

    </div>
}

@section Scripts {
    <script>
        const studentCode = '@empCode';
        const divisionName = '@div';
        const baseUrl = (typeof serviceUrl !== 'undefined') ? serviceUrl : '';
        let allCoursesData = [];
        let myCoursesData = [];
        let currentFilter = 'not-started';
        let selectedCategoryId = 'all';
        let selectedCourseType = 'all';
        let allCourseTypes = []; // dynamic course types loaded from API
        let categorizedCourses = {};
        let catalogViewMode = 'list'; // 'list' or 'grid'

        let myCoursesExpanded = false;
        const MY_COURSES_COLLAPSED_COUNT = 10;

        const typeColorPalette = [
            'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
            'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
            'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
            'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
            'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
            'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
        ];

        function getTypeColor(index) {
            return typeColorPalette[index % typeColorPalette.length];
        }

        $(function() {
            initSearchBox();
            initLogout();
            loadMyCourses();
            loadCourseTypes();
        });
        function initLogout() {
            $('#btnLogout').on('click', function (e) {
                e.preventDefault();
                const logoutUrl = '@Url.Action("Logout", "Home")';

                const dialog = DevExpress.ui.dialog.custom({
                    title: '',
                    messageHtml: `
                        <div class="text-center py-2">
                            <i class="fas fa-sign-out-alt" style="font-size:2.5rem;color:var(--brand-color);margin-bottom:0.75rem;"></i>
                            <h5 style="font-weight:700;color:#2c3e50;margin-bottom:0.4rem;">ออกจากระบบ</h5>
                            <p style="color:#7f8c8d;font-size:0.9rem;margin-bottom:0;">คุณต้องการออกจากระบบใช่หรือไม่?</p>
                        </div>`,
                    buttons: [],
                    dragEnabled: false,
                    showCloseButton: false,
                    width: 340
                });

                dialog.show();

                const $footer = dialog.$element().find('.dx-popup-bottom');
                $footer.empty().append(`
                    <div class="d-flex gap-2 justify-content-center pb-2">
                        <div id="dlg-logout-cancel"></div>
                        <div id="dlg-logout-confirm"></div>
                    </div>
                `);

                $('#dlg-logout-cancel').dxButton({
                    text: 'ยกเลิก',
                    stylingMode: 'outlined',
                    onClick: function () { dialog.hide(); }
                });

                $('#dlg-logout-confirm').dxButton({
                    text: 'ออกจากระบบ',
                    type: 'danger',
                    stylingMode: 'contained',
                    icon: 'fas fa-sign-out-alt',
                    onClick: function () {
                        dialog.hide();
                        window.location.href = logoutUrl;
                    }
                });
            });
        }

        // ========== Search Box ==========
        function initSearchBox() {
            $("#searchBoxContainer").dxTextBox({
                placeholder: "ค้นหาหลักสูตร...",
                mode: "search",
                width: 300,
                valueChangeEvent: "keyup",
                onValueChanged: function(e) {
                    filterCatalog(e.value);
                }
            });
        }

        // ========== Load My Courses ==========
        function loadMyCourses() {
            showSkeletonCarousel('#myCoursesContainer', 6);
            $.ajax({
                url: `${baseUrl}/enrollments/my-courses?studentCode=${studentCode}`,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    if (res.success && res.data && res.data.length > 0) {
                        myCoursesData = res.data;
                        updateStats(res.data);
                        const notStarted = res.data.filter(e => !e.isCompleted && (e.progress || 0) === 0);
                        renderMyCourses(notStarted.length > 0 ? notStarted : res.data);
                    } else {
                        renderEmptyState('#myCoursesContainer', 'คุณยังไม่มีคอร์สที่ได้รับมอบหมาย');
                        $("#statEnrolled, #statCompleted").text("0");
                    }
                },
                error: function() {
                    renderEmptyState('#myCoursesContainer', 'ไม่สามารถโหลดข้อมูลคอร์สเรียนได้');
                    showToast("ไม่สามารถโหลดข้อมูลคอร์สเรียนได้", "error");
                }
            });
        }

        function renderMyCourses(enrollments) {
            const $container = $("#myCoursesContainer");
            $container.empty();

            // Show toggle button when more than collapsed count
            if (enrollments.length > MY_COURSES_COLLAPSED_COUNT) {
                $('#viewToggleContainer').show();
            } else {
                $('#viewToggleContainer').hide();
            }

            // Apply collapsed/expanded mode
            const isExpanded = myCoursesExpanded;
            const displayItems = isExpanded ? enrollments : enrollments.slice(0, MY_COURSES_COLLAPSED_COUNT);

            $container.removeClass('my-courses-carousel my-courses-grid');
            $container.addClass(isExpanded ? 'my-courses-grid' : 'my-courses-carousel');

            displayItems.forEach(en => {
                const course = en.course || {};
                const progress = en.progress || 0;
                const isCompleted = !!en.isCompleted;
                const bgImage = course.coverImageUrl || 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80';

                const courseCode = en.courseCode || course.code || '-';
                const courseTypeName = en.courseTypeName || '';
                const statusClass = isCompleted ? 'completed' : (progress > 0 ? 'in-progress' : 'not-started');

                const dueDate = formatDueDate(en.dueDate);

                const typeBadgeHtml = courseTypeName
                    ? `<span class="category-badge">${courseTypeName}</span>`
                    : '';

                const $card = $("<div>")
                    .addClass('carousel-card course-item')
                    .attr('data-status', statusClass)
                    .html(`
                        <div class="my-course-card">
                            <div class="course-thumb">
                                 <img src="${bgImage}" alt="${en.courseTitle}" loading="lazy">

                                <div class="course-code-overlay">
                                    <div class="course-code-text">
                                      <div>${courseCode}</div>
                                    </div>
                                 </div>

                                ${isCompleted ? '<span class="badge bg-brand position-absolute top-0 end-0 m-2" style="z-index: 3;"><i class="fas fa-check-circle me-1"></i>เรียนจบ</span>' : ''}
                            </div>
                            <div class="course-body">
                                <h6 class="course-title" title="${en.courseTitle}">${en.courseTitle}</h6>

                                <div class="progress-section">
                                    <div class="due-date-row mb-2">
                                        <span class="d-flex align-items-center">
                                            <i class="far fa-calendar-alt text-muted me-1"></i>
                                            <span class="text-muted small">กำหนด: ${dueDate}</span>
                                        </span>
                                        ${typeBadgeHtml}
                                    </div>

                                    <div class="progress-info">
                                        <div class="progress-wrapper-inline">
                                            <div class="progress-fill" style="width: ${progress}%;"></div>
                                        </div>
                                        <span class="text-primary fw-bold ms-2">${Math.round(progress)}%</span>
                                    </div>

                                    <a href="@Url.Action("Player", "MyLearning")?courseId=${en.courseId}" class="btn btn-outline-primary w-100 btn-continue">
                                        ${isCompleted ? 'ทบทวน' : (progress > 0 ? 'เรียนต่อ' : 'เริ่มเรียน')} <i class="fas fa-arrow-right ms-1 small"></i>
                                    </a>
                                </div>
                             </div>
                        </div>
                    `);
                $container.append($card);
            });
        }

        function formatDueDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            return `${day}/${month}/${year}`;
        }

        function updateStats(data) {
            const completed = data.filter(e => !!e.isCompleted).length;
            const inProgress = data.length - completed;
            $("#statEnrolled").text(inProgress);
            $("#statCompleted").text(completed);
        }

        // ========== Toggle My Courses View ==========
        function toggleMyCoursesView() {
            myCoursesExpanded = !myCoursesExpanded;
            const $btn = $('#btnViewToggle');
            if (myCoursesExpanded) {
                $btn.html('<i class="fas fa-arrow-left me-1"></i> ย่อส่วน');
            } else {
                $btn.html('<i class="fas fa-th-large me-1"></i> ดูทั้งหมด');
            }
            // Re-render with current filter
            let filteredData = myCoursesData;
            if (currentFilter === 'not-started') {
                filteredData = myCoursesData.filter(e => !e.isCompleted && (e.progress || 0) === 0);
            } else if (currentFilter === 'progress') {
                filteredData = myCoursesData.filter(e => !e.isCompleted && (e.progress || 0) > 0);
            } else if (currentFilter === 'completed') {
                filteredData = myCoursesData.filter(e => !!e.isCompleted);
            }
            if (filteredData.length === 0) {
                const messages = {
                    'all': 'คุณยังไม่มีคอร์สที่ลงทะเบียน',
                    'not-started': 'คุณยังไม่มีคอร์สที่ยังไม่เริ่มเรียน',
                    'progress': 'คุณยังไม่มีคอร์สที่กำลังเรียน',
                    'completed': 'คุณยังไม่มีคอร์สที่เรียนจบแล้ว'
                };
                renderEmptyState('#myCoursesContainer', messages[currentFilter]);
            } else {
                renderMyCourses(filteredData);
            }
        }

        // ========== Filter My Courses ==========
        function filterMyCourses(type) {
            currentFilter = type;
            $('#pills-tab .nav-link').removeClass('active');
            event.target.classList.add('active');

            let filteredData = myCoursesData;

            if (type === 'not-started') {
                filteredData = myCoursesData.filter(e => !e.isCompleted && (e.progress || 0) === 0);
            } else if (type === 'progress') {
                filteredData = myCoursesData.filter(e => !e.isCompleted && (e.progress || 0) > 0);
            } else if (type === 'completed') {
                filteredData = myCoursesData.filter(e => !!e.isCompleted);
            }

            const $container = $("#myCoursesContainer");
            if (filteredData.length === 0) {
                const messages = {
                    'all': 'คุณยังไม่มีคอร์สที่ลงทะเบียน',
                    'not-started': 'คุณยังไม่มีคอร์สที่ยังไม่เริ่มเรียน',
                    'progress': 'คุณยังไม่มีคอร์สที่กำลังเรียน',
                    'completed': 'คุณยังไม่มีคอร์สที่เรียนจบแล้ว'
                };
                renderEmptyState('#myCoursesContainer', messages[type]);
            } else {
                renderMyCourses(filteredData);
            }
        }

        // ========== Load Course Types (dynamic) ==========
        function loadCourseTypes() {
            $.ajax({
                url: `${baseUrl}/admin/CourseTypesCRUD/Get`,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    allCourseTypes = res.data || (Array.isArray(res) ? res : []);
                    renderTypeFilterPills();
                    loadAllCourses();
                },
                error: function() {
                    loadAllCourses(); // load courses even if types fail
                }
            });
        }

        // ========== Render Type Filter Pills ==========
        function renderTypeFilterPills() {
            const $filter = $('#catalog-type-filter');
            // remove any previously injected type pills
            $filter.find('.dynamic-type-pill').remove();

            allCourseTypes.forEach(function(ct) {
                $filter.append(`
                    <li class="nav-item dynamic-type-pill">
                        <a class="nav-link" onclick="filterCatalogByType(${ct.id})">
                            <i class="fas fa-tag me-1 small"></i> ${ct.name}
                        </a>
                    </li>
                `);
            });
        }

        // ========== Load Catalog ==========
        function loadAllCourses() {
            $("#catalogLayout").show();
            showSkeletonCards('#catalogContent', 4, 'col-md-6 col-lg-4 col-xl-3');
            $.ajax({
                url: `${baseUrl}/courses`,
                method: 'GET',
                data: { isActive: true, divisionName: divisionName !== '-' ? divisionName : '' },
                xhrFields: { withCredentials: true },
                success: function(res) {
                    allCoursesData = res.data || (Array.isArray(res) ? res : []);

                    if (allCoursesData.length > 0) {
                        organizeCoursesByCategory(allCoursesData);
                        renderCategorySidebar();
                        renderCatalogContent('all');
                    } else {
                        renderEmptyState('#catalogContent', 'ยังไม่มีหลักสูตรในขณะนี้');
                    }
                },
                error: function() {
                    renderEmptyState('#catalogContent', 'ไม่สามารถโหลดข้อมูลหลักสูตรได้');
                    showToast("ไม่สามารถโหลดข้อมูลหลักสูตรได้", "error");
                }
            });
        }

        // ========== Organize by Category ==========
        function organizeCoursesByCategory(courses) {
            categorizedCourses = { 'all': courses };
            courses.forEach(course => {
                const catId = course.categoryId;
                const catName = course.categoryName || 'ไม่ระบุหมวดหมู่';

                if (!categorizedCourses[catId]) {
                    categorizedCourses[catId] = {
                        id: catId,
                        name: catName,
                        courses: []
                    };
                }
                categorizedCourses[catId].courses.push(course);
            });
        }

        // ========== Render Category Sidebar ==========
        function renderCategorySidebar() {
            const $menu = $("#categoryMenu");
            $menu.empty();

            // All Categories
            $menu.append(`
                <div class="category-menu-item active" data-category="all">
                    <span class="category-name">
                        <i class="fas fa-th-large me-2"></i>ทั้งหมด
                    </span>
                    <span class="course-count">${allCoursesData.length}</span>
                </div>
            `);
            // Individual Categories
            Object.keys(categorizedCourses).forEach(catId => {
                if (catId === 'all') return;

                const cat = categorizedCourses[catId];
                $menu.append(`
                    <div class="category-menu-item" data-category="${catId}">
                        <span class="category-name">
                            <i class="fas fa-folder me-2"></i>${cat.name}
                        </span>
                        <span class="course-count">${cat.courses.length}</span>
                    </div>
                `);
            });
            // Click Event
            $menu.on('click', '.category-menu-item', function() {
                const categoryId = $(this).data('category');
                selectedCategoryId = categoryId;

                $('.category-menu-item').removeClass('active');
                $(this).addClass('active');

                renderCatalogContent(categoryId);
            });
        }

        // ========== Filter Catalog by Course Type ==========
        function filterCatalogByType(type) {
            selectedCourseType = type;
            $('#catalog-type-filter .nav-link').removeClass('active');
            event.target.classList.add('active');

            renderCatalogContent(selectedCategoryId);
        }

        // ========== Set Catalog View Mode ==========
        function setCatalogView(mode) {
            catalogViewMode = mode;
            $('#btnListView, #btnGridView').removeClass('active');
            if (mode === 'list') {
                $('#btnListView').addClass('active');
            } else {
                $('#btnGridView').addClass('active');
            }
            renderCatalogContent(selectedCategoryId);
        }

        // ========== Render Catalog Content ==========
        function renderCatalogContent(categoryId) {
            const $content = $("#catalogContent");
            $content.empty();

            let coursesToShow = categoryId === 'all'
                ? allCoursesData
                : (categorizedCourses[categoryId]?.courses || []);

            // Apply Course Type Filter
            if (selectedCourseType !== 'all') {
                coursesToShow = coursesToShow.filter(c => c.courseTypeId === selectedCourseType);
            }

            if (coursesToShow.length === 0) {
                renderEmptyState('#catalogContent', 'ไม่พบหลักสูตรในหมวดหมู่นี้');
                return;
            }

            if (catalogViewMode === 'list') {
                const $list = $('<div class="catalog-list-container"></div>');
                coursesToShow.forEach(course => {
                    $list.append(renderCatalogListItem(course));
                });
                $content.append($list);
            } else {
                const $grid = $('<div class="row g-3"></div>');
                coursesToShow.forEach(course => {
                    $grid.append(renderCatalogCard(course));
                });
                $content.append($grid);
            }
        }

        // ========== Render Single Catalog Card (Grid) ==========
        function renderCatalogCard(course) {
            const bgImage = course.coverImageUrl || 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80';
            const courseCode = course.code || '-';

            return $(`
                <div class="col-md-6 col-lg-4 col-xl-3 catalog-course-item">
                    <div class="my-course-card">
                        <div class="course-thumb">
                            <img src="${bgImage}" alt="${course.title}" loading="lazy">
                            <div class="course-code-overlay">
                                <div class="course-code-text">${courseCode}</div>
                            </div>
                        </div>
                        <div class="course-body">
                            <h6 class="course-title" title="${course.title}">${course.title}</h6>

                            <div class="progress-section">
                                <a href="@Url.Action("Player", "MyLearning")?courseId=${course.id}" class="btn btn-outline-primary w-100 btn-continue">
                                    <i class="fas fa-eye me-1"></i> ดูเนื้อหา
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `);
        }

        // ========== Render Single Catalog List Item ==========
        function renderCatalogListItem(course) {
            const courseCode = course.code || '-';

            return $(`
                <div class="catalog-list-item catalog-course-item">
                    <div class="list-code-badge">${courseCode}</div>
                    <div class="list-info">
                        <div class="list-title course-title" title="${course.title}">${course.title}</div>
                    </div>
                    <div class="list-action">
                        <a href="@Url.Action("Player", "MyLearning")?courseId=${course.id}" class="btn btn-outline-primary btn-list-view">
                            <i class="fas fa-eye me-1"></i> ดูเนื้อหา
                        </a>
                    </div>
                </div>
            `);
        }

        // ========== Filter Catalog (Search) ==========
        function filterCatalog(searchText) {
            const $items = $(".catalog-course-item");
            if (!searchText || searchText.trim() === '') {
                $items.show();
                removeHighlights();
                return;
            }

            const lowerSearch = searchText.toLowerCase();
            $items.each(function() {
                const $item = $(this);
                const title = $item.find('.course-title').text().toLowerCase();
                const code = $item.find('.course-code-text, .list-code-badge').text().toLowerCase();

                if (title.includes(lowerSearch) || code.includes(lowerSearch)) {
                    $item.show();
                    highlightText($item, searchText);
                } else {
                    $item.hide();
                }
            });
        }

        // ========== Highlight Search Text ==========
        function highlightText($item, searchText) {
            removeHighlights();
            const $title = $item.find('.course-title');
            const $code = $item.find('.course-code-text, .list-code-badge');

            const titleHtml = $title.html();
            const codeHtml = $code.html();
            const regex = new RegExp(`(${escapeRegex(searchText)})`, 'gi');

            $title.html(titleHtml.replace(regex, '<span class="search-highlight">$1</span>'));
            $code.html(codeHtml.replace(regex, '<span class="search-highlight">$1</span>'));
        }

        function removeHighlights() {
            $('.search-highlight').each(function() {
                $(this).replaceWith($(this).text());
            });
        }

        function escapeRegex(str) {
            return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // ========== Empty State Helper ==========
        function renderEmptyState(selector, message) {
            $(selector).html(
                '<div class="col-12">' +
                    '<div class="d-flex flex-column align-items-center justify-content-center py-4 text-center">' +
                        '<i class="fas fa-inbox fa-2x mb-2" style="color:#d0d0d0;"></i>' +
                        '<p class="text-muted mb-0 small">' + message + '</p>' +
                    '</div>' +
                '</div>'
            );
        }

        // ========== Skeleton Carousel Helper ==========
        function showSkeletonCarousel(selector, count) {
            count = count || 6;
            var $el = $(selector);
            $el.removeClass('my-courses-grid').addClass('my-courses-carousel');
            var html = '';
            for (var i = 0; i < count; i++) {
                html +=
                    '<div class="carousel-card">' +
                        '<div class="skeleton-card">' +
                            '<div class="skeleton" style="height:70px;"></div>' +
                            '<div style="padding:0.5rem 0.6rem;">' +
                                '<div class="skeleton skeleton-title"></div>' +
                                '<div class="skeleton skeleton-bar" style="width:60%;"></div>' +
                                '<div class="skeleton" style="height:5px;margin-bottom:4px;"></div>' +
                                '<div class="skeleton" style="height:28px;border-radius:8px;margin-top:0.4rem;"></div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
            }
            $el.html(html);
        }
    </script>
}