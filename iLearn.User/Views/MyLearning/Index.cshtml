}

@section Scripts {
    <script>
        // PLAN-102: Learner diagnostic mode flag & buffer
        const diagParams = new URLSearchParams(window.location.search);
        const LEARNER_DEBUG = diagParams.has('debug');

        window.__ilearnDiag = [];
        function safeTruncate(v, maxLen = 2000) {
            if (v === null || v === undefined) return '';
            let str = typeof v === 'string' ? v : (typeof v === 'object' ? JSON.stringify(v) : String(v));
            if (str.length > maxLen) {
                return str.substring(0, maxLen) + `... [truncated ${str.length - maxLen} chars]`;
            }
            return str;
        }
        function diag(event, data) {
            if (!LEARNER_DEBUG) return;
            const entry = { t: new Date().toISOString(), event, data };
            window.__ilearnDiag.push(entry);
            console.log(`[DIAG] ${event}`, data ?? '');
        }

        function copyDiagnosticsLog() {
            const text = JSON.stringify(window.__ilearnDiag || [], null, 2);
            navigator.clipboard.writeText(text).then(function() {
                showToast(`คัดลอก log แล้ว (${(window.__ilearnDiag || []).length} รายการ)`, "success");
            }).catch(function(err) {
                showToast("ไม่สามารถคัดลอก log ได้", "error");
            });
        }

        const learnerCode = '@empCode';
        const myCoursesUrl = '@Url.Action("GetMyCourses", "MyLearning")';
        const courseCatalogUrl = '@Url.Action("GetCourseCatalog", "MyLearning")';
        let allCoursesData = [];
        let myCoursesData = [];
        let currentFilter = 'progress';
        let selectedCategoryId = 'all';
        let selectedCourseType = 'all';
        let categorizedCourses = {};
        let catalogViewMode = 'list'; // 'list' or 'grid'

        let myCoursesExpanded = false;
        const MY_COURSES_COLLAPSED_COUNT = 10;

        const typeColorPalette = [
            'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
            'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
            'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
            'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
            'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
            'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
        ];

        function getTypeColor(index) {
            return typeColorPalette[index % typeColorPalette.length];
        }

        $(function() {
            if (LEARNER_DEBUG) {
                $(document).ajaxSend(function (e, xhr, settings) {
                    diag("ajax→", { method: settings.type, url: settings.url, body: safeTruncate(settings.data) });
                });
                $(document).ajaxComplete(function (e, xhr, settings) {
                    diag("ajax←", { url: settings.url, status: xhr.status, resp: safeTruncate(xhr.responseText) });
                });

                $('body').append(`
                    <button id="btnCopyDiag" class="btn btn-dark btn-sm shadow-sm" onclick="copyDiagnosticsLog()"
                            style="position: fixed; bottom: 16px; left: 16px; z-index: 1000; font-family: 'Sarabun', sans-serif;">
                        <i class="fas fa-copy me-1"></i> คัดลอก diagnostics
                    </button>
                `);
            }

            initSearchBox();
            initLogout();
            loadMyCourses();
            loadAllCourses();
        });
        function initLogout() {
            const logoutUrl = '@Url.Action("Logout", "Home")';
            const logoutModalEl = document.getElementById('logoutConfirmModal');
            const logoutModal = new bootstrap.Modal(logoutModalEl);

            $('#btnLogout').on('click', function (e) {
                e.preventDefault();
                logoutModal.show();
            });

            $('#btnConfirmLogout').on('click', function () {
                window.location.href = logoutUrl;
            });
        }

        // ========== Search Box ==========
        let searchDebounceTimer = null;

        function initSearchBox() {
            $("#catalogSearchInput").on("input", function () {
                const value = $(this).val();
                clearTimeout(searchDebounceTimer);
                searchDebounceTimer = setTimeout(function() {
                    filterCatalog(value);
                }, 250);
            });
        }

        // ========== Load My Courses ==========
        function loadMyCourses() {
            showSkeletonCarousel('#myCoursesContainer', 6);
            $.ajax({
                url: myCoursesUrl,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    if (handleLearnerSessionExpired(res)) return;

                    if (res.success && res.data && res.data.length > 0) {
                        myCoursesData = res.data;
                        updateStats(res.data);
                        updateMyCoursesVisibility();
                        renderCurrentMyCourses();
                    } else {
                        myCoursesData = [];
                        $('#myCoursesSection').hide();
                        $('#myCoursesStatsCol').hide();
                        $("#statEnrolled, #statCompleted").text("0");
                    }
                },
                error: function(xhr) {
                    if (handleLearnerSessionExpired(xhr)) return;

                    renderEmptyState('#myCoursesContainer', 'ไม่สามารถโหลดข้อมูลคอร์สเรียนได้');
                    showToast("ไม่สามารถโหลดข้อมูลคอร์สเรียนได้", "error");
                }
            });
        }

        function getFilteredMyCourses(type) {
            if (type === 'completed') {
                return myCoursesData.filter(e => !!e.isCompleted);
            }

            return myCoursesData.filter(e => !e.isCompleted);
        }

        function getMyCoursesEmptyMessage(type) {
            return type === 'completed'
                ? 'คุณยังไม่มีคอร์สที่เรียนจบแล้ว'
                : 'คุณยังไม่มีคอร์สที่กำลังเรียน';
        }

        function renderCurrentMyCourses() {
            const filteredData = getFilteredMyCourses(currentFilter);
            if (filteredData.length === 0) {
                renderEmptyState('#myCoursesContainer', getMyCoursesEmptyMessage(currentFilter));
                return;
            }

            renderMyCourses(filteredData);
        }

        function renderMyCourses(enrollments) {
            const $container = $("#myCoursesContainer");
            $container.empty();

            // Show toggle button when more than collapsed count
            if (enrollments.length > MY_COURSES_COLLAPSED_COUNT) {
                $('#viewToggleContainer').show();
            } else {
                $('#viewToggleContainer').hide();
            }

            // Apply collapsed/expanded mode
            const isExpanded = myCoursesExpanded;
            const displayItems = isExpanded ? enrollments : enrollments.slice(0, MY_COURSES_COLLAPSED_COUNT);

            $container.removeClass('my-courses-carousel my-courses-grid');
            $container.addClass(isExpanded ? 'my-courses-grid' : 'my-courses-carousel');

            displayItems.forEach(en => {
                const course = en.course || {};
                const progress = en.progress || 0;
                const isCompleted = !!en.isCompleted;
                const bgImage = course.coverImageUrl;

                const courseCode = en.courseCode || course.code || '-';
                const courseTypeName = en.courseTypeName || '';
                const statusClass = isCompleted ? 'completed' : (progress > 0 ? 'in-progress' : 'not-started');

                const dueDate = formatDueDate(en.dueDate);

                const typeBadgeHtml = courseTypeName
                    ? `<span class="category-badge">${courseTypeName}</span>`
                    : '';

                const playerUrl = `@Url.Action("Player", "MyLearning")?courseId=${en.courseId}`;

                const $card = $("<a>")
                    .addClass('carousel-card course-item')
                    .attr({ href: playerUrl, 'data-status': statusClass })
                    .html(`
                        <div class="my-course-card">
                            <div class="course-thumb${bgImage ? '' : ' no-image'}">
                                 ${bgImage ? `<img src="${bgImage}" alt="${en.courseTitle}" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-image')">` : ''}

                                <div class="course-code-overlay">
                                    <div class="course-code-text">
                                      <div>${courseCode}</div>
                                    </div>
                                 </div>

                                ${isCompleted ? '<span class="badge bg-brand position-absolute top-0 end-0 m-2" style="z-index: 3;"><i class="fas fa-check-circle me-1"></i>เรียนจบ</span>' : ''}
                            </div>
                            <div class="course-body">
                                <h6 class="course-title" title="${en.courseTitle}">${en.courseTitle}</h6>

                                <div class="progress-section">
                                    <div class="due-date-row mb-2">
                                        <span class="d-flex align-items-center">
                                            <i class="far fa-calendar-alt text-muted me-1"></i>
                                            <span class="text-muted small">กำหนด: ${dueDate}</span>
                                        </span>
                                        ${typeBadgeHtml}
                                    </div>

                                    <div class="progress-info">
                                        <div class="progress-wrapper-inline">
                                            <div class="progress-fill" style="width: ${progress}%;"></div>
                                        </div>
                                         <span class="text-primary fw-bold">${Math.round(progress)}%</span>
                                    </div>

                                    <span class="btn btn-outline-primary w-100 btn-continue">
                                        ${isCompleted ? 'ทบทวน' : (progress > 0 ? 'เรียนต่อ' : 'เริ่มเรียน')} <i class="fas fa-arrow-right ms-1 small js-card-action-icon"></i>
                                    </span>
                                </div>
                             </div>
                        </div>
                    `);
                $container.append($card);
            });
        }

        function formatDueDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            return `${day}/${month}/${year}`;
        }

        function updateStats(data) {
            const completed = data.filter(e => !!e.isCompleted).length;
            const inProgress = data.length - completed;
            $("#statEnrolled").text(inProgress);
            $("#statCompleted").text(completed);
        }

        // ========== Toggle My Courses View ==========
        function toggleMyCoursesView() {
            myCoursesExpanded = !myCoursesExpanded;
            const $btn = $('#btnViewToggle');
            if (myCoursesExpanded) {
                $btn.html('<i class="fas fa-arrow-left me-1"></i> ย่อส่วน');
            } else {
                $btn.html('<i class="fas fa-th-large me-1"></i> ดูทั้งหมด');
            }
            // Re-render with current filter
            renderCurrentMyCourses();
        }

        // ========== Visibility: hide section/tabs with no data ==========
        function updateMyCoursesVisibility() {
            const hasProgress = myCoursesData.some(e => !e.isCompleted);
            const hasCompleted = myCoursesData.some(e => !!e.isCompleted);

            // Show/hide the whole section
            if (!hasProgress && !hasCompleted) {
                $('#myCoursesSection').hide();
                $('#myCoursesStatsCol').hide();
                return;
            }
            $('#myCoursesSection').show();
            $('#myCoursesStatsCol').show();

            // Show/hide individual tab pills
            const $progressTab = $('#pills-tab .nav-link[data-filter="progress"]').closest('.nav-item');
            const $completedTab = $('#pills-tab .nav-link[data-filter="completed"]').closest('.nav-item');
            $progressTab.toggle(hasProgress);
            $completedTab.toggle(hasCompleted);

            // Auto-select a visible tab if current is hidden
            if (currentFilter === 'progress' && !hasProgress) {
                currentFilter = 'completed';
            } else if (currentFilter === 'completed' && !hasCompleted) {
                currentFilter = 'progress';
            }
            $('#pills-tab .nav-link').removeClass('active');
            $(`#pills-tab .nav-link[data-filter="${currentFilter}"]`).addClass('active');
        }

        // ========== Filter My Courses ==========
        function filterMyCourses(type) {
            currentFilter = type;
            $('#pills-tab .nav-link').removeClass('active');
            $(`#pills-tab .nav-link[data-filter="${type}"]`).addClass('active');
            renderCurrentMyCourses();
        }

        // ========== Render Type Filter Pills ==========
        function getCatalogBaseCourses(categoryId) {
            return categoryId === 'all'
                ? allCoursesData
                : (categorizedCourses[categoryId]?.courses || []);
        }

        function getCourseTypeId(course) {
            const typeId = course.courseTypeId ?? course.CourseTypeId;
            return typeId === null || typeId === undefined || typeId === '' ? null : String(typeId);
        }

        function getCatalogTypeName(course) {
            return course.courseTypeName || course.typeName || 'ไม่ระบุประเภท';
        }

        function getAvailableCatalogTypes(categoryId) {
            const typeMap = new Map();
            getCatalogBaseCourses(categoryId).forEach(course => {
                const typeId = getCourseTypeId(course);
                if (!typeId) return;

                if (!typeMap.has(typeId)) {
                    typeMap.set(typeId, {
                        id: typeId,
                        name: getCatalogTypeName(course),
                        count: 0
                    });
                }

                typeMap.get(typeId).count++;
            });

            return Array.from(typeMap.values())
                .sort((a, b) => a.name.localeCompare(b.name, 'th'));
        }

        function renderTypeFilterPills(categoryId) {
            const $filter = $('#catalog-type-filter');
            const baseCourses = getCatalogBaseCourses(categoryId);
            const availableTypes = getAvailableCatalogTypes(categoryId);
            const hasSelectedType = selectedCourseType === 'all' || availableTypes.some(type => String(type.id) === String(selectedCourseType));

            if (!hasSelectedType) {
                selectedCourseType = 'all';
            }

            $filter.empty();
            $filter.append(`
                <li class="nav-item">
                    <button type="button" class="nav-link ${selectedCourseType === 'all' ? 'active' : ''}" data-type="all" onclick="filterCatalogByType(this.dataset.type)">
                        <i class="fas fa-th-large me-1 small"></i> ทั้งหมด
                        <span class="catalog-filter-count">${baseCourses.length}</span>
                    </button>
                </li>
            `);

            availableTypes.forEach(function(type) {
                $filter.append(`
                    <li class="nav-item">
                        <button type="button" class="nav-link ${String(selectedCourseType) === String(type.id) ? 'active' : ''}" data-type="${type.id}" onclick="filterCatalogByType(this.dataset.type)">
                            <i class="fas fa-tag me-1 small"></i> ${type.name}
                            <span class="catalog-filter-count">${type.count}</span>
                        </button>
                    </li>
                `);
            });
        }

        // ========== Load Catalog ==========
        function loadAllCourses() {
            $("#catalogLayout").show();
            showSkeletonList('#catalogCourseList', 6);
            $.ajax({
                url: courseCatalogUrl,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    if (handleLearnerSessionExpired(res)) return;

                    allCoursesData = res.data || (Array.isArray(res) ? res : []);

                    if (allCoursesData.length > 0) {
                        organizeCoursesByCategory(allCoursesData);
                        renderCategorySidebar();
                        renderTypeFilterPills(selectedCategoryId);
                        renderCatalogContent('all');
                    } else {
                        renderTypeFilterPills(selectedCategoryId);
                        renderEmptyState('#catalogCourseList', 'ยังไม่มีหลักสูตรในขณะนี้');
                    }
                },
                error: function(xhr) {
                    if (handleLearnerSessionExpired(xhr)) return;

                    renderTypeFilterPills(selectedCategoryId);
                    renderEmptyState('#catalogCourseList', 'ไม่สามารถโหลดข้อมูลหลักสูตรได้');
                    showToast("ไม่สามารถโหลดข้อมูลหลักสูตรได้", "error");
                }
            });
        }

        // ========== Organize by Category ==========
        function organizeCoursesByCategory(courses) {
            categorizedCourses = { 'all': courses };
            courses.forEach(course => {
                const catId = course.categoryId;
                const catName = course.categoryName || 'ไม่ระบุหมวดหมู่';

                if (!categorizedCourses[catId]) {
                    categorizedCourses[catId] = {
                        id: catId,
                        name: catName,
                        sortOrder: course.categorySortOrder ?? 0,
                        courses: []
                    };
                }
                categorizedCourses[catId].courses.push(course);
            });
        }

        // ========== Render Category Sidebar ==========
        function renderCategorySidebar() {
            const $menu = $("#categoryMenu");
            $menu.empty();

            // All Categories
            $menu.append(`
                <div class="category-menu-item active" data-category="all">
                    <span class="category-name">
                        <i class="fas fa-th-large me-2"></i>ทั้งหมด
                    </span>
                    <span class="course-count">${allCoursesData.length}</span>
                </div>
            `);
            // Individual Categories — เรียงตาม (sortOrder, id) เพื่อสะท้อนลำดับที่ admin ตั้งไว้
            Object.values(categorizedCourses)
                .filter(cat => cat.id !== undefined && String(cat.id) !== 'all')
                .sort((a, b) => (a.sortOrder - b.sortOrder) || (a.id - b.id))
                .forEach(cat => {
                    const categoryLabel = cat.sortOrder > 0 ? `${cat.sortOrder}. ${cat.name}` : cat.name;
                    $menu.append(`
                        <div class="category-menu-item" data-category="${cat.id}">
                            <span class="category-name">
                                <i class="fas fa-folder me-2"></i>${categoryLabel}
                            </span>
                            <span class="course-count">${cat.courses.length}</span>
                        </div>
                    `);
                });
            // Click Event
            $menu.off('click.category').on('click.category', '.category-menu-item', function() {
                const categoryId = $(this).data('category');
                selectedCategoryId = categoryId;

                $('.category-menu-item').removeClass('active');
                $(this).addClass('active');

                renderCatalogContent(categoryId);
            });
        }

        // ========== Filter Catalog by Course Type ==========
        function filterCatalogByType(type) {
            selectedCourseType = type;
            renderCatalogContent(selectedCategoryId);
        }

        // ========== Set Catalog View Mode ==========
        function setCatalogView(mode) {
            catalogViewMode = mode;
            $('#btnListView, #btnGridView').removeClass('active');
            if (mode === 'list') {
                $('#btnListView').addClass('active');
            } else {
                $('#btnGridView').addClass('active');
            }
            renderCatalogContent(selectedCategoryId);
        }

        // ========== Render Catalog Content ==========
        function renderCatalogContent(categoryId) {
            const $courseList = $("#catalogCourseList");
            $courseList.empty();
            renderTypeFilterPills(categoryId);

            let coursesToShow = getCatalogBaseCourses(categoryId);

            // Apply Course Type Filter
            if (selectedCourseType !== 'all') {
                coursesToShow = coursesToShow.filter(c => getCourseTypeId(c) === String(selectedCourseType));
            }

            if (coursesToShow.length === 0) {
                renderEmptyState('#catalogCourseList', 'ไม่พบหลักสูตรในหมวดหมู่นี้');
                return;
            }

            if (catalogViewMode === 'list') {
                const $list = $('<div class="catalog-list-container"></div>');
                coursesToShow.forEach(course => {
                    $list.append(renderCatalogListItem(course));
                });
                $courseList.append($list);
            } else {
                const $grid = $('<div class="row g-3"></div>');
                coursesToShow.forEach(course => {
                    $grid.append(renderCatalogCard(course));
                });
                $courseList.append($grid);
            }
        }

        // ========== Render Single Catalog Card (Grid) ==========
        function renderCatalogCard(course) {
            const bgImage = course.coverImageUrl;
            const courseCode = course.code || '-';
            const playerUrl = `@Url.Action("Player", "MyLearning")?courseId=${course.id}`;

            return $(`
                <a href="${playerUrl}" class="col-md-6 col-lg-4 col-xl-3 catalog-course-item">
                    <div class="my-course-card">
                        <div class="course-thumb${bgImage ? '' : ' no-image'}">
                            ${bgImage ? `<img src="${bgImage}" alt="${course.title}" loading="lazy" onerror="this.style.display='none';this.parentElement.classList.add('no-image')">` : ''}
                            <div class="course-code-overlay">
                                <div class="course-code-text">${courseCode}</div>
                            </div>
                        </div>
                        <div class="course-body">
                            <h6 class="course-title" title="${course.title}">${course.title}</h6>

                            <div class="progress-section">
                                <span class="btn btn-outline-primary w-100 btn-continue">
                                    <i class="fas fa-eye me-1 js-card-action-icon"></i> ดูเนื้อหา
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            `);
        }

        // ========== Render Single Catalog List Item ==========
        function renderCatalogListItem(course) {
            const courseCode = course.code || '-';
            const playerUrl = `@Url.Action("Player", "MyLearning")?courseId=${course.id}`;

            return $(`
                <a href="${playerUrl}" class="catalog-list-item catalog-course-item">
                    <div class="list-code-badge">${courseCode}</div>
                    <div class="list-info">
                        <div class="list-title course-title" title="${course.title}">${course.title}</div>
                    </div>
                    <div class="list-action">
                        <span class="btn btn-outline-primary btn-list-view">
                            <i class="fas fa-eye me-1 js-card-action-icon"></i> ดูเนื้อหา
                        </span>
                    </div>
                </a>
            `);
        }

        // ========== Filter Catalog (Search) ==========
        function filterCatalog(searchText) {
            const $items = $(".catalog-course-item");
            if (!searchText || searchText.trim() === '') {
                $items.show();
                removeHighlights();
                return;
            }

            removeHighlights();
            const lowerSearch = searchText.toLowerCase();
            $items.each(function() {
                const $item = $(this);
                const title = $item.find('.course-title').text().toLowerCase();
                const code = $item.find('.course-code-text, .list-code-badge').text().toLowerCase();

                if (title.includes(lowerSearch) || code.includes(lowerSearch)) {
                    $item.show();
                    highlightText($item, searchText);
                } else {
                    $item.hide();
                }
            });
        }

        // ========== Highlight Search Text ==========
        function highlightText($item, searchText) {
            const $title = $item.find('.course-title');
            const $code = $item.find('.course-code-text, .list-code-badge');

            const titleHtml = $title.html();
            const codeHtml = $code.html();
            const regex = new RegExp(`(${escapeRegex(searchText)})`, 'gi');

            $title.html(titleHtml.replace(regex, '<span class="search-highlight">$1</span>'));
            $code.html(codeHtml.replace(regex, '<span class="search-highlight">$1</span>'));
        }

        function removeHighlights() {
            $('.search-highlight').each(function() {
                $(this).replaceWith($(this).text());
            });
        }

        function escapeRegex(str) {
            return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // ========== Empty State Helper ==========
        function renderEmptyState(selector, message) {
            $(selector).html(
                '<div class="col-12">' +
                    '<div class="d-flex flex-column align-items-center justify-content-center py-4 text-center">' +
                        '<i class="fas fa-inbox fa-2x mb-2 empty-state-icon"></i>' +
                        '<p class="text-muted mb-0 small">' + message + '</p>' +
                    '</div>' +
                '</div>'
            );
        }

        // ========== Skeleton Carousel Helper ==========
        function showSkeletonCarousel(selector, count) {
            count = count || 6;
            var $el = $(selector);
            $el.removeClass('my-courses-grid').addClass('my-courses-carousel');
            var html = '';
            for (var i = 0; i < count; i++) {
                html +=
                    '<div class="carousel-card">' +
                        '<div class="skeleton-card">' +
                            '<div class="skeleton skeleton-thumb--sm"></div>' +
                            '<div class="skeleton-body--sm">' +
                                '<div class="skeleton skeleton-title"></div>' +
                                '<div class="skeleton skeleton-bar short" style="height:8px;margin-bottom:8px;"></div>' +
                                '<div class="skeleton skeleton-progress--sm"></div>' +
                                '<div class="skeleton skeleton-btn--sm"></div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
            }
            $el.html(html);
        }

        function showSkeletonList(selector, count) {
            count = count || 6;
            var html = '<div class="catalog-list-container">';
            for (var i = 0; i < count; i++) {
                html +=
                    '<div class="catalog-list-item" style="pointer-events:none;">' +
                        '<div class="skeleton" style="width:70px;height:26px;border-radius:4px;flex-shrink:0;"></div>' +
                        '<div style="flex:1;min-width:0;">' +
                            '<div class="skeleton" style="height:14px;width:' + (50 + Math.floor(Math.random() * 35)) + '%;border-radius:4px;"></div>' +
                        '</div>' +
                        '<div class="skeleton" style="width:90px;height:32px;border-radius:4px;flex-shrink:0;"></div>' +
                    '</div>';
            }
            html += '</div>';
            $(selector).html(html);
        }
    </script>
}