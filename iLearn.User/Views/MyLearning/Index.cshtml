@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var empName = User.Identity?.Name ?? "Guest";
    var empCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "-";
    var dept = User.FindFirst("Department")?.Value ?? "-";
    var div = User.FindFirst("Division")?.Value ?? "-";
}

@section Styles {
    <style>

        .text-brand {
            color: var(--brand-color) !important;
        }

        .bg-brand {
            background-color: var(--brand-color) !important;
        }

        .border-brand {
            border-color: var(--brand-color) !important;
        }

        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: var(--space-5) 0;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: var(--space-6);
        }

        .page-title {
            font-weight: 600;
            font-size: var(--text-lg);
            color: #2c3e50;
            letter-spacing: -0.5px;
        }

        /* --- Modern Tabs (Filter) --- */
        .nav-pills {
            gap: var(--space-2);
        }

            .nav-pills .nav-link {
                color: #6c757d;
                font-weight: 600;
                border-radius: var(--radius-md);
                padding: var(--space-2) var(--space-5);
                transition: all 0.2s ease;
                background-color: #f8f9fa;
                border: 1px solid transparent;
                cursor: pointer;
            }

                .nav-pills .nav-link:hover {
                    background-color: #e9ecef;
                    color: var(--brand-color);
                }

                .nav-pills .nav-link.active {
                    background-color: rgba(2, 125, 131, 0.1);
                    color: var(--brand-color);
                    border-color: rgba(2, 125, 131, 0.2);
                }

        /* --- Course Card (New Design) --- */
        .my-course-card {
            border: none;
            border-radius: var(--radius-md);
            background: white;
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .my-course-card:hover {
                box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            }

        /* ========== Horizontal Scroll Carousel (My Courses) ========== */
        .my-courses-carousel {
            display: flex;
            gap: var(--space-4);
            overflow-x: auto;
            overflow-y: hidden;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            padding-bottom: var(--space-2);
            scrollbar-width: thin;
            scrollbar-color: rgba(2,125,131,0.3) transparent;
        }

        .my-courses-carousel::-webkit-scrollbar {
            height: 6px;
        }

        .my-courses-carousel::-webkit-scrollbar-thumb {
            background: rgba(2,125,131,0.3);
            border-radius: 3px;
        }

        .my-courses-carousel::-webkit-scrollbar-track {
            background: transparent;
        }

        .my-courses-carousel .carousel-card {
            flex: 0 0 220px;
            max-width: 220px;
            scroll-snap-align: start;
        }

        /* Expanded grid mode (toggle) */
        .my-courses-grid {
            display: flex;
            flex-wrap: wrap;
            gap: var(--space-4);
        }

        .my-courses-grid .carousel-card {
            flex: 0 0 calc(16.666% - 0.85rem);
            max-width: calc(16.666% - 0.85rem);
        }

        @@media (max-width: 1399px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(20% - 0.8rem);
                max-width: calc(20% - 0.8rem);
            }
        }

        @@media (max-width: 1199px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(25% - 0.75rem);
                max-width: calc(25% - 0.75rem);
            }
        }

        @@media (max-width: 991px) {
            .my-courses-grid .carousel-card {
                flex: 0 0 calc(33.333% - 0.67rem);
                max-width: calc(33.333% - 0.67rem);
            }
        }

        @@media (max-width: 767px) {
            .my-courses-grid .carousel-card,
            .my-courses-carousel .carousel-card {
                flex: 0 0 180px;
                max-width: 180px;
            }
        }

        /* Compact card overrides for My Courses carousel */
        .my-courses-carousel .course-thumb,
        .my-courses-grid .course-thumb {
            height: 70px;
        }

        .my-courses-carousel .course-code-text,
        .my-courses-grid .course-code-text {
            font-size: var(--text-xs);
        }

        .my-courses-carousel .course-body,
        .my-courses-grid .course-body {
            padding: var(--space-2) var(--space-3);
        }

        .my-courses-carousel .course-title,
        .my-courses-grid .course-title {
            font-size: 0.78rem;
            line-height: 1.35;
            margin-bottom: var(--space-1);
            -webkit-line-clamp: 2;
        }

        .my-courses-carousel .progress-section,
        .my-courses-grid .progress-section {
            padding-top: var(--space-2);
        }

        .my-courses-carousel .due-date-row,
        .my-courses-grid .due-date-row {
            font-size: 0.7rem;
        }

        .my-courses-carousel .progress-wrapper-inline,
        .my-courses-grid .progress-wrapper-inline {
            height: 5px;
        }

        .my-courses-carousel .progress-info,
        .my-courses-grid .progress-info {
            margin-bottom: var(--space-2);
        }

        .my-courses-carousel .progress-info .text-primary,
        .my-courses-grid .progress-info .text-primary {
            font-size: var(--text-xs);
        }

        .my-courses-carousel .btn-continue,
        .my-courses-grid .btn-continue {
            font-size: 0.7rem;
            padding: var(--space-1) var(--space-2);
            margin-top: var(--space-1);
        }

        .my-courses-carousel .category-badge,
        .my-courses-grid .category-badge {
            font-size: 0.6rem;
            padding: var(--space-1) var(--space-2);
        }

        /* Toggle button */
        .btn-view-toggle {
            color: var(--brand-color);
            font-weight: 600;
            font-size: var(--text-sm);
            cursor: pointer;
            border: none;
            background: none;
            transition: all 0.2s;
        }

        .btn-view-toggle:hover {
            text-decoration: underline;
        }

        .course-thumb {
            height: 130px;
            background-color: #eee;
            position: relative;
            overflow: hidden;
        }

            .course-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        /* Course Code Overlay */
        .course-code-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: var(--space-4);
            z-index: 2;
        }

        .course-code-text {
            color: white;
            font-weight: 700;
            font-size: var(--text-base);
            text-align: center;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
            line-height: 1.4;
            word-break: break-word;
        }

        .course-type-label {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 0.7rem;
            font-weight: 600;
            padding: var(--space-1) var(--space-3);
            border-radius: var(--radius-lg);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            border: 1px solid rgba(255, 255, 255, 0.3);
            margin-bottom: var(--space-1);
            text-shadow: 0 1px 2px rgba(0,0,0,0.3);
        }

        /* ซ่อน Play Overlay และ Play Icon */
        .course-overlay {
            display: none !important;
        }

        .play-icon {
            display: none !important;
        }

        /* Card Body */
        .course-body {
            padding: var(--space-3) var(--space-4);
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--dx-color-border);
            border-radius: 0 0 var(--radius-md) var(--radius-md);
        }

        .course-title {
            font-weight: 600;
            font-size: var(--text-sm);
            line-height: 1.5;
            margin-bottom: var(--space-2);
            color: #2c3e50;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Progress Section */
        .progress-section {
            margin-top: auto;
            padding-top: var(--space-4);
            border-top: 1px solid #f8f9fa;
        }

        /* DueDate Row */
        .due-date-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: var(--text-sm);
        }

        .due-date-row .category-badge {
            font-size: 0.7rem;
            padding: 0.1rem 0.5rem;
        }

        /* Progress Info */
        .progress-info {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            margin-bottom: var(--space-3);
        }

        .progress-wrapper-inline {
            flex: 1;
            height: 8px;
            background-color: #ecf0f1;
            border-radius: var(--radius-sm);
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--brand-color);
            border-radius: var(--radius-sm);
            transition: width 1s ease-in-out;
        }

        .btn-continue {
            margin-top: var(--space-2);
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: var(--text-xs);
            padding: var(--space-2) var(--space-3);
            transition: all 0.2s;
        }

        /* ========== Compact Catalog Cards (Grid Mode) ========== */
        .catalog-content .course-thumb {
            height: 130px;
        }

        .catalog-content .course-code-text {
            font-size: var(--text-base);
        }

        .catalog-content .course-body {
            padding: var(--space-3);
        }

        .catalog-content .course-title {
            font-size: var(--text-sm);
            line-height: 1.45;
            margin-bottom: var(--space-2);
        }

        .catalog-content .btn-continue {
            font-size: var(--text-xs);
            padding: var(--space-2) var(--space-3);
        }

        .catalog-content .progress-section {
            padding-top: var(--space-2);
        }

        /* ========== Catalog List View ========== */
        .catalog-list-item {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-2) var(--space-3);
            background: white;
            border: 1px solid #f0f0f0;
            border-radius: var(--radius-sm);
            margin-bottom: var(--space-2);
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .catalog-list-item:hover {
            border-color: rgba(2, 125, 131, 0.3);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .catalog-list-item .list-code-badge {
            flex-shrink: 0;
            background: var(--brand-color);
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: var(--space-1) var(--space-2);
            border-radius: var(--radius-sm);
            white-space: nowrap;
            letter-spacing: 0.3px;
            min-width: 70px;
            text-align: center;
        }

        .catalog-list-item .list-info {
            flex: 1;
            min-width: 0;
        }

        .catalog-list-item .list-title {
            font-weight: 600;
            font-size: var(--text-sm);
            color: #2c3e50;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .catalog-list-item .list-action {
            flex-shrink: 0;
        }

        .catalog-list-item .btn-list-view {
            font-size: var(--text-xs);
            font-weight: 600;
            padding: var(--space-2) var(--space-3);
            border-radius: var(--radius-sm);
            white-space: nowrap;
        }

        /* ========== Whole-card clickable anchors (PLAN-108 §2a/2b) ========== */
        a.course-item,
        a.catalog-course-item {
            text-decoration: none;
            color: inherit;
        }

        /* PLAN-108 Fix 4: `.catalog-list-item` must stay `display: flex` (its own
           rule above) for the badge/title/button row layout. A bare
           `a.catalog-course-item { display: block }` would win that fight —
           class+class beats class+class only by source order, and
           `.catalog-list-item` is declared first — so explicitly exclude it
           here instead of relying on declaration order. */
        a.catalog-course-item:not(.catalog-list-item) {
            display: block;
        }

        a.course-item:focus-visible,
        a.catalog-course-item:focus-visible,
        .catalog-list-item:focus-visible {
            outline: 2px solid var(--brand-color);
            outline-offset: 2px;
        }

        a.course-item:active .my-course-card,
        a.catalog-course-item:active .my-course-card {
            transform: scale(0.99);
        }

        .catalog-list-item:active {
            transform: scale(0.99);
        }

        /* ========== Catalog View Toggle ========== */
        .catalog-view-toggle {
            display: inline-flex;
            border: 1px solid #e0e0e0;
            border-radius: var(--radius-sm);
            overflow: hidden;
        }

        .catalog-view-toggle .toggle-btn {
            border: none;
            background: white;
            padding: var(--space-2) var(--space-3);
            font-size: var(--text-xs);
            color: #999;
            cursor: pointer;
            transition: all 0.15s;
            line-height: 1;
        }

        .catalog-view-toggle .toggle-btn:not(:last-child) {
            border-right: 1px solid #e0e0e0;
        }

        .catalog-view-toggle .toggle-btn.active {
            background: var(--brand-color);
            color: white;
        }

        .catalog-view-toggle .toggle-btn:hover:not(.active) {
            background: #f5f5f5;
            color: #555;
        }

        .catalog-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: var(--space-3);
            min-width: 0;
            flex: 1 1 auto;
        }

        .catalog-type-filter-wrap {
            flex: 1 1 420px;
            min-width: 0;
            max-width: min(760px, 100%);
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(2,125,131,0.28) transparent;
            padding-bottom: 0.15rem;
        }

        .catalog-type-filter-wrap::-webkit-scrollbar {
            height: 5px;
        }

        .catalog-type-filter-wrap::-webkit-scrollbar-thumb {
            background: rgba(2,125,131,0.28);
            border-radius: 3px;
        }

        .catalog-type-filter-wrap .nav-pills {
            flex-wrap: nowrap;
            width: max-content;
            min-width: 100%;
        }

        .catalog-type-filter-wrap .nav-link {
            white-space: nowrap;
            padding: var(--space-2) var(--space-4);
        }

        .catalog-filter-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.35rem;
            height: 1.35rem;
            margin-left: 0.35rem;
            padding: 0 0.35rem;
            border-radius: 999px;
            background: rgba(2, 125, 131, 0.1);
            color: var(--brand-color);
            font-size: 0.7rem;
            font-weight: 700;
        }

        .nav-pills .nav-link.active .catalog-filter-count {
            background: var(--brand-color);
            color: #fff;
        }

        .catalog-actions {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            flex: 0 0 auto;
        }

        /* ========== Catalog Search Box (PLAN-108: native replacement for dxTextBox) ========== */
        .app-search-box {
            position: relative;
            width: 300px;
            max-width: 100%;
        }

        .app-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 0.8rem;
            pointer-events: none;
        }

        .app-search-input {
            width: 100%;
            height: 34px;
            padding: 0 10px 0 32px;
            border: 1px solid #d9d9d9;
            border-radius: var(--radius-sm);
            font-size: var(--text-sm);
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .app-search-input:focus {
            border-color: var(--brand-color);
            box-shadow: 0 0 0 0.2rem rgba(2, 125, 131, 0.25);
        }

        /* Profile Stats */
        .stat-box {
            background: white;
            border-radius: var(--radius-md);
            padding: var(--space-5);
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: var(--space-1);
        }

        .stat-label {
            color: #7f8c8d;
            font-size: var(--text-sm);
        }

        /* Catalog Section */
        .catalog-section {
            background: white;
            border-radius: var(--radius-md);
            padding: var(--space-6);
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            min-height: 400px;
        }

        .category-badge {
            background: rgba(2, 125, 131, 0.1);
            color: var(--brand-color);
            padding: 0.25rem 0.75rem;
            border-radius: var(--radius-pill);
            font-size: var(--text-sm);
            font-weight: 600;
        }

        /* ========== Category Sidebar ========== */
        .catalog-layout {
            display: flex;
            gap: var(--space-6);
        }

        .category-sidebar {
            flex: 0 0 280px;
            height: fit-content;
            position: sticky;
            top: var(--space-5);
        }

            .category-sidebar h5 {
                font-size: 1rem;
                font-weight: 700;
                color: #2c3e50;
                margin-bottom: var(--space-4);
                padding-bottom: var(--space-3);
                border-bottom: 2px solid var(--brand-color);
            }

        .category-menu-item {
            padding: var(--space-3) var(--space-4);
            margin-bottom: var(--space-2);
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8f9fa;
            border: 1px solid transparent;
        }

            .category-menu-item:hover {
                background: rgba(2, 125, 131, 0.05);
                border-color: rgba(2, 125, 131, 0.2);
            }

            .category-menu-item.active {
                background: rgba(2, 125, 131, 0.1);
                border-color: var(--brand-color);
                color: var(--brand-color);
                font-weight: 600;
            }

            .category-menu-item .category-name {
                flex: 1;
                font-size: var(--text-sm);
            }

            .category-menu-item .course-count {
                background: white;
                padding: var(--space-1) var(--space-2);
                border-radius: var(--radius-pill);
                font-size: var(--text-xs);
                font-weight: 600;
                color: #6c757d;
            }

            .category-menu-item.active .course-count {
                background: var(--brand-color);
                color: white;
            }

        .catalog-content {
            flex: 1;
            min-width: 0;
        }

        /* ========== Course Type Section ========== */
        .course-type-section {
            margin-bottom: var(--space-5);
        }

        .course-type-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            margin-bottom: var(--space-4);
            padding-bottom: var(--space-3);
            border-bottom: 1px solid #f0f0f0;
        }

        .type-badge {
            padding: var(--space-2) var(--space-4);
            border-radius: var(--radius-sm);
            font-size: var(--text-sm);
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: var(--space-2);
            color: white;
        }

        /* ========== Search Highlight ========== */
        .search-highlight {
            background-color: yellow;
            font-weight: bold;
            padding: 0 2px;
            border-radius: 2px;
        }

        /* ========== Responsive ========== */
        @@media (max-width: 991px) {
            .catalog-layout {
                flex-direction: column;
            }

            .category-sidebar {
                flex: 1;
                position: relative;
                top: 0;
            }

            .catalog-toolbar {
                width: 100%;
                flex-wrap: wrap;
                justify-content: flex-start;
            }

            .catalog-type-filter-wrap {
                flex-basis: 100%;
                max-width: 100%;
            }

            .catalog-actions {
                width: 100%;
                flex-wrap: wrap;
            }

            #searchBoxContainer {
                flex: 1 1 240px;
            }
        }

        /* --- Profile Page Headers & Custom Elements --- */
        .profile-avatar {
            width: 90px;
            height: 90px;
            background-color: var(--brand-color);
            border-radius: 50%;
        }

        .profile-avatar-icon {
            font-size: 2.5rem;
            color: #fff;
        }

        .btn-logout {
            border: 1.5px solid var(--brand-color);
            color: var(--brand-color);
            border-radius: var(--radius-md);
            padding: 0.4rem 1rem;
            font-weight: 600;
            font-size: var(--text-sm);
            background: transparent;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            background-color: var(--brand-light);
            color: var(--brand-dark);
            border-color: var(--brand-dark);
        }

        .empty-state-icon {
            color: #d0d0d0;
        }

        /* --- C2: Course image fallback --- */
        .course-thumb.no-image {
            background: linear-gradient(135deg, var(--brand-color) 0%, var(--brand-dark) 100%);
        }

        /* --- C3: :active touch feedback --- */
        .category-menu-item:active,
        .toggle-btn:active {
            transform: scale(0.97);
        }

        @@media (pointer: coarse) {
            .catalog-view-toggle .toggle-btn {
                padding: var(--space-3) var(--space-4);
                min-width: 44px;
                min-height: 44px;
            }
        }

        /* --- Logout Dialog --- */
        .logout-dialog-icon {
            font-size: 2.5rem;
            color: var(--brand-color);
            margin-bottom: var(--space-3);
        }

        .logout-dialog-title {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: var(--space-2);
        }

        .logout-dialog-text {
            color: #7f8c8d;
            font-size: var(--text-sm);
            margin-bottom: 0;
        }
    </style>
}

@if (!isAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">กรุณาเข้าสู่ระบบ</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">เข้าสู่ระบบ</a>
        </div>
    </div>
}
