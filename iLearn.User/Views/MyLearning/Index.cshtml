@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;

    var empName = User.Identity?.Name ?? "Guest";
    var empCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "-";
    var dept = User.FindFirst("Department")?.Value ?? "-";

    var profileImage = "https://ui-avatars.com/api/?name=" + empName + "&background=027d83&color=fff&size=128";
}

@section Styles {
    <style>
        :root {
            --brand-color: #027d83;
        }

        body {
            background-color: #f8f9fa;
        }

        .text-brand {
            color: var(--brand-color) !important;
        }

        .bg-brand {
            background-color: var(--brand-color) !important;
        }

        .border-brand {
            border-color: var(--brand-color) !important;
        }

        /* Hover Effect for Cards */
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(2, 125, 131, 0.15) !important;
            transition: all 0.2s ease;
        }

        /* Course Cover */
        .course-cover {
            height: 160px;
            background-size: cover;
            background-position: center;
            background-color: #e9ecef;
        }
    </style>
}

@if (!isAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">กรุณาเข้าสู่ระบบ</h4>
            <a href="/Home/Index" class="btn btn-primary mt-3">เข้าสู่ระบบ</a>
        </div>
    </div>
}
else
{
    <div class="container py-4">

        <!-- ========== Profile Card ========== -->
        <div id="profileCard" class="mb-4"></div>

        <!-- ========== My Courses Section ========== -->
        <div  class="dx-card p-4 shadow-sm mb-4">
            <div class="d-flex align-items-center mb-3 pb-2">
                <i class="fas fa-book-reader text-brand me-2 fs-5"></i>
                <h5 class="fw-bold mb-0">คอร์สเรียนของฉัน</h5>
            </div>
            <div id="myCoursesLoading" class="text-center py-5">
                <div class="spinner-border text-brand"></div>
            </div>
            <div id="myCoursesContainer" class="row g-3"></div>
        </div>

        <!-- ========== Course Catalog Section ========== -->
        <div class="dx-card p-4 shadow-sm mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2">
                <div class="d-flex align-items-center">
                    <i class="fas fa-graduation-cap text-secondary me-2 fs-5"></i>
                    <h5 class="fw-bold mb-0">คลังหลักสูตรทั้งหมด</h5>
                </div>
                <div id="searchBoxContainer"></div>
            </div>
            <div id="allCoursesLoading" class="text-center py-5">
                <div class="spinner-border text-brand"></div>
            </div>
            <div id="catalogContainer"></div>
        </div>

    </div>
}

@section Scripts {
    <script>
        const studentCode = '@empCode';
        const baseUrl = (typeof serviceUrl !== 'undefined') ? serviceUrl : '';
        let allCoursesData = [];

        $(function() {
            initProfileCard();
            initSearchBox();
            loadMyCourses();
            loadAllCourses();
        });

        // ========== Profile Card (DevExtreme) ==========
        function initProfileCard() {
            const profileContent = $("<div>").addClass("d-flex align-items-center flex-wrap gap-4").append(
                // Avatar
                $("<img>").attr({
                    src: '@profileImage',
                    width: 90,
                    height: 90,
                    alt: 'Profile'
                }).addClass("rounded-circle shadow-sm"),

                // Info
                $("<div>").addClass("flex-grow-1").append(
                    $("<h4>").addClass("fw-bold mb-1").text('@empName'),
                    $("<div>").addClass("text-muted small").html(`
                        <i class="fas fa-id-card text-brand me-1"></i> @empCode
                        <span class="mx-2">|</span>
                        <i class="fas fa-building text-brand me-1"></i> @dept
                    `)
                ),

                // Stats
                $("<div>").addClass("d-flex gap-4 border-start ps-4").append(
                    $("<div>").addClass("text-center").append(
                        $("<h3>").addClass("fw-bold text-brand mb-0").attr("id", "statEnrolled").text("-"),
                        $("<small>").addClass("text-muted").text("กำลังเรียน")
                    ),
                    $("<div>").addClass("text-center").append(
                        $("<h3>").addClass("fw-bold text-success mb-0").attr("id", "statCompleted").text("-"),
                        $("<small>").addClass("text-muted").text("เรียนจบแล้ว")
                    )
                ),

                // Logout Button
                $("<div>").addClass("border-start ps-4").append(
                    $("<div>").attr("id", "btnLogout")
                )
            );

            $("#profileCard").dxBox({
                direction: "row",
                width: "100%",
                items: [{
                    ratio: 1,
                    template: function() {
                        return $("<div>").addClass("dx-card p-4 shadow-sm").append(profileContent);
                    }
                }]
            });

            // Logout Button
            $("#btnLogout").dxButton({
                icon: "runner",
                text: "ออกจากระบบ",
                type: "danger",
                stylingMode: "text",
                onClick: function() {
                    DevExpress.ui.dialog.confirm("คุณต้องการออกจากระบบใช่หรือไม่?", "ยืนยัน").done(function(result) {
                        if (result) window.location.href = '@Url.Action("Logout", "Home")';
                    });
                }
            });
        }

        // ========== Search Box ==========
        function initSearchBox() {
            $("#searchBoxContainer").dxTextBox({
                placeholder: "ค้นหาหลักสูตร...",
                mode: "search",
                width: 280,
                valueChangeEvent: "keyup",
                onValueChanged: function(e) {
                    filterCatalog(e.value);
                }
            });
        }

        // ========== Load My Courses ==========
        function loadMyCourses() {
            $.ajax({
                url: `${baseUrl}/enrollments/my-courses?studentCode=${studentCode}`,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    $("#myCoursesLoading").hide();
                    if (res.success && res.data && res.data.length > 0) {
                        updateStats(res.data);
                        renderMyCourses(res.data);
                    } else {
                        $("#myCoursesContainer").html(`
                            <div class="col-12">
                                <div class="alert alert-light text-center border">
                                    <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                                    <p class="mb-0">คุณยังไม่มีคอร์สที่กำลังเรียน</p>
                                </div>
                            </div>
                        `);
                        $("#statEnrolled, #statCompleted").text("0");
                    }
                },
                error: function() {
                    $("#myCoursesLoading").hide();
                    DevExpress.ui.notify("ไม่สามารถโหลดข้อมูลคอร์สเรียนได้", "error", 3000);
                }
            });
        }

        function renderMyCourses(enrollments) {
            const $container = $("#myCoursesContainer");
            $container.empty();
       
            enrollments.forEach(en => {
                const course = en.course || {};

                const progress = en.progress || 0;
                const isCompleted = en.status === 'Completed';
                const bgImage = course.coverImageUrl || 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80';

                const $card = $("<div>").addClass("col-md-6 col-lg-4 col-xl-3").html(`
                    <div class="card h-100 border-0 shadow-sm card-hover">
                        <div class="course-cover position-relative" style="background-image: url('${bgImage}');">
                            ${isCompleted ? '<span class="badge bg-success position-absolute top-0 end-0 m-2"><i class="fas fa-check-circle me-1"></i>เรียนจบ</span>' : ''}
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="fw-bold text-truncate mb-2" title="${en.courseTitle}">${en.courseTitle}</h6>
                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                ${en.description || '-'}
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">ความคืบหน้า</span>
                                    <span class="fw-bold text-brand">${Math.round(progress)}%</span>
                                </div>
                                <div class="progress mb-3" style="height: 6px;">
                                    <div class="progress-bar bg-brand" style="width: ${progress}%"></div>
                                </div>
                                <div id="btn-action-${en.id}"></div>
                            </div>
                        </div>
                    </div>
                `);

                $container.append($card);

                setTimeout(() => {
                    $(`#btn-action-${en.id}`).dxButton({
                        text: isCompleted ? "ทบทวน" : (progress > 0 ? "เรียนต่อ" : "เริ่มเรียน"),
                        icon: isCompleted ? "repeat" : "chevronnext",
                        type: isCompleted ? "success" : "default",
                        stylingMode: isCompleted ? "outlined" : "contained",
                        width: "100%",
                        elementAttr: { class: isCompleted ? "" : "bg-brand text-white border-0" },
                        onClick: function() {
                            window.location.href = `/MyLearning/Player?enrollmentId=${en.id}`;
                        }
                    });
                }, 0);
            });
        }

        function updateStats(data) {
            const completed = data.filter(e => e.status === 'Completed').length;
            $("#statEnrolled").text(data.length - completed);
            $("#statCompleted").text(completed);
        }

        // ========== Load Catalog ==========
        function loadAllCourses() {
            $.ajax({
                url: `${baseUrl}/courses`,
                method: 'GET',
                data: { isActive: true },
                xhrFields: { withCredentials: true },
                success: function(res) {
                    $("#allCoursesLoading").hide();
                    allCoursesData = res.data || (Array.isArray(res) ? res : []);
                    renderCatalog(allCoursesData);
                },
                error: function() { $("#allCoursesLoading").hide(); }
            });
        }

        function renderCatalog(courses) {
            const $container = $("#catalogContainer");
            $container.empty();

            if (courses.length === 0) {
                $container.html('<div class="alert alert-light text-center">ไม่พบหลักสูตร</div>');
                return;
            }

            const grouped = courses.reduce((acc, c) => {
                const cat = c.category?.name || c.categoryName || 'ทั่วไป';
                if (!acc[cat]) acc[cat] = [];
                acc[cat].push(c);
                return acc;
            }, {});

            Object.keys(grouped).forEach(catName => {
                const $section = $(`
                    <div class="category-group mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-folder-open text-warning me-2"></i>
                            <h6 class="fw-bold mb-0">${catName}</h6>
                        </div>
                        <div class="row g-3 course-list"></div>
                    </div>
                `);

                const $list = $section.find('.course-list');

                grouped[catName].forEach(c => {
                    const bg = c.coverImageUrl || 'https://images.unsplash.com/photo-1501504905252-473c47e087f8?auto=format&fit=crop&w=800&q=80';

                    const $col = $("<div>").addClass("col-md-6 col-lg-3 course-item").attr("data-title", c.title.toLowerCase()).html(`
                        <div class="card h-100 border-0 shadow-sm card-hover">
                            <div class="course-cover" style="background-image: url('${bg}'); height: 140px;"></div>
                            <div class="card-body">
                                <h6 class="fw-bold mb-2">${c.title}</h6>
                                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    ${c.description || 'ไม่มีรายละเอียด'}
                                </p>
                                <div id="btn-enroll-${c.id}"></div>
                            </div>
                        </div>
                    `);

                    $list.append($col);

                    setTimeout(() => {
                        $(`#btn-enroll-${c.id}`).dxButton({
                            text: "ดูรายละเอียด",
                            stylingMode: "outlined",
                            type: "default",
                            width: "100%",
                            elementAttr: { class: "text-brand border-brand" },
                            onClick: () => DevExpress.ui.notify("ดูรายละเอียด: " + c.title, "info", 1000)
                        });
                    }, 0);
                });

                $container.append($section);
            });
        }

        // ========== Filter ==========
        function filterCatalog(text) {
            const keyword = text.toLowerCase();
            $("#catalogContainer .course-item").each(function() {
                $(this).toggle($(this).attr("data-title").includes(keyword));
            });
            $("#catalogContainer .category-group").each(function() {
                $(this).toggle($(this).find(".course-item:visible").length > 0);
            });
        }
    </script>
}
