@{
    ViewBag.Title = "คอร์สเรียนของฉัน";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="fa fa-graduation-cap"></i> @ViewBag.Title</h2>

    <div id="loading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">กำลังโหลดข้อมูลวิชาเรียน...</p>
    </div>

    <div id="courseList" class="row g-4" style="display:none;">
    </div>

    <div id="emptyState" class="text-center py-5" style="display:none;">
        <div class="mb-3">
            <i class="fa fa-folder-open-o fa-4x text-muted"></i>
        </div>
        <h4>คุณยังไม่มีคอร์สเรียน</h4>
        <p class="text-muted">โปรดติดต่อ HR หรือ Admin เพื่อลงทะเบียนเรียน</p>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadMyCourses();
        });

        function loadMyCourses() {
            // เรียก API ที่เราทำไว้ใน Step 1
            // serviceUrl คือตัวแปร Global ที่ชี้ไปที่ API (มักจะอยู่ใน _Layout หรือ site.js)
            $.ajax({
                url: serviceUrl + '/enrollments/my-courses',
                method: 'GET',
                xhrFields: { withCredentials: true },
              
                success: function (response) {
                    $('#loading').hide();

                    // เช็คว่า response.Data หรือ response เป็น Array
                    const courses = response.Data || response;

                    if (!courses || courses.length === 0) {
                        $('#emptyState').show();
                        return;
                    }

                    renderCourses(courses);
                    $('#courseList').fadeIn();
                },
                error: function (err) {
                    console.error("Error loading courses:", err);
                    $('#loading').hide();
                    DevExpress.ui.notify("ไม่สามารถโหลดข้อมูลคอร์สได้", "error", 3000);
                }
            });
        }

        function renderCourses(courses) {
            const container = $('#courseList');
            container.empty();

            courses.forEach(enrollment => {
                // คำนวณ Status สี และ ปุ่ม
                const isCompleted = enrollment.Status === 'Completed' || enrollment.Status === 'Passed';
                const statusBadge = isCompleted
                    ? '<span class="badge bg-success">เรียนจบแล้ว</span>'
                    : '<span class="badge bg-warning text-dark">กำลังเรียน</span>';

                const btnText = isCompleted ? 'ทบทวนบทเรียน' : 'เข้าเรียน';
                const btnClass = isCompleted ? 'btn-outline-primary' : 'btn-primary';

                // HTML Template สำหรับ Card
                const cardHtml = `
                    <div class="col-md-6 col-lg-4 col-xl-3">
                        <div class="card h-100 shadow-sm border-0 hover-shadow">
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 160px;">
                                <i class="fa fa-book fa-3x"></i>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    ${statusBadge}
                                </div>
                                <h5 class="card-title text-truncate" title="${enrollment.CourseTitle}">
                                    ${enrollment.CourseTitle}
                                </h5>
                                <p class="card-text text-muted small mb-4">
                                    รหัสวิชา: ${enrollment.CourseId} <br>
                                    ลงทะเบียนเมื่อ: ${new Date(enrollment.CreatedAt || Date.now()).toLocaleDateString('th-TH')}
                                </p>

                                <div class="mt-auto">
                                    <a href="/MyLearning/Player?enrollmentId=${enrollment.Id}" class="btn ${btnClass} w-100 rounded-pill">
                                        <i class="fa fa-play-circle me-1"></i> ${btnText}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.append(cardHtml);
            });
        }
    </script>

    <style>
        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
            transition: all 0.3s ease;
        }
    </style>
}