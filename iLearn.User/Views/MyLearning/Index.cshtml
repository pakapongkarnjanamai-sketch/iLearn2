@{
    ViewData["Title"] = "คอร์สเรียนของฉัน";
    // ดึงข้อมูลจาก Claims ที่เราเก็บไว้ตอน Login
    var empName = User.Identity?.Name;
    var empCode = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var dept = User.FindFirst("Department")?.Value;
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-white rounded">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px;">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
                <div class="flex-grow-1 ms-3">
                    <h4 class="mb-1 text-primary">@empName</h4>
                    <p class="mb-0 text-muted">
                        <span class="badge bg-light text-dark border mr-2">รหัส: @empCode</span>
                        <span class="badge bg-light text-dark border">แผนก: @dept</span>
                    </p>
                </div>
                <div class="text-right">
                    <a href="@Url.Action("Logout", "Home")" class="btn btn-outline-danger">
                        <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
                    </a>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-3"><i class="fas fa-graduation-cap"></i> คอร์สที่กำลังเรียน</h2>
    <hr />

    <div id="course-grid">
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        border-radius: 12px;
    }
</style>