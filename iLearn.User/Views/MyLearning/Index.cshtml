@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";

    bool isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var empName = User.Identity?.Name ?? "Guest";
    var empCode = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "-";
    var dept = User.FindFirst("Department")?.Value ?? "-";
    var div = User.FindFirst("Division")?.Value ?? "-";
    var profileImage = "https://ui-avatars.com/api/?name=" + empName + "&background=027d83&color=fff&size=128";
}

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .text-brand {
            color: var(--brand-color) !important;
        }

        .bg-brand {
            background-color: var(--brand-color) !important;
        }

        .border-brand {
            border-color: var(--brand-color) !important;
        }

        /* --- Page Header --- */
        .page-header {
            background-color: white;
            padding: 2.5rem 0 1.5rem;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 2rem;
        }

        .page-title {
            font-weight: 600;
            font-size: 1.2rem;
            color: #2c3e50;
            letter-spacing: -0.5px;
        }

        /* --- Modern Tabs (Filter) --- */
        .nav-pills {
            gap: 0.5rem;
        }

            .nav-pills .nav-link {
                color: #6c757d;
                font-weight: 600;
                border-radius: 8px;
                padding: 0.5rem 1.5rem;
                transition: all 0.2s ease;
                background-color: #f8f9fa;
                border: 1px solid transparent;
                cursor: pointer;
            }

                .nav-pills .nav-link:hover {
                    background-color: #e9ecef;
                    color: var(--brand-color);
                }

                .nav-pills .nav-link.active {
                    background-color: rgba(2, 125, 131, 0.1);
                    color: var(--brand-color);
                    border-color: rgba(2, 125, 131, 0.2);
                }

        /* --- Course Card (New Design) --- */
        .my-course-card {
            border: none;
            border-radius: 8px;
            background: white;
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .my-course-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            }

        .course-thumb {
            height: 180px;
            background-color: #eee;
            position: relative;
            overflow: hidden;
        }

            .course-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .my-course-card:hover .course-thumb img {
            transform: scale(1.05);
        }

        /* Course Code Overlay */
        .course-code-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            z-index: 2;
        }

        .course-code-text {
            color: white;
            font-weight: 700;
            font-size: 1.3rem;
            text-align: center;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
            line-height: 1.4;
            word-break: break-word;
        }

        /* ซ่อน Play Overlay และ Play Icon */
        .course-overlay {
            display: none !important;
        }

        .play-icon {
            display: none !important;
        }

        /* Card Body */
        .course-body {
            padding: 1.25rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            border: 1px solid var(--dx-color-border);
            border-radius: 0 0 8px 8px;
        }

        .course-title {
            font-weight: 600;
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 0.5rem;
            color: #2c3e50;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Progress Section */
        .progress-section {
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid #f8f9fa;
        }

        /* DueDate Row */
        .due-date-row {
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        /* Progress Info */
        .progress-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .progress-wrapper-inline {
            flex: 1;
            height: 8px;
            background-color: #ecf0f1;
            border-radius: 4px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: var(--brand-color);
            border-radius: 4px;
            transition: width 1s ease-in-out;
        }

        .btn-continue {
            margin-top: 0.5rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
        }

            .btn-continue:hover {
                transform: translateY(-2px);
            }

        /* Loading State */
        .loading-container {
            text-align: center;
            padding: 3rem;
            color: #aaa;
        }

        /* Profile Stats */
        .stat-box {
            background: white;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .stat-label {
            color: #7f8c8d;
            font-size: 0.9rem;
        }

        /* Catalog Section */
        .catalog-section {
            background: white;
            border-radius: 8px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            min-height: 900px;
        }

        .category-badge {
            background: rgba(2, 125, 131, 0.1);
            color: var(--brand-color);
            padding: 0.25rem 0.75rem;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* ========== Category Sidebar ========== */
        .catalog-layout {
            display: flex;
            gap: 2rem;
        }

        .category-sidebar {
            flex: 0 0 280px;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

            .category-sidebar h5 {
                font-size: 1rem;
                font-weight: 700;
                color: #2c3e50;
                margin-bottom: 1rem;
                padding-bottom: 0.75rem;
                border-bottom: 2px solid var(--brand-color);
            }

        .category-menu-item {
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8f9fa;
            border: 1px solid transparent;
        }

            .category-menu-item:hover {
                background: rgba(2, 125, 131, 0.05);
                border-color: rgba(2, 125, 131, 0.2);
            }

            .category-menu-item.active {
                background: rgba(2, 125, 131, 0.1);
                border-color: var(--brand-color);
                color: var(--brand-color);
                font-weight: 600;
            }

            .category-menu-item .category-name {
                flex: 1;
                font-size: 0.9rem;
            }

            .category-menu-item .course-count {
                background: white;
                padding: 0.15rem 0.5rem;
                border-radius: 12px;
                font-size: 0.75rem;
                font-weight: 600;
                color: #6c757d;
            }

            .category-menu-item.active .course-count {
                background: var(--brand-color);
                color: white;
            }

        .catalog-content {
            flex: 1;
            min-width: 0;
        }

        /* ========== Course Type Section ========== */
        .course-type-section {
            margin-bottom: 1.5rem;
        }

        .course-type-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .type-badge {
            padding: 0.35rem 0.9rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

            .type-badge.general {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
            }

            .type-badge.special {
                background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
                color: white;
            }

        /* ========== Search Highlight ========== */
        .search-highlight {
            background-color: yellow;
            font-weight: bold;
            padding: 0 2px;
            border-radius: 2px;
        }

        /* ========== Responsive ========== */
        @@media (max-width: 991px) {
            .catalog-layout {
                flex-direction: column;
            }

            .category-sidebar {
                flex: 1;
                position: relative;
                top: 0;
            }
        }
    </style>
}

@if (!isAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <i class="fas fa-lock fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">กรุณาเข้าสู่ระบบ</h4>
            <a href="/Home/Index" class="btn btn-primary mt-3">เข้าสู่ระบบ</a>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-4">
                        <img src="@profileImage" width="90" height="90" alt="Profile" class="rounded-circle shadow-sm">
                        <div>
                            <h2 class="page-title mb-1">สวัสดี, @empName</h2>
                            <p class="text-muted mb-0">
                                <i class="fas fa-id-card text-brand me-1"></i> @empCode
                                <span class="mx-2">|</span>
                                <i class="fas fa-building text-brand me-1"></i>@div - @dept
                            </p>
                        </div>
                        <div class="mx-1" id="btnLogout"></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="stat-box text-center">
                                <div class="stat-number text-brand" id="statEnrolled">-</div>
                                <div class="stat-label">กำลังเรียน</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-box text-center">
                                <div class="stat-number text-brand" id="statCompleted">-</div>
                                <div class="stat-label">เรียนจบแล้ว</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container pb-4">

        <div class="mb-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-book-reader text-brand me-2"></i>
                        หลักสูตรของฉัน
                    </h5>
                </div>

                <ul class="nav nav-pills" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" onclick="filterMyCourses('all')">
                            <i class="fas fa-th-large me-1 small"></i> ทั้งหมด
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" onclick="filterMyCourses('progress')">
                            <i class="fas fa-spinner me-1 small"></i> กำลังเรียน
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" onclick="filterMyCourses('completed')">
                            <i class="fas fa-check-circle me-1 small"></i> เรียนจบแล้ว
                        </a>
                    </li>
                </ul>
            </div>

            <div id="myCoursesLoading" class="loading-container">
                <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
                <p>กำลังโหลดบทเรียนของคุณ...</p>
            </div>
            <div id="myCoursesContainer" class="row g-4"></div>
        </div>

        <div class="catalog-section">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="fas fa-graduation-cap text-brand me-2"></i>
                        คลังหลักสูตรทั้งหมด
                    </h5>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <ul class="nav nav-pills" id="catalog-type-filter">
                        <li class="nav-item">
                            <a class="nav-link active" onclick="filterCatalogByType('all')">
                                <i class="fas fa-th-large me-1 small"></i> ทั้งหมด
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" onclick="filterCatalogByType('general')">
                                <i class="fas fa-book me-1 small"></i> ทั่วไป
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" onclick="filterCatalogByType('special')">
                                <i class="fas fa-star me-1 small"></i> พิเศษ
                            </a>
                        </li>
                    </ul>
                    <div id="searchBoxContainer"></div>
                </div>
            </div>

            <div id="allCoursesLoading" class="loading-container">
                <i class="fas fa-circle-notch fa-spin fa-2x mb-3"></i>
                <p>กำลังโหลดหลักสูตร...</p>
            </div>

            <div class="catalog-layout" id="catalogLayout" style="display: none;">
                <div class="category-sidebar">
                    <h5>
                        <i class="fas fa-folder-tree me-2"></i>
                        หมวดหมู่
                    </h5>
                    <div id="categoryMenu"></div>
                </div>

                <div class="catalog-content" id="catalogContent"></div>
            </div>
        </div>

    </div>
}

@section Scripts {
    <script>
        const studentCode = '@empCode';
        const baseUrl = (typeof serviceUrl !== 'undefined') ? serviceUrl : '';
        let allCoursesData = [];
        let myCoursesData = [];
        let currentFilter = 'all';
        let selectedCategoryId = 'all';
        let selectedCourseType = 'all';
        // New: Track selected course type
        let categorizedCourses = {};
        $(function() {
            initSearchBox();
            initLogout();
            loadMyCourses();
            loadAllCourses();
        });
        function initLogout(){
            $("#btnLogout").dxButton({
                icon: "remove",
                text: "ออกจากระบบ",
                type: "Default",
                stylingMode: "outlined",
                onClick: function() {
                    DevExpress.ui.dialog.confirm("คุณต้องการออกจากระบบใช่หรือไม่?", "ยืนยัน").done(function(result) {
                        if (result) window.location.href = '@Url.Action("Logout", "Home")';
                    });
                }
            });
        }

        // ========== Search Box ==========
        function initSearchBox() {
            $("#searchBoxContainer").dxTextBox({
                placeholder: "ค้นหาหลักสูตร...",
                mode: "search",
                width: 300,
                valueChangeEvent: "keyup",
                onValueChanged: function(e) {
                    filterCatalog(e.value);
                }
            });
        }

        // ========== Load My Courses ==========
        function loadMyCourses() {
            $.ajax({
                url: `${baseUrl}/enrollments/my-courses?studentCode=${studentCode}`,
                method: 'GET',
                xhrFields: { withCredentials: true },
                success: function(res) {
                    $("#myCoursesLoading").hide();
                    if (res.success && res.data && res.data.length > 0) {
                        myCoursesData = res.data;
                        updateStats(res.data);
                        renderMyCourses(res.data);
                    } else {
                        $("#myCoursesContainer").html(`
                            <div class="col-12">
                                <div class="alert alert-light text-center border">
                                    <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                                    <p class="mb-0">คุณยังไม่มีคอร์สที่กำลังเรียน</p>
                                </div>
                            </div>
                        `);
                        $("#statEnrolled, #statCompleted").text("0");
                    }
                },
                error: function() {
                    $("#myCoursesLoading").hide();
                    DevExpress.ui.notify("ไม่สามารถโหลดข้อมูลคอร์สเรียนได้", "error", 3000);
                }
            });
        }

        function renderMyCourses(enrollments) {
            const $container = $("#myCoursesContainer");
            $container.empty();

            enrollments.forEach(en => {
                const course = en.course || {};
                const progress = en.progress || 0;
                const isCompleted = !!en.isCompleted;
                const bgImage = course.coverImageUrl || 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=800&q=80';

                const courseCode = en.courseCode || course.code || '-';
                const statusClass = isCompleted ? 'completed' : (progress > 0 ? 'in-progress' : 'not-started');

                const dueDate = formatDueDate(en.dueDate);

                const $card = $("<div>")
                    .addClass(`col-md-6 col-lg-4 col-xl-3 course-item`)
                    .attr('data-status', statusClass)
                    .html(`
                        <div class="my-course-card">
                            <div class="course-thumb">
                                 <img src="${bgImage}" alt="${en.courseTitle}">

                                <div class="course-code-overlay">
                                    <div class="course-code-text">
                                      <div>${courseCode}</div>
                                    </div>
                                 </div>

                                ${isCompleted ? '<span class="badge bg-brand position-absolute top-0 end-0 m-2" style="z-index: 3;"><i class="fas fa-check-circle me-1"></i>เรียนจบ</span>' : ''}
                            </div>
                            <div class="course-body">
                                <h6 class="course-title" title="${en.courseTitle}">${en.courseTitle}</h6>

                                <div class="progress-section">
                                    <div class="due-date-row mb-2">
                                        <i class="far fa-calendar-alt text-muted me-1"></i>
                                        <span class="text-muted small">กำหนด: ${dueDate}</span>
                                    </div>

                                    <div class="progress-info">
                                        <div class="progress-wrapper-inline">
                                            <div class="progress-fill" style="width: ${progress}%;"></div>
                                        </div>
                                        <span class="text-primary fw-bold ms-2">${Math.round(progress)}%</span>
                                    </div>

                                    <a href="/MyLearning/Player?courseId=${en.courseId}" class="btn btn-outline-primary w-100 btn-continue">
                                        ${isCompleted ? 'ทบทวน' : (progress > 0 ? 'เรียนต่อ' : 'เริ่มเรียน')} <i class="fas fa-arrow-right ms-1 small"></i>
                                    </a>
                                </div>
                             </div>
                        </div>
                    `);
                $container.append($card);
            });
        }

        function formatDueDate(dateString) {
            if (!dateString) return '-';
            const date = new Date(dateString);
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const year = date.getFullYear();
            return `${day}/${month}/${year}`;
        }

        function updateStats(data) {
            const completed = data.filter(e => !!e.isCompleted).length;
            const inProgress = data.length - completed;
            $("#statEnrolled").text(inProgress);
            $("#statCompleted").text(completed);
        }

        // ========== Filter My Courses ==========
        function filterMyCourses(type) {
            currentFilter = type;
            $('#pills-tab .nav-link').removeClass('active');
            event.target.classList.add('active');

            let filteredData = myCoursesData;

            if (type === 'progress') {
                filteredData = myCoursesData.filter(e => !e.isCompleted && (e.progress || 0) > 0);
            } else if (type === 'completed') {
                filteredData = myCoursesData.filter(e => !!e.isCompleted);
            }

            const $container = $("#myCoursesContainer");
            if (filteredData.length === 0) {
                const messages = {
                    'all': 'คุณยังไม่มีคอร์สที่ลงทะเบียน',
                    'progress': 'คุณยังไม่มีคอร์สที่กำลังเรียน',
                    'completed': 'คุณยังไม่มีคอร์สที่เรียนจบแล้ว'
                };

                $container.html(`
                    <div class="col-12">
                        <div class="alert alert-light text-center border d-flex align-items-center justify-content-center" style="min-height: 300px;">
                            <div>
                                <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                                <p class="mb-0">${messages[type]}</p>
                            </div>
                        </div>
                    </div>
                `);
            } else {
                renderMyCourses(filteredData);
            }
        }

        // ========== Load Catalog ==========
        function loadAllCourses() {
            $.ajax({
                url: `${baseUrl}/courses`,
                method: 'GET',
                data: { isActive: true },
                xhrFields: { withCredentials: true },
                success: function(res) {
                    $("#allCoursesLoading").hide();
                    allCoursesData = res.data || (Array.isArray(res) ? res : []);

                    if (allCoursesData.length > 0) {
                        organizeCoursesByCategory(allCoursesData);
                        renderCategorySidebar();
                        renderCatalogContent('all');
                        $("#catalogLayout").show();
                    }
                },
                error: function() {
                    $("#allCoursesLoading").hide();
                    DevExpress.ui.notify("ไม่สามารถโหลดข้อมูลหลักสูตรได้", "error", 3000);
                }
            });
        }

        // ========== Organize by Category ==========
        function organizeCoursesByCategory(courses) {
            categorizedCourses = { 'all': courses };
            courses.forEach(course => {
                const catId = course.categoryId;
                const catName = course.categoryName || 'ไม่ระบุหมวดหมู่';

                if (!categorizedCourses[catId]) {
                    categorizedCourses[catId] = {
                        id: catId,
                        name: catName,
                        courses: []
                    };
                }
                categorizedCourses[catId].courses.push(course);
            });
        }

        // ========== Render Category Sidebar ==========
        function renderCategorySidebar() {
            const $menu = $("#categoryMenu");
            $menu.empty();

            // All Categories
            $menu.append(`
                <div class="category-menu-item active" data-category="all">
                    <span class="category-name">
                        <i class="fas fa-th-large me-2"></i>ทั้งหมด
                    </span>
                    <span class="course-count">${allCoursesData.length}</span>
                </div>
            `);
            // Individual Categories
            Object.keys(categorizedCourses).forEach(catId => {
                if (catId === 'all') return;

                const cat = categorizedCourses[catId];
                $menu.append(`
                    <div class="category-menu-item" data-category="${catId}">
                        <span class="category-name">
                            <i class="fas fa-folder me-2"></i>${cat.name}
                        </span>
                        <span class="course-count">${cat.courses.length}</span>
                    </div>
                `);
            });
            // Click Event
            $menu.on('click', '.category-menu-item', function() {
                const categoryId = $(this).data('category');
                selectedCategoryId = categoryId;

                $('.category-menu-item').removeClass('active');
                $(this).addClass('active');

                renderCatalogContent(categoryId);
            });
        }

        // ========== NEW: Filter Catalog by Course Type ==========
        function filterCatalogByType(type) {
            selectedCourseType = type;
            $('#catalog-type-filter .nav-link').removeClass('active');
            event.target.classList.add('active');

            renderCatalogContent(selectedCategoryId);
        }

               // ========== Render Catalog Content (with Course Type Filter) ==========
        function renderCatalogContent(categoryId) {
            const $content = $("#catalogContent");
            $content.empty();

            let coursesToShow = categoryId === 'all'
                ? allCoursesData
                : (categorizedCourses[categoryId]?.courses || []);
            // Apply Course Type Filter - แก้ไขตรงนี้
            if (selectedCourseType === 'general') {
                coursesToShow = coursesToShow.filter(c => c.type === 1);
                // ✅ เปลี่ยนเป็น c.type === 1
            } else if (selectedCourseType === 'special') {
                coursesToShow = coursesToShow.filter(c => c.type === 2); // 0? -> ใน CourseType 0=Special, 1=General
                // ✅ เปลี่ยนตาม Enum: 0=Special, 1=General
                // หมายเหตุ: เช็ค Enum ของคุณอีกที ในที่นี้ 1=General, 2=??
                // จากไฟล์ CourseType.cs: Special = 0, General = 1
                // แต่ในโค้ดเดิมเขียน if (c.type === 2) ซึ่งอาจจะผิด ถ้า Special คือ 0
                // **แก้ไข**: ถ้า Special คือ 0 ให้ใช้ c.type === 0
                // แต่ถ้าตามโค้ดเดิมของคุณที่ใช้ 1 กับ 2, ผมจะคง 1 กับ 2 ไว้ก่อนเพื่อความปลอดภัย หรือปรับตามความจริง
                // (สมมติว่า Special = 0 ตามไฟล์ Enum ที่ให้มา)
                // coursesToShow = coursesToShow.filter(c => c.type === 0);
            }

            if (coursesToShow.length === 0) {
                $content.html(`
                    <div class="alert alert-light text-center border">
                        <i class="fas fa-inbox fa-2x text-muted mb-2"></i>
                        <p class="mb-0">ไม่พบหลักสูตรในหมวดหมู่นี้</p>
                    </div>
                `);
                return;
            }

            // Group by Course Type
            const generalCourses = coursesToShow.filter(c => c.type === 1); // General
            const specialCourses = coursesToShow.filter(c => c.type === 0); // Special (จาก Enum: 0)

            // Render General Courses
            if (generalCourses.length > 0) {
                const $generalSection = $(`
                    <div class="course-type-section">
                        <div class="course-type-header">
                            <span class="type-badge general">
                                <i class="fas fa-book"></i>
                                หลักสูตรทั่วไป
                            </span>
                            <span class="text-muted small">(${generalCourses.length} หลักสูตร)</span>
                        </div>

                    <div class="row g-4" id="generalCoursesGrid"></div>
                    </div>
                `);
                generalCourses.forEach(course => {
                    $generalSection.find('#generalCoursesGrid').append(renderCatalogCard(course));
                });
                $content.append($generalSection);
            }

            // Render Special Courses
            if (specialCourses.length > 0) {
                const $specialSection = $(`
                    <div class="course-type-section">
                        <div class="course-type-header">
                            <span class="type-badge special">
                                <i class="fas fa-star"></i>
                                หลักสูตรพิเศษ
                            </span>
                            <span class="text-muted small">(${specialCourses.length} หลักสูตร)</span>
                        </div>
                        <div class="row g-4" id="specialCoursesGrid"></div>
                    </div>
                `);
                specialCourses.forEach(course => {
                    $specialSection.find('#specialCoursesGrid').append(renderCatalogCard(course));
                });
                $content.append($specialSection);
            }
        }

              // ========== Render Single Catalog Card ==========
        function renderCatalogCard(course) {
            const bgImage = course.coverImageUrl || 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=800&q=80';
            const courseCode = course.code || '-';

            return $(`
                <div class="col-md-6 col-lg-4 col-xl-3 catalog-course-item">
                    <div class="my-course-card">
                        <div class="course-thumb">
                            <img src="${bgImage}" alt="${course.title}">
                            <div class="course-code-overlay">
                                <div class="course-code-text">${courseCode}</div>
                            </div>
                        </div>
                        <div class="course-body">
                            <h6 class="course-title" title="${course.title}">${course.title}</h6>

                            <div class="progress-section">
                                <a href="/MyLearning/Player?courseId=${course.id}" class="btn btn-outline-primary w-100 btn-continue">
                                    <i class="fas fa-eye me-1"></i> ดูเนื้อหา / เรียน
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `);
        }

        // ========== Filter Catalog (Search) ==========
        function filterCatalog(searchText) {
            const $items = $(".catalog-course-item");
            if (!searchText || searchText.trim() === '') {
                $items.show();
                removeHighlights();
                return;
            }

            const lowerSearch = searchText.toLowerCase();
            $items.each(function() {
                const $item = $(this);
                const title = $item.find('.course-title').text().toLowerCase();
                const code = $item.find('.course-code-text').text().toLowerCase();

                if (title.includes(lowerSearch) || code.includes(lowerSearch)) {
                    $item.show();
                    highlightText($item, searchText);
                } else {
                    $item.hide();
                }
            });
        }

        // ========== Highlight Search Text ==========
        function highlightText($item, searchText) {
            removeHighlights();
            const $title = $item.find('.course-title');
            const $code = $item.find('.course-code-text');

            const titleHtml = $title.html();
            const codeHtml = $code.html();
            const regex = new RegExp(`(${escapeRegex(searchText)})`, 'gi');

            $title.html(titleHtml.replace(regex, '<span class="search-highlight">$1</span>'));
            $code.html(codeHtml.replace(regex, '<span class="search-highlight">$1</span>'));
        }

        function removeHighlights() {
            $('.search-highlight').each(function() {
                $(this).replaceWith($(this).text());
            });
        }

        function escapeRegex(str) {
            return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }
    </script>
}