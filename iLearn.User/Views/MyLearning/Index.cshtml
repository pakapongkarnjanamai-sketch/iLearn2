                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmLogout"><i class="fas fa-sign-out-alt me-1"></i> ออกจากระบบ</button>
                </div>
