@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml"; // ใช้ Layout แต่จะ Override สไตล์
}

@section Styles {
    <style>
        /* Override Background เฉพาะหน้านี้ */
        body {
            background: linear-gradient(135deg, var(--brand-color) 0%, #004d40 100%) !important;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ซ่อน Navbar/Footer ในหน้า Login ถ้าต้องการให้ Clean */
        header, footer {
            display: none !important;
        }

        /* ปรับแต่ง Popup */
        .dx-popup-content {
            padding: 30px !important;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-icon {
            font-size: 3rem;
            color: var(--brand-color);
            margin-bottom: 10px;
        }
    </style>
}

<div id="login-popup"></div>
<script>
    $(function () {
        // Template ภายใน Popup
        const popupContent = function() {
            return $("<div>").append(
                // Logo Header
                $("<div class='login-header'>").append(
                    $("<i class='fas fa-graduation-cap login-icon'>"),
                    $("<h3 class='fw-bold text-dark'>").text("iLearn Login"),
                    $("<p class='text-muted small'>").text("ระบบการเรียนรู้ออนไลน์สำหรับพนักงาน")
                ),

                // [จุดที่แก้ไข 1] Form Inputs: ใส่ ID ให้ div
                $("<div id='employee-code-box' class='mb-4'>").dxTextBox({
                    placeholder: "กรอกรหัสพนักงาน (Employee Code)",
                    label: "รหัสพนักงาน",
                    labelMode: "floating",
                    mode: "text",
                    height: 50
                }),

                // Preview Area
                $("<div id='employee-preview' class='alert alert-light border text-center mb-4' style='display:none;'>").html(
                    "<div class='spinner-border spinner-border-sm text-secondary' role='status'></div>"
                ),

                // Login Button
                $("<div>").dxButton({
                    text: "เข้าสู่ระบบ",
                    type: "default",
                    width: "100%",
                    height: 50,
                    elementAttr: { class: "bg-brand border-0 fw-bold shadow-sm" },
                    onClick: function(e) {
                        validateAndLogin(e);
                    }
                })
            );
        };

        // สร้าง Popup
        const loginPopup = $("#login-popup").dxPopup({
            width: 400,
            height: "auto",
            visible: true,
            showTitle: false,
            dragEnabled: false,
            closeOnOutsideClick: false,
            contentTemplate: popupContent,
            position: { my: "center", at: "center", of: window }
        }).dxPopup("instance");

        // Logic Login
           function validateAndLogin(btnEvent) {
        // [จุดที่แก้ไข 2] เรียก instance จาก ID ของ div
        const employeeCode = $("#employee-code-box").dxTextBox("instance").option("value");

        if (!employeeCode) {
            DevExpress.ui.notify("กรุณากรอกรหัสพนักงาน", "error", 2000);
            return;
        }

        btnEvent.component.option("disabled", true);
        btnEvent.component.option("text", "กำลังตรวจสอบ...");

        // [จุดที่แก้ไข 3] ซ่อน employee-code-box และแสดง employee-preview
        $("#employee-code-box").hide();
        $("#employee-preview").show().html(`
            <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
            <span class="text-muted">กำลังยืนยันตัวตน: <strong>${employeeCode}</strong></span>
        `);

        // AJAX Call
        $.ajax({
            url: '/Home/VerifyEmployee',
            method: 'POST',
            data: { employeeCode: employeeCode },
            xhrFields: { withCredentials: true },
            success: function(response) {
                if (response.success) {
                    $("#employee-preview").removeClass("alert-light").addClass("alert-success")
                        .html(`<i class="fas fa-check-circle me-1"></i> ยินดีต้อนรับ <strong>${response.data.name}</strong>`);

                    // DevExpress.ui.notify("เข้าสู่ระบบสำเร็จ", "success", 1500);
                    setTimeout(() => window.location.href = '/MyLearning/Index', 1000);
                } else {
                    handleLoginError(response.message, btnEvent);
                }
            },
            error: function() {
                handleLoginError("เกิดข้อผิดพลาดในการเชื่อมต่อ", btnEvent);
            }
        });
    }

    function handleLoginError(msg, btnEvent) {
        DevExpress.ui.notify(msg, "error", 2000);

        // แสดง employee-code-box กลับมา และซ่อน employee-preview
        $("#employee-preview").hide();
        $("#employee-code-box").show();

        btnEvent.component.option("disabled", false);
        btnEvent.component.option("text", "เข้าสู่ระบบ");
    }
    });
</script>