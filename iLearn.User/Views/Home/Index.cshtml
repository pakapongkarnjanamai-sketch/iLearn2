@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
}

@section Styles {
    <style>
        /* ซ่อน Navbar/Footer เฉพาะหน้า Login */
        header, footer {
            display: none !important;
        }

        /* ✅ ใช้สีพื้นหลังเดียวกับ Dashboard แทน Gradient */
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Login Card - ทำให้เหมือน Card ใน Dashboard */
        .login-container {
            width: 100%;
            max-width: 500px;
            padding: var(--space-5);
        }

        .login-card {
            background: white;
            border-radius: var(--radius-md);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: var(--space-6);
            border: 1px solid #e9ecef;
        }

        .login-header {
            text-align: center;
            margin-bottom: var(--space-5);
        }

        .login-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--brand-color), var(--brand-dark));
            border-radius: 25%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.5rem;
            margin-bottom: var(--space-5);
            box-shadow: 0 8px 20px rgba(2, 125, 131, 0.2);
        }

        .login-title {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 0.9rem;
        }

        /* Preview Area */
        .employee-preview {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: var(--radius-sm);
            padding: var(--space-4);
            margin-bottom: var(--space-5);
            text-align: center;
        }

        /* Button Styling */
        .btn-login {
            background-color: var(--brand-color) !important;
            border: none !important;
            font-weight: 600;
            border-radius: var(--radius-sm);
            height: 50px;
            transition: all 0.3s;
        }

            .btn-login:hover {
                background-color: var(--brand-dark) !important;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(2, 125, 131, 0.3);
            }

        /* Floating label input (PLAN-108 Fix 2: matches the previous dxTextBox
           floating-label measurements exactly) */
        .login-field {
            position: relative;
        }

        .login-floating-input {
            height: 50px;
            padding-left: 9px;
            padding-right: 9px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
            color: #333;
        }

        .login-floating-input::placeholder {
            color: #999;
            font-size: 14px;
            opacity: 0;
            transition: opacity 0.15s ease;
        }

        .login-floating-input:focus::placeholder,
        .login-floating-input:not(:placeholder-shown)::placeholder {
            opacity: 1;
        }

        .login-floating-label {
            position: absolute;
            left: 9px;
            top: 17px;
            font-size: 14px;
            color: #999;
            background: #fff;
            padding: 0 4px;
            pointer-events: none;
            transition: top 0.15s ease, font-size 0.15s ease, color 0.15s ease;
        }

        .login-floating-input:focus + .login-floating-label,
        .login-floating-input:not(:placeholder-shown) + .login-floating-label {
            top: -7px;
            font-size: 12px;
        }

        .login-floating-input:focus + .login-floating-label {
            color: var(--brand-color);
        }
    </style>
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <h3 class="login-title">ยินดีต้อนรับสู่ iLearn</h3>
            <p class="login-subtitle">ระบบการเรียนรู้ออนไลน์สำหรับพนักงาน</p>
        </div>

        <div class="mb-4 login-field">
            <input type="text" id="employee-code-input" class="form-control login-floating-input"
                   placeholder="กรอกรหัสพนักงาน"
                   inputmode="numeric" autocomplete="off" autocorrect="off" autocapitalize="off"
                   spellcheck="false" enterkeyhint="go" />
            <label for="employee-code-input" class="login-floating-label">รหัสพนักงาน</label>
        </div>

        <div id="employee-preview" class="employee-preview" style="display:none;">
            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>

        <button type="button" id="login-button" class="btn btn-login w-100">เข้าสู่ระบบ</button>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let isProcessing = false;

            const $employeeCodeBox = $("#employee-code-input");
            const $loginButton = $("#login-button");

            $employeeCodeBox.on("keydown", function (e) {
                if (e.key === "Enter" && !isProcessing) {
                    e.preventDefault();
                    performLogin();
                }
            });

            $loginButton.on("click", function (e) {
                e.preventDefault();
                performLogin();
            });

            function performLogin() {
                if (isProcessing) return;

                const employeeCode = $employeeCodeBox.val();

                if (!employeeCode || employeeCode.trim() === "") {
                    showToast("กรุณากรอกรหัสพนักงาน", "error");
                    return;
                }

                isProcessing = true;
                $loginButton.prop("disabled", true).text("กำลังตรวจสอบ...");

                $("#employee-code-input").closest(".mb-4").hide();
                $("#employee-preview").show().html(`
                    <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                    <span class="text-muted">กำลังยืนยันตัวตน: <strong>${employeeCode}</strong></span>
                `);

                $.ajax({
                    url: '@Url.Action("VerifyEmployee", "Home")',
                    method: 'POST',
                    data: { employeeCode: employeeCode },
                    xhrFields: { withCredentials: true },
                    success: function(response) {
                        console.log("[Login] Response:", response);
                        if (response.success) {
                            $("#employee-preview")
                                .removeClass("alert-light")
                                .addClass("text-success")
                                .html(`
                                    <i class="fas fa-check-circle me-2"></i>
                                    <strong>${response.data.name}</strong>
                                `);
                            setTimeout(() => {
                                window.location.href = '@Url.Action("Index", "MyLearning")';
                            }, 1000);
                        } else {
                            handleLoginError(response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("[Login] Error:", xhr.status, error);
                        handleLoginError("เกิดข้อผิดพลาดในการเชื่อมต่อ กรุณาลองใหม่อีกครั้ง");
                    },
                    complete: function() {
                        isProcessing = false;
                    }
                });
            }

            function handleLoginError(msg) {
                showToast(msg, "error");
                $("#employee-preview").hide();
                $("#employee-code-input").closest(".mb-4").show();
                $loginButton.prop("disabled", false).text("เข้าสู่ระบบ");
                $employeeCodeBox.trigger("focus");
            }

            setTimeout(function() {
                $employeeCodeBox.trigger("focus");
            }, 300);
        });
    </script>
}