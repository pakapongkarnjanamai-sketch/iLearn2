@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_DevExtremeLayout.cshtml";
}

@section Styles {
    <style>
        /* ซ่อน Navbar/Footer เฉพาะหน้า Login */
        header, footer {
            display: none !important;
        }

        /* ✅ ใช้สีพื้นหลังเดียวกับ Dashboard แทน Gradient */
        body {
            background-color: #f4f6f8 !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Login Card - ทำให้เหมือน Card ใน Dashboard */
        .login-container {
            width: 100%;
            width: 500px;
            padding: 60px;
        }

        .login-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 40px;
            border: 1px solid #e9ecef;
        }

        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .login-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--brand-color), var(--brand-dark));
            border-radius: 25%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.5rem;
            margin-bottom: 20px;
            box-shadow: 0 8px 20px rgba(2, 125, 131, 0.2);
        }

        .login-title {
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .login-subtitle {
            color: #6c757d;
            font-size: 0.9rem;
        }

        /* Preview Area */
        .employee-preview {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 4px;
            padding: 15px;
            margin-bottom: 20px;
            text-align: center;
        }

        /* Button Styling */
        .btn-login {
            background-color: var(--brand-color) !important;
            border: none !important;
            font-weight: 600;
            border-radius: 4px;
            height: 50px;
            transition: all 0.3s;
        }

            .btn-login:hover {
                background-color: var(--brand-dark) !important;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(2, 125, 131, 0.3);
            }
    </style>
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <h3 class="login-title">ยินดีต้อนรับสู่ iLearn</h3>
            <p class="login-subtitle">ระบบการเรียนรู้ออนไลน์สำหรับพนักงาน</p>
        </div>

        <div id="employee-code-box" class="mb-4"></div>

        <div id="employee-preview" class="employee-preview" style="display:none;">
            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>

        <div id="login-button"></div>
    </div>
</div>
<script>
    $(function () {
        let isProcessing = false; // ✅ ป้องกันการเรียกซ้ำ

        // Employee Code Input
        const employeeCodeBox = $("#employee-code-box").dxTextBox({
            placeholder: "กรอกรหัสพนักงาน",
            label: "รหัสพนักงาน",
            labelMode: "floating",
            mode: "text",
            height: 50,
            stylingMode: "outlined",
            // ✅ ใช้ onEnterKey แทน
            onEnterKey: function(e) {
                e.event.preventDefault();
                e.event.stopPropagation();
                performLogin();
            }
        }).dxTextBox("instance");

        // Login Button
        const loginButton = $("#login-button").dxButton({
            text: "เข้าสู่ระบบ",
            type: "default",
            width: "100%",
            height: 50,
            elementAttr: { class: "btn-login" },
            onClick: function(e) {
                e.event.preventDefault();
                performLogin();
            }
        }).dxButton("instance");

        // ✅ เพิ่ม Enter สำหรับ Mobile (ใช้ once เพื่อป้องกันซ้ำ)
        $(document).off("keyup.login").on("keyup.login", "#employee-code-box input", function(e) {
            if ((e.which === 13 || e.keyCode === 13) && !isProcessing) {
                e.preventDefault();
                e.stopPropagation();
                performLogin();
            }
        });

        // ฟังก์ชัน Login หลัก
        function performLogin() {
            // ✅ ป้องกันการเรียกซ้ำ
            if (isProcessing) {
                console.log("Already processing...");
                return;
            }

            const employeeCode = employeeCodeBox.option("value");

            if (!employeeCode || employeeCode.trim() === "") {
                DevExpress.ui.notify("กรุณากรอกรหัสพนักงาน", "error", 2000);
                return;
            }

            // ✅ ตั้งค่า flag
            isProcessing = true;

            // ปิดการใช้งานปุ่มและแสดงสถานะ
            loginButton.option("disabled", true);
            loginButton.option("text", "กำลังตรวจสอบ...");

            // ซ่อน Input และแสดง Preview
            $("#employee-code-box").hide();
            $("#employee-preview").show().html(`
                <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                <span class="text-muted">กำลังยืนยันตัวตน: <strong>${employeeCode}</strong></span>
            `);

            // เรียก API ตรวจสอบพนักงาน
            $.ajax({
                url: '/Home/VerifyEmployee',
                method: 'POST',
                data: { employeeCode: employeeCode },
                xhrFields: { withCredentials: true },
                success: function(response) {
                    if (response.success) {
                        // ✅ Login สำเร็จ
                        $("#employee-preview")
                            .removeClass("alert-light")
                            .addClass("text-success")
                            .html(`
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>${response.data.name}</strong>
                            `);

                        // Redirect ไปหน้า MyLearning
                        setTimeout(() => {
                            window.location.href = '/MyLearning/Index';
                        }, 1000);
                    } else {
                        // ❌ Login ไม่สำเร็จ
                        handleLoginError(response.message);
                    }
                },
                error: function(xhr, status, error) {
                    // ❌ เกิดข้อผิดพลาดในการเชื่อมต่อ
                    console.error("Login Error:", error);
                    handleLoginError("เกิดข้อผิดพลาดในการเชื่อมต่อ กรุณาลองใหม่อีกครั้ง");
                },
                complete: function() {
                    // ✅ รีเซ็ต flag เมื่อเสร็จสิ้น
                    isProcessing = false;
                }
            });
        }

        // ฟังก์ชันจัดการ Error
        function handleLoginError(msg) {
            DevExpress.ui.notify(msg, "error", 3000);

            // แสดง Input กลับมา
            $("#employee-preview").hide();
            $("#employee-code-box").show();

            // เปิดใช้งานปุ่มกลับ
            loginButton.option("disabled", false);
            loginButton.option("text", "เข้าสู่ระบบ");

            // Focus กลับไปที่ Input
            employeeCodeBox.focus();
        }

        // ✅ Auto Focus ที่ Input เมื่อโหลดหน้า
        setTimeout(function() {
            employeeCodeBox.focus();
        }, 300);
    });
</script>