@{
    ViewData["Title"] = "เข้าสู่ระบบ - iLearn";
}

<div class="container-fluid">
    <div class="text-center mt-5">
        <h1 class="display-4">iLearn System</h1>
        <p class="lead">ระบบจัดการการเรียนรู้สำหรับพนักงาน</p>
    </div>
</div>

<div id="login-popup"></div>

@section Scripts {
    <script>
        $(function () {
            // 1. โครงสร้างภายใน Popup (Template)
            const popupContent = function() {
                return $("<div>").append(
                    $("<div class='dx-field'>").append(
                        $("<div class='dx-field-label'>").text("รหัสพนักงาน"),
                        $("<div class='dx-field-value'>").append($("<div id='employee-id-input'>"))
                    ),
                    $("<div class='login-info-section mt-3 text-muted' id='employee-preview' style='display:none;'>").append(
                        $("<small>").html("<strong>ชื่อ:</strong> <span id='txt-name'>-</span><br><strong>แผนก:</strong> <span id='txt-dept'>-</span>")
                    ),
                    $("<div class='mt-4'>").append($("<div id='login-button'>"))
                );
            };

            // 2. สร้าง Popup ด้วย DevExtreme jQuery
            const loginPopup = $("#login-popup").dxPopup({
                width: 450,
                height: "auto",
                showTitle: true,
                title: "Login with Employee ID",
                visible: true,
                dragEnabled: false,
                closeOnOutsideClick: false,
                showCloseButton: false,
                contentTemplate: popupContent,
                onShown: function() {
                    // สร้าง TextBox รับรหัสพนักงาน
                    $("#employee-id-input").dxTextBox({
                        placeholder: "ระบุรหัสพนักงาน (เช่น 610034)",
                        mode: "text",
                        stylingMode: "outlined",
                        onInitialized: function(e) {
                            setTimeout(() => e.component.focus(), 100);
                        }
                    });

                    // สร้างปุ่มยืนยัน
                    $("#login-button").dxButton({
                        text: "เข้าสู่ระบบ",
                        type: "default",
                        stylingMode: "contained",
                        width: "100%",
                        useSubmitBehavior: false,
                        onClick: function(e) {
                            validateAndLogin(e);
                        }
                    });
                }
            }).dxPopup("instance");

            // 3. ฟังก์ชันจัดการการ Login และเรียก API ผ่าน Backend
            function validateAndLogin(btnEvent) {
                const empInput = $("#employee-id-input").dxTextBox("instance");
                const employeeCode = empInput.option("value");

                if (!employeeCode || employeeCode.trim() === "") {
                    DevExpress.ui.notify("กรุณากรอกรหัสพนักงาน", "error", 2000);
                    empInput.focus();
                    return;
                }

                // แสดง Loading ที่ปุ่ม
                btnEvent.component.option("disabled", true);
                btnEvent.component.option("text", "กำลังตรวจสอบ...");

                // เรียกไปที่ HomeController ของ iLearn.User
                $.ajax({
                    url: '@Url.Action("VerifyEmployee", "Home")', // Action ที่คุณต้องสร้างเพิ่มใน Controller
                    type: 'POST',
                    data: { employeeCode: employeeCode },
                    success: function (response) {
                        if (response.success) {
                            // กรณีสำเร็จ: แสดงข้อมูลที่ได้จาก API ภายนอก
                            $("#employee-preview").fadeIn();
                            $("#txt-name").text(response.data.name);
                            $("#txt-dept").text(response.data.department);

                            DevExpress.ui.notify("ยินดีต้อนรับคุณ " + response.data.name, "success", 2000);

                            // รอสักครู่แล้วย้ายหน้า (เช่น ไปหน้า MyLearning)
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Index", "MyLearning")';
                            }, 1500);
                        } else {
                            DevExpress.ui.notify(response.message || "ไม่พบข้อมูลพนักงาน", "error", 3000);
                            btnEvent.component.option("disabled", false);
                            btnEvent.component.option("text", "เข้าสู่ระบบ");
                        }
                    },
                    error: function () {
                        DevExpress.ui.notify("เกิดข้อผิดพลาดในการเชื่อมต่อกับเซิร์ฟเวอร์", "error", 3000);
                        btnEvent.component.option("disabled", false);
                        btnEvent.component.option("text", "เข้าสู่ระบบ");
                    }
                });
            }
        });
    </script>
}

<style>
    .dx-field {
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

    .dx-field-label {
        width: 35%;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .dx-field-value {
        width: 65%;
    }

    .login-info-section {
        background: #f8f9fa;
        padding: 10px;
        border-radius: 5px;
        border-left: 4px solid #337ab7;
    }
</style>