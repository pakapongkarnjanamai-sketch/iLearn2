@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IConfiguration Configuration
@inject IFileVersionProvider FileVersionProvider
@{
    var __host = Context.Request.Host.Host ?? "";
    var __isProd = __host.Contains("prwb", StringComparison.OrdinalIgnoreCase);
    var __isDev = __host.Contains("localhost", StringComparison.OrdinalIgnoreCase) || __host.StartsWith("127.");
    var __envLabel = __isProd ? null : (__isDev ? "DEV" : "QA");
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iLearn@(__isProd ? "" : $" ({__envLabel})")</title>

     @* Tab icon = PNG (Chromium/Edge render ได้แน่นอน + anonymous-safe ทั้ง QA/PROD)
         เดิมใช้ favicon.ico/favicon-tab.ico แต่ Chromium decode ไฟล์ .ico นี้ไม่ได้ = แท็บว่าง (PLAN-150)
         ห้ามเพิ่ม favicon.svg rel="icon" กลับเข้ามาจนกว่า QA IIS จะตอบ .svg เป็น 200 สำหรับ anonymous (PLAN-148 Part 2) *@
    <link href="~/favicon-32.png" rel="icon" type="image/png" sizes="32x32" asp-append-version="true" />
    <link href="~/favicon-16.png" rel="icon" type="image/png" sizes="16x16" asp-append-version="true" />
    <link href="~/favicon-32.png" rel="shortcut icon" type="image/png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon-180.png" />
    <link rel="apple-touch-icon-precomposed" sizes="180x180" href="~/apple-touch-icon-precomposed.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="iLearn" />

    @* PWA / Add to Home Screen (PLAN-151) — manifest ให้ Android/Chrome, iOS metas ให้ iPad/iPhone เปิดแบบ standalone
       theme-color เป็น env-aware (teal=PROD, orange=QA/DEV) เทียบเท่า PLAN-149; manifest เป็น static จึงใช้ teal เป็น default *@
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="@(__isProd ? "#027d83" : "#c2410c")" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 300; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Light.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 400; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Regular.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 500; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Medium.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 700; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Bold.ttf"))') format('truetype'); }
    </style>

    <script src="~/js/devextreme/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("ExternalDependencies", required: false)

    <link rel="stylesheet" href="~/css/user-theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    @if (!__isProd)
    {
        <style>
            /* PLAN-149: non-PROD brand override (QA/DEV). PROD remains untouched. */
            :root {
                --brand-color: #c2410c;
                --brand-dark: #7c2d12;
                --brand-light: #ffedd5;
                --brand-lighter: #fff7ed;
                --brand-shadow-rgb: 194, 65, 12;
            }
        </style>
    }
</head>

<body class="d-flex flex-column min-vh-100">
    <div id="appToastStack" aria-live="polite" aria-atomic="true"></div>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-graduation-cap"></i> iLearn
                    @if (!__isProd)
                    {
                        <span class="env-badge">@__envLabel</span>
                    }
                </a>
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto text-center">
        <div class="container">
            <span>&copy; @DateTime.Now.Year - iLearn - Learning System</span>
        </div>
    </footer>

    <script>
        const learnerLoginUrl = '@Url.Action("Index", "Home")';
        let learnerSessionRedirecting = false;

        /* --- Skeleton Loader ------------------------------------------------- */

        /**
         * แสดง Skeleton Cards ใน container ที่ระบุ
         * @@param {string} selector  - jQuery selector ของ container
         * @@param {number} count     - จำนวน skeleton cards (default 8)
         * @@param {string} colClass  - Bootstrap column class (default 'col-md-6 col-lg-4 col-xl-3')
         */
        function showSkeletonCards(selector, count, colClass) {
            count    = count    || 8;
            colClass = colClass || 'col-md-6 col-lg-4 col-xl-3';
            var html = '';
            for (var i = 0; i < count; i++) {
                html +=
                    '<div class="' + colClass + '">' +
                        '<div class="skeleton-card">' +
                            '<div class="skeleton skeleton-thumb"></div>' +
                            '<div class="skeleton-body">' +
                                '<div class="skeleton skeleton-title"></div>' +
                                '<div class="skeleton skeleton-title short"></div>' +
                                '<div class="skeleton skeleton-bar"></div>' +
                                '<div class="skeleton skeleton-btn"></div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
            }
            $(selector).html(html);
        }

        /* --- Notifications & Feedback ---------------------------------------- */

        // showToast: native stacked toast (top center, down-push) — PLAN-108 replacement for DevExpress.ui.notify
        // type: 'success' | 'error' | 'warning' | 'info'
        function showToast(message, type, duration) {
            type = type || 'info';
            duration = duration || 3500;
            var icons = {
                success: 'fa-circle-check',
                error:   'fa-circle-xmark',
                warning: 'fa-triangle-exclamation',
                info:    'fa-circle-info'
            };
            var icon = icons[type] || icons.info;

            var $toast = $('<div class="app-toast app-toast-' + type + '"><i class="fas ' + icon + ' me-2"></i><span></span></div>');
            $toast.find('span').text(message);

            // down-push: newest toast enters at the top, existing toasts get pushed down
            $('#appToastStack').prepend($toast);

            requestAnimationFrame(function () {
                $toast.addClass('show');
            });

            setTimeout(function () {
                $toast.removeClass('show').addClass('hide');
                setTimeout(function () { $toast.remove(); }, 60);
            }, duration);
        }

        function handleLearnerSessionExpired(result) {
            var payload = result && result.responseJSON ? result.responseJSON : result;
            var status = result && typeof result.status === 'number' ? result.status : 0;
            var isExpired = status === 440 || (payload && payload.sessionExpired === true);

            if (!isExpired) {
                return false;
            }

            if (learnerSessionRedirecting) {
                return true;
            }

            learnerSessionRedirecting = true;
            showToast((payload && payload.message) || 'Session หมดอายุ กรุณาเข้าสู่ระบบอีกครั้ง', 'warning', 2500);

            window.setTimeout(function () {
                window.location.href = (payload && payload.redirectUrl) || learnerLoginUrl;
            }, 800);

            return true;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>