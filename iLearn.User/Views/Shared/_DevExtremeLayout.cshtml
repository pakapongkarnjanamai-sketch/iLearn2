@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject IConfiguration Configuration
@inject IFileVersionProvider FileVersionProvider
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iLearn</title>

    <link href="~/favicon.svg" rel="icon" type="image/svg+xml" asp-append-version="true" />

    <link href="~/css/devextreme/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" asp-append-version="true" />

    <style>
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 300; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Light.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 400; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Regular.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 500; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Medium.ttf"))') format('truetype'); }
        @@font-face { font-family: 'Sarabun'; font-style: normal; font-weight: 700; font-display: swap; src: url('@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/fonts/sarabun/Sarabun-Bold.ttf"))') format('truetype'); }
    </style>

    <script src="~/js/devextreme/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/devextreme/dx.all.js" asp-append-version="true"></script>
    <script src="~/src/devextreme-license.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("ExternalDependencies", required: false)

    <link rel="stylesheet" href="~/css/user-theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <i class="fas fa-graduation-cap"></i> iLearn
                </a>
                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto text-center">
        <div class="container">
            <span>&copy; @DateTime.Now.Year - iLearn - Learning System</span>
        </div>
    </footer>

    <script>
        const learnerLoginUrl = '@Url.Action("Index", "Home")';
        let learnerSessionRedirecting = false;

        /* --- Skeleton Loader ------------------------------------------------- */

        /**
         * แสดง Skeleton Cards ใน container ที่ระบุ
         * @@param {string} selector  - jQuery selector ของ container
         * @@param {number} count     - จำนวน skeleton cards (default 8)
         * @@param {string} colClass  - Bootstrap column class (default 'col-md-6 col-lg-4 col-xl-3')
         */
        function showSkeletonCards(selector, count, colClass) {
            count    = count    || 8;
            colClass = colClass || 'col-md-6 col-lg-4 col-xl-3';
            var html = '';
            for (var i = 0; i < count; i++) {
                html +=
                    '<div class="' + colClass + '">' +
                        '<div class="skeleton-card">' +
                            '<div class="skeleton skeleton-thumb"></div>' +
                            '<div class="skeleton-body">' +
                                '<div class="skeleton skeleton-title"></div>' +
                                '<div class="skeleton skeleton-title short"></div>' +
                                '<div class="skeleton skeleton-bar"></div>' +
                                '<div class="skeleton skeleton-btn"></div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
            }
            $(selector).html(html);
        }

        /* --- Notifications & Feedback ---------------------------------------- */

        // showToast: DevExpress.ui.notify Stack (top center, down-push)
        // type: 'success' | 'error' | 'warning' | 'info'
        function showToast(message, type, duration) {
            type = type || 'info';
            duration = duration || 3500;
            var icons = {
                success: 'fa-circle-check',
                error:   'fa-circle-xmark',
                warning: 'fa-triangle-exclamation',
                info:    'fa-circle-info'
            };
            var icon = icons[type] || icons.info;
            DevExpress.ui.notify(
                {
                    type: type,
                    height: 45,
                    width: 'auto',
                    minWidth: 220,
                    displayTime: duration,
                    animation: {
                        show: { type: 'fade', duration: 400, from: 0, to: 1 },
                        hide: { type: 'fade', duration: 40, to: 0 }
                    },
                    contentTemplate: function(element) {
                        $(element).addClass('dx-toast-content-custom')
                            .html('<i class="fas ' + icon + ' me-2"></i><span>' + message + '</span>');
                    }
                },
                { position: 'top center', direction: 'down-push' }
            );
        }

        function handleLearnerSessionExpired(result) {
            var payload = result && result.responseJSON ? result.responseJSON : result;
            var status = result && typeof result.status === 'number' ? result.status : 0;
            var isExpired = status === 440 || (payload && payload.sessionExpired === true);

            if (!isExpired) {
                return false;
            }

            if (learnerSessionRedirecting) {
                return true;
            }

            learnerSessionRedirecting = true;
            showToast((payload && payload.message) || 'Session หมดอายุ กรุณาเข้าสู่ระบบอีกครั้ง', 'warning', 2500);

            window.setTimeout(function () {
                window.location.href = (payload && payload.redirectUrl) || learnerLoginUrl;
            }, 800);

            return true;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>